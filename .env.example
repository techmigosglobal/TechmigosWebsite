# TechMigos Website Environment Variables
# Copy this file to .env and fill in your actual values

# --- Canonical Site / Frontend ---
PUBLIC_SITE_URL=https://www.techmigos.com
NEXT_PUBLIC_SITE_URL=https://www.techmigos.com

# Supabase Edge Function API base. The frontend appends /api/... so this should stop at /functions/v1.
PUBLIC_API_BASE_URL=https://aopupssndblznvbnknoh.supabase.co/functions/v1
NEXT_PUBLIC_API_BASE_URL=https://aopupssndblznvbnknoh.supabase.co/functions/v1

# --- Supabase Browser Keys (safe only with RLS enabled) ---
NEXT_PUBLIC_SUPABASE_URL=https://aopupssndblznvbnknoh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-publishable-or-anon-key

# --- Supabase Edge Function Secrets ---
# Put these in Supabase Function secrets, not Vercel/frontend envs.
CSRF_SECRET=replace-with-long-random-secret
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
ALLOWED_ORIGINS=https://www.techmigos.com,https://techmigos.com

# Local function development only:
# supabase functions serve api --env-file supabase/.env.local
# SUPABASE_URL=https://aopupssndblznvbnknoh.supabase.co
# SUPABASE_ANON_KEY=replace-with-supabase-publishable-or-anon-key

# --- PHP cPanel Backend (Public Forms) ---
# Legacy fallback only. Production API now lives in Supabase Edge Functions.
# APP_ENV=production
# APP_TIMEZONE=UTC
# LOCAL_PHP_BACKEND_URL=http://127.0.0.1:8080
#
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=techmigos
# DB_USER=cpanel_db_user
# DB_PASS=replace-with-strong-password
# DB_CHARSET=utf8mb4
# DB_SQLITE_PATH=./php-backend/storage/local.sqlite
#
# CSRF_COOKIE_NAME=tm_csrf_secret
# CSRF_HEADER_NAME=x-csrf-token
# CSRF_COOKIE_MAX_AGE=86400
# CSRF_SECURE_COOKIE=true
#
# RATE_LIMIT_WINDOW_SECONDS=900
# RATE_LIMIT_CONTACT=6
# RATE_LIMIT_CAREERS=5
# RATE_LIMIT_NEWSLETTER=8
# RATE_LIMIT_CLEANUP_PROBABILITY=100
#
# CAREER_UPLOAD_MAX_BYTES=5242880
# CAREER_UPLOAD_DIR=/home/<cpanel-user>/public_html/storage/uploads/careers

# --- API Keys (if needed later) ---
# OPENAI_API_KEY=sk-...
# STRIPE_SECRET_KEY=sk_...
