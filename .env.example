# TechMigos Website Environment Variables
# Copy this file to .env only if you prefer dotenv. For local scripts, prefer env.json.

# --- Canonical Site / Frontend ---
PUBLIC_SITE_URL=https://www.techmigos.com
NEXT_PUBLIC_SITE_URL=https://www.techmigos.com

# InsForge API base. The frontend routes /api/... calls through /functions/techmigos-api.
PUBLIC_API_BASE_URL=https://n2hhxvw3.ap-southeast.insforge.app
NEXT_PUBLIC_API_BASE_URL=https://n2hhxvw3.ap-southeast.insforge.app

# --- InsForge Function Secrets ---
# Put these in InsForge secrets, not Vercel/frontend envs.
CSRF_SECRET=replace-with-long-random-secret
INSFORGE_API_KEY=replace-with-insforge-api-key
INSFORGE_BASE_URL=https://n2hhxvw3.ap-southeast.insforge.app
ALLOWED_ORIGINS=https://www.techmigos.com,https://techmigos.com
LEAD_NOTIFICATION_EMAIL=techmigos.global@gmail.com

# --- MSG91 ---
MSG91_AUTH_KEY=replace-with-msg91-auth-key
MSG91_EMAIL_DOMAIN=mail.techmigos.com
MSG91_EMAIL_FROM=no-reply@mail.techmigos.com
MSG91_EMAIL_TO_NAME=TechMigos
MSG91_EMAIL_TEMPLATE_ID=template_07_06_2026_14_06
MSG91_CLIENT_ACK_TEMPLATE_ID=template_07_06_2026_14_06_3
MSG91_MARKETING_TEMPLATE_ID=replace-with-approved-campaign-template-id
MSG91_INVOICE_TEMPLATE_ID=replace-with-approved-invoice-template-id

# --- Optional integrations ---
# RESEND_API_KEY=re_...
# LEAD_NOTIFICATION_FROM=TechMigos Website <notifications@techmigos.com>
# LEAD_NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/...
