# TechMigos Website Environment Variables
# Copy this file to .env and fill in your actual values

# --- General ---
# NODE_ENV=development
# SITE_URL=https://techmigos.com

# --- Admin Credentials ---
# (REQUIRED for Production) Set strong, unique username and password
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me-to-strong-password
ADMIN_SESSION_SECRET=generate-a-random-32-char-secret-here
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_NAME=Your Name

# --- Database / Storage ---
# If you switch to a database in the future
# DATABASE_URL=postgresql://user:pass@localhost:5432/techmigos
# LEADS_FILE_PATH=./data/leads.json
# CAREER_UPLOAD_DIR=./data/uploads/careers

# --- PHP cPanel Backend (Public Forms) ---
# Used by php-backend/api/* handlers when deploying Astro static output + PHP APIs.
# APP_ENV=production
# APP_TIMEZONE=UTC
# LOCAL_PHP_BACKEND_URL=http://127.0.0.1:8080
#
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=techmigos
# DB_USER=cpanel_db_user
# DB_PASS=replace-with-strong-password
# DB_CHARSET=utf8mb4
# DB_SQLITE_PATH=./php-backend/storage/local.sqlite
#
# CSRF_COOKIE_NAME=tm_csrf_secret
# CSRF_HEADER_NAME=x-csrf-token
# CSRF_COOKIE_MAX_AGE=86400
# CSRF_SECURE_COOKIE=true
#
# RATE_LIMIT_WINDOW_SECONDS=900
# RATE_LIMIT_CONTACT=6
# RATE_LIMIT_CAREERS=5
# RATE_LIMIT_NEWSLETTER=8
# RATE_LIMIT_CLEANUP_PROBABILITY=100
#
# CAREER_UPLOAD_MAX_BYTES=5242880
# CAREER_UPLOAD_DIR=/home/<cpanel-user>/public_html/storage/uploads/careers

# --- API Keys (if needed later) ---
# OPENAI_API_KEY=sk-...
# STRIPE_SECRET_KEY=sk_...
