    function bindInvoiceFormEvents(invoiceId) {
      // Auto-fill from client
      document.getElementById('inv-client')?.addEventListener('change', function () {
        const client = state.data.clients.find((c) => String(c.id) === this.value);
        if (!client) return;
        document.getElementById('inv-cname').value = client.name || '';
        document.getElementById('inv-cemail').value = client.email || '';
        document.getElementById('inv-cphone').value = client.phone || '';
      });

      // qty × rate = amount
      els.modalBody.addEventListener('input', (e) => {
        const item = e.target.closest('.inv-line-item');
        if (!item) return;
        const qty = parseFloat(item.querySelector('[name^="item_qty"]')?.value || 1);
        const rate = parseFloat(item.querySelector('[name^="item_rate"]')?.value || 0);
        const amountInput = item.querySelector('[name^="item_amount"]');
        if (amountInput) amountInput.value = (qty * rate).toFixed(2);
      });

      // Add item row
      document.getElementById('inv-add-item')?.addEventListener('click', () => {
        const list = document.getElementById('inv-items-list');
        const count = list.querySelectorAll('.inv-line-item').length;
        const div = document.createElement('div');
        div.innerHTML = invoiceLineItemsHtml([{ description: '', quantity: 1, rate: 0, amount: 0 }])
          .replace(/item_desc_0/g, `item_desc_${count}`)
          .replace(/item_unit_0/g, `item_unit_${count}`)
          .replace(/item_qty_0/g, `item_qty_${count}`)
          .replace(/item_rate_0/g, `item_rate_${count}`)
          .replace(/item_amount_0/g, `item_amount_${count}`)
          .replace(/item_notes_0/g, `item_notes_${count}`);
        list.appendChild(div.firstElementChild);
      });

      // Remove item row
      els.modalBody.addEventListener('click', (e) => {
        if (e.target.classList.contains('inv-remove-item')) {
          if (els.modalBody.querySelectorAll('.inv-line-item').length > 1) e.target.closest('.inv-line-item').remove();
        }
      });

      // Signature upload — upload immediately on file pick if editing an existing invoice
      document.getElementById('inv-sign-file')?.addEventListener('change', async function () {
        const file = this.files?.[0];
        if (!file) return;
        const statusEl = document.getElementById('inv-sign-status');
        const urlInput = document.getElementById('inv-sign-url');
        if (!invoiceId) {
          // For new invoices, store as object URL temporarily; real upload happens on create (not supported without id)
          statusEl.textContent = 'Signature will be uploaded after invoice is created. Re-open to add it.';
          return;
        }
        statusEl.textContent = 'Uploading...';
        try {
          const fd = new FormData();
          fd.append('file', file);
          const res = await portal(`/api/portal/invoices/${invoiceId}/upload-sign`, { method: 'POST', body: fd, headers: {} });
          urlInput.value = res.sign_url || '';
          statusEl.textContent = '✓ Signature uploaded';
          statusEl.style.color = '#16a34a';
        } catch (err) {
          statusEl.textContent = err instanceof Error ? err.message : 'Upload failed';
          statusEl.style.color = '#dc2626';
        }
      });
    }

    async function uploadFinanceProof(file) {
      const fd = new FormData();
      fd.append('file', file);
      try {
        return await portal('/api/portal/finances/upload-proof', { method: 'POST', body: fd, headers: {} });
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Proof upload failed';
        if (/row-level security|violates|status code 400|storage/i.test(message)) {
          throw new Error('Supabase storage policy is blocking uploads for `finance-proofs`. Apply the new storage RLS policy in Supabase, then retry.');
        }
        throw error;
      }
    }

    function bindFinanceProofField() {
      const input = document.getElementById('finance-proof-file');
      const urlInput = document.getElementById('finance-proof-url');
      const preview = document.getElementById('finance-proof-preview');
      const status = document.getElementById('finance-proof-status');
      input?.addEventListener('change', async function () {
        const file = this.files?.[0];
        if (!file || !urlInput || !preview || !status) return;
        status.textContent = 'Uploading proof...';
        status.style.color = '#667599';
        try {
          const res = await uploadFinanceProof(file);
          urlInput.value = res.proof_url || '';
          preview.innerHTML = proofPreviewMarkup(res.proof_url);
          status.textContent = '✓ Proof uploaded';
          status.style.color = 'var(--crm-green)';
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'Proof upload failed';
          status.style.color = 'var(--crm-red)';
        }
      });
    }

    function bindFinanceProofUploads() {
      document.querySelectorAll('[data-proof-upload]').forEach((input) => {
        input.addEventListener('change', async function () {
          const file = this.files?.[0];
          const row = this.closest('[data-row-id]');
          const proofCell = this.closest('[data-proof-cell]');
          const preview = proofCell?.querySelector('[data-proof-preview]');
          const status = proofCell?.querySelector('[data-proof-status]');
          if (!file || !row) return;
          if (status) {
            status.textContent = 'Uploading proof...';
            status.style.color = '#667599';
          }
          try {
            const res = await uploadFinanceProof(file);
            await portal(`/api/portal/finances/${row.dataset.rowId}`, {
              method: 'PATCH',
              body: JSON.stringify({ proof_url: res.proof_url }),
            });
            if (preview) preview.innerHTML = proofSummaryMarkup(res.proof_url);
            if (status) {
              status.textContent = `✓ ${file.name}`;
              status.style.color = 'var(--crm-green)';
            }
            toast('Proof uploaded');
            await loadData();
            render();
          } catch (error) {
            if (status) {
              status.textContent = error instanceof Error ? error.message : 'Proof upload failed';
              status.style.color = 'var(--crm-red)';
            }
            toast(error instanceof Error ? error.message : 'Proof upload failed');
          }
        }, { once: true });
      });
    }

    function collectInvoiceBody(data) {
      const itemEls = els.modalBody.querySelectorAll('.inv-line-item');
      const items = Array.from(itemEls).map((el, i) => ({
        description: (el.querySelector(`[name="item_desc_${i}"]`)?.value || '').trim(),
        unit: (el.querySelector(`[name="item_unit_${i}"]`)?.value || '').trim(),
        quantity: parseFloat(el.querySelector(`[name="item_qty_${i}"]`)?.value || 1),
        rate: parseFloat(el.querySelector(`[name="item_rate_${i}"]`)?.value || 0),
        notes: (el.querySelector(`[name="item_notes_${i}"]`)?.value || '').trim(),
      })).filter((x) => x.description);
      const subtotal = items.reduce((s, x) => s + x.quantity * x.rate, 0);
      const discount = parseFloat(data.discount_amount || 0);
      const tax = parseFloat(data.tax_amount || 0);
      const total_amount = Math.max(0, subtotal - discount + tax);
      return {
        client_id: Number(data.client_id),
        project_id: data.project_id ? Number(data.project_id) : undefined,
        invoice_number: data.invoice_number?.trim() || undefined,
        invoice_date: data.invoice_date,
        due_date: data.due_date || undefined,
        currency: data.currency || 'INR',
        customer_name: data.customer_name?.trim() || undefined,
        customer_email: data.customer_email?.trim() || undefined,
        customer_phone: data.customer_phone?.trim() || undefined,
        billing_address: data.billing_address?.trim() || undefined,
        service_title: data.service_title?.trim() || items[0]?.description || undefined,
        discount_amount: discount,
        tax_amount: tax,
        total_amount,
        received_amount: parseFloat(data.received_amount || 0),
        status: data.status || 'draft',
        notes: data.notes?.trim() || undefined,
        payment_instructions: data.payment_instructions?.trim() || undefined,
        terms: data.terms?.trim() || undefined,
        sign_url: data.sign_url?.trim() || undefined,
        items,
      };
    }

