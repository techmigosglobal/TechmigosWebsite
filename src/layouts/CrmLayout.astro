          <td>${rowActions('projects', project.id, { view: true, viewAttr: `data-project-detail="${project.id}"` })}</td>
        </tr>
      `).join('');
    }

    function renderProjects() {
      const selected = state.data.projects.find((item) => String(item.id) === String(state.selectedProjectId)) || state.data.projects[0];
      state.selectedProjectId = selected?.id || null;
      els.view.innerHTML = `
        ${pageHead('Projects Management', 'Manage all projects, track progress, budgets, and project health.', '<button class="crm-button primary" data-create="projects" type="button">+ Create Project</button>')}
        <div class="crm-grid crm-kpis">
          ${metric('Total Projects', state.data.projects.length, '▣', 'blue')}
          ${metric('At-Risk Projects', state.data.projects.filter((item) => ['watch', 'at_risk'].includes(item.health)).length, '!', 'orange', 'up 3 vs last month')}
          ${metric('Open Support Tickets', state.data.tickets.filter((item) => !['resolved', 'closed'].includes(item.status)).length, '◴', 'red', 'down 8 vs last month')}
          ${metric('Resolved Tickets', state.data.tickets.filter((item) => ['resolved', 'closed'].includes(item.status)).length, '✓', 'green')}
        </div>
        <div class="crm-two-col mt-5">
          <section class="crm-card">
            <div class="crm-card-head"><h2 class="crm-card-title">Projects</h2><div class="crm-toolbar"><select class="crm-select" id="project-status-filter"><option value="">All Statuses</option><option value="planning" ${state.projectStatusFilter === 'planning' ? 'selected' : ''}>Planning</option><option value="active" ${state.projectStatusFilter === 'active' ? 'selected' : ''}>Active</option><option value="review" ${state.projectStatusFilter === 'review' ? 'selected' : ''}>In Review</option><option value="completed" ${state.projectStatusFilter === 'completed' ? 'selected' : ''}>Completed</option><option value="on_hold" ${state.projectStatusFilter === 'on_hold' ? 'selected' : ''}>On Hold</option></select><button class="crm-button" data-export="projects">Export</button></div></div>
            ${table(['', 'Project Name', 'Client', 'Project Manager', 'Budget', 'Deadline', 'Status', 'Health', 'Progress', 'Actions'], projectRows())}
          </section>
          <aside class="crm-card crm-detail">${projectDetail(selected)}</aside>
        </div>
      `;
    }

    function projectDetail(project) {
      if (!project) return '<p class="text-sm font-bold text-slate-500">No project selected.</p>';
      const spent = Number(project.expenses || 0);
      const budget = Number(project.budget || 0);
      const used = budget ? Math.min(100, Math.round((spent / budget) * 100)) : 0;
      return `<div class="crm-detail-hero"><div class="crm-detail-icon">▣</div><div><h2 class="text-xl font-black text-slate-950">${escapeHtml(project.name)}</h2><p class="font-semibold text-slate-500">${escapeHtml(project.client_name || clientName(project.client_id))}</p></div></div>
        <div class="crm-list">
          <div class="crm-list-row"><span>Project Manager</span><strong>${escapeHtml(project.project_manager || '-')}</strong></div>
          <div class="crm-list-row"><span>Deadline</span><strong>${escapeHtml(project.due_date || '-')}</strong></div>
          <div class="crm-list-row"><span>Status</span>${badge(project.status)}</div>
          <div class="crm-list-row"><span>Budget used</span><strong>${compactMoney(spent)} of ${compactMoney(budget)}</strong></div>
          <div>${progress(used)}</div>
          <p class="text-sm font-semibold leading-6 text-slate-600">${escapeHtml(project.summary || project.notes || 'No project overview added yet.')}</p>
        </div>`;
    }

    function renderTickets() {
      const selected = state.data.tickets.find((item) => String(item.id) === String(state.selectedTicketId)) || state.data.tickets[0];
      state.selectedTicketId = selected?.id || null;
      const open = state.data.tickets.filter((item) => !['resolved', 'closed'].includes(item.status));
      const high = state.data.tickets.filter((item) => ['high', 'urgent'].includes(item.priority));
      const rows = filtered(state.data.tickets, ['subject', 'status', 'priority', 'assigned_to']).map((ticket) => {
        const employeeOpts = employeeSeed().map((e) => `<option value="${escapeHtml(e.name)}" ${ticket.assigned_to === e.name ? 'selected' : ''}>${escapeHtml(e.name)}</option>`).join('');
        return `<tr data-resource="tickets" data-row-id="${ticket.id}">
          <td><input type="checkbox" data-row-select aria-label="Select ticket ${ticket.id}" /></td>
          <td>#TIC-${ticket.id}</td>
          <td><input class="crm-edit-input" data-field="subject" value="${escapeHtml(ticket.subject)}" /></td>
          <td>${escapeHtml(clientName(ticket.client_id))}</td>
          <td class="crm-desc-cell" title="${escapeHtml(ticket.description || '')}">${escapeHtml((ticket.description || '').slice(0, 60))}${(ticket.description || '').length > 60 ? '…' : ''}</td>
          <td><select class="crm-edit-select" data-field="priority">${['low','medium','high','urgent'].map((p) => `<option value="${p}" ${ticket.priority === p ? 'selected' : ''}>${nice(p)}</option>`).join('')}</select></td>
          <td><select class="crm-edit-select" data-field="assigned_to"><option value="">Unassigned</option>${employeeOpts}</select></td>
          <td>${ticket.priority === 'urgent' ? badge('breached', 'red') : ticket.priority === 'high' ? badge('at_risk', 'orange') : badge('on_track', 'green')}</td>
          <td><select class="crm-edit-select" data-field="status">${['open','in_progress','waiting','resolved','closed'].map((s) => `<option value="${s}" ${ticket.status === s ? 'selected' : ''}>${nice(s)}</option>`).join('')}</select></td>
          <td>${rowActions('tickets', ticket.id, { view: true, viewAttr: `data-ticket-detail="${ticket.id}"` })}</td>
        </tr>`;
      }).join('');
      els.view.innerHTML = `
        ${pageHead('Support Ticketing', 'Track, assign, prioritize, and resolve client support requests.', '<button class="crm-button primary" data-create="tickets" type="button">+ Create Ticket</button><button class="crm-button" data-export="tickets" type="button">Export</button>')}
        <div class="crm-grid crm-kpis">
          ${metric('Open Tickets', open.length, '◴', 'blue', open.length ? 'down 8% vs last week' : 'up 0% vs last week')}
          ${metric('High Priority', high.length, '!', 'red', 'up 17% vs last week')}
          ${metric('SLA Breaches', state.data.tickets.filter((item) => item.priority === 'urgent').length, '△', 'orange', 'up 50% vs last week')}
          ${metric('Resolved Today', state.data.tickets.filter((item) => ['resolved', 'closed'].includes(item.status)).length, '✓', 'green', 'up 23% vs yesterday')}
        </div>
        <div class="crm-two-col mt-5">
          <section class="crm-card">
            <div class="crm-card-head"><h2 class="crm-card-title">Tickets Queue</h2><div class="crm-toolbar"><select class="crm-select"><option>All Statuses</option></select><select class="crm-select"><option>All Priorities</option></select><button class="crm-button">Clear Filters</button></div></div>
            ${table(['', 'Ticket ID', 'Subject', 'Client', 'Description', 'Priority', 'Assigned Agent', 'SLA Status', 'Status', 'Actions'], rows)}
          </section>
          <aside class="crm-card crm-detail">${ticketDetail(selected)}</aside>
        </div>
        <div class="crm-three-col mt-5">
          <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Ticket Categories</h2></div><div class="crm-donut"></div><div class="crm-list"><div class="crm-list-row"><span>Technical Issue</span><strong>${open.length}</strong></div><div class="crm-list-row"><span>Billing & Payments</span><strong>${state.data.tickets.filter((item) => /pay|bill|invoice/i.test(item.subject || '')).length}</strong></div></div></section>
          <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Resolution Performance</h2></div><div class="crm-chart"></div></section>
          <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">SLA Compliance</h2></div><div class="crm-donut"></div><div class="crm-list"><div class="crm-list-row"><span>On Time</span><strong>${state.data.tickets.length - high.length}</strong></div><div class="crm-list-row"><span>At Risk</span><strong>${high.length}</strong></div></div></section>
        </div>`;
    }

    function ticketDetail(ticket) {
      if (!ticket) return '<p class="text-sm font-bold text-slate-500">No ticket selected.</p>';
      return `<div class="crm-detail-hero"><div class="crm-detail-icon">◴</div><div><h2 class="text-xl font-black text-slate-950">#TIC-${ticket.id}</h2><p class="font-semibold text-slate-500">${escapeHtml(ticket.subject || 'Untitled ticket')}</p></div></div>
        <div class="crm-list">
          <div class="crm-list-row"><span>Client</span><strong>${escapeHtml(clientName(ticket.client_id))}</strong></div>
          <div class="crm-list-row"><span>Linked project</span><strong>${escapeHtml(projectName(ticket.project_id))}</strong></div>
          <div class="crm-list-row"><span>Assigned agent</span><strong>${escapeHtml(ticket.assigned_to || 'Unassigned')}</strong></div>
          <div class="crm-list-row"><span>Priority</span>${badge(ticket.priority, statusTone(ticket.priority))}</div>
          <div class="crm-list-row"><span>Status</span>${badge(ticket.status)}</div>
          <p class="text-sm font-semibold leading-6 text-slate-600">${escapeHtml(ticket.description || 'No issue summary added yet.')}</p>
          <div class="crm-toolbar"><button class="crm-button primary" data-create="ticket_messages" type="button">Reply</button><button class="crm-button" data-edit-resource="tickets" data-edit-id="${ticket.id}" type="button">Reassign</button><button class="crm-button green" data-quick-patch="tickets" data-quick-id="${ticket.id}" data-quick-field="status" data-quick-value="resolved" type="button">Resolve</button></div>
        </div>`;
    }

    function financeSheetRows() {
      const invoices = state.data.invoices.map((invoice) => ({
        ...invoice,
        id: invoice.id,
        transaction_date: invoice.invoice_date || invoice.created_at?.slice(0, 10),
        reference_id: invoice.invoice_number,
        client: invoice.customer_company || invoice.customer_name || clientName(invoice.client_id),
        project: projectName(invoice.project_id),
        transaction_type: 'invoice',
        amount: invoice.total_amount || invoice.amount,
        notes: invoice.notes,
      }));
      if (state.financeSheet === 'invoices') return invoices;
      return state.data.finances.filter((item) => {
        if (state.financeSheet === 'all') return true;
        if (state.financeSheet === 'income') return ['income', 'revenue'].includes(item.transaction_type);
        if (state.financeSheet === 'expenses') return item.transaction_type === 'expense';
        if (state.financeSheet === 'salary') return item.transaction_type === 'salary';
        if (state.financeSheet === 'pending') return ['pending', 'half_payment', 'sent'].includes(item.status);
        if (state.financeSheet === 'paid') return ['paid', 'received'].includes(item.status);
        return true;
      });
    }

    function financeVisibleRows() {
      const rows = filtered(financeSheetRows(), ['transaction_type', 'reference_id', 'title', 'client', 'project', 'status', 'paid_by', 'received_by', 'invoice_number', 'customer_name', 'service_title']);
      return rows.filter((item) => {
        if (state.financeStatusFilter && String(item.status || '') !== state.financeStatusFilter) return false;
        if (state.financeProofFilter === 'with-proof' && !item.proof_url) return false;
        if (state.financeProofFilter === 'without-proof' && item.proof_url) return false;
        return true;
      });
    }

    function ledgerStateKey(resource, id) {
      return `${resource}:${id}`;
    }

    function setLedgerState(resource, id, status) {
      const key = ledgerStateKey(resource, id);
      if (!status || status === 'idle') state.rowSaveStates.delete(key);
      else state.rowSaveStates.set(key, status);
    }

    function ledgerState(resource, id) {
      return state.rowSaveStates.get(ledgerStateKey(resource, id)) || 'idle';
    }

    function ledgerStateMarkup(resource, id) {
      if (!state.financeEditMode) return `<span class="crm-ledger-state crm-ledger-state--locked" data-ledger-state="${resource}:${id}">Locked</span>`;
      const current = ledgerState(resource, id);
      if (current === 'dirty') return `<span class="crm-ledger-state crm-ledger-state--dirty" data-ledger-state="${resource}:${id}">Pending</span>`;
      if (current === 'saving') return `<span class="crm-ledger-state crm-ledger-state--saving" data-ledger-state="${resource}:${id}">Saving</span>`;
      if (current === 'saved') return `<span class="crm-ledger-state crm-ledger-state--saved" data-ledger-state="${resource}:${id}">Saved</span>`;
      return `<span class="crm-ledger-state" data-ledger-state="${resource}:${id}">Ready</span>`;
    }

    function financeActiveFilters(rows) {
      const chips = [
        `<span class="crm-filter-chip"><span>Rows</span><strong>${rows.length}</strong></span>`,
      ];
      if (state.financeStatusFilter) chips.push(`<button class="crm-filter-chip" type="button" data-finance-quick-filter="status-clear"><span>Status</span><strong>${nice(state.financeStatusFilter)}</strong></button>`);
      if (state.financeProofFilter !== 'all') chips.push(`<button class="crm-filter-chip" type="button" data-finance-quick-filter="proof-clear"><span>Proof</span><strong>${state.financeProofFilter === 'with-proof' ? 'Attached' : 'Missing'}</strong></button>`);
      if (state.search) chips.push(`<button class="crm-filter-chip" type="button" data-finance-quick-filter="search-clear"><span>Search</span><strong>${escapeHtml(state.search)}</strong></button>`);
      return chips.join('');
    }

    function financeSummaryMarkup(rows) {
      const totalValue = rows.reduce((sum, item) => sum + Number(item.total_amount || item.amount || 0), 0);
      const collectedValue = rows.reduce((sum, item) => sum + Number(item.received_amount || (item.status === 'paid' ? (item.total_amount || item.amount || 0) : 0)), 0);
      const pendingCount = rows.filter((item) => ['pending', 'sent', 'overdue', 'half_payment'].includes(String(item.status || ''))).length;
      const proofCoverage = rows.filter((item) => item.proof_url).length;
      return `<div class="crm-ledger-pinned-summary">
        <div class="crm-ledger-pill"><span>Visible Rows</span><strong>${rows.length}</strong></div>
        <div class="crm-ledger-pill"><span>Sheet Total</span><strong>${compactMoney(totalValue)}</strong></div>
        <div class="crm-ledger-pill"><span>Collected / Paid</span><strong>${compactMoney(collectedValue)}</strong></div>
        <div class="crm-ledger-pill"><span>Pending / Proof</span><strong>${pendingCount} / ${proofCoverage}</strong></div>
      </div>`;
    }

    function financeDensityMarkup() {
      return `<div class="crm-density-toggle" aria-label="Ledger density">
        <button class="crm-density-button ${state.financeDensity === 'comfortable' ? 'active' : ''}" type="button" data-finance-density="comfortable">Comfortable</button>
        <button class="crm-density-button ${state.financeDensity === 'compact' ? 'active' : ''}" type="button" data-finance-density="compact">Compact</button>
      </div>`;
    }

    function ledgerFieldError(row, input) {
      const field = input.dataset.field;
      const value = String(input.value || '').trim();
      const resource = row.dataset.resource;
      if (resource === 'finances') {
        if (field === 'transaction_date' && !value) return 'Date is required.';
        if (field === 'amount' && (value === '' || Number(value) < 0 || Number.isNaN(Number(value)))) return 'Amount must be 0 or more.';
        if (state.financeSheet === 'salary' && field === 'title' && !value) return 'Employee name is required.';
      }
      if (resource === 'invoices') {
        if (['invoice_date', 'invoice_number', 'customer_name', 'service_title'].includes(field) && !value) return 'This field is required.';
      }
      return '';
    }

    function validateLedgerInput(input) {
      const row = input.closest('[data-row-id]');
      if (!row || !['finances', 'invoices'].includes(row.dataset.resource || '')) return true;
      const message = ledgerFieldError(row, input);
      input.classList.toggle('crm-cell-invalid', Boolean(message));
      if (message) input.setAttribute('title', message);
      else input.removeAttribute('title');
      return !message;
    }

    function validateLedgerRow(row) {
      if (!row || !['finances', 'invoices'].includes(row.dataset.resource || '')) return true;
      const inputs = Array.from(row.querySelectorAll('[data-field]'));
      const valid = inputs.every((input) => validateLedgerInput(input));
      if (!valid) {
        setLedgerState(row.dataset.resource, row.dataset.rowId, 'invalid');
        applyLedgerStateToRow(row, 'invalid');
      }
      return valid;
    }

    function moveLedgerFocus(current, step) {
      const cells = Array.from(document.querySelectorAll('.crm-table--ledger [data-field]'));
      const index = cells.indexOf(current);
      if (index === -1) return;
      const target = cells[index + step];
      if (target) {
        target.focus();
        if (target.select) target.select();
      }
    }

    function bindLedgerKeyboardFlow() {
      document.querySelectorAll('.crm-table--ledger [data-field]').forEach((input) => {
        input.addEventListener('keydown', (event) => {
          if (event.key === 'Enter') {
            event.preventDefault();
            moveLedgerFocus(input, event.shiftKey ? -1 : 1);
          }
          if (event.altKey && event.key === 'ArrowRight') {
            event.preventDefault();
            moveLedgerFocus(input, 1);
          }
          if (event.altKey && event.key === 'ArrowLeft') {
            event.preventDefault();
            moveLedgerFocus(input, -1);
          }
        });
      });
    }

    function financeRowStart(resource, item) {
      const currentState = ledgerState(resource, item.id);
      const rowStateClass = currentState && currentState !== 'idle' ? ` crm-ledger-row--${currentState}` : '';
      return `<tr class="${rowStateClass.trim()}" data-resource="${resource}" data-row-id="${item.id}">`;
    }

    function applyLedgerStateToRow(row, status) {
      if (!row) return;
      row.classList.remove('crm-ledger-row--dirty', 'crm-ledger-row--saving', 'crm-ledger-row--saved', 'crm-ledger-row--invalid');
      if (status && status !== 'idle') row.classList.add(`crm-ledger-row--${status}`);
      const indicator = row.querySelector(`[data-ledger-state="${row.dataset.resource}:${row.dataset.rowId}"]`);
      if (!indicator) return;
      indicator.className = 'crm-ledger-state';
      if (!state.financeEditMode) {
        indicator.classList.add('crm-ledger-state--locked');
        indicator.textContent = 'Locked';
        return;
      }
      if (status === 'dirty') {
        indicator.classList.add('crm-ledger-state--dirty');
        indicator.textContent = 'Pending';
      } else if (status === 'saving') {
        indicator.classList.add('crm-ledger-state--saving');
        indicator.textContent = 'Saving';
      } else if (status === 'saved') {
        indicator.classList.add('crm-ledger-state--saved');
        indicator.textContent = 'Saved';
      } else if (status === 'invalid') {
        indicator.classList.add('crm-ledger-state--invalid');
        indicator.textContent = 'Fix row';
      } else {
        indicator.textContent = 'Ready';
      }
    }

    function proofCell(item) {
      const id = item.id;
      if (item.proof_url) {
        return `<div class="crm-proof-cell" data-proof-cell="${id}" style="display:flex;flex-direction:column;align-items:flex-start;gap:6px;">
          <div class="crm-proof-preview-inline" data-proof-preview="${id}">${proofSummaryMarkup(item.proof_url)}</div>
          <div style="display:flex;align-items:center;gap:4px;flex-wrap:wrap;">
            <button class="crm-mini-action" type="button" data-proof-open="${escapeHtml(item.proof_url)}">Preview</button>
            <button class="crm-mini-action" type="button" data-proof-link="${escapeHtml(item.proof_url)}">Open</button>
            <label class="crm-mini-action" style="cursor:pointer;" title="Replace proof">↑<input type="file" data-proof-upload="${id}" accept="image/*,.pdf,.jpg,.jpeg,.png,.webp" style="display:none;" /></label>
          </div>
          <span class="crm-proof-status" data-proof-status="${id}" style="font-size:10px;color:#667599;"></span>
        </div>`;
      }
      return `<div class="crm-proof-cell" data-proof-cell="${id}" style="display:flex;flex-direction:column;align-items:flex-start;gap:6px;">
        <label class="crm-mini-action" style="cursor:pointer;" title="Upload proof">+ Proof<input type="file" data-proof-upload="${id}" accept="image/*,.pdf,.jpg,.jpeg,.png,.webp" style="display:none;" /></label>
        <div class="crm-proof-preview-inline" data-proof-preview="${id}">${proofSummaryMarkup('')}</div>
        <span class="crm-proof-status" data-proof-status="${id}" style="font-size:10px;color:#667599;"></span>
      </div>`;
    }

    function proofPreviewMarkup(url) {
      if (!url) return '';
      const safeUrl = escapeHtml(url);
      if (/\.(png|jpe?g|webp|gif|avif)$/i.test(url)) {
        return `<a href="${safeUrl}" target="_blank" rel="noopener"><img src="${safeUrl}" alt="Proof preview" style="max-width:220px;max-height:160px;object-fit:cover;border:1px solid #e2e8f0;border-radius:8px;background:#fff;" /></a>`;
      }
      if (/\.pdf$/i.test(url)) {
        return `<a href="${safeUrl}" target="_blank" rel="noopener" class="crm-mini-action" style="text-decoration:none;">📄 Open PDF proof</a>`;
      }
      return `<a href="${safeUrl}" target="_blank" rel="noopener" class="crm-mini-action" style="text-decoration:none;">📎 Open proof</a>`;
    }

    function proofSummaryMarkup(url) {
      if (!url) return '<span class="crm-proof-summary">No proof</span>';
      if (/\.pdf(\?|$)/i.test(url)) return '<span class="crm-proof-summary">PDF attached</span>';
      if (/\.(png|jpe?g|webp|gif|avif)(\?|$)/i.test(url)) return '<span class="crm-proof-summary">Image attached</span>';
      return '<span class="crm-proof-summary">Proof attached</span>';
    }

    function proofStoragePath(value) {
      const raw = String(value || '').trim();
      if (!raw) return '';
      if (/^https?:\/\//i.test(raw)) {
        const match = raw.match(/\/finance-proofs\/(.+)$/);
        return match ? decodeURIComponent(match[1]) : '';
      }
      return raw;
    }

    async function resolveProofUrl(value) {
      const raw = String(value || '').trim();
      if (!raw) return '';
      const path = proofStoragePath(raw);
      if (!path && /^https?:\/\//i.test(raw)) return raw;
      if (!path) return raw;
      const { data, error } = await window.tmSupabase.storage
        .from('finance-proofs')
        .createSignedUrl(path, 60 * 60);
      if (error) throw new Error(error.message);
      return data?.signedUrl || '';
    }

    async function openProofPreview(value) {
      if (!value || !els.proofPreviewModal || !els.proofPreviewBody) return;
      els.proofPreviewBody.innerHTML = '<p style="margin:0;color:#475569;font-weight:700;">Loading proof preview...</p>';
      els.proofPreviewModal.classList.add('open');
      try {
        const resolvedUrl = await resolveProofUrl(value);
        const safeUrl = escapeHtml(resolvedUrl);
        if (/\.pdf(\?|$)/i.test(resolvedUrl)) {
          els.proofPreviewBody.innerHTML = `<iframe src="${safeUrl}" title="Proof PDF preview"></iframe>`;
        } else if (/\.(png|jpe?g|webp|gif|avif)(\?|$)/i.test(resolvedUrl)) {
          els.proofPreviewBody.innerHTML = `<img src="${safeUrl}" alt="Proof preview" />`;
        } else {
          els.proofPreviewBody.innerHTML = `<p style="margin:0 0 12px;color:#475569;font-weight:700;">Inline preview is not available for this proof type.</p><a class="crm-button primary" href="${safeUrl}" target="_blank" rel="noopener" style="text-decoration:none;">Open Proof</a>`;
        }
      } catch (error) {
        els.proofPreviewBody.innerHTML = `<p style="margin:0;color:#b91c1c;font-weight:700;">${escapeHtml(error instanceof Error ? error.message : 'Could not open proof preview')}</p>`;
        return;
      }
    }

    async function openProofInNewTab(value) {
      try {
        const resolvedUrl = await resolveProofUrl(value);
        window.open(resolvedUrl, '_blank', 'noopener,noreferrer');
      } catch (error) {
        toast(error instanceof Error ? error.message : 'Could not open proof');
      }
    }

    function financeProofFieldMarkup(values = {}) {
      const proofUrl = String(values.proof_url || '');
      return `<div class="wide" style="border:1px solid #e2e8f0;border-radius:6px;padding:10px 12px;">
        <strong style="font-size:12px;">Payment Proof Attachment</strong>
        <span style="display:block;font-size:10px;color:#667599;margin-bottom:6px;">Upload a receipt, screenshot, or PDF proof. It will be saved with the transaction and can be included in reports.</span>
        ${proofUrl ? `<div id="finance-proof-preview" style="margin-bottom:8px;">${proofPreviewMarkup(proofUrl)}</div>` : `<div id="finance-proof-preview" style="margin-bottom:8px;">${proofSummaryMarkup('')}</div>`}
        <input type="file" id="finance-proof-file" accept="image/*,.pdf,.jpg,.jpeg,.png,.webp" style="display:block;" />
        <input type="hidden" name="proof_url" id="finance-proof-url" value="${escapeHtml(proofUrl)}" />
        <span id="finance-proof-status" style="font-size:10px;color:#667599;"></span>
      </div>`;
    }

    function financeRows() {
