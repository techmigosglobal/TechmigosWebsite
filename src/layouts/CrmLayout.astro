    .project-reference-date {
      display: inline-flex;
      min-width: 305px;
      min-height: 58px;
      align-items: center;
      gap: 12px;
      border: 1px solid #dce7ef;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.84);
