    @page {
      size: A4 landscape;
      margin: 10mm;
    }

    @media print {
      body * { visibility: hidden !important; }

      #invoice-modal,
      #invoice-modal * { visibility: visible !important; }

      #invoice-modal {
        position: fixed !important;
        inset: 0 !important;
        padding: 0 !important;
        background: white !important;
        z-index: 9999 !important;
        overflow: visible !important;
      }

      .invoice-print-sheet {
        width: 277mm !important;
        max-width: 277mm !important;
        margin: 0 auto !important;
        padding: 0 !important;
        font-size: 9.5px !important;
        line-height: 1.4 !important;
        font-family: Arial, sans-serif !important;
        color: #000 !important;
      }

      .invoice-print-sheet * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .invoice-print-sheet table { border-collapse: collapse !important; }

      .inv-no-break { break-inside: avoid !important; page-break-inside: avoid !important; }

      .print\:hidden, [type="button"], .crm-icon-button, .crm-button, #invoice-modal > div > div:first-child { display: none !important; }

      .inv-logo { display: block !important; }
    }

    /* === Invoice Builder === */
    .inv-builder-layout {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 20px;
      align-items: start;
    }
    .inv-section-title {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 18px 0 10px;
      color: #0f172a;
      font-size: 13px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .inv-section-title:first-child { margin-top: 0; }
    .inv-project-card .inv-section-title { color: #1d4ed8; }
    .inv-project-status-message {
      margin: -2px 0 12px;
      padding: 8px 10px;
      border-radius: 8px;
      background: #eff6ff;
      color: #1e40af;
      font-size: 11px;
      line-height: 1.45;
    }
    .inv-project-summary {
      margin: 0 0 10px;
      padding: 8px 10px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      background: #f8fafc;
      font-size: 10px;
      line-height: 1.45;
    }
    .inv-section-title::before {
      content: "";
      width: 8px;
      height: 8px;
      background: var(--crm-blue);
      border-radius: 50%;
    }
    .inv-upload-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    .inv-upload-box {
      border: 1px dashed #9fb1ca;
      background: #f8fbff;
      padding: 12px;
      border-radius: 12px;
      display: grid;
      gap: 6px;
      transition: border-color 0.15s, background 0.15s;
      cursor: pointer;
