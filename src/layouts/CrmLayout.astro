    .inv-asset-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
    .inv-asset-actions .crm-button { min-height: 34px; padding: 0 10px; font-size: 12px; }
    .inv-asset-file { display: inline-flex; align-items: center; cursor: pointer; }
    .inv-asset-file input { display: none; }
    .inv-asset-status { display: block; min-height: 16px; margin-top: 8px; color: var(--crm-muted); font-size: 11px; }
    .inv-asset-list { display: grid; gap: 6px; margin-top: 10px; }
    .inv-asset-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      border-top: 1px solid #e2e8f0;
