  <OverlayLayer />

  <script is:inline define:vars={{ activeTab }}>
    const navItems = [
      ['dashboard', 'Dashboard', '⌂'],
      ['projects', 'Projects', '▣'],
      ['tickets', 'Support Tickets', '◴'],
      ['finance', 'Finance', '▤'],
      ['analytics', 'Analytics', '▥'],
      ['reports', 'Reports', '▧'],
      ['clients', 'Clients', '○'],
      ['employees', 'Employees', '♙'],
      ['users', 'User Management', '♧'],
      ['settings', 'Settings', '⚙'],
    ];

    const DISABLED_CRM_RESOURCES = new Set(['leads', 'deals', 'followups', 'campaigns']);
    const ADMIN_ONLY_RESOURCES = new Set(['profiles', 'settings']);

    const hoverCache = new Map();
    let hoverGen = 0;

    const state = {
      active: typeof activeTab !== 'undefined' ? activeTab : 'dashboard',
      search: '',
      financeStatusFilter: '',
      financeProofFilter: 'all',
      financeEditMode: false,
      financeDensity: 'comfortable',
      profile: null,
      selectedProjectId: null,
      selectedTicketId: null,
      selectedClientId: null,
      selectedEmployeeId: null,
      financeSheet: 'all',
      invoiceBuilderActive: false,
      invoiceBuilderId: null,
      reportType: 'executive',
      reportFrom: '',
      reportTo: '',
      projectStatusFilter: '',
      saveTimers: new Map(),
      rowSaveStates: new Map(),
      data: {
        leads: [],
        clients: [],
        projects: [],
        deals: [],
        tickets: [],
        invoices: [],
        finances: [],
        followups: [],
        campaigns: [],
        activities: [],
        profiles: [],
      },
    };

    const els = {
      nav: document.getElementById('crm-nav'),
      view: document.getElementById('crm-view'),
      search: document.getElementById('crm-search'),
      status: document.getElementById('crm-status'),
      toast: document.getElementById('crm-toast'),
      modal: document.getElementById('crm-modal'),
      modalTitle: document.getElementById('crm-modal-title'),
      modalBody: document.getElementById('crm-modal-body'),
      invoiceModal: document.getElementById('invoice-modal'),
      invoicePreview: document.getElementById('invoice-preview'),
      invoicePreviewTitle: document.getElementById('invoice-preview-title'),
      actionbar: document.getElementById('crm-actionbar'),
      selectedCount: document.getElementById('crm-selected-count'),
      invoiceHover: document.getElementById('invoice-hover-preview'),
      proofPreviewModal: document.getElementById('proof-preview-modal'),
      proofPreviewBody: document.getElementById('proof-preview-body'),
    };

    function token() {
      return 'supabase-session';
    }

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
    }

    function money(value, currency = 'INR') {
      return `${currency} ${Number(value || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    function compactMoney(value) {
      return `₹${Number(value || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 })}`;
    }

    function nice(value) {
      return escapeHtml(String(value || '').replace(/_/g, ' ') || '-');
    }

    function toast(message) {
      els.toast.textContent = message;
      els.toast.classList.add('show');
      clearTimeout(toast.timer);
      toast.timer = setTimeout(() => els.toast.classList.remove('show'), 2400);
    }

    // showToast alias for backward compat with invoice builder/tracker code
    function showToast(message) { toast(message); }

    function setStatus(message, tone = 'neutral') {
      els.status.textContent = message;
      els.status.style.color = tone === 'error' ? 'var(--crm-red)' : tone === 'success' ? 'var(--crm-green)' : '#667599';
    }

    const TABLE_MAP = {
      leads: 'crm_leads',
      clients: 'crm_clients',
      projects: 'crm_projects',
      deals: 'crm_deals',
      tickets: 'crm_tickets',
      invoices: 'crm_invoices',
      finances: 'crm_finances',
      followups: 'crm_followups',
      campaigns: 'crm_campaigns',
      activities: 'crm_activities',
      profiles: 'crm_profiles',
      ticket_messages: 'crm_ticket_messages',
    };

    const RESOURCE_FIELDS = {
      leads: ['name', 'email', 'company', 'phone', 'service', 'budget', 'priority', 'status', 'assigned_to', 'message', 'source', 'source_path'],
      clients: ['name', 'company', 'email', 'phone', 'status', 'marketing_opt_in', 'notes'],
      projects: ['client_id', 'name', 'client_name', 'project_manager', 'owner_user_id', 'budget', 'expenses', 'revenue', 'status', 'health', 'progress', 'due_date', 'summary', 'notes'],
      deals: ['client_id', 'lead_id', 'title', 'stage', 'value', 'currency', 'expected_close_date', 'assigned_to', 'notes'],
      tickets: ['client_id', 'project_id', 'subject', 'description', 'priority', 'status', 'assigned_to'],
      invoices: ['client_id', 'project_id', 'invoice_number', 'invoice_date', 'due_date', 'currency', 'customer_name', 'customer_email', 'customer_phone', 'billing_address', 'service_title', 'discount_amount', 'tax_amount', 'total_amount', 'received_amount', 'status', 'notes', 'payment_instructions', 'terms', 'sign_url', 'is_recurring'],
      finances: ['transaction_date', 'transaction_type', 'reference_id', 'title', 'client', 'project', 'paid_by', 'received_by', 'payment_method', 'department', 'amount', 'status', 'notes', 'source', 'proof_url'],
      followups: ['related_type', 'related_id', 'title', 'due_at', 'status', 'assigned_to', 'notes'],
      campaigns: ['name', 'subject', 'body', 'status', 'msg91_template_id', 'scheduled_at', 'sent_at'],
      profiles: ['auth_user_id', 'email', 'name', 'role', 'status', 'client_id', 'department'],
      ticket_messages: ['ticket_id', 'body', 'author_name', 'author_role', 'visibility'],
    };

    const NUMERIC_FIELDS = new Set([
      'client_id', 'lead_id', 'project_id', 'ticket_id', 'related_id',
      'amount', 'budget', 'value', 'progress', 'expenses', 'revenue',
      'discount_amount', 'tax_amount', 'total_amount', 'received_amount',
      'quantity', 'rate', 'sort_order',
    ]);

    const BOOLEAN_FIELDS = new Set(['marketing_opt_in', 'is_recurring']);

    function tableName(resource) {
      return TABLE_MAP[resource] || resource;
    }

    function isCompanyAdmin() {
      return state.profile?.role === 'company_admin';
    }

    function isDisabledResource(resource) {
      return DISABLED_CRM_RESOURCES.has(resource);
    }

    function ensurePortalAccess(resource) {
      if (!resource || resource === 'me' || resource === 'client') return;
      if (isDisabledResource(resource)) throw new Error(`${nice(resource)} is not enabled in this CRM workspace.`);
      if (ADMIN_ONLY_RESOURCES.has(resource) && !isCompanyAdmin()) {
        throw new Error('Only company admins can access this area.');
      }
    }

    function validatePayload(resource, payload) {
      if (resource === 'profiles' && payload.role === 'client' && !payload.client_id) {
        return 'Select a client before creating or updating a client login.';
      }
      if (resource === 'projects' && !payload.client_id) {
        return 'Select a client for this project.';
      }
      if (resource === 'tickets' && !payload.client_id) {
        return 'Select a client before creating the ticket.';
      }
      if (resource === 'finances' && (!payload.transaction_date || payload.amount === undefined)) {
        return 'Finance records need both a date and an amount.';
      }
      return '';
    }

    function sanitizeInvoiceItems(items = []) {
      return items
        .map((item, index) => ({
          description: String(item.description || '').trim(),
          quantity: Number(item.quantity || 1),
          rate: Number(item.rate || 0),
          amount: Number(item.amount || ((Number(item.quantity || 1) * Number(item.rate || 0)) || 0)),
          unit: String(item.unit || '').trim(),
          notes: String(item.notes || '').trim(),
          sort_order: Number(item.sort_order ?? index),
        }))
        .filter((item) => item.description);
    }

    function sanitizeResourcePayload(resource, payload = {}) {
      const allowed = RESOURCE_FIELDS[resource];
      const clean = {};
      Object.entries(payload || {}).forEach(([key, value]) => {
        if (!allowed || !allowed.includes(key)) return;
        if (typeof value === 'string') value = value.trim();
        if (value === '' || value === undefined || value === null) return;
        if (NUMERIC_FIELDS.has(key)) value = Number(value);
        if (BOOLEAN_FIELDS.has(key)) value = value === true || value === 'true' || value === 'on' || value === '1';
        clean[key] = value;
      });

      if (resource === 'projects' && clean.progress !== undefined) {
        clean.progress = Math.max(0, Math.min(100, Number(clean.progress || 0)));
      }

      return clean;
    }

    async function portal(path, options = {}) {
      const method = (options.method || 'GET').toUpperCase();
      const body = options.body ? (typeof options.body === 'string' ? JSON.parse(options.body) : options.body) : null;
      const parts = path.replace(/^\/api\/portal\//, '').split('/').filter(Boolean);
      const resource = parts[0];
      const id = parts[1];
      const sub = parts[2];
      const table = tableName(resource);

      if (resource === 'me') {
        const { data: { user } } = await window.tmSupabase.auth.getUser();
        if (!user) throw new Error('Not authenticated');
        const { data: profile } = await window.tmSupabase
          .from('crm_profiles')
          .select('*')
          .eq('auth_user_id', user.id)
          .single();
        if (!profile) throw new Error('Profile not found');
        if (profile.role === 'client') throw new Error('Access denied');
        return { profile, destination: '/company' };
      }

      if (resource === 'settings') {
        const category = id || 'company';
        if (method === 'GET') {
          const { data } = await window.tmSupabase
            .from('crm_settings')
            .select('settings')
            .eq('category', category)
            .single();
          return { settings: data?.settings || {} };
        }
        if (method === 'PATCH') {
          const { data: existing } = await window.tmSupabase
            .from('crm_settings')
            .select('id, settings')
            .eq('category', category)
            .single();
          if (existing) {
            await window.tmSupabase
              .from('crm_settings')
              .update({ settings: { ...existing.settings, ...body } })
              .eq('id', existing.id);
          }
          return { ok: true };
        }
      }

      if (resource === 'invoices' && id && sub === 'upload-sign') {
        const file = options.body?.get?.('file');
        if (!file) throw new Error('No file provided');
        const path = `signatures/${id}/${Date.now()}-${file.name}`;
        const { error: uploadError } = await window.tmSupabase.storage
          .from('invoice-signatures')
          .upload(path, file, { upsert: true });
        if (uploadError) throw new Error(uploadError.message);
        const { data: urlData } = window.tmSupabase.storage
          .from('invoice-signatures')
          .getPublicUrl(path);
        await window.tmSupabase
          .from('crm_invoices')
          .update({ sign_url: urlData.publicUrl })
          .eq('id', id);
        return { sign_url: urlData.publicUrl };
      }

      if (resource === 'finances' && (id === 'upload-proof' || sub === 'upload-proof') && method === 'POST') {
        const file = options.body?.get?.('file');
        if (!file) throw new Error('No file provided');
        const uploadName = id && id !== 'upload-proof' ? `records/${id}/${Date.now()}-${file.name}` : `pending/${Date.now()}-${file.name}`;
        const { error: uploadError } = await window.tmSupabase.storage
          .from('finance-proofs')
          .upload(uploadName, file, { upsert: true });
        if (uploadError) throw new Error(uploadError.message);
        if (id) {
          await window.tmSupabase
            .from('crm_finances')
            .update({ proof_url: uploadName })
            .eq('id', id);
        }
        return { proof_url: uploadName, proof_key: uploadName };
      }

      if (resource === 'invoices' && id && sub === undefined && method === 'GET') {
        const { data: invoice } = await window.tmSupabase
          .from('crm_invoices')
          .select('*')
          .eq('id', id)
          .single();
        const { data: items } = await window.tmSupabase
          .from('crm_invoice_items')
          .select('*')
          .eq('invoice_id', id)
          .order('sort_order');
        return { detail: { invoice, items } };
      }

      if (resource === 'client') {
        if (id === 'overview') {
          const { data: { user } } = await window.tmSupabase.auth.getUser();
          const { data: profile } = await window.tmSupabase
            .from('crm_profiles')
            .select('client_id')
            .eq('auth_user_id', user.id)
            .single();
          const clientId = profile?.client_id;
          if (!clientId) throw new Error('No client linked');
          const [clientRes, projectsRes, invoicesRes, ticketsRes] = await Promise.all([
            window.tmSupabase.from('crm_clients').select('*').eq('id', clientId).single(),
            window.tmSupabase.from('crm_projects').select('*').eq('client_id', clientId),
            window.tmSupabase.from('crm_invoices').select('*').eq('client_id', clientId),
            window.tmSupabase.from('crm_tickets').select('*').eq('client_id', clientId),
          ]);
          return {
            client: clientRes.data,
            projects: projectsRes.data || [],
            invoices: invoicesRes.data || [],
            tickets: ticketsRes.data || [],
          };
        }
      }

      ensurePortalAccess(resource);

      if (method === 'GET' && !id) {
        const { data, error } = await window.tmSupabase
          .from(table)
          .select('*')
          .order('created_at', { ascending: false });
        if (error) throw new Error(error.message);
        return { items: data || [] };
      }

      if (method === 'POST' && !id) {
        const invoiceItems = resource === 'invoices' ? sanitizeInvoiceItems(body?.items || []) : [];
        const rows = (Array.isArray(body) ? body : [body]).map((row) => sanitizeResourcePayload(resource, row));
        const { data, error } = await window.tmSupabase
          .from(table)
          .insert(rows)
          .select();
        if (error) throw new Error(error.message);

        if (resource === 'invoices' && invoiceItems.length) {
          const invoiceId = data[0]?.id;
          if (invoiceId) {
            const items = invoiceItems.map((item, i) => ({
              invoice_id: invoiceId,
              description: item.description || '',
              quantity: item.quantity || 1,
              rate: item.rate || 0,
              amount: (item.quantity || 1) * (item.rate || 0),
              unit: item.unit || '',
              notes: item.notes || '',
              sort_order: i,
            }));
            await window.tmSupabase.from('crm_invoice_items').insert(items);
          }
        }

        return { item: data?.[0], items: data };
      }

      if (method === 'PATCH' && id) {
        const invoiceItems = resource === 'invoices' ? sanitizeInvoiceItems(body?.items || []) : [];
        const updateBody = sanitizeResourcePayload(resource, body);
        const { data, error } = await window.tmSupabase
          .from(table)
          .update(updateBody)
          .eq('id', id)
          .select();
        if (error) throw new Error(error.message);

        if (resource === 'invoices' && Array.isArray(body?.items)) {
          await window.tmSupabase.from('crm_invoice_items').delete().eq('invoice_id', id);
          const items = invoiceItems.map((item, i) => ({
            invoice_id: id,
            description: item.description || '',
            quantity: item.quantity || 1,
            rate: item.rate || 0,
            amount: (item.quantity || 1) * (item.rate || 0),
            unit: item.unit || '',
            notes: item.notes || '',
            sort_order: i,
          }));
          if (items.length) await window.tmSupabase.from('crm_invoice_items').insert(items);
        }

        return { item: data?.[0] };
      }

      if (method === 'DELETE' && id) {
        const { error } = await window.tmSupabase
          .from(table)
          .delete()
          .eq('id', id);
        if (error) throw new Error(error.message);
        return { ok: true };
      }

      throw new Error(`Unsupported portal call: ${method} ${path}`);
    }

    function logout() {
      window.tmSupabase.auth.signOut();
      location.href = '/login';
    }

    function clientName(id) {
      const client = state.data.clients.find((item) => String(item.id) === String(id));
      return client?.company || client?.name || `Client #${id || '-'}`;
    }

    function filtered(rows, keys) {
      const query = state.search.trim().toLowerCase();
      if (!query) return rows;
      return rows.filter((row) => keys.some((key) => String(row[key] || '').toLowerCase().includes(query)));
    }

    function statusTone(status) {
      if (['paid', 'received', 'active', 'completed', 'resolved', 'closed', 'on_track'].includes(status)) return 'green';
      if (['overdue', 'urgent', 'at_risk', 'cancelled'].includes(status)) return 'red';
      if (['sent', 'viewed', 'watch', 'high', 'half_payment', 'pending', 'on_hold'].includes(status)) return 'orange';
      if (['planning', 'proposal'].includes(status)) return 'purple';
      return 'blue';
    }

    function badge(value, tone = statusTone(value)) {
      return `<span class="crm-status ${tone}">${nice(value)}</span>`;
    }

    function rowActions(resource, id, options = {}) {
      const view = options.view ? `<button class="crm-mini-action" ${options.viewAttr || ''} type="button">View</button>` : '';
      const invoice = resource === 'invoices' ? `<button class="crm-mini-action" data-invoice-view="${id}" type="button">Invoice</button>` : '';
      return `<div class="crm-row-actions">
        ${view}${invoice}
        <button class="crm-mini-action" data-edit-resource="${resource}" data-edit-id="${id}" type="button">Edit</button>
        <button class="crm-mini-action" data-duplicate-resource="${resource}" data-duplicate-id="${id}" type="button">Duplicate</button>
        <button class="crm-mini-action danger" data-delete-resource="${resource}" data-delete-id="${id}" type="button">Delete</button>
      </div>`;
    }

    function metric(label, value, icon, color = 'blue', trend = 'Updated just now') {
      return `<article class="crm-card crm-kpi">
        <div class="crm-kpi-icon ${color}-soft">${icon}</div>
        <div><p class="crm-kpi-label">${label}</p><p class="crm-kpi-value">${value}</p><p class="crm-trend ${trend.startsWith('down') ? 'down' : 'up'}">${trend}</p></div>
      </article>`;
    }

    function progress(value) {
      const safe = Math.max(0, Math.min(100, Number(value || 0)));
      return `<div class="crm-progress"><div class="crm-progress-track"><div class="crm-progress-fill" style="width:${safe}%"></div></div><strong>${safe}%</strong></div>`;
    }

    function currentWeekLabel() {
      const now = new Date();
      const dayOfWeek = now.getDay() === 0 ? 6 : now.getDay() - 1;
      const weekStart = new Date(now);
      weekStart.setDate(now.getDate() - dayOfWeek);
      const weekEnd = new Date(weekStart);
      weekEnd.setDate(weekStart.getDate() + 6);
      const fmtDate = (date) => date.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
      return `${fmtDate(weekStart)} – ${fmtDate(weekEnd)}, ${weekEnd.getFullYear()}`;
    }

    function syncNavVisibility() {
      document.querySelectorAll('[data-nav-key]').forEach((link) => {
        const key = link.getAttribute('data-nav-key');
        const hideForNonAdmin = (key === 'users' || key === 'settings') && !isCompanyAdmin();
        link.style.display = hideForNonAdmin ? 'none' : '';
      });
    }

    function renderShell() {
      document.querySelectorAll('[data-jump]').forEach((button) => button.addEventListener('click', () => {
        const target = button.dataset.jump;
        window.location.href = `/company/${target === 'users' ? 'user-management' : target}`;
      }));
    }

    function pageHead(title, subtitle, actions = '') {
      return `<div class="crm-page-head"><div><h1 class="crm-page-title">${title}</h1><p class="crm-page-subtitle">${subtitle}</p></div><div class="crm-toolbar">${actions}</div></div>`;
    }

    function table(headers, rows, empty = 'No records yet.', tableClass = '') {
      table.labelIndex = 0;
      const labeledRows = rows ? rows.replace(/<td(?![^>]*data-label=)([^>]*)>/g, (match, attrs) => {
        const index = table.labelIndex % headers.length;
        table.labelIndex += 1;
        return `<td data-label="${escapeHtml(headers[index] || '')}"${attrs}>`;
      }) : '';
      return `<div class="crm-table-wrap"><table class="crm-table ${tableClass}"><thead><tr>${headers.map((item) => `<th>${item}</th>`).join('')}</tr></thead><tbody>${labeledRows || `<tr><td data-label="" colspan="${headers.length}">${empty}</td></tr>`}</tbody></table></div>`;
    }
    table.labelIndex = 0;

    function renderDashboard() {
      const projects = state.data.projects;
      const tickets = state.data.tickets;
      const clients = state.data.clients;
      const finances = state.data.finances;
      const income = finances.filter((item) => ['income', 'revenue'].includes(item.transaction_type)).reduce((sum, item) => sum + Number(item.amount || 0), 0);
      const expenses = finances.filter((item) => ['expense', 'salary'].includes(item.transaction_type)).reduce((sum, item) => sum + Number(item.amount || 0), 0);
      const openTickets = tickets.filter((item) => !['resolved', 'closed'].includes(item.status));
      
      // Dynamic current-week date range
      const weekLabel = currentWeekLabel();

      // Accounts Receivable
      const receivable = state.data.invoices
        .filter((item) => !['paid', 'cancelled'].includes(item.status))
        .reduce((sum, item) => sum + Number(item.total_amount || item.amount || 0), 0);

      const projectRows = filtered(projects, ['name', 'client_name', 'status', 'project_manager']).slice(0, 5).map((project) => `
        <tr><td><strong>${escapeHtml(project.name)}</strong></td><td>${escapeHtml(project.client_name || clientName(project.client_id))}</td><td>${badge(project.status)}</td><td>${compactMoney(project.budget)}</td><td>${progress(project.progress)}</td></tr>
      `).join('');
      const ticketRows = filtered(tickets, ['subject', 'priority', 'assigned_to', 'status']).slice(0, 5).map((ticket) => `
        <tr><td>#TIC-${ticket.id}</td><td>${badge(ticket.priority, statusTone(ticket.priority))}</td><td>${escapeHtml(ticket.assigned_to || 'Unassigned')}</td><td>${badge(ticket.status)}</td></tr>
      `).join('');
      els.view.innerHTML = `
        ${pageHead('Operations Dashboard', 'Company-wide visibility across delivery, support, projects, clients, and finance.', `<button class="crm-button" type="button">${escapeHtml(weekLabel)}</button><button class="crm-button primary" type="button" data-jump="reports">Open reports</button>`)}
        <section class="crm-card crm-hero-panel">
          <div class="crm-hero-grid">
            <div>
              <span class="crm-hero-kicker">Team Snapshot</span>
              <h2 class="crm-hero-title">Welcome back, ${escapeHtml(state.profile?.name || 'Team')}.</h2>
              <p class="crm-hero-copy">You have ${openTickets.length} active support items, ${projects.filter((item) => ['active', 'review', 'planning'].includes(item.status)).length} live projects, and ${receivable ? `${compactMoney(receivable)} pending collection` : 'no outstanding receivables'} across the current operating cycle.</p>
            </div>
            <div class="crm-hero-meta">
              <span class="crm-meta-label">Cash Position</span>
              <span class="crm-meta-value">${compactMoney(income - expenses)}</span>
              <p class="crm-meta-note">${income >= expenses ? 'Revenue is covering operating spend this period.' : 'Operating spend is ahead of collected revenue this period.'}</p>
              <button class="crm-button" type="button" data-jump="finance">Review finance desk</button>
            </div>
          </div>
        </section>
        <div class="crm-section-stack">
          <div class="crm-grid crm-kpis">
            ${metric('Total Projects', projects.length, '▣', 'blue', `${projects.filter((item) => item.status === 'completed').length} completed`)}
            ${metric('Active Clients', clients.filter((item) => item.status !== 'archived').length, '○', 'green', `${clients.filter((item) => item.status === 'lead').length} still in lead stage`)}
            ${metric('Open Tickets', openTickets.length, '◴', 'red', openTickets.length ? `${openTickets.filter((item) => ['high', 'urgent'].includes(item.priority)).length} high priority` : 'Queue is under control')}
            ${metric('Monthly Revenue', compactMoney(income), '₹', 'green', `${compactMoney(expenses)} in operating costs`)}
            ${metric('Accounts Receivable', compactMoney(receivable), '◈', receivable > 0 ? 'orange' : 'green', receivable > 0 ? `${state.data.invoices.filter((item) => !['paid', 'cancelled'].includes(item.status)).length} unpaid invoices` : 'All issued invoices are settled')}
          </div>
          <div class="crm-two-col">
            <section class="crm-card crm-table-card">
              <div class="crm-card-head"><h2 class="crm-card-title">Project Pipeline</h2><button class="crm-link" data-jump="projects">View all projects</button></div>
              ${table(['Project Name', 'Client', 'Status', 'Budget', 'Progress'], projectRows, 'No projects in progress right now.')}
            </section>
            <section class="crm-card">
              <div class="crm-card-head"><h2 class="crm-card-title">Financial Position</h2><button class="crm-link" data-jump="finance">Open finance</button></div>
              <div class="crm-list">
                <div class="crm-list-row"><span>Revenue collected</span><strong class="crm-amount-positive">${compactMoney(income)}</strong></div>
                <div class="crm-list-row"><span>Expenses recorded</span><strong class="crm-amount-negative">${compactMoney(expenses)}</strong></div>
                <div class="crm-list-row"><span>Net position</span><strong class="${income - expenses >= 0 ? 'crm-amount-positive' : 'crm-amount-negative'}">${compactMoney(income - expenses)}</strong></div>
                <div class="crm-list-row"><span>Receivables due</span><strong>${compactMoney(receivable)}</strong></div>
              </div>
              <div class="crm-split-callout" style="padding:0 18px 18px;">
                <div class="crm-mini-card">
                  <span class="crm-meta-label">Quick action</span>
                  <strong>Create invoice</strong>
                  <p class="crm-note">Issue a bill, collect payment, and attach proof from the finance workspace.</p>
                </div>
                <div class="crm-mini-card">
                  <span class="crm-meta-label">Attention</span>
                  <strong>${openTickets.length} support items</strong>
                  <p class="crm-note">Keep delivery confidence high by closing urgent client issues first.</p>
                </div>
              </div>
            </section>
          </div>
          <div class="crm-three-col">
            <section class="crm-card crm-table-card"><div class="crm-card-head"><h2 class="crm-card-title">Support Queue</h2><button class="crm-link" data-jump="tickets">Open support desk</button></div>${table(['Ticket ID', 'Priority', 'Assigned Agent', 'Status'], ticketRows, 'No support tickets in the queue.')}</section>
            <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Recent Activity</h2></div><div class="crm-list">${state.data.activities.slice(0, 5).map((item) => `<div class="crm-list-row"><span>${escapeHtml(item.summary || item.action || 'Activity')}</span><small>${escapeHtml(String(item.created_at || '').slice(0, 10) || 'Recently')}</small></div>`).join('') || '<p class="crm-empty">No activity has been recorded yet.</p>'}</div></section>
            <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Client Watchlist</h2></div><div class="crm-list">${projects.filter((item) => ['watch', 'at_risk', 'breached'].includes(item.health)).slice(0, 4).map((item) => `<div class="crm-list-row"><span>${escapeHtml(item.name || 'Project')}</span><small>${escapeHtml(item.client_name || clientName(item.client_id) || 'Client')}</small></div>`).join('') || '<p class="crm-empty">No delivery risks need attention right now.</p>'}</div></section>
          </div>
        </div>
      `;
    }

    function projectRows() {
      const allProjects = state.projectStatusFilter
        ? state.data.projects.filter((p) => p.status === state.projectStatusFilter)
        : state.data.projects;
      return filtered(allProjects, ['name', 'client_name', 'status', 'project_manager']).map((project) => `
        <tr data-resource="projects" data-row-id="${project.id}">
          <td><input type="checkbox" data-row-select aria-label="Select project ${escapeHtml(project.name)}" /></td>
          <td><input class="crm-edit-input" data-field="name" value="${escapeHtml(project.name)}" /></td>
          <td><input class="crm-edit-input" data-field="client_name" value="${escapeHtml(project.client_name || clientName(project.client_id))}" /></td>
          <td><input class="crm-edit-input" data-field="project_manager" value="${escapeHtml(project.project_manager || '')}" /></td>
          <td><input class="crm-edit-input" data-field="budget" type="number" value="${escapeHtml(project.budget || 0)}" /></td>
          <td><input class="crm-edit-input" data-field="due_date" type="date" value="${escapeHtml(project.due_date || '')}" /></td>
          <td><select class="crm-edit-select" data-field="status">${['planning', 'active', 'review', 'completed', 'on_hold'].map((item) => `<option value="${item}" ${project.status === item ? 'selected' : ''}>${nice(item)}</option>`).join('')}</select></td>
          <td>${badge(project.health, statusTone(project.health))}</td>
