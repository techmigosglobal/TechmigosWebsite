    /* Projects reference screen: overview first, actions second, project table last. */
    .crm-projects-page {
      grid-template-rows: auto auto auto minmax(0, 1fr);
      gap: 16px;
    }

    .project-reference-header {
      display: flex;
      min-width: 0;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
    }

    .project-reference-header h1 {
      margin: 0;
      color: #101c35;
      font-size: clamp(34px, 2.9vw, 42px);
      font-weight: 950;
      letter-spacing: -0.06em;
      line-height: 1.05;
    }

    .project-reference-header p {
      margin: 7px 0 0;
      color: #59708f;
      font-size: 18px;
