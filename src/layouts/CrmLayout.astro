    .project-reference-table th:nth-child(1) { width: 23%; }
    .project-reference-table th:nth-child(2) { width: 18%; }
    .project-reference-table th:nth-child(3) { width: 12%; }
    .project-reference-table th:nth-child(4) { width: 19%; }
    .project-reference-table th:nth-child(5) { width: 13%; }
