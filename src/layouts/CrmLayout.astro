      border-top-color: #edf1f5 !important;
      gap: 12px !important;
    }

    .crm-dashboard .dashboard-actions > p {
      font-size: 14px !important;
      letter-spacing: 0.08em !important;
    }

    .crm-dashboard .dashboard-actions .crm-button {
      min-height: 66px;
      border-radius: 17px;
      font-size: 18px;
    }

