      }

      els.view.innerHTML = `
        ${pageHead('Financial Management', subtitles, tabActions)}
        ${isBuilder ? financeSheetTabs() : ''}
        ${bodyContent}`;

      if (isBuilder) {
        initInvoiceBuilder();
      } else {
        initFinanceCharts();
      }
    }

    function initFinanceCharts() {
      // Invoice Aging: real computed from invoice data
      const today = new Date();
      const aging = { '0\u201330 Days': 0, '31\u201360 Days': 0, '61\u201390 Days': 0, '90+ Days': 0 };
      state.data.invoices
        .filter((inv) => !['paid', 'cancelled'].includes(inv.status))
        .forEach((inv) => {
          const daysLate = inv.due_date ? Math.floor((today - new Date(inv.due_date)) / 86400000) : 0;
          const amt = Number(inv.total_amount || inv.amount || 0);
          if (daysLate <= 30) aging['0\u201330 Days'] += amt;
          else if (daysLate <= 60) aging['31\u201360 Days'] += amt;
          else if (daysLate <= 90) aging['61\u201390 Days'] += amt;
          else aging['90+ Days'] += amt;
        });
      const agingEl = document.getElementById('invoice-aging-list');
      if (agingEl) {
        agingEl.innerHTML = Object.entries(aging).map(([label, amt]) =>
          `<div class="crm-list-row"><span>${label}</span><strong style="color:${amt > 0 ? '#dc2626' : '#64748b'}">${compactMoney(amt)}</strong></div>`
        ).join('');
      }
      // Monthly Cash Flow: last 6 months bar chart
      const monthMap = {};
      state.data.finances.forEach((item) => {
        const d = item.transaction_date || (item.created_at || '').slice(0, 10);
        const monthKey = d.slice(0, 7);
        if (!monthKey || monthKey.length < 7) return;
        if (!monthMap[monthKey]) monthMap[monthKey] = { income: 0, expense: 0 };
        if (['income', 'revenue'].includes(item.transaction_type)) monthMap[monthKey].income += Number(item.amount || 0);
        else monthMap[monthKey].expense += Number(item.amount || 0);
      });
      const monthKeys = Object.keys(monthMap).sort().slice(-6);
      const maxFlow = Math.max(...monthKeys.flatMap((k) => [monthMap[k].income, monthMap[k].expense]), 1);
      const chartEl = document.getElementById('cashflow-chart-container');
      if (chartEl) {
        if (monthKeys.length === 0) {
          chartEl.innerHTML = '<p style="font-size:11px;color:#94a3b8;padding:8px">No transaction data yet</p>';
        } else {
          const bars = monthKeys.map((k) => {
            const incH = Math.round((monthMap[k].income / maxFlow) * 60);
            const expH = Math.round((monthMap[k].expense / maxFlow) * 60);
            const lbl = new Date(k + '-01').toLocaleDateString('en-IN', { month: 'short' });
            return `<div style="display:flex;flex-direction:column;align-items:center;gap:2px;flex:1">
              <div style="display:flex;gap:2px;align-items:flex-end;height:64px">
                <div title="Income \u20b9${monthMap[k].income.toLocaleString('en-IN')}" style="width:10px;height:${incH}px;background:#16a34a;border-radius:2px 2px 0 0"></div>
                <div title="Expense \u20b9${monthMap[k].expense.toLocaleString('en-IN')}" style="width:10px;height:${expH}px;background:#dc2626;border-radius:2px 2px 0 0"></div>
              </div>
              <span style="font-size:9px;color:#64748b">${lbl}</span>
            </div>`;
          }).join('');
          chartEl.innerHTML = `<div style="display:flex;align-items:flex-end;gap:4px;height:80px">${bars}</div><div style="display:flex;gap:12px;margin-top:6px"><span style="font-size:10px;color:#16a34a;font-weight:700">&#9632; Income</span><span style="font-size:10px;color:#dc2626;font-weight:700">&#9632; Expense</span></div>`;
        }
      }
    }

    function renderInvoiceBuilder() {
      return `<div class="crm-card mt-5" style="padding:0;overflow:visible;">
        <div class="inv-builder-layout">
          <div class="inv-builder-form" id="inv-builder-form">
            <div class="crm-card" style="padding:18px;">
              <div class="inv-section-title">Company Settings</div>
              <div class="crm-form-grid">
                <label>Company Name<input id="inv-company-name" class="crm-input" placeholder="Your Company" value="" style="width:100%;" /></label>
                <label>Company Tagline<input id="inv-company-tagline" class="crm-input" placeholder="Excellence in Digital" value="" style="width:100%;" /></label>
                <label>Contact Person<input id="inv-contact-person" class="crm-input" placeholder="Full Name" value="" style="width:100%;" /></label>
                <label>Contact Number<input id="inv-contact-number" class="crm-input" placeholder="+91 XXXXX XXXXX" value="" style="width:100%;" /></label>
                <label>Contact Email<input id="inv-contact-email" class="crm-input" placeholder="billing@company.com" value="" style="width:100%;" /></label>
                <label>GST / Tax ID<input id="inv-gst" class="crm-input" placeholder="GST Number" value="" style="width:100%;" /></label>
              </div>
              <div class="inv-upload-grid" style="margin-top:14px;">
                <div class="inv-upload-box"><label>Company Logo<input type="file" id="inv-logo-input" accept="image/*" style="display:none;" /></label><div class="inv-upload-preview" id="inv-logo-preview"><span>No logo selected</span></div></div>
                <div class="inv-upload-box"><label>QR Code<input type="file" id="inv-qr-input" accept="image/*" style="display:none;" /></label><div class="inv-upload-preview" id="inv-qr-preview"><span>No QR selected</span></div></div>
                <div class="inv-upload-box"><label>Signature<input type="file" id="inv-sign-input" accept="image/*" style="display:none;" /></label><div class="inv-upload-preview" id="inv-sign-preview"><span>No signature selected</span></div></div>
              </div>
            </div>

            <div class="crm-card" style="padding:18px;margin-top:16px;">
              <div class="inv-section-title">Client Details</div>
              <div style="margin-bottom:14px;">
                <label style="font-size:12px;font-weight:800;color:#27364a;display:block;margin-bottom:6px;">Select Existing Client</label>
                <select id="inv-client-select" class="crm-select" style="width:100%;">
                  <option value="">— Choose a Client to Auto-Fetch Details —</option>
                  ${state.data.clients.map(c => `<option value="${c.id}">${escapeHtml(c.company || c.name)}</option>`).join('')}
                </select>
              </div>
              <div class="crm-form-grid">
                <label>Client / Company Name<input id="inv-client-name" class="crm-input" placeholder="Client Company" value="" style="width:100%;" /></label>
                <label>Contact Person<input id="inv-client-contact" class="crm-input" placeholder="Client Contact" value="" style="width:100%;" /></label>
                <label>Email<input id="inv-client-email" class="crm-input" placeholder="client@email.com" value="" style="width:100%;" /></label>
                <label>Phone<input id="inv-client-phone" class="crm-input" placeholder="Phone" value="" style="width:100%;" /></label>
                <label class="full">Address<textarea id="inv-client-address" class="crm-input" placeholder="Billing Address" rows="2" style="width:100%;min-height:48px;"></textarea></label>
              </div>
            </div>

            <div class="crm-card" style="padding:18px;margin-top:16px;">
              <div class="inv-section-title">Invoice Details</div>
              <div class="crm-form-grid">
                <label>Invoice Number<input id="inv-number" class="crm-input" placeholder="INV-001" value="" style="width:100%;" /></label>
                <label>Invoice Date<input id="inv-date" type="date" class="crm-input" style="width:100%;" /></label>
                <label>Due Date<input id="inv-due-date" type="date" class="crm-input" style="width:100%;" /></label>
                <label>Status<select id="inv-status" class="crm-select" style="width:100%;"><option value="draft">Draft</option><option value="sent">Sent</option><option value="paid">Paid</option><option value="overdue">Overdue</option><option value="cancelled">Cancelled</option></select></label>
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-top:20px;grid-column: span 2;"><input id="inv-is-recurring" type="checkbox" style="width:16px;height:16px;cursor:pointer;" /><strong>Recurring Invoice</strong></label>
              </div>
            </div>

            <div class="crm-card" style="padding:18px;margin-top:16px;">
              <div class="inv-section-title">Service Items</div>
              <div class="inv-items-editor" id="inv-items-editor">
                <table>
                  <thead><tr><th style="width:50%">Service / Description</th><th style="width:12%">Qty</th><th style="width:15%">Rate</th><th style="width:15%">Total</th><th style="width:8%"></th></tr></thead>
                  <tbody id="inv-items-tbody"></tbody>
                </table>
              </div>
              <button class="crm-button" type="button" id="inv-add-item" style="margin-top:10px;">+ Add Item</button>
              <div class="crm-form-grid" style="margin-top:14px;">
                <label>Notes / Terms<textarea id="inv-notes" class="crm-input" placeholder="Notes or terms..." rows="2" style="width:100%;min-height:48px;"></textarea></label>
                <label>Payment Instructions<textarea id="inv-payment" class="crm-input" placeholder="Bank details, UPI, etc." rows="2" style="width:100%;min-height:48px;"></textarea></label>
              </div>
            </div>
          </div>

          <div class="inv-builder-preview" id="inv-builder-preview">
            <div class="inv-preview-wrap" id="inv-preview-container"></div>
          </div>
        </div>
      </div>`;
    }

    // HTML escape helper to prevent XSS (shared scope)
    const esc = (str) => {
      if (!str) return "";
      return String(str).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
    };

    function initInvoiceBuilder() {
      // Load saved company settings from Supabase
      async function loadBuilderSettings() {
        try {
          const { data } = await window.tmSupabase.from('crm_settings').select('value').eq('key', 'invoice_builder_settings').single();
          if (data && data.value) {
            const s = typeof data.value === 'string' ? JSON.parse(data.value) : data.value;
            const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.value = val || ''; };
            const setCheckbox = (id, val) => { const el = document.getElementById(id); if (el) el.checked = !!val; };
            const setPreview = (id, url) => { const el = document.getElementById(id); if (el && url) el.innerHTML = `<img src="${url}" style="max-height:40px;border-radius:4px;">`; };

            setVal('inv-company-name', s.companyName);
            setVal('inv-company-tagline', s.companyTagline);
            setVal('inv-contact-person', s.contactPerson);
            setVal('inv-contact-number', s.contactNumber);
            setVal('inv-contact-email', s.contactEmail);
            setVal('inv-gst', s.gst);
            setVal('inv-client-name', s.clientName);
            setVal('inv-client-contact', s.clientContact);
            setVal('inv-client-email', s.clientEmail);
            setVal('inv-client-phone', s.clientPhone);
            setVal('inv-client-address', s.clientAddress);
            setVal('inv-number', s.invoiceNumber);
            setVal('inv-date', s.invoiceDate);
            setVal('inv-due-date', s.dueDate);
            setVal('inv-status', s.status);
            setVal('inv-notes', s.notes);
            setVal('inv-payment', s.paymentTerms);
            setCheckbox('inv-is-recurring', s.isRecurring || s.is_recurring);
            setPreview('inv-logo-preview', s.logoUrl);
            setPreview('inv-qr-preview', s.qrUrl);
            setPreview('inv-sign-preview', s.signUrl);

            // Restore items
            if (s.items && s.items.length) {
              const tbody = document.getElementById('inv-items-tbody');
              if (tbody) {
                tbody.innerHTML = '';
                s.items.forEach(item => addItemRow(item));
              }
            }
            updatePreview();
          }
        } catch (e) { console.warn('Could not load builder settings:', e); }
      }

      async function loadInvoiceData(invoiceId) {
        try {
          const res = await portal(`/api/portal/invoices/${invoiceId}`);
          const { invoice, items } = res.detail;
          if (invoice) {
            const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.value = val || ''; };
            const setCheckbox = (id, val) => { const el = document.getElementById(id); if (el) el.checked = !!val; };
            const setPreview = (id, url) => { const el = document.getElementById(id); if (el && url) el.innerHTML = `<img src="${url}" style="max-height:40px;border-radius:4px;">`; };

            setVal('inv-number', invoice.invoice_number);
            setVal('inv-date', invoice.invoice_date ? invoice.invoice_date.slice(0, 10) : '');
            setVal('inv-due-date', invoice.due_date ? invoice.due_date.slice(0, 10) : '');
            setVal('inv-status', invoice.status);
            setVal('inv-notes', invoice.notes);
            setVal('inv-payment', invoice.payment_instructions);
            setVal('inv-client-name', invoice.customer_name);
            setVal('inv-client-email', invoice.customer_email);
            setVal('inv-client-phone', invoice.customer_phone);
            setVal('inv-client-address', invoice.billing_address);
            setCheckbox('inv-is-recurring', invoice.is_recurring);

            setVal('inv-company-name', invoice.company_name || '');
            setVal('inv-gst', invoice.gst_number || '');
            setPreview('inv-sign-preview', invoice.sign_url);

            const tbody = document.getElementById('inv-items-tbody');
            if (tbody) {
              tbody.innerHTML = '';
              if (items && items.length) {
                items.forEach(item => addItemRow({
                  desc: item.description,
                  qty: item.quantity,
                  rate: item.rate
                }));
              }
            }
            updatePreview();
          }
        } catch (e) {
          console.error('Failed to load invoice data:', e);
          showToast('Failed to load invoice: ' + e.message, 'error');
        }
      }

      // File upload handlers
      function setupFileInput(inputId, previewId, fieldKey) {
        const input = document.getElementById(inputId);
        const preview = document.getElementById(previewId);
        if (!input || !preview) return;
        input.addEventListener('change', async (e) => {
          const file = e.target.files[0];
          if (file) {
            preview.innerHTML = `<span style="font-size:11px;color:#64748b;">Uploading...</span>`;
            try {
              const filename = `${fieldKey}/${Date.now()}-${file.name}`;
              const { data, error: uploadError } = await window.tmSupabase.storage
                .from('invoice-signatures')
                .upload(filename, file, { upsert: true });
              if (uploadError) throw uploadError;

              const { data: urlData } = window.tmSupabase.storage
                .from('invoice-signatures')
                .getPublicUrl(filename);

              const publicUrl = urlData.publicUrl;
              preview.innerHTML = `<img src="${publicUrl}" style="max-height:40px;border-radius:4px;">`;
              updatePreview();
            } catch (error) {
              console.error(error);
              showToast('Upload failed: ' + (error.message || error), 'error');
              preview.innerHTML = `<span style="font-size:11px;color:#ef4444;">Upload Failed</span>`;
            }
          }
        });
      }
      setupFileInput('inv-logo-input', 'inv-logo-preview', 'logo');
      setupFileInput('inv-qr-input', 'inv-qr-preview', 'qr');
      setupFileInput('inv-sign-input', 'inv-sign-preview', 'sign');

      // Make the entire box clickable to trigger file upload dialog
      document.querySelectorAll('.inv-upload-box').forEach(box => {
        box.addEventListener('click', (e) => {
          if (e.target.tagName === 'INPUT') return;
          box.querySelector('input[type="file"]')?.click();
        });
      });

      // Auto-fetch client details handler
      const clientSelect = document.getElementById('inv-client-select');
      if (clientSelect) {
        clientSelect.addEventListener('change', (e) => {
          const clientId = e.target.value;
          if (!clientId) return;
          const client = state.data.clients.find(c => String(c.id) === String(clientId));
          if (client) {
            const setVal = (id, val) => { const el = document.getElementById(id); if (el) { el.value = val || ''; el.dispatchEvent(new Event('input')); } };
            setVal('inv-client-name', client.company || client.name);
            setVal('inv-client-contact', client.name);
            setVal('inv-client-email', client.email);
            setVal('inv-client-phone', client.phone);
            setVal('inv-client-address', client.notes || '');
          }
        });
      }

      // Add item row
      function addItemRow(data) {
        const tbody = document.getElementById('inv-items-tbody');
        if (!tbody) return;
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><input type="text" class="inv-item-desc" value="${data?.desc || ''}" placeholder="Service description" style="width:100%;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;"></td>
          <td><input type="number" class="inv-item-qty" value="${data?.qty || 1}" min="1" style="width:60px;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;"></td>
          <td><input type="number" class="inv-item-rate" value="${data?.rate || 0}" step="0.01" style="width:90px;padding:6px 8px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;"></td>
          <td class="inv-item-total" style="font-weight:600;padding:6px 8px;">${formatCurrency((data?.qty || 1) * (data?.rate || 0))}</td>
          <td><button type="button" class="inv-remove-item crm-button" style="background:#fee2e2;color:#dc2626;padding:4px 8px;font-size:12px;">✕</button></td>
        `;
        tr.querySelectorAll('input').forEach(inp => inp.addEventListener('input', updatePreview));
        tr.querySelector('.inv-remove-item').addEventListener('click', () => { tr.remove(); updatePreview(); });
        tbody.appendChild(tr);
        updatePreview();
      }

      // Add item button
      const addBtn = document.getElementById('inv-add-item');
      if (addBtn) {
        addBtn.addEventListener('click', () => addItemRow());
      }

      // Format currency
      function formatCurrency(amount) {
        return '₹' + Number(amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }

      // Live preview update
      function updatePreview() {
        const preview = document.getElementById('inv-preview-container');
        if (!preview) return;
        const g = (id) => (document.getElementById(id)?.value || '').trim();
        const getCheck = (id) => !!document.getElementById(id)?.checked;
        const getPreviewSrc = (id) => document.getElementById(id)?.querySelector('img')?.src || '';
        const logoSrc = getPreviewSrc('inv-logo-preview');
        const qrSrc = getPreviewSrc('inv-qr-preview');
        const signSrc = getPreviewSrc('inv-sign-preview');

        // Collect items
        const rows = document.querySelectorAll('#inv-items-tbody tr');
        let items = [];
        let subtotal = 0;
        rows.forEach(row => {
          const desc = row.querySelector('.inv-item-desc')?.value || '';
          const qty = Number(row.querySelector('.inv-item-qty')?.value || 1);
          const rate = Number(row.querySelector('.inv-item-rate')?.value || 0);
          const total = qty * rate;
          subtotal += total;
          const totalCell = row.querySelector('.inv-item-total');
          if (totalCell) totalCell.textContent = formatCurrency(total);
          items.push({ desc, qty, rate, total });
        });

        const gstRate = 18;
        const gstAmount = subtotal * gstRate / 100;
        const grandTotal = subtotal + gstAmount;

        preview.innerHTML = `
          <div class="inv-preview-sheet">
            <div class="inv-preview-border">
              ${logoSrc ? `<div style="text-align:center;margin-bottom:8px;"><img src="${logoSrc}" style="max-height:50px;"></div>` : ''}
              <div style="text-align:center;margin-bottom:10px;">
                <h2 style="margin:0;font-size:18px;color:#1e40af;">${esc(g('inv-company-name')) || 'Company Name'}</h2>
                ${esc(g('inv-company-tagline')) ? `<p style="margin:2px 0 0;font-size:11px;color:#6b7280;">${g('inv-company-tagline')}</p>` : ''}
                ${esc(g('inv-gst')) ? `<p style="margin:2px 0 0;font-size:10px;color:#6b7280;">GST: ${g('inv-gst')}</p>` : ''}
                ${[g('inv-contact-person'), g('inv-contact-number'), g('inv-contact-email')].some(v=>v) ? `<p style="margin:2px 0 0;font-size:10px;color:#6b7280;">${esc([g('inv-contact-person'), g('inv-contact-number'), g('inv-contact-email')].filter(Boolean).join(' | '))}</p>` : ''}
              </div>
              <hr style="border:none;border-top:2px solid #1e40af;margin:10px 0;">
              <div style="display:flex;justify-content:space-between;margin-bottom:10px;font-size:12px;">
                <div><strong>Bill To:</strong><br>${esc(g('inv-client-name')) || 'Client Name'}<br>${esc(g('inv-client-address')) || ''}<br>${esc(g('inv-client-email')) || ''}<br>${esc(g('inv-client-phone')) || ''}</div>
                <div style="text-align:right;"><strong>Invoice #:</strong> ${esc(g('inv-number')) || 'INV-001'}<br><strong>Date:</strong> ${g('inv-date') || new Date().toISOString().split('T')[0]}<br><strong>Due:</strong> ${esc(g('inv-due-date')) || ''}<br><strong>Status:</strong> <span style="color:${g('inv-status')==='paid'?'#16a34a':g('inv-status')==='overdue'?'#dc2626':'#d97706'}">${g('inv-status') || 'pending'}</span>${getCheck('inv-is-recurring') ? '<br><span style="display:inline-block;padding:2px 6px;background:#fef3c7;color:#d97706;border-radius:4px;font-size:9px;font-weight:700;margin-top:4px;">RECURRING</span>' : ''}</div>
              </div>
              <table style="width:100%;border-collapse:collapse;font-size:12px;margin-bottom:10px;">
                <thead><tr style="background:#1e40af;color:#fff;"><th style="padding:6px 8px;text-align:left;">Description</th><th style="padding:6px 8px;text-align:center;">Qty</th><th style="padding:6px 8px;text-align:right;">Rate</th><th style="padding:6px 8px;text-align:right;">Total</th></tr></thead>
                <tbody>
                  ${items.length ? items.map(it => `<tr><td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;">${esc(it.desc)}</td><td style="padding:6px 8px;text-align:center;border-bottom:1px solid #e5e7eb;">${it.qty}</td><td style="padding:6px 8px;text-align:right;border-bottom:1px solid #e5e7eb;">${formatCurrency(it.rate)}</td><td style="padding:6px 8px;text-align:right;border-bottom:1px solid #e5e7eb;font-weight:600;">${formatCurrency(it.total)}</td></tr>`).join('') : '<tr><td colspan="4" style="padding:10px;text-align:center;color:#9ca3af;">No items added</td></tr>'}
                </tbody>
              </table>
              <div style="text-align:right;font-size:12px;">
                <div>Subtotal: <strong>${formatCurrency(subtotal)}</strong></div>
                <div>GST (18%): <strong>${formatCurrency(gstAmount)}</strong></div>
                <div style="font-size:15px;color:#1e40af;margin-top:4px;">Grand Total: <strong>${formatCurrency(grandTotal)}</strong></div>
              </div>
              ${g('inv-notes') ? `<div style="margin-top:10px;font-size:11px;color:#6b7280;"><strong>Notes:</strong> ${g('inv-notes')}</div>` : ''}
              ${g('inv-payment') ? `<div style="margin-top:4px;font-size:11px;color:#6b7280;"><strong>Payment Terms:</strong> ${g('inv-payment')}</div>` : ''}
              <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-top:15px;">
                ${qrSrc ? `<div><img src="${qrSrc}" style="max-height:60px;"><div style="font-size:9px;color:#6b7280;">Scan to Pay</div></div>` : '<div></div>'}
                ${signSrc ? `<div><img src="${signSrc}" style="max-height:40px;"><div style="font-size:9px;color:#6b7280;">Authorized Signature</div></div>` : ''}
              </div>
            </div>
          </div>
        `;
      }

      // Save draft settings
      async function saveBuilderSettings() {
        const g = (id) => (document.getElementById(id)?.value || '').trim();
        const getCheck = (id) => !!document.getElementById(id)?.checked;
        const getPreviewSrc = (id) => document.getElementById(id)?.querySelector('img')?.src || '';
        const logoSrc = getPreviewSrc('inv-logo-preview');
        const qrSrc = getPreviewSrc('inv-qr-preview');
        const signSrc = getPreviewSrc('inv-sign-preview');
        const rows = document.querySelectorAll('#inv-items-tbody tr');
        const items = [];
        rows.forEach(row => {
          items.push({
            desc: row.querySelector('.inv-item-desc')?.value || '',
            qty: Number(row.querySelector('.inv-item-qty')?.value || 1),
            rate: Number(row.querySelector('.inv-item-rate')?.value || 0)
          });
        });
        const settings = {
          companyName: g('inv-company-name'),
          companyTagline: g('inv-company-tagline'),
          contactPerson: g('inv-contact-person'),
          contactNumber: g('inv-contact-number'),
          contactEmail: g('inv-contact-email'),
          gst: g('inv-gst'),
          clientName: g('inv-client-name'),
          clientContact: g('inv-client-contact'),
          clientEmail: g('inv-client-email'),
          clientPhone: g('inv-client-phone'),
          clientAddress: g('inv-client-address'),
          invoiceNumber: g('inv-number'),
          invoiceDate: g('inv-date'),
          dueDate: g('inv-due-date'),
          status: g('inv-status'),
          notes: g('inv-notes'),
          paymentTerms: g('inv-payment'),
          logoUrl: logoSrc,
          qrUrl: qrSrc,
          signUrl: signSrc,
          isRecurring: getCheck('inv-is-recurring'),
          items
        };
        try {
          const { error } = await window.tmSupabase.from('crm_settings').upsert({ key: 'invoice_builder_settings', value: settings }, { onConflict: 'key' });
          if (error) throw error;
          showToast('Invoice builder settings saved', 'success');
        } catch (e) { showToast('Failed to save: ' + e.message, 'error'); }
      }

      // Save invoice to Supabase crm_invoices / crm_invoice_items
      async function saveInvoice() {
        const g = (id) => (document.getElementById(id)?.value || '').trim();
        const getCheck = (id) => !!document.getElementById(id)?.checked;
        if (!g('inv-client-name')) { showToast('Client name is required', 'error'); return; }
        if (!g('inv-number')) { showToast('Invoice number is required', 'error'); return; }
        const rows = document.querySelectorAll('#inv-items-tbody tr');
        let totalAmount = 0;
        const invoiceItems = [];
        rows.forEach(row => {
          const desc = row.querySelector('.inv-item-desc')?.value || '';
          const qty = Number(row.querySelector('.inv-item-qty')?.value || 1);
          const rate = Number(row.querySelector('.inv-item-rate')?.value || 0);
          const total = qty * rate;
          totalAmount += total;
          invoiceItems.push({ description: desc, quantity: qty, rate, total });
        });
        const gstAmount = totalAmount * 0.18;
        const grandTotal = totalAmount + gstAmount;

        const payload = {
          invoice_number: g('inv-number') || 'INV-' + Date.now(),
          customer_name: g('inv-client-name'),
          customer_email: g('inv-client-email'),
          customer_phone: g('inv-client-phone'),
          billing_address: g('inv-client-address'),
          total_amount: grandTotal,
          amount: totalAmount,
          status: g('inv-status') || 'pending',
          invoice_date: g('inv-date') || new Date().toISOString().split('T')[0],
          due_date: g('inv-due-date') || null,
          notes: g('inv-notes'),
          payment_instructions: g('inv-payment'),
          is_recurring: getCheck('inv-is-recurring'),
          items: invoiceItems
        };

        try {
          if (state.invoiceBuilderId) {
            const { data, error } = await window.tmSupabase.from('crm_invoices').update({
              invoice_number: payload.invoice_number,
              customer_name: payload.customer_name,
              customer_email: payload.customer_email,
              customer_phone: payload.customer_phone,
              billing_address: payload.billing_address,
              total_amount: payload.total_amount,
              status: payload.status,
              invoice_date: payload.invoice_date,
              due_date: payload.due_date,
              notes: payload.notes,
              payment_instructions: payload.payment_instructions,
              is_recurring: payload.is_recurring
            }).eq('id', state.invoiceBuilderId).select().single();
            if (error) throw error;

            await window.tmSupabase.from('crm_invoice_items').delete().eq('invoice_id', state.invoiceBuilderId);
            if (invoiceItems.length) {
              const itemRows = invoiceItems.map((it, idx) => ({
                invoice_id: state.invoiceBuilderId,
                description: it.description,
                quantity: it.quantity,
                rate: it.rate,
                amount: it.total,
                sort_order: idx
              }));
              const { error: itemsError } = await window.tmSupabase.from('crm_invoice_items').insert(itemRows);
              if (itemsError) throw itemsError;
            }

            const idx = state.data.invoices.findIndex(i => i.id === state.invoiceBuilderId);
            if (idx !== -1) {
              state.data.invoices[idx] = data;
            }
            showToast('Invoice updated successfully', 'success');
          } else {
            const { data: inv, error } = await window.tmSupabase.from('crm_invoices').insert({
              invoice_number: payload.invoice_number,
              customer_name: payload.customer_name,
              customer_email: payload.customer_email,
              customer_phone: payload.customer_phone,
              billing_address: payload.billing_address,
              total_amount: payload.total_amount,
              status: payload.status,
              invoice_date: payload.invoice_date,
              due_date: payload.due_date,
              notes: payload.notes,
              payment_instructions: payload.payment_instructions,
              is_recurring: payload.is_recurring
            }).select().single();
            if (error) throw error;

            if (invoiceItems.length && inv) {
              const itemRows = invoiceItems.map((it, idx) => ({
                invoice_id: inv.id,
                description: it.description,
                quantity: it.quantity,
                rate: it.rate,
                amount: it.total,
                sort_order: idx
              }));
              const { error: itemsError } = await window.tmSupabase.from('crm_invoice_items').insert(itemRows);
              if (itemsError) throw itemsError;
            }

            state.data.invoices.push(inv);
            showToast('Invoice saved successfully', 'success');
          }

          state.invoiceBuilderActive = false;
          state.invoiceBuilderId = null;
          await loadData();
        } catch (e) {
          showToast('Failed to save invoice: ' + e.message, 'error');
        }
      }

      // Bind save buttons
      const saveBtn = document.getElementById('inv-save-settings');
      if (saveBtn) saveBtn.addEventListener('click', saveBuilderSettings);
      const saveInvBtn = document.getElementById('inv-save-invoice');
      if (saveInvBtn) saveInvBtn.addEventListener('click', saveInvoice);

      // Bind all inputs for live preview
      document.querySelectorAll('#inv-builder-form input, #inv-builder-form select, #inv-builder-form textarea').forEach(el => {
        el.addEventListener('input', updatePreview);
        el.addEventListener('change', updatePreview);
      });

      // Initial preview
      updatePreview();

      // Load settings or invoice details
      if (state.invoiceBuilderId) {
        loadInvoiceData(state.invoiceBuilderId);
      } else {
        loadBuilderSettings();
      }
    }


