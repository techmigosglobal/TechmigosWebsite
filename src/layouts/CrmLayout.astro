      .crm-dashboard .crm-hero-grid > div:first-child > .crm-toolbar .crm-button { flex: 1 1 150px; min-height: 52px; font-size: 14px; }
      .crm-dashboard .crm-kpis,
      .crm-dashboard .crm-three-col { grid-template-columns: 1fr; }
      .crm-dashboard .crm-kpi { min-height: 124px; border-radius: 20px; padding: 20px; }
      .crm-dashboard .crm-kpi-icon { width: 62px; height: 62px; font-size: 27px; }
      .crm-dashboard .crm-kpi-label { font-size: 15px; }
      .crm-dashboard .crm-kpi-value { font-size: 26px; }
