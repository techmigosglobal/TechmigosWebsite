      gap: 14px;
      margin-top: 12px;
    }
    .inv-signature-pad-wrap,
    .inv-asset-current {
      border: 1px solid #d9e3ef;
      border-radius: 10px;
      background: #fff;
      padding: 10px;
    }
    .inv-signature-pad {
      display: block;
      width: 100%;
      height: 130px;
      margin-top: 8px;
      border: 1px dashed #94a3b8;
      border-radius: 8px;
      background: #fff;
      touch-action: none;
      cursor: crosshair;
