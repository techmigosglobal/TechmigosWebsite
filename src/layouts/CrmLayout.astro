        : profiles;
      // Live RBAC matrix — highlight current user's column
      const myColIdx = state.profile?.role === 'company_admin' ? 0 : state.profile?.role === 'client' ? 2 : 1;
      const rbacMatrix = [
        ['Dashboard',        '✅ Full',   '✅ Assigned work',      '—'],
        ['Projects',         '✅ Full',   '✅ Assigned only','✅ View own'],
        ['Project Files',    '✅ Full',   '✅ Assigned only','—'],
        ['Tickets',          '✅ Full',   '✅ Assigned only',      '✅ Own only'],
        ['Finance',          '✅ Full',   '—','—'],
        ['Analytics',        '✅ Full',   '—','—'],
        ['Reports',          '✅ Full',   '—','—'],
        ['Clients',          '✅ Full',   '👁 Linked only','✅ Own profile'],
        ['Employees',        '✅ Full',   '—','—'],
        ['User Management',  '✅ Full',   '🔒 Restricted','—'],
        ['Settings',         '✅ Full',   '🔒 Restricted','—'],
      ];
      const colHeaders = ['Module', 'Admin', 'Member', 'Client'];
      const rbacHtml = `<div class="crm-table-wrap"><table class="crm-table" style="font-size:12px;"><thead><tr>${colHeaders.map((h, i) => `<th style="${i === myColIdx + 1 ? 'background:#ede9fe;color:#7c3aed;' : ''}">${h}${i === myColIdx + 1 ? ' ★' : ''}</th>`).join('')}</tr></thead><tbody>${rbacMatrix.map(([mod,...cols]) => `<tr><td><strong>${mod}</strong></td>${cols.map((c, i) => `<td style="${i === myColIdx ? 'background:#f5f3ff;font-weight:800;' : ''}">${c}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;
      els.view.innerHTML = `${pageHead('User Management & Access Control', 'Create separate logins for clients and employees, assign roles, and manage permissions securely.', '<button class="crm-button primary" data-create="profiles" type="button">+ Create Login</button><button class="crm-button" id="btn-invite-user" type="button">Invite User</button><button class="crm-button" id="btn-data-review" type="button">Review data</button><button class="crm-button" data-export="users" type="button">Export</button>')}
        <div class="crm-grid crm-kpis">${metric('Total Users', profiles.length, '♧', 'blue', 'registered logins')}${metric('Client Logins', profiles.filter((item) => item.role === 'client').length, '○', 'green', 'client portal access')}${metric('Employee Logins', profiles.filter((item) => item.role !== 'client').length, '♙', 'purple', 'staff access')}${metric('Pending', profiles.filter((item) => item.status === 'pending').length, '▹', 'orange', 'awaiting activation')}</div>
        <div class="crm-two-col mt-5">
          <section class="crm-card">
            <div class="crm-card-head">
              <h2 class="crm-card-title">Access Directory</h2>
              <div class="crm-toolbar">
                <input class="crm-input" id="users-search" placeholder="Search users..." value="${escapeHtml(searchQuery)}" />
