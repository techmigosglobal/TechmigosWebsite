                <div class="crm-list-row"><span>Role</span>${badge(myRole, myRole === 'company_admin' ? 'purple' : 'blue')}</div>
                ${myPerms.map(([mod, perm]) => `<div class="crm-list-row"><span>${mod}</span><span style="font-size:12px;font-weight:700;">${perm}</span></div>`).join('')}
