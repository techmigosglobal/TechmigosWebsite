          <td><div class="dashboard-demo-client"><span>${crmProjectIcon('folder')}</span><strong>${escapeHtml(client)}</strong></div></td>
          <td><span class="dashboard-demo-status ${statusClass(project.status)}"><i></i>${escapeHtml(statusText(project.status))}</span></td>
          <td><div class="dashboard-demo-progress"><strong>${progressValue}%</strong><span><i style="width:${progressValue}%"></i></span></div></td>
          <td><div class="dashboard-demo-budget"><strong>${compactMoney(budget)}</strong><small>${spentPercent}% spent</small></div></td>
          <td class="dashboard-demo-due">${dateText(project.due_date)}</td>
          <td><div class="dashboard-demo-actions"><button class="dashboard-demo-more" data-dashboard-project-menu-trigger="${project.id}" type="button" aria-label="Actions for ${escapeHtml(project.name)}" aria-expanded="false">•••</button><div class="dashboard-demo-menu" data-dashboard-project-menu-panel="${project.id}"><button type="button" data-jump="projects">View</button>${canUpdate('projects') ? `<button type="button" data-edit-resource="projects" data-edit-id="${project.id}">Edit</button>` : ''}${canWrite('projects') ? `<button type="button" class="danger" data-delete-resource="projects" data-delete-id="${project.id}">Delete</button>` : ''}</div></div></td>
        </tr>`;
      }).join('');

      const stat = (label, value, icon, tone, notes) => `<article class="dashboard-demo-stat ${tone}"><span class="dashboard-demo-stat-icon">${crmProjectIcon(icon)}</span><div class="dashboard-demo-stat-content"><p>${label}</p><strong>${value}</strong><div class="dashboard-demo-stat-notes">${notes}</div></div></article>`;

      els.view.innerHTML = `<section class="dashboard-demo-header"><div><h1>Good evening, ${escapeHtml(state.profile?.name || 'Vinay')}!</h1><p>Here’s a quick overview of your business today.</p></div><button class="dashboard-demo-date" type="button" aria-label="Current reporting week"><span>${crmProjectIcon('calendar')}</span><strong>${currentWeekLabel()}</strong><b>⌄</b></button></section>
        <section class="dashboard-demo-stats" aria-label="Business overview">
          ${stat('Total Projects', projects.length, 'folder', 'green', `<span><i></i>${activeProjects.length} Active</span><span class="amber"><i></i>${onHoldProjects.length} On Hold</span>`)}
          ${stat('Active Clients', activeClients.length, 'clients', 'blue', '<span class="blue-dot"><i></i>0 new this week</span>')}
          ${stat('Open Tickets', openTickets.length, 'tickets', 'orange', `<span><i></i>${openTickets.length ? `${openTickets.length} open` : 'All clear'}</span>`)}
          ${stat('Revenue (Collected)', compactMoney(income), 'finance', 'green', `<span><i></i>${compactMoney(expenses)} expenses</span>`)}
          ${stat('Receivables', compactMoney(receivable), 'reports', 'red', `<span><i></i>${receivableRows.length} outstanding</span>`)}
        </section>
        <section class="dashboard-demo-quick-actions" aria-label="Quick actions"><div class="dashboard-demo-quick-title"><span>${crmProjectIcon('layers')}</span><div><h2>Quick Actions</h2><p>Get things done faster</p></div></div><div class="dashboard-demo-quick-buttons">${canWrite('projects') ? '<button class="dashboard-demo-quick-button primary" data-create="projects" type="button"><span>＋</span>New Project</button>' : ''}${canWrite('clients') ? '<button class="dashboard-demo-quick-button blue" data-create="clients" type="button"><span>♙</span>Add Client</button>' : ''}${canWrite('tickets') ? '<button class="dashboard-demo-quick-button orange" data-create="tickets" type="button"><span>◴</span>Create Ticket</button>' : ''}<button class="dashboard-demo-quick-button purple" data-jump="reports" type="button"><span>▥</span>View Reports</button></div></section>
        <section class="dashboard-demo-projects"><header class="dashboard-demo-projects-head"><div class="dashboard-demo-projects-title"><span>${crmProjectIcon('folder')}</span><div><h2>Your Projects</h2><p>All projects at a glance</p></div></div><div class="dashboard-demo-project-tools"><label><span class="sr-only">Search projects</span><b>${crmProjectIcon('reports')}</b><input id="dashboard-project-search" type="search" placeholder="Search projects..." value="${escapeHtml(state.dashboardProjectSearch)}" /></label><select id="dashboard-project-status" aria-label="Filter projects by status"><option value="">All Statuses</option><option value="active" ${state.dashboardProjectStatusFilter === 'active' ? 'selected' : ''}>Active</option><option value="on_hold" ${state.dashboardProjectStatusFilter === 'on_hold' ? 'selected' : ''}>On Hold</option><option value="completed" ${state.dashboardProjectStatusFilter === 'completed' ? 'selected' : ''}>Completed</option></select></div></header><div class="dashboard-demo-table-wrap"><table class="dashboard-demo-table"><thead><tr><th>PROJECT</th><th>CLIENT</th><th>STATUS</th><th>PROGRESS</th><th>BUDGET</th><th>DUE DATE</th><th>ACTIONS</th></tr></thead><tbody>${projectRows || '<tr><td colspan="7"><p class="crm-empty">No projects found.</p></td></tr>'}</tbody></table></div></section>`;

      document.getElementById('dashboard-project-search')?.addEventListener('input', (event) => { state.dashboardProjectSearch = event.target.value; renderDashboard(); bindActions(); });
      document.getElementById('dashboard-project-status')?.addEventListener('change', (event) => { state.dashboardProjectStatusFilter = event.target.value; renderDashboard(); bindActions(); });
      document.querySelectorAll('[data-dashboard-project-menu-trigger]').forEach((button) => button.addEventListener('click', (event) => {
        event.stopPropagation();
        document.querySelectorAll('.dashboard-demo-menu.is-open').forEach((menu) => menu.classList.remove('is-open'));
        const menu = document.querySelector(`[data-dashboard-project-menu-panel="${button.dataset.dashboardProjectMenuTrigger}"]`);
        menu?.classList.toggle('is-open');
        button.setAttribute('aria-expanded', menu?.classList.contains('is-open') ? 'true' : 'false');
      }));
    }

    function renderDashboard() {
      if (isEmployee()) return renderEmployeeDashboard();
      const projects = state.data.projects;
      const tickets = state.data.tickets;
      const collectedIncome = incomeRows();
      const settledExpenses = expenseRows();
      const income = sumAmounts(collectedIncome);
      const expenses = sumAmounts(settledExpenses);
      const openTickets = tickets.filter((item) => !['resolved', 'closed'].includes(item.status));
      const receivableRows = outstandingInvoiceRows();
      const receivable = sumAmounts(receivableRows);
      const activeProjects = projects.filter((project) => ['active', 'review', 'planning'].includes(project.status));
      const monthTrend = { months: [], incomeByMonth: [], expenseByMonth: [] };
      for (let i = 5; i >= 0; i--) {
        const date = new Date();
        date.setMonth(date.getMonth() - i);
        const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
        monthTrend.months.push(date.toLocaleString('en-IN', { month: 'short', year: '2-digit' }));
        monthTrend.incomeByMonth.push(collectedIncome.filter((item) => String(item.transaction_date || item.created_at || '').startsWith(key)).reduce((sum, item) => sum + Number(item.amount || 0), 0));
        monthTrend.expenseByMonth.push(settledExpenses.filter((item) => String(item.transaction_date || item.created_at || '').startsWith(key)).reduce((sum, item) => sum + Number(item.amount || 0), 0));
      }

      els.view.innerHTML = `${pageHead('Operations Dashboard', `${new Date().toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })} — Welcome back, ${escapeHtml(state.profile?.name || 'Team')}.`, `<div class="dashboard-welcome-note"><span class="dashboard-welcome-icon">${crmProjectIcon('layers')}</span><span>Great things happen with<br />focused teams.</span></div>`)}
        <div class="crm-grid crm-kpis dashboard-reference-kpis">
          ${metric('Active Projects', activeProjects.length, crmProjectIcon('folder'), 'blue', `${projects.filter((project) => project.status === 'completed').length} completed`)}
          ${metric('Open Tickets', openTickets.length, crmProjectIcon('tickets'), openTickets.length ? 'red' : 'green', openTickets.length ? `${openTickets.length} in queue` : 'Queue clear')}
          ${metric('Revenue Collected', compactMoney(income), crmProjectIcon('currency'), 'green', `${compactMoney(expenses)} expenses`)}
          ${metric('Receivables', compactMoney(receivable), crmProjectIcon('reports'), receivable > 0 ? 'orange' : 'green', receivable > 0 ? `${receivableRows.length} outstanding invoices` : 'All invoices settled')}
        </div>
        <div class="dashboard-reference-main">
          <section class="crm-card dashboard-reference-card dashboard-revenue-card"><div class="crm-card-head"><h2 class="crm-card-title">Revenue vs Expenses (6 months)</h2><button class="crm-link dashboard-period-link" data-jump="finance" type="button">Last 6 months <span aria-hidden="true">⌄</span></button></div><div class="dashboard-reference-chart-wrap"><canvas id="dash-revenue-chart"></canvas></div></section>
          <section class="crm-card dashboard-reference-card dashboard-focus-card"><div class="dashboard-focus-heading"><span class="dashboard-focus-icon" aria-hidden="true">${crmProjectIcon('layers')}</span><div><h2 class="crm-card-title">Today's Focus</h2><p>Quick actions to keep things moving.</p></div></div><div class="dashboard-focus-actions">${canWrite('projects') ? `<button class="dashboard-focus-action primary" data-create="projects" type="button"><span aria-hidden="true">${crmProjectIcon('folder')}</span>New Project</button>` : ''}${canWrite('tickets') ? `<button class="dashboard-focus-action" data-create="tickets" type="button"><span aria-hidden="true">${crmProjectIcon('tickets')}</span>New Ticket</button>` : ''}${canWrite('clients') ? `<button class="dashboard-focus-action" data-create="clients" type="button"><span aria-hidden="true">${crmProjectIcon('clients')}</span>Add Client</button>` : ''}<button class="dashboard-focus-action" data-jump="reports" type="button"><span aria-hidden="true">${crmProjectIcon('reports')}</span>Open Reports</button></div></section>
        </div>`;

      requestAnimationFrame(() => {
        const context = document.getElementById('dash-revenue-chart')?.getContext('2d');
        if (!context || !window.Chart) return;
        new window.Chart(context, {
          type: 'line',
          data: { labels: monthTrend.months, datasets: [
            { label: 'Revenue', data: monthTrend.incomeByMonth, borderColor: '#22c55e', backgroundColor: '#22c55e22', fill: true, tension: 0.4, pointRadius: 4, pointBackgroundColor: '#22c55e', borderWidth: 2 },
            { label: 'Expenses', data: monthTrend.expenseByMonth, borderColor: '#ef4444', backgroundColor: '#ef444422', fill: true, tension: 0.4, pointRadius: 4, pointBackgroundColor: '#ef4444', borderWidth: 2 },
          ] },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { font: { size: 10 }, boxWidth: 12 } } }, scales: { y: { ticks: { font: { size: 10 }, callback: (value) => `₹${value >= 1000 ? (value / 1000).toFixed(0) + 'k' : value}` }, grid: { color: '#f1f5f9' } }, x: { ticks: { font: { size: 10 } }, grid: { display: false } } } },
        });
      });
    }

    function renderEmployeeDashboard() {
      return renderEmployeeProjectView();
      /* Legacy delivery widgets remain below for reference but are not rendered. */
      const projects = state.data.projects;
      const tickets = state.data.tickets;
