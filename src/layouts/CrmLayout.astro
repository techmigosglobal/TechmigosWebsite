          .acc-proof-btn{display:inline-grid;place-items:center;width:30px;height:30px;border:1px solid #dbe5f0;border-radius:8px;background:#fff;color:#64748b;cursor:pointer;padding:0;transition:transform .1s,border-color .1s,background .1s,color .1s;line-height:1;}
          .acc-proof-btn:hover{transform:translateY(-1px);border-color:#99f6e4;background:#f0fdfa;color:#0f766e;}
          .acc-proof-btn.has-proof{border-color:#bbf7d0;background:#f0fdf4;color:#15803d;}
