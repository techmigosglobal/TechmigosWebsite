          { name: 'visibility', label: 'Visibility',  type: 'select',   html: `<select name="visibility">${selectOpts([['external','External (visible to client)'],['internal','Internal (team only)']], values.visibility || 'external')}</select>` },
        ],
      };
      return configs[resource] || configs.clients;
    }

    function formMarkup(resource, values = {}, submitLabel = 'Save') {
      const fields = createFields(resource, values);
      const rows = fields.map((f) => {
        const wide = f.wide ? 'wide' : '';
        const req = f.required ? ' required' : '';
        let input;
        if (f.type === 'html') {
          input = f.html;
        } else if (f.type === 'textarea') {
          input = `<textarea name="${f.name}"${req} placeholder="${f.placeholder || ''}">${escapeHtml(values[f.name] ?? '')}</textarea>`;
        } else {
          const extra = [
            f.min !== undefined ? `min="${f.min}"` : '',
            f.max !== undefined ? `max="${f.max}"` : '',
            f.step ? `step="${f.step}"` : '',
            f.placeholder ? `placeholder="${escapeHtml(f.placeholder)}"` : '',
          ].filter(Boolean).join(' ');
          input = `<input name="${f.name}" type="${f.type}"${req} value="${escapeHtml(values[f.name] ?? '')}" ${extra} />`;
        }
        return `<label class="${wide}">${f.label}${input}</label>`;
      });
      return `<form id="crm-edit-form" class="crm-form-grid">${rows.join('')}<button class="crm-button primary wide" type="submit">${submitLabel}</button></form>`;
    }

