          .acc-badge-invoice{background:#fef9c3;color:#a16207;}
          .acc-badge-other{background:#f1f5f9;color:#475569;}
          .acc-status-badge{display:inline-flex;align-items:center;gap:5px;padding:4px 9px;border-radius:999px;font-size:11px;font-weight:750;white-space:nowrap;}
          .acc-status-paid{background:#dcfce7;color:#16a34a;}
