            <div style="flex:1;min-width:0;">
              <h2 class="pm-detail-title">${escapeHtml(employee.name || employee.email)}</h2>
              <p class="pm-detail-client">${nice(employee.role || 'company_member')} &bull; ${escapeHtml(employee.department || 'No dept')}</p>
            </div>
          </div>
