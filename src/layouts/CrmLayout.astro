    .crm-dashboard .crm-kpis {
      gap: 25px;
      margin-bottom: 0 !important;
    }

    .crm-dashboard .crm-kpi {
      min-height: 170px;
      grid-template-columns: 84px 1fr;
      gap: 19px;
      border: 0;
      border-radius: 27px;
