    }

    .crm-dashboard .crm-card-title {
      font-size: 22px;
      letter-spacing: -0.025em;
    }

    .crm-dashboard .crm-link {
      font-size: 16px;
    }

    .crm-dashboard .dashboard-chart-wrap {
      height: 300px;
