    .crm-dashboard .crm-meta-note {
      font-size: 20px;
      line-height: 1.35;
    }

    .crm-dashboard .dashboard-alert,
    .crm-dashboard .crm-hero-meta > div[style*="fef3c7"] {
      display: flex;
      align-items: center;
      min-height: 52px;
      margin-top: auto !important;
      border-radius: 12px;
      background: #fff4c6;
      padding: 0 18px;
      color: #a24812;
      font-size: 16px !important;
      font-weight: 900 !important;
