          <input class="crm-input" placeholder="Service description" name="item_desc_${i}" value="${escapeHtml(item.description || '')}" required />
          <input class="crm-input" placeholder="Unit" name="item_unit_${i}" value="${escapeHtml(item.unit || 'Service')}" />
          <input class="crm-input" type="number" placeholder="Qty" name="item_qty_${i}" value="${escapeHtml(item.quantity || 1)}" min="0" step="any" />
          <input class="crm-input" type="number" placeholder="Rate per unit" name="item_rate_${i}" value="${escapeHtml(item.rate || 0)}" min="0" step="any" />
          <input class="crm-input" type="number" placeholder="= Qty × Rate" name="item_amount_${i}" value="${escapeHtml(item.amount || 0)}" min="0" step="any" readonly style="background:#f8faff;" />
