    .project-reference-stat {
      display: grid;
      min-width: 0;
      min-height: 160px;
      grid-template-columns: 64px minmax(0, 1fr);
      align-items: center;
      gap: 14px;
      border: 1px solid #e0e9f0;
      border-radius: 17px;
      background: rgba(255, 255, 255, 0.92);
      padding: 16px;
      box-shadow: 0 9px 24px rgba(15, 23, 42, 0.04);
    }

    .project-reference-stat-icon {
      display: grid;
      width: 64px;
      height: 64px;
      place-items: center;
      border-radius: 15px;
    }

    .project-reference-stat-icon svg {
      width: 30px;
      height: 30px;
      stroke-width: 2;
    }

    .project-reference-stat.green .project-reference-stat-icon { background: #ddf8ed; color: #08a568; }
    .project-reference-stat.blue .project-reference-stat-icon { background: #e3efff; color: #1769e8; }
    .project-reference-stat.orange .project-reference-stat-icon { background: #fff0da; color: #ee9200; }
    .project-reference-stat.red .project-reference-stat-icon { background: #ffe5e8; color: #f0444c; }

    .project-reference-stat-content {
      min-width: 0;
    }

    .project-reference-stat-content p {
      margin: 0;
      overflow: hidden;
      color: #49658e;
      font-size: 13px;
      font-weight: 850;
      line-height: 1.25;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .project-reference-stat-content > strong {
      display: block;
      margin-top: 8px;
      overflow: hidden;
      color: #101c35;
      font-size: clamp(24px, 1.9vw, 30px);
      font-weight: 950;
      letter-spacing: -0.06em;
      line-height: 1;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .project-reference-stat-notes {
      display: grid;
      gap: 5px;
      margin-top: 12px;
      color: #49658e;
      font-size: 12px;
      line-height: 1.2;
