    .project-reference-table {
      width: 100%;
      min-width: 900px;
      border-collapse: collapse;
      table-layout: fixed;
    }

    .project-reference-table th,
    .project-reference-table td {
      border-bottom: 1px solid #e8eef3;
      padding: 15px 20px;
      text-align: left;
      vertical-align: middle;
