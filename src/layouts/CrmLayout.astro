    .crm-analytics-page .analytics-finance-list strong {
      font-size: 15px;
      font-weight: 900;
    }

    .crm-analytics-page .analytics-finance-list .is-positive { color: #08a264; }
    .crm-analytics-page .analytics-finance-list .is-negative { color: #ef4444; }
    .crm-analytics-page .analytics-finance-list .is-warning { color: #f59e0b; }

    .crm-analytics-page .analytics-team-list {
      display: grid;
      min-height: 0;
      overflow: auto;
      padding: 13px 24px 14px;
    }

    .crm-analytics-page .analytics-team-row {
      display: grid;
      gap: 7px;
      min-height: 47px;
      padding: 8px 0;
    }

    .crm-analytics-page .analytics-team-row-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      color: #203e70;
      font-size: 14px;
    }

    .crm-analytics-page .analytics-team-row-head strong {
      color: #1d3967;
      font-weight: 850;
    }

    .crm-analytics-page .analytics-team-row-head span {
      color: #6d819e;
      font-size: 13px;
      font-weight: 750;
      white-space: nowrap;
    }

    .crm-analytics-page .analytics-team-track {
      height: 8px;
      overflow: hidden;
      border-radius: 99px;
