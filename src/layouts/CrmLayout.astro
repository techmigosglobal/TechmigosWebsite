          ${metric('Assigned projects', projects.length, '▣', 'blue', `${activeProjects.length} active`)}
          ${metric('Open tickets', openTickets.length, '◴', openTickets.length ? 'orange' : 'green', 'assigned delivery work')}
          ${metric('Project files', files.length, '▱', 'blue', 'internal only')}
        </div>
        <div class="crm-grid mt-5" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr));">
          <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">My projects</h2></div><div class="crm-list">${activeProjects.map((project) => `<button class="crm-list-row" data-jump="projects" type="button"><span>${escapeHtml(project.name)}</span><strong>${progress(project.progress)}</strong></button>`).join('') || '<p class="crm-empty">No projects are assigned yet.</p>'}</div></section>
          <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Recent files</h2></div><div class="crm-list">${recentFiles.map((file) => `<button class="crm-list-row" data-jump="files" type="button"><span>${escapeHtml(file.original_name)}</span><strong>${Math.ceil(Number(file.size_bytes || 0) / 1024)} KB</strong></button>`).join('') || '<p class="crm-empty">No internal files yet.</p>'}</div></section>
        </div>`;
    }

