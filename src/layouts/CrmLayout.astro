    .crm-dashboard .crm-page-head {
      margin-bottom: 10px;
    }

    .crm-dashboard .crm-hero-panel {
      margin-bottom: 0 !important;
      min-height: 368px;
      border: 0;
      border-radius: 29px;
      padding: 42px;
      background:
        radial-gradient(circle at 92% 50%, rgba(31, 175, 165, 0.22), transparent 32%),
        linear-gradient(112deg, #10182b 0%, #10202c 55%, #17685f 100%);
      box-shadow: 0 24px 54px rgba(15, 23, 42, 0.13);
