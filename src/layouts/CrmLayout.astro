      align-items: center;
      justify-content: flex-end;
      gap: 12px;
    }

    .project-reference-table-tools label {
      position: relative;
      display: block;
      width: 305px;
    }

    .project-reference-table-tools label b {
      position: absolute;
      top: 50%;
