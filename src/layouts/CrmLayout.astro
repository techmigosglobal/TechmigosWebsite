    function renderProjectReference() {
      const allProjects = state.data.projects;
      els.view.classList.toggle('employee-projects-view', isEmployee());
      const searchQ = state.projectSearch || '';
      const searchLower = searchQ.toLowerCase();
      const filteredProjects = allProjects.filter((project) => {
        const statusMatch = !state.projectStatusFilter || project.status === state.projectStatusFilter;
        const searchMatch = !searchLower || ['name', 'client_name', 'project_manager', 'status'].some((key) => String(project[key] || '').toLowerCase().includes(searchLower));
        return statusMatch && searchMatch;
      });
      const openTickets = state.data.tickets.filter((ticket) => !['resolved', 'closed'].includes(ticket.status));
      const activeProjectCount = allProjects.filter((project) => ['planning', 'active', 'review'].includes(project.status)).length;
      const onHoldCount = allProjects.filter((project) => project.status === 'on_hold').length;
      const activeClientCount = state.data.clients.filter((client) => !['inactive', 'archived'].includes(client.status)).length;
      const income = sumAmounts(incomeRows());
      const expenses = sumAmounts(expenseRows());
      const receivableRows = outstandingInvoiceRows();
      const receivable = sumAmounts(receivableRows);
      const greetingHour = new Date().getHours();
      const greeting = greetingHour < 12 ? 'Good morning' : greetingHour < 17 ? 'Good afternoon' : 'Good evening';
      const userName = state.profile?.name || 'Team';
      const statusLabel = (status) => ({ planning: 'Planning', active: 'Active', review: 'In Review', on_hold: 'On Hold', completed: 'Completed', cancelled: 'Cancelled' }[status] || nice(status));
      const dateLabel = (date) => date ? new Date(date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
      const spentPercent = (project) => project.budget ? Math.min(100, Math.round((Number(project.expenses || 0) / Number(project.budget)) * 100)) : 0;
      const stat = (label, value, icon, tone, notes) => `<article class="project-reference-stat ${tone}">
        <span class="project-reference-stat-icon">${crmProjectIcon(icon)}</span>
        <div class="project-reference-stat-content"><p>${label}</p><strong>${value}</strong><div class="project-reference-stat-notes">${notes}</div></div>
      </article>`;
      const projectRows = filteredProjects.map((project) => {
        const progressValue = Math.max(0, Math.min(100, Number(project.progress || 0)));
        const spent = Number(project.expenses || 0);
        const budget = Number(project.budget || 0);
        const spentPct = spentPercent(project);
        const client = project.client_name || clientName(project.client_id) || 'TechMigos';
        const projectType = project.client_id || project.client_name ? client : 'Internal project';
        return `<tr class="project-reference-row" data-resource="projects" data-row-id="${project.id}">
          <td><div class="project-reference-name"><strong>${escapeHtml(project.name)}</strong><small>${escapeHtml(projectType)}</small></div></td>
          <td><div class="project-reference-client"><span>${crmProjectIcon('folder')}</span><strong>${escapeHtml(client)}</strong></div></td>
          <td><span class="project-reference-status ${statusTone(project.status)}"><i></i>${escapeHtml(statusLabel(project.status))}</span></td>
          <td><div class="project-reference-progress"><strong>${progressValue}%</strong><span><i style="width:${progressValue}%"></i></span></div></td>
          <td><div class="project-reference-budget"><strong>${compactMoney(budget)}</strong><small>${spentPct}% spent</small></div></td>
          <td class="project-reference-due">${dateLabel(project.due_date)}</td>
          <td><div class="project-reference-actions"><button class="project-reference-action" data-project-detail="${project.id}" type="button">View</button><button class="project-reference-action" data-project-files-open="${project.id}" type="button">Files</button>${canUpdate('projects') ? `<button class="project-reference-action" type="button" data-edit-resource="projects" data-edit-id="${project.id}">Edit</button>` : ''}${canWrite('projects') ? `<button class="project-reference-action danger" type="button" data-delete-resource="projects" data-delete-id="${project.id}">Delete</button>` : ''}</div></td>
        </tr>`;
      }).join('');

      els.view.innerHTML = `
        <section class="project-reference-header">
          <div><h1>${greeting}, ${escapeHtml(userName)}!</h1><p>Here’s a quick overview of your business today.</p></div>
          <button class="project-reference-date" type="button" aria-label="Current reporting week"><span>${crmProjectIcon('reports')}</span><strong>${currentWeekLabel()}</strong><b>⌄</b></button>
        </section>

        <section class="project-reference-stats" aria-label="Project overview">
          ${stat('Total Projects', allProjects.length, 'folder', 'green', `<span><i></i>${activeProjectCount} Active</span><span class="amber"><i></i>${onHoldCount} On Hold</span>`)}
          ${stat('Active Clients', activeClientCount, 'clients', 'blue', '<span class="blue-dot"><i></i>0 new this week</span>')}
           ${stat('Open Tickets', openTickets.length, 'tickets', 'orange', `<span><i></i>${openTickets.length ? `${openTickets.length} open` : 'All clear'}</span>`)}
           ${isEmployee() ? '' : stat('Revenue (Collected)', compactMoney(income), 'currency', 'green', `<span><i></i>${compactMoney(expenses)} expenses</span>`)}
           ${isEmployee() ? '' : stat('Receivables', compactMoney(receivable), 'reports', 'red', `<span><i></i>${receivableRows.length} outstanding</span>`)}
        </section>

        <section class="project-reference-quick-actions" aria-label="Quick actions">
          <div class="project-reference-quick-title"><span>${crmProjectIcon('reports')}</span><div><h2>Quick Actions</h2><p>Get things done faster</p></div></div>
          <div class="project-reference-quick-buttons">
            ${canWrite('projects') ? `<button class="project-reference-quick-button primary" data-create="projects" type="button"><span>${crmProjectIcon('folder')}</span>New Project</button>` : ''}
            ${canWrite('clients') ? `<button class="project-reference-quick-button blue" data-create="clients" type="button"><span>${crmProjectIcon('clients')}</span>Add Client</button>` : ''}
            ${canWrite('tickets') ? `<button class="project-reference-quick-button orange" data-create="tickets" type="button"><span>${crmProjectIcon('tickets')}</span>Create Ticket</button>` : ''}
            ${isEmployee() ? `<button class="project-reference-quick-button purple" data-jump="files" type="button"><span>${crmProjectIcon('folder')}</span>Project Files</button>` : `<button class="project-reference-quick-button purple" data-jump="reports" type="button"><span>${crmProjectIcon('reports')}</span>View Reports</button>`}
          </div>
        </section>

        <section class="project-reference-table-card">
          <header class="project-reference-table-head">
            <div class="project-reference-table-title"><span>${crmProjectIcon('folder')}</span><div><h2>Your Projects</h2><p>All projects at a glance</p></div></div>
            <div class="project-reference-table-tools"><label><span class="sr-only">Search projects</span><b>${crmProjectIcon('reports')}</b><input id="pm-search" type="search" placeholder="Search projects..." value="${escapeHtml(searchQ)}" /></label><select id="project-status-filter" aria-label="Filter projects by status"><option value="">All Statuses</option><option value="planning" ${state.projectStatusFilter === 'planning' ? 'selected' : ''}>Planning</option><option value="active" ${state.projectStatusFilter === 'active' ? 'selected' : ''}>Active</option><option value="review" ${state.projectStatusFilter === 'review' ? 'selected' : ''}>In Review</option><option value="on_hold" ${state.projectStatusFilter === 'on_hold' ? 'selected' : ''}>On Hold</option><option value="completed" ${state.projectStatusFilter === 'completed' ? 'selected' : ''}>Completed</option></select></div>
          </header>
          <div class="project-reference-table-wrap"><table class="project-reference-table"><thead><tr><th>PROJECT</th><th>CLIENT</th><th>STATUS</th><th>PROGRESS</th><th>BUDGET</th><th>DUE DATE</th><th>ACTIONS</th></tr></thead><tbody>${projectRows || '<tr><td colspan="7"><p class="crm-empty">No projects found.</p></td></tr>'}</tbody></table></div>
        </section>`;

      document.getElementById('pm-search')?.addEventListener('input', (event) => { state.projectSearch = event.target.value; renderProjects(); bindActions(); });
      document.getElementById('project-status-filter')?.addEventListener('change', (event) => { state.projectStatusFilter = event.target.value; renderProjects(); bindActions(); });
      document.querySelectorAll('[data-project-menu-trigger]').forEach((button) => button.addEventListener('click', (event) => {
        event.stopPropagation();
        document.querySelectorAll('.project-reference-menu.is-open').forEach((menu) => menu.classList.remove('is-open'));
        const menu = document.querySelector(`[data-project-menu-panel="${button.dataset.projectMenuTrigger}"]`);
        menu?.classList.toggle('is-open');
        button.setAttribute('aria-expanded', menu?.classList.contains('is-open') ? 'true' : 'false');
      }));
      document.querySelectorAll('[data-project-files-open]').forEach((button) => button.addEventListener('click', () => {
        window.location.href = `/company/files?project=${encodeURIComponent(button.dataset.projectFilesOpen || '')}`;
      }));
      document.querySelectorAll('[data-project-detail]').forEach((button) => button.addEventListener('click', (event) => {
        event.stopImmediatePropagation();
        const project = allProjects.find((item) => String(item.id) === String(button.dataset.projectDetail));
        if (!project) return;
        els.modalTitle.textContent = 'Project details';
        els.modalBody.innerHTML = projectDetail(project);
        els.modal.classList.add('open');
        els.modalBody.querySelectorAll('[data-jump]').forEach((action) => action.addEventListener('click', () => {
          const target = action.dataset.jump;
          window.location.href = `/company/${target === 'users' ? 'user-management' : target}`;
        }));
        els.modalBody.querySelectorAll('[data-edit-resource]').forEach((action) => action.addEventListener('click', () => openEdit(action.dataset.editResource, action.dataset.editId)));
        els.modalBody.querySelectorAll('[data-create]').forEach((action) => action.addEventListener('click', () => openCreate(action.dataset.create)));
      }));
    }

    function renderProjectReferenceV2() {
      const allProjects = state.data.projects;
      const isActiveProject = (project) => ['planning', 'active', 'review'].includes(project.status);
      const isAtRiskProject = (project) => ['watch', 'at_risk', 'breached'].includes(project.health);
      const statusFilter = state.projectStatusFilter || '';
      const searchQ = state.projectSearch || '';
      const searchLower = searchQ.trim().toLowerCase();
      const activeProjectCount = allProjects.filter(isActiveProject).length;
      const atRiskCount = allProjects.filter(isAtRiskProject).length;
      const completedCount = allProjects.filter((project) => project.status === 'completed').length;
      const milestoneCount = allProjects.reduce((total, project) => total + (Array.isArray(project.milestones) ? project.milestones.length : 0), 0);
      const filteredProjects = allProjects.filter((project) => {
        const statusMatch = !statusFilter
          || (statusFilter === 'active' ? isActiveProject(project) : statusFilter === 'at_risk' ? isAtRiskProject(project) : project.status === statusFilter);
        const searchMatch = !searchLower || ['name', 'client_name', 'project_manager', 'status', 'health'].some((key) => String(project[key] || '').toLowerCase().includes(searchLower));
        return statusMatch && searchMatch;
      });
      const statusLabel = (status) => ({ planning: 'Planning', active: 'Active', review: 'In Review', on_hold: 'On Hold', completed: 'Completed', cancelled: 'Cancelled' }[status] || nice(status));
      const dateLabel = (date) => date ? new Date(date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
      const projectTeam = (project) => {
        const memberIds = new Set(state.data.project_members.filter((member) => String(member.project_id) === String(project.id)).map((member) => String(member.profile_id)));
        const people = state.data.profiles.filter((profile) => memberIds.has(String(profile.id)) || String(profile.auth_user_id) === String(project.owner_user_id));
        const names = people.map((person) => person.name || person.email).filter(Boolean);
        return names.length ? names : (project.project_manager ? [project.project_manager] : []);
      };
      const stat = (label, value, icon, tone, note) => `<article class="project-reference-stat ${tone}"><span class="project-reference-stat-icon">${crmProjectIcon(icon)}</span><div class="project-reference-stat-content"><p>${label}</p><strong>${value}</strong><div class="project-reference-stat-notes"><span><i></i>${note}</span></div></div></article>`;
      const rows = filteredProjects.map((project) => {
        const progressValue = Math.max(0, Math.min(100, Number(project.progress || 0)));
        const budget = Number(project.budget || 0);
        const client = project.client_name || clientName(project.client_id) || 'Internal project';
        const team = projectTeam(project);
        const teamLabel = team.length ? team.slice(0, 2).join(', ') : 'Unassigned';
        const teamExtra = team.length > 2 ? ` +${team.length - 2}` : '';
        const statusToneClass = isAtRiskProject(project) ? 'red' : statusTone(project.status);
        const menuId = `project-menu-${project.id}`;
        return `<tr class="project-reference-row" data-resource="projects" data-row-id="${project.id}">
          <td class="project-reference-select-cell" data-label="Select"><input type="checkbox" data-row-select aria-label="Select ${escapeHtml(project.name)}" onclick="event.stopPropagation()" /></td>
          <td data-label="Project"><div class="project-reference-name"><strong>${escapeHtml(project.name)}</strong><small>${escapeHtml(project.summary || 'No summary added yet.')}</small></div></td>
          <td data-label="Client"><div class="project-reference-client"><span>${crmProjectIcon('clients')}</span><strong>${escapeHtml(client)}</strong></div></td>
          <td data-label="Progress"><div class="project-reference-progress"><strong>${progressValue}%</strong><span><i style="width:${progressValue}%"></i></span></div></td>
          <td data-label="Status"><span class="project-reference-status ${statusToneClass}"><i></i>${escapeHtml(statusLabel(project.status))}</span></td>
          <td data-label="Team"><div class="project-reference-team"><span class="project-reference-team-avatars">${team.slice(0, 3).map((person) => `<i title="${escapeHtml(person)}">${escapeHtml(String(person).trim().slice(0, 1).toUpperCase())}</i>`).join('') || '<i class="is-empty">—</i>'}</span><strong>${escapeHtml(teamLabel)}${teamExtra}</strong></div></td>
          <td data-label="Budget"><div class="project-reference-budget"><strong>${compactMoney(budget)}</strong><small>${Number(project.expenses || 0) ? `${compactMoney(project.expenses)} spent` : 'No spend recorded'}</small></div></td>
          <td data-label="Due date" class="project-reference-due">${dateLabel(project.due_date)}</td>
          <td data-label="Actions"><div class="project-reference-actions"><button class="project-reference-more" data-project-menu-trigger="${project.id}" type="button" aria-controls="${menuId}" aria-label="Actions for ${escapeHtml(project.name)}" aria-expanded="false">${crmProjectIcon('more')}</button><div class="project-reference-menu" id="${menuId}" data-project-menu-panel="${project.id}"><button data-project-detail="${project.id}" type="button">View details</button><button data-project-files-open="${project.id}" type="button">Open files</button>${canUpdate('projects') ? `<button data-edit-resource="projects" data-edit-id="${project.id}" type="button">Edit project</button>` : ''}${canWrite('projects') ? `<button class="danger" data-delete-resource="projects" data-delete-id="${project.id}" type="button">Delete</button>` : ''}</div></div></td>
        </tr>`;
      }).join('');
      const tabs = [['', 'All Projects', allProjects.length], ['active', 'Active', activeProjectCount], ['at_risk', 'At Risk', atRiskCount], ['completed', 'Completed', completedCount]].map(([key, label, count]) => `<button type="button" class="project-reference-tab${statusFilter === key ? ' active' : ''}" data-project-status-tab="${key}" role="tab" aria-selected="${statusFilter === key ? 'true' : 'false'}">${label}<small>${count}</small></button>`).join('');

      els.view.innerHTML = `<section class="project-reference-header"><div><h1>Project Management</h1><p>Plan. Track. Collaborate. Deliver.</p></div>${canWrite('projects') ? '<button class="project-reference-header-action crm-button primary" data-create="projects" type="button">+ New Project</button>' : ''}</section>
        <section class="project-reference-stats" aria-label="Project overview">${stat('Total Projects', allProjects.length, 'folder', 'blue', 'Live workspace total')}${stat('Active Projects', activeProjectCount, 'layers', 'green', 'Planning, active, and review')}${stat('At Risk', atRiskCount, 'tickets', 'red', atRiskCount ? 'Needs attention' : 'No risk flags')}${stat('Completed', completedCount, 'reports', 'green', 'Delivered projects')}${stat('Milestones', milestoneCount, 'calendar', 'purple', 'From linked milestone data')}</section>
        <nav class="project-reference-tabs" aria-label="Project status filters">${tabs}</nav>
        <section class="project-reference-table-card"><header class="project-reference-table-head"><div class="project-reference-table-title"><span>${crmProjectIcon('folder')}</span><div><h2>All Projects</h2><p>Every project at a glance</p></div></div><div class="project-reference-table-tools"><label><span class="sr-only">Search projects</span><b>${crmProjectIcon('reports')}</b><input id="pm-search" type="search" placeholder="Search projects..." value="${escapeHtml(searchQ)}" /></label><select id="project-status-filter" aria-label="Filter projects by status"><option value="">All Statuses</option><option value="planning" ${statusFilter === 'planning' ? 'selected' : ''}>Planning</option><option value="active" ${statusFilter === 'active' ? 'selected' : ''}>Active</option><option value="review" ${statusFilter === 'review' ? 'selected' : ''}>In Review</option><option value="on_hold" ${statusFilter === 'on_hold' ? 'selected' : ''}>On Hold</option><option value="completed" ${statusFilter === 'completed' ? 'selected' : ''}>Completed</option><option value="at_risk" ${statusFilter === 'at_risk' ? 'selected' : ''}>At Risk</option></select><button class="project-reference-filter-button" type="button" data-project-clear-filters ${!statusFilter && !searchQ ? 'disabled' : ''}>Clear filters</button></div></header><div class="project-reference-table-wrap"><table class="project-reference-table"><thead><tr><th aria-label="Select"></th><th>PROJECT</th><th>CLIENT</th><th>PROGRESS</th><th>STATUS</th><th>TEAM</th><th>BUDGET</th><th>DUE DATE</th><th>ACTIONS</th></tr></thead><tbody>${rows || '<tr><td colspan="9"><p class="crm-empty">No projects found.</p></td></tr>'}</tbody></table></div></section>`;

      document.getElementById('pm-search')?.addEventListener('input', (event) => { state.projectSearch = event.target.value; renderProjects(); bindActions(); });
      document.getElementById('project-status-filter')?.addEventListener('change', (event) => { state.projectStatusFilter = event.target.value; renderProjects(); bindActions(); });
      document.querySelectorAll('[data-project-status-tab]').forEach((button) => button.addEventListener('click', () => { state.projectStatusFilter = button.dataset.projectStatusTab || ''; renderProjects(); bindActions(); }));
      document.querySelector('[data-project-clear-filters]')?.addEventListener('click', () => { state.projectStatusFilter = ''; state.projectSearch = ''; renderProjects(); bindActions(); });
      document.querySelectorAll('[data-project-menu-trigger]').forEach((button) => button.addEventListener('click', (event) => {
        event.stopPropagation();
        document.querySelectorAll('.project-reference-menu.is-open').forEach((menu) => menu.classList.remove('is-open'));
        const menu = document.querySelector(`[data-project-menu-panel="${button.dataset.projectMenuTrigger}"]`);
        menu?.classList.toggle('is-open');
        button.setAttribute('aria-expanded', menu?.classList.contains('is-open') ? 'true' : 'false');
      }));
      document.querySelectorAll('[data-project-files-open]').forEach((button) => button.addEventListener('click', () => { window.location.href = `/company/files?project=${encodeURIComponent(button.dataset.projectFilesOpen || '')}`; }));
      document.querySelectorAll('[data-project-detail]').forEach((button) => button.addEventListener('click', (event) => {
        event.stopPropagation();
        const project = allProjects.find((item) => String(item.id) === String(button.dataset.projectDetail));
        if (!project) return;
        els.modalTitle.textContent = 'Project details';
        els.modalBody.innerHTML = projectDetail(project);
        els.modal.classList.add('open');
        els.modalBody.querySelectorAll('[data-jump]').forEach((action) => action.addEventListener('click', () => { window.location.href = `/company/${action.dataset.jump === 'users' ? 'user-management' : action.dataset.jump}`; }));
        els.modalBody.querySelectorAll('[data-edit-resource]').forEach((action) => action.addEventListener('click', () => openEdit(action.dataset.editResource, action.dataset.editId)));
        els.modalBody.querySelectorAll('[data-create]').forEach((action) => action.addEventListener('click', () => openCreate(action.dataset.create)));
      }));
    }

    function renderProjects() {
      return renderProjectReferenceV2();
    }

    function renderProjectsLegacy() {
      const view = state.projectView || 'board';
      let allProjects = state.data.projects;
      if (state.projectStatusFilter) allProjects = allProjects.filter((p) => p.status === state.projectStatusFilter);
      const searchQ = state.projectSearch || '';
      if (searchQ) allProjects = allProjects.filter((p) => ['name','client_name','project_manager','status'].some((k) => String(p[k]||'').toLowerCase().includes(searchQ.toLowerCase())));

      const selected = state.data.projects.find((p) => String(p.id) === String(state.selectedProjectId)) || state.data.projects[0];
      state.selectedProjectId = selected?.id || null;

      const totalBudget = state.data.projects.reduce((s, p) => s + Number(p.budget || 0), 0);
      const totalSpent = state.data.projects.reduce((s, p) => s + Number(p.expenses || 0), 0);
      const completed = state.data.projects.filter((p) => p.status === 'completed').length;
      const active = state.data.projects.filter((p) => ['active','review'].includes(p.status)).length;
      const atRisk = state.data.projects.filter((p) => ['watch','at_risk','breached'].includes(p.health)).length;

      const kpiBar = `<div class="crm-grid crm-kpis">
        ${metric('Total Projects', state.data.projects.length, '▣', 'blue', `${active} currently active`)}
        ${metric('Completed', completed, '✓', 'green', `${state.data.projects.length - completed} remaining`)}
        ${metric('At-Risk', atRisk, '!', 'orange', atRisk ? 'needs attention' : 'all healthy')}
        ${metric('Total Budget', compactMoney(totalBudget), '₹', 'purple', `${compactMoney(totalSpent)} spent`)}
        ${metric('Open Tickets', state.data.tickets.filter((t) => !['resolved','closed'].includes(t.status)).length, '◴', 'red', 'across all projects')}
      </div>`;

      const STYLES = `<style>
