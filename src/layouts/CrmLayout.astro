          { name: 'body',              label: 'Message Body',    type: 'textarea', wide: true, placeholder: 'Campaign message...' },
          { name: 'msg91_template_id', label: 'MSG91 Template ID', type: 'text',   placeholder: 'Template ID from MSG91 dashboard' },
          { name: 'status',            label: 'Status',          type: 'select',   html: `<select name="status">${selectOpts([['draft','Draft'],['scheduled','Scheduled'],['sent','Sent'],['cancelled','Cancelled']], values.status || 'draft')}</select>` },
          { name: 'scheduled_at',      label: 'Schedule Date',   type: 'date' },
