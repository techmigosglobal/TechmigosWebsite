    function ensureReportDates() {
      const now = new Date();
      const today = now.toISOString().slice(0, 10);
      const monthStart = new Date(now.getFullYear(), now.getMonth(), 1).toISOString().slice(0, 10);
      if (!state.reportFrom) state.reportFrom = monthStart;
      if (!state.reportTo) state.reportTo = today;
    }

    function reportDate(row, keys) {
      for (const key of keys) {
        if (row[key]) return String(row[key]).slice(0, 10);
      }
      return '';
    }

    function inReportRange(row, keys = ['created_at']) {
      const date = reportDate(row, keys);
      if (!date) return true;
      return (!state.reportFrom || date >= state.reportFrom) && (!state.reportTo || date <= state.reportTo);
    }

    function reportDefinitions() {
      ensureReportDates();
      const finances = state.data.finances.filter((row) => inReportRange(row, ['transaction_date', 'created_at']));
      const invoices = state.data.invoices.filter((row) => inReportRange(row, ['invoice_date', 'created_at']));
      const projects = state.data.projects.filter((row) => inReportRange(row, ['created_at', 'due_date']));
      const tickets = state.data.tickets.filter((row) => inReportRange(row, ['created_at']));
      const clients = state.data.clients.filter((row) => inReportRange(row, ['created_at']));
      const income = finances.filter((item) => ['income', 'revenue'].includes(item.transaction_type)).reduce((sum, item) => sum + Number(item.amount || 0), 0);
      const expenses = finances.filter((item) => ['expense', 'salary'].includes(item.transaction_type)).reduce((sum, item) => sum + Number(item.amount || 0), 0);
      const invoiceTotal = invoices.reduce((sum, item) => sum + Number(item.total_amount || 0), 0);
      const invoiceReceived = invoices.reduce((sum, item) => sum + Number(item.received_amount || 0), 0);

      return {
        executive: {
          title: 'Executive Summary Report',
          subtitle: 'Company-wide snapshot across projects, support, finance, and clients.',
          metrics: [
            ['Revenue', compactMoney(income + invoiceReceived), '₹', 'green'],
            ['Expenses', compactMoney(expenses), '▵', 'red'],
            ['Open Tickets', tickets.filter((item) => !['resolved', 'closed'].includes(item.status)).length, '◴', 'orange'],
            ['Active Projects', state.data.projects.filter((item) => ['planning', 'active', 'review'].includes(item.status)).length, '▣', 'blue'],
          ],
          columns: [['area', 'Area'], ['value', 'Value'], ['notes', 'Notes']],
          rows: [
            { area: 'Projects', value: state.data.projects.length, notes: `${state.data.projects.filter((item) => item.health === 'at_risk').length} at risk` },
            { area: 'Finance', value: compactMoney((income + invoiceReceived) - expenses), notes: 'Net after recorded expenses' },
            { area: 'Invoices', value: compactMoney(invoiceTotal - invoiceReceived), notes: 'Outstanding balance' },
            { area: 'Tickets', value: tickets.length, notes: `${tickets.filter((item) => ['urgent', 'high'].includes(item.priority)).length} high priority` },
            { area: 'Clients', value: clients.length, notes: `${clients.filter((item) => item.status === 'active').length} active` },
          ],
        },
        finance: {
          title: 'Finance Report',
          subtitle: 'Invoices, income, expense, salary, and payment status in the selected period.',
          metrics: [
            ['Income', compactMoney(income), '₹', 'green'],
            ['Expenses', compactMoney(expenses), '▵', 'red'],
            ['Invoice Total', compactMoney(invoiceTotal), '▱', 'blue'],
            ['Outstanding', compactMoney(invoiceTotal - invoiceReceived), '!', 'orange'],
          ],
          columns: [['date', 'Date'], ['type', 'Type'], ['title', 'Title'], ['client', 'Client'], ['amount', 'Amount'], ['status', 'Status'], ['proof', 'Proof']],
          rows: [
            ...finances.map((item) => ({
              date: item.transaction_date || String(item.created_at || '').slice(0, 10),
              type: item.transaction_type,
              title: item.title || item.reference_id || '-',
              client: item.client || '-',
              amount: compactMoney(item.amount),
              status: item.status || '-',
              proof: item.proof_url ? 'Attached' : '-',
            })),
            ...invoices.map((item) => ({
              date: item.invoice_date || String(item.created_at || '').slice(0, 10),
              type: 'invoice',
              title: item.invoice_number || item.service_title || '-',
              client: item.customer_name || clientName(item.client_id),
              amount: compactMoney(item.total_amount),
              status: item.status || '-',
              proof: item.sign_url ? 'Signed' : '-',
            })),
          ],
        },
        projects: {
          title: 'Projects Report',
          subtitle: 'Project status, owner, budget, progress, and delivery health.',
          metrics: [
            ['Total Projects', projects.length, '▣', 'blue'],
            ['Completed', projects.filter((item) => item.status === 'completed').length, '✓', 'green'],
            ['At Risk', projects.filter((item) => ['watch', 'at_risk', 'breached'].includes(item.health)).length, '!', 'orange'],
            ['Budget', compactMoney(projects.reduce((sum, item) => sum + Number(item.budget || 0), 0)), '₹', 'blue'],
          ],
          columns: [['name', 'Project'], ['client', 'Client'], ['manager', 'Manager'], ['status', 'Status'], ['health', 'Health'], ['progress', 'Progress'], ['budget', 'Budget']],
          rows: projects.map((item) => ({
            name: item.name,
            client: item.client_name || clientName(item.client_id),
            manager: item.project_manager || '-',
            status: item.status,
            health: item.health,
            progress: `${Number(item.progress || 0)}%`,
            budget: compactMoney(item.budget),
          })),
        },
        tickets: {
          title: 'Support Tickets Report',
          subtitle: 'Ticket load, priorities, assignments, and resolution status.',
          metrics: [
            ['Tickets', tickets.length, '◴', 'blue'],
            ['Open', tickets.filter((item) => !['resolved', 'closed'].includes(item.status)).length, '!', 'orange'],
            ['Resolved', tickets.filter((item) => ['resolved', 'closed'].includes(item.status)).length, '✓', 'green'],
            ['Urgent', tickets.filter((item) => item.priority === 'urgent').length, '△', 'red'],
          ],
          columns: [['id', 'Ticket'], ['subject', 'Subject'], ['client', 'Client'], ['priority', 'Priority'], ['assigned_to', 'Assigned To'], ['status', 'Status']],
          rows: tickets.map((item) => ({
            id: `TIC-${item.id}`,
            subject: item.subject,
            client: clientName(item.client_id),
            priority: item.priority,
            assigned_to: item.assigned_to || 'Unassigned',
            status: item.status,
          })),
        },
        clients: {
          title: 'Clients Report',
          subtitle: 'Client records, contacts, project count, and billing total.',
          metrics: [
            ['Clients', clients.length, '○', 'blue'],
            ['Active', clients.filter((item) => item.status === 'active').length, '✓', 'green'],
            ['Lead Clients', clients.filter((item) => item.status === 'lead').length, '◎', 'orange'],
            ['Archived', clients.filter((item) => item.status === 'archived').length, '×', 'red'],
          ],
          columns: [['company', 'Company'], ['name', 'Contact'], ['email', 'Email'], ['phone', 'Phone'], ['status', 'Status'], ['projects', 'Projects'], ['billing', 'Billing']],
          rows: clients.map((item) => ({
            company: item.company || item.name,
            name: item.name || '-',
            email: item.email || '-',
            phone: item.phone || '-',
            status: item.status || 'active',
            projects: state.data.projects.filter((project) => String(project.client_id) === String(item.id)).length,
            billing: compactMoney(state.data.invoices.filter((invoice) => String(invoice.client_id) === String(item.id)).reduce((sum, invoice) => sum + Number(invoice.total_amount || 0), 0)),
          })),
        },
      };
    }

    function currentReport() {
      const reports = reportDefinitions();
      return reports[state.reportType] || reports.executive;
    }

    function reportTableRows(report) {
      return report.rows.map((row) => `<tr>${report.columns.map(([key]) => `<td>${escapeHtml(row[key] ?? '-')}</td>`).join('')}</tr>`).join('');
    }

