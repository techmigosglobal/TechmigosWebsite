      color: #63799a;
      font-size: clamp(17px, 1.45vw, 23px);
      font-weight: 650;
      letter-spacing: -0.025em;
      line-height: 1.3;
    }

    .files-reference-panel {
      min-width: 0;
      border: 1px solid #e0e9f2;
      border-radius: 22px;
      background: rgba(255, 255, 255, 0.93);
      padding: 25px 26px 26px;
      box-shadow: 0 16px 36px rgba(15, 23, 42, 0.045);
    }

    .files-reference-projects {
      display: grid;
      gap: 10px;
      margin-bottom: 22px;
    }

    .files-reference-projects-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .files-reference-projects-head h2 {
      margin: 0;
      color: #13223e;
      font-size: 17px;
      font-weight: 900;
      letter-spacing: -0.025em;
    }

    .files-reference-projects-head p,
    .files-reference-projects-count {
      margin: 3px 0 0;
      color: #7185a1;
      font-size: 12px;
      font-weight: 650;
    }

    .files-reference-projects-count {
      margin: 0;
      white-space: nowrap;
    }

    .files-reference-project-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
      min-width: 0;
      overflow: visible;
      padding: 1px;
    }

    .files-reference-project-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 14px;
      min-width: 0;
      min-height: 58px;
      padding: 7px 9px;
      border: 1px solid #dbe6f1;
      border-radius: 12px;
      background: #fff;
      transition: border-color .16s ease, box-shadow .16s ease, background .16s ease;
    }

    .files-reference-project-card.is-selected {
      border-color: #8bd8cd;
      background: #f4fffd;
      box-shadow: 0 0 0 2px rgba(15, 118, 110, .08);
    }

    .files-reference-project-select {
      display: flex;
      align-items: center;
      gap: 9px;
      min-width: 0;
      border: 0;
      padding: 3px;
      background: transparent;
      color: #142542;
      font: inherit;
      text-align: left;
      cursor: pointer;
    }

    .files-reference-project-actions {
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
      flex: 0 0 auto;
    }

    .files-reference-project-documents,
    .files-reference-project-upload {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 92px;
      height: 34px;
      padding: 0 12px;
      border: 1px solid #dbe6f1;
      border-radius: 9px;
      background: #fff;
      color: #17365f;
      font: inherit;
      font-size: 11px;
      font-weight: 850;
      white-space: nowrap;
      cursor: pointer;
    }

    .files-reference-project-documents:hover,
    .files-reference-project-upload:hover {
      border-color: #8bd8cd;
      background: #f4fffd;
      color: #0f766e;
    }

    .files-reference-project-upload {
      min-width: 112px;
      border-color: #b7ded8;
      background: #f2fffc;
      color: #0f766e;
    }

    .files-reference-project-icon {
      display: grid;
      place-items: center;
      width: 35px;
      height: 35px;
      flex: 0 0 auto;
      border-radius: 10px;
      background: #e7f8f4;
      color: #0f8f7f;
    }

    .files-reference-project-icon svg {
      width: 19px;
      height: 19px;
    }

    .files-reference-project-copy {
      display: grid;
      min-width: 0;
      gap: 3px;
    }

    .files-reference-project-copy strong,
    .files-reference-project-copy small {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .files-reference-project-copy strong {
      color: #142542;
      font-size: 13px;
      font-weight: 850;
    }

    .files-reference-project-copy small {
      color: #7185a1;
      font-size: 11px;
      font-weight: 650;
    }

    .files-reference-projects-empty {
      padding: 14px;
      border: 1px dashed #cbd9e8;
      border-radius: 12px;
      color: #7185a1;
      font-size: 12px;
      font-weight: 700;
      text-align: center;
    }

    .files-reference-controls {
      display: grid;
      grid-template-columns: minmax(170px, 1.05fr) minmax(170px, 1.05fr) minmax(230px, 1.5fr) minmax(140px, 0.84fr) minmax(150px, 0.9fr);
      align-items: end;
      gap: 14px;
      min-width: 0;
    }

    .files-reference-field {
      display: grid;
      min-width: 0;
      gap: 7px;
    }

    .files-reference-field > span:first-child {
      color: #526783;
      font-size: 14px;
      font-weight: 850;
      line-height: 1;
    }

    .files-reference-select,
    .files-reference-input,
    .files-reference-action {
      box-sizing: border-box;
      min-width: 0;
      height: 58px;
      border: 1px solid #dbe6f1;
      border-radius: 13px;
      background: #fff;
      color: #13223e;
      font-family: inherit;
      font-size: 16px;
      font-weight: 800;
    }

    .files-reference-select {
      width: 100%;
      appearance: none;
      background-image: linear-gradient(45deg, transparent 50%, #526783 50%), linear-gradient(135deg, #526783 50%, transparent 50%);
      background-position: calc(100% - 21px) 26px, calc(100% - 15px) 26px;
      background-repeat: no-repeat;
      background-size: 6px 6px, 6px 6px;
      padding: 0 42px 0 18px;
      cursor: pointer;
    }

    .files-reference-search-wrap {
      display: flex;
      align-items: center;
      min-width: 0;
      height: 58px;
      overflow: hidden;
      border: 1px solid #dbe6f1;
      border-radius: 13px;
      background: #fff;
    }

    .files-reference-search-icon {
      flex: 0 0 auto;
      margin-left: 18px;
      color: #5c789c;
      font-size: 27px;
      font-weight: 500;
      line-height: 1;
      transform: translateY(-2px);
    }

    .files-reference-input {
      width: 100%;
      height: 56px;
      border: 0;
      outline: 0;
      padding: 0 16px 0 11px;
    }

    .files-reference-input::placeholder {
      color: #7e91ad;
      opacity: 1;
    }

    .files-reference-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 0 14px;
      white-space: nowrap;
      cursor: pointer;
    }

    .files-reference-action svg {
      width: 22px;
      height: 22px;
      flex: 0 0 auto;
      color: #176ee0;
    }

    .files-reference-action--primary {
      border-color: #0f766e;
      background: #0f766e;
      color: #fff;
      box-shadow: 0 12px 24px rgba(15, 118, 110, 0.18);
    }

    .files-reference-action--primary svg {
      color: #fff;
    }

    .files-reference-action:disabled,
    .files-reference-action[aria-disabled="true"] {
      cursor: not-allowed;
      opacity: 0.55;
    }

    .files-reference-workspace {
      display: flex;
      min-height: 456px;
      align-items: center;
      justify-content: center;
      margin-top: 26px;
      border: 2px dashed #d2dfed;
      border-radius: 14px;
      background: linear-gradient(180deg, #fff 0%, #fcfdff 100%);
      overflow: hidden;
    }

    .files-reference-empty {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 452px;
      flex-direction: column;
      padding: 24px;
      text-align: center;
    }

    .files-reference-empty-illustration {
      display: grid;
      place-items: center;
      width: 160px;
      height: 160px;
      border-radius: 50%;
      background: #f1f7ff;
      color: #8eb5ed;
    }

    .files-reference-empty-illustration svg {
      width: 83px;
      height: 83px;
      stroke-width: 1.5;
    }

    .files-reference-empty h2 {
      margin: 18px 0 0;
      color: #101d38;
      font-size: 28px;
      font-weight: 950;
      letter-spacing: -0.045em;
    }

    .files-reference-empty p {
      margin: 8px 0 25px;
      color: #607899;
      font-size: 19px;
      font-weight: 600;
    }

    .files-reference-empty-action {
      display: inline-flex;
      min-width: 206px;
      height: 62px;
      align-items: center;
      justify-content: center;
      border: 0;
      border-radius: 13px;
      background: #0f8f7f;
      color: #fff;
      font-family: inherit;
      font-size: 17px;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 13px 24px rgba(15, 118, 110, 0.18);
    }

    .files-reference-folder-content {
      width: 100%;
      align-self: stretch;
      overflow: auto;
      padding: 17px;
    }

    .files-reference-breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 15px;
      color: #63799a;
      font-size: 13px;
      font-weight: 750;
    }

    .files-reference-breadcrumb button {
      border: 0;
      background: transparent;
      color: #0f766e;
      font: inherit;
      cursor: pointer;
      padding: 0;
    }

    .files-reference-folder-grid {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 12px;
    }

    .files-reference-folder-grid .crm-file-folder {
      min-height: 74px;
      border-color: #dce7f2;
      border-radius: 12px;
      box-shadow: none;
    }

    .files-reference-file-table {
      min-width: 0;
      margin-top: 18px;
    }

    .files-reference-file-table .crm-table-wrap {
      overflow: auto;
    }

    @media (min-width: 1181px) {
      body:has(.crm-files-page) {
        overflow: hidden;
      }

      .crm-app:has(.crm-files-page) {
        height: 100vh;
        min-height: 0;
        grid-template-columns: 294px minmax(0, 1fr);
      }

      .crm-app:has(.crm-files-page) .crm-main {
        height: 100vh;
        min-height: 0;
        grid-template-rows: 92px minmax(0, 1fr);
      }

      .crm-app:has(.crm-files-page) .crm-sidebar {
        height: 100vh;
      }

      .crm-app:has(.crm-files-page) .crm-content {
        height: calc(100vh - 92px);
        min-height: 0;
        overflow: hidden;
        padding: 34px 32px 36px;
      }

      .crm-files-page {
        height: 100%;
        min-height: 0;
        grid-template-rows: auto minmax(0, 1fr);
        overflow: hidden;
      }

      .files-reference-panel {
        display: flex;
        min-height: 0;
        flex-direction: column;
      }

      .files-reference-workspace {
        flex: 1;
        min-height: 0;
      }
    }

    @media (min-width: 1181px) and (max-height: 850px) {
      body:has(.crm-files-page) {
        overflow-y: auto;
      }

      .crm-app:has(.crm-files-page) .crm-content {
        height: auto;
        min-height: calc(100vh - 86px);
        overflow: visible;
        padding: 24px 28px 28px;
      }

      .crm-app:has(.crm-files-page) .crm-main {
        grid-template-rows: 86px auto;
      }

      .crm-files-page {
        height: auto;
        min-height: calc(100vh - 124px);
        overflow: visible;
        gap: 18px;
      }

      .files-reference-header h1 {
        font-size: 38px;
      }

      .files-reference-header p {
        margin-top: 7px;
        font-size: 16px;
      }

      .files-reference-panel {
        padding: 18px 20px 20px;
      }

      .files-reference-projects {
        margin-bottom: 16px;
      }

      .files-reference-projects-head h2 {
        font-size: 15px;
      }

      .files-reference-controls {
        gap: 10px;
      }

      .files-reference-field {
        gap: 5px;
      }

      .files-reference-field > span:first-child {
        font-size: 12px;
      }

      .files-reference-select,
      .files-reference-input,
      .files-reference-action,
      .files-reference-search-wrap {
        height: 50px;
        font-size: 14px;
      }

      .files-reference-select {
        background-position: calc(100% - 18px) 22px, calc(100% - 12px) 22px;
      }

      .files-reference-input {
        height: 48px;
      }

      .files-reference-workspace {
        min-height: 360px;
        margin-top: 18px;
      }

      .files-reference-empty {
        min-height: 356px;
      }

      .files-reference-empty-illustration {
        width: 120px;
        height: 120px;
      }

      .files-reference-empty-illustration svg {
        width: 63px;
        height: 63px;
      }

      .files-reference-empty h2 {
        margin-top: 12px;
        font-size: 23px;
      }

      .files-reference-empty p {
        margin: 6px 0 15px;
        font-size: 16px;
      }

      .files-reference-empty-action {
        min-width: 180px;
        height: 50px;
        font-size: 14px;
      }
    }

    @media (max-width: 1180px) {
      .files-reference-controls {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .files-reference-field--search {
        grid-column: 1 / -1;
      }

      .files-reference-action {
        width: 100%;
      }
    }

    @media (max-width: 640px) {
      .crm-files-page {
        gap: 16px;
      }

      .files-reference-header h1 {
        font-size: 34px;
      }

      .files-reference-header p {
        font-size: 16px;
      }

      .files-reference-panel {
        padding: 16px;
        border-radius: 16px;
      }

      .files-reference-project-list {
        grid-template-columns: 1fr;
      }

      .files-reference-project-card {
        grid-template-columns: 1fr;
        gap: 8px;
      }

      .files-reference-project-actions {
        width: 100%;
        justify-content: stretch;
      }

      .files-reference-project-documents,
      .files-reference-project-upload {
        flex: 1 1 0;
      }

      .files-reference-controls {
        grid-template-columns: 1fr;
      }

      .files-reference-field--search {
        grid-column: auto;
      }

      .files-reference-workspace {
        min-height: 330px;
      }

      .files-reference-empty {
        min-height: 326px;
      }

      .files-reference-empty-illustration {
        width: 104px;
        height: 104px;
      }

      .files-reference-empty h2 {
        font-size: 22px;
      }

      .files-reference-empty p {
        font-size: 15px;
      }
    }

    /* Analytics reference layout: compact insight cards arranged for one desktop view. */
    .crm-analytics-page .analytics-reference-middle,
    .crm-analytics-page .analytics-reference-bottom {
      display: grid;
      min-width: 0;
    }

    .crm-analytics-page .analytics-reference-middle {
      grid-template-columns: minmax(0, 1.5fr) minmax(250px, 0.82fr) minmax(280px, 1fr);
      gap: 16px;
    }

    .crm-analytics-page .analytics-reference-bottom {
      grid-template-columns: minmax(0, 1.2fr) minmax(340px, 1fr);
      gap: 16px;
    }

    .crm-analytics-page .analytics-card {
      min-width: 0;
      min-height: 0;
      overflow: hidden;
      border: 1px solid #dce7f1;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.95);
      box-shadow: 0 11px 26px rgba(15, 23, 42, 0.045);
    }

    .crm-analytics-page .analytics-card .crm-card-head {
      min-height: 58px;
      padding: 0 22px;
      border-bottom: 1px solid #e2eaf2;
    }

    .crm-analytics-page .analytics-card .crm-card-title {
      min-width: 0;
      color: #101d38;
      font-size: 18px;
      font-weight: 950;
      letter-spacing: -0.04em;
    }

    .crm-analytics-page .analytics-card-note {
      color: #7186a4;
      font-size: 14px;
      font-weight: 650;
      white-space: nowrap;
    }

    .crm-analytics-page .analytics-chart-area {
      position: relative;
      min-width: 0;
      height: calc(100% - 58px);
      padding: 10px 18px 12px;
    }

    .crm-analytics-page .analytics-chart-area canvas {
      display: block;
      width: 100% !important;
      height: 100% !important;
    }

    .crm-analytics-page .analytics-kpis {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      min-width: 0;
      margin: 0;
    }

    .crm-analytics-page .analytics-kpis .crm-kpi {
      display: grid;
      grid-template-columns: 84px minmax(0, 1fr);
      align-items: center;
      gap: 14px;
      min-width: 0;
      height: 100%;
      min-height: 0;
      overflow: hidden;
      border: 1px solid #e0e9f2;
      border-radius: 17px;
      padding: 18px 20px;
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
    }

    .crm-analytics-page .analytics-kpis .crm-kpi > div:last-child {
      min-width: 0;
    }

    .crm-analytics-page .analytics-kpis .crm-kpi-icon {
      display: grid;
      place-items: center;
      width: 84px;
      height: 84px;
      border-radius: 50%;
      font-size: 34px;
    }

    .crm-analytics-page .analytics-kpis .crm-kpi-label,
    .crm-analytics-page .analytics-kpis .crm-kpi-value,
    .crm-analytics-page .analytics-kpis .crm-trend {
      max-width: 100%;
      overflow: visible;
      text-overflow: clip;
      white-space: normal;
    }

    .crm-analytics-page .analytics-kpis .crm-kpi-label {
      color: #526989;
      font-size: 15px;
      line-height: 1.2;
    }

    .crm-analytics-page .analytics-kpis .crm-kpi-value {
      margin-top: 7px;
      color: #0f1c36;
      font-size: clamp(24px, 2.1vw, 32px);
      letter-spacing: -0.06em;
      line-height: 1;
    }

    .crm-analytics-page .analytics-kpis .crm-trend {
      margin-top: 8px;
      font-size: 13px;
      line-height: 1.2;
    }

    .crm-analytics-page .analytics-project-health-card,
    .crm-analytics-page .analytics-finance-card,
    .crm-analytics-page .analytics-team-card,
    .crm-analytics-page .analytics-ticket-card {
      display: flex;
      flex-direction: column;
    }

    .crm-analytics-page .analytics-project-chart {
      position: relative;
      height: 206px;
      min-height: 0;
      padding: 10px 28px 0;
    }

    .crm-analytics-page .analytics-project-chart canvas {
      display: block;
      width: 100% !important;
      height: 100% !important;
    }

    .crm-analytics-page .analytics-donut-center {
      position: absolute;
      top: 50%;
      left: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 92px;
      height: 92px;
      flex-direction: column;
      border-radius: 50%;
      background: #fff;
      transform: translate(-50%, -50%);
      text-align: center;
    }

    .crm-analytics-page .analytics-donut-center strong {
      color: #101d38;
      font-size: 24px;
      font-weight: 950;
      line-height: 1;
    }

    .crm-analytics-page .analytics-donut-center span {
      margin-top: 4px;
      color: #526989;
      font-size: 11px;
      font-weight: 700;
    }

    .crm-analytics-page .analytics-project-legend {
      display: grid;
      gap: 0;
      padding: 0 28px 14px;
    }

    .crm-analytics-page .analytics-project-legend-row,
    .crm-analytics-page .analytics-finance-list > div {
      display: grid;
      grid-template-columns: 14px minmax(0, 1fr) auto;
      align-items: center;
      gap: 8px;
      min-width: 0;
