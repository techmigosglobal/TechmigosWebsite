    .crm-analytics-page .analytics-project-legend-row {
      min-height: 29px;
      color: #304b76;
      font-size: 13px;
      font-weight: 650;
    }

    .crm-analytics-page .analytics-project-legend-row strong {
      color: #162d56;
      font-size: 13px;
      font-weight: 900;
    }

    .crm-analytics-page .analytics-project-legend-dot,
    .crm-analytics-page .analytics-ticket-legend-dot {
      width: 13px;
      height: 13px;
      border-radius: 50%;
    }

    .crm-analytics-page .analytics-finance-list {
      display: grid;
      padding: 9px 28px 12px;
    }

    .crm-analytics-page .analytics-finance-list > div {
      grid-template-columns: minmax(0, 1fr) auto;
      min-height: 46px;
      border-bottom: 1px solid #e4ebf2;
