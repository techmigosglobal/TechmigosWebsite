          </section>
          <div class="crm-section-stack">
          <div class="crm-grid crm-kpis">
            ${metric('Revenue Collected', compactMoney(income), '₹', 'green', `${state.data.finances.filter((item) => ['income', 'revenue'].includes(item.transaction_type)).length} entries posted`)}
            ${metric('Expense Load', compactMoney(expenses), '◵', 'red', `${state.data.finances.filter((item) => ['expense', 'salary'].includes(item.transaction_type)).length} outgoing records`)}
            ${metric('Recurring Value', compactMoney(recurring), '◱', 'orange', `${state.data.invoices.filter((item) => item.is_recurring).length} recurring invoices`)}
            ${metric('Net Position', compactMoney(income - expenses), '▢', income - expenses >= 0 ? 'green' : 'red', income - expenses >= 0 ? 'Positive operating margin' : 'Operating margin needs attention')}
            ${metric('Receivables', compactMoney(receivable), '◈', receivable > 0 ? 'orange' : 'green', receivable > 0 ? 'Collection follow-up required' : 'Fully collected')}
          </div>
          <div class="crm-finance-grid">
          <section class="crm-card crm-table-card">
            <div class="crm-card-head">
