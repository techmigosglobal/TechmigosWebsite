          clientName: g('inv-client-name'),
          clientContact: g('inv-client-contact'),
          clientEmail: g('inv-client-email'),
          clientPhone: g('inv-client-phone'),
          clientAddress: g('inv-client-address'),
          invoiceNumber: g('inv-number'),
          invoiceDate: g('inv-date'),
          dueDate: g('inv-due-date'),
