---
export const prerender = true;

import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/crm/Sidebar.astro';
import Topbar from '../components/crm/Topbar.astro';
import OverlayLayer from '../components/crm/OverlayLayer.astro';
import '../styles/operations.css';

interface Props {
  activeTab: string;
  title?: string;
}

const { activeTab, title } = Astro.props;
const pageTitle = title || 'TechMigos Finance';
const pageDescription = 'Private TechMigos Finance workspace for invoices, transactions, proof uploads, reporting, and secure payment actions.';
const viewClass = activeTab === 'dashboard'
  ? 'crm-dashboard'
  : activeTab === 'projects'
    ? 'crm-projects-page'
    : activeTab === 'tickets'
      ? 'crm-tickets-page'
      : activeTab === 'files'
        ? 'crm-files-page'
        : activeTab === 'analytics'
          ? 'crm-analytics-shell'
          : activeTab === 'reports'
            ? 'crm-reports-shell'
            : '';
const shellClass = activeTab === 'finance' ? 'finance-page' : 'operations-page';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  noIndex={true}
  hideNavbar={true}
  isCrm={true}
>
  <style is:global>
    :root {
      --crm-blue: #0f766e;
      --crm-blue-dark: #115e59;
      --crm-navy: #0f172a;
      --crm-text: #1e293b;
      --crm-muted: #64748b;
      --crm-line: #dbe3ef;
      --crm-bg: #f4f7fb;
      --crm-green: #059669;
      --crm-red: #dc2626;
      --crm-orange: #d97706;
      --crm-purple: #475569;
      --crm-sidebar-bg: #0f172a;
      --crm-sidebar-line: rgba(148, 163, 184, 0.16);
      --crm-sidebar-text: #cbd5e1;
      --crm-sidebar-active: rgba(15, 118, 110, 0.18);
      --crm-surface: #ffffff;
      --crm-surface-muted: #f8fafc;
      --crm-shadow-soft: 0 18px 48px rgba(15, 23, 42, 0.07);
      --crm-shadow-strong: 0 24px 64px rgba(15, 23, 42, 0.12);
    }

    body:has(.crm-app) {
      background: var(--crm-bg);
    }

    .crm-app {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 220px minmax(0, 1fr);
      background: var(--crm-bg);
      color: var(--crm-text);
      font-family: Inter, "Segoe UI", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      transition: grid-template-columns 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .crm-app.sidebar-collapsed {
      grid-template-columns: 64px minmax(0, 1fr);
    }

    .crm-sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      border-right: 1px solid var(--crm-sidebar-line);
      background:
        radial-gradient(circle at top, rgba(15, 118, 110, 0.22), transparent 26%),
        linear-gradient(180deg, #111827 0%, #0f172a 55%, #0b1120 100%);
      display: flex;
      flex-direction: column;
      padding: 0;
      overflow: hidden;
      color: var(--crm-sidebar-text);
      transition: width 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .crm-nav-label,
    .crm-brand span {
      overflow: hidden;
      white-space: nowrap;
      transition: opacity 0.2s ease, max-width 0.28s cubic-bezier(0.4, 0, 0.2, 1);
      max-width: 200px;
      opacity: 1;
    }

    .sidebar-collapsed .crm-nav-label,
    .sidebar-collapsed .crm-brand span {
      max-width: 0;
      opacity: 0;
    }

    .crm-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 20px 18px 16px;
      color: #f8fafc;
      font-weight: 900;
      font-size: 17px;
      letter-spacing: -0.035em;
      border-bottom: 1px solid var(--crm-sidebar-line);
      flex-shrink: 0;
    }

    .crm-logo {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      object-fit: contain;
      flex-shrink: 0;
    }

    .crm-nav {
      display: flex;
      flex-direction: column;
      gap: 2px;
      overflow-y: auto;
      padding: 10px 10px;
      flex: 1;
      scrollbar-width: none;
    }

    .crm-nav::-webkit-scrollbar { display: none; }

    .crm-nav-section {
      padding: 10px 8px 4px;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #a0aec0;
      flex-shrink: 0;
    }

    .crm-nav-item,
    .crm-button,
    .crm-icon-button {
      min-height: 44px;
      touch-action: manipulation;
    }

    .crm-nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      border: 1px solid transparent;
      border-radius: 12px;
      background: transparent;
      padding: 11px 12px;
      text-align: left;
      color: var(--crm-sidebar-text);
      font-size: 13.5px;
      font-weight: 750;
      cursor: pointer;
      transition: background-color 0.16s ease, color 0.16s ease, border-color 0.16s ease, transform 0.16s ease;
      min-height: 42px;
      text-decoration: none;
    }

    .crm-nav-item.active {
      background: var(--crm-sidebar-active);
      color: #f8fafc;
      border-color: rgba(45, 212, 191, 0.2);
      box-shadow: inset 0 0 0 1px rgba(15, 118, 110, 0.22);
    }

    .crm-nav-item.active .crm-nav-icon {
      color: #7dd3fc;
    }

    .crm-nav-item:hover {
      background: rgba(148, 163, 184, 0.08);
      color: #f8fafc;
      transform: translateX(2px);
    }

    .crm-nav-icon {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      color: #94a3b8;
    }

    .crm-nav-icon svg {
      width: 18px;
      height: 18px;
    }

    .crm-sidebar-footer {
      border-top: 1px solid var(--crm-line);
      padding: 10px;
      flex-shrink: 0;
    }

    .crm-collapse {
      width: 100%;
      justify-content: center;
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 12px;
      background: rgba(148, 163, 184, 0.08);
      color: #cbd5e1;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      min-height: 38px;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 0 12px;
      transition: background-color 0.16s ease, color 0.16s ease, border-color 0.16s ease;
    }

    .crm-collapse:hover {
      background: rgba(15, 118, 110, 0.16);
      color: #f8fafc;
      border-color: rgba(45, 212, 191, 0.22);
    }

    .sidebar-collapsed .crm-nav-section,
    .sidebar-collapsed .crm-collapse-label {
      display: none;
    }

    .sidebar-collapsed .crm-brand {
      justify-content: center;
      padding: 16px 0 12px;
    }

    .sidebar-collapsed .crm-logo {
      width: 28px;
      height: 28px;
    }

    .sidebar-collapsed .crm-nav-item {
      padding: 9px;
      justify-content: center;
    }

    .sidebar-collapsed .crm-nav {
      padding: 10px 8px;
    }

    .crm-main {
      min-width: 0;
      display: grid;
      grid-template-rows: auto 1fr;
    }

    .crm-topbar {
      position: sticky;
      top: 0;
      z-index: 30;
      display: grid;
      grid-template-columns: minmax(260px, 560px) auto;
      align-items: center;
      gap: 18px;
      min-height: 72px;
      border-bottom: 1px solid var(--crm-line);
      background: rgba(255, 255, 255, 0.92);
      padding: 0 28px;
      backdrop-filter: blur(18px);
      box-shadow: 0 1px 0 var(--crm-line), 0 16px 40px rgba(15, 23, 42, 0.05);
    }

    .crm-search {
      position: relative;
    }

    .crm-search input {
      width: 100%;
      height: 48px;
      border: 1px solid var(--crm-line);
      border-radius: 12px;
      background: rgba(248, 250, 252, 0.92);
      padding: 0 58px 0 44px;
      color: var(--crm-text);
      font-weight: 700;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.4);
    }

    .crm-search span:first-child {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: #7484a3;
    }

    .crm-search-kbd,
    kbd.crm-search-kbd {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      border-radius: 7px;
      background: #f0f4fb;
      border: 1px solid #dfe7f3;
      padding: 3px 8px;
      color: #62718f;
      font-size: 12px;
      font-weight: 900;
      font-family: inherit;
    }

    .crm-top-actions {
      justify-self: end;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .crm-company-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      border-right: 1px solid var(--crm-line);
      padding-right: 18px;
      color: var(--crm-navy);
      font-size: 13px;
      font-weight: 900;
      white-space: nowrap;
    }

    .crm-topbar-clock {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      line-height: 1.25;
      border-right: 1px solid var(--crm-line);
      padding-right: 18px;
    }

    .crm-topbar-clock .clock-time {
      font-size: 14px;
      font-weight: 900;
      color: var(--crm-navy);
      font-variant-numeric: tabular-nums;
    }

    .crm-topbar-clock .clock-date {
      font-size: 11px;
      font-weight: 700;
      color: var(--crm-muted);
    }

    .crm-icon-button {
      position: relative;
      width: 40px;
      height: 40px;
      border: 1px solid var(--crm-line);
      border-radius: 12px;
      background: rgba(248, 250, 252, 0.9);
      color: #26395e;
      font-size: 17px;
      font-weight: 900;
      cursor: pointer;
      display: grid;
      place-items: center;
      transition: border-color 0.16s ease, box-shadow 0.16s ease, background-color 0.16s ease, color 0.16s ease;
    }

    .crm-icon-button:hover {
      border-color: rgba(15, 118, 110, 0.24);
      box-shadow: 0 10px 24px rgba(15, 118, 110, 0.12);
      color: var(--crm-blue);
    }

    .crm-icon-button svg,
    .crm-logout-btn svg {
      width: 18px;
      height: 18px;
    }

    .crm-badge-dot {
      position: absolute;
      right: -4px;
      top: -4px;
      min-width: 18px;
      height: 18px;
      border-radius: 999px;
      border: 2px solid #fff;
      background: #ff3b3b;
      color: #fff;
      font-size: 10px;
      font-weight: 900;
      line-height: 14px;
      text-align: center;
      padding: 0 3px;
    }

    .crm-user {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      border: 1px solid var(--crm-line);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.9);
      color: inherit;
      cursor: pointer;
      text-align: left;
      padding: 5px 10px 5px 6px;
      transition: border-color 0.16s ease, box-shadow 0.16s ease, background-color 0.16s ease;
    }

    .crm-user:hover {
      border-color: rgba(15, 118, 110, 0.22);
      box-shadow: 0 10px 26px rgba(15, 118, 110, 0.1);
    }

    .crm-avatar {
      position: relative;
      flex-shrink: 0;
      width: 36px;
      height: 36px;
      border-radius: 999px;
      overflow: visible;
      background: linear-gradient(135deg, #0f766e, #0f172a);
      display: grid;
      place-items: center;
      color: #fff;
      font-size: 13px;
      font-weight: 900;
      letter-spacing: -0.02em;
    }

    .crm-avatar::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 0;
      width: 10px;
      height: 10px;
      border: 2px solid #fff;
      border-radius: 999px;
      background: #15b56d;
    }

    .crm-user-text {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .crm-logout-btn {
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      display: grid;
      place-items: center;
      border: 1px solid var(--crm-line);
      border-radius: 7px;
      background: #fff;
      color: #667599;
      font-size: 14px;
      cursor: pointer;
      margin-left: 2px;
      transition: border-color 0.15s, color 0.15s;
    }

    .crm-logout-btn:hover {
      border-color: #ffd7d4;
      color: var(--crm-red);
    }

    .crm-content {
      min-width: 0;
      padding: 30px;
    }

    .crm-page-head {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: flex-start;
      margin-bottom: 22px;
      flex-wrap: wrap;
    }

    .crm-page-title {
      margin: 0;
      color: var(--crm-navy);
      font-size: clamp(26px, 2.4vw, 36px);
      line-height: 1.05;
      font-weight: 950;
      letter-spacing: -0.05em;
    }

    .crm-page-subtitle {
      margin-top: 8px;
      color: var(--crm-muted);
      font-size: 15px;
      font-weight: 650;
    }

    .crm-toolbar {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 10px;
      min-width: 0;
    }

    .crm-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      border: 1px solid var(--crm-line);
      border-radius: 12px;
      background: var(--crm-surface);
      padding: 0 16px;
      color: var(--crm-text);
      font-size: 14px;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
      transition: border-color 0.16s ease, box-shadow 0.16s ease, background-color 0.16s ease, color 0.16s ease, transform 0.16s ease;
    }

    .crm-button:hover {
      transform: translateY(-1px);
      box-shadow: 0 14px 32px rgba(15, 23, 42, 0.08);
      border-color: #cbd5e1;
    }

    .crm-button:active {
      transform: translateY(0);
      box-shadow: 0 4px 12px rgba(16, 32, 71, 0.04);
    }

    .crm-button.primary {
      border-color: transparent;
      background: linear-gradient(135deg, #0f766e, #115e59);
      color: #fff;
      box-shadow: 0 18px 34px rgba(15, 118, 110, 0.22);
    }

    .crm-button.primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 20px 38px rgba(15, 118, 110, 0.28);
    }

    .crm-button.primary:active {
      transform: translateY(0);
    }

    .crm-button.green {
      border-color: transparent;
      background: linear-gradient(135deg, #059669, #047857);
      color: #fff;
      box-shadow: 0 18px 34px rgba(5, 150, 105, 0.2);
    }

    .crm-button.green:hover {
      transform: translateY(-1px);
      box-shadow: 0 20px 38px rgba(5, 150, 105, 0.26);
    }

    .crm-button.green:active {
      transform: translateY(0);
    }

    .crm-button.danger {
      border-color: #ffd7d4;
      background: #fff;
      color: #d9342e;
    }

    .crm-select,
    .crm-input {
      height: 44px;
      border: 1px solid var(--crm-line);
      border-radius: 9px;
      background: #fff;
      padding: 0 13px;
      color: var(--crm-text);
      font-weight: 750;
    }

    .crm-grid {
      display: grid;
      gap: 18px;
    }

    .crm-kpis {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .crm-card {
      border: 1px solid var(--crm-line);
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.94);
      box-shadow: var(--crm-shadow-soft);
      transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .crm-files-command { padding: 18px; }
    .crm-files-breadcrumb { display:flex; align-items:center; gap:8px; margin-top:16px; color:var(--crm-muted); font-size:12px; font-weight:700; }
    .crm-files-breadcrumb button { border:0; background:transparent; color:var(--crm-blue); font:inherit; cursor:pointer; padding:0; }
    .crm-file-folders { display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:12px; }
    .crm-file-folder { display:flex; align-items:center; gap:10px; min-height:78px; border:1px solid var(--crm-line); border-radius:14px; background:var(--crm-surface); padding:12px; box-shadow:0 8px 18px rgba(15,23,42,.04); }
    .crm-file-folder.is-active { border-color:var(--crm-blue); box-shadow:0 0 0 3px rgba(15,118,110,.1); }
    .crm-file-folder-open { display:grid; place-items:center; width:38px; height:38px; border:0; border-radius:10px; background:#e6fffb; color:var(--crm-blue); font-size:24px; cursor:pointer; }
    .crm-file-folder-body { min-width:0; flex:1; display:grid; gap:4px; }
    .crm-file-folder-name { border:0; padding:0; background:transparent; color:var(--crm-text); font:700 13px/1.2 inherit; text-align:left; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; cursor:pointer; }
    .crm-file-folder-body small { color:var(--crm-muted); font-weight:600; }
    .crm-folder-rename { min-width:0; height:30px; padding:4px 7px; font-size:13px; }

    .crm-kpi {
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 14px;
      align-items: center;
      min-height: 112px;
      padding: 20px;
      border: 1px solid transparent;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .crm-kpi:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(16, 32, 71, 0.08);
      border-color: #cbd5e1;
    }

    .crm-kpi-icon {
      width: 58px;
      height: 58px;
      display: grid;
      place-items: center;
      border-radius: 999px;
      font-size: 28px;
      font-weight: 900;
    }

    .blue-soft { background: #dff7f4; color: var(--crm-blue); }
    .green-soft { background: #ddfaef; color: var(--crm-green); }
    .red-soft { background: #fee2e2; color: var(--crm-red); }
    .orange-soft { background: #ffedd5; color: var(--crm-orange); }
    .purple-soft { background: #e2e8f0; color: var(--crm-purple); }

    .crm-kpi-label {
      color: #506080;
      font-size: 13px;
      font-weight: 850;
    }

    .crm-kpi-value {
      margin-top: 4px;
      color: var(--crm-navy);
      font-size: 25px;
      font-weight: 950;
      letter-spacing: -0.03em;
    }

    .crm-trend {
      margin-top: 4px;
      color: var(--crm-muted);
      font-size: 12px;
      font-weight: 800;
    }

    .crm-trend.up { color: var(--crm-green); }
    .crm-trend.down { color: var(--crm-red); }

    .crm-card-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      min-height: 56px;
      border-bottom: 1px solid var(--crm-line);
      padding: 0 18px;
      flex-wrap: wrap;
    }

    .crm-card-title {
      color: var(--crm-navy);
      font-weight: 950;
    }

    .crm-link {
      border: 0;
      background: transparent;
      color: var(--crm-blue);
      font-size: 12px;
      font-weight: 900;
      cursor: pointer;
    }

    .crm-sheet-tabs {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding: 6px;
      background: #edf3f8;
      border-radius: 14px;
      margin-bottom: 20px;
      border: 1px solid #e2e8f0;
    }

    .crm-sheet-tab {
      flex: 0 0 auto;
      min-height: 36px;
      border: none;
      border-radius: 8px;
      background: transparent;
      padding: 0 16px;
      color: #64748b;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
    }

    .crm-sheet-tab:hover {
      color: #0f172a;
      background: rgba(255,255,255,0.5);
      transform: translateY(-1px);
    }

    .crm-sheet-tab.active {
      background: #fff;
      color: #0f172a;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08), 0 1px 3px rgba(15, 23, 42, 0.02);
      transform: none;
    }

    .crm-table-wrap {
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: #cbd5e1 transparent;
      max-width: 100%;
    }

    .crm-table {
      width: 100%;
      min-width: 920px;
      border-collapse: collapse;
      color: #26395e;
      font-size: 13px;
      font-weight: 720;
    }

    .crm-table th,
    .crm-table td {
      border-bottom: 1px solid #edf2f8;
      padding: 15px 16px;
      text-align: left;
      vertical-align: middle;
      white-space: nowrap;
    }

    .crm-table td::before {
      display: none;
    }

    .crm-table th {
      color: #4f5f80;
      font-size: 12px;
      font-weight: 950;
      background: #f8fbfd;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .crm-table tr:hover td {
      background: #f7fbfc;
    }

    .crm-status {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 24px;
      border-radius: 6px;
      padding: 0 9px;
      font-size: 12px;
      font-weight: 900;
    }

    .crm-status.blue { background: #e9f3ff; color: var(--crm-blue); }
    .crm-status.green { background: #e5f9f0; color: #05875f; }
    .crm-status.red { background: #ffeded; color: var(--crm-red); }
    .crm-status.orange { background: #fff3df; color: #c56b00; }
    .crm-status.purple { background: #f1eaff; color: var(--crm-purple); }
    .crm-status.gray { background: #eef3f9; color: #62718f; }

    .crm-progress {
      display: grid;
      grid-template-columns: minmax(72px, 1fr) 38px;
      gap: 10px;
      align-items: center;
    }

    .crm-progress-track {
      height: 7px;
      border-radius: 999px;
      background: #e8eef6;
      overflow: hidden;
    }

    .crm-progress-fill {
      height: 100%;
      border-radius: inherit;
      background: #0eb6a3;
    }

    .crm-two-col {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(340px, 0.35fr);
      gap: 18px;
      align-items: start;
    }

    .crm-three-col {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .crm-chart {
      height: 190px;
      margin: 18px;
      border-radius: 10px;
      background:
        linear-gradient(to top, transparent 23%, #edf2f8 24%, transparent 25%),
        linear-gradient(to top, transparent 48%, #edf2f8 49%, transparent 50%),
        linear-gradient(to top, transparent 73%, #edf2f8 74%, transparent 75%),
        linear-gradient(135deg, rgba(31, 122, 255, 0.12), rgba(8, 169, 121, 0.12));
      position: relative;
      overflow: hidden;
    }

    .crm-chart::before,
    .crm-chart::after {
      content: "";
      position: absolute;
      left: 20px;
      right: 20px;
      height: 4px;
      border-radius: 999px;
      transform-origin: left center;
    }

    .crm-chart::before {
      bottom: 58px;
      background: linear-gradient(90deg, var(--crm-green), #22d3ee);
      transform: skewY(-9deg);
      box-shadow: 70px -20px 0 -1px #16c79a, 150px 4px 0 -1px #16c79a, 245px -42px 0 -1px #16c79a;
    }

    .crm-chart::after {
      bottom: 32px;
      background: linear-gradient(90deg, var(--crm-red), #ff8a80);
      transform: skewY(-6deg);
      box-shadow: 85px 14px 0 -1px #ff6b67, 180px -8px 0 -1px #ff6b67, 275px 6px 0 -1px #ff6b67;
    }

    .crm-donut {
      width: 156px;
      height: 156px;
      margin: 22px auto;
      border-radius: 999px;
      background: conic-gradient(var(--crm-blue) 0 38%, var(--crm-green) 38% 68%, var(--crm-purple) 68% 82%, var(--crm-orange) 82% 94%, var(--crm-red) 94% 100%);
      position: relative;
      box-shadow: inset 0 0 0 1px rgba(8, 22, 56, 0.04), 0 18px 38px rgba(31, 122, 255, 0.12);
    }

    .crm-donut::after {
      content: "";
      position: absolute;
      inset: 38px;
      border-radius: inherit;
      background: #fff;
      box-shadow: inset 0 0 0 1px #edf2f8;
    }

    .crm-detail {
      position: sticky;
      top: 94px;
      padding: 20px;
    }

    .crm-detail-hero {
      display: flex;
      gap: 14px;
      align-items: center;
      margin-bottom: 18px;
    }

    .crm-detail-icon {
      width: 56px;
      height: 56px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--crm-blue), var(--crm-blue-dark));
      color: #fff;
      font-size: 26px;
      font-weight: 900;
    }

    .crm-list {
      display: grid;
      gap: 12px;
      padding: 18px;
    }

    .crm-list-row {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      border-bottom: 1px solid #edf2f8;
      padding-bottom: 12px;
      color: #26395e;
      font-size: 13px;
      font-weight: 750;
    }

    .crm-list-row:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }

    .crm-hero-panel {
      position: relative;
      overflow: hidden;
      padding: 28px;
      background:
        radial-gradient(circle at top right, rgba(45, 212, 191, 0.24), transparent 30%),
        linear-gradient(135deg, #0f172a 0%, #111827 45%, #134e4a 100%);
      color: #f8fafc;
      box-shadow: var(--crm-shadow-strong);
    }

    .crm-hero-panel::after {
      content: "";
      position: absolute;
      inset: auto -10% -55% auto;
      width: 260px;
      height: 260px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.05);
      filter: blur(10px);
    }

    .crm-hero-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(260px, 0.7fr);
      gap: 20px;
      align-items: start;
    }

    .crm-hero-kicker,
    .crm-section-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border-radius: 999px;
      padding: 6px 12px;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .crm-hero-kicker {
      background: rgba(255, 255, 255, 0.1);
      color: rgba(248, 250, 252, 0.88);
    }

    .crm-section-kicker {
      background: #dff7f4;
      color: var(--crm-blue-dark);
    }

    .crm-hero-title {
      margin: 16px 0 8px;
      font-size: clamp(28px, 3vw, 40px);
      line-height: 1;
      letter-spacing: -0.05em;
      font-weight: 950;
      text-wrap: balance;
    }

    .crm-hero-copy {
      max-width: 60ch;
      color: rgba(226, 232, 240, 0.88);
      font-size: 15px;
      line-height: 1.7;
    }

    .crm-hero-meta {
      display: grid;
      gap: 12px;
      align-content: start;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 18px;
      background: rgba(15, 23, 42, 0.28);
      padding: 18px;
      backdrop-filter: blur(10px);
    }

    .crm-meta-label {
      color: rgba(203, 213, 225, 0.88);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .crm-meta-value {
      color: #f8fafc;
      font-size: 24px;
      font-weight: 950;
      letter-spacing: -0.04em;
    }

    .crm-meta-note {
      color: rgba(226, 232, 240, 0.78);
      font-size: 13px;
      line-height: 1.5;
    }

    .crm-stack {
      display: grid;
      gap: 18px;
    }

    .crm-section-stack {
      display: grid;
      gap: 22px;
      margin-top: 22px;
    }

    .crm-split-callout {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .crm-mini-card {
      border: 1px solid var(--crm-line);
      border-radius: 18px;
      background: var(--crm-surface-muted);
      padding: 18px;
    }

    .crm-mini-card strong {
      display: block;
      margin-top: 8px;
      color: var(--crm-navy);
      font-size: 18px;
      letter-spacing: -0.03em;
    }

    .crm-note {
      color: var(--crm-muted);
      font-size: 13px;
      line-height: 1.6;
    }

    .crm-table-card {
      overflow: hidden;
    }

    .crm-table th.crm-numeric,
    .crm-table td.crm-numeric {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .crm-amount-positive {
      color: #047857;
      font-weight: 900;
      font-variant-numeric: tabular-nums;
    }

    .crm-amount-negative {
      color: #b91c1c;
      font-weight: 900;
      font-variant-numeric: tabular-nums;
    }

    .crm-finance-grid {
      display: grid;
      gap: 18px;
      grid-template-columns: minmax(0, 1.3fr) minmax(320px, 0.7fr);
      align-items: start;
    }

    .crm-filterbar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 16px;
      padding: 14px 18px 0;
    }

    .crm-ledger-pinned-summary {
      position: sticky;
      top: 0;
      z-index: 6;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
      margin: 14px 18px 0;
      padding: 10px;
      border: 1px solid rgba(15, 118, 110, 0.12);
      border-radius: 14px;
      background: rgba(248, 252, 255, 0.92);
      backdrop-filter: blur(12px);
      box-shadow: 0 18px 34px rgba(15, 23, 42, 0.05);
    }

    .crm-ledger-pill {
      display: grid;
      gap: 4px;
      padding: 10px 12px;
      border-radius: 12px;
      background: linear-gradient(180deg, #ffffff 0%, #f8fbfd 100%);
      border: 1px solid #e4edf6;
    }

    .crm-ledger-pill span {
      color: var(--crm-muted);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .crm-ledger-pill strong {
      color: var(--crm-navy);
      font-size: 15px;
      font-weight: 950;
      font-variant-numeric: tabular-nums;
    }

    .crm-ledger-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .crm-ledger-toolbar .crm-toolbar {
      flex: 1 1 280px;
      justify-content: flex-end;
    }

    .crm-ledger-summary {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }

    .crm-filter-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 34px;
      border-radius: 999px;
      border: 1px solid rgba(14, 165, 233, 0.14);
      background: linear-gradient(180deg, #f8fdff 0%, #ecfeff 100%);
      padding: 0 12px;
      color: #155e75;
      font-size: 12px;
      font-weight: 850;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75);
    }

    .crm-filter-chip strong {
      color: #0f172a;
      font-weight: 950;
    }

    .crm-filterbar .crm-select,
    .crm-filterbar .crm-input,
    .crm-filterbar .crm-button {
      flex: 1 1 160px;
    }

    .crm-density-toggle {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px;
      border-radius: 999px;
      background: #f1f5f9;
      border: 1px solid #dbe5f0;
    }

    .crm-density-button {
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: #51627e;
      min-height: 30px;
      padding: 0 12px;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.18s ease, color 0.18s ease;
    }

    .crm-density-button.active {
      background: #0f172a;
      color: #f8fafc;
    }

    .crm-table--ledger thead th {
      position: sticky;
      top: 0;
      z-index: 4;
    }

    .crm-table--ledger th:first-child,
    .crm-table--ledger td:first-child {
      position: sticky;
      left: 0;
      z-index: 3;
      background: inherit;
    }

    .crm-table--ledger th:nth-child(2),
    .crm-table--ledger td:nth-child(2) {
      position: sticky;
      left: 54px;
      z-index: 2;
      background: inherit;
      box-shadow: 1px 0 0 #edf2f8;
    }

    .crm-table--ledger thead th:first-child,
    .crm-table--ledger thead th:nth-child(2) {
      z-index: 5;
      background: #f8fbfd;
    }

    .crm-table--ledger th:last-child,
    .crm-table--ledger td:last-child {
      position: sticky;
      right: 0;
      z-index: 2;
      background: inherit;
      box-shadow: -1px 0 0 #edf2f8;
    }

    .crm-table--ledger thead th:last-child {
      z-index: 5;
      background: #f8fbfd;
    }

    .crm-table--ledger tbody tr {
      transition: background 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
    }

    .crm-table--ledger tbody tr:hover {
      transform: translateY(-1px);
    }

    .crm-table--ledger.crm-density-compact th,
    .crm-table--ledger.crm-density-compact td {
      padding: 10px 12px;
    }

    .crm-table--ledger.crm-density-compact .crm-edit-input,
    .crm-table--ledger.crm-density-compact .crm-edit-select {
      min-width: 90px;
      height: 30px;
      padding: 0 6px;
      font-size: 12px;
    }

    .crm-ledger-row--dirty td {
      background: linear-gradient(180deg, rgba(255, 247, 237, 0.92) 0%, rgba(255, 255, 255, 0.98) 100%);
    }

    .crm-ledger-row--saving td {
      background: linear-gradient(180deg, rgba(239, 246, 255, 0.96) 0%, rgba(255, 255, 255, 0.98) 100%);
    }

    .crm-ledger-row--saved td {
      background: linear-gradient(180deg, rgba(236, 253, 245, 0.94) 0%, rgba(255, 255, 255, 0.98) 100%);
    }

    .crm-ledger-row--invalid td {
      background: linear-gradient(180deg, rgba(254, 242, 242, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
    }

    .crm-ledger-readonly .crm-edit-input,
    .crm-ledger-readonly .crm-edit-select {
      pointer-events: none;
      background: transparent;
      border-color: transparent;
      box-shadow: none;
      color: inherit;
      appearance: none;
    }

    .crm-ledger-readonly .crm-edit-select {
      padding-right: 8px;
    }

    .crm-save-indicator {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 36px;
      border-radius: 999px;
      padding: 0 14px;
      background: #ecfeff;
      color: #155e75;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .crm-save-indicator::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: currentColor;
      opacity: 0.65;
    }

    .crm-ledger-state {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-width: 118px;
      min-height: 34px;
      border-radius: 999px;
      border: 1px solid #dbe5f0;
      background: #fff;
      padding: 0 12px;
      color: #51627e;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      box-shadow: 0 8px 18px rgba(15, 23, 42, 0.05);
    }

    .crm-ledger-state::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: currentColor;
      flex: 0 0 auto;
    }

    .crm-ledger-state--dirty {
      border-color: rgba(245, 158, 11, 0.22);
      background: #fff9ed;
      color: #b45309;
    }

    .crm-ledger-state--saving {
      border-color: rgba(14, 165, 233, 0.22);
      background: #f0f9ff;
      color: #0369a1;
    }

    .crm-ledger-state--saved {
      border-color: rgba(22, 163, 74, 0.22);
      background: #f0fdf4;
      color: #15803d;
    }

    .crm-ledger-state--locked {
      border-color: rgba(100, 116, 139, 0.18);
      background: #f8fafc;
      color: #64748b;
    }

    .crm-ledger-state--invalid {
      border-color: rgba(220, 38, 38, 0.2);
      background: #fef2f2;
      color: #b91c1c;
    }

    .crm-chart-card {
      padding: 18px;
    }

    .crm-chart-card .crm-card-head {
      padding-left: 0;
      padding-right: 0;
      min-height: auto;
    }

    .crm-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 14px;
      color: var(--crm-muted);
      font-size: 11px;
      font-weight: 850;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .crm-legend span {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .crm-legend i {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      display: inline-block;
    }

    .crm-empty {
      padding: 24px 18px;
      color: var(--crm-muted);
      font-size: 13px;
      font-weight: 800;
    }

    .crm-actionbar {
      display: none;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
      border: 1px solid #b9d2ff;
      border-radius: 10px;
      background: #eef5ff;
      padding: 12px 14px;
      color: #143a79;
      font-size: 13px;
      font-weight: 850;
    }

    .crm-actionbar.show {
      display: flex;
    }

    .crm-row-actions {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
    }

    .crm-mini-action {
      min-height: 34px;
      border: 1px solid var(--crm-line);
      border-radius: 7px;
      background: #fff;
      padding: 0 10px;
      color: #26456f;
      font-size: 12px;
      font-weight: 900;
      cursor: pointer;
    }

    .crm-mini-action:hover {
      border-color: #b9d2ff;
      color: var(--crm-blue-dark);
      box-shadow: 0 8px 18px rgba(31, 122, 255, 0.1);
    }

    .crm-mini-action.danger {
      border-color: #ffd7d4;
      color: #d9342e;
    }

    .crm-page {
      display: none;
    }

    .crm-page.active {
      display: block;
    }

    .crm-edit-input,
    .crm-edit-select {
      width: 100%;
      min-width: 120px;
      height: 34px;
      border: 1px solid transparent;
      border-radius: 7px;
      background: transparent;
      padding: 0 8px;
      color: inherit;
      font: inherit;
      font-weight: 760;
    }

    .crm-edit-input:hover,
    .crm-edit-select:hover,
    .crm-edit-input:focus,
    .crm-edit-select:focus {
      border-color: var(--crm-line);
      background: #fff;
      outline: none;
      box-shadow: 0 0 0 3px rgba(31, 122, 255, 0.12);
    }

    .crm-cell-invalid {
      border-color: rgba(220, 38, 38, 0.34) !important;
      background: #fff5f5 !important;
      box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1) !important;
    }

    .crm-dirty {
      box-shadow: inset 3px 0 0 var(--crm-orange);
    }

    .invoice-hover-preview {
      position: fixed;
      z-index: 100;
      width: min(420px, 92vw);
      max-height: 360px;
      overflow: auto;
      border-radius: 10px;
      background: #fff;
      box-shadow: 0 18px 50px rgba(8, 22, 56, 0.22), 0 0 0 1px rgba(31, 122, 255, 0.10);
      padding: 16px;
      pointer-events: none;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.18s ease, transform 0.18s ease;
    }

    .invoice-hover-preview.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .invoice-hover-preview .ihp-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 10px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--crm-line);
    }

    .invoice-hover-preview .ihp-head h4 {
      margin: 0;
      font-size: 13px;
      font-weight: 950;
      color: var(--crm-navy);
    }

    .invoice-hover-preview .ihp-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px 16px;
      font-size: 12px;
    }

    .invoice-hover-preview .ihp-grid dt {
      color: var(--crm-muted);
      font-weight: 800;
    }

    .invoice-hover-preview .ihp-grid dd {
      margin: 0;
      font-weight: 850;
      color: var(--crm-text);
    }

    .invoice-hover-preview .ihp-items {
      margin-top: 10px;
      border-top: 1px solid var(--crm-line);
      padding-top: 8px;
    }

    .invoice-hover-preview .ihp-items table {
      width: 100%;
      border-collapse: collapse;
      font-size: 11px;
    }

    .invoice-hover-preview .ihp-items th {
      text-align: left;
      color: var(--crm-muted);
      font-weight: 900;
      padding: 3px 6px;
      border-bottom: 1px solid var(--crm-line);
    }

    .invoice-hover-preview .ihp-items td {
      padding: 3px 6px;
      font-weight: 750;
      color: var(--crm-text);
    }

    .invoice-hover-preview .ihp-foot {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 10px;
      padding-top: 8px;
      border-top: 1px solid var(--crm-line);
      font-size: 12px;
      font-weight: 900;
    }

    .proof-preview-modal {
      position: fixed;
      inset: 0;
      z-index: 110;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(8, 22, 56, 0.65);
      padding: 18px;
    }

    .proof-preview-modal.open {
      display: flex;
    }

    .proof-preview-panel {
      width: min(920px, 100%);
      max-height: 92vh;
      overflow: auto;
      border-radius: 14px;
      background: #fff;
      box-shadow: 0 30px 100px rgba(8, 22, 56, 0.35);
    }

    .proof-preview-body {
      padding: 18px;
    }

    .proof-preview-body img,
    .proof-preview-body iframe {
      width: 100%;
      max-width: 100%;
      border: 0;
      border-radius: 10px;
