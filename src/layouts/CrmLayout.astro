      .crm-dashboard .dashboard-chart-wrap { height: 240px; padding: 12px 10px 0; }
      .crm-dashboard .dashboard-actions { padding-left: 20px !important; padding-right: 20px !important; }
      .crm-dashboard .dashboard-watchlist { padding-left: 20px !important; padding-right: 20px !important; }
