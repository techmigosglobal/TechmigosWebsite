                  </div>
                  <div class="inv-sign-panel">${signSrc ? `<img src="${escapeHtml(signSrc)}" alt="Authorised signature">` : '<div style="height:60px;"></div>'}<div>Authorised Signatory For<br>${escapeHtml(companyName)}</div></div>
                </div>
