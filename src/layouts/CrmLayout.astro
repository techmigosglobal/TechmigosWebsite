        const searchMatch = !searchQuery || ['name', 'client_name', 'project_manager', 'status'].some((key) => String(project[key] || '').toLowerCase().includes(searchQuery));
        return statusMatch && searchMatch;
      });
      const statusText = (status) => ({ active: 'Active', planning: 'Active', review: 'Active', on_hold: 'On Hold', completed: 'Completed', cancelled: 'Cancelled' }[status] || nice(status));
      const statusClass = (status) => ['active', 'planning', 'review'].includes(status) ? 'green' : statusTone(status);
      const dateText = (date) => date ? new Date(date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
      const projectRows = filteredProjects.map((project) => {
        const progressValue = Math.max(0, Math.min(100, Number(project.progress || 0)));
        const budget = Number(project.budget || 0);
