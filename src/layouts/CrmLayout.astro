    /* Desktop one-screen mode: keep every dashboard module in view. */
    @media (min-width: 1181px) {
      body:has(.crm-dashboard) {
        overflow: hidden;
      }

      .crm-app:has(.crm-dashboard),
      .crm-app:has(.crm-dashboard) .crm-main {
        height: 100vh;
        min-height: 0;
      }

      .crm-app:has(.crm-dashboard) .crm-sidebar {
        height: 100vh;
      }

      .crm-app:has(.crm-dashboard) .crm-topbar {
        min-height: 82px;
      }

      .crm-app:has(.crm-dashboard) .crm-brand {
        min-height: 82px;
        font-size: 19px;
      }

