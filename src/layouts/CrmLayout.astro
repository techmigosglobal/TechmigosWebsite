    function renderCrudResource(resource, title, subtitle, columns) {
      const rows = filtered(state.data[resource] || [], columns.map(([field]) => field)).map((item) => `<tr data-resource="${resource}" data-row-id="${item.id}">
        <td><input type="checkbox" data-row-select aria-label="Select ${resource} ${item.id}" /></td>
        ${columns.map(([field, , type]) => {
          if (field === 'status' || field === 'priority' || field === 'stage') return `<td>${badge(item[field])}</td>`;
          if (type === 'number') return `<td><input class="crm-edit-input" data-field="${field}" type="number" value="${escapeHtml(item[field] || 0)}" /></td>`;
          if (type === 'date') return `<td><input class="crm-edit-input" data-field="${field}" type="date" value="${escapeHtml(String(item[field] || '').slice(0, 10))}" /></td>`;
          return `<td><input class="crm-edit-input" data-field="${field}" value="${escapeHtml(item[field] || '')}" /></td>`;
        }).join('')}
        <td>${rowActions(resource, item.id)}</td>
      </tr>`).join('');
      els.view.innerHTML = `${pageHead(title, subtitle, `<button class="crm-button primary" data-create="${resource}" type="button">+ Create</button><button class="crm-button" data-export="${resource}" type="button">Export</button>`)}
        <div class="crm-grid crm-kpis">${metric(`Total ${title}`, (state.data[resource] || []).length, '◎', 'blue')}${metric('Active', (state.data[resource] || []).filter((item) => !['closed', 'completed', 'sent'].includes(item.status || item.stage)).length, '✓', 'green')}${metric('Pending', (state.data[resource] || []).filter((item) => ['pending', 'new', 'scheduled'].includes(item.status || item.stage)).length, '⌁', 'orange')}${metric('Updated Today', state.data.activities.filter((item) => item.entity_type === resource).length, '▥', 'purple')}</div>
