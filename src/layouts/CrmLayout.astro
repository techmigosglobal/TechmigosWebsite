---
export const prerender = true;

import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/crm/Sidebar.astro';
import Topbar from '../components/crm/Topbar.astro';
import OverlayLayer from '../components/crm/OverlayLayer.astro';
import '../styles/operations.css';
import '../styles/crm-shell.css';
import '../styles/finance.css';

interface Props {
  activeTab: string;
  title?: string;
}

const { activeTab, title } = Astro.props;
const pageTitle = title || 'TechMigos Operations & Management';
const pageDescription = 'Private TechMigos Operations & Management workspace for projects, files, support, finance, reporting, and secure administrative actions.';
const viewClass = activeTab === 'dashboard'
  ? 'crm-dashboard'
  : activeTab === 'projects'
    ? 'crm-projects-page'
  : activeTab === 'support'
      ? 'crm-tickets-page'
      : activeTab === 'files'
        ? 'crm-files-page'
        : activeTab === 'analytics'
          ? 'crm-analytics-shell'
          : activeTab === 'reports'
            ? 'crm-reports-shell'
            : '';
const shellClass = activeTab === 'finance' ? 'finance-page' : 'operations-page';

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  noIndex={true}
  hideNavbar={true}
  isCrm={true}
>

  <div class="crm-app" data-crm-active-tab={activeTab}>
    <Sidebar activeTab={activeTab} />

    <div class="crm-main">
      <Topbar activeTab={activeTab} />

      <section class="crm-content">
        <p id="crm-status" class="mb-4 text-sm font-bold text-slate-500" role="status">Loading Operations &amp; Management data…</p>
        <div id="crm-actionbar" class="crm-actionbar">
          <span id="crm-selected-count">0 selected</span>
          <div class="crm-toolbar">
            <button class="crm-button" type="button" data-bulk-export>Export Selected</button>
            <button class="crm-button danger" type="button" data-bulk-delete>Delete Selected</button>
            <button class="crm-button" type="button" data-clear-selection>Clear</button>
          </div>
        </div>
        <div id="crm-view" class={`${shellClass} ${viewClass}`}><slot /></div>
      </section>
      <OverlayLayer />
    </div>
  </div>

  <script>
    import { downloadCrmReportPdf } from '../scripts/crm-pdf.js';
    window.tmCrmPdf = { downloadCrmReportPdf };
  </script>
  <script src="../scripts/crm-workspace.js"></script>
</BaseLayout>
