          .acc-proof-btn-empty:hover{transform:none;border-color:#e5e7eb;background:#f8fafc;color:#94a3b8;}
          .acc-proof-actions,.acc-inline-proof-actions{display:inline-flex;align-items:center;gap:6px;}
          .acc-proof-upload{color:#0f766e;}
          .acc-proof-empty-icon{display:grid;place-items:center;margin-bottom:10px;color:#94a3b8;}
          .acc-inline-proof-placeholder,.acc-inline-no-proof{color:#94a3b8;font-size:11px;line-height:1.4;}
          .acc-inline-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;min-width:220px;}
          .acc-inline-save-state{display:inline-flex;align-items:center;min-height:28px;border-radius:999px;padding:0 9px;font-size:10px;font-weight:750;white-space:nowrap;}
          .acc-inline-save-state--draft{background:#f8fafc;color:#64748b;}
          .acc-inline-save-state--dirty{background:#fff7ed;color:#c2410c;}
          .acc-inline-save-state--saving{background:#eff6ff;color:#0369a1;}
          .acc-inline-save-state--saved{background:#f0fdf4;color:#15803d;}
          .acc-inline-save-state--error{background:#fef2f2;color:#b91c1c;}
          .acc-pending-note{display:flex;align-items:flex-start;gap:8px;margin:0 0 14px;padding:10px 11px;border:1px solid #f5d77a;border-radius:10px;background:#fffaf0;color:#a16207;font-size:11px;}
          .acc-pending-note span{display:grid;gap:2px;}
          .acc-pending-note small{color:#92400e;font-size:10px;line-height:1.4;}
          @keyframes acc-pending-pulse{0%,100%{opacity:.65;}50%{opacity:1;}}
