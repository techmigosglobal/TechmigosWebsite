    .project-reference-stat-notes i {
      display: inline-block;
      flex: 0 0 auto;
      width: 9px;
      height: 9px;
      border-radius: 999px;
      background: #16bf77;
    }

    .project-reference-stat-notes .amber i { background: #e6ab00; }
    .project-reference-stat-notes .blue-dot i { background: #74a9f5; }
    .project-reference-stat.orange .project-reference-stat-notes i { background: #16bf77; }
    .project-reference-stat.red .project-reference-stat-notes { color: #49658e; }
    .project-reference-stat.red .project-reference-stat-notes i { background: #f0444c; }

    .project-reference-quick-actions {
      display: grid;
      min-width: 0;
      min-height: 98px;
