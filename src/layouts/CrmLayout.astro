    .inv-upload-box:hover {
      border-color: var(--crm-blue);
      background: #f0f6ff;
    }
    .inv-upload-box label {
      display: grid;
      gap: 4px;
      color: #27364a;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
    }
    .inv-upload-preview {
      display: flex;
      gap: 8px;
      align-items: center;
      color: var(--crm-muted);
      font-size: 12px;
      min-height: 36px;
