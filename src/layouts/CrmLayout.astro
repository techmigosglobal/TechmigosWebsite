      }

      .crm-table tr {
        border-bottom: 1px solid #edf2f8;
        padding: 12px 14px;
      }

      .crm-ledger-toolbar,
      .crm-ledger-summary {
        align-items: stretch;
      }

      .crm-ledger-pinned-summary {
