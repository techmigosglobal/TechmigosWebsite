    function openInvoiceCreateIntegrated() {
      state.financeSheet = 'invoices';
      state.invoiceBuilderActive = true;
      state.invoiceBuilderId = null;
      renderFinance();
      bindActions();
    }

    function openInvoiceEditIntegrated(id) {
      state.financeSheet = 'invoices';
      state.invoiceBuilderActive = true;
      state.invoiceBuilderId = id;
      renderFinance();
      bindActions();
    }

    function openCreate(resource) {
      if (isDisabledResource(resource)) return toast(`${nice(resource)} is not enabled in this CRM.`);
      if (resource === 'profiles' && !isCompanyAdmin()) return toast('Only company admins can create new logins.');
      if (resource === 'invoices') return openInvoiceCreateIntegrated();
      if (resource === 'tickets') return openTicketCreate();
      const actualResource = resource === 'salary' ? 'finances' : resource;
      const defaults = smartDefaults(resource);
      els.modalTitle.textContent = resource === 'salary' ? 'Add Salary' : `Create ${resource.replace(/_/g, ' ')}`;
      els.modalBody.innerHTML = formMarkup(resource === 'salary' ? 'salary' : actualResource, defaults, resource === 'salary' ? 'Add Salary' : 'Create');
      els.modal.classList.add('open');
      if (actualResource === 'finances') bindFinanceProofField();
      document.getElementById('crm-edit-form')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const raw = Object.fromEntries(new FormData(event.currentTarget).entries());
        if (actualResource === 'finances' && resource === 'salary') raw.transaction_type = 'salary';
        const body = normalizePayload(actualResource, raw);
        const validationError = validatePayload(actualResource, body);
        if (validationError) return toast(validationError);
        try {
          await portal(`/api/portal/${actualResource}`, { method: 'POST', body: JSON.stringify(body) });
          els.modal.classList.remove('open');
          toast(`${resource === 'salary' ? 'Salary' : 'Record'} created`);
          await loadData();
        } catch (error) {
          toast(error instanceof Error ? error.message : 'Create failed');
        }
      });
    }

    function smartDefaults(resource) {
      const today = new Date().toISOString().slice(0, 10);
      return {
        projects:         { status: 'planning', budget: 0, due_date: today },
        tickets:          { priority: 'medium', status: 'open' },
        finances:         { transaction_date: today, transaction_type: 'expense', status: 'pending', amount: 0, source: 'manual' },
        salary:           { transaction_date: today, transaction_type: 'salary', status: 'pending', amount: 0, source: 'manual' },
        clients:          { status: 'active' },
        profiles:         { role: 'company_member', status: 'active' },
        ticket_messages:  { ticket_id: state.selectedTicketId || '', visibility: 'external' },
      }[resource] || {};
    }

    function normalizePayload(resource, body) {
      return sanitizeResourcePayload(resource, body);
    }

    function openEdit(resource, id) {
      if (isDisabledResource(resource)) return toast(`${nice(resource)} is not enabled in this CRM.`);
      if (resource === 'profiles' && !isCompanyAdmin()) return toast('Only company admins can update user roles and access.');
      if (resource === 'invoices') return openInvoiceEditIntegrated(id);
      const item = findRecord(resource, id);
      if (!item) return toast('Record not found');
      els.modalTitle.textContent = `Edit ${resource.replace(/_/g, ' ')}`;
      els.modalBody.innerHTML = formMarkup(resource, item, 'Save Changes');
      els.modal.classList.add('open');
      if (resource === 'finances') bindFinanceProofField();
      document.getElementById('crm-edit-form')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const body = normalizePayload(resource, Object.fromEntries(new FormData(event.currentTarget).entries()));
        const validationError = validatePayload(resource, body);
        if (validationError) return toast(validationError);
        try {
          await portal(`/api/portal/${resource}/${id}`, { method: 'PATCH', body: JSON.stringify(body) });
          els.modal.classList.remove('open');
          toast('Saved');
          await loadData();
        } catch (error) {
          toast(error instanceof Error ? error.message : 'Update failed');
        }
      });
    }

    async function duplicateRecord(resource, id) {
      if (isDisabledResource(resource)) return toast(`${nice(resource)} is not enabled in this CRM.`);
      if (resource === 'profiles' && !isCompanyAdmin()) return toast('Only company admins can duplicate user records.');
      const item = findRecord(resource, id);
      if (!item) return toast('Record not found');
      const body = { ...item };
      ['id', 'created_at', 'updated_at', 'sent_at', 'viewed_at', 'paid_at'].forEach((key) => delete body[key]);
      if (body.name) body.name = `${body.name} Copy`;
      if (body.subject) body.subject = `${body.subject} Copy`;
      if (body.reference_id) body.reference_id = `${body.reference_id}-COPY`;
      if (body.invoice_number) delete body.invoice_number;
      try {
        await portal(`/api/portal/${resource}`, { method: 'POST', body: JSON.stringify(normalizePayload(resource, body)) });
        toast('Duplicated');
        await loadData();
      } catch (error) {
        toast(error instanceof Error ? error.message : 'Duplicate failed');
      }
    }

    async function deleteRecord(resource, id) {
      if (isDisabledResource(resource)) return toast(`${nice(resource)} is not enabled in this CRM.`);
      if (resource === 'profiles' && !isCompanyAdmin()) return toast('Only company admins can delete user records.');
      if (!id || !confirm(`Delete this ${resource.slice(0, -1) || resource}? This cannot be undone.`)) return;
      try {
        await portal(`/api/portal/${resource}/${id}`, { method: 'DELETE' });
        toast('Deleted');
        await loadData();
      } catch (error) {
        toast(error instanceof Error ? error.message : 'Delete failed');
      }
    }

    async function quickPatch(button) {
      try {
        await portal(`/api/portal/${button.dataset.quickPatch}/${button.dataset.quickId}`, {
          method: 'PATCH',
          body: JSON.stringify({ [button.dataset.quickField]: button.dataset.quickValue }),
        });
        toast('Updated');
        await loadData();
      } catch (error) {
        toast(error instanceof Error ? error.message : 'Update failed');
      }
    }

    function selectedRows() {
      return Array.from(document.querySelectorAll('[data-row-select]:checked')).map((input) => input.closest('[data-row-id]')).filter(Boolean);
    }

    function updateSelectionBar() {
      const rows = selectedRows();
      els.selectedCount.textContent = `${rows.length} selected`;
      els.actionbar.classList.toggle('show', rows.length > 0);
    }

    function clearSelection() {
      document.querySelectorAll('[data-row-select]').forEach((input) => { input.checked = false; });
      updateSelectionBar();
    }

    async function bulkDelete() {
      const rows = selectedRows();
      if (!rows.length || !confirm(`Delete ${rows.length} selected records?`)) return;
      if (rows.some((row) => isDisabledResource(row.dataset.resource))) return toast('One or more selected records belong to disabled CRM modules.');
      if (rows.some((row) => row.dataset.resource === 'profiles') && !isCompanyAdmin()) return toast('Only company admins can bulk delete user records.');
      try {
        await Promise.all(rows.map((row) => portal(`/api/portal/${row.dataset.resource}/${row.dataset.rowId}`, { method: 'DELETE' })));
        toast(`Deleted ${rows.length} records`);
        await loadData();
      } catch (error) {
        toast(error instanceof Error ? error.message : 'Bulk delete failed');
      }
    }

    function bulkExport() {
      const rows = selectedRows().map((row) => findRecord(row.dataset.resource, row.dataset.rowId)).filter(Boolean);
      if (!rows.length) return;
      const keys = Array.from(new Set(rows.flatMap((row) => Object.keys(row)))).filter((key) => !String(key).endsWith('_at'));
      const csv = [keys.join(','), ...rows.map((row) => keys.map((key) => `"${String(row[key] ?? '').replace(/"/g, '""')}"`).join(','))].join('\n');
      downloadCsv(csv, 'techmigos-selected-records.csv');
    }

    function exportRows(kind) {
      const configs = {
        projects: { rows: state.data.projects, keys: ['external_project_id', 'name', 'client_name', 'project_manager', 'status', 'budget', 'progress'] },
        finance: { rows: state.data.finances, keys: ['transaction_date', 'transaction_type', 'reference_id', 'title', 'client', 'project', 'status', 'amount'] },
        finances: { rows: state.data.finances, keys: ['transaction_date', 'transaction_type', 'reference_id', 'title', 'client', 'project', 'status', 'amount'] },
        tickets: { rows: state.data.tickets, keys: ['id', 'subject', 'client_id', 'project_id', 'priority', 'assigned_to', 'status'] },
        clients: { rows: state.data.clients, keys: ['name', 'company', 'email', 'phone', 'status'] },
        employees: { rows: employeeSeed(), keys: ['name', 'email', 'role', 'status'] },
        users: { rows: state.data.profiles.length ? state.data.profiles : employeeSeed(), keys: ['name', 'email', 'role', 'status', 'client_id'] },
      };
      const config = configs[kind] || configs.finance;
      const rows = config.rows;
      const keys = config.keys;
      const csv = [keys.join(','), ...rows.map((row) => keys.map((key) => `"${String(row[key] ?? '').replace(/"/g, '""')}"`).join(','))].join('\n');
      downloadCsv(csv, `techmigos-${kind}.csv`);
    }

    function downloadCsv(csv, filename) {
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = filename;
      link.click();
      URL.revokeObjectURL(url);
    }

    function invoiceHtml(detail) {
      const inv = detail.invoice;
      const cur = inv.currency || 'INR';
      const sym = cur === 'INR' ? '₹' : cur;
      const fmt = (v) => `${sym} ${Number(v || 0).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 })}`;
      const fmtNum = (v) => Number(v || 0).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
      const esc = escapeHtml;

      const billName = inv.customer_name || detail.client?.name || '';
      const billCompany = inv.customer_company || detail.client?.company || '';
      const billPhone = inv.customer_phone || detail.client?.phone || '';
      const billEmail = inv.customer_email || detail.client?.email || '';
      const billAddr = inv.billing_address || '';

      const total = Number(inv.total_amount || inv.amount || 0);
      const received = Number(inv.received_amount || (inv.status === 'paid' ? total : 0));
      const balance = Math.max(total - received, 0);

      const statusLabel = String(inv.status || 'draft').toUpperCase().replace(/_/g, ' ');

      const items = detail.items || [];
      const itemRows = items.map((item, i) => `
        <tr>
          <td style="border:1px solid #ccc;padding:6px 8px;text-align:center;vertical-align:top;">${i + 1}</td>
          <td style="border:1px solid #ccc;padding:6px 8px;vertical-align:top;">
            <strong>${esc(item.description)}</strong>
            ${item.notes ? `<br><span style="color:#666;font-size:9px;">${esc(item.notes)}</span>` : ''}
            ${inv.service_title && i === 0 && item.description !== inv.service_title ? `<br><span style="color:#888;font-size:9px;">${esc(inv.service_title)}</span>` : ''}
          </td>
          <td style="border:1px solid #ccc;padding:6px 8px;text-align:center;vertical-align:top;">${fmtNum(item.quantity)} SERVICE</td>
          <td style="border:1px solid #ccc;padding:6px 8px;text-align:right;vertical-align:top;">${fmtNum(item.rate)}</td>
          <td style="border:1px solid #ccc;padding:6px 8px;text-align:right;vertical-align:top;">${fmtNum(item.amount)}</td>
        </tr>`).join('');

      return `<article class="invoice-print-sheet" style="width:100%;max-width:780px;margin:0 auto;font-family:Arial,sans-serif;font-size:11px;color:#111;background:#fff;">

        <!-- BILL OF SUPPLY header bar -->
        <div style="display:flex;align-items:center;gap:10px;padding:6px 0 8px;border-bottom:1px solid #333;">
          <span style="font-weight:900;font-size:13px;letter-spacing:0.03em;">BILL OF SUPPLY</span>
          <span style="border:1px solid #888;padding:2px 8px;font-size:9px;font-weight:700;color:#555;">ORIGINAL FOR RECIPIENT</span>
          <span style="background:#22c55e;color:#fff;padding:2px 8px;font-size:9px;font-weight:700;">${esc(statusLabel)}</span>
        </div>

        <!-- Company header box with logo -->
        <div style="border:1px solid #ccc;margin-top:6px;padding:10px 14px;display:flex;align-items:center;justify-content:space-between;">
          <div style="display:flex;align-items:center;gap:12px;">
            <img src="/icon.png" class="inv-logo" style="width:56px;height:56px;object-fit:contain;" alt="TechMigos" />
            <div>
              <div style="font-size:18px;font-weight:900;letter-spacing:-0.01em;">TechMigos</div>
              <div style="font-size:10px;color:#555;">Hyderabad, Hyderabad, Telangana, 500097</div>
              <div style="font-size:10px;color:#555;"><strong>Mobile:</strong> 9959703547 &nbsp; <strong>Email:</strong> info@techmigos.com</div>
            </div>
          </div>
          <div style="text-align:right;font-size:10px;color:#555;">
            <div style="font-weight:700;color:#111;">${esc(statusLabel)}</div>
            <div>Due: ${sym} ${fmtNum(balance)}</div>
            ${inv.due_date ? `<div>Due Date: ${esc(inv.due_date)}</div>` : ''}
          </div>
        </div>

        <!-- BILL TO + Invoice meta table -->
        <table style="width:100%;border-collapse:collapse;margin-top:0;" class="inv-no-break">
          <tr>
            <td style="border:1px solid #ccc;padding:8px 10px;width:45%;vertical-align:top;">
              <div style="font-size:9px;font-weight:700;color:#555;text-transform:uppercase;letter-spacing:0.05em;">Bill To</div>
              <div style="font-size:13px;font-weight:900;margin-top:3px;">${esc(billName)}${billCompany && billCompany !== billName ? `<br><span style="font-size:11px;font-weight:600;">${esc(billCompany)}</span>` : ''}</div>
              ${billPhone ? `<div style="font-size:10px;margin-top:2px;"><strong>Mobile:</strong> ${esc(billPhone)}</div>` : ''}
              ${billEmail ? `<div style="font-size:10px;"><strong>Email:</strong> ${esc(billEmail)}</div>` : ''}
              ${billAddr ? `<div style="font-size:10px;margin-top:2px;white-space:pre-line;">${esc(billAddr)}</div>` : ''}
            </td>
            <td style="border:1px solid #ccc;padding:8px 10px;vertical-align:top;">
              <strong>Invoice No.</strong><br>${esc(inv.invoice_number)}
            </td>
            <td style="border:1px solid #ccc;padding:8px 10px;vertical-align:top;">
              <strong>Invoice Date</strong><br>${esc(inv.invoice_date || '')}
            </td>
            <td style="border:1px solid #ccc;padding:8px 10px;vertical-align:top;">
              <strong>Due Date</strong><br>${esc(inv.due_date || '-')}
            </td>
          </tr>
        </table>

        <!-- Line items table -->
        <table style="width:100%;border-collapse:collapse;margin-top:0;" class="inv-no-break">
          <thead>
            <tr style="background:#f3f4f6;">
              <th style="border:1px solid #ccc;padding:6px 8px;text-align:center;width:40px;">S.NO.</th>
              <th style="border:1px solid #ccc;padding:6px 8px;text-align:center;">SERVICES</th>
              <th style="border:1px solid #ccc;padding:6px 8px;text-align:center;width:90px;">QTY.</th>
              <th style="border:1px solid #ccc;padding:6px 8px;text-align:center;width:70px;">RATE</th>
              <th style="border:1px solid #ccc;padding:6px 8px;text-align:center;width:80px;">AMOUNT</th>
            </tr>
          </thead>
          <tbody>
            ${itemRows || `<tr><td colspan="5" style="border:1px solid #ccc;padding:6px 8px;text-align:center;color:#999;">No line items</td></tr>`}
            <!-- spacer rows for consistent height -->
            <tr style="height:30px;"><td colspan="5" style="border-left:1px solid #ccc;border-right:1px solid #ccc;"></td></tr>
          </tbody>
          <tfoot>
            <tr style="background:#f3f4f6;">
              <td colspan="2" style="border:1px solid #ccc;padding:6px 8px;"></td>
              <td style="border:1px solid #ccc;padding:6px 8px;text-align:right;font-weight:700;">TOTAL</td>
              <td style="border:1px solid #ccc;padding:6px 8px;text-align:center;">${items.reduce((s, x) => s + Number(x.quantity || 0), 0)}</td>
              <td style="border:1px solid #ccc;padding:6px 8px;text-align:right;font-weight:900;">${fmt(total)}</td>
            </tr>
          </tfoot>
        </table>

        <!-- Received / Balance / Status row -->
        <table style="width:100%;border-collapse:collapse;margin-top:0;" class="inv-no-break">
          <tr>
            <td style="border:1px solid #ccc;padding:6px 10px;width:38%;"><strong>Received Amount: ${fmt(received)}</strong></td>
            <td style="border:1px solid #ccc;padding:6px 10px;width:38%;"><strong>Balance Amount: ${fmt(balance)}</strong></td>
            <td style="border:1px solid #ccc;padding:6px 10px;"><strong>Status: ${esc(statusLabel)}</strong></td>
          </tr>
        </table>

        <!-- Notes -->
        ${inv.notes ? `<div style="border:1px solid #ccc;border-top:0;padding:6px 10px;font-size:10px;"><strong>Notes:</strong> ${esc(inv.notes)}</div>` : ''}

        <!-- Payment Details -->
        ${inv.payment_instructions ? `<div style="border:1px solid #ccc;border-top:0;padding:6px 10px;font-size:10px;"><strong>Payment Details:</strong> ${esc(inv.payment_instructions)}</div>` : ''}

        <!-- Terms + Signatory -->
        <table style="width:100%;border-collapse:collapse;margin-top:0;" class="inv-no-break">
          <tr>
            <td style="border:1px solid #ccc;padding:8px 10px;vertical-align:top;width:55%;">
              ${inv.terms ? `<div><strong>Terms and Conditions</strong><div style="margin-top:4px;font-size:10px;white-space:pre-line;">${esc(inv.terms)}</div></div>` : ''}
            </td>
            <td style="border:1px solid #ccc;padding:8px 10px;text-align:center;vertical-align:bottom;">
              ${inv.sign_url ? `<img src="${esc(inv.sign_url)}" style="max-height:52px;max-width:140px;object-fit:contain;" alt="Signature" />` : '<div style="height:44px;"></div>'}
              <div style="border-top:1px solid #555;padding-top:4px;font-size:10px;font-weight:700;">Authorised Signatory For<br>TechMigos</div>
            </td>
          </tr>
        </table>
      </article>`;
    }

    function downloadInvoicePdf(id) {
      window.print();
    }

    function buildInvoicePreviewHtml(invoice, items) {
      const statusClass = statusTone(invoice.status);
      const itemRows = (items || []).map((item) => `<tr><td>${escapeHtml(item.description || '')}</td><td style="text-align:right">${Number(item.quantity || 0)}</td><td style="text-align:right">${escapeHtml(item.unit || 'N/A')}</td><td style="text-align:right">${money(item.rate || item.unit_price)}</td><td style="text-align:right">${money(item.amount || item.total || 0)}</td></tr>`).join('');
      return `<div class="ihp-head"><h4>${escapeHtml(invoice.invoice_number || 'Invoice')}</h4>${badge(invoice.status, statusClass)}</div>
        <dl class="ihp-grid">
          <dt>Client</dt><dd>${escapeHtml(invoice.customer_company || invoice.customer_name || clientName(invoice.client_id))}</dd>
          <dt>Date</dt><dd>${escapeHtml(invoice.invoice_date || '').slice(0, 10) || '-'}</dd>
          <dt>Due</dt><dd>${escapeHtml(invoice.due_date || '').slice(0, 10) || '-'}</dd>
          <dt>Service</dt><dd>${escapeHtml(invoice.service_title || '-')}</dd>
        </dl>
        ${items && items.length ? `<div class="ihp-items"><table><thead><tr><th>Description</th><th style="text-align:right">Qty</th><th style="text-align:right">Unit</th><th style="text-align:right">Rate</th><th style="text-align:right">Amount</th></tr></thead><tbody>${itemRows}</tbody></table></div>` : ''}
        <div class="ihp-foot"><span>Total</span><span>${money(invoice.total_amount || invoice.amount || 0)}</span></div>`;
    }

    async function showInvoice(id) {
      const result = await portal(`/api/portal/invoices/${id}`);
      const detail = result.detail;
      els.invoicePreviewTitle.textContent = `Invoice ${detail.invoice.invoice_number}`;
      els.invoicePreview.innerHTML = invoiceHtml(detail);
      els.invoiceModal.classList.add('open');
    }

    async function loadData() {
      try {
        const cached = sessionStorage.getItem('tm_crm_data');
        if (cached) {
          state.data = JSON.parse(cached);
          setStatus('Syncing with database...', 'success');
          render();
        } else {
          setStatus('Loading CRM data...');
        }
      } catch (e) {
        console.warn('Cache load failed:', e);
        setStatus('Loading CRM data...');
      }

      try {
        const skipList = new Set(['ticket_messages']);
        const names = Object.keys(state.data).filter((name) => {
          if (skipList.has(name)) return false;
          if (isDisabledResource(name)) return false;
          if (name === 'profiles' && state.profile?.role !== 'company_admin') return false;
          return true;
        });
        const results = await Promise.allSettled(names.map(async (name) => [name, (await portal(`/api/portal/${name}`)).items || []]));
        results.forEach((r) => { if (r.status === 'fulfilled') { const [name, items] = r.value; state.data[name] = items; } });
        
        try {
          sessionStorage.setItem('tm_crm_data', JSON.stringify(state.data));
        } catch (e) {
          console.warn('Cache write failed:', e);
        }

        setStatus('', 'success');
        render();
      } catch (error) {
        console.error(error);
        setStatus(error instanceof Error ? error.message : 'Sync failed', 'error');
      }
    }

    async function boot() {
      try {
        const { data: { session } } = await window.tmSupabase.auth.getSession();
        if (!session) return logout();
        if (DISABLED_CRM_RESOURCES.has(state.active)) {
          window.location.replace('/company/dashboard');
          return;
        }
        if (localStorage.getItem('tm_crm_sidebar_collapsed') === '1') {
          document.querySelector('.crm-app')?.classList.add('sidebar-collapsed');
          document.getElementById('crm-collapse').textContent = '⇥';
        }

        // Live clock
        function updateClock() {
          const now = new Date();
          const time = now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });
          const date = now.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' });
          document.getElementById('crm-clock-time').textContent = time;
          document.getElementById('crm-clock-date').textContent = date;
        }
        updateClock();
        setInterval(updateClock, 30000);

        document.getElementById('crm-logout-btn')?.addEventListener('click', () => {
          if (confirm('Sign out of TechMigos CRM?')) logout();
        });

        // Try profile from cache
        try {
          const cachedProfile = sessionStorage.getItem('tm_crm_profile');
          if (cachedProfile) {
            state.profile = JSON.parse(cachedProfile);
            const displayName = state.profile.name || 'TechMigos';
            const initials = displayName.split(' ').filter(Boolean).map((w) => w[0].toUpperCase()).slice(0, 2).join('');
          document.getElementById('crm-user-name').textContent = displayName;
          document.getElementById('crm-avatar').textContent = initials || 'TM';
          document.getElementById('crm-company-name').textContent = 'TechMigos';
          document.getElementById('crm-user-role').textContent = String(state.profile.role || 'company').replace(/_/g, ' ');
          syncNavVisibility();
        }
        } catch (e) {
          console.warn('Profile cache read failed:', e);
        }

        const me = await portal('/api/portal/me');
        state.profile = me.profile;
        try {
          sessionStorage.setItem('tm_crm_profile', JSON.stringify(state.profile));
        } catch (e) {
          console.warn('Profile cache write failed:', e);
        }

        const displayName = me.profile.name || 'TechMigos';
        const initials = displayName.split(' ').filter(Boolean).map((w) => w[0].toUpperCase()).slice(0, 2).join('');
        document.getElementById('crm-user-name').textContent = displayName;
        document.getElementById('crm-avatar').textContent = initials || 'TM';
        document.getElementById('crm-company-name').textContent = 'TechMigos';
        document.getElementById('crm-user-role').textContent = String(me.profile.role || 'company').replace(/_/g, ' ');
        syncNavVisibility();
        await loadData();
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'Could not load CRM.', 'error');
        setTimeout(logout, 1200);
      }
    }

    els.search.addEventListener('input', () => {
      state.search = els.search.value;
      render();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== els.search) {
        event.preventDefault();
        els.search.focus();
      }
    });
    document.getElementById('crm-modal-close')?.addEventListener('click', () => els.modal.classList.remove('open'));
    els.modal?.addEventListener('click', (e) => { if (e.target === els.modal) els.modal.classList.remove('open'); });
    document.getElementById('close-invoice')?.addEventListener('click', () => els.invoiceModal.classList.remove('open'));
    els.invoiceModal?.addEventListener('click', (e) => { if (e.target === els.invoiceModal) els.invoiceModal.classList.remove('open'); });
    document.getElementById('proof-preview-close')?.addEventListener('click', () => els.proofPreviewModal?.classList.remove('open'));
    els.proofPreviewModal?.addEventListener('click', (e) => { if (e.target === els.proofPreviewModal) els.proofPreviewModal.classList.remove('open'); });
    document.getElementById('print-invoice')?.addEventListener('click', () => window.print());
    document.getElementById('download-pdf-invoice')?.addEventListener('click', () => {
      const invoiceNumber = document.querySelector('#invoice-preview h1, #invoice-preview-title')?.textContent || 'invoice';
      const idMatch = String(invoiceNumber).match(/[\w-]+$/);
      const id = idMatch ? idMatch[0] : 'unknown';
      downloadInvoicePdf(id);
    });

    boot();
  </script>
</BaseLayout>
