          });
        }
        document.getElementById('settings-status').textContent = '';
      } catch (e) {
        document.getElementById('settings-status').textContent = 'Could not load settings from server.';
      }

      // Per-section save handlers
      async function saveSection(formId, endpoint, statusId, extraTransform) {
        const form = document.getElementById(formId);
        const statusEl = document.getElementById(statusId);
        if (!form || !statusEl) return;
        statusEl.style.display = 'none';
        try {
          let data = Object.fromEntries(new FormData(form).entries());
          if (extraTransform) data = extraTransform(data);
          await portal(endpoint, { method: 'PATCH', body: JSON.stringify(data) });
          statusEl.textContent = '✓ Saved'; statusEl.style.color = '#22c55e'; statusEl.style.display = '';
          toast('Settings saved successfully.');
          setTimeout(() => { statusEl.style.display = 'none'; }, 3000);
        } catch (err) {
          statusEl.textContent = '✗ Save failed'; statusEl.style.color = '#ef4444'; statusEl.style.display = '';
          toast(err instanceof Error ? err.message : 'Save failed.');
        }
      }

      document.getElementById('btn-save-company')?.addEventListener('click', () => {
        const cf = document.getElementById('form-company');
        const name = cf?.querySelector('[name="company_name"]')?.value?.trim();
        const email = cf?.querySelector('[name="company_email"]')?.value?.trim();
        if (!name) { toast('Company name is required.'); return; }
        if (!email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { toast('Valid company email is required.'); return; }
        saveSection('form-company', '/api/portal/settings/company', 'status-company');
      });

      document.getElementById('btn-save-invoice')?.addEventListener('click', () => {
        saveSection('form-invoice', '/api/portal/settings/invoice', 'status-invoice', (d) => ({
          ...d,
          starting_number: Number(d.starting_number) || 1,
          tax_rate: Number(d.tax_rate) || 0,
        }));
      });

      document.getElementById('settings-save-all-btn')?.addEventListener('click', async () => {
        document.getElementById('btn-save-company')?.click();
        await new Promise((r) => setTimeout(r, 200));
        document.getElementById('btn-save-invoice')?.click();
      });

      document.getElementById('btn-reset-password')?.addEventListener('click', () => toast('Password reset email sent. Check your inbox.'));
    }





