        document.getElementById('settings-status').textContent = 'Could not load settings.';
      }

      document.getElementById('settings-save-btn')?.addEventListener('click', saveSettings);
    }

    async function saveSettings() {
      const cf = document.getElementById('form-company');
      const inf = document.getElementById('form-invoice');
      const statusEl = document.getElementById('settings-status');
      if (statusEl) statusEl.textContent = 'Saving...';
      try {
        const tasks = [];
        if (cf) tasks.push(portal('/api/portal/settings/company', { method: 'PATCH', body: JSON.stringify(Object.fromEntries(new FormData(cf).entries())) }));
        if (inf) {
          const invData = Object.fromEntries(new FormData(inf).entries());
          invData.starting_number = Number(invData.starting_number);
          invData.tax_rate = Number(invData.tax_rate);
          tasks.push(portal('/api/portal/settings/invoice', { method: 'PATCH', body: JSON.stringify(invData) }));
        }
        await Promise.all(tasks);
        if (statusEl) { statusEl.textContent = 'Settings saved.'; statusEl.style.color = 'var(--crm-green)'; }
        toast('Settings saved');
      } catch (error) {
        if (statusEl) { statusEl.textContent = error instanceof Error ? error.message : 'Save failed'; statusEl.style.color = 'var(--crm-red)'; }
        toast(error instanceof Error ? error.message : 'Settings save failed');
      }
    }

