          .acc-tab-btn:hover:not(.active){color:#475569;}
          .acc-kpi-card{border-radius:14px;padding:18px 20px;}
          .acc-kpi-green{background:#22f25a;}
          .acc-kpi-purple{background:#b69df8;}
          .acc-kpi-dark{background:#0f172a;color:#fff;}
          .acc-kpi-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;opacity:.8;margin-bottom:10px;}
          .acc-kpi-value{font-size:24px;font-weight:800;letter-spacing:-.5px;line-height:1;}
          .acc-kpi-note{font-size:11px;opacity:.6;margin-top:6px;}
          .acc-financial-pulse{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(280px,.8fr);gap:14px;}
          .acc-pulse-metrics{display:grid;grid-template-columns:repeat(5,minmax(118px,1fr));gap:10px;}
          .acc-pulse-metric{min-width:0;padding:14px 15px;border:1px solid #e5e7eb;border-radius:12px;background:#fff;display:flex;flex-direction:column;gap:5px;}
          .acc-pulse-metric span,.acc-pulse-chart span{font-size:10px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#64748b;}
          .acc-pulse-metric strong{font-size:18px;line-height:1.1;letter-spacing:-.03em;color:#1e293b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
          .acc-pulse-metric small{font-size:10px;color:#94a3b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
          .acc-pulse-income{border-color:#bbf7d0;background:#f0fdf4;}
          .acc-pulse-income strong,.acc-pulse-balance-positive strong{color:#15803d;}
          .acc-pulse-balance-negative{border-color:#fecaca;background:#fff7f7;}
          .acc-pulse-balance-negative strong{color:#dc2626;}
