            <div class="crm-table-wrap">${table(financeSheetHeaders(), financeRows(), 'No finance records match the current filters.', `crm-table--ledger crm-density-${state.financeDensity} ${state.financeEditMode ? '' : 'crm-ledger-readonly'}`)}</div>
          </section>
          <div class="crm-stack">
            <section class="crm-card crm-chart-card"><div class="crm-card-head"><h2 class="crm-card-title">Monthly Cash Flow</h2></div><div id="cashflow-chart-container"></div><div class="crm-legend"><span><i style="background:#059669;"></i>Income</span><span><i style="background:#dc2626;"></i>Expense</span></div></section>
