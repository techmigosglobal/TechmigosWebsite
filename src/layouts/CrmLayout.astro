    .project-reference-quick-button.blue { background: #e5f0ff; color: #1769e8; }
    .project-reference-quick-button.orange { background: #fff1df; color: #e37c00; }
    .project-reference-quick-button.purple { background: #f0eaff; color: #7b4ff1; }

    .project-reference-table-card {
      display: flex;
      min-width: 0;
      min-height: 0;
      flex-direction: column;
      overflow: hidden;
      border: 1px solid #e0e9f0;
