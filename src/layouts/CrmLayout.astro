    function token() {
      return 'supabase-session';
    }

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
    }

    function proofIconMarkup(kind = 'file', size = 18) {
      const paths = {
        file: '<path d="M6 2.75h7l5 5V21.25H6z"></path><path d="M13 2.75v5h5"></path><path d="M9 12h6"></path><path d="M9 16h6"></path>',
        paperclip: '<path d="m8.5 12.5 5.8-5.8a3.18 3.18 0 0 1 4.5 4.5l-7.6 7.6a5 5 0 0 1-7.1-7.1l7.6-7.6a1.9 1.9 0 0 1 2.7 2.7l-7.2 7.2a.65.65 0 0 0 .9.9l6.5-6.5"></path>',
        upload: '<path d="M12 16V4"></path><path d="m7 9 5-5 5 5"></path><path d="M5 20h14"></path>',
        pending: '<circle cx="12" cy="12" r="8.5"></circle><path d="M12 7v5l3 2"></path>',
      };
      return `<svg class="acc-proof-icon" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths[kind] || paths.file}</svg>`;
    }

    function money(value, currency = 'INR') {
      return `${currency} ${Number(value || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    function compactMoney(value) {
      return `₹${Number(value || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 })}`;
    }

    const SETTLED_FINANCE_STATUSES = new Set(['paid', 'received', 'completed']);
    const SETTLED_EXPENSE_STATUSES = new Set(['paid', 'completed']);
    const SETTLED_INVOICE_STATUSES = new Set(['paid', 'completed']);
    const SETTLED_INVOICE_TRANSACTION_STATUSES = new Set(['paid', 'received', 'completed']);

    function normalizedStatus(value) {
      return String(value || '').trim().toLowerCase();
    }

    function isSettledFinance(item) {
      const transactionType = normalizedStatus(item.transaction_type);
      if (transactionType === 'invoice') return SETTLED_INVOICE_TRANSACTION_STATUSES.has(normalizedStatus(item.status));
      const statuses = ['income', 'revenue'].includes(transactionType)
        ? SETTLED_FINANCE_STATUSES
        : SETTLED_EXPENSE_STATUSES;
      return statuses.has(normalizedStatus(item.status));
    }

    function isSettledInvoice(invoice) {
      return SETTLED_INVOICE_STATUSES.has(normalizedStatus(invoice.status));
    }

    function invoiceTotal(invoice) {
      return Math.max(Number(invoice.total_amount || invoice.amount || 0), 0);
    }

    function invoicePaidAmount(invoice) {
      const total = invoiceTotal(invoice);
      if (isSettledInvoice(invoice)) return total;
      return Math.min(Math.max(Number(invoice.received_amount || 0), 0), total);
    }

    function invoiceBalance(invoice) {
      if (normalizedStatus(invoice.status) === 'cancelled') return 0;
      return Math.max(invoiceTotal(invoice) - invoicePaidAmount(invoice), 0);
    }

    function standaloneInvoiceBalance(item, invoices = state.data.invoices) {
      if (normalizedStatus(item.transaction_type) !== 'invoice' || isSettledFinance(item)) return 0;
      if (normalizedStatus(item.status) === 'cancelled') return 0;
      if (item.invoice_id && invoices.some((invoice) => String(invoice.id) === String(item.invoice_id))) return 0;
      return Math.max(Number(item.amount || 0), 0);
    }

    function outstandingInvoiceRows(invoices = state.data.invoices, finances = state.data.finances) {
      return [
        ...invoices.filter((invoice) => invoiceBalance(invoice) > 0).map((invoice) => ({
          ...invoice,
          amount: invoiceBalance(invoice),
          record_kind: 'invoice',
        })),
        ...finances.filter((item) => standaloneInvoiceBalance(item, invoices) > 0),
      ];
    }

    function outstandingInvoiceAmount(invoices = state.data.invoices, finances = state.data.finances) {
      return sumAmounts(outstandingInvoiceRows(invoices, finances));
    }

    const UPI_ID = 'v5219@slc';
    const UPI_MERCHANT_NAME = 'TechMigos';

    function buildUpiPaymentUri(upiId, merchantName, invoiceNumber, amount) {
      const balanceAmount = Math.max(Number(amount) || 0, 0).toFixed(2);
      const paymentNote = `Invoice ${invoiceNumber}`;
      return `upi://pay?pa=${upiId}&pn=${encodeURIComponent(merchantName)}&am=${balanceAmount}&cu=INR&tn=${encodeURIComponent(paymentNote)}&tr=${encodeURIComponent(invoiceNumber)}`;
    }

    function buildUpiQrUrl(upiPaymentUri) {
      return `https://api.qrserver.com/v1/create-qr-code/?size=160x160&format=png&data=${encodeURIComponent(upiPaymentUri)}`;
    }

    function invoiceEffectiveStatus(invoice, now = new Date()) {
      const status = normalizedStatus(invoice.status) || 'draft';
      if (isSettledInvoice(invoice) || status === 'cancelled') return status;
      if (invoiceBalance(invoice) > 0 && invoice.due_date) {
        const dueDate = new Date(`${String(invoice.due_date).slice(0, 10)}T23:59:59`);
        if (!Number.isNaN(dueDate.getTime()) && dueDate < now) return 'overdue';
      }
      return status;
    }

    function invoiceProjectSnapshot(invoice) {
      const snapshot = invoice?.project_snapshot;
      if (snapshot && typeof snapshot === 'object' && !Array.isArray(snapshot)) return snapshot;
      return state.data.projects.find((project) => String(project.id) === String(invoice?.project_id)) || {};
    }

    function invoiceBranding(invoice) {
      const branding = invoice?.invoice_branding;
      return branding && typeof branding === 'object' && !Array.isArray(branding) ? branding : {};
    }

    function invoiceLedgerRecord(invoice, finances = state.data.finances) {
      const invoiceId = String(invoice?.id || '');
      if (!invoiceId) return null;
      return finances.find((item) =>
        normalizedStatus(item.transaction_type) === 'invoice'
        && String(item.invoice_id || '') === invoiceId,
      ) || null;
    }

    function invoiceIncomeRows(invoices = state.data.invoices, finances = state.data.finances) {
      const linkedInvoiceIds = new Set(
        finances
          .filter((item) => ['income', 'revenue', 'invoice'].includes(normalizedStatus(item.transaction_type)) && item.invoice_id)
          .map((item) => String(item.invoice_id)),
      );
      return invoices
        .filter((invoice) => isSettledInvoice(invoice))
        .filter((invoice) => !linkedInvoiceIds.has(String(invoice.id)))
        .map((invoice) => ({
          ...invoice,
          id: `invoice-${invoice.id}`,
          invoice_id: invoice.id,
          record_kind: 'invoice',
          transaction_type: 'invoice',
          transaction_date: invoice.invoice_date || String(invoice.created_at || '').slice(0, 10),
          reference_id: invoice.invoice_number,
          title: invoice.service_title || invoice.invoice_number || 'Invoice income',
          client: invoice.customer_company || invoice.customer_name || clientName(invoice.client_id),
          project: projectName(invoice.project_id),
          amount: invoicePaidAmount(invoice),
          status: invoiceEffectiveStatus(invoice),
          source: 'invoice',
        }));
    }

    function invoiceLedgerEntryRows(finances = state.data.finances) {
      return finances
        .filter((item) => normalizedStatus(item.transaction_type) === 'invoice' && !item.invoice_id)
        .map((item) => ({ ...item, record_kind: 'invoice_ledger' }));
    }

    function incomeRows(finances = state.data.finances, invoices = state.data.invoices) {
      const invoiceLedgerIds = new Set(
        finances
          .filter((item) => normalizedStatus(item.transaction_type) === 'invoice' && item.invoice_id)
          .map((item) => String(item.invoice_id)),
      );
      const ledgerIncome = finances.filter((item) => {
        const type = normalizedStatus(item.transaction_type);
        if (!['income', 'revenue', 'invoice'].includes(type) || !isSettledFinance(item)) return false;
        return !(type !== 'invoice' && item.invoice_id && invoiceLedgerIds.has(String(item.invoice_id)));
      });
      return [...ledgerIncome, ...invoiceIncomeRows(invoices, finances)];
    }

    function expenseRows(finances = state.data.finances) {
      return finances.filter((item) => ['expense', 'salary'].includes(normalizedStatus(item.transaction_type)) && isSettledFinance(item));
    }

    function sumAmounts(rows) {
      return rows.reduce((sum, item) => sum + Number(item.amount || 0), 0);
    }

    function nice(value) {
      return escapeHtml(String(value || '').replace(/_/g, ' ') || '-');
    }

    function toast(message) {
      els.toast.textContent = message;
      els.toast.classList.add('show');
      clearTimeout(toast.timer);
      toast.timer = setTimeout(() => els.toast.classList.remove('show'), 2400);
    }

    // showToast alias for backward compat with invoice builder/tracker code
    function showToast(message) { toast(message); }

    function setStatus(message, tone = 'neutral') {
      els.status.textContent = message;
      els.status.style.color = tone === 'error' ? 'var(--crm-red)' : tone === 'success' ? 'var(--crm-green)' : '#667599';
      let retry = document.getElementById('crm-retry-load');
      if (tone === 'error') {
        if (!retry) {
          retry = document.createElement('button');
          retry.id = 'crm-retry-load';
          retry.type = 'button';
          retry.className = 'crm-button';
          retry.textContent = 'Retry';
          els.status.insertAdjacentElement('afterend', retry);
          retry.addEventListener('click', () => loadData());
        }
        retry.style.display = 'inline-flex';
      } else if (retry) {
        retry.style.display = 'none';
      }
    }

    const RESOURCE_FIELDS = {
      leads: ['name', 'email', 'company', 'phone', 'service', 'budget', 'priority', 'status', 'assigned_to', 'message', 'source', 'source_path'],
      clients: ['name', 'company', 'email', 'phone', 'status', 'marketing_opt_in', 'notes'],
      projects: ['client_id', 'name', 'client_name', 'project_manager', 'owner_user_id', 'budget', 'expenses', 'revenue', 'status', 'health', 'progress', 'due_date', 'summary', 'notes'],
      deals: ['client_id', 'lead_id', 'title', 'stage', 'value', 'currency', 'expected_close_date', 'assigned_to', 'notes'],
      tickets: ['client_id', 'project_id', 'subject', 'description', 'priority', 'status', 'assigned_to'],
      invoices: ['client_id', 'project_id', 'invoice_number', 'invoice_date', 'due_date', 'currency', 'customer_name', 'customer_email', 'customer_phone', 'billing_address', 'service_title', 'discount_amount', 'tax_amount', 'total_amount', 'received_amount', 'status', 'notes', 'payment_instructions', 'terms', 'sign_url', 'project_snapshot', 'invoice_branding', 'is_recurring'],
      finances: ['invoice_id', 'transaction_date', 'transaction_type', 'reference_id', 'title', 'client', 'project', 'paid_by', 'received_by', 'payment_method', 'department', 'amount', 'status', 'notes', 'source', 'proof_url'],
      followups: ['related_type', 'related_id', 'title', 'due_at', 'status', 'assigned_to', 'notes'],
      campaigns: ['name', 'subject', 'body', 'status', 'msg91_template_id', 'scheduled_at', 'sent_at'],
      profiles: ['auth_user_id', 'email', 'name', 'role', 'status', 'client_id', 'department'],
      ticket_messages: ['ticket_id', 'body', 'author_name', 'author_role', 'visibility'],
    };

    const NUMERIC_FIELDS = new Set([
      'client_id', 'lead_id', 'project_id', 'ticket_id', 'invoice_id', 'related_id',
      'amount', 'budget', 'value', 'progress', 'expenses', 'revenue',
      'discount_amount', 'tax_amount', 'total_amount', 'received_amount',
      'quantity', 'rate', 'sort_order',
    ]);

    const BOOLEAN_FIELDS = new Set(['marketing_opt_in', 'is_recurring']);

    function isCompanyAdmin() {
      return state.profile?.role === 'company_admin';
    }

    function canWrite(resource) {
      const role = state.profile?.role;
      if (role === 'company_admin') return true;
      if (role === 'client') {
        return ['tickets', 'ticket_messages'].includes(resource);
      }
      return false;
    }

    function isDisabledResource(resource) {
      return DISABLED_CRM_RESOURCES.has(resource);
    }

    function validatePayload(resource, payload) {
      // Profiles: client login needs a client_id; all logins need name + email + role
      if (resource === 'profiles') {
        if (!payload.name || !String(payload.name).trim()) return 'Full name is required.';
        if (!payload.email || !String(payload.email).trim()) return 'Email address is required.';
        if (!payload.role) return 'Role is required.';
        if (payload.role === 'client' && !payload.client_id) return 'Select a client before creating a client login.';
      }
      // Clients: company name + contact name required
      if (resource === 'clients') {
        if (!payload.company || !String(payload.company).trim()) return 'Company name is required.';
        if (!payload.name || !String(payload.name).trim()) return 'Contact name is required.';
      }
      if (resource === 'projects' && !payload.client_id) {
        return 'Select a client for this project.';
      }
      if (resource === 'tickets') {
        if (!payload.client_id) return 'Select a client before creating the ticket.';
        if (!payload.subject || !String(payload.subject).trim()) return 'Ticket subject is required.';
      }
      if (resource === 'finances') {
        if (!payload.transaction_date) return 'Date is required for finance records.';
        if (!payload.transaction_type) return 'Category (transaction type) is required.';
        if (!['income', 'revenue', 'expense', 'salary', 'invoice'].includes(payload.transaction_type)) return 'Choose a valid finance category.';
        if (!payload.title || !String(payload.title).trim()) return 'Description is required.';
        if (payload.amount === undefined || payload.amount === null || String(payload.amount).trim() === '' || isNaN(Number(payload.amount))) return 'A valid amount is required.';
        if (!payload.status) return 'Status is required.';
        if (!['pending', 'paid', 'received', 'half_payment', 'cancelled'].includes(payload.status)) return 'Choose a valid finance status.';
      }
      return '';
    }

    function sanitizeResourcePayload(resource, payload = {}) {
      const allowed = RESOURCE_FIELDS[resource];
      const clean = {};
      Object.entries(payload || {}).forEach(([key, value]) => {
        if (!allowed || !allowed.includes(key)) return;
        if (typeof value === 'string') value = value.trim();
        if (value === '' || value === undefined || value === null) return;
        if (NUMERIC_FIELDS.has(key)) value = Number(value);
        if (BOOLEAN_FIELDS.has(key)) value = value === true || value === 'true' || value === 'on' || value === '1';
        clean[key] = value;
      });

      if (resource === 'projects' && clean.progress !== undefined) {
        clean.progress = Math.max(0, Math.min(100, Number(clean.progress || 0)));
      }

      return clean;
    }

    async function portal(path, options = {}) {
      if (window.tmCrmReady) await window.tmCrmReady;
      if (window.tmCrm?.repository) return window.tmCrm.repository.request(path, options);
      throw new Error('CRM repository is unavailable. Please refresh the page.');
    }

    function logout() {
      window.tmCrm?.repository?.clearSession?.();
      const userId = state.cacheUserId || state.profile?.auth_user_id;
      if (userId) {
        Object.keys(sessionStorage).filter((key) => key.includes(`_${userId}_`)).forEach((key) => sessionStorage.removeItem(key));
        sessionStorage.removeItem(`tm_crm_profile_${userId}`);
      }
      ['tm_crm_profile', 'tm_crm_data'].forEach((key) => sessionStorage.removeItem(key));
      window.tmSupabase.auth.signOut();
      location.href = '/login';
    }

    function clientName(id) {
      const client = state.data.clients.find((item) => String(item.id) === String(id));
      return client?.company || client?.name || `Client #${id || '-'}`;
    }

    function filtered(rows, keys) {
      const query = state.search.trim().toLowerCase();
      if (!query) return rows;
      return rows.filter((row) => keys.some((key) => String(row[key] || '').toLowerCase().includes(query)));
    }

    function statusTone(status) {
      if (['paid', 'received', 'active', 'completed', 'resolved', 'closed', 'on_track'].includes(status)) return 'green';
      if (['overdue', 'urgent', 'at_risk', 'cancelled'].includes(status)) return 'red';
      if (['sent', 'viewed', 'watch', 'high', 'half_payment', 'pending', 'on_hold'].includes(status)) return 'orange';
      if (['planning', 'proposal'].includes(status)) return 'purple';
      return 'blue';
    }

    function badge(value, tone = statusTone(value)) {
      return `<span class="crm-status ${tone}">${nice(value)}</span>`;
    }

    function rowActions(resource, id, options = {}) {
      const view = options.view ? `<button class="crm-mini-action" ${options.viewAttr || ''} type="button">View</button>` : '';
      const invoice = resource === 'invoices' ? `<button class="crm-mini-action" data-invoice-view="${id}" type="button">Invoice</button>` : '';
      const editable = canWrite(resource);
      const editBtn = editable ? `<button class="crm-mini-action" data-edit-resource="${resource}" data-edit-id="${id}" type="button" title="Edit"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>` : '';
      const deleteBtn = editable ? `<button class="crm-mini-action danger" data-delete-resource="${resource}" data-delete-id="${id}" type="button" title="Delete"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg></button>` : '';
      return `<div class="crm-row-actions">
        ${view}${invoice}
        ${editBtn}${deleteBtn}
      </div>`;
    }

    function metric(label, value, icon, color = 'blue', trend = 'Updated just now') {
      return `<article class="crm-card crm-kpi">
        <div class="crm-kpi-icon ${color}-soft">${icon}</div>
        <div><p class="crm-kpi-label">${label}</p><p class="crm-kpi-value">${value}</p><p class="crm-trend ${trend.startsWith('down') ? 'down' : 'up'}">${trend}</p></div>
      </article>`;
    }

    function progress(value) {
      const safe = Math.max(0, Math.min(100, Number(value || 0)));
      return `<div class="crm-progress"><div class="crm-progress-track"><div class="crm-progress-fill" style="width:${safe}%"></div></div><strong>${safe}%</strong></div>`;
    }

    function currentWeekLabel() {
      const now = new Date();
      const dayOfWeek = now.getDay() === 0 ? 6 : now.getDay() - 1;
      const weekStart = new Date(now);
      weekStart.setDate(now.getDate() - dayOfWeek);
      const weekEnd = new Date(weekStart);
      weekEnd.setDate(weekStart.getDate() + 6);
      const fmtDate = (date) => date.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
      return `${fmtDate(weekStart)} – ${fmtDate(weekEnd)}, ${weekEnd.getFullYear()}`;
    }

    function syncNavVisibility() {
      document.querySelectorAll('[data-nav-key]').forEach((link) => {
        const key = link.getAttribute('data-nav-key');
        const hideForNonAdmin = ['employees', 'users', 'settings'].includes(key) && !isCompanyAdmin();
        link.style.display = hideForNonAdmin ? 'none' : '';
      });
    }

    function renderShell() {
      document.querySelectorAll('[data-jump]').forEach((button) => button.addEventListener('click', () => {
        const target = button.dataset.jump;
        window.location.href = `/company/${target === 'users' ? 'user-management' : target}`;
      }));
    }

    function pageHead(title, subtitle, actions = '') {
      return `<div class="crm-page-head"><div><h1 class="crm-page-title">${title}</h1><p class="crm-page-subtitle">${subtitle}</p></div><div class="crm-toolbar">${actions}</div></div>`;
    }

    function table(headers, rows, empty = 'No records yet.', tableClass = '') {
      table.labelIndex = 0;
      const labeledRows = rows ? rows.replace(/<td(?![^>]*data-label=)([^>]*)>/g, (match, attrs) => {
        const index = table.labelIndex % headers.length;
        table.labelIndex += 1;
        return `<td data-label="${escapeHtml(headers[index] || '')}"${attrs}>`;
      }) : '';
      return `<div class="crm-table-wrap"><table class="crm-table ${tableClass}"><thead><tr>${headers.map((item) => `<th>${item}</th>`).join('')}</tr></thead><tbody>${labeledRows || `<tr><td data-label="" colspan="${headers.length}">${empty}</td></tr>`}</tbody></table></div>`;
    }
    table.labelIndex = 0;

    function renderDashboard() {
      const projects = state.data.projects;
      const tickets = state.data.tickets;
      const clients = state.data.clients;
      const collectedIncome = incomeRows();
      const settledExpenses = expenseRows();
      const income = sumAmounts(collectedIncome);
      const expenses = sumAmounts(settledExpenses);
      const openTickets = tickets.filter((item) => !['resolved', 'closed'].includes(item.status));
      const urgentTickets = openTickets.filter((item) => ['urgent', 'high'].includes(item.priority));
      const weekLabel = currentWeekLabel();

      // Accounts Receivable
      const receivableRows = outstandingInvoiceRows();
      const receivable = sumAmounts(receivableRows);

      // 6-month revenue trend data
      const monthTrend = (() => {
        const months = [];
        const incomeByMonth = [];
        const expenseByMonth = [];
        for (let i = 5; i >= 0; i--) {
          const d = new Date();
          d.setMonth(d.getMonth() - i);
          const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
          months.push(d.toLocaleString('en-IN', { month: 'short', year: '2-digit' }));
          incomeByMonth.push(collectedIncome.filter((f) => String(f.transaction_date || f.created_at || '').startsWith(key)).reduce((s, f) => s + Number(f.amount || 0), 0));
          expenseByMonth.push(settledExpenses.filter((f) => String(f.transaction_date || f.created_at || '').startsWith(key)).reduce((s, f) => s + Number(f.amount || 0), 0));
        }
        return { months, incomeByMonth, expenseByMonth };
      })();

      // Top 5 recent tickets
      const ticketRows = openTickets.slice(0, 5).map((ticket) => `
        <tr><td><strong style="font-size:11px;">#TIC-${ticket.id}</strong></td><td>${badge(ticket.priority, statusTone(ticket.priority))}</td><td style="max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escapeHtml(ticket.subject || '—')}</td><td>${badge(ticket.status)}</td></tr>
      `).join('');

      // Top 5 projects
      const projectRows = projects.filter((p) => ['active','review','planning'].includes(p.status)).slice(0, 5).map((project) => `
        <tr><td><strong>${escapeHtml(project.name)}</strong></td><td>${escapeHtml(project.client_name || clientName(project.client_id))}</td><td>${badge(project.status)}</td><td>${progress(project.progress)}</td></tr>
      `).join('');

      // Overdue projects
      const today = new Date();
      const overdueProjects = projects.filter((p) => p.due_date && new Date(p.due_date) < today && !['completed','cancelled'].includes(p.status));

      els.view.innerHTML = `
        ${pageHead('Operations Dashboard', `${new Date().toLocaleDateString('en-IN', { weekday:'long', year:'numeric', month:'long', day:'numeric' })} — Welcome back, ${escapeHtml(state.profile?.name || 'Team')}.`, `<button class="crm-button" type="button">${escapeHtml(weekLabel)}</button><button class="crm-button primary" type="button" data-jump="reports">Open Reports</button>`)}

        <!-- Hero Banner -->
        <section class="crm-card crm-hero-panel" style="margin-bottom:16px;">
          <div class="crm-hero-grid">
            <div>
              <span class="crm-hero-kicker">Company Overview</span>
              <h2 class="crm-hero-title">Good ${new Date().getHours() < 12 ? 'morning' : new Date().getHours() < 17 ? 'afternoon' : 'evening'}, ${escapeHtml((state.profile?.name || 'Team').split(' ')[0])}.</h2>
              <p class="crm-hero-copy">
                ${openTickets.length ? `<strong style="color:#ef4444;">${openTickets.length} open ticket${openTickets.length !== 1 ? 's' : ''}</strong>${urgentTickets.length ? ` (${urgentTickets.length} urgent)` : ''}, ` : 'Ticket queue is clear. '}
                ${projects.filter((p) => ['active','review','planning'].includes(p.status)).length} live project${projects.filter((p) => ['active','review','planning'].includes(p.status)).length !== 1 ? 's' : ''},
                ${receivable ? `<strong style="color:#d97706;">${compactMoney(receivable)} pending collection</strong>` : 'no outstanding receivables'}.
              </p>
              <div class="crm-toolbar" style="margin-top:12px;gap:8px;">
                ${canWrite('tickets') ? `<button class="crm-button primary" data-create="tickets" type="button">+ New Ticket</button>` : ''}
                ${canWrite('invoices') ? `<button class="crm-button" data-create="invoices" type="button">+ Invoice</button>` : ''}
                ${canWrite('clients') ? `<button class="crm-button" data-create="clients" type="button">+ Client</button>` : ''}
                <button class="crm-button" data-jump="finance" type="button">Finance Desk</button>
              </div>
            </div>
            <div class="crm-hero-meta">
              <span class="crm-meta-label">Net Cash Position</span>
              <span class="crm-meta-value" style="color:${income - expenses >= 0 ? '#22c55e' : '#ef4444'};">${compactMoney(income - expenses)}</span>
              <p class="crm-meta-note">${income >= expenses ? '↑ Revenue is covering operating spend.' : '↓ Spend is ahead of collected revenue.'}</p>
              ${overdueProjects.length ? `<div style="margin-top:10px;padding:8px 12px;background:#fef3c7;border-radius:8px;font-size:12px;font-weight:700;color:#92400e;">⚠ ${overdueProjects.length} overdue project${overdueProjects.length !== 1 ? 's' : ''} need attention</div>` : ''}
            </div>
          </div>
        </section>

        <!-- KPIs -->
        <div class="crm-grid crm-kpis" style="margin-bottom:16px;">
          ${metric('Total Projects', projects.length, '▣', 'blue', `${projects.filter((p) => p.status === 'completed').length} completed`)}
          ${metric('Active Clients', clients.filter((c) => c.status !== 'archived').length, '○', 'green', `${clients.filter((c) => c.status === 'lead').length} in pipeline`)}
          ${metric('Open Tickets', openTickets.length, '◴', openTickets.length ? 'red' : 'green', urgentTickets.length ? `${urgentTickets.length} urgent` : 'Queue under control')}
          ${metric('Revenue Collected', compactMoney(income), '₹', 'green', `${compactMoney(expenses)} expenses`)}
          ${metric('Receivables', compactMoney(receivable), '◈', receivable > 0 ? 'orange' : 'green', receivable > 0 ? `${receivableRows.length} outstanding invoices` : 'All invoices settled')}
        </div>

        <!-- Main Content: 2 columns -->
        <div class="crm-two-col" style="margin-bottom:16px;">
          <!-- Revenue Trend Chart -->
          <section class="crm-card">
            <div class="crm-card-head">
              <h2 class="crm-card-title">Revenue vs Expenses (6 months)</h2>
              <button class="crm-link" data-jump="finance">Finance desk</button>
            </div>
            <div style="height:200px;position:relative;padding:4px 0 0;">
              <canvas id="dash-revenue-chart"></canvas>
            </div>
            <div class="crm-list" style="margin-top:10px;">
              <div class="crm-list-row"><span>Revenue collected</span><strong class="crm-amount-positive">${compactMoney(income)}</strong></div>
              <div class="crm-list-row"><span>Operating expenses</span><strong class="crm-amount-negative">${compactMoney(expenses)}</strong></div>
              <div class="crm-list-row"><span>Net position</span><strong class="${income - expenses >= 0 ? 'crm-amount-positive' : 'crm-amount-negative'}">${compactMoney(income - expenses)}</strong></div>
              <div class="crm-list-row"><span>Receivables</span><strong>${compactMoney(receivable)}</strong></div>
            </div>
          </section>

          <!-- Project Pipeline -->
          <section class="crm-card crm-table-card">
            <div class="crm-card-head">
              <h2 class="crm-card-title">Active Projects</h2>
              <button class="crm-link" data-jump="projects">View all</button>
            </div>
            ${table(['Project', 'Client', 'Status', 'Progress'], projectRows, 'No active projects.')}
          </section>
        </div>

        <!-- Bottom row: 3 columns -->
        <div class="crm-three-col">
          <!-- Open Tickets -->
          <section class="crm-card crm-table-card">
            <div class="crm-card-head">
              <h2 class="crm-card-title">Open Tickets ${openTickets.length ? `<span style="font-size:11px;font-weight:700;background:#fee2e2;color:#dc2626;padding:2px 7px;border-radius:99px;margin-left:6px;">${openTickets.length}</span>` : ''}</h2>
              <button class="crm-link" data-jump="tickets">Support desk</button>
            </div>
            ${table(['ID', 'Priority', 'Subject', 'Status'], ticketRows, 'No open tickets — queue is clear.')}
          </section>

          <!-- Recent Activity -->
          <section class="crm-card">
            <div class="crm-card-head"><h2 class="crm-card-title">Recent Activity</h2></div>
            <div class="crm-list">
              ${state.data.activities.slice(0, 7).map((item) => `<div class="crm-list-row"><span style="font-size:12px;">${escapeHtml(item.summary || item.action || 'Activity')}</span><small style="color:#94a3b8;white-space:nowrap;">${escapeHtml(String(item.created_at || '').slice(0, 10) || 'Recently')}</small></div>`).join('') || '<p class="crm-empty">No recent activity yet.</p>'}
            </div>
          </section>

          <!-- Watchlist + Quick Actions -->
          <section class="crm-card">
            <div class="crm-card-head"><h2 class="crm-card-title">Watchlist & Actions</h2></div>
            ${overdueProjects.length || projects.filter((p) => ['watch','at_risk','breached'].includes(p.health)).length ? `
            <div class="crm-list" style="margin-bottom:12px;">
              ${projects.filter((p) => ['watch','at_risk','breached'].includes(p.health)).slice(0, 3).map((p) => `<div class="crm-list-row"><span>${escapeHtml(p.name)}</span>${badge(p.health || 'watch', 'orange')}</div>`).join('')}
              ${overdueProjects.slice(0,2).map((p) => `<div class="crm-list-row"><span>${escapeHtml(p.name)}</span><small style="color:#ef4444;font-weight:700;">Overdue</small></div>`).join('')}
            </div>` : `<p class="crm-empty" style="padding:12px 18px;">No delivery risks right now.</p>`}
            <div style="padding:12px 18px;border-top:1px solid #f1f5f9;display:flex;flex-direction:column;gap:8px;">
              <p style="font-size:10px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;">Quick Actions</p>
              ${canWrite('projects') ? `<button class="crm-button primary" data-create="projects" type="button" style="width:100%;">+ New Project</button>` : ''}
              ${canWrite('clients') ? `<button class="crm-button" data-create="clients" type="button" style="width:100%;">+ Add Client</button>` : ''}
              <button class="crm-button" data-jump="analytics" type="button" style="width:100%;">View Analytics</button>
            </div>
          </section>
        </div>
      `;

      // Render Chart.js revenue trend
      requestAnimationFrame(() => {
        const ctx = document.getElementById('dash-revenue-chart')?.getContext('2d');
        if (ctx && window.Chart) {
          new window.Chart(ctx, {
            type: 'line',
            data: {
              labels: monthTrend.months,
              datasets: [
                { label: 'Revenue', data: monthTrend.incomeByMonth, borderColor: '#22c55e', backgroundColor: '#22c55e22', fill: true, tension: 0.4, pointRadius: 4, pointBackgroundColor: '#22c55e', borderWidth: 2 },
                { label: 'Expenses', data: monthTrend.expenseByMonth, borderColor: '#ef4444', backgroundColor: '#ef444422', fill: true, tension: 0.4, pointRadius: 4, pointBackgroundColor: '#ef4444', borderWidth: 2 },
              ],
            },
            options: {
              responsive: true, maintainAspectRatio: false,
              plugins: { legend: { position: 'bottom', labels: { font: { size: 10 }, boxWidth: 12 } } },
              scales: {
                y: { ticks: { font: { size: 10 }, callback: (v) => '₹' + (v >= 1000 ? (v/1000).toFixed(0)+'k' : v) }, grid: { color: '#f1f5f9' } },
                x: { ticks: { font: { size: 10 } }, grid: { display: false } },
              },
            },
          });
        }
      });
    }

    // ── PROJECT MANAGEMENT — FULL RECODE ─────────────────────────────────────

    function projectHealthDot(health) {
      const map = { on_track: '#22c55e', watch: '#f59e0b', at_risk: '#ef4444', breached: '#dc2626' };
      const color = map[health] || '#94a3b8';
      return `<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${color};flex-shrink:0;"></span>`;
    }

    function daysUntil(dateStr) {
      if (!dateStr) return null;
      const diff = Math.ceil((new Date(dateStr) - new Date()) / 86400000);
      return diff;
    }

    function dueBadge(dateStr) {
      const d = daysUntil(dateStr);
      if (d === null) return '';
      if (d < 0) return `<span style="font-size:10px;font-weight:700;background:#fee2e2;color:#dc2626;padding:2px 6px;border-radius:99px;">Overdue ${Math.abs(d)}d</span>`;
      if (d <= 7) return `<span style="font-size:10px;font-weight:700;background:#fef3c7;color:#d97706;padding:2px 6px;border-radius:99px;">Due in ${d}d</span>`;
      return `<span style="font-size:10px;font-weight:700;background:#f1f5f9;color:#475569;padding:2px 6px;border-radius:99px;">${d}d left</span>`;
    }

    function projectKanbanCard(project) {
      const prog = Math.max(0, Math.min(100, Number(project.progress || 0)));
      const budget = Number(project.budget || 0);
      const spent = Number(project.expenses || 0);
      const budgetPct = budget ? Math.min(100, Math.round((spent / budget) * 100)) : 0;
      const tickets = state.data.tickets.filter((t) => String(t.project_id) === String(project.id));
      const openTickets = tickets.filter((t) => !['resolved','closed'].includes(t.status));
      const isSelected = String(project.id) === String(state.selectedProjectId);
      return `
        <div class="pm-card ${isSelected ? 'pm-card--selected' : ''}" data-project-detail="${project.id}" data-row-id="${project.id}" data-resource="projects" data-dnd-card="${project.id}" draggable="true" tabindex="0" role="button" aria-label="Select project ${escapeHtml(project.name)}">
          <div class="pm-card-top">
            <div style="display:flex;align-items:center;gap:6px;flex:1;min-width:0;">
              ${projectHealthDot(project.health)}
              <span class="pm-card-title">${escapeHtml(project.name)}</span>
            </div>
            ${dueBadge(project.due_date)}
          </div>
          <div class="pm-card-client">${escapeHtml(project.client_name || clientName(project.client_id) || '—')}</div>
          <div class="pm-card-meta">
            <span>PM: ${escapeHtml(project.project_manager || '—')}</span>
            ${openTickets.length ? `<span style="color:#ef4444;">● ${openTickets.length} open tickets</span>` : ''}
          </div>
          <div class="pm-progress-wrap">
            <div class="pm-progress-bar"><div class="pm-progress-fill" style="width:${prog}%"></div></div>
            <span class="pm-progress-pct">${prog}%</span>
          </div>
          <div class="pm-card-footer">
            <span>${compactMoney(budget)}</span>
            ${budgetPct > 80 ? `<span style="color:#ef4444;font-size:10px;font-weight:700;">${budgetPct}% spent</span>` : `<span style="color:#64748b;font-size:10px;">${budgetPct}% spent</span>`}
          </div>
          <div class="pm-card-actions">
            ${canWrite('projects') ? `<button class="pm-btn-sm" data-edit-resource="projects" data-edit-id="${project.id}" type="button" title="Edit"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>` : ''}
            ${canWrite('projects') ? `<button class="pm-btn-sm danger" data-delete-resource="projects" data-delete-id="${project.id}" type="button" title="Delete"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M9 6V4h6v2"/></svg></button>` : ''}
          </div>
        </div>`;
    }

    function renderProjectKanban(allProjects) {
      const stages = [
        { key: 'planning',  label: 'Planning',    color: '#6366f1' },
        { key: 'active',    label: 'Active',      color: '#22c55e' },
        { key: 'review',    label: 'In Review',   color: '#f59e0b' },
        { key: 'on_hold',   label: 'On Hold',     color: '#94a3b8' },
        { key: 'completed', label: 'Completed',   color: '#10b981' },
      ];
      return `<div class="pm-board">${stages.map(({ key, label, color }) => {
        const cols = allProjects.filter((p) => p.status === key);
        return `
          <div class="pm-column">
            <div class="pm-col-head">
              <span class="pm-col-dot" style="background:${color}"></span>
              <span class="pm-col-label">${label}</span>
              <span class="pm-col-count">${cols.length}</span>
            </div>
            <div class="pm-col-body" data-dnd-col="${key}" style="min-height:60px;">${cols.map(projectKanbanCard).join('') || '<div class="pm-empty-col">No projects</div>'}</div>
          </div>`;
      }).join('')}</div>`;
    }

    function renderProjectTable(allProjects) {
      const rows = allProjects.map((project) => {
        const isSelected = String(project.id) === String(state.selectedProjectId);
        const prog = Math.max(0, Math.min(100, Number(project.progress || 0)));
        const days = daysUntil(project.due_date);
        const tickets = state.data.tickets.filter((t) => String(t.project_id) === String(project.id) && !['resolved','closed'].includes(t.status));
        return `<tr data-resource="projects" data-row-id="${project.id}" data-project-detail="${project.id}" style="cursor:pointer;${isSelected ? 'background:#f0fdf4;' : ''}" tabindex="0">
          <td><input type="checkbox" data-row-select onclick="event.stopPropagation()" /></td>
          <td>
            <div style="display:flex;align-items:center;gap:8px;">
              ${projectHealthDot(project.health)}
              <div><strong>${escapeHtml(project.name)}</strong><br><small style="color:#64748b;">${escapeHtml(project.client_name || clientName(project.client_id) || '—')}</small></div>
            </div>
          </td>
          <td>${escapeHtml(project.project_manager || '—')}</td>
          <td>${badge(project.status)}</td>
          <td>${budget2bar(project)}</td>
          <td>${days !== null ? (days < 0 ? `<span style="color:#dc2626;font-weight:700;">Overdue ${Math.abs(days)}d</span>` : `<span style="color:${days <= 7 ? '#d97706' : '#475569'};font-weight:700;">${days}d</span>`) : '—'}</td>
          <td>${tickets.length ? `<span style="color:#ef4444;font-weight:700;">${tickets.length}</span>` : '<span style="color:#22c55e;">0</span>'}</td>
          <td><div style="display:flex;align-items:center;gap:6px;"><div style="flex:1;height:6px;background:#e2e8f0;border-radius:3px;overflow:hidden;"><div style="height:100%;width:${prog}%;background:#6366f1;border-radius:3px;"></div></div><span style="font-size:11px;font-weight:700;color:#64748b;">${prog}%</span></div></td>
          <td>${rowActions('projects', project.id)}</td>
        </tr>`;
      }).join('');
      return table(['', 'Project / Client', 'Manager', 'Status', 'Budget', 'Deadline', 'Open Tickets', 'Progress', 'Actions'], rows, 'No projects found.');
    }

    function budget2bar(project) {
      const budget = Number(project.budget || 0);
      const spent = Number(project.expenses || 0);
      const pct = budget ? Math.min(100, Math.round((spent / budget) * 100)) : 0;
      const color = pct > 90 ? '#ef4444' : pct > 70 ? '#f59e0b' : '#22c55e';
      return `<div style="display:flex;flex-direction:column;gap:2px;min-width:90px;"><div style="font-size:11px;font-weight:700;color:#1e293b;">${compactMoney(budget)}</div><div style="height:4px;background:#e2e8f0;border-radius:2px;"><div style="height:100%;width:${pct}%;background:${color};border-radius:2px;"></div></div></div>`;
    }

    function projectDetail(project) {
      if (!project) return `<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:200px;gap:8px;"><div style="font-size:32px;">▣</div><p style="color:#94a3b8;font-weight:600;">Select a project to view details</p></div>`;
      const budget = Number(project.budget || 0);
      const spent = Number(project.expenses || 0);
      const revenue = Number(project.revenue || 0);
      const pct = budget ? Math.min(100, Math.round((spent / budget) * 100)) : 0;
      const prog = Math.max(0, Math.min(100, Number(project.progress || 0)));
      const pctColor = pct > 90 ? '#ef4444' : pct > 70 ? '#f59e0b' : '#22c55e';
      const tickets = state.data.tickets.filter((t) => String(t.project_id) === String(project.id));
      const openTix = tickets.filter((t) => !['resolved','closed'].includes(t.status));
      const days = daysUntil(project.due_date);
      const healthMap = { on_track: { label: 'On Track', c: '#22c55e' }, watch: { label: 'Watch', c: '#f59e0b' }, at_risk: { label: 'At Risk', c: '#ef4444' }, breached: { label: 'Breached', c: '#dc2626' } };
      const h = healthMap[project.health] || { label: project.health || 'Unknown', c: '#94a3b8' };
      return `
        <div class="pm-detail">
          <div class="pm-detail-hero">
            <div class="pm-detail-icon">▣</div>
            <div style="flex:1;min-width:0;">
              <h2 class="pm-detail-title">${escapeHtml(project.name)}</h2>
              <p class="pm-detail-client">${escapeHtml(project.client_name || clientName(project.client_id) || '—')}</p>
            </div>
            <span style="width:10px;height:10px;border-radius:50%;background:${h.c};flex-shrink:0;margin-top:6px;" title="${h.label}"></span>
          </div>

          <div class="pm-detail-badges">
            ${badge(project.status)}
            <span style="font-size:11px;font-weight:700;background:${h.c}18;color:${h.c};padding:2px 8px;border-radius:99px;">${h.label}</span>
            ${days !== null ? dueBadge(project.due_date) : ''}
          </div>

          <div class="pm-detail-section">
            <div class="pm-detail-label">DELIVERY PROGRESS</div>
            <div style="display:flex;align-items:center;gap:10px;margin-top:6px;">
              <div style="flex:1;height:10px;background:#e2e8f0;border-radius:5px;overflow:hidden;"><div style="height:100%;width:${prog}%;background:linear-gradient(90deg,#6366f1,#8b5cf6);border-radius:5px;transition:width 0.4s;"></div></div>
              <span style="font-size:13px;font-weight:800;color:#1e293b;">${prog}%</span>
            </div>
          </div>

          <div class="pm-detail-section">
            <div class="pm-detail-label">BUDGET BURN</div>
            <div style="display:flex;justify-content:space-between;margin-top:4px;margin-bottom:6px;">
              <span style="font-size:12px;color:#64748b;">Spent: <strong style="color:#1e293b;">${compactMoney(spent)}</strong></span>
              <span style="font-size:12px;color:#64748b;">Budget: <strong style="color:#1e293b;">${compactMoney(budget)}</strong></span>
            </div>
            <div style="height:8px;background:#e2e8f0;border-radius:4px;overflow:hidden;"><div style="height:100%;width:${pct}%;background:${pctColor};border-radius:4px;transition:width 0.4s;"></div></div>
            <div style="display:flex;justify-content:space-between;margin-top:4px;">
              <span style="font-size:10px;color:#94a3b8;">${pct}% consumed</span>
              <span style="font-size:10px;color:${revenue > 0 ? '#22c55e' : '#94a3b8'};">Revenue: ${compactMoney(revenue)}</span>
            </div>
          </div>

          <div class="pm-detail-section">
            <div class="pm-detail-label">PROJECT INFO</div>
            <div class="pm-info-grid">
              <div class="pm-info-row"><span>Manager</span><strong>${escapeHtml(project.project_manager || '—')}</strong></div>
              <div class="pm-info-row"><span>Deadline</span><strong>${project.due_date ? new Date(project.due_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—'}</strong></div>
              <div class="pm-info-row"><span>Open Tickets</span><strong style="color:${openTix.length ? '#ef4444' : '#22c55e'}">${openTix.length} / ${tickets.length}</strong></div>
              <div class="pm-info-row"><span>Health</span><strong style="color:${h.c}">${h.label}</strong></div>
            </div>
          </div>

          ${project.summary || project.notes ? `<div class="pm-detail-section"><div class="pm-detail-label">OVERVIEW</div><p style="font-size:12px;line-height:1.7;color:#475569;margin-top:6px;">${escapeHtml(project.summary || project.notes)}</p></div>` : ''}

          ${openTix.length ? `<div class="pm-detail-section"><div class="pm-detail-label">OPEN TICKETS</div>${openTix.slice(0, 3).map((t) => `<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #f1f5f9;"><span style="font-size:12px;color:#1e293b;">#TIC-${t.id} — ${escapeHtml((t.subject || '').slice(0, 40))}</span>${badge(t.priority, statusTone(t.priority))}</div>`).join('')}</div>` : ''}

          <div class="pm-detail-actions">
            ${canWrite('projects') ? `<button class="crm-button primary" data-edit-resource="projects" data-edit-id="${project.id}" type="button">Edit Project</button>` : ''}
            <button class="crm-button" data-jump="tickets" type="button">View Tickets</button>
            ${canWrite('projects') ? `<button class="crm-button" data-create="invoices" type="button">New Invoice</button>` : ''}
          </div>
        </div>
      `;
    }

    function renderProjects() {
      const view = state.projectView || 'board';
      let allProjects = state.data.projects;
      if (state.projectStatusFilter) allProjects = allProjects.filter((p) => p.status === state.projectStatusFilter);
      const searchQ = state.projectSearch || '';
      if (searchQ) allProjects = allProjects.filter((p) => ['name','client_name','project_manager','status'].some((k) => String(p[k]||'').toLowerCase().includes(searchQ.toLowerCase())));

      const selected = state.data.projects.find((p) => String(p.id) === String(state.selectedProjectId)) || state.data.projects[0];
      state.selectedProjectId = selected?.id || null;

      const totalBudget = state.data.projects.reduce((s, p) => s + Number(p.budget || 0), 0);
      const totalSpent = state.data.projects.reduce((s, p) => s + Number(p.expenses || 0), 0);
      const completed = state.data.projects.filter((p) => p.status === 'completed').length;
      const active = state.data.projects.filter((p) => ['active','review'].includes(p.status)).length;
      const atRisk = state.data.projects.filter((p) => ['watch','at_risk','breached'].includes(p.health)).length;

      const kpiBar = `<div class="crm-grid crm-kpis">
        ${metric('Total Projects', state.data.projects.length, '▣', 'blue', `${active} currently active`)}
        ${metric('Completed', completed, '✓', 'green', `${state.data.projects.length - completed} remaining`)}
        ${metric('At-Risk', atRisk, '!', 'orange', atRisk ? 'needs attention' : 'all healthy')}
        ${metric('Total Budget', compactMoney(totalBudget), '₹', 'purple', `${compactMoney(totalSpent)} spent`)}
        ${metric('Open Tickets', state.data.tickets.filter((t) => !['resolved','closed'].includes(t.status)).length, '◴', 'red', 'across all projects')}
      </div>`;

      const STYLES = `<style>
        .pm-board{display:flex;gap:14px;overflow-x:auto;padding:4px 0 12px;min-height:480px;}
        .pm-column{flex:0 0 240px;display:flex;flex-direction:column;gap:10px;}
        .pm-col-head{display:flex;align-items:center;gap:8px;padding:10px 12px;background:#f8fafc;border-radius:10px;border:1px solid #e2e8f0;}
        .pm-col-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
        .pm-col-label{font-size:12px;font-weight:800;color:#1e293b;flex:1;}
        .pm-col-count{font-size:11px;font-weight:700;background:#e2e8f0;color:#64748b;padding:1px 7px;border-radius:99px;}
        .pm-col-body{display:flex;flex-direction:column;gap:8px;}
        .pm-empty-col{font-size:11px;color:#94a3b8;text-align:center;padding:20px 0;font-weight:600;}
        .pm-card{background:#fff;border:1.5px solid #e2e8f0;border-radius:12px;padding:12px;cursor:pointer;transition:all 0.18s;display:flex;flex-direction:column;gap:6px;}
        .pm-card:hover{border-color:#6366f1;box-shadow:0 4px 18px rgba(99,102,241,0.12);transform:translateY(-1px);}
        .pm-card--selected{border-color:#6366f1;background:#fafafe;box-shadow:0 0 0 3px rgba(99,102,241,0.12);}
        .pm-card-top{display:flex;align-items:center;justify-content:space-between;gap:6px;}
        .pm-card-title{font-size:12px;font-weight:800;color:#1e293b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
        .pm-card-client{font-size:10px;color:#64748b;font-weight:600;}
        .pm-card-meta{display:flex;justify-content:space-between;font-size:10px;color:#64748b;gap:4px;flex-wrap:wrap;}
        .pm-progress-wrap{display:flex;align-items:center;gap:6px;}
        .pm-progress-bar{flex:1;height:5px;background:#e2e8f0;border-radius:3px;overflow:hidden;}
        .pm-progress-fill{height:100%;background:linear-gradient(90deg,#6366f1,#8b5cf6);border-radius:3px;transition:width 0.3s;}
        .pm-progress-pct{font-size:10px;font-weight:800;color:#6366f1;min-width:24px;text-align:right;}
        .pm-card-footer{display:flex;justify-content:space-between;align-items:center;font-size:10px;font-weight:700;color:#1e293b;}
        .pm-card-actions{display:flex;gap:4px;justify-content:flex-end;opacity:0;transition:opacity 0.15s;}
        .pm-card:hover .pm-card-actions{opacity:1;}
        .pm-btn-sm{width:24px;height:24px;border:1px solid #e2e8f0;border-radius:6px;background:#f8fafc;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;color:#475569;transition:all 0.15s;}
        .pm-btn-sm:hover{background:#e0e7ff;border-color:#6366f1;color:#6366f1;}
        .pm-btn-sm.danger:hover{background:#fee2e2;border-color:#ef4444;color:#ef4444;}
        .pm-view-toggle{display:flex;background:#f1f5f9;border-radius:8px;padding:3px;gap:2px;}
        .pm-view-btn{padding:5px 14px;border-radius:6px;font-size:12px;font-weight:700;cursor:pointer;border:none;background:transparent;color:#64748b;transition:all 0.15s;}
        .pm-view-btn.active{background:#fff;color:#6366f1;box-shadow:0 1px 4px rgba(0,0,0,0.08);}
        .pm-detail{display:flex;flex-direction:column;gap:0;height:100%;overflow-y:auto;}
        .pm-detail-hero{display:flex;align-items:flex-start;gap:12px;padding:16px 18px;border-bottom:1px solid #f1f5f9;}
        .pm-detail-icon{width:40px;height:40px;background:linear-gradient(135deg,#6366f1,#8b5cf6);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;color:#fff;flex-shrink:0;}
        .pm-detail-title{font-size:16px;font-weight:900;color:#0f172a;line-height:1.3;}
        .pm-detail-client{font-size:12px;color:#64748b;font-weight:600;margin-top:2px;}
        .pm-detail-badges{display:flex;gap:6px;flex-wrap:wrap;padding:10px 18px;border-bottom:1px solid #f1f5f9;}
        .pm-detail-section{padding:12px 18px;border-bottom:1px solid #f1f5f9;}
        .pm-detail-label{font-size:10px;font-weight:800;color:#94a3b8;letter-spacing:0.08em;}
        .pm-info-grid{display:flex;flex-direction:column;gap:6px;margin-top:8px;}
        .pm-info-row{display:flex;justify-content:space-between;align-items:center;font-size:12px;}
        .pm-info-row span{color:#64748b;}
        .pm-info-row strong{color:#1e293b;}
        .pm-detail-actions{display:flex;flex-wrap:wrap;gap:8px;padding:14px 18px;background:#f8fafc;margin-top:auto;}
        .pm-split{display:grid;grid-template-columns:1fr 340px;gap:14px;}
        @media(max-width:1100px){.pm-split{grid-template-columns:1fr;}.pm-board{flex-wrap:nowrap;}}
      </style>`;

      const toolbar = `<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <div class="pm-view-toggle">
          <button class="pm-view-btn ${view === 'board' ? 'active' : ''}" id="pm-view-board" type="button">⊞ Board</button>
          <button class="pm-view-btn ${view === 'list' ? 'active' : ''}" id="pm-view-list" type="button">≡ List</button>
        </div>
        <select class="crm-select" id="project-status-filter">
          <option value="">All Statuses</option>
          <option value="planning" ${state.projectStatusFilter === 'planning' ? 'selected' : ''}>Planning</option>
          <option value="active" ${state.projectStatusFilter === 'active' ? 'selected' : ''}>Active</option>
          <option value="review" ${state.projectStatusFilter === 'review' ? 'selected' : ''}>In Review</option>
          <option value="on_hold" ${state.projectStatusFilter === 'on_hold' ? 'selected' : ''}>On Hold</option>
          <option value="completed" ${state.projectStatusFilter === 'completed' ? 'selected' : ''}>Completed</option>
        </select>
        <input class="crm-input" id="pm-search" placeholder="Search projects..." value="${escapeHtml(searchQ)}" style="width:200px;" />
        <button class="crm-button" data-export="projects" type="button">Export</button>
        ${canWrite('projects') ? '<button class="crm-button primary" data-create="projects" type="button">+ New Project</button>' : ''}
      </div>`;

      const mainContent = view === 'board'
        ? renderProjectKanban(allProjects)
        : renderProjectTable(allProjects);

      els.view.innerHTML = `
        ${STYLES}
        ${pageHead('Project Management', 'Track every project — budget, health, delivery progress, and linked support across your client portfolio.', toolbar)}
        ${kpiBar}
        <div class="pm-split mt-5">
          <div>${mainContent}</div>
          <aside class="crm-card" style="padding:0;overflow:hidden;">${projectDetail(selected)}</aside>
        </div>
      `;

      // Wire view toggle
      document.getElementById('pm-view-board')?.addEventListener('click', () => { state.projectView = 'board'; renderProjects(); bindActions(); });
      document.getElementById('pm-view-list')?.addEventListener('click', () => { state.projectView = 'list'; renderProjects(); bindActions(); });
      // Wire search
      document.getElementById('pm-search')?.addEventListener('input', (e) => { state.projectSearch = e.target.value; renderProjects(); bindActions(); });
      // Wire status filter
      document.getElementById('project-status-filter')?.addEventListener('change', (e) => { state.projectStatusFilter = e.target.value; renderProjects(); bindActions(); });
      // Wire card / row clicks → detail panel
      document.querySelectorAll('[data-project-detail]').forEach((el) => el.addEventListener('click', (e) => {
        if (e.target.closest('[data-edit-resource],[data-delete-resource],[data-row-select]')) return;
        state.selectedProjectId = el.dataset.projectDetail;
        renderProjects();
        bindActions();
      }));
      // Drag-and-drop for kanban
      if (view === 'board') wireKanbanDnd('projects', 'status', () => { renderProjects(); });
    }

    // ── KANBAN DND HELPER (shared by Projects + Tickets) ────────────────────────────────
    function wireKanbanDnd(resource, statusField, reRender) {
      let dragId = null;
      document.querySelectorAll('[data-dnd-card]').forEach((card) => {
        card.setAttribute('draggable', 'true');
        card.addEventListener('dragstart', (e) => {
          dragId = card.dataset.dndCard;
          card.style.opacity = '0.5';
          e.dataTransfer.effectAllowed = 'move';
        });
        card.addEventListener('dragend', () => { card.style.opacity = ''; });
      });
      document.querySelectorAll('[data-dnd-col]').forEach((col) => {
        col.addEventListener('dragover', (e) => { e.preventDefault(); col.classList.add('dnd-over'); });
        col.addEventListener('dragleave', () => col.classList.remove('dnd-over'));
        col.addEventListener('drop', async (e) => {
          e.preventDefault();
          col.classList.remove('dnd-over');
          if (!dragId) return;
          const newStatus = col.dataset.dndCol;
          const item = state.data[resource].find((r) => String(r.id) === String(dragId));
          if (!item || item.status === newStatus) return;
          item.status = newStatus;
          reRender();
          bindActions();
          try { await portal(`/api/portal/${resource}/${dragId}`, { method: 'PATCH', body: JSON.stringify({ [statusField]: newStatus }) }); }
          catch { toast('Status update failed — check connection.'); item.status = item._prevStatus || item.status; reRender(); bindActions(); }
        });
      });
    }

    // ── SUPPORT TICKETS — FULL RECODE ───────────────────────────────────────
    const TIC_PRIORITY_COLORS = { urgent: '#dc2626', high: '#ea580c', medium: '#d97706', low: '#16a34a' };
    const TIC_PRIORITY_BG    = { urgent: '#fee2e2', high: '#ffedd5', medium: '#fef3c7', low: '#dcfce7' };

    function ticPriorityDot(priority) {
      const c = TIC_PRIORITY_COLORS[priority] || '#94a3b8';
      return `<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${c};flex-shrink:0;"></span>`;
    }

    function ticketKanbanCard(ticket) {
      const isSelected = String(ticket.id) === String(state.selectedTicketId);
      const pc = TIC_PRIORITY_COLORS[ticket.priority] || '#94a3b8';
      const pb = TIC_PRIORITY_BG[ticket.priority] || '#f1f5f9';
      return `
        <div class="tic-card ${isSelected ? 'tic-card--selected' : ''}" data-ticket-detail="${ticket.id}" data-dnd-card="${ticket.id}" draggable="true" tabindex="0" role="button">
          <div class="tic-card-top">
            <span style="font-size:10px;font-weight:700;background:${pb};color:${pc};padding:2px 7px;border-radius:99px;">${nice(ticket.priority || 'low')}</span>
            <span style="font-size:10px;color:#94a3b8;font-weight:600;">#${ticket.id}</span>
          </div>
          <div class="tic-card-subject">${escapeHtml(ticket.subject || 'Untitled')}</div>
          <div class="tic-card-meta">
            <span>${escapeHtml(clientName(ticket.client_id) || '—')}</span>
            ${ticket.assigned_to ? `<span style="color:#6366f1;font-weight:700;">@${escapeHtml(ticket.assigned_to)}</span>` : '<span style="color:#94a3b8;">Unassigned</span>'}
          </div>
          <div class="tic-card-actions">
            ${canWrite('tickets') ? `<button class="pm-btn-sm" data-quick-patch="tickets" data-quick-id="${ticket.id}" data-quick-field="status" data-quick-value="resolved" type="button" title="Resolve"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></button>` : ''}
            ${canWrite('tickets') ? `<button class="pm-btn-sm" data-edit-resource="tickets" data-edit-id="${ticket.id}" type="button" title="Edit"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>` : ''}
          </div>
        </div>`;
    }

    function renderTicketKanban(allTickets) {
      const stages = [
        { key: 'open',        label: 'Open',        color: '#ef4444' },
        { key: 'in_progress', label: 'In Progress', color: '#f59e0b' },
        { key: 'waiting',     label: 'Waiting',     color: '#6366f1' },
        { key: 'resolved',    label: 'Resolved',    color: '#22c55e' },
      ];
      return `<div class="pm-board">${stages.map(({ key, label, color }) => {
        const cols = allTickets.filter((t) => t.status === key);
        return `<div class="pm-column">
          <div class="pm-col-head"><span class="pm-col-dot" style="background:${color}"></span><span class="pm-col-label">${label}</span><span class="pm-col-count">${cols.length}</span></div>
          <div class="pm-col-body" data-dnd-col="${key}" style="min-height:60px;">${cols.map(ticketKanbanCard).join('') || '<div class="pm-empty-col">Empty</div>'}</div>
        </div>`;
      }).join('')}</div>`;
    }

    function renderTicketTable(allTickets) {
      const rows = allTickets.map((ticket) => {
        const isSelected = String(ticket.id) === String(state.selectedTicketId);
        const pc = TIC_PRIORITY_COLORS[ticket.priority] || '#94a3b8';
        return `<tr data-ticket-detail="${ticket.id}" data-resource="tickets" data-row-id="${ticket.id}" style="cursor:pointer;${isSelected ? 'background:#fafafe;' : ''}" tabindex="0">
          <td><input type="checkbox" data-row-select onclick="event.stopPropagation()" /></td>
          <td><span style="font-size:11px;font-weight:700;color:#94a3b8;">#${ticket.id}</span></td>
          <td><strong>${escapeHtml(ticket.subject || '')}</strong></td>
          <td><span style="font-size:11px;">${escapeHtml(clientName(ticket.client_id) || '—')}</span></td>
          <td><span style="font-size:11px;font-weight:700;color:${pc};padding:2px 7px;background:${TIC_PRIORITY_BG[ticket.priority]||'#f1f5f9'};border-radius:99px;">${nice(ticket.priority || 'low')}</span></td>
          <td><span style="font-size:11px;color:#6366f1;">${escapeHtml(ticket.assigned_to || '—')}</span></td>
          <td>${badge(ticket.status)}</td>
          <td>${rowActions('tickets', ticket.id)}</td>
        </tr>`;
      }).join('');
      return table(['', 'ID', 'Subject', 'Client', 'Priority', 'Assigned To', 'Status', 'Actions'], rows, 'No tickets found.');
    }

    function ticketDetail(ticket) {
      if (!ticket) return `<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:200px;gap:8px;"><div style="font-size:32px;">&#9716;</div><p style="color:#94a3b8;font-weight:600;">Select a ticket to view details</p></div>`;
      const pc = TIC_PRIORITY_COLORS[ticket.priority] || '#94a3b8';
      const pb = TIC_PRIORITY_BG[ticket.priority] || '#f1f5f9';
      return `
        <div class="pm-detail">
          <div class="pm-detail-hero">
            <div class="pm-detail-icon" style="background:linear-gradient(135deg,${pc},${pc}99);">&#9716;</div>
            <div style="flex:1;min-width:0;">
              <h2 class="pm-detail-title">#TIC-${ticket.id}</h2>
              <p class="pm-detail-client">${escapeHtml(ticket.subject || 'Untitled ticket')}</p>
            </div>
          </div>
          <div class="pm-detail-badges">
            ${badge(ticket.status)}
            <span style="font-size:11px;font-weight:700;background:${pb};color:${pc};padding:2px 8px;border-radius:99px;">${nice(ticket.priority || 'low')}</span>
          </div>
          <div class="pm-detail-section">
            <div class="pm-detail-label">TICKET INFO</div>
            <div class="pm-info-grid">
              <div class="pm-info-row"><span>Client</span><strong>${escapeHtml(clientName(ticket.client_id) || '—')}</strong></div>
              <div class="pm-info-row"><span>Project</span><strong>${escapeHtml(projectName(ticket.project_id) || 'Unlinked')}</strong></div>
              <div class="pm-info-row"><span>Assigned To</span><strong style="color:#6366f1;">${escapeHtml(ticket.assigned_to || 'Unassigned')}</strong></div>
              <div class="pm-info-row"><span>Status</span>${badge(ticket.status)}</div>
            </div>
          </div>
          ${ticket.description ? `<div class="pm-detail-section"><div class="pm-detail-label">DESCRIPTION</div><p style="font-size:12px;line-height:1.7;color:#475569;margin-top:6px;">${escapeHtml(ticket.description)}</p></div>` : ''}
          <div class="pm-detail-actions">
            ${canWrite('tickets') ? `<button class="crm-button primary" data-quick-patch="tickets" data-quick-id="${ticket.id}" data-quick-field="status" data-quick-value="resolved" type="button">✓ Resolve</button>` : ''}
            ${canWrite('tickets') ? `<button class="crm-button" data-quick-patch="tickets" data-quick-id="${ticket.id}" data-quick-field="status" data-quick-value="in_progress" type="button">Set In Progress</button>` : ''}
            ${canWrite('tickets') ? `<button class="crm-button" data-edit-resource="tickets" data-edit-id="${ticket.id}" type="button">Reassign</button>` : ''}
          </div>
        </div>`;
    }

    function renderTickets() {
      const view = state.ticketView || 'board';
      const ticketStatusFilter = state.ticketStatusFilter || '';
      const ticketPriorityFilter = state.ticketPriorityFilter || '';
      const ticketSearch = state.ticketSearch || '';
      let allTickets = state.data.tickets;
      if (ticketStatusFilter) allTickets = allTickets.filter((t) => t.status === ticketStatusFilter);
      if (ticketPriorityFilter) allTickets = allTickets.filter((t) => t.priority === ticketPriorityFilter);
      if (ticketSearch) allTickets = allTickets.filter((t) => ['subject','assigned_to'].some((k) => String(t[k]||'').toLowerCase().includes(ticketSearch.toLowerCase())));

      const selected = state.data.tickets.find((t) => String(t.id) === String(state.selectedTicketId)) || state.data.tickets[0];
      state.selectedTicketId = selected?.id || null;

      const open = state.data.tickets.filter((t) => !['resolved','closed'].includes(t.status));
      const high = state.data.tickets.filter((t) => ['high','urgent'].includes(t.priority));
      const resolved = state.data.tickets.filter((t) => ['resolved','closed'].includes(t.status));
      const urgent = state.data.tickets.filter((t) => t.priority === 'urgent');

      const TIC_STYLES = `<style>
        .tic-card{background:#fff;border:1.5px solid #e2e8f0;border-radius:12px;padding:12px;cursor:pointer;transition:all 0.18s;display:flex;flex-direction:column;gap:6px;}
        .tic-card:hover{border-color:#6366f1;box-shadow:0 4px 18px rgba(99,102,241,0.12);transform:translateY(-1px);}
        .tic-card--selected{border-color:#6366f1;background:#fafafe;box-shadow:0 0 0 3px rgba(99,102,241,0.12);}
        .tic-card-top{display:flex;align-items:center;justify-content:space-between;}
        .tic-card-subject{font-size:12px;font-weight:800;color:#1e293b;line-height:1.4;}
        .tic-card-meta{display:flex;justify-content:space-between;font-size:10px;color:#64748b;gap:4px;}
        .tic-card-actions{display:flex;gap:4px;justify-content:flex-end;opacity:0;transition:opacity 0.15s;}
        .tic-card:hover .tic-card-actions{opacity:1;}
        .dnd-over .pm-col-body{background:#f0fdf4;border:2px dashed #22c55e;border-radius:10px;}
      </style>`;

      const toolbar = `<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <div class="pm-view-toggle">
          <button class="pm-view-btn ${view === 'board' ? 'active' : ''}" id="tic-view-board" type="button">⊞ Board</button>
          <button class="pm-view-btn ${view === 'list' ? 'active' : ''}" id="tic-view-list" type="button">≡ List</button>
        </div>
        <select class="crm-select" id="tic-status-filter">
          <option value="">All Statuses</option>
          <option value="open" ${ticketStatusFilter==='open'?'selected':''}>Open</option>
          <option value="in_progress" ${ticketStatusFilter==='in_progress'?'selected':''}>In Progress</option>
          <option value="waiting" ${ticketStatusFilter==='waiting'?'selected':''}>Waiting</option>
          <option value="resolved" ${ticketStatusFilter==='resolved'?'selected':''}>Resolved</option>
          <option value="closed" ${ticketStatusFilter==='closed'?'selected':''}>Closed</option>
        </select>
        <select class="crm-select" id="tic-priority-filter">
          <option value="">All Priorities</option>
          <option value="urgent" ${ticketPriorityFilter==='urgent'?'selected':''}>Urgent</option>
          <option value="high" ${ticketPriorityFilter==='high'?'selected':''}>High</option>
          <option value="medium" ${ticketPriorityFilter==='medium'?'selected':''}>Medium</option>
          <option value="low" ${ticketPriorityFilter==='low'?'selected':''}>Low</option>
        </select>
        <input class="crm-input" id="tic-search" placeholder="Search tickets..." value="${escapeHtml(ticketSearch)}" style="width:180px;" />
        ${canWrite('tickets') ? '<button class="crm-button primary" data-create="tickets" type="button">+ New Ticket</button>' : ''}
        <button class="crm-button" data-export="tickets" type="button">Export</button>
      </div>`;

      const mainContent = view === 'board' ? renderTicketKanban(allTickets) : renderTicketTable(allTickets);

      els.view.innerHTML = `
        ${TIC_STYLES}
        ${pageHead('Support Tickets', 'Track, triage, assign, and resolve client support requests across all projects.', toolbar)}
        <div class="crm-grid crm-kpis">
          ${metric('Open', open.length, '&#9716;', 'blue', `${urgent.length} urgent`)}
          ${metric('High Priority', high.length, '!', 'orange', 'needs attention')}
          ${metric('Resolved', resolved.length, '&#10003;', 'green', `${state.data.tickets.length - resolved.length} remaining`)}
          ${metric('Unassigned', state.data.tickets.filter((t) => !t.assigned_to && !['resolved','closed'].includes(t.status)).length, '&#9716;', 'red', 'need agent')}
        </div>
        <div class="pm-split mt-5">
          <div>${mainContent}</div>
          <aside class="crm-card" style="padding:0;overflow:hidden;">${ticketDetail(selected)}</aside>
        </div>`;

      // Wire toggles
      document.getElementById('tic-view-board')?.addEventListener('click', () => { state.ticketView = 'board'; renderTickets(); bindActions(); });
      document.getElementById('tic-view-list')?.addEventListener('click', () => { state.ticketView = 'list'; renderTickets(); bindActions(); });
      document.getElementById('tic-status-filter')?.addEventListener('change', (e) => { state.ticketStatusFilter = e.target.value; renderTickets(); bindActions(); });
      document.getElementById('tic-priority-filter')?.addEventListener('change', (e) => { state.ticketPriorityFilter = e.target.value; renderTickets(); bindActions(); });
      document.getElementById('tic-search')?.addEventListener('input', (e) => { state.ticketSearch = e.target.value; renderTickets(); bindActions(); });
      // Wire card/row selection
      document.querySelectorAll('[data-ticket-detail]').forEach((el) => el.addEventListener('click', (e) => {
        if (e.target.closest('[data-quick-patch],[data-edit-resource],[data-delete-resource],[data-row-select]')) return;
        state.selectedTicketId = el.dataset.ticketDetail;
        renderTickets();
        bindActions();
      }));
      // Drag-and-drop for ticket kanban
      if (view === 'board') wireKanbanDnd('tickets', 'status', () => { renderTickets(); });
    }

    function financeSheetRows() {
      const invoices = state.data.invoices.map((invoice) => ({
        ...invoice,
        id: invoice.id,
        transaction_date: invoice.invoice_date || invoice.created_at?.slice(0, 10),
        reference_id: invoice.invoice_number,
        client: invoice.customer_company || invoice.customer_name || clientName(invoice.client_id),
        project: projectName(invoice.project_id),
        transaction_type: 'invoice',
        amount: invoiceTotal(invoice),
        received_amount: invoicePaidAmount(invoice),
        status: invoiceEffectiveStatus(invoice),
        notes: invoice.notes,
      }));
      if (state.financeSheet === 'invoices') return invoices;
      if (state.financeSheet === 'income') return incomeRows();
      return state.data.finances.filter((item) => {
        if (state.financeSheet === 'all') return true;
        if (state.financeSheet === 'income') return ['income', 'revenue'].includes(item.transaction_type) && isSettledFinance(item);
        if (state.financeSheet === 'expenses') return item.transaction_type === 'expense';
        if (state.financeSheet === 'salary') return item.transaction_type === 'salary';
        if (state.financeSheet === 'pending') return ['pending', 'half_payment', 'sent'].includes(item.status);
        if (state.financeSheet === 'paid') return ['paid', 'received', 'completed'].includes(normalizedStatus(item.status));
        return true;
      });
    }

    function financeVisibleRows() {
      const rows = filtered(financeSheetRows(), ['transaction_type', 'reference_id', 'title', 'client', 'project', 'status', 'paid_by', 'received_by', 'invoice_number', 'customer_name', 'service_title']);
      return rows.filter((item) => {
        if (state.financeStatusFilter && String(item.status || '') !== state.financeStatusFilter) return false;
        if (state.financeProofFilter === 'with-proof' && !item.proof_url) return false;
        if (state.financeProofFilter === 'without-proof' && item.proof_url) return false;
        return true;
      });
    }

    function ledgerStateKey(resource, id) {
      return `${resource}:${id}`;
    }

    function setLedgerState(resource, id, status) {
      const key = ledgerStateKey(resource, id);
      if (!status || status === 'idle') state.rowSaveStates.delete(key);
      else state.rowSaveStates.set(key, status);
    }

    function ledgerState(resource, id) {
      return state.rowSaveStates.get(ledgerStateKey(resource, id)) || 'idle';
    }

    function ledgerStateMarkup(resource, id) {
      if (!state.financeEditMode) return `<span class="crm-ledger-state crm-ledger-state--locked" data-ledger-state="${resource}:${id}">Locked</span>`;
      const current = ledgerState(resource, id);
      if (current === 'dirty') return `<span class="crm-ledger-state crm-ledger-state--dirty" data-ledger-state="${resource}:${id}">Pending</span>`;
      if (current === 'saving') return `<span class="crm-ledger-state crm-ledger-state--saving" data-ledger-state="${resource}:${id}">Saving</span>`;
      if (current === 'saved') return `<span class="crm-ledger-state crm-ledger-state--saved" data-ledger-state="${resource}:${id}">Saved</span>`;
      return `<span class="crm-ledger-state" data-ledger-state="${resource}:${id}">Ready</span>`;
    }

    function financeActiveFilters(rows) {
      const chips = [
        `<span class="crm-filter-chip"><span>Rows</span><strong>${rows.length}</strong></span>`,
      ];
      if (state.financeStatusFilter) chips.push(`<button class="crm-filter-chip" type="button" data-finance-quick-filter="status-clear"><span>Status</span><strong>${nice(state.financeStatusFilter)}</strong></button>`);
      if (state.financeProofFilter !== 'all') chips.push(`<button class="crm-filter-chip" type="button" data-finance-quick-filter="proof-clear"><span>Proof</span><strong>${state.financeProofFilter === 'with-proof' ? 'Attached' : 'Missing'}</strong></button>`);
      if (state.search) chips.push(`<button class="crm-filter-chip" type="button" data-finance-quick-filter="search-clear"><span>Search</span><strong>${escapeHtml(state.search)}</strong></button>`);
      return chips.join('');
    }

    function financeSummaryMarkup(rows) {
      const totalValue = rows.reduce((sum, item) => sum + Number(item.total_amount || item.amount || 0), 0);
      const collectedValue = rows.reduce((sum, item) => sum + Number(item.received_amount || (['paid', 'received', 'completed'].includes(normalizedStatus(item.status)) ? (item.total_amount || item.amount || 0) : 0)), 0);
      const pendingCount = rows.filter((item) => ['pending', 'sent', 'overdue', 'half_payment'].includes(String(item.status || ''))).length;
      const proofCoverage = rows.filter((item) => item.proof_url).length;
      return `<div class="crm-ledger-pinned-summary">
        <div class="crm-ledger-pill"><span>Visible Rows</span><strong>${rows.length}</strong></div>
        <div class="crm-ledger-pill"><span>Sheet Total</span><strong>${compactMoney(totalValue)}</strong></div>
        <div class="crm-ledger-pill"><span>Collected / Paid</span><strong>${compactMoney(collectedValue)}</strong></div>
        <div class="crm-ledger-pill"><span>Pending / Proof</span><strong>${pendingCount} / ${proofCoverage}</strong></div>
      </div>`;
    }

    function financeDensityMarkup() {
      return `<div class="crm-density-toggle" aria-label="Ledger density">
        <button class="crm-density-button ${state.financeDensity === 'comfortable' ? 'active' : ''}" type="button" data-finance-density="comfortable">Comfortable</button>
        <button class="crm-density-button ${state.financeDensity === 'compact' ? 'active' : ''}" type="button" data-finance-density="compact">Compact</button>
      </div>`;
    }

    function ledgerFieldError(row, input) {
      const field = input.dataset.field;
      const value = String(input.value || '').trim();
      const resource = row.dataset.resource;
      if (resource === 'finances') {
        if (field === 'transaction_date' && !value) return 'Date is required.';
        if (field === 'amount' && (value === '' || Number(value) < 0 || Number.isNaN(Number(value)))) return 'Amount must be 0 or more.';
        if (state.financeSheet === 'salary' && field === 'title' && !value) return 'Employee name is required.';
      }
      if (resource === 'invoices') {
        if (['invoice_date', 'invoice_number', 'customer_name', 'service_title'].includes(field) && !value) return 'This field is required.';
      }
      return '';
    }

    function validateLedgerInput(input) {
      const row = input.closest('[data-row-id]');
      if (!row || !['finances', 'invoices'].includes(row.dataset.resource || '')) return true;
      const message = ledgerFieldError(row, input);
      input.classList.toggle('crm-cell-invalid', Boolean(message));
      if (message) input.setAttribute('title', message);
      else input.removeAttribute('title');
      return !message;
    }

    function validateLedgerRow(row) {
      if (!row || !['finances', 'invoices'].includes(row.dataset.resource || '')) return true;
      const inputs = Array.from(row.querySelectorAll('[data-field]'));
      const valid = inputs.every((input) => validateLedgerInput(input));
      if (!valid) {
        setLedgerState(row.dataset.resource, row.dataset.rowId, 'invalid');
        applyLedgerStateToRow(row, 'invalid');
      }
      return valid;
    }

    function moveLedgerFocus(current, step) {
      const cells = Array.from(document.querySelectorAll('.crm-table--ledger [data-field]'));
      const index = cells.indexOf(current);
      if (index === -1) return;
      const target = cells[index + step];
      if (target) {
        target.focus();
        if (target.select) target.select();
      }
    }

    function bindLedgerKeyboardFlow() {
      document.querySelectorAll('.crm-table--ledger [data-field]').forEach((input) => {
        input.addEventListener('keydown', (event) => {
          if (event.key === 'Enter') {
            event.preventDefault();
            moveLedgerFocus(input, event.shiftKey ? -1 : 1);
          }
          if (event.altKey && event.key === 'ArrowRight') {
            event.preventDefault();
            moveLedgerFocus(input, 1);
          }
          if (event.altKey && event.key === 'ArrowLeft') {
            event.preventDefault();
            moveLedgerFocus(input, -1);
          }
        });
      });
    }

    function financeRowStart(resource, item) {
      const currentState = ledgerState(resource, item.id);
      const rowStateClass = currentState && currentState !== 'idle' ? ` crm-ledger-row--${currentState}` : '';
      return `<tr class="${rowStateClass.trim()}" data-resource="${resource}" data-row-id="${item.id}">`;
    }

    function applyLedgerStateToRow(row, status) {
      if (!row) return;
      row.classList.remove('crm-ledger-row--dirty', 'crm-ledger-row--saving', 'crm-ledger-row--saved', 'crm-ledger-row--invalid');
      if (status && status !== 'idle') row.classList.add(`crm-ledger-row--${status}`);
      const indicator = row.querySelector(`[data-ledger-state="${row.dataset.resource}:${row.dataset.rowId}"]`);
      if (!indicator) return;
      indicator.className = 'crm-ledger-state';
      if (!state.financeEditMode) {
        indicator.classList.add('crm-ledger-state--locked');
        indicator.textContent = 'Locked';
        return;
      }
      if (status === 'dirty') {
        indicator.classList.add('crm-ledger-state--dirty');
        indicator.textContent = 'Pending';
      } else if (status === 'saving') {
        indicator.classList.add('crm-ledger-state--saving');
        indicator.textContent = 'Saving';
      } else if (status === 'saved') {
        indicator.classList.add('crm-ledger-state--saved');
        indicator.textContent = 'Saved';
      } else if (status === 'invalid') {
        indicator.classList.add('crm-ledger-state--invalid');
        indicator.textContent = 'Fix row';
      } else {
        indicator.textContent = 'Ready';
      }
    }

    function proofCell(item) {
      const id = item.id;
      if (item.proof_url) {
        return `<div class="crm-proof-cell" data-proof-cell="${id}" style="display:flex;flex-direction:column;align-items:flex-start;gap:6px;">
          <div class="crm-proof-preview-inline" data-proof-preview="${id}">${proofSummaryMarkup(item.proof_url)}</div>
          <div style="display:flex;align-items:center;gap:4px;flex-wrap:wrap;">
            <button class="crm-mini-action" type="button" data-proof-open="${escapeHtml(item.proof_url)}">Preview</button>
            <button class="crm-mini-action" type="button" data-proof-link="${escapeHtml(item.proof_url)}">Open</button>
            ${canWrite('finances') ? '<label class="crm-mini-action" style="cursor:pointer;" title="Replace proof">↑<input type="file" data-proof-upload="' + id + '" accept="image/*,.pdf,.jpg,.jpeg,.png,.webp" style="display:none;" /></label>' : ''}
          </div>
          <span class="crm-proof-status" data-proof-status="${id}" style="font-size:10px;color:#667599;"></span>
        </div>`;
      }
      return `<div class="crm-proof-cell" data-proof-cell="${id}" style="display:flex;flex-direction:column;align-items:flex-start;gap:6px;">
        ${canWrite('finances') ? '<label class="crm-mini-action" style="cursor:pointer;" title="Upload proof">+ Proof<input type="file" data-proof-upload="' + id + '" accept="image/*,.pdf,.jpg,.jpeg,.png,.webp" style="display:none;" /></label>' : '<span class="crm-proof-summary">No proof</span>'}
        <div class="crm-proof-preview-inline" data-proof-preview="${id}">${proofSummaryMarkup('')}</div>
        <span class="crm-proof-status" data-proof-status="${id}" style="font-size:10px;color:#667599;"></span>
      </div>`;
    }

    function getResolvedProofUrl(value) {
      const raw = String(value || '').trim();
      if (!raw) return '';
      if (/^https?:\/\//i.test(raw)) return raw;
      return '';
    }

    function proofPreviewMarkup(url) {
      if (!url) return '';
      const resolvedUrl = getResolvedProofUrl(url);
      const safeRawUrl = escapeHtml(url);
      if (!resolvedUrl) return `<div data-proof-auto-preview data-proof-value="${safeRawUrl}" style="border:1px dashed #cbd5e1;border-radius:8px;padding:12px;text-align:center;color:#64748b;font-size:11px;">Loading secure preview…</div>`;
      return proofDocumentMarkup(url, resolvedUrl, true);
    }

    function proofSummaryMarkup(url) {
      if (!url) return '<span class="crm-proof-summary">No proof</span>';
      if (/\.pdf(\?|$)/i.test(url)) return '<span class="crm-proof-summary">PDF attached</span>';
      if (/\.(png|jpe?g|webp|gif|avif)(\?|$)/i.test(url)) return '<span class="crm-proof-summary">Image attached</span>';
      return '<span class="crm-proof-summary">Proof attached</span>';
    }

    function proofStoragePath(value) {
      const raw = String(value || '').trim();
      if (!raw) return '';
      if (/^https?:\/\//i.test(raw)) {
        const match = raw.match(/\/finance-proofs\/(.+)$/);
        return match ? decodeURIComponent(match[1]) : '';
      }
      return raw;
    }

    async function resolveProofUrl(value) {
      const raw = String(value || '').trim();
      if (!raw) return '';
      const path = proofStoragePath(raw);
      if (!path && /^https?:\/\//i.test(raw)) return raw;
      if (!path) throw new Error('The stored proof path is invalid.');
      try {
        return await window.tmCrm.repository.getFinanceProofUrl(path);
      } catch (error) {
        throw error instanceof Error ? error : new Error('Could not create secure proof URL.');
      }
    }

    function proofDocumentMarkup(rawUrl, resolvedUrl, compact = false) {
      const safeUrl = escapeHtml(resolvedUrl);
      const fileName = escapeHtml(String(rawUrl || '').split('/').pop() || 'Proof document');
      const isPdf = /\.pdf(\?|$)/i.test(resolvedUrl) || /\.pdf(\?|$)/i.test(rawUrl);
      const isImg = /\.(png|jpe?g|webp|gif|avif)(\?|$)/i.test(resolvedUrl) || /\.(png|jpe?g|webp|gif|avif)(\?|$)/i.test(rawUrl);
      if (isPdf) {
        return `<div style="border:1px solid #e2e8f0;border-radius:8px;overflow:hidden;background:#fff;${compact ? 'max-width:260px;' : 'margin-bottom:10px;'}">
          <iframe src="${safeUrl}#toolbar=0" style="width:100%;height:${compact ? '140px' : '320px'};border:none;display:block;background:#f8fafc;" title="PDF Preview"></iframe>
          <div style="padding:6px 8px;background:#f8fafc;border-top:1px solid #e2e8f0;display:flex;justify-content:space-between;align-items:center;gap:8px;">
            <span style="font-size:10px;color:#64748b;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="${fileName}">${fileName}</span>
            <a class="crm-mini-action" href="${safeUrl}" target="_blank" rel="noopener" style="font-size:10px;text-decoration:none;white-space:nowrap;">Open ↗</a>
          </div>
        </div>`;
      }
      if (isImg) {
        return `<a href="${safeUrl}" target="_blank" rel="noopener" style="display:block;text-align:center;">
          <img src="${safeUrl}" alt="Proof preview" style="max-width:${compact ? '220px' : '100%'};max-height:${compact ? '160px' : '320px'};width:auto;object-fit:contain;border:1px solid #e2e8f0;border-radius:8px;background:#fff;" />
        </a>`;
      }
      return `<a href="${safeUrl}" target="_blank" rel="noopener" class="crm-mini-action" style="display:inline-flex;text-decoration:none;">${proofIconMarkup('paperclip', 14)} ${fileName}</a>`;
    }

    async function loadProofPreviewTarget(target, value) {
      if (!target || !value || target.dataset.proofLoading === 'true') return;
      target.dataset.proofLoading = 'true';
      target.innerHTML = '<div style="border:1px dashed #cbd5e1;border-radius:8px;padding:12px;text-align:center;color:#64748b;font-size:11px;">Loading secure preview…</div>';
      try {
        const resolvedUrl = await resolveProofUrl(value);
        if (target.isConnected) target.innerHTML = proofDocumentMarkup(value, resolvedUrl, target.dataset.proofCompact === 'true');
      } catch (error) {
        if (target.isConnected) target.innerHTML = `<div style="border:1px solid #fecaca;border-radius:8px;padding:12px;text-align:center;color:#b91c1c;font-size:11px;">${escapeHtml(error instanceof Error ? error.message : 'Could not load secure proof preview.')}</div>`;
      } finally {
        delete target.dataset.proofLoading;
      }
    }

    function loadAutoProofPreviews(root = document) {
      root.querySelectorAll('[data-proof-auto-preview]').forEach((target) => {
        loadProofPreviewTarget(target, target.dataset.proofValue);
      });
    }

    async function openProofPreview(value) {
      if (!value || !els.proofPreviewModal || !els.proofPreviewBody) return;
      els.proofPreviewBody.innerHTML = '<p style="margin:0;color:#475569;font-weight:700;">Loading proof preview...</p>';
      els.proofPreviewModal.classList.add('open');
      try {
        const resolvedUrl = await resolveProofUrl(value);
        const safeUrl = escapeHtml(resolvedUrl);
        const isPdf = /\.pdf(\?|$)/i.test(resolvedUrl) || /\.pdf(\?|$)/i.test(value);
        const isImg = /\.(png|jpe?g|webp|gif|avif)(\?|$)/i.test(resolvedUrl) || /\.(png|jpe?g|webp|gif|avif)(\?|$)/i.test(value);
        if (isPdf) {
          els.proofPreviewBody.innerHTML = `<iframe src="${safeUrl}" title="Proof PDF preview" style="width:100%;height:75vh;border:0;border-radius:10px;background:#fff;"></iframe>`;
        } else if (isImg) {
          els.proofPreviewBody.innerHTML = `<img src="${safeUrl}" alt="Proof preview" style="max-height:75vh;width:auto;max-width:100%;margin:0 auto;display:block;object-fit:contain;border-radius:10px;" />`;
        } else {
          els.proofPreviewBody.innerHTML = `<p style="margin:0 0 12px;color:#475569;font-weight:700;">Inline preview is not available for this proof type.</p><a class="crm-button primary" href="${safeUrl}" target="_blank" rel="noopener" style="text-decoration:none;">Open Proof</a>`;
        }
      } catch (error) {
        els.proofPreviewBody.innerHTML = `<p style="margin:0;color:#b91c1c;font-weight:700;">${escapeHtml(error instanceof Error ? error.message : 'Could not open proof preview')}</p>`;
        return;
      }
    }

    async function openProofInNewTab(value) {
      try {
        const resolvedUrl = await resolveProofUrl(value);
        window.open(resolvedUrl, '_blank', 'noopener,noreferrer');
      } catch (error) {
        toast(error instanceof Error ? error.message : 'Could not open proof');
      }
    }

    function financeProofFieldMarkup(values = {}) {
      const proofUrl = String(values.proof_url || '');
      const recordId = Number.isInteger(Number(values.id)) ? String(values.id) : '';
      return `<div class="wide" style="border:1px solid #e2e8f0;border-radius:6px;padding:10px 12px;">
        <strong style="font-size:12px;">Payment Proof Attachment</strong>
        <span style="display:block;font-size:10px;color:#667599;margin-bottom:6px;">${recordId ? 'Upload a receipt, screenshot, or PDF proof. It will be saved with the transaction and can be included in reports.' : 'Save the finance record first, then reopen it to attach proof.'}</span>
        ${proofUrl ? `<div id="finance-proof-preview" style="margin-bottom:8px;">${proofPreviewMarkup(proofUrl)}</div>` : `<div id="finance-proof-preview" style="margin-bottom:8px;">${proofSummaryMarkup('')}</div>`}
        <input type="file" id="finance-proof-file" data-record-id="${escapeHtml(recordId)}" accept="image/*,.pdf,.jpg,.jpeg,.png,.webp" style="display:block;" ${recordId ? '' : 'disabled'} />
        <input type="hidden" name="proof_url" id="finance-proof-url" value="${escapeHtml(proofUrl)}" />
        <span id="finance-proof-status" style="font-size:10px;color:#667599;"></span>
      </div>`;
    }

    function financeRows() {
      const rows = financeVisibleRows();

      if (state.financeSheet === 'invoices') {
        return rows.map((item) => {
          const total = invoiceTotal(item);
          const received = invoicePaidAmount(item);
          const balance = invoiceBalance(item);
          const status = invoiceEffectiveStatus(item);
          return `${financeRowStart('invoices', item)}
            <td><input type="checkbox" data-row-select aria-label="Select invoice ${item.id}" /></td>
            <td><input class="crm-edit-input" data-field="invoice_date" type="date" value="${escapeHtml(item.invoice_date || '')}" /></td>
            <td><input class="crm-edit-input" data-field="invoice_number" value="${escapeHtml(item.invoice_number || '')}" /></td>
            <td><input class="crm-edit-input" data-field="customer_name" value="${escapeHtml(item.customer_name || item.client || '')}" /></td>
            <td><input class="crm-edit-input" data-field="service_title" value="${escapeHtml(item.service_title || item.project || '')}" /></td>
            <td><input class="crm-edit-input" data-field="due_date" type="date" value="${escapeHtml(item.due_date || '')}" /></td>
            <td class="crm-numeric"><strong>${compactMoney(total)}</strong></td>
            <td class="crm-numeric"><span class="crm-amount-positive">${compactMoney(received)}</span></td>
            <td class="crm-numeric"><span class="${balance > 0 ? 'crm-amount-negative' : 'crm-amount-positive'}">${compactMoney(balance)}</span></td>
            <td><select class="crm-edit-select" data-field="status">${['draft','sent','paid','overdue','cancelled'].map((s) => `<option value="${s}" ${status === s ? 'selected' : ''}>${nice(s)}</option>`).join('')}</select></td>
            <td><div class="crm-stack">${ledgerStateMarkup('invoices', item.id)}${rowActions('invoices', item.id)}</div></td>
          </tr>`;
        }).join('');
      }

      if (state.financeSheet === 'income') {
        return rows.map((item) => item.record_kind === 'invoice' ? `
          <tr data-resource="invoices" data-row-id="${item.invoice_id}">
            <td><input type="checkbox" data-row-select aria-label="Select invoice ${item.invoice_id}" /></td>
            <td>${escapeHtml(item.transaction_date || '')}</td>
            <td>${escapeHtml(item.client || '')}</td>
            <td>${escapeHtml(item.title || item.reference_id || '')}</td>
            <td>${escapeHtml(item.received_by || 'Invoice payment')}</td>
            <td>${escapeHtml(item.payment_method || '—')}</td>
            <td class="crm-numeric"><span class="crm-amount-positive">${compactMoney(item.amount)}</span></td>
            <td>${badge(item.status, 'green')}</td>
            <td>${escapeHtml(item.notes || 'Paid invoice income')}</td>
            <td>—</td>
            <td><div class="crm-stack"><span class="crm-ledger-state crm-ledger-state--locked">Invoice</span><button class="crm-mini-action" data-load-invoice="${item.invoice_id}" type="button">View</button></div></td>
          </tr>` : `
          ${financeRowStart('finances', item)}
            <td><input type="checkbox" data-row-select aria-label="Select record ${item.id}" /></td>
            <td><input class="crm-edit-input" data-field="transaction_date" type="date" value="${escapeHtml(item.transaction_date || '')}" /></td>
            <td><input class="crm-edit-input" data-field="client" value="${escapeHtml(item.client || '')}" /></td>
            <td><input class="crm-edit-input" data-field="project" value="${escapeHtml(item.project || '')}" /></td>
            <td><input class="crm-edit-input" data-field="received_by" value="${escapeHtml(item.received_by || '')}" /></td>
            <td><input class="crm-edit-input" data-field="payment_method" value="${escapeHtml(item.payment_method || '')}" /></td>
            <td class="crm-numeric"><input class="crm-edit-input" data-field="amount" type="number" value="${escapeHtml(item.amount || 0)}" /></td>
            <td><select class="crm-edit-select" data-field="status">${['pending','received','paid','cancelled'].map((s) => `<option value="${s}" ${item.status === s ? 'selected' : ''}>${nice(s)}</option>`).join('')}</select></td>
            <td><input class="crm-edit-input" data-field="notes" value="${escapeHtml(item.notes || '')}" /></td>
            <td>${proofCell(item)}</td>
            <td><div class="crm-stack">${ledgerStateMarkup('finances', item.id)}${rowActions('finances', item.id)}</div></td>
          </tr>`).join('');
      }

      if (state.financeSheet === 'expenses') {
        return rows.map((item) => `
          ${financeRowStart('finances', item)}
            <td><input type="checkbox" data-row-select aria-label="Select record ${item.id}" /></td>
            <td><input class="crm-edit-input" data-field="transaction_date" type="date" value="${escapeHtml(item.transaction_date || '')}" /></td>
            <td><input class="crm-edit-input" data-field="reference_id" value="${escapeHtml(item.reference_id || '')}" /></td>
            <td><input class="crm-edit-input" data-field="title" value="${escapeHtml(item.title || '')}" /></td>
            <td><input class="crm-edit-input" data-field="paid_by" value="${escapeHtml(item.paid_by || '')}" /></td>
            <td><input class="crm-edit-input" data-field="payment_method" value="${escapeHtml(item.payment_method || '')}" /></td>
            <td class="crm-numeric"><input class="crm-edit-input" data-field="amount" type="number" value="${escapeHtml(item.amount || 0)}" /></td>
            <td><select class="crm-edit-select" data-field="status">${['pending','paid','cancelled'].map((s) => `<option value="${s}" ${item.status === s ? 'selected' : ''}>${nice(s)}</option>`).join('')}</select></td>
            <td><input class="crm-edit-input" data-field="notes" value="${escapeHtml(item.notes || '')}" /></td>
            <td>${proofCell(item)}</td>
            <td><div class="crm-stack">${ledgerStateMarkup('finances', item.id)}${rowActions('finances', item.id)}</div></td>
          </tr>`).join('');
      }

      if (state.financeSheet === 'salary') {
        return rows.map((item) => `
          ${financeRowStart('finances', item)}
            <td><input type="checkbox" data-row-select aria-label="Select record ${item.id}" /></td>
            <td><input class="crm-edit-input" data-field="transaction_date" type="date" value="${escapeHtml(item.transaction_date || '')}" /></td>
            <td><input class="crm-edit-input" data-field="title" placeholder="Employee name" value="${escapeHtml(item.title || '')}" /></td>
            <td><input class="crm-edit-input" data-field="department" value="${escapeHtml(item.department || '')}" /></td>
            <td><input class="crm-edit-input" data-field="paid_by" placeholder="Role" value="${escapeHtml(item.paid_by || '')}" /></td>
            <td><input class="crm-edit-input" data-field="received_by" placeholder="Bank name" value="${escapeHtml(item.received_by || '')}" /></td>
            <td><input class="crm-edit-input" data-field="payment_method" placeholder="Account no." value="${escapeHtml(item.payment_method || '')}" /></td>
            <td class="crm-numeric"><input class="crm-edit-input" data-field="amount" type="number" value="${escapeHtml(item.amount || 0)}" /></td>
            <td><select class="crm-edit-select" data-field="status">${['pending','paid','cancelled'].map((s) => `<option value="${s}" ${item.status === s ? 'selected' : ''}>${nice(s)}</option>`).join('')}</select></td>
            <td>${proofCell(item)}</td>
            <td><div class="crm-stack">${ledgerStateMarkup('finances', item.id)}${rowActions('finances', item.id)}</div></td>
          </tr>`).join('');
      }

      if (state.financeSheet === 'pending' || state.financeSheet === 'paid') {
        return rows.map((item) => `
          ${financeRowStart('finances', item)}
            <td><input type="checkbox" data-row-select aria-label="Select record ${item.id}" /></td>
            <td><input class="crm-edit-input" data-field="transaction_date" type="date" value="${escapeHtml(item.transaction_date || '')}" /></td>
            <td>${badge(item.transaction_type, 'blue')}</td>
            <td><input class="crm-edit-input" data-field="title" value="${escapeHtml(item.title || item.reference_id || '')}" /></td>
            <td><input class="crm-edit-input" data-field="client" value="${escapeHtml(item.client || '')}" /></td>
            <td class="crm-numeric"><input class="crm-edit-input" data-field="amount" type="number" value="${escapeHtml(item.amount || 0)}" /></td>
            <td><input class="crm-edit-input" data-field="payment_method" value="${escapeHtml(item.payment_method || '')}" /></td>
            <td><select class="crm-edit-select" data-field="status">${['pending','paid','received','half_payment','cancelled'].map((s) => `<option value="${s}" ${item.status === s ? 'selected' : ''}>${nice(s)}</option>`).join('')}</select></td>
            <td>${proofCell(item)}</td>
            <td><div class="crm-stack">${ledgerStateMarkup('finances', item.id)}${rowActions('finances', item.id)}</div></td>
          </tr>`).join('');
      }

      // 'all' sheet
      return rows.map((item) => `
        ${financeRowStart('finances', item)}
          <td><input type="checkbox" data-row-select aria-label="Select record ${item.id}" /></td>
          <td><input class="crm-edit-input" data-field="transaction_date" type="date" value="${escapeHtml(item.transaction_date || '')}" /></td>
          <td>${badge(item.transaction_type, 'blue')}</td>
          <td><input class="crm-edit-input" data-field="title" value="${escapeHtml(item.title || '')}" /></td>
          <td class="crm-numeric"><input class="crm-edit-input" data-field="amount" type="number" value="${escapeHtml(item.amount || 0)}" /></td>
          <td><select class="crm-edit-select" data-field="status">${['pending','paid','received','sent','overdue','half_payment','cancelled'].map((s) => `<option value="${s}" ${item.status === s ? 'selected' : ''}>${nice(s)}</option>`).join('')}</select></td>
          <td><input class="crm-edit-input" data-field="notes" value="${escapeHtml(item.notes || '')}" /></td>
          <td>${proofCell(item)}</td>
          <td><div class="crm-stack">${ledgerStateMarkup('finances', item.id)}${rowActions('finances', item.id)}</div></td>
        </tr>`).join('');
    }

    function financeSheetHeaders() {
      const h = {
        all:      ['', 'Date', 'Type', 'Title', 'Amount', 'Status', 'Notes', 'Proof', 'Actions'],
        income:   ['', 'Date', 'Client', 'Project / Service', 'Received By', 'Payment Method', 'Amount', 'Status', 'Notes', 'Proof', 'Actions'],
        expenses: ['', 'Date', 'Expense ID', 'Purpose', 'Paid By', 'Payment Method', 'Amount', 'Status', 'Notes', 'Proof', 'Actions'],
        salary:   ['', 'Date', 'Employee', 'Department', 'Role', 'Bank Name', 'Account No.', 'Amount', 'Status', 'Proof', 'Actions'],
        invoices: ['', 'Date', 'Invoice No.', 'Client', 'Service', 'Due Date', 'Total', 'Paid', 'Balance', 'Status', 'Actions'],
      };
      return h[state.financeSheet] || h.all;
    }

    function financeSheetTabs() {
      const sheets = [
        ['all', 'All Records'],
        ['income', 'Income'],
        ['expenses', 'Expenses'],
        ['salary', 'Salary'],
        ['invoices', 'Invoices'],
      ];
      return `<div class="crm-sheet-tabs" role="tablist" aria-label="Finance sheets">${sheets.map(([key, label]) => `<button class="crm-sheet-tab ${state.financeSheet === key ? 'active' : ''}" data-finance-sheet="${key}" type="button" role="tab" aria-selected="${state.financeSheet === key}">${label}</button>`).join('')}</div>`;
    }

    function renderFinance() {
      const isBuilder = state.financeSheet === 'invoices' && state.invoiceBuilderActive;
      const collectedIncome = incomeRows();
      const settledExpenses = expenseRows();
      const income = sumAmounts(collectedIncome);
      const operatingExpenses = sumAmounts(settledExpenses.filter((item) => item.transaction_type === 'expense'));
      const salaries = sumAmounts(settledExpenses.filter((item) => item.transaction_type === 'salary'));
      const expenses = operatingExpenses + salaries;
      const receivable = outstandingInvoiceAmount();
      const availableBalance = income - expenses;

      const canWriteFinance = canWrite('finances');
      const tabActions = isBuilder
        ? `<button class="crm-button" type="button" id="inv-cancel-btn">Back to Invoices</button>${isCompanyAdmin() ? '<button class="crm-button green" type="button" id="inv-save-settings">Save Settings</button><button class="crm-button primary" type="button" id="inv-save-invoice">Save Invoice</button>' : ''}<button class="crm-button" type="button" id="inv-print-btn">Print / PDF</button>`
        : '<button class="crm-button" data-export="finance" type="button">Export CSV</button>';

      const subtitles = isBuilder
        ? 'Build professional invoices with live preview. Configure company settings, client details, service items, and branding.'
        : 'Track revenue, expenses, salary, receivables, and proof-backed ledger records in one controlled workspace.';

      let bodyContent = '';

      if (isBuilder) {
        bodyContent = renderInvoiceBuilder();
      } else {
        const accTab = state.accTab || 'overview';
        const fmtINR = (v) => '₹' + Math.abs(Number(v) || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const fmtDate = (d) => d ? new Date(d).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
        const isInc = (t) => ['income', 'revenue', 'invoice'].includes(t);
        const signedINR = (v, t, status = '') => t === 'invoice' && !SETTLED_INVOICE_TRANSACTION_STATUSES.has(normalizedStatus(status))
          ? fmtINR(Math.abs(Number(v) || 0))
          : isInc(t) ? '+' + fmtINR(Math.abs(Number(v) || 0)) : '-' + fmtINR(Math.abs(Number(v) || 0));
        const cashFlowByMonth = {};
        collectedIncome.forEach((item) => {
          const month = (item.transaction_date || '').slice(0, 7);
          if (!month) return;
          cashFlowByMonth[month] = (cashFlowByMonth[month] || 0) + Number(item.amount || 0);
        });
        settledExpenses.forEach((item) => {
          const month = (item.transaction_date || '').slice(0, 7);
          if (!month) return;
          cashFlowByMonth[month] = (cashFlowByMonth[month] || 0) - Number(item.amount || 0);
        });
        const cashFlowMonths = Object.keys(cashFlowByMonth).sort().slice(-6);
        const cashFlowValues = cashFlowMonths.map((month) => cashFlowByMonth[month]);
        const cashFlowMax = Math.max(...cashFlowValues.map(Math.abs), 1);
        const cashFlowPoints = cashFlowValues.map((value, index) => `${8 + (index * 184 / Math.max(cashFlowValues.length - 1, 1))},${44 - (value / cashFlowMax) * 32}`).join(' ');

        const catBadge = (t) => {
          const m = { income: 'acc-badge-income', revenue: 'acc-badge-income', expense: 'acc-badge-expense', salary: 'acc-badge-salary', invoice: 'acc-badge-invoice' };
          const l = { income: 'Income', revenue: 'Income', expense: 'Expenses', salary: 'Salary', invoice: 'Invoice' };
          const cls = m[t?.toLowerCase()] || 'acc-badge-other';
          return `<span class="acc-badge ${cls}">${l[t?.toLowerCase()] || 'Other'}</span>`;
        };
        const sBadge = (s) => {
          const m = { paid: 'acc-status-paid', received: 'acc-status-paid', completed: 'acc-status-paid', pending: 'acc-status-pending', overdue: 'acc-status-overdue', draft: 'acc-status-draft', sent: 'acc-status-sent', cancelled: 'acc-status-cancelled' };
          const status = String(s || '').toLowerCase();
          const label = status ? status[0].toUpperCase() + status.slice(1).replace(/_/g, ' ') : '—';
          return `<span class="acc-status-badge ${m[status] || 'acc-status-other'}" aria-label="Status: ${escapeHtml(label)}">${status === 'pending' ? proofIconMarkup('pending', 13) : ''}<span>${escapeHtml(label)}</span></span>`;
        };
        const proofIcon = (r) => r.proof_url
          ? `<button class="acc-proof-btn has-proof" data-proof="${escapeHtml(r.proof_url)}" data-id="${r.id}" title="View proof" aria-label="View proof" type="button">${proofIconMarkup('paperclip')}</button>`
          : `<span class="acc-proof-btn acc-proof-btn-empty" data-noproof="${r.id}" title="No proof attached" aria-label="No proof attached">${proofIconMarkup('file')}</span>`;

        // Filter finance rows by sub-tab and search
        const getFinRows = () => {
          let rows = [...state.data.finances];
          const sh = state.accSubTab || 'all';
          if (sh === 'income') rows = incomeRows();
          else if (sh === 'expenses') rows = rows.filter(r => r.transaction_type === 'expense');
          else if (sh === 'salary') rows = rows.filter(r => r.transaction_type === 'salary');
          else if (sh === 'invoices') rows = [
            ...state.data.invoices.map((invoice) => ({
              ...invoice,
              record_kind: 'invoice',
              invoice_id: invoice.id,
              transaction_type: 'invoice',
              transaction_date: invoice.invoice_date || String(invoice.created_at || '').slice(0, 10),
              title: invoice.service_title || invoice.invoice_number || 'Invoice',
              amount: invoiceTotal(invoice),
              status: invoiceEffectiveStatus(invoice),
            })),
            ...invoiceLedgerEntryRows(),
          ];
          if (state.accSearch) {
            const q = state.accSearch.toLowerCase();
            rows = rows.filter(r => (r.title || '').toLowerCase().includes(q) || (r.status || '').toLowerCase().includes(q));
          }
          return rows;
        };
        const finRows = getFinRows();
        const txPage = state.accTxPage || 1, txPer = 12;
        const txTotal = finRows.length;
        const txPageRows = finRows.slice((txPage - 1) * txPer, txPage * txPer);

        const transactionTypeOptions = (selected) => ['income', 'revenue', 'expense', 'salary', 'invoice'].map((type) => `<option value="${type}" ${selected === type ? 'selected' : ''}>${nice(type === 'expense' ? 'expenses' : type)}</option>`).join('');
        const transactionStatusOptions = (selected) => ['pending', 'paid', 'received', 'half_payment', 'cancelled'].map((status) => `<option value="${status}" ${selected === status ? 'selected' : ''}>${nice(status)}</option>`).join('');
        const inlineTransactionRow = (record = {}, showProof = false) => {
          const isNew = !record.id;
          const type = record.transaction_type || state.accInlineFinanceType || (state.accSubTab === 'income' ? 'income' : state.accSubTab === 'expenses' ? 'expense' : state.accSubTab === 'salary' ? 'salary' : 'expense');
          const status = record.status || (type === 'income' ? 'received' : 'pending');
          const date = record.transaction_date || new Date().toISOString().slice(0, 10);
          const initialSaveLabel = isNew ? 'Draft · complete required fields' : 'Auto-save ready';
          const proofCellMarkup = showProof
            ? isNew
              ? '<span class="acc-inline-proof-placeholder">Complete the row to attach proof</span>'
              : `<div class="acc-inline-proof-actions">${record.proof_url ? proofIcon(record) : '<span class="acc-inline-no-proof">No proof</span>'}<label class="acc-proof-btn acc-proof-upload" title="Attach or replace proof" aria-label="Attach or replace proof">${proofIconMarkup('upload')}<input type="file" accept="image/*,.pdf" data-proof-upload="${record.id}" style="display:none;" /></label></div>`
            : '';
          const actionLabel = isNew ? 'Cancel' : 'Done';
          return `<tr class="acc-tbl-row acc-inline-row" data-inline-finance-row${isNew ? ' data-inline-finance-new' : ` data-inline-finance-id="${record.id}"`}>
            <td><input class="crm-edit-input" data-inline-field="transaction_date" type="date" value="${escapeHtml(date)}" aria-label="Transaction date" /></td>
            <td><input class="crm-edit-input" data-inline-field="title" value="${escapeHtml(record.title || '')}" placeholder="Description" aria-label="Description" /></td>
            <td><select class="crm-edit-select" data-inline-field="transaction_type" aria-label="Category">${transactionTypeOptions(type)}</select></td>
            <td><input class="crm-edit-input" data-inline-field="amount" type="number" min="0" step="0.01" value="${escapeHtml(record.amount ?? '')}" placeholder="0.00" aria-label="Amount" /></td>
            <td><select class="crm-edit-select" data-inline-field="status" aria-label="Status">${transactionStatusOptions(status)}</select></td>
            ${showProof ? `<td>${proofCellMarkup}</td>` : ''}
            <td><div class="acc-inline-actions"><span class="acc-inline-save-state acc-inline-save-state--draft" data-inline-save-state aria-live="polite">${initialSaveLabel}</span><button class="crm-button" data-cancel-inline-finance type="button">${actionLabel}</button></div></td>
          </tr>`;
        };
        const invoiceTransactionRow = (record, showProof) => {
          const invoiceId = record.invoice_id || record.id;
          const invoice = state.data.invoices.find((item) => String(item.id) === String(invoiceId)) || record;
          const ledger = invoiceLedgerRecord(invoice);
          const proofUrl = ledger?.proof_url || '';
          const incomeLabel = normalizedStatus(invoice.status) === 'cancelled'
            ? '<span style="font-size:10px;color:#94a3b8;font-weight:700;">Voided</span>'
            : isSettledInvoice(invoice)
              ? '<span style="font-size:10px;color:#15803d;font-weight:700;">Included in income</span>'
              : '<span style="font-size:10px;color:#a16207;font-weight:700;">Outstanding</span>';
          const proofAction = proofUrl
            ? `<button class="crm-mini-action" data-proof-open="${escapeHtml(proofUrl)}" type="button">Preview proof</button>${canWriteFinance ? `<label class="crm-mini-action" style="cursor:pointer;">Replace<input type="file" data-proof-upload="${ledger.id}" accept="image/*,.pdf" style="display:none;" /></label>` : ''}`
            : ledger && canWriteFinance
              ? `<label class="crm-mini-action" style="cursor:pointer;">+ Proof<input type="file" data-proof-upload="${ledger.id}" accept="image/*,.pdf" style="display:none;" /></label>`
              : '<span style="font-size:10px;color:#94a3b8;">Optional proof</span>';
          return `<tr class="acc-tbl-row" data-row-id="${record.id}" data-record-kind="invoice">
            <td style="white-space:nowrap;font-size:12px;color:#64748b;">${fmtDate(record.transaction_date)}</td>
            <td style="font-weight:600;">${escapeHtml(record.title || record.reference_id || 'Invoice')}</td>
            <td>${catBadge('invoice')}</td>
            <td class="acc-amt-invoice" style="font-weight:700;">${signedINR(record.amount, 'invoice', record.status)}</td>
            <td>${sBadge(record.status)}</td>
            ${showProof ? `<td><div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">${proofAction}</div></td>` : ''}
            <td><div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">${incomeLabel}<button class="crm-button" data-load-invoice="${invoiceId}" type="button" title="Open invoice">View invoice</button></div></td>
          </tr>`;
        };
        const txTable = (rows, showProof = false) => {
          const isAdding = state.accInlineFinanceId === 'new';
          if (!rows.length && !isAdding) return `<p style="padding:24px;text-align:center;color:#94a3b8;font-size:13px;">No records found.</p>`;
          return `<div style="overflow-x:auto;"><table class="acc-tbl"><thead><tr>
            <th>Date</th><th>Description</th><th>Category</th><th>Amount</th><th>Status</th>${showProof ? '<th>Proof</th>' : ''}<th>Actions</th>
          </tr></thead><tbody>
          ${isAdding ? inlineTransactionRow({}, showProof) : ''}
          ${rows.map(r => r.record_kind === 'invoice' || (r.transaction_type === 'invoice' && r.invoice_id) ? invoiceTransactionRow(r, showProof) : state.accInlineFinanceId === String(r.id) ? inlineTransactionRow(r, showProof) : `<tr class="acc-tbl-row${state.accSelectedId === String(r.id) ? ' acc-row-selected' : ''}${String(r.status).toLowerCase() === 'pending' ? ' acc-row-pending' : ''}" data-row-id="${r.id}">
            <td style="white-space:nowrap;font-size:12px;color:#64748b;">${fmtDate(r.transaction_date)}</td>
            <td style="font-weight:600;">${escapeHtml(r.title || '—')}</td>
            <td>${catBadge(r.transaction_type)}</td>
            <td class="${r.transaction_type === 'invoice' ? 'acc-amt-invoice' : isInc(r.transaction_type) ? 'acc-amt-pos' : 'acc-amt-neg'}" style="font-weight:700;">${signedINR(r.amount, r.transaction_type, r.status)}</td>
            <td>${sBadge(r.status)}</td>
            ${showProof ? `<td><div class="acc-proof-actions">${proofIcon(r)}${canWriteFinance ? `<label class="acc-proof-btn acc-proof-upload" title="Attach or replace proof" aria-label="Attach or replace proof">${proofIconMarkup('upload')}<input type="file" accept="image/*,.pdf" data-proof-upload="${r.id}" style="display:none;" /></label>` : ''}</div></td>` : ''}
            <td><div style="display:${canWriteFinance ? 'flex' : 'none'};gap:4px;align-items:center;">
              <button class="crm-button" data-edit-finance="${r.id}" type="button" title="Edit" aria-label="Edit" style="padding:4px 7px;display:inline-flex;align-items:center;justify-content:center;line-height:1;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2 2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>
              <button class="crm-button" data-del-finance="${r.id}" type="button" title="Delete" aria-label="Delete" style="padding:4px 7px;display:inline-flex;align-items:center;justify-content:center;line-height:1;color:#dc2626;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg></button>
            </div></td>
          </tr>`).join('')}
          </tbody></table></div>`;
        };

        const proofPanel = (panelId) => {
          const row = state.data.finances.find(r => String(r.id) === String(state.accSelectedId));
          if (!row) return `<div class="acc-proof-panel" id="${panelId}" style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;text-align:center;min-height:200px;">
            <div class="acc-proof-empty-icon">${proofIconMarkup('file', 32)}</div>
            <div style="font-size:14px;font-weight:700;color:#475569;">Proof Preview</div>
            <p style="font-size:12px;color:#94a3b8;margin-top:6px;max-width:320px;">Click any transaction row to see details and proof/receipt here.</p>
          </div>`;
          const safeRawUrl = escapeHtml(row.proof_url || '');

          let proofContentMarkup = '';
          if (row.proof_url) {
            proofContentMarkup = `<div data-proof-auto-preview data-proof-value="${safeRawUrl}" style="border:1.5px solid #e2e8f0;border-radius:10px;padding:16px;text-align:center;background:#fff;margin-bottom:10px;"><p style="margin:0;color:#64748b;font-size:12px;">Loading secure preview…</p></div>`;
          } else {
            proofContentMarkup = `
              <label style="display:${canWriteFinance ? 'flex' : 'none'};flex-direction:column;align-items:center;gap:8px;border:1.5px dashed #d1d5db;border-radius:10px;padding:20px;cursor:pointer;background:#fafafa;transition:background .15s;" onmouseover="this.style.background='#f0f0f0'" onmouseout="this.style.background='#fafafa'">
                <div class="acc-proof-empty-icon">${proofIconMarkup('upload', 30)}</div>
                <span style="font-size:12px;color:#94a3b8;font-weight:600;">No proof attached</span>
                <span style="font-size:11px;color:#6366f1;font-weight:700;">Click to Upload</span>
                <input type="file" accept="image/*,.pdf" data-proof-upload="${row.id}" data-proof-row="${row.id}" style="display:none;" />
              </label>`;
          }

          return `<div class="acc-proof-panel" id="${panelId}">
            <div style="padding:14px 16px;border-bottom:1px solid #f0f4fb;background:#f8fafc;">
              <div style="font-size:13px;font-weight:800;color:#1e293b;margin-bottom:2px;">${escapeHtml(row.title || '—')}</div>
              <div style="font-size:11px;color:#94a3b8;">${fmtDate(row.transaction_date)}</div>
            </div>
            <div style="padding:14px 16px;">
              <div style="font-size:22px;font-weight:800;color:${isInc(row.transaction_type) && (normalizedStatus(row.transaction_type) !== 'invoice' || SETTLED_INVOICE_TRANSACTION_STATUSES.has(normalizedStatus(row.status))) ? '#16a34a' : normalizedStatus(row.transaction_type) === 'invoice' ? '#a16207' : '#dc2626'};margin-bottom:6px;">${signedINR(row.amount, row.transaction_type, row.status)}</div>
              <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;">${catBadge(row.transaction_type)}${sBadge(row.status)}</div>
              ${String(row.status).toLowerCase() === 'pending' && normalizedStatus(row.transaction_type) !== 'invoice' ? '<div class="acc-pending-note" role="status">' + proofIconMarkup('pending', 16) + '<span><strong>Pending review</strong><small>Update the status after confirming this record.</small></span>' + (canWriteFinance ? `<button class="crm-button" type="button" data-resolve-finance="${row.id}" style="margin-left:auto;white-space:nowrap;padding:5px 8px;font-size:10px;">Mark ${isInc(row.transaction_type) ? 'Received' : 'Paid'}</button>` : '') + '</div>' : ''}
              ${proofContentMarkup}
              ${row.notes ? `<div style="margin-top:12px;font-size:12px;color:#64748b;background:#f8fafc;padding:10px;border-radius:8px;border-left:3px solid #e2e8f0;">${escapeHtml(row.notes)}</div>` : ''}
            </div>
          </div>`;
        };

        // Build sub-tab pills
        const subTabs = (tabs) => `<div class="acc-sheet-tabs">${tabs.map(([k, l]) => `<button class="acc-sheet-tab${(state.accSubTab || 'all') === k ? ' active' : ''}" data-acc-subtab="${k}" type="button">${l}</button>`).join('')}</div>`;
        const financialPulse = `<section class="acc-financial-pulse" aria-label="Financial summary">
          <div class="acc-pulse-metrics">
            <div class="acc-pulse-metric acc-pulse-income"><span>Income</span><strong>${fmtINR(income)}</strong><small>${collectedIncome.length} settled entries, including paid invoices</small></div>
