          <td><select class="crm-edit-select" data-field="status">${['pending','paid','received','sent','overdue','half_payment','cancelled'].map((s) => `<option value="${s}" ${item.status === s ? 'selected' : ''}>${nice(s)}</option>`).join('')}</select></td>
