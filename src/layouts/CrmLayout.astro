    }
    @media (max-width: 720px) {
      .inv-upload-grid { grid-template-columns: 1fr; }
      .inv-summary-grid { grid-template-columns: 1fr 1fr; }
      .inv-sheet-header { grid-template-columns: 1fr; text-align: center; }
      .inv-sheet-top-right { text-align: center; }
      .inv-sheet .inv-bill-row,
      .inv-sheet .inv-paid-row,
      .inv-sheet .inv-bottom-row { grid-template-columns: 1fr; }
      .inv-sheet .inv-bill-left { border-right: 0; border-bottom: 2px solid #111; }
      .inv-sheet .inv-bill-right { grid-template-columns: 1fr; }
      .inv-sheet .inv-sign-box { grid-template-columns: 1fr; }
    }

    @media print {
      .inv-builder-no-print { display: none !important; }
      .inv-sheet { border: 2px solid #111; box-shadow: none; }
    }

    /* Dashboard reference layout: a calm operations control room. */
    .crm-content > #crm-status:empty {
