        </div>`;

        const tabDefs = [['overview', 'Overview'], ['transactions', 'Transactions'], ['invoices', 'Invoices'], ['reports', 'Reports']];
        const tabContent = accTab === 'overview' ? overviewTab : accTab === 'transactions' ? transactionsTab : accTab === 'invoices' ? invoicesTab : reportsTab;

        bodyContent = `<style>
          .acc-tab-nav{display:flex;border-bottom:2px solid #e5e7eb;margin-bottom:20px;}
          .acc-tab-btn{background:none;border:none;border-bottom:2.5px solid transparent;margin-bottom:-2px;cursor:pointer;padding:10px 22px;font-size:14px;font-weight:500;color:#94a3b8;transition:all .15s;}
