        expenses: ['', 'Date', 'Expense ID', 'Purpose', 'Paid By', 'Payment Method', 'Amount', 'Status', 'Notes', 'Proof', 'Actions'],
        salary:   ['', 'Date', 'Employee', 'Department', 'Role', 'Bank Name', 'Account No.', 'Amount', 'Status', 'Proof', 'Actions'],
        invoices: ['', 'Date', 'Invoice No.', 'Client', 'Service', 'Due Date', 'Total', 'Paid', 'Balance', 'Status', 'Actions'],
