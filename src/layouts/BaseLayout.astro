---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noIndex?: boolean;
  hideNavbar?: boolean;
  isCrm?: boolean;
}

const {
  title,
  description = 'TechMigos - Building Tomorrow, Together. We partner with startups and enterprises to design, build, and ship world-class digital products.',
  ogImage = '/og-image.png',
  ogType = 'website',
  noIndex = false,
  hideNavbar = false,
  isCrm = false,
} = Astro.props;

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || 'https://www.techmigos.com';
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const absoluteOgImage = new URL(ogImage, siteOrigin).toString();
const publicApiBaseUrl = (import.meta.env.PUBLIC_API_BASE_URL || '').trim().replace(/\/$/, '');
const pageTitle = title === 'Home'
  ? 'TechMigos | Web, Mobile, AI & Backend Development'
  : `${title} | TechMigos`;
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbLabels: Record<string, string> = {
  about: 'About', services: 'Services', portfolio: 'Portfolio', blog: 'Blog',
  careers: 'Careers', contact: 'Contact', support: 'Support', privacy: 'Privacy Policy', terms: 'Terms of Service',
};
const breadcrumbs = pathSegments.map((segment, index) => ({
  name: breadcrumbLabels[segment] || segment.replace(/-/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase()),
  url: new URL(`/${pathSegments.slice(0, index + 1).join('/')}`, siteOrigin).toString(),
}));
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteOrigin}/#organization`,
      name: 'TechMigos',
      url: siteOrigin,
      logo: `${siteOrigin}/icon.png`,
      description,
      email: 'info@techmigos.com',
      sameAs: [
        'https://linkedin.com/company/techmigos',
        'https://github.com/techmigos',
        'https://twitter.com/techmigos',
        'https://www.instagram.com/techmigos_official/',
        'https://medium.com/@techmigos',
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'info@techmigos.com',
        contactType: 'customer service',
        availableLanguage: ['English'],
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      name: 'TechMigos',
      url: siteOrigin,
      publisher: { '@id': `${siteOrigin}/#organization` },
      inLanguage: 'en-IN',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      name: pageTitle,
      description,
      url: canonicalURL.toString(),
      isPartOf: { '@id': `${siteOrigin}/#website` },
      about: { '@id': `${siteOrigin}/#organization` },
      inLanguage: 'en-IN',
    },
    ...(breadcrumbs.length ? [{
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteOrigin },
        ...breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 2, name: item.name, item: item.url })),
      ],
    }] : []),
  ],
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="TechMigos" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#2563EB" />

    <meta name="techmigos-api-base-url" content={publicApiBaseUrl} />

    <!-- Performance: preconnect to key origins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://lzlflnjrtxovzrniwmyq.supabase.co" />

    <!-- JSON-LD makes the page, organization, and navigation legible to search engines. -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
    <script is:inline define:vars={{ sbUrl: import.meta.env.PUBLIC_SUPABASE_URL || '', sbKey: import.meta.env.PUBLIC_SUPABASE_KEY || '' }}>
      window.TechMigosConfig = { apiBaseUrl: '' };
      window.techmigosApiUrl = function(p) { return String(p || ''); };
      window.techmigosApiFetch = async function() { return new Response('{}', { status: 501 }); };
      window.techmigosGetCsrfToken = async function() { return 'no-csrf'; };
      window.tmSupabase = null;
      window.tmCrmReady = new Promise((resolve) => { window.__resolveTmCrm = resolve; });

      try {
        if (sbUrl && sbKey) {
          window.tmSupabase = supabase.createClient(sbUrl, sbKey);
        }
      } catch (e) {
        console.error('Supabase init failed:', e);
      }
    </script>
    <script>
      import { createCrmRepository } from '../lib/crm/repository.js';

      const crmRepository = createCrmRepository(() => window.tmSupabase);
      window.tmCrm = { repository: crmRepository };
      window.__resolveTmCrm?.(window.tmCrm);
    </script>
  </head>
  <body class="bg-white text-gray-900">
    <!-- Skip to main content link for accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    {!isCrm && <>
    {/* Custom Cursor */}
    <div id="cursor-dot" style="left:-100px;top:-100px;"></div>
    <div id="cursor-ring" style="left:-100px;top:-100px;"></div>
    {/* Scroll Progress Bar */}
    <div id="page-progress" style="width:0%"></div>
    </>}

    {!hideNavbar && <Navbar />}

    <main id="main-content">
      <slot />
    </main>

    {!isCrm && <Footer />}

    <SpeedInsights />

    <script>
      // ============================================
      // CUSTOM CURSOR
      // ============================================
      const dot = document.getElementById('cursor-dot');
      const ring = document.getElementById('cursor-ring');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      const allowEnhancedMotion = !reducedMotion.matches && (finePointer.matches || window.innerWidth >= 1024);
      let dotX = -100, dotY = -100;
      let ringX = -100, ringY = -100;

      if (!allowEnhancedMotion) {
        dot?.remove();
        ring?.remove();
      }

      if (allowEnhancedMotion && dot && ring) {
        const cursorDot = dot;
        const cursorRing = ring;

        document.addEventListener('mousemove', (e) => {
          dotX = e.clientX;
          dotY = e.clientY;
          cursorDot.style.left = dotX + 'px';
          cursorDot.style.top = dotY + 'px';
        }, { passive: true });

        function animateCursor() {
          ringX += (dotX - ringX) * 0.12;
          ringY += (dotY - ringY) * 0.12;
          cursorRing.style.left = ringX + 'px';
          cursorRing.style.top = ringY + 'px';
          requestAnimationFrame(animateCursor);
        }

        animateCursor();

        const interactiveEls = document.querySelectorAll('a, button, [role="button"], input, textarea, select, label');
        interactiveEls.forEach(el => {
          el.addEventListener('mouseenter', () => document.body.classList.add('cursor-hovering'));
          el.addEventListener('mouseleave', () => document.body.classList.remove('cursor-hovering'));
        });

        document.addEventListener('mouseleave', () => {
          cursorDot.style.left = '-100px';
          cursorDot.style.top = '-100px';
          cursorRing.style.left = '-100px';
          cursorRing.style.top = '-100px';
        });
      }

      // ============================================
      // SCROLL PROGRESS BAR
      // ============================================
      const progressBar = document.getElementById('page-progress');
      if (!reducedMotion.matches && progressBar) {
        window.addEventListener('scroll', () => {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          progressBar.style.width = progress + '%';
        }, { passive: true });
      } else {
        progressBar?.remove();
      }

      // ============================================
      // SCROLL REVEAL (IntersectionObserver)
      // ============================================
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });

      document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale').forEach(el => {
        revealObserver.observe(el);
      });

      // ============================================
      // MAGNETIC BUTTON EFFECT
      // ============================================
      if (allowEnhancedMotion) {
        document.querySelectorAll('.btn-primary, .btn-ghost').forEach(btn => {
          btn.addEventListener('mousemove', (e: Event) => {
            const mouseEvent = e as MouseEvent;
            const rect = (btn as HTMLElement).getBoundingClientRect();
            const x = mouseEvent.clientX - rect.left - rect.width / 2;
            const y = mouseEvent.clientY - rect.top - rect.height / 2;
            (btn as HTMLElement).style.transform = `translate(${x * 0.1}px, ${y * 0.1}px) translateY(-2px)`;
          });
          btn.addEventListener('mouseleave', () => {
            (btn as HTMLElement).style.transform = '';
          });
        });
      }

      // ============================================
      // NUMBER COUNTER ANIMATION
      // ============================================
      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = el.dataset.counter || '';
            const numericPart = parseInt(target.replace(/\D/g, ''));
            const suffix = target.replace(/[\d]/g, '');
            let current = 0;
            const duration = 1800;
            const step = numericPart / (duration / 16);
            const timer = setInterval(() => {
              current = Math.min(current + step, numericPart);
              el.textContent = Math.floor(current) + suffix;
              if (current >= numericPart) {
                el.textContent = target;
                clearInterval(timer);
              }
            }, 16);
            counterObserver.unobserve(el);
          }
        });
      }, { threshold: 0.5 });

      document.querySelectorAll('[data-counter]').forEach(el => {
        counterObserver.observe(el);
      });

      // ============================================
      // TILT CARD EFFECT
      // ============================================
      if (allowEnhancedMotion) {
        document.querySelectorAll('.tilt-card').forEach(card => {
          card.addEventListener('mousemove', (e: Event) => {
            const mouseEvent = e as MouseEvent;
            const rect = (card as HTMLElement).getBoundingClientRect();
            const x = (mouseEvent.clientX - rect.left) / rect.width - 0.5;
            const y = (mouseEvent.clientY - rect.top) / rect.height - 0.5;
            (card as HTMLElement).style.transform = `perspective(600px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg) scale(1.01)`;
          });
          card.addEventListener('mouseleave', () => {
            (card as HTMLElement).style.transform = 'perspective(600px) rotateY(0) rotateX(0) scale(1)';
          });
        });
      }
    </script>
  </body>
</html>
