---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="TechMigos Client Project Portal"
  description="TechMigos client portal for viewing project progress, invoice status, and support tickets in one secure customer workspace."
  noIndex={true}
>
  <section class="min-h-screen pt-28 pb-16 bg-slate-100">
    <div class="container-custom">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <span class="section-eyebrow">Client Portal</span>
          <h1 class="mt-3 text-4xl font-extrabold text-slate-950">Project workspace</h1>
          <p id="client-user" class="mt-2 text-slate-600">Loading your workspace...</p>
        </div>
        <button id="logout-button" class="btn-secondary">Sign out</button>
      </div>

      <p id="client-status" class="mt-6 text-sm text-slate-600" role="status">Loading portal data...</p>

      <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_380px]">
        <div class="space-y-6">
          <section class="bg-white rounded-lg border border-slate-200 p-5">
            <h2 class="text-xl font-bold text-slate-950">Projects</h2>
            <div id="projects-list" class="mt-4 grid gap-4"></div>
          </section>

          <section class="bg-white rounded-lg border border-slate-200 p-5">
            <h2 class="text-xl font-bold text-slate-950">Invoices</h2>
            <div id="invoices-list" class="mt-4 overflow-x-auto"></div>
          </section>

          <section class="bg-white rounded-lg border border-slate-200 p-5">
            <h2 class="text-xl font-bold text-slate-950">Support Tickets</h2>
            <div id="tickets-list" class="mt-4 grid gap-3"></div>
          </section>
        </div>

        <aside class="bg-white rounded-lg border border-slate-200 p-5 h-fit">
          <h2 class="text-xl font-bold text-slate-950">Open support ticket</h2>
          <form id="ticket-form" class="mt-5 space-y-4">
            <label class="block">
              <span class="form-label">Project ID</span>
              <input name="project_id" type="number" class="form-input form-control" placeholder="Optional" />
            </label>
            <label class="block">
              <span class="form-label">Subject</span>
              <input name="subject" type="text" required class="form-input form-control" />
            </label>
            <label class="block">
              <span class="form-label">Priority</span>
              <select name="priority" class="form-input form-control">
                <option value="medium">Medium</option>
                <option value="low">Low</option>
                <option value="high">High</option>
                <option value="urgent">Urgent</option>
              </select>
            </label>
            <label class="block">
              <span class="form-label">Description</span>
              <textarea name="description" required class="form-input form-control min-h-[140px]"></textarea>
            </label>
            <button class="btn-primary w-full justify-center" type="submit">Submit ticket</button>
          </form>
        </aside>
      </div>
    </div>
  </section>

  <script is:inline>
    const statusEl = document.getElementById('client-status');
    const userEl = document.getElementById('client-user');
    const projectsEl = document.getElementById('projects-list');
    const invoicesEl = document.getElementById('invoices-list');
    const ticketsEl = document.getElementById('tickets-list');
    const ticketForm = document.getElementById('ticket-form');

    function token() {
      return sessionStorage.getItem('tm_portal_access_token') || '';
    }

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
    }

    function logout() {
      sessionStorage.removeItem('tm_portal_access_token');
      sessionStorage.removeItem('tm_portal_refresh_token');
      sessionStorage.removeItem('tm_portal_csrf_token');
      location.href = '/login';
    }

    function setStatus(message, tone = 'neutral') {
      statusEl.textContent = message;
      statusEl.className = `mt-6 text-sm ${tone === 'error' ? 'text-red-600' : tone === 'success' ? 'text-emerald-700' : 'text-slate-600'}`;
    }

    async function portal(path, options = {}) {
      const headers = new Headers(options.headers || {});
      headers.set('authorization', `Bearer ${token()}`);
      if (options.body && !headers.has('content-type')) headers.set('content-type', 'application/json');
      const response = await window.techmigosApiFetch(path, { ...options, headers });
      const data = await response.json().catch(() => null);
      if (!response.ok) throw new Error(data?.error || 'Portal request failed.');
      return data;
    }

    function renderProjects(projects) {
      projectsEl.innerHTML = projects.map((project) => `
        <article class="border border-slate-200 rounded-lg p-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase text-slate-400">#${escapeHtml(project.id)}</p>
              <h3 class="mt-1 text-lg font-bold text-slate-950">${escapeHtml(project.name)}</h3>
              <p class="mt-2 text-sm text-slate-600">${escapeHtml(project.summary || 'No summary added yet.')}</p>
            </div>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">${escapeHtml(project.status)}</span>
          </div>
          <div class="mt-4 h-2 rounded-full bg-slate-100 overflow-hidden">
            <div class="h-full bg-primary-600" style="width:${Math.max(0, Math.min(100, Number(project.progress || 0)))}%"></div>
          </div>
          <p class="mt-2 text-xs text-slate-500">Progress: ${escapeHtml(project.progress || 0)}% ${project.due_date ? `- Due ${escapeHtml(project.due_date)}` : ''}</p>
        </article>
      `).join('') || '<p class="text-sm text-slate-500">No projects are linked yet.</p>';
    }

    function renderInvoices(invoices) {
      invoicesEl.innerHTML = `
        <table class="min-w-full text-sm">
          <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
            <tr><th class="px-4 py-3">Invoice</th><th class="px-4 py-3">Amount</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Due</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            ${invoices.map((invoice) => `
              <tr>
                <td class="px-4 py-3 font-semibold text-slate-950">${escapeHtml(invoice.invoice_number)}</td>
                <td class="px-4 py-3 text-slate-600">${escapeHtml(invoice.currency || 'INR')} ${escapeHtml(invoice.amount || 0)}</td>
                <td class="px-4 py-3 text-slate-600">${escapeHtml(invoice.status)}</td>
                <td class="px-4 py-3 text-slate-600">${escapeHtml(invoice.due_date || '')}</td>
              </tr>
            `).join('') || '<tr><td class="px-4 py-6 text-slate-500" colspan="4">No invoices yet.</td></tr>'}
          </tbody>
        </table>
      `;
    }

    function renderTickets(tickets) {
      ticketsEl.innerHTML = tickets.map((ticket) => `
        <article class="border border-slate-200 rounded-lg p-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="font-bold text-slate-950">${escapeHtml(ticket.subject)}</h3>
              <p class="mt-1 text-sm text-slate-600">${escapeHtml(ticket.description)}</p>
            </div>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">${escapeHtml(ticket.status)}</span>
          </div>
          <p class="mt-3 text-xs text-slate-500">Priority: ${escapeHtml(ticket.priority)} - Created ${escapeHtml(ticket.created_at || '')}</p>
        </article>
      `).join('') || '<p class="text-sm text-slate-500">No support tickets yet.</p>';
    }

    async function loadOverview() {
      const data = await portal('/api/portal/client/overview');
      userEl.textContent = `${data.client?.name || 'Client'} workspace`;
      renderProjects(data.projects || []);
      renderInvoices(data.invoices || []);
      renderTickets(data.tickets || []);
      setStatus('Workspace loaded.', 'success');
    }

    async function boot() {
      if (!token()) return logout();
      try {
        const me = await portal('/api/portal/me');
        if (me.destination !== '/client') location.href = me.destination;
        await loadOverview();
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'Could not load portal.', 'error');
        setTimeout(logout, 1200);
      }
    }

    ticketForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const body = Object.fromEntries(new FormData(ticketForm).entries());
      if (!body.project_id) delete body.project_id;
      else body.project_id = Number(body.project_id);
      try {
        await portal('/api/portal/client/tickets', { method: 'POST', body: JSON.stringify(body) });
        ticketForm.reset();
        setStatus('Support ticket created.', 'success');
        await loadOverview();
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'Could not create support ticket.', 'error');
      }
    });

    document.getElementById('logout-button')?.addEventListener('click', logout);
    boot();
  </script>
</BaseLayout>
