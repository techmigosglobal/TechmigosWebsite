---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="TechMigos Client Project Portal"
  description="TechMigos client portal for viewing project progress, invoice status, and support tickets in one secure customer workspace."
  noIndex={true}
>
  <style is:global>
    @page { size: A4 landscape; margin: 10mm; }

    @media print {
      body * { visibility: hidden !important; }

      #invoice-preview,
      #invoice-preview * { visibility: visible !important; }

      #invoice-preview {
        position: fixed !important;
        inset: 0 !important;
        padding: 0 !important;
        background: white !important;
        overflow: visible !important;
      }

      .invoice-print-sheet {
        width: 277mm !important;
        max-width: 277mm !important;
        margin: 0 auto !important;
        padding: 0 !important;
        font-size: 9.5px !important;
        line-height: 1.4 !important;
        font-family: Arial, sans-serif !important;
        color: #000 !important;
      }

      .invoice-print-sheet * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .print\:hidden { display: none !important; }
    }
  </style>

  <section class="min-h-screen bg-slate-100 pt-24 pb-10">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.22em] text-primary-600">Client Portal</p>
            <h1 class="mt-2 text-3xl font-extrabold text-slate-950 sm:text-4xl">Project workspace</h1>
            <p id="client-user" class="mt-2 text-slate-600">Loading your workspace...</p>
          </div>
          <button id="logout-button" class="btn-secondary">Sign out</button>
        </div>
        <p id="client-status" class="mt-4 text-sm text-slate-600" role="status">Loading portal data...</p>
      </div>

      <div id="client-kpis" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"></div>

      <div class="mt-5 grid gap-5 lg:grid-cols-[1fr_320px]">
        <div class="space-y-5">
          <section class="rounded-lg border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between gap-3">
              <div>
                <h2 class="text-xl font-extrabold text-slate-950">Projects</h2>
                <p class="mt-1 text-sm text-slate-500">Delivery status, progress, and current project health.</p>
              </div>
            </div>
            <div id="projects-list" class="mt-4 grid gap-4 sm:grid-cols-2"></div>
          </section>

          <section class="rounded-lg border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between gap-3">
              <div>
                <h2 class="text-xl font-extrabold text-slate-950">Invoices</h2>
                <p class="mt-1 text-sm text-slate-500">View invoice status and print or save copies as PDF.</p>
              </div>
            </div>
            <div id="invoices-list" class="mt-4 grid gap-3"></div>
          </section>

          <section class="rounded-lg border border-slate-200 bg-white p-5">
            <h2 class="text-xl font-extrabold text-slate-950">Support Tickets</h2>
            <div id="tickets-list" class="mt-4 grid gap-3"></div>
          </section>
        </div>

        <aside class="space-y-5">
          <section class="rounded-lg border border-slate-200 bg-white p-5">
            <h2 class="text-xl font-extrabold text-slate-950">Open support ticket</h2>
            <form id="ticket-form" class="mt-5 space-y-4">
              <label class="block">
                <span class="form-label">Project</span>
                <select name="project_id" id="ticket-project" class="form-input form-control">
                  <option value="">General support</option>
                </select>
              </label>
              <label class="block">
                <span class="form-label">Subject</span>
                <input name="subject" type="text" required class="form-input form-control" />
              </label>
              <label class="block">
                <span class="form-label">Priority</span>
                <select name="priority" class="form-input form-control">
                  <option value="medium">Medium</option>
                  <option value="low">Low</option>
                  <option value="high">High</option>
                  <option value="urgent">Urgent</option>
                </select>
              </label>
              <label class="block">
                <span class="form-label">Description</span>
                <textarea name="description" required class="form-input form-control min-h-[140px]"></textarea>
              </label>
              <button class="btn-primary w-full justify-center" type="submit">Submit ticket</button>
            </form>
          </section>

          <section id="conversation-panel" class="hidden rounded-lg border border-slate-200 bg-white p-5">
            <h2 id="conversation-title" class="text-xl font-extrabold text-slate-950">Ticket conversation</h2>
            <div id="conversation-messages" class="mt-4 space-y-3"></div>
            <form id="message-form" class="mt-4 space-y-3">
              <textarea name="body" required class="form-input form-control min-h-[100px]" placeholder="Reply to this ticket"></textarea>
              <button class="btn-primary w-full justify-center" type="submit">Send reply</button>
            </form>
          </section>
        </aside>
      </div>
    </div>
  </section>

  <div id="invoice-modal" class="fixed inset-0 z-50 hidden bg-slate-950/70 p-4 sm:p-6">
    <div class="mx-auto max-h-[95vh] max-w-5xl overflow-auto rounded-lg bg-white shadow-2xl">
      <div class="flex items-center justify-between gap-4 border-b border-slate-200 p-4 sm:p-6 print:hidden">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary-600">Invoice Preview</p>
          <h2 id="invoice-preview-title" class="mt-1 text-xl font-extrabold text-slate-950">Invoice</h2>
        </div>
        <div class="flex gap-2">
          <button id="download-pdf-invoice" class="btn-secondary text-sm">Print / Save PDF</button>
          <button id="print-invoice" class="btn-primary text-sm">Print / Save PDF</button>
          <button id="close-invoice" class="btn-secondary text-sm">Close</button>
        </div>
      </div>
      <div id="invoice-preview" class="p-4 sm:p-6"></div>
    </div>
  </div>

  <script is:inline>
    const state = {
      client: null,
      projects: [],
      invoices: [],
      tickets: [],
      activeTicketId: null,
    };

    const statusEl = document.getElementById('client-status');
    const userEl = document.getElementById('client-user');
    const kpisEl = document.getElementById('client-kpis');
    const projectsEl = document.getElementById('projects-list');
    const invoicesEl = document.getElementById('invoices-list');
    const ticketsEl = document.getElementById('tickets-list');
    const ticketForm = document.getElementById('ticket-form');
    const messageForm = document.getElementById('message-form');
    const conversationPanel = document.getElementById('conversation-panel');
    const conversationTitle = document.getElementById('conversation-title');
    const conversationMessages = document.getElementById('conversation-messages');
    const invoiceModal = document.getElementById('invoice-modal');
    const invoicePreview = document.getElementById('invoice-preview');
    const invoicePreviewTitle = document.getElementById('invoice-preview-title');

    function token() {
      return 'supabase-session';
    }

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
    }

    function money(value, currency = 'INR') {
      return `${escapeHtml(currency || 'INR')} ${Number(value || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    function invoiceProjectSnapshot(invoice) {
      const snapshot = invoice?.project_snapshot;
      if (snapshot && typeof snapshot === 'object' && !Array.isArray(snapshot)) return snapshot;
      return state.projects.find((project) => String(project.id) === String(invoice?.project_id)) || {};
    }

    function invoiceBranding(invoice) {
      const branding = invoice?.invoice_branding;
      return branding && typeof branding === 'object' && !Array.isArray(branding) ? branding : {};
    }

    const UPI_ID = 'v5219@slc';
    const UPI_MERCHANT_NAME = 'TechMigos';

    function buildUpiPaymentUri(upiId, merchantName, invoiceNumber, amount) {
      const balanceAmount = Math.max(Number(amount) || 0, 0).toFixed(2);
      const paymentNote = `Invoice ${invoiceNumber}`;
      return `upi://pay?pa=${upiId}&pn=${encodeURIComponent(merchantName)}&am=${balanceAmount}&cu=INR&tn=${encodeURIComponent(paymentNote)}&tr=${encodeURIComponent(invoiceNumber)}`;
    }

    function buildUpiQrUrl(upiPaymentUri) {
      return `https://api.qrserver.com/v1/create-qr-code/?size=160x160&format=png&data=${encodeURIComponent(upiPaymentUri)}`;
    }

    function getInvoicePrintName(value) {
      return String(value || 'invoice').replace(/[^a-z0-9_-]+/gi, '-').replace(/^-+|-+$/g, '') || 'invoice';
    }

    async function printInvoiceMarkup(markup, filename = 'invoice') {
      const printWindow = window.open('', '_blank', 'popup,width=900,height=1100');
      if (!printWindow) {
        setStatus('Allow pop-ups to print or save the invoice as PDF.', 'error');
        return false;
      }
      printWindow.document.open();
      printWindow.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>${escapeHtml(filename)}</title><style>
        @page { size: A4 landscape; margin: 10mm; }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; background: #fff; color: #111; }
        body { font-family: Arial, Helvetica, sans-serif; }
        .invoice-print-sheet { width: 277mm; max-width: 277mm !important; margin: 0 auto; color: #111; background: #fff; font-family: Arial, Helvetica, sans-serif; font-size: 9.5pt; line-height: 1.35; }
        .invoice-print-sheet * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .invoice-print-sheet table { border-collapse: collapse; width: 100%; }
        img { max-width: 100%; }
      </style></head><body>${markup}</body></html>`);
      printWindow.document.close();
      await Promise.all(Array.from(printWindow.document.images || []).map((image) => image.complete ? Promise.resolve() : new Promise((resolve) => {
        image.addEventListener('load', resolve, { once: true });
        image.addEventListener('error', resolve, { once: true });
      })));
      printWindow.onafterprint = () => printWindow.close();
      printWindow.focus();
      window.setTimeout(() => printWindow.print(), 80);
      return true;
    }

    function badge(value, tone = 'slate') {
      const tones = {
        slate: 'bg-slate-100 text-slate-700',
        green: 'bg-emerald-50 text-emerald-700',
        yellow: 'bg-amber-50 text-amber-700',
        red: 'bg-red-50 text-red-700',
        blue: 'bg-blue-50 text-blue-700',
      };
      return `<span class="inline-flex rounded-full px-2.5 py-1 text-xs font-bold ${tones[tone] || tones.slate}">${escapeHtml(String(value || 'open').replace(/_/g, ' '))}</span>`;
    }

    function statusTone(status) {
      if (['paid', 'completed', 'resolved', 'closed', 'on_track'].includes(status)) return 'green';
      if (['overdue', 'urgent', 'at_risk'].includes(status)) return 'red';
      if (['sent', 'viewed', 'watch', 'high'].includes(status)) return 'yellow';
      return 'slate';
    }

    function setStatus(message, tone = 'neutral') {
      statusEl.textContent = message;
      statusEl.className = `mt-4 text-sm ${tone === 'error' ? 'text-red-600' : tone === 'success' ? 'text-emerald-700' : 'text-slate-600'}`;
      let retry = document.getElementById('client-retry-load');
      if (tone === 'error') {
        if (!retry) {
          retry = document.createElement('button');
          retry.id = 'client-retry-load';
          retry.type = 'button';
          retry.className = 'btn-secondary mt-2';
          retry.textContent = 'Retry loading workspace';
          statusEl.insertAdjacentElement('afterend', retry);
          retry.addEventListener('click', () => loadOverview());
        }
        retry.classList.remove('hidden');
      } else if (retry) {
        retry.classList.add('hidden');
      }
    }

    async function portal(path, options = {}) {
      if (window.tmCrmReady) await window.tmCrmReady;
      if (window.tmCrm?.repository) return window.tmCrm.repository.request(path, options);
      throw new Error('CRM repository is unavailable. Please refresh the page.');
    }

    function logout() {
      window.tmSupabase.auth.signOut();
      location.href = '/login';
    }

    function renderKpis() {
      const openTickets = state.tickets.filter((ticket) => !['resolved', 'closed'].includes(ticket.status)).length;
      const invoiceTotal = (invoice) => Math.max(Number(invoice.total_amount ?? invoice.amount ?? 0) || 0, 0);
      const invoiceReceived = (invoice) => {
        const total = invoiceTotal(invoice);
        if (['paid', 'completed'].includes(String(invoice.status || '').toLowerCase())) return total;
        return Math.min(Math.max(Number(invoice.received_amount || 0) || 0, 0), total);
      };
      const invoiceBalance = (invoice) => String(invoice.status || '').toLowerCase() === 'cancelled'
        ? 0
        : Math.max(invoiceTotal(invoice) - invoiceReceived(invoice), 0);
      const openInvoices = state.invoices.filter((invoice) => invoiceBalance(invoice) > 0);
      const outstanding = openInvoices.reduce((sum, invoice) => sum + invoiceBalance(invoice), 0);
      kpisEl.innerHTML = [
        ['Projects', state.projects.length, 'Linked active work'],
        ['Open tickets', openTickets, 'Support in progress'],
        ['Open invoices', openInvoices.length, money(outstanding)],
        ['Project progress', `${Math.round(state.projects.reduce((sum, project) => sum + Number(project.progress || 0), 0) / Math.max(state.projects.length, 1))}%`, 'Average completion'],
      ].map(([label, value, hint]) => `<article class="rounded-lg border border-slate-200 bg-white p-5"><p class="text-sm font-semibold text-slate-500">${label}</p><p class="mt-2 text-3xl font-extrabold text-slate-950">${value}</p><p class="mt-2 text-xs text-slate-400">${hint}</p></article>`).join('');
    }

    function renderProjects() {
      projectsEl.innerHTML = state.projects.map((project) => `
        <article class="rounded-lg border border-slate-200 p-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase text-slate-400">Project #${escapeHtml(project.id)}</p>
              <h3 class="mt-1 text-lg font-extrabold text-slate-950">${escapeHtml(project.name)}</h3>
              <p class="mt-2 text-sm text-slate-600">${escapeHtml(project.summary || 'No summary added yet.')}</p>
            </div>
            ${badge(project.health || project.status, statusTone(project.health || project.status))}
          </div>
          <div class="mt-4 h-2 rounded-full bg-slate-100 overflow-hidden">
            <div class="h-full bg-primary-600" style="width:${Math.max(0, Math.min(100, Number(project.progress || 0)))}%"></div>
          </div>
          <p class="mt-2 text-xs text-slate-500">Progress: ${escapeHtml(project.progress || 0)}% ${project.due_date ? `· Due ${escapeHtml(project.due_date)}` : ''}</p>
        </article>
      `).join('') || '<p class="text-sm text-slate-500">No projects are linked yet.</p>';

      const projectSelect = document.getElementById('ticket-project');
      projectSelect.innerHTML = '<option value="">General support</option>' + state.projects.map((project) => `<option value="${project.id}">${escapeHtml(project.name)}</option>`).join('');
    }

    function renderInvoices() {
      invoicesEl.innerHTML = state.invoices.map((invoice) => `
        <article class="flex flex-col gap-3 rounded-lg border border-slate-200 p-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-extrabold text-slate-950">${escapeHtml(invoice.invoice_number)}</p>
            <p class="mt-1 text-sm text-slate-500">${money(invoice.total_amount || invoice.amount, invoice.currency)} · Due ${escapeHtml(invoice.due_date || '-')}</p>
          </div>
          <div class="flex items-center gap-3">
            ${badge(invoice.status, statusTone(invoice.status))}
            <button class="text-sm font-bold text-primary-700" data-invoice="${invoice.id}">Preview</button>
          </div>
        </article>
      `).join('') || '<p class="text-sm text-slate-500">No invoices yet.</p>';
      invoicesEl.querySelectorAll('[data-invoice]').forEach((button) => button.addEventListener('click', () => showInvoice(button.dataset.invoice)));
    }

    function renderTickets() {
      ticketsEl.innerHTML = state.tickets.map((ticket) => `
        <article class="rounded-lg border border-slate-200 p-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="font-extrabold text-slate-950">${escapeHtml(ticket.subject)}</h3>
              <p class="mt-1 line-clamp-2 text-sm text-slate-600">${escapeHtml(ticket.description)}</p>
            </div>
            ${badge(ticket.status, statusTone(ticket.status))}
          </div>
          <div class="mt-4 flex items-center justify-between gap-3">
            <p class="text-xs text-slate-500">Priority: ${escapeHtml(ticket.priority)} · Created ${escapeHtml(ticket.created_at || '')}</p>
            <button class="text-sm font-bold text-primary-700" data-ticket="${ticket.id}">Open conversation</button>
          </div>
        </article>
      `).join('') || '<p class="text-sm text-slate-500">No support tickets yet.</p>';
      ticketsEl.querySelectorAll('[data-ticket]').forEach((button) => button.addEventListener('click', () => openConversation(button.dataset.ticket)));
    }

    async function showInvoice(id) {
      const result = await portal(`/api/portal/client/invoices/${id}`);
      const detail = result.detail;
      invoicePreviewTitle.textContent = `Invoice ${detail.invoice.invoice_number}`;
      invoicePreview.innerHTML = invoiceHtml(detail);
      invoicePreview.dataset.invoiceNumber = detail.invoice.invoice_number || id;
      invoiceModal.classList.remove('hidden');
      await loadOverview(false);
    }

    function invoiceHtml(detail) {
      const inv = detail.invoice;
      const cur = inv.currency || 'INR';
      const sym = cur === 'INR' ? '₹' : cur;
      const fmt = (v) => `${sym} ${Number(v || 0).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 })}`;
      const fmtNum = (v) => Number(v || 0).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
      const esc = escapeHtml;

      const billName = inv.customer_name || detail.client?.name || '';
      const billCompany = inv.customer_company || detail.client?.company || '';
      const billPhone = inv.customer_phone || detail.client?.phone || '';
      const billEmail = inv.customer_email || detail.client?.email || '';
      const branding = invoiceBranding(inv);
      const logoUrl = branding.logo_url || '/icon.png';
      const signatureUrl = branding.signature_url || inv.sign_url || '';

      const total = Math.max(Number(inv.total_amount ?? inv.amount ?? 0) || 0, 0);
      const received = String(inv.status || '').toLowerCase() === 'cancelled'
        ? 0
        : ['paid', 'completed'].includes(String(inv.status || '').toLowerCase())
          ? total
          : Math.min(Math.max(Number(inv.received_amount || 0) || 0, 0), total);
      const balance = String(inv.status || '').toLowerCase() === 'cancelled' ? 0 : Math.max(total - received, 0);
      const invoiceNumber = String(inv.invoice_number || inv.id || 'invoice');
      const upiPaymentUri = buildUpiPaymentUri(UPI_ID, UPI_MERCHANT_NAME, invoiceNumber, balance);
      const upiQrUrl = buildUpiQrUrl(upiPaymentUri);
      const items = detail.items || [];

      const itemRows = items.map((item, i) => `
        <tr>
          <td style="border:1px solid #ccc;padding:6px 8px;text-align:center;vertical-align:top;">${i + 1}</td>
          <td style="border:1px solid #ccc;padding:6px 8px;height:92px;vertical-align:top;"><strong>${esc(item.description)}</strong></td>
          <td style="border:1px solid #ccc;padding:6px 8px;text-align:center;vertical-align:top;">${fmtNum(item.quantity)} SERVICE</td>
          <td style="border:1px solid #ccc;padding:6px 8px;text-align:right;vertical-align:top;">${fmtNum(item.rate)}</td>
          <td style="border:1px solid #ccc;padding:6px 8px;text-align:right;vertical-align:top;">${fmtNum(item.amount)}</td>
        </tr>`).join('');

      const subtotal = items.reduce((sum, item) => sum + Number(item.amount || (Number(item.quantity || 0) * Number(item.rate || 0)) || 0), 0);

      return `<article class="invoice-print-sheet" style="width:100%;max-width:840px;margin:0 auto;border:1px solid #222;font-family:Arial,sans-serif;font-size:11px;color:#111;background:#fff;">
        <table style="width:100%;border-collapse:collapse;">
          <tr>
            <td style="width:24%;padding:10px 12px;text-align:center;vertical-align:middle;border-bottom:1px solid #222;">
              <img src="${esc(logoUrl)}" style="width:74px;height:74px;object-fit:contain;" alt="TechMigos" onerror="this.style.display='none'" />
            </td>
            <td style="width:52%;padding:10px 8px;text-align:center;vertical-align:middle;border-bottom:1px solid #222;">
              <div style="font-size:18px;font-weight:900;">TechMigos</div>
              <div style="font-size:10px;color:#333;margin-top:2px;">Hyderabad, Hyderabad, Telangana, 500097</div>
              <div style="font-size:10px;color:#333;margin-top:4px;"><strong>Mobile:</strong> 9959703547 &nbsp;&nbsp; <strong>Email:</strong> info@techmigos.com</div>
            </td>
            <td style="width:24%;border-bottom:1px solid #222;"></td>
          </tr>
        </table>
        <table style="width:100%;border-collapse:collapse;margin-top:0;">
          <tr>
            <td style="border-bottom:1px solid #222;border-right:1px solid #222;padding:9px 12px;width:50%;vertical-align:top;">
              <div style="font-size:11px;font-weight:900;text-transform:uppercase;">Bill To</div>
              <div style="font-size:13px;font-weight:900;margin-top:3px;">${esc(billName)}${billCompany && billCompany !== billName ? `<br><span style="font-size:11px;font-weight:600;">${esc(billCompany)}</span>` : ''}</div>
              ${billPhone ? `<div style="font-size:10px;margin-top:2px;"><strong>Mobile:</strong> ${esc(billPhone)}</div>` : ''}
              ${billEmail ? `<div style="font-size:10px;"><strong>Email:</strong> ${esc(billEmail)}</div>` : ''}
            </td>
            <td style="border-bottom:1px solid #222;padding:9px 12px;width:25%;vertical-align:top;text-align:center;"><strong>Invoice No.</strong><br>${esc(invoiceNumber)}</td>
            <td style="border-bottom:1px solid #222;padding:9px 12px;width:25%;vertical-align:top;text-align:center;"><strong>Invoice Date</strong><br>${esc(inv.invoice_date || '')}</td>
          </tr>
        </table>
        <table style="width:100%;border-collapse:collapse;margin-top:0;">
          <thead>
            <tr style="background:#f3f4f6;">
              <th style="border:1px solid #ccc;padding:6px 8px;text-align:center;width:40px;">S.NO.</th>
              <th style="border:1px solid #ccc;padding:6px 8px;text-align:center;">SERVICES</th>
              <th style="border:1px solid #ccc;padding:6px 8px;text-align:center;width:90px;">QTY.</th>
              <th style="border:1px solid #ccc;padding:6px 8px;text-align:center;width:70px;">RATE</th>
              <th style="border:1px solid #ccc;padding:6px 8px;text-align:center;width:80px;">AMOUNT</th>
            </tr>
          </thead>
          <tbody>
            ${itemRows}
            <tr style="height:30px;"><td colspan="5" style="border-left:1px solid #ccc;border-right:1px solid #ccc;"></td></tr>
          </tbody>
          <tfoot>
            <tr style="background:#f3f4f6;">
              <td colspan="2" style="border:1px solid #ccc;padding:8px;text-align:right;font-weight:900;">TOTAL</td>
              <td style="border:1px solid #ccc;padding:8px;text-align:center;font-weight:900;">${items.reduce((s, x) => s + Number(x.quantity || 0), 0)}</td>
              <td style="border:1px solid #ccc;padding:8px;"></td>
              <td style="border:1px solid #ccc;padding:8px;text-align:right;font-weight:900;">${fmt(total)}</td>
            </tr>
          </tfoot>
        </table>
        <div style="padding:7px 12px;text-align:right;font-size:10px;line-height:1.5;">
          <div><strong>Subtotal:</strong> ${fmt(subtotal)}</div>
          <div style="font-size:11px;font-weight:900;"><strong>Grand Total:</strong> ${fmt(total)}</div>
        </div>
        <table style="width:100%;border-collapse:collapse;margin-top:0;">
          <tr>
            <td style="border-top:1px solid #222;border-bottom:1px solid #222;border-right:1px solid #222;padding:8px 12px;width:50%;"><strong>Received Amount: ${fmt(received)}</strong></td>
            <td style="border-top:1px solid #222;border-bottom:1px solid #222;padding:8px 12px;width:50%;"><strong>Balance Amount: ${fmt(balance)}</strong></td>
          </tr>
        </table>
        ${inv.notes ? `<div style="border-bottom:1px solid #222;padding:8px 12px;font-size:10px;"><strong>Notes:</strong> ${esc(inv.notes)}</div>` : ''}
        <table style="width:100%;border-collapse:collapse;margin-top:0;">
          <tr>
            <td style="border-right:1px solid #222;padding:10px 12px;vertical-align:top;width:50%;min-height:108px;">
              ${inv.terms ? `<strong>Terms and Conditions</strong><div style="margin-top:4px;font-size:10px;white-space:pre-line;">${esc(inv.terms)}</div>` : ''}
            </td>
            <td style="border-right:1px solid #222;padding:10px 8px;text-align:center;vertical-align:middle;width:22%;">
              <a href="${esc(upiPaymentUri)}" style="display:inline-block;line-height:0;" aria-label="Pay invoice ${esc(invoiceNumber)} using UPI">
                <img src="${esc(upiQrUrl)}" style="width:92px;height:92px;object-fit:contain;" alt="UPI payment QR code for invoice ${esc(invoiceNumber)}" />
              </a>
              <div style="margin-top:4px;font-size:9px;font-weight:900;">Scan or tap to pay</div>
              <div style="margin-top:2px;font-size:8px;word-break:break-word;">${esc(UPI_ID)} · ${fmt(balance)}</div>
              ${inv.payment_instructions ? `<div style="margin-top:4px;font-size:8px;color:#555;">${esc(inv.payment_instructions)}</div>` : ''}
            </td>
            <td style="padding:10px 8px;text-align:center;vertical-align:bottom;width:28%;">
              ${signatureUrl ? `<img src="${esc(signatureUrl)}" style="max-height:52px;max-width:140px;object-fit:contain;" alt="Signature" onerror="this.style.display='none'" />` : '<div style="height:44px;"></div>'}
              <div style="border-top:1px solid #555;padding-top:4px;font-size:10px;font-weight:700;">Authorised Signatory For<br>TechMigos</div>
            </td>
          </tr>
        </table>
      </article>`;
    }

    function downloadInvoicePdf(id) {
      const markup = invoicePreview?.innerHTML || '';
      if (!markup) return setStatus('Invoice preview is not ready yet.', 'error');
      return printInvoiceMarkup(markup, getInvoicePrintName(id || 'invoice'));
    }

    async function openConversation(id) {
      state.activeTicketId = id;
      const ticket = state.tickets.find((item) => String(item.id) === String(id));
      conversationTitle.textContent = ticket ? ticket.subject : 'Ticket conversation';
      conversationPanel.classList.remove('hidden');
      const result = await portal(`/api/portal/client/tickets/${id}/messages`);
      conversationMessages.innerHTML = (result.messages || []).map((message) => `
        <article class="rounded-md border ${message.author_role === 'client' ? 'border-primary-100 bg-primary-50' : 'border-slate-200 bg-slate-50'} p-3">
          <p class="text-sm font-bold text-slate-950">${escapeHtml(message.author_name || message.author_role)}</p>
          <p class="mt-1 text-sm text-slate-600">${escapeHtml(message.body)}</p>
          <p class="mt-2 text-xs text-slate-400">${escapeHtml(message.created_at || '')}</p>
        </article>
      `).join('') || '<p class="rounded-md border border-dashed border-slate-200 p-4 text-sm text-slate-500">No replies yet.</p>';
    }

    async function loadOverview(showStatus = true) {
      if (showStatus) setStatus('Loading portal data...');
      const data = await portal('/api/portal/client/overview');
      state.client = data.client;
      state.projects = data.projects || [];
      state.invoices = data.invoices || [];
      state.tickets = data.tickets || [];
      userEl.textContent = `${data.client?.name || 'Client'} workspace`;
      renderKpis();
      renderProjects();
      renderInvoices();
      renderTickets();
      if (showStatus) setStatus('Workspace loaded.', 'success');
    }

    async function boot() {
      try {
        const { data: { session } } = await window.tmSupabase.auth.getSession();
        if (!session) return logout();
        const me = await portal('/api/portal/me');
        if (me.destination !== '/client') {
          location.replace(me.destination);
          return;
        }
        await loadOverview();
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'Could not load portal.', 'error');
        setTimeout(logout, 1200);
      }
    }

    ticketForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const body = Object.fromEntries(new FormData(ticketForm).entries());
      if (!body.project_id) delete body.project_id;
      else body.project_id = Number(body.project_id);
      try {
        await portal('/api/portal/client/tickets', { method: 'POST', body: JSON.stringify(body) });
        ticketForm.reset();
        setStatus('Support ticket created.', 'success');
        await loadOverview(false);
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'Could not create support ticket.', 'error');
      }
    });

    messageForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!state.activeTicketId) return;
      const body = Object.fromEntries(new FormData(messageForm).entries());
      try {
        await portal(`/api/portal/client/tickets/${state.activeTicketId}/messages`, { method: 'POST', body: JSON.stringify(body) });
        messageForm.reset();
        await openConversation(state.activeTicketId);
        await loadOverview(false);
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'Could not send reply.', 'error');
      }
    });

    document.getElementById('logout-button')?.addEventListener('click', logout);
    document.getElementById('close-invoice')?.addEventListener('click', () => invoiceModal.classList.add('hidden'));
    document.getElementById('print-invoice')?.addEventListener('click', () => {
      const markup = invoicePreview?.innerHTML || '';
      if (markup) printInvoiceMarkup(markup, getInvoicePrintName(invoicePreview.dataset.invoiceNumber || 'invoice'));
    });
    document.getElementById('download-pdf-invoice')?.addEventListener('click', () => {
      downloadInvoicePdf(invoicePreview.dataset.invoiceNumber || 'invoice');
    });

    boot();
  </script>
</BaseLayout>
