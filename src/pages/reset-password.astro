---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Reset portal password | TechMigos" noIndex={true}>
  <main class="min-h-screen bg-slate-100 px-4 py-16">
    <section class="mx-auto max-w-md rounded-2xl border border-slate-200 bg-white p-7 shadow-sm sm:p-9">
      <a href="/login" class="text-sm font-bold text-emerald-700 hover:text-emerald-900">← Back to sign in</a>
      <p class="mt-8 text-xs font-black uppercase tracking-[0.16em] text-emerald-700">Account recovery</p>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-950">Reset your password</h1>
      <p class="mt-2 text-sm leading-6 text-slate-500">Enter the work email linked to your TechMigos account.</p>
      <form id="reset-password-form" class="mt-7 space-y-5">
        <label class="block"><span class="form-label">Work email</span><input class="form-input form-control" name="email" type="email" required autocomplete="email" /></label>
        <button id="reset-password-button" class="btn-primary w-full justify-center" type="submit">Send reset link</button>
        <p id="reset-password-status" class="min-h-[1.25rem] text-sm text-slate-600" role="status" aria-live="polite"></p>
      </form>
    </section>
  </main>
  <script is:inline>
    const form = document.getElementById('reset-password-form');
    const status = document.getElementById('reset-password-status');
    const button = document.getElementById('reset-password-button');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      status.textContent = 'Sending reset link...';
      try {
        const email = String(new FormData(form).get('email') || '').trim();
        const { error } = await window.tmSupabase.auth.resetPasswordForEmail(email, { redirectTo: `${window.location.origin}/change-password` });
        if (error) throw error;
        status.textContent = 'If that email is registered, a reset link has been sent.';
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Could not send a reset link.';
        status.classList.add('text-rose-600');
      } finally {
        button.disabled = false;
      }
    });
  </script>
</BaseLayout>
