---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin Login" description="Company admin and CRM access for TechMigos." noIndex={true}>
  <section class="min-h-screen pt-32 pb-20 bg-gray-50">
    <div class="container-custom max-w-md">
      <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Company CRM Login</h1>
        <p class="text-gray-500 mb-8">Sign in with your assigned account to manage content, leads, and users.</p>

        <form id="login-form" class="space-y-5">
          <div>
            <label for="email" class="form-label">Email</label>
            <input id="email" name="email" type="email" required class="form-control form-control--muted" autocomplete="username" />
          </div>

          <div>
            <label for="password" class="form-label">Password</label>
            <input id="password" name="password" type="password" required class="form-control form-control--muted" autocomplete="current-password" />
          </div>

          <p id="error" class="form-error hidden" role="alert" aria-live="assertive"></p>

          <button id="login-submit" type="submit" class="btn-primary w-full justify-center">Login</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('login-form');
  const error = document.getElementById('error');
  const submitBtn = document.getElementById('login-submit');

  async function tryRedirectIfAuthenticated() {
    try {
      const response = await (window as any).techmigosApiFetch('/api/admin/auth/me');
      if (response.ok) {
        window.location.href = '/admin/dashboard';
      }
    } catch {
      // no-op
    }
  }

  tryRedirectIfAuthenticated();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    error?.classList.add('hidden');

    const formData = new FormData(form as HTMLFormElement);
    const email = String(formData.get('email') || '');
    const password = String(formData.get('password') || '');

    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Signing in...';
    }

    try {
      const response = await (window as any).techmigosApiFetch('/api/admin/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ email, password }),
      });

      const result = await response.json().catch(() => ({ ok: false, error: 'Unexpected server response.' }));

      if (!response.ok || !result.ok) {
        error?.classList.remove('hidden');
        if (error) {
          error.textContent = result.error || (response.status === 404
            ? 'Admin login API is unavailable in this deployment.'
            : 'Invalid username or password.');
        }
        return;
      }

      if (typeof (window as any).techmigosSetAdminSession === 'function') {
        (window as any).techmigosSetAdminSession(result.data?.session);
      }

      window.location.href = '/admin/dashboard';
    } catch {
      error?.classList.remove('hidden');
      if (error) error.textContent = 'Unable to login right now. Please try again.';
    } finally {
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Login';
      }
    }
  });
</script>
