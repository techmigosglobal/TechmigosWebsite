---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAuthenticated } from '../../lib/adminAuth';
export const prerender = false;

if (isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/dashboard');
}
---

<BaseLayout title="Admin Login" description="Company admin access for TechMigos content management.">
  <section class="min-h-screen pt-32 pb-20 bg-gray-50">
    <div class="container-custom max-w-md">
      <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Company Login</h1>
        <p class="text-gray-500 mb-8">Use your company username and password to manage website content.</p>

        <form id="login-form" class="space-y-5">
          <div>
            <label for="username" class="form-label">Username</label>
            <input id="username" name="username" type="text" required class="form-control form-control--muted" autocomplete="username" />
          </div>

          <div>
            <label for="password" class="form-label">Password</label>
            <input id="password" name="password" type="password" required class="form-control form-control--muted" autocomplete="current-password" />
          </div>

          <p id="error" class="form-error hidden"></p>

          <button type="submit" class="btn-primary w-full justify-center">Login</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('login-form');
  const error = document.getElementById('error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const formData = new FormData(form as HTMLFormElement);
    const username = String(formData.get('username') || '');
    const password = String(formData.get('password') || '');

    const response = await fetch('/api/admin/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, password }),
    });

    if (!response.ok) {
      error?.classList.remove('hidden');
      if (error) error.textContent = 'Invalid username or password.';
      return;
    }

    window.location.href = '/admin/dashboard';
  });
</script>
