---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin CRM Dashboard" description="Manage testimonials, portfolio content, and leads.">
  <section class="pt-32 pb-20 bg-gray-50 min-h-screen">
    <div class="container-custom max-w-7xl space-y-6">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900">CRM Dashboard</h1>
          <p id="session-meta" class="text-gray-500 mt-2">Checking your session...</p>
        </div>
        <button id="logout-btn" class="px-5 py-2.5 rounded-xl border border-gray-300 text-gray-700 hover:bg-gray-100 transition-colors">Logout</button>
      </div>

      <div class="flex flex-wrap gap-2" id="tabs">
        <button class="crm-tab active" data-tab="content">Content</button>
        <button class="crm-tab" data-tab="leads">Leads</button>
        <button class="crm-tab" data-tab="users">Users</button>
      </div>

      <p id="global-status" class="text-sm font-medium"></p>

      <section id="tab-content" class="crm-panel space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-bold text-gray-900">Testimonials</h2>
              <button id="testimonial-new" class="btn-ghost text-sm">New</button>
            </div>
            <div class="max-h-72 overflow-auto border border-gray-100 rounded-xl mb-4">
              <table class="w-full text-sm">
                <thead class="bg-gray-50 text-left text-gray-500">
                  <tr>
                    <th class="px-3 py-2">Name</th>
                    <th class="px-3 py-2">Company</th>
                    <th class="px-3 py-2">Active</th>
                  </tr>
                </thead>
                <tbody id="testimonial-list"></tbody>
              </table>
            </div>
            <form id="testimonial-form" class="space-y-3">
              <input type="hidden" id="t-id" />
              <div>
                <label class="form-label" for="t-quote">Quote</label>
                <textarea id="t-quote" class="form-control form-control--muted form-textarea" rows="3" required></textarea>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                  <label class="form-label" for="t-name">Name</label>
                  <input id="t-name" class="form-control form-control--muted" required />
                </div>
                <div>
                  <label class="form-label" for="t-role">Role</label>
                  <input id="t-role" class="form-control form-control--muted" required />
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                  <label class="form-label" for="t-company">Company</label>
                  <input id="t-company" class="form-control form-control--muted" required />
                </div>
                <div>
                  <label class="form-label" for="t-result">Result</label>
                  <input id="t-result" class="form-control form-control--muted" required />
                </div>
              </div>
              <div>
                <label class="form-label" for="t-avatar">Avatar URL</label>
                <input id="t-avatar" class="form-control form-control--muted" />
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                  <label class="form-label" for="t-sort">Sort Order</label>
                  <input id="t-sort" type="number" class="form-control form-control--muted" value="0" />
                </div>
                <label class="inline-flex items-center gap-2 mt-8">
                  <input id="t-active" type="checkbox" checked />
                  <span class="text-sm text-gray-700">Active</span>
                </label>
              </div>
              <div class="flex gap-2">
                <button type="submit" class="btn-primary text-sm">Save Testimonial</button>
                <button type="button" id="testimonial-delete" class="px-4 py-2 rounded-lg border border-red-300 text-red-600 text-sm hidden">Delete</button>
              </div>
            </form>
          </div>

          <div class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-bold text-gray-900">Portfolio Projects</h2>
              <button id="portfolio-new" class="btn-ghost text-sm">New</button>
            </div>
            <div class="max-h-72 overflow-auto border border-gray-100 rounded-xl mb-4">
              <table class="w-full text-sm">
                <thead class="bg-gray-50 text-left text-gray-500">
                  <tr>
                    <th class="px-3 py-2">Title</th>
                    <th class="px-3 py-2">Category</th>
                    <th class="px-3 py-2">Active</th>
                  </tr>
                </thead>
                <tbody id="portfolio-list"></tbody>
              </table>
            </div>
            <form id="portfolio-form" class="space-y-3">
              <input type="hidden" id="p-id" />
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                  <label class="form-label" for="p-title">Title</label>
                  <input id="p-title" class="form-control form-control--muted" required />
                </div>
                <div>
                  <label class="form-label" for="p-slug">Slug</label>
                  <input id="p-slug" class="form-control form-control--muted" required />
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <div>
                  <label class="form-label" for="p-category">Category</label>
                  <input id="p-category" class="form-control form-control--muted" required />
                </div>
                <div>
                  <label class="form-label" for="p-emoji">Emoji</label>
                  <input id="p-emoji" class="form-control form-control--muted" />
                </div>
                <div>
                  <label class="form-label" for="p-result">Result</label>
                  <input id="p-result" class="form-control form-control--muted" required />
                </div>
              </div>
              <div>
                <label class="form-label" for="p-tags">Tags (comma-separated)</label>
                <input id="p-tags" class="form-control form-control--muted" />
              </div>
              <div>
                <label class="form-label" for="p-image">Image URL</label>
                <input id="p-image" class="form-control form-control--muted" />
              </div>
              <div>
                <label class="form-label" for="p-description">Description</label>
                <textarea id="p-description" class="form-control form-control--muted form-textarea" rows="2" required></textarea>
              </div>
              <div>
                <label class="form-label" for="p-overview">Overview</label>
                <textarea id="p-overview" class="form-control form-control--muted form-textarea" rows="2" required></textarea>
              </div>
              <div>
                <label class="form-label" for="p-challenge">Challenge</label>
                <textarea id="p-challenge" class="form-control form-control--muted form-textarea" rows="2" required></textarea>
              </div>
              <div>
                <label class="form-label" for="p-solution">Solution</label>
                <textarea id="p-solution" class="form-control form-control--muted form-textarea" rows="2" required></textarea>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <div>
                  <label class="form-label" for="p-timeline">Timeline</label>
                  <input id="p-timeline" class="form-control form-control--muted" required />
                </div>
                <div>
                  <label class="form-label" for="p-team">Team</label>
                  <input id="p-team" class="form-control form-control--muted" required />
                </div>
                <div>
                  <label class="form-label" for="p-services">Services</label>
                  <input id="p-services" class="form-control form-control--muted" required />
                </div>
              </div>
              <div>
                <label class="form-label" for="p-results">Results (one per line: metric|label)</label>
                <textarea id="p-results" class="form-control form-control--muted form-textarea" rows="3" required></textarea>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <div>
                  <label class="form-label" for="p-sort">Sort Order</label>
                  <input id="p-sort" type="number" class="form-control form-control--muted" value="0" />
                </div>
                <label class="inline-flex items-center gap-2 mt-8">
                  <input id="p-featured" type="checkbox" />
                  <span class="text-sm text-gray-700">Featured</span>
                </label>
                <label class="inline-flex items-center gap-2 mt-8">
                  <input id="p-active" type="checkbox" checked />
                  <span class="text-sm text-gray-700">Active</span>
                </label>
              </div>
              <div class="flex gap-2">
                <button type="submit" class="btn-primary text-sm">Save Project</button>
                <button type="button" id="portfolio-delete" class="px-4 py-2 rounded-lg border border-red-300 text-red-600 text-sm hidden">Delete</button>
              </div>
            </form>
          </div>
        </div>
      </section>

      <section id="tab-leads" class="crm-panel hidden space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4" id="lead-counters"></div>

        <div class="bg-white border border-gray-200 rounded-2xl p-6 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
            <select id="lead-type" class="form-control form-control--muted">
              <option value="">All Types</option>
              <option value="contact">Contact</option>
              <option value="newsletter">Newsletter</option>
              <option value="careers">Careers</option>
            </select>
            <select id="lead-status" class="form-control form-control--muted">
              <option value="">All Statuses</option>
              <option value="new">New</option>
              <option value="in_progress">In Progress</option>
              <option value="qualified">Qualified</option>
              <option value="closed">Closed</option>
            </select>
            <select id="lead-priority" class="form-control form-control--muted">
              <option value="">All Priorities</option>
              <option value="low">Low</option>
              <option value="medium">Medium</option>
              <option value="high">High</option>
            </select>
            <input id="lead-search" class="form-control form-control--muted" placeholder="Search leads" />
            <button id="lead-refresh" class="btn-primary text-sm">Refresh</button>
          </div>

          <div class="overflow-auto border border-gray-100 rounded-xl">
            <table class="w-full text-sm">
              <thead class="bg-gray-50 text-left text-gray-500">
                <tr>
                  <th class="px-3 py-2">Type</th>
                  <th class="px-3 py-2">Name / Email</th>
                  <th class="px-3 py-2">Subject</th>
                  <th class="px-3 py-2">Status</th>
                  <th class="px-3 py-2">Priority</th>
                  <th class="px-3 py-2">Created</th>
                </tr>
              </thead>
              <tbody id="lead-list"></tbody>
            </table>
          </div>
        </div>

        <div id="lead-detail" class="bg-white border border-gray-200 rounded-2xl p-6 hidden">
          <h3 class="text-xl font-bold text-gray-900 mb-3">Lead Detail</h3>
          <p id="lead-detail-meta" class="text-sm text-gray-500 mb-4"></p>
          <p id="lead-detail-text" class="text-sm text-gray-700 mb-5"></p>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-3 mb-4">
            <select id="lead-detail-status" class="form-control form-control--muted">
              <option value="new">New</option>
              <option value="in_progress">In Progress</option>
              <option value="qualified">Qualified</option>
              <option value="closed">Closed</option>
            </select>
            <select id="lead-detail-priority" class="form-control form-control--muted">
              <option value="low">Low</option>
              <option value="medium">Medium</option>
              <option value="high">High</option>
            </select>
            <select id="lead-detail-assignee" class="form-control form-control--muted"></select>
            <input id="lead-detail-followup" type="datetime-local" class="form-control form-control--muted" />
          </div>

          <button id="lead-update" class="btn-primary text-sm mb-6">Save Lead Status</button>

          <div class="space-y-3">
            <h4 class="font-semibold text-gray-900">Notes</h4>
            <div id="lead-notes" class="space-y-2"></div>
            <div class="flex gap-2">
              <input id="lead-note-input" class="form-control form-control--muted" placeholder="Add note" />
              <button id="lead-note-add" class="btn-primary text-sm">Add</button>
            </div>
          </div>
        </div>
      </section>

      <section id="tab-users" class="crm-panel hidden space-y-6">
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Create User</h2>
          <form id="user-create-form" class="grid grid-cols-1 md:grid-cols-5 gap-3">
            <input id="u-username" class="form-control form-control--muted" placeholder="Username" required />
            <input id="u-email" type="email" class="form-control form-control--muted" placeholder="Email" required />
            <input id="u-fullname" class="form-control form-control--muted" placeholder="Full name" required />
            <select id="u-role" class="form-control form-control--muted">
              <option value="sales">Sales</option>
              <option value="editor">Editor</option>
              <option value="admin">Admin</option>
            </select>
            <input id="u-password" type="password" class="form-control form-control--muted" placeholder="Password" required />
            <button type="submit" class="btn-primary text-sm md:col-span-5">Create User</button>
          </form>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Users</h2>
          <div class="overflow-auto border border-gray-100 rounded-xl">
            <table class="w-full text-sm">
              <thead class="bg-gray-50 text-left text-gray-500">
                <tr>
                  <th class="px-3 py-2">Username</th>
                  <th class="px-3 py-2">Role</th>
                  <th class="px-3 py-2">Email</th>
                  <th class="px-3 py-2">Active</th>
                  <th class="px-3 py-2">Action</th>
                </tr>
              </thead>
              <tbody id="user-list"></tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .crm-tab {
    @apply px-4 py-2 rounded-lg border border-gray-200 bg-white text-sm font-medium text-gray-700;
  }
  .crm-tab.active {
    @apply text-white border-transparent;
    background: linear-gradient(135deg, #4f46e5, #06b6d4);
  }
</style>

<script>
  const state = {
    me: null,
    testimonials: [],
    portfolio: [],
    leads: [],
    users: [],
    selectedLead: null,
  };

  const tabButtons = Array.from(document.querySelectorAll('.crm-tab'));
  const tabPanels = {
    content: document.getElementById('tab-content'),
    leads: document.getElementById('tab-leads'),
    users: document.getElementById('tab-users'),
  };

  const globalStatus = document.getElementById('global-status');
  const sessionMeta = document.getElementById('session-meta');

  function setStatus(message, type = 'error') {
    if (!globalStatus) return;
    globalStatus.textContent = message;
    globalStatus.className = `text-sm font-medium ${type === 'success' ? 'text-green-600' : 'text-red-600'}`;
  }

  function clearStatus() {
    if (!globalStatus) return;
    globalStatus.textContent = '';
    globalStatus.className = 'text-sm font-medium';
  }

  function showTab(tab) {
    tabButtons.forEach((btn) => {
      btn.classList.toggle('active', btn.getAttribute('data-tab') === tab);
    });

    Object.entries(tabPanels).forEach(([key, panel]) => {
      if (!panel) return;
      panel.classList.toggle('hidden', key !== tab);
    });
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab') || 'content';
      if (tab === 'users' && !canAccessUsers()) return;
      if (tab === 'leads' && !canAccessLeads()) return;
      if (tab === 'content' && !canAccessContent()) return;
      showTab(tab);
    });
  });

  class ApiError extends Error {
    constructor(message, status) {
      super(message);
      this.name = 'ApiError';
      this.status = Number(status || 0);
    }
  }

  function isUnauthorizedError(error) {
    return error instanceof ApiError && error.status === 401;
  }

  function isForbiddenError(error) {
    return error instanceof ApiError && error.status === 403;
  }

  function canAccessContent() {
    return state.me?.role === 'admin' || state.me?.role === 'editor';
  }

  function canAccessLeads() {
    return state.me?.role === 'admin' || state.me?.role === 'sales';
  }

  function canAccessUsers() {
    return state.me?.role === 'admin';
  }

  async function api(path, options = {}) {
    const response = await fetch(path, {
      credentials: 'include',
      headers: {
        'Content-Type': 'application/json',
        ...(options.headers || {}),
      },
      ...options,
    });

    const body = await response.json().catch(() => ({ ok: false, error: 'Invalid server response.' }));

    if (!response.ok || !body.ok) {
      const message = body.error || `Request failed with status ${response.status}`;
      throw new ApiError(message, response.status);
    }

    return body.data || {};
  }

  function parseResultsText(value) {
    return String(value || '')
      .split('\n')
      .map((line) => line.trim())
      .filter(Boolean)
      .map((line) => {
        const [metric, ...rest] = line.split('|');
        return {
          metric: String(metric || '').trim(),
          label: String(rest.join('|') || '').trim(),
        };
      })
      .filter((item) => item.metric && item.label);
  }

  function resultsToText(results) {
    if (!Array.isArray(results)) return '';
    return results.map((item) => `${item.metric || ''}|${item.label || ''}`).join('\n');
  }

  function populateAssigneeSelect() {
    const assignee = document.getElementById('lead-detail-assignee');
    if (!(assignee instanceof HTMLSelectElement)) return;

    assignee.innerHTML = '<option value="">Unassigned</option>';
    state.users.forEach((user) => {
      if (!user.isActive) return;
      const opt = document.createElement('option');
      opt.value = String(user.id);
      opt.textContent = `${user.fullName || user.username} (${user.role})`;
      assignee.appendChild(opt);
    });
  }

  function renderTestimonials() {
    const list = document.getElementById('testimonial-list');
    if (!list) return;

    list.innerHTML = '';
    state.testimonials.forEach((item) => {
      const row = document.createElement('tr');
      row.className = 'border-t border-gray-100 hover:bg-gray-50 cursor-pointer';
      row.innerHTML = `
        <td class="px-3 py-2 font-medium text-gray-900">${item.name}</td>
        <td class="px-3 py-2 text-gray-600">${item.company}</td>
        <td class="px-3 py-2 text-gray-600">${item.isActive ? 'Yes' : 'No'}</td>
      `;
      row.addEventListener('click', () => fillTestimonialForm(item));
      list.appendChild(row);
    });
  }

  function fillTestimonialForm(item = null) {
    (document.getElementById('t-id')).value = item?.id ? String(item.id) : '';
    (document.getElementById('t-quote')).value = item?.quote || '';
    (document.getElementById('t-name')).value = item?.name || '';
    (document.getElementById('t-role')).value = item?.role || '';
    (document.getElementById('t-company')).value = item?.company || '';
    (document.getElementById('t-result')).value = item?.result || '';
    (document.getElementById('t-avatar')).value = item?.avatar || '';
    (document.getElementById('t-sort')).value = String(item?.sortOrder || 0);
    (document.getElementById('t-active')).checked = item ? Boolean(item.isActive) : true;

    const deleteBtn = document.getElementById('testimonial-delete');
    if (deleteBtn) {
      deleteBtn.classList.toggle('hidden', !item?.id);
    }
  }

  function renderPortfolio() {
    const list = document.getElementById('portfolio-list');
    if (!list) return;

    list.innerHTML = '';
    state.portfolio.forEach((item) => {
      const row = document.createElement('tr');
      row.className = 'border-t border-gray-100 hover:bg-gray-50 cursor-pointer';
      row.innerHTML = `
        <td class="px-3 py-2 font-medium text-gray-900">${item.title}</td>
        <td class="px-3 py-2 text-gray-600">${item.category}</td>
        <td class="px-3 py-2 text-gray-600">${item.isActive ? 'Yes' : 'No'}</td>
      `;
      row.addEventListener('click', () => fillPortfolioForm(item));
      list.appendChild(row);
    });
  }

  function fillPortfolioForm(item = null) {
    (document.getElementById('p-id')).value = item?.id ? String(item.id) : '';
    (document.getElementById('p-title')).value = item?.title || '';
    (document.getElementById('p-slug')).value = item?.slug || '';
    (document.getElementById('p-category')).value = item?.category || '';
    (document.getElementById('p-emoji')).value = item?.emoji || '';
    (document.getElementById('p-tags')).value = Array.isArray(item?.tags) ? item.tags.join(', ') : '';
    (document.getElementById('p-image')).value = item?.image || '';
    (document.getElementById('p-description')).value = item?.description || '';
    (document.getElementById('p-result')).value = item?.result || '';
    (document.getElementById('p-overview')).value = item?.overview || '';
    (document.getElementById('p-challenge')).value = item?.challenge || '';
    (document.getElementById('p-solution')).value = item?.solution || '';
    (document.getElementById('p-timeline')).value = item?.timeline || '';
    (document.getElementById('p-team')).value = item?.team || '';
    (document.getElementById('p-services')).value = item?.services || '';
    (document.getElementById('p-results')).value = resultsToText(item?.results || []);
    (document.getElementById('p-sort')).value = String(item?.sortOrder || 0);
    (document.getElementById('p-featured')).checked = Boolean(item?.featured);
    (document.getElementById('p-active')).checked = item ? Boolean(item.isActive) : true;

    const deleteBtn = document.getElementById('portfolio-delete');
    if (deleteBtn) {
      deleteBtn.classList.toggle('hidden', !item?.id);
    }
  }

  function renderLeads() {
    const list = document.getElementById('lead-list');
    if (!list) return;

    list.innerHTML = '';
    state.leads.forEach((lead) => {
      const row = document.createElement('tr');
      row.className = 'border-t border-gray-100 hover:bg-gray-50 cursor-pointer';
      row.innerHTML = `
        <td class="px-3 py-2 text-gray-700">${lead.leadType}</td>
        <td class="px-3 py-2 text-gray-700">${lead.name || '-'}<br/><span class="text-xs text-gray-500">${lead.email || ''}</span></td>
        <td class="px-3 py-2 text-gray-700">${lead.subject || '-'}</td>
        <td class="px-3 py-2 text-gray-700">${lead.status}</td>
        <td class="px-3 py-2 text-gray-700">${lead.priority}</td>
        <td class="px-3 py-2 text-gray-500">${lead.createdAt || ''}</td>
      `;
      row.addEventListener('click', () => openLeadDetail(lead));
      list.appendChild(row);
    });
  }

  function renderLeadCounters(counters) {
    const wrap = document.getElementById('lead-counters');
    if (!wrap || !counters) return;

    const items = [
      ['New Today', counters.newToday || 0],
      ['Pending Followups', counters.pendingFollowups || 0],
      ['Contact Leads', counters.bySource?.contact || 0],
      ['Careers Leads', counters.bySource?.careers || 0],
    ];

    wrap.innerHTML = items
      .map(([label, value]) => `
        <div class="bg-white border border-gray-200 rounded-xl p-4">
          <p class="text-xs text-gray-500 uppercase tracking-wide">${label}</p>
          <p class="text-2xl font-bold text-gray-900 mt-1">${value}</p>
        </div>
      `)
      .join('');
  }

  async function openLeadDetail(lead) {
    try {
      const data = await api(`/api/admin/leads/${lead.leadType}/${lead.id}`);
      state.selectedLead = data.item;

      const panel = document.getElementById('lead-detail');
      if (panel) panel.classList.remove('hidden');

      const meta = document.getElementById('lead-detail-meta');
      const text = document.getElementById('lead-detail-text');
      if (meta) meta.textContent = `${data.item.leadType.toUpperCase()} | ${data.item.email || ''}`;
      if (text) text.textContent = data.item.details || data.item.subject || 'No details.';

      (document.getElementById('lead-detail-status')).value = data.item.status || 'new';
      (document.getElementById('lead-detail-priority')).value = data.item.priority || 'medium';
      (document.getElementById('lead-detail-assignee')).value = data.item.assignedTo ? String(data.item.assignedTo) : '';
      (document.getElementById('lead-detail-followup')).value = data.item.nextFollowupAt
        ? String(data.item.nextFollowupAt).replace(' ', 'T').slice(0, 16)
        : '';

      const notesWrap = document.getElementById('lead-notes');
      if (notesWrap) {
        notesWrap.innerHTML = (data.item.notes || [])
          .map((note) => `<div class="p-2 rounded-lg bg-gray-50 border border-gray-100"><p class="text-sm text-gray-700">${note.note}</p><p class="text-xs text-gray-500 mt-1">${note.author?.fullName || note.author?.username || 'Unknown'} • ${note.createdAt || ''}</p></div>`)
          .join('');
      }
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Failed to load lead detail.');
    }
  }

  function renderUsers() {
    const list = document.getElementById('user-list');
    if (!list) return;

    list.innerHTML = '';
    state.users.forEach((user) => {
      const row = document.createElement('tr');
      row.className = 'border-t border-gray-100';
      row.innerHTML = `
        <td class="px-3 py-2 text-gray-800">${user.username}</td>
        <td class="px-3 py-2 text-gray-700">${user.role}</td>
        <td class="px-3 py-2 text-gray-700">${user.email}</td>
        <td class="px-3 py-2 text-gray-700">${user.isActive ? 'Yes' : 'No'}</td>
        <td class="px-3 py-2 text-gray-700">
          <button data-user-id="${user.id}" data-active="${user.isActive ? '1' : '0'}" class="user-toggle text-sm px-3 py-1 rounded border border-gray-300 hover:bg-gray-100">${user.isActive ? 'Deactivate' : 'Activate'}</button>
        </td>
      `;
      list.appendChild(row);
    });

    Array.from(document.querySelectorAll('.user-toggle')).forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = Number(btn.getAttribute('data-user-id') || '0');
        const active = btn.getAttribute('data-active') === '1';
        try {
          await api(`/api/admin/users/${id}`, {
            method: 'PATCH',
            body: JSON.stringify({ isActive: !active }),
          });
          await loadUsers();
          setStatus('User status updated.', 'success');
        } catch (error) {
          setStatus(error instanceof Error ? error.message : 'Failed to update user status.');
        }
      });
    });
  }

  async function loadSession() {
    const data = await api('/api/admin/auth/me');
    state.me = data.user;

    if (sessionMeta) {
      sessionMeta.textContent = `Logged in as ${data.user.fullName || data.user.username} (${data.user.role})`;
    }

    const contentTab = tabButtons.find((btn) => btn.getAttribute('data-tab') === 'content');
    const leadsTab = tabButtons.find((btn) => btn.getAttribute('data-tab') === 'leads');
    const usersTab = tabButtons.find((btn) => btn.getAttribute('data-tab') === 'users');

    if (contentTab) contentTab.classList.toggle('hidden', !canAccessContent());
    if (leadsTab) leadsTab.classList.toggle('hidden', !canAccessLeads());
    if (usersTab) usersTab.classList.toggle('hidden', !canAccessUsers());

    if (tabPanels.content) tabPanels.content.classList.toggle('hidden', !canAccessContent());
    if (tabPanels.leads) tabPanels.leads.classList.toggle('hidden', !canAccessLeads());
    if (tabPanels.users) tabPanels.users.classList.toggle('hidden', !canAccessUsers());

    if (canAccessContent()) {
      showTab('content');
    } else if (canAccessLeads()) {
      showTab('leads');
    } else if (canAccessUsers()) {
      showTab('users');
    }
  }

  async function loadTestimonials() {
    const data = await api('/api/admin/testimonials');
    state.testimonials = data.items || [];
    renderTestimonials();
    fillTestimonialForm();
  }

  async function loadPortfolio() {
    const data = await api('/api/admin/portfolio');
    state.portfolio = data.items || [];
    renderPortfolio();
    fillPortfolioForm();
  }

  async function loadLeads() {
    const params = new URLSearchParams({
      type: String((document.getElementById('lead-type')).value || ''),
      status: String((document.getElementById('lead-status')).value || ''),
      priority: String((document.getElementById('lead-priority')).value || ''),
      search: String((document.getElementById('lead-search')).value || ''),
      limit: '100',
      offset: '0',
    });

    const data = await api(`/api/admin/leads?${params.toString()}`);
    state.leads = data.items || [];
    renderLeads();
    renderLeadCounters(data.counters || {});
  }

  async function loadUsers() {
    if (state.me?.role !== 'admin') return;
    const data = await api('/api/admin/users');
    state.users = data.items || [];
    renderUsers();
    populateAssigneeSelect();
  }

  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    try {
      await api('/api/admin/auth/logout', { method: 'POST' });
    } finally {
      window.location.href = '/admin/login';
    }
  });

  document.getElementById('testimonial-new')?.addEventListener('click', () => fillTestimonialForm());
  document.getElementById('portfolio-new')?.addEventListener('click', () => fillPortfolioForm());

  document.getElementById('testimonial-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearStatus();

    const id = Number((document.getElementById('t-id')).value || '0');
    const payload = {
      quote: (document.getElementById('t-quote')).value,
      name: (document.getElementById('t-name')).value,
      role: (document.getElementById('t-role')).value,
      company: (document.getElementById('t-company')).value,
      result: (document.getElementById('t-result')).value,
      avatar: (document.getElementById('t-avatar')).value,
      sortOrder: Number((document.getElementById('t-sort')).value || '0'),
      isActive: Boolean((document.getElementById('t-active')).checked),
    };

    try {
      if (id > 0) {
        await api(`/api/admin/testimonials/${id}`, { method: 'PUT', body: JSON.stringify(payload) });
      } else {
        await api('/api/admin/testimonials', { method: 'POST', body: JSON.stringify(payload) });
      }
      await loadTestimonials();
      setStatus('Testimonial saved successfully.', 'success');
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Failed to save testimonial.');
    }
  });

  document.getElementById('testimonial-delete')?.addEventListener('click', async () => {
    const id = Number((document.getElementById('t-id')).value || '0');
    if (id <= 0) return;

    try {
      await api(`/api/admin/testimonials/${id}`, { method: 'DELETE' });
      await loadTestimonials();
      setStatus('Testimonial deleted.', 'success');
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Failed to delete testimonial.');
    }
  });

  document.getElementById('portfolio-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearStatus();

    const id = Number((document.getElementById('p-id')).value || '0');
    const payload = {
      title: (document.getElementById('p-title')).value,
      slug: (document.getElementById('p-slug')).value,
      category: (document.getElementById('p-category')).value,
      emoji: (document.getElementById('p-emoji')).value,
      tags: String((document.getElementById('p-tags')).value || '').split(',').map((x) => x.trim()).filter(Boolean),
      image: (document.getElementById('p-image')).value,
      description: (document.getElementById('p-description')).value,
      result: (document.getElementById('p-result')).value,
      overview: (document.getElementById('p-overview')).value,
      challenge: (document.getElementById('p-challenge')).value,
      solution: (document.getElementById('p-solution')).value,
      timeline: (document.getElementById('p-timeline')).value,
      team: (document.getElementById('p-team')).value,
      services: (document.getElementById('p-services')).value,
      featured: Boolean((document.getElementById('p-featured')).checked),
      isActive: Boolean((document.getElementById('p-active')).checked),
      sortOrder: Number((document.getElementById('p-sort')).value || '0'),
      results: parseResultsText((document.getElementById('p-results')).value),
    };

    try {
      if (id > 0) {
        await api(`/api/admin/portfolio/${id}`, { method: 'PUT', body: JSON.stringify(payload) });
      } else {
        await api('/api/admin/portfolio', { method: 'POST', body: JSON.stringify(payload) });
      }
      await loadPortfolio();
      setStatus('Portfolio project saved successfully.', 'success');
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Failed to save portfolio project.');
    }
  });

  document.getElementById('portfolio-delete')?.addEventListener('click', async () => {
    const id = Number((document.getElementById('p-id')).value || '0');
    if (id <= 0) return;

    try {
      await api(`/api/admin/portfolio/${id}`, { method: 'DELETE' });
      await loadPortfolio();
      setStatus('Portfolio project deleted.', 'success');
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Failed to delete project.');
    }
  });

  document.getElementById('lead-refresh')?.addEventListener('click', async () => {
    try {
      await loadLeads();
      setStatus('Leads refreshed.', 'success');
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Failed to refresh leads.');
    }
  });

  document.getElementById('lead-update')?.addEventListener('click', async () => {
    if (!state.selectedLead) return;

    const payload = {
      status: (document.getElementById('lead-detail-status')).value,
      priority: (document.getElementById('lead-detail-priority')).value,
      assignedTo: (document.getElementById('lead-detail-assignee')).value || null,
      nextFollowupAt: (document.getElementById('lead-detail-followup')).value || null,
    };

    try {
      const data = await api(`/api/admin/leads/${state.selectedLead.leadType}/${state.selectedLead.id}`, {
        method: 'PATCH',
        body: JSON.stringify(payload),
      });
      state.selectedLead = data.item;
      await loadLeads();
      await openLeadDetail(state.selectedLead);
      setStatus('Lead updated.', 'success');
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Failed to update lead.');
    }
  });

  document.getElementById('lead-note-add')?.addEventListener('click', async () => {
    if (!state.selectedLead) return;

    const noteInput = document.getElementById('lead-note-input');
    const note = String(noteInput?.value || '').trim();
    if (!note) return;

    try {
      await api(`/api/admin/leads/${state.selectedLead.leadType}/${state.selectedLead.id}/notes`, {
        method: 'POST',
        body: JSON.stringify({ note }),
      });
      noteInput.value = '';
      await openLeadDetail(state.selectedLead);
      setStatus('Note added.', 'success');
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Failed to add note.');
    }
  });

  document.getElementById('user-create-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (state.me?.role !== 'admin') return;

    const payload = {
      username: (document.getElementById('u-username')).value,
      email: (document.getElementById('u-email')).value,
      fullName: (document.getElementById('u-fullname')).value,
      role: (document.getElementById('u-role')).value,
      password: (document.getElementById('u-password')).value,
      isActive: true,
    };

    try {
      await api('/api/admin/users', {
        method: 'POST',
        body: JSON.stringify(payload),
      });
      (document.getElementById('user-create-form')).reset();
      await loadUsers();
      setStatus('User created successfully.', 'success');
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Failed to create user.');
    }
  });

  async function init() {
    try {
      await loadSession();

      const loadTasks = [];
      if (canAccessContent()) {
        loadTasks.push(loadTestimonials(), loadPortfolio());
      }
      if (canAccessLeads()) {
        loadTasks.push(loadLeads());
      }
      if (canAccessUsers()) {
        loadTasks.push(loadUsers());
      }

      await Promise.all(loadTasks);
      setStatus('CRM loaded successfully.', 'success');
    } catch (error) {
      if (isUnauthorizedError(error)) {
        window.location.href = '/admin/login';
        return;
      }

      if (isForbiddenError(error)) {
        setStatus('You are logged in, but your role does not have access to this section.');
        return;
      }

      const message = error instanceof Error ? error.message : 'Failed to initialize CRM dashboard.';
      setStatus(message);
    }
  }

  init();
</script>
