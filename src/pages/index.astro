---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSiteContent } from '../lib/siteContent';
import '../styles/signal-garden.css';

const { projects } = await loadSiteContent();
const selectedWork = ['hastkala', 'focus-today', 'notiva'].flatMap((slug) =>
  projects.filter((project) => project.slug === slug)
);

const phases = [
  { label: 'Start', lines: ['Give your next', 'idea room to grow.'], title: 'Start with an idea', copy: 'Define the smallest release that makes the idea useful.' },
  { label: 'Improve', lines: ['Make the familiar', 'work better.'], title: 'Improve what exists', copy: 'Find the friction in a real workflow and test the change.' },
  { label: 'Expand', lines: ['Build for what', 'comes next.'], title: 'Expand a product', copy: 'Support new users, devices, and integrations as the product grows.' },
];

const branches = Array.from({ length: 48 }, (_, index) => {
  const angle = index * Math.PI / 24;
  const variation = Math.sin(index * 2.41);
  const color = ['#176bc2', '#dc4830', '#247b31', '#5143c8', '#a05e04', '#176bc2'][index % 6];
  const forms = [
    { width: 287, height: 145, twist: .63, spin: 0 },
    { width: 245, height: 154, twist: -.73, spin: -.17 },
    { width: 362, height: 154, twist: 1.07, spin: .26 },
  ].map(({ width, height, twist, spin }) => {
    const x = Math.round(500 + Math.cos(angle + spin) * (width + variation * 21));
    const y = Math.round(194 + Math.sin(angle + spin) * (height + variation * 14));
    const controlX = Math.round(500 + Math.cos(angle + twist + spin) * (width + 43));
    const controlY = Math.round(194 + Math.sin(angle + twist + spin) * (height + 10));
    return { x, y, path: 'M500 194 Q' + controlX + ' ' + controlY + ' ' + x + ' ' + y };
  });
  return { forms, color, radius: index % 7 === 0 ? 4.8 : 2.6 };
});

const services = [
  { id: 'web', name: 'Web development', detail: 'Websites, storefronts, and applications built around what people come to do.', color: 'blue' },
  { id: 'mobile', name: 'Mobile apps', detail: 'Android and iOS experiences that make the important tasks easy to find and finish.', color: 'orange' },
  { id: 'desktop', name: 'Desktop software', detail: 'Tools for Windows, macOS, and Linux that fit the way teams already work.', color: 'green' },
];

const chapters = [
  { title: 'Find the right problem', detail: 'Agree on the people, workflows, and decisions the product needs to support.' },
  { title: 'Make it testable', detail: 'Put a prototype in front of people early enough for their feedback to change the plan.' },
  { title: 'Build for the next release', detail: 'Ship the useful parts first, then use what you learn to decide what comes next.' },
];

const motes = Array.from({ length: 23 }, (_, index) => ({
  x: 27 + (index * 137) % 1346,
  y: 29 + (index * 107) % 802,
  radius: index % 5 === 0 ? 3.6 : 1.6,
}));
---

<BaseLayout title="Home" description="TechMigos is a software development company in Hyderabad. We design and build websites, Android and iOS apps, and desktop software for businesses." ogImage="/images/og/signal-garden.png">
  <div class="signal-home" data-signal-home>
    <section class="signal-hero" data-signal-hero aria-labelledby="signal-title">
      <div class="signal-atmosphere" aria-hidden="true" data-signal-atmosphere>
        <div class="signal-halo signal-halo-blue" data-signal-halo></div>
        <div class="signal-halo signal-halo-rose" data-signal-halo></div>
        <svg class="signal-field" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice">
          <defs>
            <linearGradient id="signal-field-ink">
              <stop offset="0" stop-color="#7162d0" stop-opacity="0" />
              <stop offset=".62" stop-color="#7162d0" stop-opacity=".33" />
              <stop offset="1" stop-color="#2687b4" stop-opacity=".06" />
            </linearGradient>
          </defs>
          <g fill="none" stroke="url(#signal-field-ink)">
            {Array.from({ length: 10 }, (_, i) => (
              <path d={`M${610 - i * 42} 840 C${865 - i * 25} ${660 - i * 26} ${690 + i * 37} ${540 + i * 10} ${1470 + i * 15} ${240 - i * 20}`} />
            ))}
          </g>
        </svg>
        <svg viewBox="0 0 1400 850" preserveAspectRatio="xMidYMid slice" class="signal-motes">
          {motes.map(({ x, y, radius }) => <circle cx={x} cy={y} r={radius} />)}
        </svg>
      </div>
      <div class="signal-scene signal-wrap">
        <div class="signal-intro" data-signal-intro>
          <h1 id="signal-title">
            <span class="sr-only">{phases[0].lines.join(' ')}</span>
            <span class="signal-headlines" aria-hidden="true">
              {phases.map(({ lines }, index) => (
                <span class="signal-headline" data-signal-headline={index} data-active={index === 0 ? '' : undefined}>
                  <span class="signal-line">{lines[0]}</span>
                  <span class="signal-line"><span data-signal-type>{lines[1]}</span></span>
                </span>
              ))}
            </span>
          </h1>
          <p>Web, mobile, and desktop development from first release through the next version.</p>
        </div>

        <div class="signal-stage" data-signal-stage>
          <svg class="signal-flora" viewBox="0 0 1000 388" aria-hidden="true">
            <ellipse class="signal-orbit" cx="500" cy="194" rx="462" ry="178" />
            <ellipse class="signal-orbit signal-orbit-inner" cx="500" cy="194" rx="358" ry="148" />
            <g data-signal-drift>
              {branches.map(({ forms, color, radius }) => (
                <g class="signal-branch" data-signal-forms={JSON.stringify(forms)}>
                  <path d={forms[0].path} stroke={color} pathLength="1" />
                  <circle cx={forms[0].x} cy={forms[0].y} r={radius} fill={color} />
                </g>
              ))}
            </g>
            <g class="signal-core">
              <circle cx="500" cy="194" r="28" />
              <image href="/icon.png" x="481" y="175" width="38" height="38" />
            </g>
          </svg>
        </div>

        <div class="signal-console">
          <div class="signal-choices" data-signal-choices hidden role="group" aria-label="Explore product stages">
            {phases.map(({ label }, index) => (
              <button type="button" data-signal-choice={index} aria-pressed={index === 0}>{label}</button>
            ))}
          </div>
          <div class="signal-panels" aria-live="off" aria-atomic="true" data-signal-panels>
            {phases.map(({ title, copy }, index) => (
              <div data-signal-panel={index} hidden={index !== 0}>
                <strong>{title}</strong>
                <p>{copy}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="signal-hero-foot signal-wrap">
        <a href="#signal-services" class="signal-down">Explore the studio <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section class="signal-services signal-wrap" id="signal-services" aria-labelledby="signal-services-title">
      <div class="signal-section-head" data-signal-reveal>
        <div>
          <p class="signal-kicker">What we build</p>
          <h2 id="signal-services-title">Software for the<br />way people work.</h2>
        </div>
        <p>TechMigos is a software development studio based in Hyderabad, India. We work with businesses and product teams from the first prototype through release and the next version.</p>
      </div>
      <div class="signal-service-list">
        {services.map(({ id, name, detail, color }) => (
          <a class:list={['signal-service', 'signal-' + color]} href={'/services#' + id} data-signal-service>
            <span class="signal-service-dot" aria-hidden="true"></span>
            <h3>{name}</h3>
            <p>{detail}</p>
            <span class="signal-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <p class="signal-more">Explore <a href="/services#backend">backend development</a>, <a href="/services#qa">QA and testing</a>, <a href="/services#ai">AI integration</a>, and <a href="/services#consulting">technology consulting</a>.</p>
      <p class="signal-more">Planning a project? Read our guides to <a href="/blog/web-app-vs-mobile-app">choosing between a web or mobile app</a> and <a href="/blog/website-redesign-seo-accessibility">protecting search visibility during a website redesign</a>.</p>
    </section>

    {selectedWork.length > 0 && (
      <section class="signal-work" aria-labelledby="signal-work-title">
        <div class="signal-wrap">
          <div class="signal-section-head" data-signal-reveal>
            <div><p class="signal-kicker">Selected work</p><h2 id="signal-work-title">Ideas out in the world.</h2></div>
            <a class="signal-link" href="/work">Browse all projects <span aria-hidden="true">↗</span></a>
          </div>
          <div class="signal-projects">
            {selectedWork.map((project) => (
              <article class:list={['signal-project', 'signal-project-' + project.slug]} data-signal-card>
                <a href={project.href || '/work/' + project.slug}>
                  <div class="signal-project-media" data-signal-project>
                    <img src={project.image} alt="" loading="lazy" decoding="async" width="800" height="560" />
                  </div>
                  <div class="signal-project-copy">
                    <p class="signal-kicker">{project.category} project</p>
                    <h3>{project.title} <span aria-hidden="true">↗</span></h3>
                    <p>{project.description}</p>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="signal-chapter" aria-labelledby="signal-chapter-title">
      <div class="signal-wrap signal-chapter-grid">
        <div class="signal-chapter-art" data-signal-orbit aria-hidden="true">
          <svg viewBox="0 0 520 520" data-signal-orbit-layer>
            <g data-signal-rings>
              {Array.from({ length: 17 }, (_, index) => (
                <ellipse cx="260" cy="260" rx={112 + index * 5.5} ry={49 + index * 4.3} transform={'rotate(' + index * 12 + ' 260 260)'} />
              ))}
            </g>
            <g data-signal-satellites>
              <circle cx="453" cy="260" r="4" fill="#a7a3ff" />
              <circle cx="91" cy="260" r="3" fill="#eda777" />
            </g>
          </svg>
          <div class="signal-chapter-logo"><img src="/icon.png" width="88" height="88" alt="" loading="lazy" /></div>
        </div>
        <div class="signal-chapter-copy">
          <div data-signal-reveal><p class="signal-kicker">How we work</p><h2 id="signal-chapter-title">Give the work<br />room to evolve.</h2></div>
          <ol>
            {chapters.map(({ title, detail }, index) => (
              <li data-signal-step>
                <details name="signal-process" open={index === 0}>
                  <summary><span aria-hidden="true">0{index + 1}</span><strong>{title}</strong></summary>
                  <p>{detail}</p>
                </details>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="signal-contact signal-wrap" aria-labelledby="signal-contact-title">
      <div class="signal-contact-rings" aria-hidden="true"><i></i><i></i><i></i></div>
      <div data-signal-reveal>
        <p class="signal-kicker">Work with TechMigos</p>
        <h2 id="signal-contact-title">What would you<br />like to build?</h2>
        <p>Tell us about the product, the people using it, or the workflow you want to make easier.</p>
        <a class="signal-cta" href="/contact">Plan a project <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <div class="signal-preferences signal-wrap">
      <button type="button" data-signal-motion aria-pressed="false" hidden>Reduce homepage motion <span aria-hidden="true">✓</span></button>
    </div>
  </div>
</BaseLayout>

<script>
  import { mountSignalGarden } from '../scripts/signal-garden';

  let dispose: (() => void) | undefined;

  function init() {
    if (dispose) return;
    const home = document.querySelector<HTMLElement>('[data-signal-home]');
    if (home) dispose = mountSignalGarden(home);
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    dispose?.();
    dispose = undefined;
  });
  init();
</script>
