---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    icon: 'web',
    title: 'Web Development',
    description: 'Custom web applications built with modern frameworks that scale to millions.',
    href: '/services#web',
    color: 'from-indigo-500 to-blue-500',
  },
  {
    icon: 'mobile',
    title: 'Mobile Apps',
    description: 'Native iOS & Android apps with React Native & Flutter — ship to both stores fast.',
    href: '/services#mobile',
    color: 'from-violet-500 to-purple-500',
  },
  {
    icon: 'design',
    title: 'UI/UX Design',
    description: 'User-centered design that converts visitors into loyal customers.',
    href: '/services#design',
    color: 'from-pink-500 to-rose-500',
  },
  {
    icon: 'cloud',
    title: 'Cloud & DevOps',
    description: 'Scalable, fault-tolerant infrastructure on AWS, GCP and Azure.',
    href: '/services#cloud',
    color: 'from-cyan-500 to-sky-500',
  },
  {
    icon: 'ai',
    title: 'AI/ML Integration',
    description: 'Intelligent features powered by the latest LLMs and ML pipelines.',
    href: '/services#ai',
    color: 'from-emerald-500 to-teal-500',
  },
  {
    icon: 'consulting',
    title: 'Tech Consulting',
    description: 'Strategic guidance to accelerate your digital transformation journey.',
    href: '/services#consulting',
    color: 'from-amber-500 to-orange-500',
  },
];

const stats = [
  { value: 'Web', label: 'Product Engineering', icon: '🚀' },
  { value: 'Mobile', label: 'App Delivery', icon: '🤝' },
  { value: 'Cloud', label: 'Scale Readiness', icon: '⭐' },
  { value: 'AI', label: 'Applied Intelligence', icon: '💯' },
];

const featuredWork = [
  {
    title: 'Fintech Dashboard',
    category: 'Web Application',
    description: 'A real-time trading platform with advanced analytics and live charts.',
    image: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&h=600&fit=crop',
    href: '/portfolio/fintech-dashboard',
    tags: ['React', 'Node.js', 'AWS'],
  },
  {
    title: 'HealthTrack App',
    category: 'Mobile App',
    description: 'Personalized health monitoring with AI-powered insights and recommendations.',
    image: 'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=800&h=600&fit=crop',
    href: '/portfolio/healthtrack-app',
    tags: ['Flutter', 'Firebase', 'ML'],
  },
  {
    title: 'E-Commerce Platform',
    category: 'Web Application',
    description: 'Omnichannel retail solution with seamless checkout and AI recommendations.',
    image: 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=800&h=600&fit=crop',
    href: '/portfolio/ecommerce-platform',
    tags: ['Next.js', 'Stripe', 'GCP'],
  },
];

const processSteps = [
  {
    number: '01',
    title: 'Discovery & Strategy',
    description: 'Deep-dive into your goals, audience, and competitive landscape to define a bulletproof roadmap.',
    icon: '🔍',
  },
  {
    number: '02',
    title: 'Design & Prototype',
    description: 'Stunning interfaces and interactive prototypes that bring your vision to life before a line of code is written.',
    icon: '✏️',
  },
  {
    number: '03',
    title: 'Build & Test',
    description: 'Clean, scalable code with rigorous automated testing ensuring flawless performance at every scale.',
    icon: '⚡',  
  },
  {
    number: '04',
    title: 'Launch & Support',
    description: 'Deploy with confidence and ongoing support to keep your product thriving and evolving.',
    icon: '🚀',
  },
];

const testimonials = [
  {
    quote: 'TechMigos transformed our outdated platform into a modern, scalable solution. The team was professional, responsive, and truly understood our vision.',
    name: 'Sarah Chen',
    role: 'CTO',
    company: 'Nexus Financial',
    avatar: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&h=100&fit=crop&crop=face',
    result: '+200% Performance',
  },
  {
    quote: 'Working with TechMigos felt like having an extension of our own team. They delivered a mobile app that exceeded all our expectations on time and budget.',
    name: 'Marcus Rodriguez',
    role: 'Founder',
    company: 'HealthFirst',
    avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&h=100&fit=crop&crop=face',
    result: '50k+ Downloads',
  },
  {
    quote: 'Their AI expertise helped us implement features we didn\'t even know were possible. Truly innovative partners who push boundaries.',
    name: 'Emily Watson',
    role: 'VP Product',
    company: 'RetailMax',
    avatar: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&h=100&fit=crop&crop=face',
    result: '3x User Growth',
  },
  {
    quote: 'From discovery to launch, every phase was executed with precision. Our conversion rates increased by 40% after the redesign — incredible ROI.',
    name: 'David Park',
    role: 'CEO',
    company: 'GreenTech Solutions',
    avatar: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&h=100&fit=crop&crop=face',
    result: '+40% Conversions',
  },
];

const clientNames = ['TechCorp', 'Innovate', 'FutureFin', 'HealthSys', 'RetailGo', 'CloudNine', 'StartupX', 'DataFlow'];
---

<BaseLayout title="Home" description="TechMigos - Building Tomorrow, Together. We partner with startups and enterprises to design, build, and ship world-class digital products.">

  <!-- ========================================
       HERO SECTION
       ======================================== -->
  <section class="relative min-h-screen flex items-center overflow-hidden bg-white pt-20">
    <!-- Animated grid background -->
    <div class="absolute inset-0 grid-pattern opacity-60"></div>

    <!-- Animated gradient blobs -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -right-40 w-[600px] h-[600px] bg-primary-200 rounded-full mix-blend-multiply filter blur-3xl opacity-25 animate-blob"></div>
      <div class="absolute top-40 -left-40 w-[500px] h-[500px] bg-accent-200 rounded-full mix-blend-multiply filter blur-3xl opacity-25 animate-blob" style="animation-delay: 2s;"></div>
      <div class="absolute -bottom-40 left-1/2 w-[500px] h-[500px] bg-violet-200 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob" style="animation-delay: 4s;"></div>
    </div>

    <!-- Floating tech icon particles -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none" id="hero-particles">
      {[
        { top: '15%', left: '8%', delay: '0s', dur: '7s', size: '40px', opacity: '0.12' },
        { top: '70%', left: '5%', delay: '1s', dur: '9s', size: '30px', opacity: '0.08' },
        { top: '25%', left: '90%', delay: '3s', dur: '8s', size: '50px', opacity: '0.10' },
        { top: '80%', left: '85%', delay: '2s', dur: '6s', size: '35px', opacity: '0.12' },
        { top: '45%', left: '92%', delay: '0.5s', dur: '10s', size: '25px', opacity: '0.08' },
        { top: '55%', left: '3%', delay: '4s', dur: '7s', size: '45px', opacity: '0.09' },
      ].map(p => (
        <div
          class="absolute rounded-full bg-gradient-to-br from-primary-400 to-accent-400 animate-float"
          style={`top:${p.top};left:${p.left};width:${p.size};height:${p.size};animation-delay:${p.delay};animation-duration:${p.dur};opacity:${p.opacity};`}
        ></div>
      ))}
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full py-20">
      <div class="text-center max-w-5xl mx-auto">
        <!-- Eyebrow -->
        <div class="reveal stagger-1 flex justify-center mb-6">
          <span class="section-eyebrow">
            <span class="w-2 h-2 rounded-full bg-primary-500 animate-pulse inline-block"></span>
            Startup-friendly and enterprise-ready delivery
          </span>
        </div>

        <!-- Main heading with typewriter -->
        <h1 class="reveal stagger-2 text-5xl sm:text-6xl lg:text-7xl font-extrabold text-gray-900 leading-[1.05] tracking-tight mb-6">
          We Build Software<br>
          That <span class="text-gradient" id="rotating-text">Scales With You</span>
        </h1>

        <p class="reveal stagger-3 text-xl sm:text-2xl text-gray-500 mb-10 max-w-3xl mx-auto leading-relaxed">
          TechMigos partners with startups and enterprises to design, build, and ship 
          <strong class="text-gray-700">world-class digital products</strong> that drive growth.
        </p>

        <div class="reveal stagger-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/contact" class="btn-primary text-lg px-10 py-4 shine-hover group">
            Start a Project
            <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="/portfolio" class="btn-ghost text-lg px-10 py-4 group">
            <svg class="w-5 h-5 mr-2 group-hover:scale-125 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            See Our Work
          </a>
        </div>

        <!-- Mini stats strip -->
        <div class="reveal stagger-5 mt-16 flex flex-wrap justify-center gap-6 md:gap-12">
          {stats.map(s => (
            <div class="text-center">
              <div class="text-3xl font-black text-primary-600 tabular-nums">{s.value}</div>
              <div class="text-sm text-gray-500 mt-0.5">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50">
      <span class="text-xs text-gray-400 uppercase tracking-widest">Scroll</span>
      <div class="w-px h-8 bg-gradient-to-b from-gray-400 to-transparent animate-pulse"></div>
    </div>
  </section>

  <!-- ========================================
       MARQUEE LOGO STRIP
       ======================================== -->
  <section class="py-10 bg-gray-50 border-y border-gray-100 overflow-hidden">
    <p class="text-center text-xs font-semibold text-gray-400 uppercase tracking-widest mb-6">Trusted by innovative companies</p>
    <div class="relative flex overflow-hidden">
      <div class="flex gap-12 items-center animate-marquee whitespace-nowrap">
        {[...clientNames, ...clientNames].map((name) => (
          <span class="text-xl font-bold text-gray-300 hover:text-primary-500 transition-colors duration-300 cursor-default select-none px-4">
            {name}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       SERVICES SECTION
       ======================================== -->
  <section class="section-padding bg-white relative overflow-hidden">
    <!-- Background decor -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary-50 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl"></div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">What We Do</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">End-to-End Technology</h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          From concept to launch — comprehensive services that take your product to market and beyond.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service, i) => (
          <a
            href={service.href}
            class={`group relative bg-white rounded-2xl p-7 border border-gray-100 glow-card shine-hover tilt-card stagger-${i + 1} reveal overflow-hidden`}
          >
            <!-- Gradient corner accent -->
            <div class={`absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl ${service.color} opacity-0 group-hover:opacity-5 transition-opacity duration-500 rounded-bl-3xl rounded-tr-2xl`}></div>
            
            {/* Animated icon bg */}
            <div class={`w-14 h-14 rounded-xl bg-gradient-to-br ${service.color} flex items-center justify-center mb-5 shadow-lg group-hover:scale-110 group-hover:rotate-3 transition-all duration-300`}>
              {service.icon === 'web' && (
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                </svg>
              )}
              {service.icon === 'mobile' && (
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
              )}
              {service.icon === 'design' && (
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
                </svg>
              )}
              {service.icon === 'cloud' && (
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
                </svg>
              )}
              {service.icon === 'ai' && (
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              )}
              {service.icon === 'consulting' && (
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
              )}
            </div>

            <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-600 transition-colors">
              {service.title}
            </h3>
            <p class="text-gray-500 leading-relaxed text-sm">{service.description}</p>
            
            <!-- Arrow -->
            <div class="mt-5 flex items-center text-primary-600 font-semibold text-sm opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all duration-300">
              Learn more
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       ANIMATED STATS SECTION
       ======================================== -->
  <section class="py-24 relative overflow-hidden" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 40%, #0e7490 100%);">
    <!-- Noise texture -->
    <div class="absolute inset-0 opacity-5" style="background-image:url('data:image/svg+xml,%3Csvg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cfilter id=\"n\"%3E%3CfeTurbulence type=\"fractalNoise\" baseFrequency=\"0.9\" numOctaves=\"4\" stitchTiles=\"stitch\"/%3E%3C/filter%3E%3Crect width=\"100%25\" height=\"100%25\" filter=\"url(%23n)\"/%3E%3C/svg%3E');"></div>
    <!-- Orbiting rings -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full border border-white/5 animate-spin-slow pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] rounded-full border border-white/5 animate-spin-slow pointer-events-none" style="animation-direction:reverse;animation-duration:15s;"></div>

    <div class="container-custom relative z-10">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
        {stats.map((stat, i) => (
          <div class={`text-center reveal stagger-${i + 1}`}>
            <div class="text-4xl mb-2">{stat.icon}</div>
            <div
              class="text-5xl lg:text-6xl font-black mb-2 tabular-nums"
              style="background: linear-gradient(135deg, #a5b4fc, #67e8f9); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
              data-counter={stat.value}
            >
              {stat.value}
            </div>
            <div class="text-indigo-200 font-medium">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       FEATURED WORK
       ======================================== -->
  <section class="section-padding bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">Portfolio</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">Our Best Work</h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          Selected projects that showcase our expertise across industries and cutting-edge technologies.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredWork.map((project, i) => (
          <a href={project.href} class={`group block bg-white rounded-2xl overflow-hidden shadow-sm glow-card stagger-${i + 1} reveal`}>
            <div class="relative overflow-hidden">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-56 object-cover transform group-hover:scale-110 transition-transform duration-700"
                loading="lazy"
                width="800"
                height="600"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-gray-900/90 via-gray-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
                <div>
                  <div class="flex gap-2 mb-3">
                    {project.tags.map(tag => (
                      <span class="px-2 py-0.5 bg-white/20 backdrop-blur-sm text-white text-xs font-medium rounded-full border border-white/30">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <span class="text-white font-semibold flex items-center gap-2">
                    View Case Study
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </span>
                </div>
              </div>
            </div>
            <div class="p-6">
              <span class="text-sm font-semibold text-primary-600 mb-2 block uppercase tracking-wide">{project.category}</span>
              <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-600 transition-colors">
                {project.title}
              </h3>
              <p class="text-gray-500 text-sm leading-relaxed">{project.description}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-12 reveal">
        <a href="/portfolio" class="btn-ghost group">
          View All Projects
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ========================================
       PROCESS SECTION
       ======================================== -->
  <section class="section-padding bg-white relative overflow-hidden">
    <div class="absolute left-0 top-1/2 -translate-y-1/2 w-64 h-64 bg-accent-50 rounded-full blur-3xl opacity-50"></div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">Our Process</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">How We Work</h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          A battle-tested methodology that delivers exceptional results, every single time.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 relative">
        <!-- Connecting line (desktop) -->
        <div class="hidden lg:block absolute top-16 left-[12.5%] right-[12.5%] h-0.5 z-0">
          <div class="h-full bg-gradient-to-r from-primary-200 via-accent-300 to-primary-200 rounded-full"></div>
        </div>

        {processSteps.map((step, i) => (
          <div class={`relative text-center stagger-${i + 1} reveal`}>
            <div class="relative z-10 inline-flex items-center justify-center w-28 h-28 rounded-full mb-6 animate-pulse-glow" style="background: linear-gradient(135deg, #4F46E5, #06B6D4);">
              <div class="w-24 h-24 rounded-full bg-white flex items-center justify-center">
                <div class="text-center">
                  <div class="text-2xl">{step.icon}</div>
                  <div class="text-sm font-black text-primary-600">{step.number}</div>
                </div>
              </div>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-3">{step.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       TESTIMONIALS
       ======================================== -->
  <section class="section-padding bg-gray-50 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-80 h-80 bg-primary-50 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl"></div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">Testimonials</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">What Our Clients Say</h2>
        <p class="text-lg text-gray-500">Don't take our word for it — hear from the companies we've helped grow.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {testimonials.map((t, i) => (
          <div class={`group bg-white rounded-2xl p-8 shadow-sm overflow-hidden relative glow-card stagger-${i + 1} reveal`}>
            <!-- Gradient accent top line -->
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-primary-500 to-accent-400 transform origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
            
            <!-- Result badge -->
            <div class="absolute top-6 right-6 px-3 py-1 bg-primary-50 text-primary-700 text-xs font-bold rounded-full border border-primary-100">
              {t.result}
            </div>

            <!-- Stars -->
            <div class="flex gap-1 mb-5">
              {[...Array(5)].map(() => (
                <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <blockquote class="text-gray-700 mb-6 leading-relaxed text-base italic">
              "{t.quote}"
            </blockquote>

            <div class="flex items-center">
              <div class="relative mr-4">
                <img src={t.avatar} alt={t.name} class="w-12 h-12 rounded-full object-cover ring-2 ring-primary-100" loading="lazy" width="48" height="48"/>
                <div class="absolute -bottom-0.5 -right-0.5 w-4 h-4 bg-green-400 rounded-full border-2 border-white"></div>
              </div>
              <div>
                <div class="font-bold text-gray-900">{t.name}</div>
                <div class="text-sm text-gray-500">{t.role}, <span class="text-primary-600 font-medium">{t.company}</span></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       CTA BANNER
       ======================================== -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 animate-gradient-shift" style="background: linear-gradient(135deg, #4F46E5, #7C3AED, #06B6D4, #4F46E5); background-size: 300% 300%;"></div>
    <!-- Animated shapes -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-20 -left-20 w-80 h-80 bg-white/5 rounded-full"></div>
      <div class="absolute -bottom-20 -right-20 w-96 h-96 bg-white/5 rounded-full"></div>
      <div class="absolute top-1/2 left-1/4 w-2 h-2 bg-white/40 rounded-full animate-float"></div>
      <div class="absolute top-1/3 right-1/4 w-3 h-3 bg-white/30 rounded-full animate-float" style="animation-delay:1s;"></div>
      <div class="absolute bottom-1/3 left-1/3 w-2 h-2 bg-white/40 rounded-full animate-float" style="animation-delay:2s;"></div>
    </div>

    <div class="container-custom relative z-10 text-center reveal">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/15 text-white/90 text-sm font-semibold rounded-full border border-white/20 mb-6">
        <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
        Currently accepting new projects
      </span>
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-6 leading-tight">
        Ready to bring your<br>idea to life?
      </h2>
      <p class="text-xl text-white/80 mb-10 max-w-2xl mx-auto">
        Let's collaborate to build something extraordinary.<br>Schedule a free consultation today — no commitment required.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact" class="group inline-flex items-center justify-center px-10 py-4 bg-white text-primary-700 font-bold rounded-xl hover:bg-gray-50 transition-all duration-300 shadow-2xl hover:shadow-white/25 hover:-translate-y-1 text-lg shine-hover">
          Let's Talk
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="/pricing" class="inline-flex items-center justify-center px-10 py-4 border-2 border-white/40 text-white font-bold rounded-xl hover:bg-white/10 hover:border-white/70 transition-all duration-300 text-lg">
          View Pricing
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Marquee animation */
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee 25s linear infinite;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }

  /* Rotating text animation */
  @keyframes textFade {
    0%, 18% { opacity: 1; transform: translateY(0); }
    22%, 96% { opacity: 0; transform: translateY(-20px); }
    100% { opacity: 0; }
  }
</style>

<script>
  // Rotating hero text
  const phrases = ['Scales With You', 'Drives Growth', 'Wins Markets', 'Makes an Impact', 'Delights Users'];
  let currentPhrase = 0;
  const el = document.getElementById('rotating-text');

  if (el) {
    setInterval(() => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(-12px)';
      el.style.transition = 'all 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
      setTimeout(() => {
        currentPhrase = (currentPhrase + 1) % phrases.length;
        el.textContent = phrases[currentPhrase];
        el.style.transform = 'translateY(12px)';
        el.style.opacity = '0';
        setTimeout(() => {
          el.style.transform = 'translateY(0)';
          el.style.opacity = '1';
        }, 50);
      }, 400);
    }, 3000);
  }
</script>
