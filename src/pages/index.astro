  .home-final-cta h2 { max-width: 14ch; margin: var(--space-5) auto 0; color: var(--color-text-inverse); font-size: clamp(2.5rem, 5.5vw, 5rem); font-weight: var(--weight-extrabold); letter-spacing: -0.055em; line-height: 1; }
  .home-final-cta__summary { max-width: 40rem; margin: var(--space-6) auto 0; color: rgb(248 250 252 / 0.78); font-size: var(--text-lg); line-height: 1.65; }
  .home-final-cta__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-4); margin-top: var(--space-8); }
  .home-final-cta__primary, .home-final-cta__secondary { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: 3rem; padding: 0 var(--space-5); border-radius: var(--radius-md); font-weight: var(--weight-semibold); text-decoration: none; transition: transform var(--motion-normal) var(--ease-standard), background var(--motion-normal) var(--ease-standard); }
  .home-final-cta__primary { background: #fff; color: #0f172a; }
  .home-final-cta__secondary { border: 1px solid rgb(255 255 255 / 0.42); color: var(--color-text-inverse); }
  .home-final-cta__primary:hover, .home-final-cta__primary:focus-visible { background: #ccfbf1; }
  .home-final-cta__secondary:hover, .home-final-cta__secondary:focus-visible { border-color: #fff; background: rgb(255 255 255 / 0.1); }

  @media (max-width: 900px) {
    .homepage-hero { min-height: auto; }
    .homepage-hero__container { grid-template-columns: 1fr; gap: var(--space-10); width: min(100% - 2rem, 44rem); }
    .homepage-hero__content { max-width: 40rem; }
    .homepage-hero h1 { max-width: 12ch; }
    .homepage-hero__visual { width: min(100%, 39rem); }
    .home-trust__layout, .home-process__layout, .home-principles__layout { grid-template-columns: 1fr; }
    .home-process__layout, .home-principles__layout { gap: var(--space-10); }
    .home-technology__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .home-technology__grid > :global(section):nth-child(3n) { border-right: 1px solid var(--color-border); }
    .home-technology__grid > :global(section):nth-child(2n) { border-right: 0; }
  }

  @media (max-width: 480px) {
    .homepage-hero { padding-top: 7rem; }
    .homepage-hero__actions { align-items: stretch; gap: var(--space-3); }
    .homepage-hero__primary-action { width: 100%; }
    .homepage-hero__secondary-action { width: fit-content; }
    .homepage-hero__visual { padding: 0.8rem; }
    .homepage-hero__status { display: none; }
    .homepage-hero__map { min-height: 20rem; }
    .homepage-hero__node { width: 41%; padding: 0.65rem; }
    .homepage-hero__node small { font-size: 0.6rem; }
    .homepage-hero__node--web { top: 7%; left: 4%; }
    .homepage-hero__node--mobile { top: 7%; right: 4%; }
    .homepage-hero__node--cloud { bottom: 7%; left: 4%; }
    .homepage-hero__node--ai { right: 4%; bottom: 7%; }
    .home-section { padding-block: var(--space-16); }
    .home-trust__layout { padding-block: var(--space-8); }
    .home-trust__list, .home-services__grid, .home-work__grid, .home-insights__grid, .home-technology__grid { grid-template-columns: 1fr; }
    .home-work__heading, .home-insights__heading { display: grid; align-items: start; }
    .home-technology__grid > :global(section) { border-right: 0; }
    .home-final-cta__actions { align-items: stretch; }
    .home-final-cta__primary, .home-final-cta__secondary { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-hero__network { display: none; }
    .homepage-hero__paths path { animation: none; }
    .homepage-hero::after { transition: none; }
    .homepage-hero__core::before,
    .homepage-hero__core::after { animation: none; }
    .homepage-hero__node { animation: none; }
    .home-final-cta__orbit,
    .home-final-cta__orbit::after { animation: none; }
    .home-final-cta__primary,
    .home-final-cta__secondary { transition: none; }
  }

  /* Custom cursor styles — activated only when JS sets .custom-cursor-active */
  :global(.custom-cursor-active) {
    cursor: none !important;
  }

  :global(.custom-cursor-active) :global(a),
  :global(.custom-cursor-active) :global(button),
  :global(.custom-cursor-active) :global([role="button"]) {
    cursor: none !important;
  }

  :global(#cursor-dot) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%);
    will-change: transform;
  }

  :global(#cursor-ring) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9998;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1.5px solid rgb(13 148 136 / 0.7);
    background: transparent;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%);
    will-change: transform;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(#cursor-label) {
    color: var(--color-accent);
    font-size: 0.6rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }
</style>

<script>
  import { initHomeMotion, destroyHomeMotion } from '../scripts/home-motion';
  import { initCursorFollower, destroyCursorFollower } from '../scripts/cursor-follower';
  import { initCardInteractions, destroyCardInteractions } from '../scripts/card-interactions';

  // ===== PAGE-LEVEL CLEANUP REGISTRY =====
  const pageCleanups: Array<() => void> = [];
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const isMobileViewport = window.matchMedia('(max-width: 767px)').matches;

  function cleanupPage() {
    while (pageCleanups.length > 0) {
      pageCleanups.pop()?.();
    }
  }

  // ===== HERO NETWORK CANVAS (upgraded) =====
  function setupNetworkCanvas() {
    if (prefersReducedMotion || isMobileViewport) return;

    const canvas = document.querySelector<HTMLCanvasElement>('#hero-network-canvas');
    const hero = document.querySelector<HTMLElement>('#homepage-hero');
    if (!canvas || !hero) return;

    const context = canvas.getContext('2d');
    if (!context) return;

    // Reduced particle count for quality > quantity
    const PARTICLE_COUNT = 32;
    const CONNECTION_DISTANCE = 120;
    const MOUSE_INFLUENCE = 160;
    const particles: Array<{ x: number; y: number; vx: number; vy: number; r: number; opacity: number }> = [];
    let animationFrameId: number | undefined;
    let width = 0;
    let height = 0;
    let isActive = true;
    let isVisible = true;
    let mouse = { x: -1000, y: -1000 };

    const resizeCanvas = () => {
      const rect = hero.getBoundingClientRect();
      width = canvas.width = Math.round(canvas.offsetWidth || rect.width || window.innerWidth);
      height = canvas.height = Math.round(canvas.offsetHeight || rect.height || window.innerHeight);

      if (particles.length === 0) {
        for (let i = 0; i < PARTICLE_COUNT; i++) {
          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.4,
            vy: (Math.random() - 0.5) * 0.4,
            r: Math.random() * 1.5 + 0.8,
            opacity: Math.random() * 0.5 + 0.3,
          });
        }
        return;
      }

      particles.forEach((p) => {
        if (p.x > width) p.x = Math.random() * width;
        if (p.y > height) p.y = Math.random() * height;
      });
    };

    const draw = () => {
      if (!isActive || !isVisible) {
        animationFrameId = window.requestAnimationFrame(draw);
        return;
      }

      context.clearRect(0, 0, width, height);

      for (let i = 0; i < PARTICLE_COUNT; i++) {
        const p = particles[i];
        if (!p) continue;

        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;
        p.x = Math.max(0, Math.min(width, p.x));
        p.y = Math.max(0, Math.min(height, p.y));

        // Mouse subtle attraction
        if (mouse.x > 0) {
          const dx = mouse.x - p.x;
          const dy = mouse.y - p.y;
          const dist = Math.hypot(dx, dy);
          if (dist < MOUSE_INFLUENCE) {
            p.x += dx * 0.004;
            p.y += dy * 0.004;
          }
        }

        // Draw particle
        context.beginPath();
        context.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        context.fillStyle = `rgba(13, 148, 136, ${p.opacity})`;
        context.fill();

        // Connection lines
        for (let j = i + 1; j < PARTICLE_COUNT; j++) {
          const q = particles[j];
          if (!q) continue;
          const dx = p.x - q.x;
          const dy = p.y - q.y;
          const dist = Math.hypot(dx, dy);
          if (dist < CONNECTION_DISTANCE) {
            const alpha = (1 - dist / CONNECTION_DISTANCE) * 0.22;
            context.beginPath();
            context.lineWidth = (1 - dist / CONNECTION_DISTANCE) * 0.9;
            context.strokeStyle = `rgba(37, 99, 235, ${alpha})`;
            context.moveTo(p.x, p.y);
            context.lineTo(q.x, q.y);
            context.stroke();
          }
        }
      }

      animationFrameId = window.requestAnimationFrame(draw);
    };

    // Pause when hero is off screen
    const visibilityObserver = typeof IntersectionObserver !== 'undefined'
      ? new IntersectionObserver((entries) => {
          for (const entry of entries) {
            isVisible = entry.isIntersecting;
          }
        }, { threshold: 0 })
      : undefined;
    visibilityObserver?.observe(hero);

    // Hero spotlight + mouse tracking
    const updateMousePosition = (event: MouseEvent) => {
      const rect = hero.getBoundingClientRect();
      mouse = { x: event.clientX - rect.left, y: event.clientY - rect.top };
    };
    const resetMousePosition = () => { mouse = { x: -1000, y: -1000 }; };
    const updateHeroSpotlight = (event: PointerEvent) => {
      const rect = hero.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      hero.style.setProperty('--hero-x', `${((event.clientX - rect.left) / rect.width) * 100}%`);
      hero.style.setProperty('--hero-y', `${((event.clientY - rect.top) / rect.height) * 100}%`);
    };

    // Hero visual parallax on pointer move
    const visualEl = document.querySelector<HTMLElement>('.homepage-hero__visual');
    const updateHeroParallax = (event: PointerEvent) => {
      if (!visualEl) return;
      const rect = hero.getBoundingClientRect();
      const nx = (event.clientX - rect.left - rect.width / 2) / (rect.width / 2);
      const ny = (event.clientY - rect.top - rect.height / 2) / (rect.height / 2);
      visualEl.style.setProperty('transform', `translate(${nx * 4}px, ${ny * 3}px)`);
    };
    const resetParallax = () => {
      if (visualEl) visualEl.style.setProperty('transform', 'translate(0, 0)');
    };

    if (hasFinePointer) {
      hero.classList.add('is-interactive');
      hero.addEventListener('mousemove', updateMousePosition, { passive: true });
      hero.addEventListener('mouseleave', resetMousePosition, { passive: true });
      hero.addEventListener('pointermove', updateHeroSpotlight, { passive: true });
      hero.addEventListener('pointermove', updateHeroParallax, { passive: true });
      hero.addEventListener('pointerleave', resetParallax, { passive: true });
    }

    const resizeObserver = typeof ResizeObserver === 'undefined'
      ? undefined
      : new ResizeObserver(resizeCanvas);
    resizeObserver?.observe(hero);
    window.addEventListener('resize', resizeCanvas, { passive: true });
    resizeCanvas();
    draw();

    pageCleanups.push(() => {
      isActive = false;
      if (animationFrameId !== undefined) window.cancelAnimationFrame(animationFrameId);
      resizeObserver?.disconnect();
      visibilityObserver?.disconnect();
      window.removeEventListener('resize', resizeCanvas);
      hero.removeEventListener('mousemove', updateMousePosition);
      hero.removeEventListener('mouseleave', resetMousePosition);
      hero.removeEventListener('pointermove', updateHeroSpotlight);
      hero.removeEventListener('pointermove', updateHeroParallax);
      hero.removeEventListener('pointerleave', resetParallax);
      hero.classList.remove('is-interactive');
      context.clearRect(0, 0, width, height);
      canvas.width = 0;
      canvas.height = 0;
    });
  }

  // ===== GSAP MOTION + CURSOR + CARD INTERACTIONS =====
  function setupHomepageMotion() {
    if (prefersReducedMotion) {
      // Show all content immediately — no reveals
      document.querySelectorAll('[data-service-card], [data-work-card], [data-tech-group], [data-principle-item], [data-insight-card]').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
      });
    } else {
      // Set initial state for GSAP reveals — hidden until animated in
      document.querySelectorAll('[data-service-card], [data-work-card], [data-tech-group], [data-principle-item], [data-insight-card]').forEach((el) => {
        (el as HTMLElement).style.opacity = '0';
      });

      initHomeMotion();
      pageCleanups.push(() => destroyHomeMotion());

      initCardInteractions();
      pageCleanups.push(() => destroyCardInteractions());
    }

    // Cursor — internal guards prevent mobile/touch/reduced-motion activation
    initCursorFollower();
    pageCleanups.push(() => destroyCursorFollower());
  }

  // Run canvas immediately (no dependency on GSAP)
  setupNetworkCanvas();

  // Run GSAP async after first paint — does not block rendering
  if (typeof requestIdleCallback !== 'undefined') {
    requestIdleCallback(() => setupHomepageMotion(), { timeout: 2000 });
  } else {
    setTimeout(() => setupHomepageMotion(), 150);
  }

  // Cleanup on Astro SPA navigation
  window.addEventListener('pagehide', cleanupPage, { once: true });
  document.addEventListener('astro:before-swap', cleanupPage, { once: true });
</script>
