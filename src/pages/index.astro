---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { loadSiteContent } from '../lib/siteContent';

const services = [
  {
    icon: 'web',
    title: 'Web Development',
    description: 'Custom web applications built with modern frameworks that scale to millions.',
    href: '/services#web',
    color: 'from-indigo-500 to-blue-500',
  },
  {
    icon: 'mobile',
    title: 'Mobile Apps',
    description: 'Native iOS & Android apps with React Native & Flutter — ship to both stores fast.',
    href: '/services#mobile',
    color: 'from-blue-500 to-cyan-500',
  },
  {
    icon: 'qa',
    title: 'Quality Assurance & Testing',
    description: 'Comprehensive manual and automated testing to ensure stable, release-ready software.',
    href: '/services#qa',
    color: 'from-pink-500 to-rose-500',
  },
  {
    icon: 'backend',
    title: 'Backend Development',
    description: 'Robust APIs, databases, and business logic built for performance, security, and scale.',
    href: '/services#backend',
    color: 'from-cyan-500 to-sky-500',
  },
  {
    icon: 'ai',
    title: 'AI/ML Integration',
    description: 'Intelligent features powered by the latest LLMs and ML pipelines.',
    href: '/services#ai',
    color: 'from-emerald-500 to-teal-500',
  },
  {
    icon: 'consulting',
    title: 'Tech Consulting',
    description: 'Architecture, education technology, teacher training, technical guidance, and motivation programs.',
    href: '/services#consulting',
    color: 'from-amber-500 to-orange-500',
  },
];

const trustHighlights = [
  'Strong Client Satisfaction',
  'Cross-Industry Delivery Experience',
  'Responsive Project Communication',
  'Reliable, Long-Term Delivery Partner',
  'On-Time, On-Budget Delivery',
  'Transparent Progress Reporting',
  'Security-First Engineering Practices',
];

const processSteps = [
  {
    number: '01',
    title: 'Discovery & Strategy',
    description: 'Deep-dive into your goals, audience, and competitive landscape to define a bulletproof roadmap.',
    icon: 'Plan',
  },
  {
    number: '02',
    title: 'Design & Prototype',
    description: 'Stunning interfaces and interactive prototypes that bring your vision to life before a line of code is written.',
    icon: 'Design',
  },
  {
    number: '03',
    title: 'Build & Test',
    description: 'Clean, scalable code with rigorous automated testing ensuring flawless performance at every scale.',
    icon: 'Build',  
  },
  {
    number: '04',
    title: 'Launch & Support',
    description: 'Deploy with confidence and ongoing support to keep your product thriving and evolving.',
    icon: 'Launch',
  },
];

const { testimonials, projects } = await loadSiteContent();
const featuredWork = projects.filter((project) => project.featured).slice(0, 3);
const showTestimonials = false;
---

<BaseLayout title="Home" description="TechMigos designs and builds web apps, mobile apps, backend systems, QA automation, AI integrations, and consulting programs for schools, teachers, startups, and growing companies.">

  <!-- ========================================
       HERO SECTION
       ======================================== -->
  <section id="homepage-hero" class="homepage-hero" aria-labelledby="homepage-hero-title">
    <div class="homepage-hero__grid" aria-hidden="true"></div>
    <canvas id="hero-network-canvas" class="homepage-hero__network" aria-hidden="true"></canvas>

    <div class="homepage-hero__container">
      <div class="homepage-hero__content">
        <p class="homepage-hero__eyebrow">Product engineering for ambitious teams</p>
        <h1 id="homepage-hero-title">We build digital products people remember.</h1>
        <p class="homepage-hero__summary">
          Strategy, UX, web, mobile, cloud, and applied AI—planned and delivered by one accountable product team.
        </p>
        <div class="homepage-hero__actions">
          <a href="/contact" class="btn-primary homepage-hero__primary-action">
            Start a project
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
          <a href="/portfolio" class="btn-link homepage-hero__secondary-action">Explore our work <span aria-hidden="true">↗</span></a>
        </div>
        <p class="homepage-hero__assurance">From the first decision to the first release.</p>
      </div>

      <div class="homepage-hero__visual" aria-label="TechMigos capabilities: web, mobile, cloud, and AI connected through one product delivery core.">
        <div class="homepage-hero__visual-header">
          <span>TechMigos delivery system</span>
          <span class="homepage-hero__status"><i aria-hidden="true"></i> Ready to build</span>
        </div>
        <div class="homepage-hero__map">
          <svg class="homepage-hero__paths" viewBox="0 0 520 420" aria-hidden="true" focusable="false">
            <path d="M126 104C186 116 203 154 260 210" />
            <path d="M394 104C334 116 317 154 260 210" />
            <path d="M126 316C186 304 203 266 260 210" />
            <path d="M394 316C334 304 317 266 260 210" />
          </svg>
          <div class="homepage-hero__core" aria-hidden="true"><span>TM</span><small>Product core</small></div>
          <div class="homepage-hero__node homepage-hero__node--web"><span>01</span><strong>Web</strong><small>Experiences that convert</small></div>
          <div class="homepage-hero__node homepage-hero__node--mobile"><span>02</span><strong>Mobile</strong><small>Useful, native-feeling apps</small></div>
          <div class="homepage-hero__node homepage-hero__node--cloud"><span>03</span><strong>Cloud</strong><small>Systems built to evolve</small></div>
          <div class="homepage-hero__node homepage-hero__node--ai"><span>04</span><strong>Applied AI</strong><small>Intelligence with purpose</small></div>
        </div>
        <p class="homepage-hero__visual-caption"><span aria-hidden="true"></span> One team, connected delivery</p>
      </div>
    </div>
  </section>

  <!-- ========================================
       TRUST METRICS STRIP
       ======================================== -->
  <section class="py-10 bg-gray-50 border-y border-gray-100 overflow-hidden">
    <p class="text-center text-xs font-semibold text-gray-400 uppercase tracking-widest mb-6">Trusted delivery, measurable outcomes</p>
    <div class="relative">
      <div class="flex w-max animate-trust-ticker whitespace-nowrap">
        {[...trustHighlights, ...trustHighlights].map((item) => (
          <div class="mx-3 sm:mx-4 px-6 py-3 rounded-full bg-white border border-gray-200 shadow-sm text-sm sm:text-base font-semibold text-gray-700">
            {item}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       SERVICES SECTION
       ======================================== -->
  <section class="section-padding bg-white relative overflow-hidden">
    <!-- Background decor -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary-50 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl"></div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">What We Do</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">End-to-End Technology</h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          From concept to launch — comprehensive services that take your product to market and beyond.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service, i) => (
          <a
            href={service.href}
            class={`group relative bg-white rounded-2xl p-7 border border-gray-100 glow-card shine-hover tilt-card stagger-${i + 1} reveal overflow-hidden`}
          >
            <!-- Gradient corner accent -->
            <div class={`absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl ${service.color} opacity-0 group-hover:opacity-5 transition-opacity duration-500 rounded-bl-3xl rounded-tr-2xl`}></div>
            
            {/* Animated icon bg */}
            <div class={`w-14 h-14 rounded-xl bg-gradient-to-br ${service.color} flex items-center justify-center mb-5 shadow-lg group-hover:scale-110 group-hover:rotate-3 transition-[transform,box-shadow] duration-300`}>
              <ServiceIcon name={service.icon} class="w-7 h-7 text-white" />
            </div>

            <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-600 transition-colors">
              {service.title}
            </h3>
            <p class="text-gray-500 leading-relaxed text-sm">{service.description}</p>
            
            <!-- Arrow -->
            <div class="mt-5 flex items-center text-primary-600 font-semibold text-sm opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-[opacity,transform] duration-300">
              Learn more
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       FEATURED WORK
       ======================================== -->
  <section class="section-padding bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">Portfolio</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">Our Best Work</h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          Selected projects that showcase our expertise across industries and cutting-edge technologies.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredWork.map((project, i) => (
          <a href={project.href || `/portfolio/${project.slug}`} class={`group block bg-white rounded-2xl overflow-hidden shadow-sm glow-card stagger-${i + 1} reveal`}>
            <div class="relative overflow-hidden">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-56 object-cover transform group-hover:scale-110 transition-transform duration-700"
                loading="lazy"
                width="800"
                height="600"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-gray-900/90 via-gray-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
                <div>
                  <div class="flex gap-2 mb-3">
                    {project.tags.map(tag => (
                      <span class="px-2 py-0.5 bg-white/20 backdrop-blur-sm text-white text-xs font-medium rounded-full border border-white/30">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <span class="text-white font-semibold flex items-center gap-2">
                    View Case Study
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </span>
                </div>
              </div>
            </div>
            <div class="p-6">
              <span class="text-sm font-semibold text-primary-600 mb-2 block uppercase tracking-wide">{project.category}</span>
              <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-600 transition-colors">
                {project.title}
              </h3>
              <p class="text-gray-500 text-sm leading-relaxed">{project.description}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-12 reveal">
        <a href="/portfolio" class="btn-ghost group">
          View All Projects
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ========================================
       PROCESS SECTION
       ======================================== -->
  <section class="section-padding bg-white relative overflow-hidden">
    <div class="absolute left-0 top-1/2 -translate-y-1/2 w-64 h-64 bg-accent-50 rounded-full blur-3xl opacity-50"></div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">Our Process</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">How We Work</h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          A battle-tested methodology that delivers exceptional results, every single time.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 relative">
        <!-- Connecting line (desktop) -->
        <div class="hidden lg:block absolute top-16 left-[12.5%] right-[12.5%] h-0.5 z-0">
          <div class="h-full bg-gradient-to-r from-primary-200 via-accent-300 to-primary-200 rounded-full"></div>
        </div>

        {processSteps.map((step, i) => (
          <div class={`relative text-center stagger-${i + 1} reveal`}>
            <div class="relative z-10 inline-flex items-center justify-center w-28 h-28 rounded-full mb-6 animate-pulse-glow" style="background: linear-gradient(135deg, #4F46E5, #06B6D4);">
              <div class="w-24 h-24 rounded-full bg-white flex items-center justify-center">
                <div class="text-center">
                  <div class="text-[0.68rem] font-black uppercase tracking-[0.18em] text-slate-500">{step.icon}</div>
                  <div class="text-sm font-black text-primary-600">{step.number}</div>
                </div>
              </div>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-3">{step.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       TESTIMONIALS
       ======================================== -->
    {showTestimonials && (
    <section class="section-padding bg-gray-50 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-80 h-80 bg-primary-50 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl"></div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">Testimonials</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">What Our Clients Say</h2>
        <p class="text-lg text-gray-500">Don't take our word for it — hear from the companies we've helped grow.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {testimonials.map((t, i) => (
          <div class={`group bg-white rounded-2xl p-8 shadow-sm overflow-hidden relative glow-card stagger-${i + 1} reveal`}>
            <!-- Gradient accent top line -->
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-primary-500 to-accent-400 transform origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
            
            <!-- Result badge -->
            <div class="absolute top-6 right-6 px-3 py-1 bg-primary-50 text-primary-700 text-xs font-bold rounded-full border border-primary-100">
              {t.result}
            </div>

            <!-- Stars -->
            <div class="flex gap-1 mb-5">
              {[...Array(5)].map(() => (
                <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <blockquote class="text-gray-700 mb-6 leading-relaxed text-base italic">
              "{t.quote}"
            </blockquote>

            <div class="flex items-center">
              <div class="relative mr-4">
                <img src={t.avatar} alt={t.name} class="w-12 h-12 rounded-full object-cover ring-2 ring-primary-100" loading="lazy" width="48" height="48"/>
                <div class="absolute -bottom-0.5 -right-0.5 w-4 h-4 bg-green-400 rounded-full border-2 border-white"></div>
              </div>
              <div>
                <div class="font-bold text-gray-900">{t.name}</div>
                <div class="text-sm text-gray-500">{t.role}, <span class="text-primary-600 font-medium">{t.company}</span></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- ========================================
       CTA BANNER
       ======================================== -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 animate-gradient-shift" style="background: linear-gradient(135deg, #2563eb, #0ea5e9, #06b6d4, #2563eb); background-size: 300% 300%;"></div>
    <!-- Animated shapes -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-20 -left-20 w-80 h-80 bg-white/5 rounded-full"></div>
      <div class="absolute -bottom-20 -right-20 w-96 h-96 bg-white/5 rounded-full"></div>
      <div class="absolute top-1/2 left-1/4 w-2 h-2 bg-white/40 rounded-full animate-float"></div>
      <div class="absolute top-1/3 right-1/4 w-3 h-3 bg-white/30 rounded-full animate-float" style="animation-delay:1s;"></div>
      <div class="absolute bottom-1/3 left-1/3 w-2 h-2 bg-white/40 rounded-full animate-float" style="animation-delay:2s;"></div>
    </div>

    <div class="container-custom relative z-10 text-center reveal">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/15 text-white/90 text-sm font-semibold rounded-full border border-white/20 mb-6">
        <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
        Currently accepting new projects
      </span>
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-6 leading-tight">
        Ready to bring your<br>idea to life?
      </h2>
      <p class="text-xl text-white/80 mb-10 max-w-2xl mx-auto">
        Let's collaborate to build something extraordinary.<br>Schedule a free consultation today — no commitment required.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact" class="group inline-flex items-center justify-center px-10 py-4 bg-white text-primary-700 font-bold rounded-xl hover:bg-gray-50 transition-[background-color,box-shadow,transform] duration-300 shadow-2xl hover:shadow-white/25 hover:-translate-y-1 text-lg shine-hover">
          Let's Talk
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="/portfolio" class="inline-flex items-center justify-center px-10 py-4 border-2 border-white/40 text-white font-bold rounded-xl hover:bg-white/10 hover:border-white/70 transition-[background-color,border-color] duration-300 text-lg">
          View Portfolio
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .homepage-hero {
    --hero-border: rgb(148 163 184 / 0.25);
    --hero-grid: rgb(15 118 110 / 0.09);
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(54rem, 100svh);
    padding: clamp(7.5rem, 12vw, 10rem) 0 clamp(4rem, 8vw, 7rem);
    overflow: clip;
    background: linear-gradient(135deg, #f8fafc 0%, #fff 45%, #ecfdf5 100%);
  }

  .homepage-hero__grid,
  .homepage-hero__network {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .homepage-hero__grid {
    opacity: 0.9;
    background-image: linear-gradient(var(--hero-grid) 1px, transparent 1px), linear-gradient(90deg, var(--hero-grid) 1px, transparent 1px);
    background-size: 2.75rem 2.75rem;
    mask-image: linear-gradient(to bottom, black, transparent 86%);
  }

  .homepage-hero__network { opacity: 0.52; }

  .homepage-hero__container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(20rem, 0.85fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 8rem);
    width: min(100% - 2rem, var(--container-wide));
    margin-inline: auto;
  }

  .homepage-hero__content { max-width: 42rem; }

  .homepage-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .homepage-hero__eyebrow::before {
    width: 1.75rem;
    height: 1px;
    content: '';
    background: currentColor;
  }

  .homepage-hero h1 {
    max-width: 11ch;
    margin: 0;
    color: var(--color-text-primary);
    font-size: clamp(3rem, 5.6vw, 5.5rem);
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .homepage-hero__summary {
    max-width: 39rem;
    margin: var(--space-6) 0 0;
    color: var(--color-text-secondary);
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.65;
  }

  .homepage-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  .homepage-hero__primary-action { gap: var(--space-3); padding-inline: var(--space-6); }
  .homepage-hero__primary-action svg { width: 1.25rem; height: 1.25rem; }
  .homepage-hero__secondary-action { padding-inline: var(--space-1); }

  .homepage-hero__assurance {
    margin: var(--space-6) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .homepage-hero__visual {
    position: relative;
    min-width: 0;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border: 1px solid var(--hero-border);
    border-radius: var(--radius-xl);
    background: rgb(255 255 255 / 0.68);
    box-shadow: 0 28px 70px rgb(15 23 42 / 0.1);
    backdrop-filter: blur(14px);
  }

  .homepage-hero__visual::before {
    position: absolute;
    z-index: -1;
    inset: 12% -9% -10% 8%;
    border-radius: 50%;
    content: '';
    background: radial-gradient(circle, rgb(13 148 136 / 0.2), transparent 69%);
    filter: blur(14px);
  }

  .homepage-hero__visual-header,
  .homepage-hero__visual-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .homepage-hero__status { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--color-accent); }
  .homepage-hero__status i,
  .homepage-hero__visual-caption span { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgb(34 197 94 / 0.12); }

  .homepage-hero__map {
    position: relative;
    min-height: clamp(21rem, 32vw, 27rem);
    margin: var(--space-3) 0;
    border: 1px solid rgb(226 232 240 / 0.85);
    border-radius: calc(var(--radius-xl) - 0.25rem);
    background: linear-gradient(145deg, rgb(248 250 252 / 0.84), rgb(255 255 255 / 0.96));
    overflow: hidden;
  }

  .homepage-hero__map::before {
    position: absolute;
    inset: 0;
    content: '';
    opacity: 0.72;
    background-image: radial-gradient(rgb(15 118 110 / 0.18) 0.75px, transparent 0.75px);
    background-size: 0.8rem 0.8rem;
    mask-image: radial-gradient(circle at center, black, transparent 73%);
  }

  .homepage-hero__paths { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .homepage-hero__paths path { fill: none; stroke: rgb(15 118 110 / 0.38); stroke-width: 1.25; stroke-dasharray: 5 6; animation: hero-path-drift 8s linear infinite; }

  .homepage-hero__core {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: clamp(6.3rem, 11vw, 8rem);
    aspect-ratio: 1;
    border: 1px solid rgb(15 118 110 / 0.35);
    border-radius: 50%;
    background: linear-gradient(145deg, #0f766e, #164e63);
    box-shadow: 0 0 0 0.7rem rgb(13 148 136 / 0.08), 0 20px 42px rgb(15 118 110 / 0.26);
    color: #fff;
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .homepage-hero__core span { font-size: clamp(1.25rem, 2.8vw, 1.8rem); font-weight: var(--weight-extrabold); letter-spacing: -0.08em; }
  .homepage-hero__core small { margin-top: -0.8rem; font-size: 0.58rem; font-weight: var(--weight-semibold); letter-spacing: 0.08em; text-transform: uppercase; }

  .homepage-hero__node {
    position: absolute;
    display: grid;
    gap: 0.18rem;
    width: min(10.3rem, 34%);
    padding: 0.85rem 0.9rem;
    border: 1px solid rgb(203 213 225 / 0.95);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.93);
    box-shadow: var(--shadow-sm);
  }

  .homepage-hero__node > span { color: var(--color-accent); font-family: var(--font-mono); font-size: 0.625rem; font-weight: var(--weight-bold); }
  .homepage-hero__node strong { color: var(--color-text-primary); font-size: var(--text-sm); }
  .homepage-hero__node small { color: var(--color-text-muted); font-size: 0.67rem; line-height: 1.35; }
  .homepage-hero__node--web { top: 10%; left: 7%; }
  .homepage-hero__node--mobile { top: 10%; right: 7%; }
  .homepage-hero__node--cloud { bottom: 10%; left: 7%; }
  .homepage-hero__node--ai { right: 7%; bottom: 10%; }

  .homepage-hero__visual-caption { justify-content: flex-start; }

  .homepage-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(30rem circle at var(--hero-x, 50%) var(--hero-y, 35%), rgba(20, 184, 166, 0.16), transparent 62%);
    transition: opacity 250ms ease;
  }

  .homepage-hero.is-interactive::after { opacity: 1; }

  @keyframes hero-path-drift { to { stroke-dashoffset: -44; } }

  @keyframes trustTicker {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
  .animate-trust-ticker {
    animation: trustTicker 22s linear infinite;
  }

  /* Rotating text animation */
  @keyframes textFade {
    0%, 18% { opacity: 1; transform: translateY(0); }
    22%, 96% { opacity: 0; transform: translateY(-20px); }
    100% { opacity: 0; }
  }

  /* Spotlight glow effect for cards */
  .glow-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(280px circle at var(--mouse-x, -999px) var(--mouse-y, -999px), rgba(37, 99, 235, 0.07), transparent 45%);
    z-index: 1;
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: inherit;
  }
  .glow-card:hover::after {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .homepage-hero { min-height: auto; }
    .homepage-hero__container { grid-template-columns: 1fr; gap: var(--space-10); width: min(100% - 2rem, 44rem); }
    .homepage-hero__content { max-width: 40rem; }
    .homepage-hero h1 { max-width: 12ch; }
    .homepage-hero__visual { width: min(100%, 39rem); }
  }

  @media (max-width: 480px) {
    .homepage-hero { padding-top: 7rem; }
    .homepage-hero__actions { align-items: stretch; gap: var(--space-3); }
    .homepage-hero__primary-action { width: 100%; }
    .homepage-hero__secondary-action { width: fit-content; }
    .homepage-hero__visual { padding: 0.8rem; }
    .homepage-hero__status { display: none; }
    .homepage-hero__map { min-height: 20rem; }
    .homepage-hero__node { width: 41%; padding: 0.65rem; }
    .homepage-hero__node small { font-size: 0.6rem; }
    .homepage-hero__node--web { top: 7%; left: 4%; }
    .homepage-hero__node--mobile { top: 7%; right: 4%; }
    .homepage-hero__node--cloud { bottom: 7%; left: 4%; }
    .homepage-hero__node--ai { right: 4%; bottom: 7%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-hero__network { display: none; }
    .homepage-hero__paths path { animation: none; }
  }
</style>

<script>
  const cleanups: Array<() => void> = [];
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function addCleanup(cleanup: () => void) {
    cleanups.push(cleanup);
  }

  function cleanupPage() {
    while (cleanups.length > 0) {
      cleanups.pop()?.();
    }
  }

  function setupNetworkCanvas() {
    const hasLimitedViewport = window.matchMedia('(max-width: 767px)').matches;
    if (prefersReducedMotion || hasLimitedViewport) return;

    const canvas = document.querySelector<HTMLCanvasElement>('#hero-network-canvas');
    const hero = document.querySelector<HTMLElement>('#homepage-hero');
    if (!canvas || !hero) return;

    const context = canvas.getContext('2d');
    if (!context) return;

    const particleCount = 45;
    const particles: Array<{ x: number; y: number; vx: number; vy: number; r: number }> = [];
    let animationFrameId: number | undefined;
    let width = 0;
    let height = 0;
    let isActive = true;
    let mouse = { x: -1000, y: -1000 };

    const resizeCanvas = () => {
      const rect = hero.getBoundingClientRect();
      width = canvas.width = canvas.offsetWidth || rect.width || window.innerWidth;
      height = canvas.height = canvas.offsetHeight || rect.height || window.innerHeight;

      if (particles.length === 0) {
        for (let index = 0; index < particleCount; index += 1) {
          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.45,
            vy: (Math.random() - 0.5) * 0.45,
            r: Math.random() * 2 + 1,
          });
        }
        return;
      }

      particles.forEach((particle) => {
        if (particle.x > width) particle.x = Math.random() * width;
        if (particle.y > height) particle.y = Math.random() * height;
      });
    };

    const draw = () => {
      if (!isActive) return;

      context.clearRect(0, 0, width, height);
      context.fillStyle = 'rgba(13, 148, 136, 0.45)';
      context.strokeStyle = 'rgba(37, 99, 235, 0.08)';

      for (let index = 0; index < particleCount; index += 1) {
        const particle = particles[index];
        if (!particle) continue;

        particle.x += particle.vx;
        particle.y += particle.vy;

        if (particle.x < 0 || particle.x > width) particle.vx *= -1;
        if (particle.y < 0 || particle.y > height) particle.vy *= -1;

        particle.x = Math.max(0, Math.min(width, particle.x));
        particle.y = Math.max(0, Math.min(height, particle.y));

        if (mouse.x > 0) {
          const xDistance = mouse.x - particle.x;
          const yDistance = mouse.y - particle.y;
          const distance = Math.sqrt(xDistance * xDistance + yDistance * yDistance);
          if (distance < 180) {
            particle.x += xDistance * 0.005;
            particle.y += yDistance * 0.005;
          }
        }

        context.beginPath();
        context.arc(particle.x, particle.y, particle.r, 0, Math.PI * 2);
        context.fill();

        for (let otherIndex = index + 1; otherIndex < particleCount; otherIndex += 1) {
          const otherParticle = particles[otherIndex];
          if (!otherParticle) continue;

          const xDistance = particle.x - otherParticle.x;
          const yDistance = particle.y - otherParticle.y;
          const distance = Math.sqrt(xDistance * xDistance + yDistance * yDistance);
          if (distance < 110) {
            context.beginPath();
            context.lineWidth = (1 - distance / 110) * 0.8;
            context.moveTo(particle.x, particle.y);
            context.lineTo(otherParticle.x, otherParticle.y);
            context.stroke();
          }
        }
      }

      animationFrameId = window.requestAnimationFrame(draw);
    };

    const hasFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const updateMousePosition = (event: MouseEvent) => {
      const rect = hero.getBoundingClientRect();
      mouse = { x: event.clientX - rect.left, y: event.clientY - rect.top };
    };
    const resetMousePosition = () => {
      mouse = { x: -1000, y: -1000 };
    };
    const updateHeroSpotlight = (event: PointerEvent) => {
      const rect = hero.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      hero.style.setProperty('--hero-x', `${((event.clientX - rect.left) / rect.width) * 100}%`);
      hero.style.setProperty('--hero-y', `${((event.clientY - rect.top) / rect.height) * 100}%`);
    };

    if (hasFinePointer) {
      hero.classList.add('is-interactive');
      hero.addEventListener('mousemove', updateMousePosition, { passive: true });
      hero.addEventListener('mouseleave', resetMousePosition, { passive: true });
      hero.addEventListener('pointermove', updateHeroSpotlight, { passive: true });
    }

    const resizeObserver = typeof ResizeObserver === 'undefined'
      ? undefined
      : new ResizeObserver(resizeCanvas);
    resizeObserver?.observe(hero);
    window.addEventListener('resize', resizeCanvas, { passive: true });
    resizeCanvas();
    draw();

    addCleanup(() => {
      isActive = false;
      if (animationFrameId !== undefined) window.cancelAnimationFrame(animationFrameId);
      resizeObserver?.disconnect();
      window.removeEventListener('resize', resizeCanvas);
      hero.removeEventListener('mousemove', updateMousePosition);
      hero.removeEventListener('mouseleave', resetMousePosition);
      hero.removeEventListener('pointermove', updateHeroSpotlight);
      hero.classList.remove('is-interactive');
      context.clearRect(0, 0, width, height);
      canvas.width = 0;
      canvas.height = 0;
    });
  }

  function setupCardGlow() {
    if (prefersReducedMotion) return;

    document.querySelectorAll<HTMLElement>('.glow-card').forEach((card) => {
      const updateCardGlow = (event: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mouse-x', `${event.clientX - rect.left}px`);
        card.style.setProperty('--mouse-y', `${event.clientY - rect.top}px`);
      };

      card.addEventListener('mousemove', updateCardGlow, { passive: true });
      addCleanup(() => card.removeEventListener('mousemove', updateCardGlow));
    });
  }

  setupNetworkCanvas();
  setupCardGlow();

  window.addEventListener('pagehide', cleanupPage, { once: true });
  document.addEventListener('astro:before-swap', cleanupPage, { once: true });
</script>
