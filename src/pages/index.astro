---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { loadSiteContent } from '../lib/siteContent';

const services = [
  {
    icon: 'web',
    title: 'Web Development',
    description: 'Custom web applications built with modern frameworks — React, Next.js, Astro — engineered to scale.',
    href: '/services#web',
    color: 'from-indigo-500 to-blue-500',
    tags: ['React', 'Next.js', 'Astro'],
  },
  {
    icon: 'mobile',
    title: 'Mobile Apps',
    description: 'Native iOS & Android apps with React Native & Flutter — shipped to both stores with design polish.',
    href: '/services#mobile',
    color: 'from-blue-500 to-cyan-500',
    tags: ['React Native', 'Flutter', 'Swift'],
  },
  {
    icon: 'qa',
    title: 'Quality Assurance',
    description: 'Comprehensive manual and automated testing that catches bugs before your users do.',
    href: '/services#qa',
    color: 'from-pink-500 to-rose-500',
    tags: ['Playwright', 'Cypress', 'Manual QA'],
  },
  {
    icon: 'backend',
    title: 'Backend Development',
    description: 'Robust APIs, databases, and business logic built for performance, security, and scale.',
    href: '/services#backend',
    color: 'from-cyan-500 to-sky-500',
    tags: ['Node.js', 'Supabase', 'PostgreSQL'],
  },
  {
    icon: 'ai',
    title: 'AI / ML Integration',
    description: 'Intelligent features powered by the latest LLMs, embeddings, and ML pipelines.',
    href: '/services#ai',
    color: 'from-emerald-500 to-teal-500',
    tags: ['OpenAI', 'LangChain', 'Python'],
  },
  {
    icon: 'consulting',
    title: 'Tech Consulting',
    description: 'Architecture reviews, edtech programs, teacher training, and technical strategy guidance.',
    href: '/services#consulting',
    color: 'from-amber-500 to-orange-500',
    tags: ['Architecture', 'EdTech', 'Strategy'],
  },
];

const techStack = [
  'React', 'Next.js', 'Astro', 'Vue', 'TypeScript',
  'Node.js', 'Python', 'PostgreSQL', 'Supabase', 'Redis',
  'React Native', 'Flutter', 'Swift', 'Kotlin',
  'Tailwind CSS', 'Figma', 'AWS', 'Vercel', 'Docker', 'Git',
  'OpenAI', 'LangChain', 'Playwright', 'Stripe', 'Firebase',
];

const whyUs = [
  {
    emoji: '🚀',
    title: 'Startup-Friendly',
    description: 'We understand tight timelines and lean budgets. We move fast without cutting corners.',
    color: 'from-indigo-500 to-blue-500',
  },
  {
    emoji: '🎯',
    title: 'Dedicated Team',
    description: 'You work with senior engineers directly — no account managers or outsourced handoffs.',
    color: 'from-blue-500 to-cyan-500',
  },
  {
    emoji: '✅',
    title: 'On-Time Delivery',
    description: 'We plan honestly, report transparently, and deliver what we commit to, every time.',
    color: 'from-emerald-500 to-teal-500',
  },
  {
    emoji: '🔒',
    title: 'Security-First',
    description: 'Every line of code follows security best practices — from auth to data access to deployment.',
    color: 'from-amber-500 to-orange-500',
  },
];

const processSteps = [
  {
    number: '01',
    title: 'Discovery & Strategy',
    description: 'Deep-dive into your goals, audience, and competitive landscape to define a bulletproof roadmap.',
    icon: '🗺️',
  },
  {
    number: '02',
    title: 'Design & Prototype',
    description: 'Stunning interfaces and interactive prototypes that bring your vision to life before a line of code is written.',
    icon: '✏️',
  },
  {
    number: '03',
    title: 'Build & Test',
    description: 'Clean, scalable code with rigorous automated testing ensuring flawless performance at every scale.',
    icon: '⚙️',
  },
  {
    number: '04',
    title: 'Launch & Support',
    description: 'Deploy with confidence and ongoing support to keep your product thriving and evolving.',
    icon: '🚀',
  },
];

const trustHighlights = [
  '✦ Strong Client Satisfaction',
  '✦ Cross-Industry Delivery Experience',
  '✦ Responsive Project Communication',
  '✦ Reliable Long-Term Partner',
  '✦ On-Time, On-Budget Delivery',
  '✦ Transparent Progress Reporting',
  '✦ Security-First Engineering',
  '✦ Modern Tech Stack',
];

const { testimonials, projects } = await loadSiteContent();
const featuredWork = projects.filter((project) => project.featured).slice(0, 3);
const showTestimonials = false;
---

<BaseLayout
  title="Home"
  description="TechMigos designs and builds web apps, mobile apps, backend systems, QA automation, AI integrations, and consulting programs for startups and growing companies."
>

  <!-- ========================================
       HERO SECTION
       ======================================== -->
  <section id="homepage-hero" class="homepage-hero relative min-h-screen flex items-center overflow-hidden bg-white pt-20">
    <!-- Animated gradient mesh background -->
    <div class="absolute inset-0" style="z-index:0;">
      <div class="absolute inset-0" style="background: radial-gradient(ellipse 80% 60% at 60% -10%, rgba(99,102,241,0.10) 0%, transparent 60%), radial-gradient(ellipse 60% 50% at 10% 60%, rgba(6,182,212,0.08) 0%, transparent 55%), radial-gradient(ellipse 50% 40% at 90% 90%, rgba(236,72,153,0.05) 0%, transparent 55%), #ffffff;"></div>
      <div class="absolute inset-0 grid-pattern opacity-50"></div>
    </div>

    <!-- Canvas for interactive neural particle network background -->
    <canvas id="hero-network-canvas" class="absolute inset-0 pointer-events-none opacity-40" style="z-index: 1;"></canvas>

    <!-- Animated gradient blobs -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -right-40 w-[650px] h-[650px] bg-primary-200 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob"></div>
      <div class="absolute top-40 -left-40 w-[500px] h-[500px] bg-accent-200 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob" style="animation-delay: 2s;"></div>
      <div class="absolute -bottom-40 left-1/2 w-[500px] h-[500px] bg-sky-200 rounded-full mix-blend-multiply filter blur-3xl opacity-15 animate-blob" style="animation-delay: 4s;"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <!-- Left: Content -->
        <div class="text-left max-w-2xl">
          <!-- Eyebrow -->
          <div class="reveal stagger-1 flex mb-6">
            <span class="section-eyebrow">
              <span class="w-2 h-2 rounded-full bg-primary-500 animate-pulse inline-block"></span>
              Startup-friendly · Enterprise-ready
            </span>
          </div>

          <!-- Main heading -->
          <h1 class="reveal stagger-2 text-5xl sm:text-6xl lg:text-7xl font-extrabold text-gray-900 leading-[1.04] tracking-tight mb-6 text-balance" style="font-family:'Syne',sans-serif;">
            We Build Software<br>
            That <span class="text-gradient" id="rotating-text">Scales&nbsp;With&nbsp;You</span>
          </h1>

          <p class="reveal stagger-3 text-xl sm:text-2xl text-gray-500 mb-8 leading-relaxed max-w-xl">
            TechMigos partners with startups and enterprises to design, build, and ship
            <strong class="text-gray-700">world-class digital products</strong> that drive growth.
          </p>

          <div class="reveal stagger-4 flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="btn-primary text-base px-8 py-4 shine-hover group">
              Start a Project
              <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href="/portfolio" class="btn-ghost text-base px-8 py-4 group">
              <svg class="w-5 h-5 mr-2 group-hover:scale-125 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              See Our Work
            </a>
          </div>

          <!-- Capability chips -->
          <div class="reveal stagger-5 mt-10 flex flex-wrap gap-2">
            {['Web Apps', 'Mobile Apps', 'AI/ML', 'Backend APIs', 'QA Testing', 'EdTech'].map(tag => (
              <span class="tech-pill">{tag}</span>
            ))}
          </div>
        </div>

        <!-- Right: Floating product preview card -->
        <div class="reveal stagger-3 hidden lg:block relative">
          <!-- Main showcase card -->
          <div class="relative glass-card rounded-3xl p-6 border border-white/60 shadow-2xl animate-float" style="background: rgba(255,255,255,0.85); backdrop-filter: blur(20px);">
            <!-- Card header -->
            <div class="flex items-center justify-between mb-5">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-cyan-400 flex items-center justify-center shadow-lg">
                  <span class="text-white text-lg">🎯</span>
                </div>
                <div>
                  <div class="font-bold text-gray-900 text-sm">FocusFlow</div>
                  <div class="text-xs text-gray-400">Productivity Mobile App</div>
                </div>
              </div>
              <span class="badge-accent text-xs">Live</span>
            </div>

            <!-- Mini screen mockup -->
            <div class="rounded-xl overflow-hidden bg-gray-950 mb-4 relative" style="height: 180px;">
              <div class="absolute inset-0 flex items-center justify-center">
                <img
                  src="/images/portfolio/focusflow/screenshots/screen-01.webp"
                  alt="FocusFlow app screenshot"
                  class="h-full w-full object-cover object-top opacity-90"
                  loading="eager"
                  width="400"
                  height="300"
                />
              </div>
              <!-- Overlay gradient -->
              <div class="absolute inset-0 bg-gradient-to-t from-gray-950/30 to-transparent"></div>
            </div>

            <!-- Stats row -->
            <div class="grid grid-cols-3 gap-3 text-center">
              {[
                { label: 'Screens', value: '25+' },
                { label: 'Timers', value: '3' },
                { label: 'Sounds', value: '6' },
              ].map(s => (
                <div class="bg-gray-50 rounded-xl p-2.5">
                  <div class="text-base font-black text-primary-600">{s.value}</div>
                  <div class="text-[10px] text-gray-400 font-medium uppercase tracking-wide">{s.label}</div>
                </div>
              ))}
            </div>
          </div>

          <!-- Secondary floating card: Hastkala -->
          <div
            class="absolute -bottom-10 -left-12 w-56 glass-card rounded-2xl p-4 border border-white/60 shadow-xl animate-float-slow"
            style="background: rgba(255,255,255,0.9); backdrop-filter: blur(16px); animation-delay: 1.5s;"
          >
            <div class="flex items-center gap-2.5 mb-2">
              <span class="text-xl">🏺</span>
              <div>
                <div class="text-xs font-bold text-gray-900">Hastkala</div>
                <div class="text-[10px] text-gray-400">E-Commerce Platform</div>
              </div>
            </div>
            <div class="flex gap-1 flex-wrap">
              <span class="tech-pill text-[10px]">Next.js</span>
              <span class="tech-pill text-[10px]">Tailwind</span>
            </div>
          </div>

          <!-- Floating badge: Currently accepting -->
          <div
            class="absolute -top-4 -right-4 glass-card rounded-2xl px-4 py-2.5 border border-white/60 shadow-xl"
            style="background: rgba(255,255,255,0.95); backdrop-filter: blur(12px);"
          >
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
              <span class="text-xs font-semibold text-gray-700">Open for Projects</span>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50">
      <span class="text-xs text-gray-400 uppercase tracking-widest">Scroll</span>
      <div class="w-px h-8 bg-gradient-to-b from-gray-400 to-transparent animate-pulse"></div>
    </div>
  </section>

  <!-- ========================================
       TRUST TICKER STRIP
       ======================================== -->
  <section class="py-8 bg-gray-50 border-y border-gray-100 overflow-hidden" aria-hidden="true">
    <div class="relative">
      <div class="flex w-max animate-trust-ticker whitespace-nowrap">
        {[...trustHighlights, ...trustHighlights].map((item) => (
          <div class="mx-4 px-5 py-2.5 rounded-full bg-white border border-gray-200 shadow-sm text-sm font-semibold text-gray-600 flex-shrink-0">
            {item}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       SERVICES SECTION
       ======================================== -->
  <section class="section-padding bg-white relative overflow-hidden" id="services">
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary-50 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl opacity-60"></div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">What We Do</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4" style="font-family:'Syne',sans-serif;">End-to-End Technology</h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          From concept to launch — comprehensive services that take your product from idea to market and beyond.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service, i) => (
          <a
            href={service.href}
            class={`group relative bg-white rounded-2xl p-7 border border-gray-100 glow-card tilt-card stagger-${i + 1} reveal overflow-hidden`}
          >
            <!-- Gradient corner accent -->
            <div class={`absolute top-0 right-0 w-36 h-36 bg-gradient-to-bl ${service.color} opacity-0 group-hover:opacity-6 transition-opacity duration-500 rounded-bl-3xl rounded-tr-2xl`}></div>

            <!-- Icon -->
            <div class={`w-14 h-14 rounded-xl bg-gradient-to-br ${service.color} flex items-center justify-center mb-5 shadow-lg group-hover:scale-110 group-hover:rotate-3 transition-[transform,box-shadow] duration-300`}>
              <ServiceIcon name={service.icon} class="w-7 h-7 text-white" />
            </div>

            <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-600 transition-colors">
              {service.title}
            </h3>
            <p class="text-gray-500 leading-relaxed text-sm mb-4">{service.description}</p>

            <!-- Tech tags -->
            <div class="flex flex-wrap gap-1.5">
              {service.tags.map(tag => (
                <span class="tech-pill">{tag}</span>
              ))}
            </div>

            <!-- Arrow -->
            <div class="mt-5 flex items-center text-primary-600 font-semibold text-sm opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-[opacity,transform] duration-300">
              Learn more
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-12 reveal">
        <a href="/services" class="btn-ghost group">
          View All Services
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <div class="section-divider mx-8 lg:mx-24"></div>

  <!-- ========================================
       FEATURED WORK
       ======================================== -->
  <section class="section-padding bg-gray-50" id="work">
    <div class="container-custom">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">Portfolio</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4" style="font-family:'Syne',sans-serif;">Products We've Built</h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          Real products we've designed and shipped — from artisan marketplaces to mindful mobile apps.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredWork.map((project, i) => (
          <a href={project.href || `/portfolio/${project.slug}`} class={`group block bg-white rounded-2xl overflow-hidden shadow-sm glow-card stagger-${i + 1} reveal`}>
            <div class="relative overflow-hidden" style="height: 220px;">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
                loading="lazy"
                width="800"
                height="440"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-5">
                <span class="text-white font-semibold flex items-center gap-2 text-sm">
                  View Case Study
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </span>
              </div>
              <!-- Category badge on image -->
              <div class="absolute top-3 left-3">
                <span class="badge-dark">{project.emoji} {project.category}</span>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-600 transition-colors">
                {project.title}
              </h3>
              <p class="text-gray-500 text-sm leading-relaxed mb-4">{project.description}</p>
              <div class="flex flex-wrap gap-1.5">
                {project.tags.slice(0,3).map(tag => (
                  <span class="tech-pill">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-12 reveal">
        <a href="/portfolio" class="btn-ghost group">
          View All Projects
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <div class="section-divider mx-8 lg:mx-24"></div>

  <!-- ========================================
       TECH STACK MARQUEE
       ======================================== -->
  <section class="py-16 bg-white overflow-hidden" aria-label="Technologies we use">
    <div class="container-custom mb-8 reveal text-center">
      <span class="section-eyebrow">Our Stack</span>
      <h2 class="text-3xl font-bold text-gray-900 mt-2" style="font-family:'Syne',sans-serif;">Technologies We Master</h2>
    </div>
    <!-- Row 1: left to right -->
    <div class="relative flex overflow-hidden mb-4" aria-hidden="true">
      <div class="flex w-max animate-marquee gap-3 whitespace-nowrap">
        {[...techStack, ...techStack].map((tech) => (
          <span class="px-5 py-2.5 rounded-full bg-gray-50 border border-gray-200 text-sm font-semibold text-gray-700 flex-shrink-0 hover:bg-primary-50 hover:border-primary-200 hover:text-primary-700 transition-colors duration-200">
            {tech}
          </span>
        ))}
      </div>
    </div>
    <!-- Row 2: right to left -->
    <div class="relative flex overflow-hidden" aria-hidden="true">
      <div class="flex w-max animate-marquee-reverse gap-3 whitespace-nowrap">
        {[...techStack.slice(10), ...techStack, ...techStack.slice(0, 10)].map((tech) => (
          <span class="px-5 py-2.5 rounded-full bg-gray-50 border border-gray-200 text-sm font-semibold text-gray-700 flex-shrink-0 hover:bg-accent-50 hover:border-accent-200 hover:text-accent-700 transition-colors duration-200">
            {tech}
          </span>
        ))}
      </div>
    </div>
  </section>

  <div class="section-divider mx-8 lg:mx-24"></div>

  <!-- ========================================
       WHY TECHMIGOS
       ======================================== -->
  <section class="section-padding bg-gray-50 relative overflow-hidden" id="why-us">
    <div class="absolute top-0 left-0 w-96 h-96 bg-accent-50 rounded-full -translate-x-1/2 -translate-y-1/2 blur-3xl opacity-50"></div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">Why TechMigos</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4" style="font-family:'Syne',sans-serif;">Built Different</h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          We're not a typical agency. We're a tight-knit product engineering team that cares about your outcomes.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {whyUs.map((item, i) => (
          <div class={`reveal stagger-${i + 1} group bg-white rounded-2xl p-7 border border-gray-100 glow-card text-center`}>
            <div class={`w-16 h-16 rounded-2xl bg-gradient-to-br ${item.color} flex items-center justify-center mb-5 mx-auto shadow-md group-hover:scale-110 group-hover:rotate-3 transition-[transform] duration-300`}>
              <span class="text-2xl" role="img" aria-label={item.title}>{item.emoji}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{item.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="section-divider mx-8 lg:mx-24"></div>

  <!-- ========================================
       PROCESS SECTION
       ======================================== -->
  <section class="section-padding bg-white relative overflow-hidden" id="process">
    <div class="absolute right-0 top-1/2 -translate-y-1/2 w-64 h-64 bg-accent-50 rounded-full translate-x-1/2 blur-3xl opacity-50"></div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">Our Process</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4" style="font-family:'Syne',sans-serif;">How We Work</h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          A battle-tested methodology that delivers exceptional results, every single time.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 relative">
        <!-- Connecting line (desktop only) -->
        <div class="hidden lg:block absolute top-16 left-[12.5%] right-[12.5%] h-0.5 z-0">
          <div class="h-full bg-gradient-to-r from-primary-200 via-accent-300 to-primary-200 rounded-full"></div>
        </div>

        {processSteps.map((step, i) => (
          <div class={`relative text-center stagger-${i + 1} reveal`}>
            <div class="relative z-10 inline-flex items-center justify-center w-28 h-28 rounded-full mb-6 animate-pulse-glow" style="background: linear-gradient(135deg, #4F46E5, #06B6D4);">
              <div class="w-24 h-24 rounded-full bg-white flex items-center justify-center">
                <div class="text-center">
                  <div class="text-2xl mb-0.5" role="img" aria-label={step.title}>{step.icon}</div>
                  <div class="text-xs font-black text-primary-600">{step.number}</div>
                </div>
              </div>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-3">{step.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       TESTIMONIALS (hidden until real ones exist)
       ======================================== -->
  {showTestimonials && testimonials.length > 0 && (
  <section class="section-padding bg-gray-50 relative overflow-hidden">
    <div class="container-custom relative z-10">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">Testimonials</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4" style="font-family:'Syne',sans-serif;">What Our Clients Say</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {testimonials.map((t, i) => (
          <div class={`group bg-white rounded-2xl p-8 shadow-sm overflow-hidden relative glow-card stagger-${i + 1} reveal`}>
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-primary-500 to-accent-400 transform origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
            <blockquote class="text-gray-700 mb-6 leading-relaxed italic">"{t.quote}"</blockquote>
            <div class="flex items-center">
              <div class="font-bold text-gray-900">{t.name}</div>
              <div class="text-sm text-gray-500 ml-2">{t.role}, {t.company}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- ========================================
       CTA BANNER
       ======================================== -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 animate-gradient-shift" style="background: linear-gradient(135deg, #2563eb, #0ea5e9, #06b6d4, #2563eb); background-size: 300% 300%;"></div>
    <!-- Noise overlay for depth -->
    <div class="absolute inset-0 opacity-[0.03] cta-noise-overlay"></div>
    <!-- Animated shapes -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-20 -left-20 w-80 h-80 bg-white/5 rounded-full"></div>
      <div class="absolute -bottom-20 -right-20 w-96 h-96 bg-white/5 rounded-full"></div>
      <div class="absolute top-1/3 left-1/4 w-2 h-2 bg-white/40 rounded-full animate-float"></div>
      <div class="absolute top-2/3 right-1/4 w-3 h-3 bg-white/30 rounded-full animate-float" style="animation-delay:1.5s;"></div>
      <div class="absolute bottom-1/3 left-2/3 w-2 h-2 bg-white/35 rounded-full animate-float" style="animation-delay:3s;"></div>
    </div>

    <div class="container-custom relative z-10 text-center reveal">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/15 text-white/90 text-sm font-semibold rounded-full border border-white/20 mb-6">
        <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
        Currently accepting new projects
      </span>
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-6 leading-tight text-balance" style="font-family:'Syne',sans-serif;">
        Ready to bring your<br>idea to life?
      </h2>
      <p class="text-xl text-white/80 mb-10 max-w-2xl mx-auto">
        Let's collaborate to build something extraordinary.<br>Schedule a free consultation — no commitment required.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact" class="group inline-flex items-center justify-center px-10 py-4 bg-white text-primary-700 font-bold rounded-xl hover:bg-gray-50 transition-[background-color,box-shadow,transform] duration-300 shadow-2xl hover:shadow-white/20 hover:-translate-y-1 text-lg shine-hover">
          Let's Talk
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="/portfolio" class="inline-flex items-center justify-center px-10 py-4 border-2 border-white/40 text-white font-bold rounded-xl hover:bg-white/10 hover:border-white/70 transition-[background-color,border-color] duration-300 text-lg">
          View Portfolio
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .homepage-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(30rem circle at var(--hero-x, 50%) var(--hero-y, 35%), rgba(20, 184, 166, 0.10), transparent 62%);
    transition: opacity 250ms ease;
  }
  .homepage-hero.is-interactive::after { opacity: 1; }

  /* Glow card spotlight */
  .glow-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(280px circle at var(--mouse-x, -999px) var(--mouse-y, -999px), rgba(37, 99, 235, 0.06), transparent 45%);
    z-index: 1;
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: inherit;
  }
  .glow-card:hover::after { opacity: 1; }

  .cta-noise-overlay {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }
</style>

<script>
  // Rotating hero text
  const phrases = ['Scales With You', 'Drives Growth', 'Wins Markets', 'Delights Users', 'Makes an Impact'];
  let currentPhrase = 0;
  const el = document.getElementById('rotating-text');

  if (el) {
    setInterval(() => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(-12px)';
      el.style.transition = 'opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
      setTimeout(() => {
        currentPhrase = (currentPhrase + 1) % phrases.length;
        el.textContent = phrases[currentPhrase];
        el.style.transform = 'translateY(12px)';
        el.style.opacity = '0';
        setTimeout(() => {
          el.style.transform = 'translateY(0)';
          el.style.opacity = '1';
        }, 50);
      }, 400);
    }, 3200);
  }

  // Hero canvas neural network
  const hero = document.getElementById('homepage-hero');
  const canvas = document.getElementById('hero-network-canvas') as HTMLCanvasElement;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !prefersReduced) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      let width = 0, height = 0;
      const particles: Array<{x: number, y: number, vx: number, vy: number, r: number}> = [];
      const particleCount = 40;
      let mouse = { x: -1000, y: -1000 };

      function resize() {
        width = canvas.width = canvas.offsetWidth || window.innerWidth;
        height = canvas.height = canvas.offsetHeight || window.innerHeight;
        if (particles.length === 0) {
          for (let i = 0; i < particleCount; i++) {
            particles.push({ x: Math.random() * width, y: Math.random() * height, vx: (Math.random() - 0.5) * 0.4, vy: (Math.random() - 0.5) * 0.4, r: Math.random() * 1.8 + 0.8 });
          }
        }
      }

      const hasFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (hero && hasFinePointer) {
        hero.addEventListener('mousemove', (e) => {
          const rect = hero.getBoundingClientRect();
          mouse.x = e.clientX - rect.left;
          mouse.y = e.clientY - rect.top;
          hero.style.setProperty('--hero-x', `${((e.clientX - rect.left) / rect.width) * 100}%`);
          hero.style.setProperty('--hero-y', `${((e.clientY - rect.top) / rect.height) * 100}%`);
        }, { passive: true });
        hero.addEventListener('mouseleave', () => { mouse.x = -1000; mouse.y = -1000; }, { passive: true });
        hero.classList.add('is-interactive');
      }

      window.addEventListener('resize', resize, { passive: true });
      resize();

      function draw() {
        ctx.clearRect(0, 0, width, height);
        ctx.fillStyle = 'rgba(13, 148, 136, 0.35)';
        ctx.strokeStyle = 'rgba(37, 99, 235, 0.07)';

        for (let i = 0; i < particleCount; i++) {
          const p = particles[i];
          if (!p) continue;
          p.x += p.vx; p.y += p.vy;
          if (p.x < 0 || p.x > width) p.vx *= -1;
          if (p.y < 0 || p.y > height) p.vy *= -1;
          p.x = Math.max(0, Math.min(width, p.x));
          p.y = Math.max(0, Math.min(height, p.y));

          if (mouse.x > 0) {
            const dx = mouse.x - p.x, dy = mouse.y - p.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 160) { p.x += dx * 0.004; p.y += dy * 0.004; }
          }

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();

          for (let j = i + 1; j < particleCount; j++) {
            const p2 = particles[j];
            if (!p2) continue;
            const dx = p.x - p2.x, dy = p.y - p2.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 100) {
              ctx.beginPath();
              ctx.lineWidth = (1 - dist / 100) * 0.7;
              ctx.moveTo(p.x, p.y);
              ctx.lineTo(p2.x, p2.y);
              ctx.stroke();
            }
          }
        }
        requestAnimationFrame(draw);
      }
      draw();
    }
  }

  // Glow card mouse tracking
  if (!prefersReduced) {
    document.querySelectorAll('.glow-card').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const me = e as MouseEvent;
        const rect = (card as HTMLElement).getBoundingClientRect();
        (card as HTMLElement).style.setProperty('--mouse-x', `${me.clientX - rect.left}px`);
        (card as HTMLElement).style.setProperty('--mouse-y', `${me.clientY - rect.top}px`);
      }, { passive: true });
    });
  }
</script>
