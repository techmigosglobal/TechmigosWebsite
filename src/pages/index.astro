---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import HomeInsightCard from '../components/home/HomeInsightCard.astro';
import HomeProcessStep from '../components/home/HomeProcessStep.astro';
import HomeProjectCard from '../components/home/HomeProjectCard.astro';
import HomeSectionHeading from '../components/home/HomeSectionHeading.astro';
import HomeServiceCard from '../components/home/HomeServiceCard.astro';
import HomeTechnologyGroup from '../components/home/HomeTechnologyGroup.astro';
import { getCollection } from 'astro:content';
import { loadSiteContent } from '../lib/siteContent';

const services = [
  {
    icon: 'web',
    title: 'Web application development',
    problem: 'Turn a manual, fragmented, or outdated web experience into a product people can use with confidence.',
    deliverable: 'Responsive product interfaces, accessible user journeys, and maintainable application foundations.',
    platform: 'Web products',
    href: '/services#web',
  },
  {
    icon: 'mobile',
    title: 'Mobile application development',
    problem: 'Meet customers and teams where their work happens: on Android, iOS, and cross-platform devices.',
    deliverable: 'Native-feeling mobile flows, device-aware UX, and release-ready application delivery.',
    platform: 'Android, iOS, Flutter',
    href: '/services#mobile',
  },
  {
    icon: 'qa',
    title: 'Quality assurance and testing',
    problem: 'Reduce release uncertainty before defects become expensive user-facing problems.',
    deliverable: 'Test strategy, manual exploration, automated checks, and cross-device release review.',
    platform: 'Web, mobile, API',
    href: '/services#qa',
  },
  {
    icon: 'backend',
    title: 'Cloud and backend systems',
    problem: 'Give product ideas reliable workflows, data boundaries, and integrations behind the interface.',
    deliverable: 'APIs, data models, authentication-aware workflows, and deployment-ready services.',
    platform: 'Backend and data',
    href: '/services#backend',
  },
  {
    icon: 'ai',
    title: 'Applied AI and automation',
    problem: 'Find practical ways to make repetitive work, search, guidance, or analysis more useful.',
    deliverable: 'Evaluated AI features, automation flows, and human-centered product integrations.',
    platform: 'AI-enabled workflows',
    href: '/services#ai',
  },
  {
    icon: 'consulting',
    title: 'Product strategy and modernization',
    problem: 'Make high-stakes technology decisions with a clearer view of user needs, risks, and delivery paths.',
    deliverable: 'Discovery, architecture guidance, technical education, and a practical next-step plan.',
    platform: 'Strategy and consulting',
    href: '/services#consulting',
  },
];

const trustHighlights = [
  'Web, mobile, cloud, and applied AI delivery',
  'Android, iOS, and responsive web product experience',
  'Product strategy through deployment',
  'Education, productivity, and business-software product work',
];

const processSteps = [
  {
    number: '01',
    title: 'Discover',
    description: 'Understand the problem, people, existing system, and constraints before choosing a solution.',
  },
  {
    number: '02',
    title: 'Define',
    description: 'Turn the strongest insights into a focused scope, delivery plan, and success criteria.',
  },
  {
    number: '03',
    title: 'Design',
    description: 'Shape clear content, journeys, interface states, and technical decisions before implementation grows.',
  },
  {
    number: '04',
    title: 'Build',
    description: 'Implement the product in small, reviewable pieces with maintainability in mind.',
  },
  {
    number: '05',
    title: 'Test',
    description: 'Review critical workflows, devices, accessibility, and edge cases before release.',
  },
  {
    number: '06',
    title: 'Launch',
    description: 'Prepare the delivery path, monitor the release, and make handoff details explicit.',
  },
  {
    number: '07',
    title: 'Improve',
    description: 'Use what the product team learns next to refine the experience and plan the next increment.',
  },
];

const technologyGroups = [
  { title: 'Frontend and web', description: 'Interfaces and web products built for real users, content, and business workflows.', technologies: ['Astro', 'React', 'Next.js', 'TypeScript', 'Tailwind CSS'] },
  { title: 'Mobile products', description: 'Cross-platform and native-minded application experiences for mobile teams and customers.', technologies: ['Flutter', 'React Native', 'Swift', 'Kotlin', 'Firebase'] },
  { title: 'Backend and data', description: 'Application services, data models, integrations, and product operations behind the interface.', technologies: ['Node.js', 'Python', 'PostgreSQL', 'Supabase', 'REST APIs'] },
  { title: 'Cloud and deployment', description: 'Practical environments and delivery workflows for web, mobile, and backend releases.', technologies: ['Vercel', 'AWS', 'Docker', 'CI/CD', 'GitHub Actions'] },
  { title: 'AI and automation', description: 'Applied capabilities selected for a clear user or operations need—not novelty alone.', technologies: ['OpenAI', 'LLM workflows', 'TensorFlow', 'PyTorch', 'Automation'] },
];

const principles = [
  { title: 'Think before coding', description: 'We start with the workflow, audience, constraints, and evidence so delivery has a reasoned direction.' },
  { title: 'Build for the whole product', description: 'Product strategy, UX, interface, backend, QA, and release decisions work better when they connect.' },
  { title: 'Keep the foundation maintainable', description: 'Clear architecture, accessible patterns, and testable increments make future product work easier.' },
  { title: 'Make progress visible', description: 'Small reviewable steps and direct communication help teams make decisions without losing context.' },
];

const { projects } = await loadSiteContent();
const selectedWorkSlugs = ['focus-today', 'techmigos-hub', 'focusflow'];
const featuredWork = selectedWorkSlugs
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));
const homepageInsights = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home" description="TechMigos designs and builds web apps, mobile apps, backend systems, QA automation, AI integrations, and consulting programs for schools, teachers, startups, and growing companies.">

  <!-- ========================================
       HERO SECTION
       ======================================== -->
  <section id="homepage-hero" class="homepage-hero" aria-labelledby="homepage-hero-title">
    <div class="homepage-hero__grid" aria-hidden="true"></div>
    <canvas id="hero-network-canvas" class="homepage-hero__network" aria-hidden="true"></canvas>

    <div class="homepage-hero__container">
      <div class="homepage-hero__content">
        <p class="homepage-hero__eyebrow">Product engineering for ambitious teams</p>
        <h1 id="homepage-hero-title">We build digital products people remember.</h1>
        <p class="homepage-hero__summary">
          Strategy, UX, web, mobile, cloud, and applied AI—planned and delivered by one accountable product team.
        </p>
        <div class="homepage-hero__actions">
          <a href="/contact" class="btn-primary homepage-hero__primary-action" data-magnetic>
            Start a project
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
          <a href="/portfolio" class="btn-link homepage-hero__secondary-action">Explore our work <span aria-hidden="true">↗</span></a>
        </div>
        <p class="homepage-hero__assurance">From the first decision to the first release.</p>
      </div>

      <div class="homepage-hero__visual" aria-label="TechMigos capabilities: web, mobile, cloud, and AI connected through one product delivery core.">
        <div class="homepage-hero__visual-header">
          <span>TechMigos delivery system</span>
          <span class="homepage-hero__status"><i aria-hidden="true"></i> Ready to build</span>
        </div>
        <div class="homepage-hero__map">
          <svg class="homepage-hero__paths" viewBox="0 0 520 420" aria-hidden="true" focusable="false">
            <path d="M126 104C186 116 203 154 260 210" />
            <path d="M394 104C334 116 317 154 260 210" />
            <path d="M126 316C186 304 203 266 260 210" />
            <path d="M394 316C334 304 317 266 260 210" />
          </svg>
          <div class="homepage-hero__core" aria-hidden="true"><span>TM</span><small>Product core</small></div>
          <div class="homepage-hero__node homepage-hero__node--web"><span>01</span><strong>Web</strong><small>Experiences that convert</small></div>
          <div class="homepage-hero__node homepage-hero__node--mobile"><span>02</span><strong>Mobile</strong><small>Useful, native-feeling apps</small></div>
          <div class="homepage-hero__node homepage-hero__node--cloud"><span>03</span><strong>Cloud</strong><small>Systems built to evolve</small></div>
          <div class="homepage-hero__node homepage-hero__node--ai"><span>04</span><strong>Applied AI</strong><small>Intelligence with purpose</small></div>
        </div>
        <p class="homepage-hero__visual-caption"><span aria-hidden="true"></span> One team, connected delivery</p>
      </div>
    </div>
  </section>

  <section class="home-trust" aria-labelledby="home-trust-title">
    <div class="home-container home-trust__layout">
      <div>
        <p class="home-kicker">Built around useful proof</p>
        <h2 id="home-trust-title">Capability-led delivery, from a single product team.</h2>
      </div>
      <ul class="home-trust__list">
        {trustHighlights.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <!-- ========================================
       SERVICES SECTION
       ======================================== -->
  <section class="home-section home-services" aria-labelledby="home-services-title">
    <div class="home-container">
      <HomeSectionHeading
        id="home-services-title"
        eyebrow="Services and capabilities"
        title="Make the next version of your product easier to use, run, and evolve."
        description="TechMigos brings the product decisions, engineering disciplines, and delivery work together around the problem that matters."
      />
      <div class="home-services__grid">
        {services.map((service) => <HomeServiceCard {...service} />)}
      </div>
    </div>
  </section>

  <section class="home-section home-work" aria-labelledby="home-work-title">
    <div class="home-container">
      <div class="home-work__heading">
        <HomeSectionHeading
          id="home-work-title"
          eyebrow="Selected products"
          title="Product work that starts with a real use case."
          description="A selection of real TechMigos product directions across civic information, team productivity, and focused work."
        />
        <a href="/portfolio" class="btn-link">Explore all products <span aria-hidden="true">↗</span></a>
      </div>
      <div class="home-work__grid">
        {featuredWork.map((project) => <HomeProjectCard {...project} href={project.href || `/portfolio/${project.slug}`} />)}
      </div>
    </div>
  </section>

  <section class="home-section home-process" aria-labelledby="home-process-title">
    <div class="home-container home-process__layout">
      <HomeSectionHeading
        id="home-process-title"
        eyebrow="Product development process"
        title="A clear path from an important question to an improving product."
        description="The exact shape changes with the work, but the decisions stay visible from discovery through the next iteration."
      />
      <div class="home-process__steps-wrapper">
        <div class="home-process__progress" aria-hidden="true">
          <div class="home-process__progress-fill"></div>
        </div>
        <ol class="home-process__list">
          {processSteps.map((step) => <HomeProcessStep {...step} />)}
        </ol>
      </div>
    </div>
  </section>

  <section class="home-section home-technology" aria-labelledby="home-technology-title">
    <div class="home-container">
      <HomeSectionHeading
        id="home-technology-title"
        eyebrow="Technology and platforms"
        title="Choose technology for the job it needs to do."
        description="The tools below reflect technologies represented in the repository and existing TechMigos service content."
      />
      <div class="home-technology__grid">
        {technologyGroups.map((group) => <HomeTechnologyGroup {...group} />)}
      </div>
    </div>
  </section>

  <section class="home-section home-principles" aria-labelledby="home-principles-title">
    <div class="home-container home-principles__layout">
      <HomeSectionHeading
        id="home-principles-title"
        eyebrow="Why TechMigos"
        title="The product is only as strong as the decisions behind it."
        description="A practical way of working for teams that need clarity, careful engineering, and a useful next release."
      />
      <dl class="home-principles__list">
        {principles.map((principle, index) => (
          <div data-principle-item>
            <dt><span aria-hidden="true">0{index + 1}</span>{principle.title}</dt>
            <dd>{principle.description}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="home-section home-insights" aria-labelledby="home-insights-title">
    <div class="home-container">
      <div class="home-insights__heading">
        <HomeSectionHeading
          id="home-insights-title"
          eyebrow="Featured insights"
          title="Useful technical thinking, shared in public."
          description="Recent articles from the TechMigos blog for developers and product-minded teams."
        />
        <a href="/blog" class="btn-link">Visit the blog <span aria-hidden="true">↗</span></a>
      </div>
      <div class="home-insights__grid">
        {homepageInsights.map((post) => <div data-insight-card><HomeInsightCard {...post.data} href={`/blog/${post.id}`} /></div>)}
      </div>
    </div>
  </section>

  <section class="home-final-cta" aria-labelledby="home-final-cta-title">
    <div class="home-final-cta__grid" aria-hidden="true"></div>
    <div class="home-final-cta__orbit" aria-hidden="true"></div>
    <div class="home-container home-final-cta__content">
      <p>Start with the question that is holding your product back.</p>
      <h2 id="home-final-cta-title">Build the next useful version with a team that sees the whole system.</h2>
      <p class="home-final-cta__summary">Tell us what needs to change. We will help clarify a practical route from the first decision to the first release.</p>
      <div class="home-final-cta__actions">
        <a href="/contact" class="home-final-cta__primary" data-magnetic>Start a conversation <span aria-hidden="true">→</span></a>
        <a href="/portfolio" class="home-final-cta__secondary">Explore product work <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .homepage-hero {
    --hero-border: rgb(148 163 184 / 0.25);
    --hero-grid: rgb(15 118 110 / 0.09);
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(54rem, 100svh);
    padding: clamp(7.5rem, 12vw, 10rem) 0 clamp(4rem, 8vw, 7rem);
    overflow: clip;
    background: linear-gradient(135deg, #f8fafc 0%, #fff 45%, #ecfdf5 100%);
  }

  .homepage-hero__grid,
  .homepage-hero__network {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .homepage-hero__grid {
    opacity: 0.9;
    background-image: linear-gradient(var(--hero-grid) 1px, transparent 1px), linear-gradient(90deg, var(--hero-grid) 1px, transparent 1px);
    background-size: 2.75rem 2.75rem;
    mask-image: linear-gradient(to bottom, black, transparent 86%);
  }

  .homepage-hero__network { opacity: 0.52; }

  .homepage-hero__container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(20rem, 0.85fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 8rem);
    width: min(100% - 2rem, var(--container-wide));
    margin-inline: auto;
  }

  .homepage-hero__content { max-width: 42rem; }

  .homepage-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .homepage-hero__eyebrow::before {
    width: 1.75rem;
    height: 1px;
    content: '';
    background: currentColor;
  }

  .homepage-hero h1 {
    max-width: 11ch;
    margin: 0;
    color: var(--color-text-primary);
    font-size: clamp(3rem, 5.6vw, 5.5rem);
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .homepage-hero__summary {
    max-width: 39rem;
    margin: var(--space-6) 0 0;
    color: var(--color-text-secondary);
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.65;
  }

  .homepage-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  .homepage-hero__primary-action { gap: var(--space-3); padding-inline: var(--space-6); }
  .homepage-hero__primary-action svg { width: 1.25rem; height: 1.25rem; }
  .homepage-hero__secondary-action { padding-inline: var(--space-1); }

  .homepage-hero__assurance {
    margin: var(--space-6) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .homepage-hero__visual {
    position: relative;
    min-width: 0;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border: 1px solid var(--hero-border);
    border-radius: var(--radius-xl);
    background: rgb(255 255 255 / 0.68);
    box-shadow: 0 28px 70px rgb(15 23 42 / 0.1);
    backdrop-filter: blur(14px);
  }

  .homepage-hero__visual::before {
    position: absolute;
    z-index: -1;
    inset: 12% -9% -10% 8%;
    border-radius: 50%;
    content: '';
    background: radial-gradient(circle, rgb(13 148 136 / 0.2), transparent 69%);
    filter: blur(14px);
  }

  .homepage-hero__visual-header,
  .homepage-hero__visual-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .homepage-hero__status { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--color-accent); }
  .homepage-hero__status i,
  .homepage-hero__visual-caption span { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgb(34 197 94 / 0.12); }

  .homepage-hero__map {
    position: relative;
    min-height: clamp(21rem, 32vw, 27rem);
    margin: var(--space-3) 0;
    border: 1px solid rgb(226 232 240 / 0.85);
    border-radius: calc(var(--radius-xl) - 0.25rem);
    background: linear-gradient(145deg, rgb(248 250 252 / 0.84), rgb(255 255 255 / 0.96));
    overflow: hidden;
  }

  .homepage-hero__map::before {
    position: absolute;
    inset: 0;
    content: '';
    opacity: 0.72;
    background-image: radial-gradient(rgb(15 118 110 / 0.18) 0.75px, transparent 0.75px);
    background-size: 0.8rem 0.8rem;
    mask-image: radial-gradient(circle at center, black, transparent 73%);
  }

  .homepage-hero__paths { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .homepage-hero__paths path { fill: none; stroke: rgb(15 118 110 / 0.38); stroke-width: 1.25; stroke-dasharray: 5 6; animation: hero-path-drift 8s linear infinite; }

  .homepage-hero__core {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: clamp(6.3rem, 11vw, 8rem);
    aspect-ratio: 1;
    border: 1px solid rgb(15 118 110 / 0.35);
    border-radius: 50%;
    background: linear-gradient(145deg, #0f766e, #164e63);
    box-shadow: 0 0 0 0.7rem rgb(13 148 136 / 0.08), 0 20px 42px rgb(15 118 110 / 0.26);
    color: #fff;
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .homepage-hero__core span { font-size: clamp(1.25rem, 2.8vw, 1.8rem); font-weight: var(--weight-extrabold); letter-spacing: -0.08em; }
  .homepage-hero__core small { margin-top: -0.8rem; font-size: 0.58rem; font-weight: var(--weight-semibold); letter-spacing: 0.08em; text-transform: uppercase; }

  .homepage-hero__node {
    position: absolute;
    display: grid;
    gap: 0.18rem;
    width: min(10.3rem, 34%);
    padding: 0.85rem 0.9rem;
    border: 1px solid rgb(203 213 225 / 0.95);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.93);
    box-shadow: var(--shadow-sm);
  }

  .homepage-hero__node > span { color: var(--color-accent); font-family: var(--font-mono); font-size: 0.625rem; font-weight: var(--weight-bold); }
  .homepage-hero__node strong { color: var(--color-text-primary); font-size: var(--text-sm); }
  .homepage-hero__node small { color: var(--color-text-muted); font-size: 0.67rem; line-height: 1.35; }
  .homepage-hero__node--web { top: 10%; left: 7%; }
  .homepage-hero__node--mobile { top: 10%; right: 7%; }
  .homepage-hero__node--cloud { bottom: 10%; left: 7%; }
  .homepage-hero__node--ai { right: 7%; bottom: 10%; }

  .homepage-hero__visual-caption { justify-content: flex-start; }

  /* Atmospheric depth glow responds to pointer */
  .homepage-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(38rem circle at var(--hero-x, 50%) var(--hero-y, 35%), rgba(13, 148, 136, 0.18), rgba(37, 99, 235, 0.06) 60%, transparent 75%);
    transition: opacity 350ms ease;
    z-index: 0;
  }

  .homepage-hero.is-interactive::after { opacity: 1; }

  /* Orbital ring on the core */
  @keyframes hero-core-orbit {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to   { transform: translate(-50%, -50%) rotate(360deg); }
  }

  /* Node pulse */
  @keyframes hero-node-pulse {
    0%, 100% { box-shadow: var(--shadow-sm); }
    50% { box-shadow: var(--shadow-sm), 0 0 0 6px rgb(13 148 136 / 0.12); }
  }

  /* Orbit line on the core */
  .homepage-hero__core::before {
    content: '';
    position: absolute;
    inset: -0.65rem;
    border-radius: 50%;
    border: 1px dashed rgb(13 148 136 / 0.45);
    animation: hero-core-orbit 14s linear infinite;
  }

  /* Second slower orbit ring */
  .homepage-hero__core::after {
    content: '';
    position: absolute;
    inset: -1.35rem;
    border-radius: 50%;
    border: 1px dashed rgb(37 99 235 / 0.2);
    animation: hero-core-orbit 22s linear infinite reverse;
  }

  .homepage-hero__node {
    animation: hero-node-pulse 4s ease-in-out infinite;
  }

  .homepage-hero__node--web   { animation-delay: 0s; }
  .homepage-hero__node--mobile { animation-delay: 1s; }
  .homepage-hero__node--cloud { animation-delay: 2s; }
  .homepage-hero__node--ai    { animation-delay: 3s; }

  @keyframes hero-path-drift { to { stroke-dashoffset: -44; } }

  .home-container { width: min(100% - 2rem, var(--container-wide)); margin-inline: auto; }
  .home-section { position: relative; padding: clamp(4.5rem, 9vw, 8rem) 0; }
  .home-kicker { margin: 0 0 var(--space-3); color: var(--color-accent); font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: 0.1em; text-transform: uppercase; }

  .home-trust { border-block: 1px solid var(--color-border); background: var(--color-surface-inverse); color: var(--color-text-inverse); }
  .home-trust__layout { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; padding-block: var(--space-10); }
  .home-trust .home-kicker { color: #99f6e4; }
  .home-trust h2 { max-width: 25rem; margin: 0; font-size: clamp(1.65rem, 3vw, 2.5rem); letter-spacing: -0.04em; line-height: 1.08; }
  .home-trust__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); padding: 0; margin: 0; list-style: none; }
