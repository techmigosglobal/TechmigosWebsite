---
import BaseLayout from '../layouts/BaseLayout.astro';

const updatedAt = 'April 3, 2026';

const highlights = [
  'Project-specific commitments are confirmed in proposals, statements of work, or signed agreements.',
  'Client ownership typically transfers after full payment for agreed deliverables.',
  'Use of the website and services means you agree to these terms.',
];

const sections = [
  {
    id: 'acceptance',
    title: 'Acceptance of Terms',
    body: [
      'By accessing this website or engaging TechMigos for services, you agree to these Terms of Service and any project-specific agreements that may apply.',
      'If you do not agree with these terms, you should not use the website or engage our services.',
    ],
  },
  {
    id: 'services',
    title: 'Services and Project Scope',
    body: [
      'TechMigos provides software development, quality assurance, backend engineering, AI integration, consulting, and related digital services.',
      'The precise scope, delivery timeline, pricing, acceptance criteria, and commercial terms for each engagement are defined in the relevant proposal, statement of work, or contract.',
    ],
  },
  {
    id: 'payments',
    title: 'Fees and Payments',
    body: [
      'Unless otherwise agreed in writing, invoices are due according to the payment schedule set out in your project agreement.',
      'Late payments may result in delivery delays, suspension of work, or additional charges where permitted by law and contract.',
    ],
  },
  {
    id: 'ip',
    title: 'Intellectual Property',
    body: [
      'Upon full payment of all agreed fees, clients generally receive ownership or licensed usage rights to the final deliverables created specifically for their project, as defined in the governing agreement.',
      'TechMigos retains ownership of pre-existing materials, reusable frameworks, internal tools, libraries, templates, know-how, and general methods used in delivering services.',
    ],
  },
  {
    id: 'confidentiality',
    title: 'Confidentiality',
    body: [
      'Both parties are expected to protect confidential information shared during discussions and project delivery, except where disclosure is required by law or already publicly known.',
      'More detailed confidentiality obligations may be set out in separate nondisclosure agreements or project contracts.',
    ],
  },
  {
    id: 'liability',
    title: 'Limitation of Liability',
    body: [
      'To the maximum extent permitted by law, TechMigos is not liable for indirect, incidental, special, consequential, or punitive damages arising from use of the website or services.',
      'Where liability applies, it is generally limited to the amount paid for the specific service giving rise to the claim, unless a written agreement states otherwise.',
    ],
  },
  {
    id: 'contact',
    title: 'Contact',
    body: [
      'Questions about these terms can be sent to legal@techmigos.com.',
    ],
  },
];
---

<BaseLayout
  title="Terms of Service"
  description="Review the core terms that govern use of the TechMigos website and service engagements."
>
  <section class="pt-36 pb-16 relative overflow-hidden bg-gray-50">
    <div class="absolute inset-0 dot-pattern opacity-40"></div>
    <div class="absolute -top-24 left-0 h-80 w-80 rounded-full bg-accent-100 blur-3xl opacity-45"></div>
    <div class="container-custom relative z-10">
      <div class="max-w-4xl">
        <span class="section-eyebrow reveal">Legal</span>
        <h1 class="reveal stagger-1 text-5xl sm:text-6xl font-extrabold text-gray-900 mb-5 leading-tight">
          Terms of Service
        </h1>
        <p class="reveal stagger-2 max-w-3xl text-xl text-gray-500 leading-relaxed">
          The core rules that guide how this website and our project engagements are used.
        </p>
        <div class="reveal stagger-3 mt-8 inline-flex items-center gap-3 rounded-full border border-primary-100 bg-white px-5 py-2 text-sm font-semibold text-slate-600 shadow-sm">
          <span class="h-2.5 w-2.5 rounded-full bg-accent-500"></span>
          Last updated {updatedAt}
        </div>
      </div>
    </div>
  </section>

  <section class="pb-24 bg-white">
    <div class="container-custom">
      <div class="grid gap-10 lg:grid-cols-[18rem,minmax(0,1fr)]">
        <aside class="reveal-left">
          <div class="sticky top-28 space-y-5 rounded-3xl border border-slate-200 bg-slate-50 p-6 shadow-sm">
            <div>
              <h2 class="text-lg font-extrabold text-slate-900">At a Glance</h2>
              <p class="mt-2 text-sm leading-6 text-slate-500">A faster summary of the expectations behind the full terms.</p>
            </div>
            <ul class="space-y-3">
              {highlights.map((item) => (
                <li class="rounded-2xl bg-white px-4 py-3 text-sm leading-6 text-slate-700 border border-slate-200">{item}</li>
              ))}
            </ul>
            <nav aria-label="Terms sections">
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400 mb-3">On this page</p>
              <div class="space-y-2">
                {sections.map((section) => (
                  <a href={`#${section.id}`} class="block rounded-xl px-3 py-2 text-sm font-medium text-slate-600 transition-[background-color,color] duration-200 hover:bg-white hover:text-primary-700">
                    {section.title}
                  </a>
                ))}
              </div>
            </nav>
          </div>
        </aside>

        <div class="reveal-right space-y-6">
          {sections.map((section, index) => (
            <section id={section.id} class={`rounded-3xl border border-slate-200 bg-white p-7 shadow-sm stagger-${Math.min(index + 1, 6)} reveal`}>
              <div class="flex items-center gap-3 mb-4">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-primary-50 text-sm font-black tracking-[0.18em] text-primary-700">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h2 class="text-2xl font-extrabold text-slate-900">{section.title}</h2>
              </div>
              <div class="space-y-4 text-[1.02rem] leading-8 text-slate-600">
                {section.body.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
