---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { careersEmail } from '../../lib/careers';

const allJobs = await getCollection('careers', ({ data }) => !data.draft);
allJobs.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function entrySlug(entry: { id: string }) {
  return entry.id;
}

const perks = [
  { marker: '01', title: 'Work on real workflows', description: 'Help clients solve practical problems across web, mobile, and desktop software.' },
  { marker: '02', title: 'Work across disciplines', description: 'Sales, design, and engineering each bring a different perspective to the same project.' },
  { marker: '03', title: 'See a project through', description: 'Connect early client conversations with what gets built, tested, and released.' },
];

const departments = ['All', ...new Set(allJobs.map(job => job.data.department))];
---

<BaseLayout
  title="Software Careers at TechMigos"
  description="Explore TechMigos careers in business development, backend engineering, and sales and marketing. Read the open roles and apply by email."
>
  <!-- HERO -->
  <section class="pt-36 pb-20 relative overflow-hidden">
    <div class="absolute inset-0" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #0e7490 100%)"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <!-- Floating orbs -->
    <div class="absolute top-20 left-10 w-64 h-64 bg-primary-500 rounded-full blur-3xl opacity-10 animate-blob"></div>
    <div class="absolute bottom-10 right-10 w-80 h-80 bg-accent-500 rounded-full blur-3xl opacity-10 animate-blob" style="animation-delay:3s"></div>

    <div class="container-custom relative z-10 text-center">
      <div class="reveal">
        <span class="section-eyebrow" style="color:#a5b4fc; background:rgba(165,180,252,0.1); border-color:rgba(165,180,252,0.2);">
          We're Hiring
        </span>
      </div>
      <h1 class="reveal stagger-1 text-5xl sm:text-6xl font-extrabold text-white mb-6 leading-tight">
        Join the Migos.<br>
        <span style="-webkit-background-clip:text;-webkit-text-fill-color:transparent;background:linear-gradient(135deg,#a5b4fc,#67e8f9);background-clip:text;">
          Build the Future.
        </span>
      </h1>
      <p class="reveal stagger-2 text-xl text-indigo-200 max-w-2xl mx-auto mb-10">
        Help businesses plan, build, and improve websites, mobile apps, and desktop software.
      </p>
      <a href="#open-positions" class="btn-primary inline-flex">View open positions</a>
    </div>
  </section>

  <!-- PERKS SECTION -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">Why TechMigos</span>
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Life at TechMigos</h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          We're building more than a company — a culture where great people do the best work of their careers.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {perks.map((perk, i) => (
          <div class={`glow-card bg-white rounded-2xl p-7 border border-gray-100 group stagger-${i + 1} reveal`}>
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary-50 text-sm font-black tracking-[0.2em] text-primary-700 mb-4 group-hover:scale-110 transition-transform duration-300">{perk.marker}</div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{perk.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{perk.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OPEN POSITIONS -->
  <section id="open-positions" class="section-padding bg-gray-50 scroll-mt-20">
    <div class="container-custom">
      <div class="text-center mb-12 reveal">
        <span class="section-eyebrow">Open Roles</span>
        <h2 class="text-4xl font-bold text-gray-900 mb-2">Open Positions</h2>
        <p class="text-gray-500">{allJobs.length} {allJobs.length === 1 ? 'position' : 'positions'} available</p>
        <p class="mt-3 text-gray-600">Send your resume to <a class="inline-block font-semibold text-primary-700 underline" href={`mailto:${careersEmail}`}>{careersEmail}</a>. Use the role title as your email subject.</p>
      </div>

      {allJobs.length > 0 ? (
        <>
          <!-- Dept filters -->
          <div class="flex flex-wrap justify-center gap-2 mb-10 reveal" id="department-filters">
            {departments.map(dept => (
              <button
                class="dept-filter px-5 py-2 rounded-full text-sm font-semibold transition-[background-color,border-color,color,box-shadow] duration-300"
                data-department={dept}
                type="button"
                aria-pressed={dept === 'All'}
              >
                {dept}
              </button>
            ))}
          </div>

          <!-- Job listings -->
          <div class="max-w-4xl mx-auto space-y-4" id="jobs-list">
            {allJobs.map((job, i) => (
              <a
                href={`/careers/${entrySlug(job)}`}
                class={`job-item flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white rounded-2xl p-6 border border-gray-100 hover:border-primary-300 hover:shadow-xl transition-[border-color,box-shadow,transform] duration-300 transform hover:-translate-y-1 group stagger-${i + 1} reveal`}
                data-department={job.data.department}
              >
                <div>
                  <h3 class="text-lg font-bold text-gray-900 group-hover:text-primary-600 transition-colors mb-2">
                    {job.data.title}
                  </h3>
                  <div class="flex flex-wrap items-center gap-3 text-sm">
                    <span class="flex items-center gap-1 px-3 py-1 bg-primary-50 text-primary-700 rounded-full font-medium">
                      🏢 {job.data.department}
                    </span>
                    {job.data.location && <span class="text-gray-500">{job.data.location}</span>}
                    {job.data.type && <span class="text-gray-500">{job.data.type}</span>}
                  </div>
                </div>
                <div class="flex-shrink-0">
                  <span class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary-600 text-white text-sm font-bold group-hover:bg-primary-700 transition-colors shine-hover">
                    View role
                    <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </>
      ) : (
        <div class="text-center py-20 reveal">
          <div class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-primary-50 text-sm font-black uppercase tracking-[0.22em] text-primary-700 mb-6">Open</div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">No open positions right now</h3>
          <p class="text-gray-500 text-lg mb-8 max-w-md mx-auto">We're growing! Send us your CV anyway — we'd love to meet talented people.</p>
          <a href={`mailto:${careersEmail}`} class="btn-primary shine-hover">
            Send Your CV
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 animate-gradient-shift" style="background: linear-gradient(135deg,#2563eb,#0ea5e9,#06b6d4,#2563eb); background-size:300% 300%;"></div>
    <div class="container-custom relative z-10 text-center reveal">
      <h2 class="text-4xl sm:text-5xl font-extrabold text-white mb-6">Don't see the perfect role?</h2>
      <p class="text-xl text-white/80 mb-10 max-w-2xl mx-auto">
        We're always interested in meeting talented people. Tell us how you'd like to contribute.
      </p>
      <a href={`mailto:${careersEmail}`} class="inline-flex items-center justify-center px-10 py-4 bg-white text-primary-700 font-bold rounded-xl hover:-translate-y-1 transition-[box-shadow,transform] duration-300 shadow-2xl text-lg shine-hover">
        Get in Touch
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  @reference "../../styles/global.css";

  .dept-filter { @apply text-gray-600 bg-white border border-gray-200 hover:border-primary-300 hover:text-primary-600; }
  .dept-filter[aria-pressed="true"] {
    background: linear-gradient(135deg, #4F46E5, #06B6D4);
    @apply text-white border-transparent shadow-md;
  }
</style>

<script>
  function initCareerFilters() {
    const group = document.getElementById('department-filters');
    if (!group || group.dataset.initialized) return;
    group.dataset.initialized = 'true';
    const filters = group.querySelectorAll<HTMLButtonElement>('.dept-filter');
    const jobs = document.querySelectorAll<HTMLElement>('.job-item');

    filters.forEach(filter => {
      filter.addEventListener('click', () => {
        const department = filter.dataset.department;
        filters.forEach(button => button.setAttribute('aria-pressed', String(button === filter)));
        jobs.forEach(job => {
          job.hidden = department !== 'All' && department !== job.dataset.department;
        });
      });
    });
  }

  initCareerFilters();
  document.addEventListener('astro:page-load', initCareerFilters);
</script>
