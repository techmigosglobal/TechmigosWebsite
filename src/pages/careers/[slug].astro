  }

  .field-badge {
    color: #1d4ed8;
    background: #eff6ff;
    border-radius: 9999px;
    padding: 0.35rem 0.6rem;
    font-size: 0.74rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .field-control {
    border: 1px solid #dbeafe;
    border-radius: 0.95rem;
    background: #f8fbff;
    padding: 0.9rem 1rem;
    transition: border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
  }

  .field:focus-within .field-control {
    border-color: #60a5fa;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.12);
  }

  .field-input {
    display: block;
    width: 100%;
    border: 0;
    outline: 0;
    background: #ffffff;
    color: #0f172a !important;
    -webkit-text-fill-color: #0f172a;
    caret-color: #0f172a;
    font-size: 0.98rem;
    line-height: 1.6;
    min-height: 1.6rem;
    padding: 0.15rem 0;
    opacity: 1;
  }

  .field-input::placeholder {
    color: #94a3b8;
    opacity: 1;
  }

  .field-textarea {
    min-height: 150px;
    resize: vertical;
    padding-top: 0.2rem;
  }

  .field-hint,
  .field-help {
