  }

  .upload-dropzone {
    display: grid;
    justify-items: center;
    gap: 0.8rem;
    border: 1.5px dashed #93c5fd;
    border-radius: 1rem;
    background: linear-gradient(180deg, #f8fbff, #eff6ff);
    padding: 1.4rem 1rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .upload-dropzone:hover,
  .upload-dropzone.is-dragover {
    border-color: #2563eb;
    background: linear-gradient(180deg, #eff6ff, #dbeafe);
    transform: translateY(-1px);
  }

  .upload-icon {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 9999px;
    background: rgba(37, 99, 235, 0.1);
    color: #1d4ed8;
  }

  .upload-icon svg {
    width: 1.45rem;
    height: 1.45rem;
  }

  .upload-copy strong {
    display: block;
    color: #0f172a;
    font-size: 1rem;
  }

  .upload-copy span {
    display: block;
    margin-top: 0.2rem;
    color: #64748b;
    font-size: 0.9rem;
  }

  .upload-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: center;
    margin-top: 0.75rem;
  }

  .upload-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.6rem;
    border-radius: 9999px;
    background: #eff6ff;
    color: #0f172a;
    font-size: 0.82rem;
  }

  .upload-summary-name {
    font-weight: 700;
    max-width: 17rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .upload-remove {
    color: #1d4ed8;
    font-weight: 700;
  }

  .field-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    align-items: center;
    margin-top: 0.5rem;
  }

  .field-count {
    color: #475569;
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .field-error {
    min-height: 1.1rem;
    margin-top: 0.55rem;
    color: #dc2626;
    font-size: 0.79rem;
  }

  .field.field--error {
    border-color: #ef4444;
    box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.1);
  }

  .field.field--valid {
    border-color: #86efac;
  }

  .application-actions {
    display: grid;
    gap: 0.75rem;
  }

  .application-submit {
    width: 100%;
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
  }

  .application-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .application-note {
    text-align: center;
    color: #64748b;
    font-size: 0.84rem;
  }

  .career-status {
    min-height: 1.5rem;
    text-align: center;
    font-weight: 700;
    font-size: 0.92rem;
  }

  .career-status.success {
    color: #15803d;
  }

  .career-status.error {
    color: #b91c1c;
  }

  @media (min-width: 768px) {
    .field-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .application-topbar {
      grid-template-columns: minmax(0, 1fr) 20rem;
      align-items: start;
    }

    .application-shell {
      padding: 1.6rem;
    }

    .form-panel {
      padding: 1.15rem;
    }
  }

  @media (min-width: 1100px) {
    .content-shell {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 1.6rem;
    }
  }

  @media (max-width: 767px) {
    .career-summary {
      margin-top: -1rem;
    }

    .job-content-card,
    .summary-card,
    .sidebar-card,
    .insight-card {
      padding: 1rem;
    }

    .application-shell {
      padding: 0.95rem;
    }

    .upload-meta,
    .field-meta,
    .field-head {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<script>
  const MAX_FILE_SIZE = 5 * 1024 * 1024;
  const ALLOWED_FILE_TYPES = [
    'application/pdf',
    'application/msword',
    'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
  ];
  const ALLOWED_FILE_EXTENSIONS = ['pdf', 'doc', 'docx'];

  const form = document.getElementById('career-application-form');
  const progressFill = document.getElementById('application-progress-fill');
  const progressLabel = document.getElementById('application-progress-label');
  const submitBtn = document.getElementById('career-submit');
  const submitText = document.getElementById('career-submit-text');
  const submitSpinner = document.getElementById('career-submit-spinner');
  const statusEl = document.getElementById('career-status');
  const fileInput = document.getElementById('cv');
  const fileSummary = document.getElementById('cv-file-summary');
  const fileNameEl = document.getElementById('cv-file-name');
  const removeFileBtn = document.getElementById('cv-remove');
  const dropzone = document.getElementById('upload-dropzone');
  const coverLetter = document.getElementById('coverLetter');
  const coverLetterCount = document.getElementById('cover-letter-count');

  const requiredIds = ['name', 'email', 'coverLetter', 'cv'];
  const touched = new Set();

  function slugify(value) {
    return value
      .toLowerCase()
      .trim()
      .replace(/&/g, 'and')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  function getFileExtension(file) {
    const parts = file.name.split('.');
    return parts.length > 1 ? parts.pop().toLowerCase() : '';
  }

  function validateFile(file) {
    if (!file) return 'Please upload your resume file.';
    const fileExtension = getFileExtension(file);
    if (file.type && !ALLOWED_FILE_TYPES.includes(file.type) && !ALLOWED_FILE_EXTENSIONS.includes(fileExtension)) {
      return 'Upload a PDF, DOC, or DOCX file.';
    }
    if (!file.type && !ALLOWED_FILE_EXTENSIONS.includes(fileExtension)) {
      return 'Upload a PDF, DOC, or DOCX file.';
    }
    if (file.size > MAX_FILE_SIZE) {
      return 'Resume files must be 5 MB or smaller.';
    }
    return '';
  }

  const validators = {
    name: (value) => value.trim().length > 1 ? '' : 'Please enter your full name.',
    email: (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value) ? '' : 'Please enter a valid email address.',
    linkedin: (value) => !value || /^https?:\/\//.test(value) ? '' : 'Use a full URL starting with http:// or https://.',
    portfolio: (value) => !value || /^https?:\/\//.test(value) ? '' : 'Use a full URL starting with http:// or https://.',
    coverLetter: (value) => value.trim().length >= 30 ? '' : 'Please add at least 30 characters in your cover letter.',
    cv: (_value, file) => validateFile(file),
  };

  function setFieldError(id, message) {
    const input = document.getElementById(id);
    const field = input?.closest('.field');
    const errorEl = document.getElementById(`error-${id}`);
    if (!field || !errorEl) return;

    field.classList.toggle('field--error', Boolean(message));
    field.classList.toggle('field--valid', !message && touched.has(id) && hasValue(input));
    errorEl.textContent = message || '';
  }

  function hasValue(input) {
    if (!input) return false;
    if (input.type === 'file') return Boolean(input.files && input.files[0]);
    return Boolean(input.value && input.value.trim());
  }

  function updateProgress() {
    let done = 0;
    requiredIds.forEach((id) => {
      const input = document.getElementById(id);
      if (hasValue(input)) done += 1;
    });

    const percentage = Math.round((done / requiredIds.length) * 100);
    if (progressFill) progressFill.style.width = `${percentage}%`;
    if (progressLabel) progressLabel.textContent = `${percentage}% complete`;
  }

  function setLoading(loading) {
    if (!submitBtn || !submitText || !submitSpinner) return;
    submitBtn.disabled = loading;
    submitText.textContent = loading ? 'Submitting...' : 'Submit Application';
    submitSpinner.classList.toggle('hidden', !loading);
  }

  async function getCsrfToken() {
    const response = await fetch('/api/csrf', { credentials: 'include' });
    if (!response.ok) throw new Error('Failed to initialize secure form session. Please refresh and try again.');
    const data = await response.json();
    if (!data?.token) throw new Error('Missing secure form token. Please refresh and try again.');
    return data.token;
  }

  function setStatus(message, type) {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove('success', 'error');
    if (type) statusEl.classList.add(type);
  }

  function syncCount() {
    if (coverLetter && coverLetterCount) {
      coverLetterCount.textContent = `${coverLetter.value.length} / 1200`;
    }
  }

  function syncFileSummary() {
    const file = fileInput?.files?.[0];
    if (file && fileNameEl && fileSummary) {
      fileNameEl.textContent = `${file.name} (${Math.max(1, Math.round(file.size / 1024))} KB)`;
      fileSummary.hidden = false;
    } else if (fileSummary && fileNameEl) {
      fileNameEl.textContent = '';
      fileSummary.hidden = true;
    }
  }

  function assignSections() {
    const tocLinks = document.querySelectorAll('[data-toc-link]');
    const sections = document.querySelectorAll('[data-role-section]');

    if (!sections.length || !tocLinks.length) return;

    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

      if (!visible) return;

      const id = visible.target.getAttribute('data-role-section');
      if (!id) return;

      sections.forEach((section) => section.classList.toggle('is-current', section.getAttribute('data-role-section') === id));
      tocLinks.forEach((link) => {
        link.classList.toggle('is-active', link.getAttribute('data-toc-link') === id);
      });
    }, { rootMargin: '-35% 0px -55% 0px', threshold: [0.2, 0.6] });

    sections.forEach((section) => observer.observe(section));

    tocLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.getAttribute('data-toc-link');
        if (!id) return;
        const section = document.querySelector(`[data-role-section="${id}"]`);
        if (section instanceof HTMLDetailsElement) {
          section.open = true;
        }
      });
    });
  }

  function validateField(id, { force = false } = {}) {
    const input = document.getElementById(id);
    if (!input || !validators[id]) return '';

    const message = id === 'cv'
      ? validators[id]('', input.files && input.files[0])
      : validators[id](input.value || '');

    if (force || touched.has(id)) setFieldError(id, message);
    return message;
  }

  function attachInputBehavior(input) {
    const id = input.id;
    if (!id) return;

    input.addEventListener('input', () => {
      updateProgress();
      if (id !== 'cv') validateField(id);
      if (id === 'coverLetter') syncCount();
    });

    input.addEventListener('blur', () => {
      touched.add(id);
      validateField(id, { force: true });
      updateProgress();
    });
  }

  if (fileInput) {
    fileInput.addEventListener('change', () => {
      touched.add('cv');
      syncFileSummary();
      validateField('cv', { force: true });
      updateProgress();
    });
  }

  removeFileBtn?.addEventListener('click', () => {
    if (!fileInput) return;
    fileInput.value = '';
    touched.add('cv');
    syncFileSummary();
    validateField('cv', { force: true });
    updateProgress();
  });

  ['dragenter', 'dragover'].forEach((eventName) => {
    dropzone?.addEventListener(eventName, (event) => {
      event.preventDefault();
      dropzone.classList.add('is-dragover');
    });
  });

  ['dragleave', 'drop'].forEach((eventName) => {
    dropzone?.addEventListener(eventName, (event) => {
      event.preventDefault();
      dropzone.classList.remove('is-dragover');
    });
  });

  dropzone?.addEventListener('drop', (event) => {
    const transfer = event.dataTransfer;
    if (!transfer?.files?.length || !fileInput) return;
    fileInput.files = transfer.files;
    touched.add('cv');
    syncFileSummary();
    validateField('cv', { force: true });
    updateProgress();
  });

  document.querySelectorAll('.field-input, .field-file-input').forEach((input) => attachInputBehavior(input));

  syncCount();
  syncFileSummary();
  updateProgress();
  assignSections();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    setStatus('');

    let firstErrorInput = null;
    let hasErrors = false;

    Object.keys(validators).forEach((id) => {
      touched.add(id);
      const message = validateField(id, { force: true });
      if (message && !firstErrorInput) firstErrorInput = document.getElementById(id);
      if (message) hasErrors = true;
    });

    if (hasErrors) {
      setStatus('Please fix the highlighted fields before submitting.', 'error');
      firstErrorInput?.focus();
      return;
    }

    setLoading(true);

    try {
      const csrfToken = await getCsrfToken();
      const formData = new FormData(form);

      const response = await fetch('/api/leads/careers', {
        method: 'POST',
        headers: {
          'x-csrf-token': csrfToken,
        },
        body: formData,
      });

      const result = await response.json();
      if (!response.ok || !result.ok) {
        if (result.fieldErrors) {
          Object.entries(result.fieldErrors).forEach(([key, value]) => {
            touched.add(key);
            setFieldError(key, String(value));
          });
        }
        throw new Error(result.error || 'Could not submit your application right now.');
      }

      form.reset();
      touched.clear();
      document.querySelectorAll('.field').forEach((field) => field.classList.remove('field--error', 'field--valid'));
      document.querySelectorAll('.field-error').forEach((el) => { el.textContent = ''; });
      syncCount();
      syncFileSummary();
      updateProgress();
      setStatus('Application submitted successfully. Our team will review your materials and follow up soon.', 'success');
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
      setStatus(message, 'error');
    } finally {
      setLoading(false);
    }
  });
</script>
