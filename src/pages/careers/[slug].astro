  .field:hover {
    border-color: #93c5fd;
  }

  .field:focus-within {
    border-color: #3b82f6;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
    transform: translateY(-1px);
  }

  .field-head {
    display: flex;
    justify-content: space-between;
