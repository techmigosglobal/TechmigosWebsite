---
import fs from 'node:fs/promises';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

type ParsedSection = {
  title: string;
  id: string;
  level: 2 | 3;
  body: string[];
  bullets: string[];
  paragraphs: string[];
};

function slugify(value: string) {
  return value
    .toLowerCase()
    .trim()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function stripFrontmatter(source: string) {
  return source.replace(/^---[\s\S]*?---\s*/, '');
}

function parseSections(source: string) {
  const lines = source.split('\n');
  const sections: ParsedSection[] = [];
  let current: ParsedSection | null = null;

  for (const line of lines) {
    const headingMatch = line.match(/^(##|###)\s+(.*)$/);
    if (headingMatch) {
      if (current) sections.push(current);
      const title = headingMatch[2].trim();
      current = {
        title,
        id: slugify(title),
        level: headingMatch[1] === '##' ? 2 : 3,
        body: [],
        bullets: [],
        paragraphs: [],
      };
      continue;
    }

    if (!current) continue;
    current.body.push(line);
    const bulletMatch = line.match(/^\s*-\s+(.*)$/);
    if (bulletMatch) {
      current.bullets.push(bulletMatch[1].trim());
      continue;
    }

    const paragraph = line.trim();
    if (paragraph) current.paragraphs.push(paragraph);
  }

  if (current) sections.push(current);
  return sections;
}

function findSection(sections: ParsedSection[], candidates: string[]) {
  return sections.find((section) =>
    candidates.some((candidate) => section.title.toLowerCase() === candidate.toLowerCase())
  );
}

function formatPostedDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
}

export async function getStaticPaths() {
  const jobs = await getCollection('careers', ({ data }) => !data.draft);
  return jobs.map((job) => ({
    params: { slug: job.slug },
    props: { job },
  }));
}

const { job } = Astro.props;

const sourcePath = path.join(process.cwd(), 'src', 'content', 'careers', `${job.slug}.mdx`);
const rawSource = await fs.readFile(sourcePath, 'utf-8').catch(() => '');
const parsedSections = parseSections(stripFrontmatter(rawSource));

const tocSections = parsedSections.filter((section) => section.level === 2);
const hiringProcess = findSection(parsedSections, ['Hiring Process']);
const roleOverview = findSection(parsedSections, ['Role Overview']);

const essentials = [
  { label: 'Department', value: job.data.department },
  { label: 'Location', value: job.data.location },
  { label: 'Employment', value: job.data.type },
  { label: 'Posted', value: formatPostedDate(job.data.pubDate) },
  ...(job.data.salary ? [{ label: 'Compensation', value: job.data.salary }] : []),
];
---

<BaseLayout
  title={job.data.title}
  description={`${job.data.title} - ${job.data.description}`}
  ogType="article"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'JobPosting',
      title: job.data.title,
      description: job.data.description,
      hiringOrganization: {
        '@type': 'Organization',
        name: 'TechMigos',
        sameAs: 'https://techmigos.com',
      },
      jobLocation: {
        '@type': 'Place',
        address: {
          '@type': 'PostalAddress',
          addressLocality: job.data.location,
        },
      },
      employmentType: job.data.type.toUpperCase().replace('-', '_'),
      datePosted: job.data.pubDate.toISOString().split('T')[0],
    })}
  />

  <section class="career-hero pt-32 pb-16 relative overflow-hidden">
    <div class="hero-noise" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-one animate-float" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-two animate-float-slow" aria-hidden="true"></div>
    <div class="container-custom relative z-10">
      <nav class="mb-8 reveal" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
          <li>/</li>
          <li><a href="/careers" class="hover:text-primary-600 transition-colors">Careers</a></li>
          <li>/</li>
          <li class="text-slate-900">{job.data.title}</li>
        </ol>
      </nav>

      <div class="hero-grid">
        <div class="max-w-4xl">
          <span class="section-eyebrow reveal">Open Position</span>
          <h1 class="reveal stagger-1 text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-950 leading-[1.05] mb-5">
            {job.data.title}
          </h1>
          <p class="reveal stagger-2 text-lg sm:text-xl text-slate-600 max-w-3xl mb-7 leading-relaxed">
            {job.data.description}
          </p>

          <div class="reveal stagger-3 flex flex-wrap gap-2 text-sm mb-8">
            <span class="role-pill">{job.data.department}</span>
            <span class="role-pill">{job.data.location}</span>
            <span class="role-pill">{job.data.type}</span>
            {job.data.salary && <span class="role-pill">{job.data.salary}</span>}
          </div>

          <div class="reveal stagger-4 hero-actions">
            <a href="#apply" class="btn-primary hero-cta">Start Application</a>
            <a href="#role-details" class="btn-ghost hero-cta-secondary">Read Role Details</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="career-summary pb-10">
    <div class="container-custom">
      <div class="summary-grid summary-grid--single">
        <div class="summary-card reveal">
          <span class="summary-kicker">Role Snapshot</span>
          <dl class="summary-list">
            {essentials.map((item) => (
              <div class="summary-list-item">
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>
          {roleOverview?.paragraphs?.[0] && <p class="summary-intro">{roleOverview.paragraphs[0]}</p>}
        </div>
      </div>
    </div>
  </section>

  <section id="role-details" class="pb-20">
    <div class="container-custom">
      <div class="content-shell">
        <div class="content-main">
          <div class="section-header reveal">
            <div>
              <span class="section-eyebrow">Role Details</span>
              <h2 class="section-title">Explore the role section by section</h2>
            </div>
            {tocSections.length > 0 && (
              <nav class="toc-strip" aria-label="Job description sections">
                {tocSections.map((section) => (
                  <a href={`#${section.id}`} class="toc-chip" data-toc-link={section.id}>
                    {section.title}
                  </a>
                ))}
              </nav>
            )}
          </div>

          <article class="job-content-card reveal-left">
            <div class="job-content">
              <div class="job-content-intro">
                <p>Open any section to read the details without scanning one long wall of content.</p>
              </div>

              <div class="job-accordion">
                {tocSections.map((section, index) => (
                  <details
                    class="job-accordion-item"
                    id={section.id}
                    data-role-section={section.id}
                    open={index === 0}
                  >
                    <summary class="job-accordion-summary">
                      <span>{section.title}</span>
                      <span class="job-accordion-icon" aria-hidden="true">
                        <svg viewBox="0 0 20 20" fill="none">
                          <path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                      </span>
                    </summary>
                    <div class="job-accordion-body">
                      {section.paragraphs.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                      {section.bullets.length > 0 && (
                        <ul>
                          {section.bullets.map((item) => <li>{item}</li>)}
                        </ul>
                      )}
                    </div>
                  </details>
                ))}
              </div>
            </div>
          </article>
        </div>

        <aside class="content-sidebar reveal-right">
          <div class="sidebar-card sidebar-card--sticky">
            <p class="sidebar-kicker">Quick View</p>
            <h2 class="sidebar-title">Everything important, without the scroll hunt</h2>
            <dl class="sidebar-facts">
              {essentials.map((item) => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
            <a href="#apply" class="btn-primary w-full text-center">Apply for This Role</a>
          </div>

          {hiringProcess?.bullets && hiringProcess.bullets.length > 0 && (
            <div class="sidebar-card sidebar-card--soft">
              <p class="sidebar-kicker">Hiring Process</p>
              <ol class="timeline-list">
                {hiringProcess.bullets.map((item) => <li>{item}</li>)}
              </ol>
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>

  <section id="apply" class="pb-28">
    <div class="container-custom">
      <div class="application-shell reveal">
        <div class="application-topbar">
          <div class="application-head">
            <span class="section-eyebrow">Application Form</span>
            <h2 class="section-title">Apply for {job.data.title}</h2>
            <p class="text-slate-600 max-w-2xl leading-relaxed">
              Share the essentials, upload your resume, and tell us how you think about ownership and impact.
            </p>
          </div>

          <div class="application-assurance">
            <div class="assurance-item">
              <strong>Secure submission</strong>
              <span>Protected with CSRF validation and rate limiting.</span>
            </div>
            <div class="assurance-item">
              <strong>File support</strong>
              <span>PDF, DOC, DOCX up to 5 MB.</span>
            </div>
          </div>
        </div>

        <div class="application-progress-wrap">
          <div class="application-progress" aria-hidden="true">
            <div id="application-progress-fill" class="application-progress-fill"></div>
          </div>
          <p id="application-progress-label" class="application-progress-label">0% complete</p>
        </div>

        <form id="career-application-form" class="application-form" method="POST" enctype="multipart/form-data" novalidate>
          <input type="hidden" name="jobTitle" value={job.data.title} />
          <input type="text" name="company_website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

          <section class="form-panel">
            <div class="form-panel-head">
              <h3>Your Profile</h3>
              <p>Start with the details we need to reach you and understand your background.</p>
            </div>

            <div class="field-grid">
              <div class="field" data-required="true">
                <label for="name" class="field-label">Full Name</label>
                <div class="field-control">
                  <input id="name" name="name" type="text" class="field-input" autocomplete="name" placeholder="John Smith" required />
                </div>
                <p class="field-hint">Use the name you want us to use in communication.</p>
                <p class="field-error" id="error-name" aria-live="polite"></p>
              </div>

              <div class="field" data-required="true">
                <label for="email" class="field-label">Email Address</label>
                <div class="field-control">
                  <input id="email" name="email" type="email" class="field-input" autocomplete="email" placeholder="name@example.com" required />
                </div>
                <p class="field-hint">We will use this for role updates and interview coordination.</p>
                <p class="field-error" id="error-email" aria-live="polite"></p>
              </div>
            </div>
          </section>

          <section class="form-panel">
            <div class="form-panel-head">
              <h3>Links and Resume</h3>
              <p>Add helpful public links, then upload the latest version of your resume.</p>
            </div>

            <div class="field-grid">
              <div class="field">
                <label for="linkedin" class="field-label">LinkedIn URL</label>
                <div class="field-control">
                  <input id="linkedin" name="linkedin" type="url" class="field-input" placeholder="https://linkedin.com/in/your-profile" />
                </div>
                <p class="field-hint">Optional, but helpful for professional context.</p>
                <p class="field-error" id="error-linkedin" aria-live="polite"></p>
              </div>

              <div class="field">
                <label for="portfolio" class="field-label">Portfolio or GitHub URL</label>
                <div class="field-control">
                  <input id="portfolio" name="portfolio" type="url" class="field-input" placeholder="https://github.com/your-profile" />
                </div>
                <p class="field-hint">Share work that best reflects how you think and build.</p>
                <p class="field-error" id="error-portfolio" aria-live="polite"></p>
              </div>
            </div>

            <div class="field field-file" data-required="true" id="resume-field">
              <div class="field-head">
                <label for="cv" class="field-label-static">Resume or CV</label>
                <span class="field-badge">Required</span>
              </div>
              <input id="cv" name="cv" type="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" class="field-file-input" required />
              <label for="cv" class="upload-dropzone" id="upload-dropzone">
                <span class="upload-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 16V4m0 0l-4 4m4-4l4 4M5 16.5v.5A2 2 0 0 0 7 19h10a2 2 0 0 0 2-2v-.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
                <span class="upload-copy">
                  <strong>Drop your resume here</strong>
                  <span>or click to browse local files</span>
                </span>
              </label>
              <div class="upload-meta">
                <p class="field-help">Accepted formats: PDF, DOC, DOCX. Maximum file size: 5 MB.</p>
                <div id="cv-file-summary" class="upload-summary" hidden>
                  <span id="cv-file-name" class="upload-summary-name"></span>
                  <button type="button" id="cv-remove" class="upload-remove">Remove</button>
                </div>
              </div>
              <p class="field-error" id="error-cv" aria-live="polite"></p>
            </div>
          </section>

          <section class="form-panel">
            <div class="form-panel-head">
              <h3>Tell Us About Your Fit</h3>
              <p>Use this space to connect your experience to the role, the systems you have owned, and the impact you delivered.</p>
            </div>

            <div class="field" data-required="true">
              <div class="field-head">
                <label for="coverLetter" class="field-label-static">Cover Letter</label>
                <span class="field-badge">Minimum 30 characters</span>
              </div>
              <div class="field-control">
                <textarea id="coverLetter" name="coverLetter" rows="7" class="field-input field-textarea" maxlength="1200" placeholder="Share the systems you have worked on, your role in them, and why this opportunity fits." required></textarea>
              </div>
              <div class="field-meta">
                <p class="field-help">A short, thoughtful explanation is better than a generic template.</p>
                <p id="cover-letter-count" class="field-count">0 / 1200</p>
              </div>
              <p class="field-error" id="error-coverLetter" aria-live="polite"></p>
            </div>
          </section>

          <div class="application-actions">
            <button type="submit" id="career-submit" class="btn-primary application-submit">
              <span id="career-submit-text">Submit Application</span>
              <svg id="career-submit-spinner" class="hidden animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
            </button>

            <p class="application-note">By submitting, you agree that TechMigos may review your application materials for hiring evaluation.</p>
          </div>

          <p id="career-status" class="career-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .career-hero {
    background:
      radial-gradient(circle at 0% 18%, rgba(14, 165, 233, 0.18), transparent 35%),
      radial-gradient(circle at 82% 12%, rgba(79, 70, 229, 0.16), transparent 34%),
      linear-gradient(180deg, #f8fbff 0%, #ffffff 78%);
  }

  .hero-noise {
    position: absolute;
    inset: 0;
    opacity: 0.25;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.65), rgba(255, 255, 255, 0.65)),
      radial-gradient(rgba(15, 23, 42, 0.06) 0.7px, transparent 0.7px);
    background-size: auto, 18px 18px;
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: end;
  }

  .hero-orb {
    position: absolute;
    border-radius: 9999px;
    filter: blur(70px);
    pointer-events: none;
  }

  .hero-orb-one {
    width: 260px;
    height: 260px;
    top: 44px;
    right: 6%;
    background: rgba(14, 165, 233, 0.18);
  }

  .hero-orb-two {
    width: 220px;
    height: 220px;
    bottom: 8px;
    left: 8%;
    background: rgba(99, 102, 241, 0.14);
  }

  .role-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.82rem;
    border-radius: 9999px;
    border: 1px solid #d8e6ff;
    background: rgba(255, 255, 255, 0.88);
    color: #0f172a;
    font-weight: 600;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .role-pill:hover {
    border-color: #7dd3fc;
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(59, 130, 246, 0.12);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .hero-cta,
  .hero-cta-secondary {
    min-height: 50px;
  }

  .summary-kicker,
  .sidebar-kicker {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    border-radius: 9999px;
    background: #eff6ff;
    color: #1d4ed8;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.72rem;
    padding: 0.4rem 0.65rem;
  }

  .career-summary {
    margin-top: -1.2rem;
    position: relative;
    z-index: 12;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }

  .summary-grid--single {
    grid-template-columns: minmax(0, 1fr);
  }

  .summary-card,
  .job-content-card,
  .sidebar-card,
  .application-shell,
  .form-panel {
    border: 1px solid #e2e8f0;
    background: #ffffff;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
  }

  .summary-card {
    border-radius: 1.25rem;
    padding: 1.25rem;
  }

  .summary-intro {
    margin-top: 1rem;
    color: #475569;
    line-height: 1.7;
    max-width: 72ch;
  }

  .summary-list {
    margin-top: 1rem;
    display: grid;
    gap: 0.8rem;
  }

  .summary-list-item {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid #edf2f7;
  }

  .summary-list-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .summary-list-item dt {
    color: #64748b;
    font-size: 0.86rem;
  }

  .summary-list-item dd {
    text-align: right;
    font-weight: 700;
    color: #0f172a;
  }

  .content-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.4rem;
    align-items: start;
  }

  .content-main {
    min-width: 0;
  }

  .content-sidebar {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .section-title {
    margin-top: 0.6rem;
    color: #0f172a;
    font-size: clamp(1.9rem, 3vw, 2.7rem);
    font-weight: 800;
    line-height: 1.1;
  }

  .toc-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .toc-chip {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    border-radius: 9999px;
    border: 1px solid #dbeafe;
    background: #ffffff;
    color: #334155;
    font-weight: 600;
    padding: 0.55rem 0.9rem;
    transition: all 180ms ease;
  }

  .toc-chip:hover,
  .toc-chip.is-active {
    color: #0f172a;
    border-color: #60a5fa;
    background: #eff6ff;
    box-shadow: 0 12px 24px rgba(59, 130, 246, 0.1);
  }

  .job-content-card {
    border-radius: 1.4rem;
    padding: 1.5rem;
  }

  .job-content {
    display: grid;
    gap: 1rem;
  }

  .job-content-intro {
    color: #64748b;
    line-height: 1.6;
  }

  .job-accordion {
    display: grid;
    gap: 0.9rem;
  }

  .job-accordion-item {
    border: 1px solid #dbeafe;
    border-radius: 1rem;
    background: #ffffff;
    overflow: hidden;
    scroll-margin-top: 7rem;
  }

  .job-accordion-item[open] {
    border-color: #93c5fd;
    box-shadow: 0 14px 30px rgba(59, 130, 246, 0.08);
  }

  .job-accordion-item.is-current {
    border-color: #60a5fa;
  }

  .job-accordion-summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.1rem;
    cursor: pointer;
    font-weight: 800;
    color: #0f172a;
  }

  .job-accordion-summary::-webkit-details-marker {
    display: none;
  }

  .job-accordion-icon {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #eff6ff;
    color: #1d4ed8;
    flex-shrink: 0;
    transition: transform 180ms ease;
  }

  .job-accordion-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .job-accordion-item[open] .job-accordion-icon {
    transform: rotate(180deg);
  }

  .job-accordion-body {
    border-top: 1px solid #e2e8f0;
    padding: 1rem 1.1rem 1.15rem;
  }

  .job-accordion-body p {
    color: #334155;
    line-height: 1.75;
    max-width: 70ch;
  }

  .job-accordion-body p + p {
    margin-top: 0.85rem;
  }

  .job-accordion-body ul {
    margin-top: 0.9rem;
    padding-left: 1.2rem;
  }

  .job-accordion-body li {
    margin: 0.5rem 0;
    color: #1e293b;
  }

  .sidebar-card {
    border-radius: 1.2rem;
