---
import AppShell from '../../../features/operations/layouts/AppShell.astro';
import Icon from '../../../features/operations/components/Icon.astro';
import StatCard from '../../../features/operations/components/StatCard.astro';
import Avatar from '../../../features/operations/components/Avatar.astro';
import { projects } from '../../../features/operations/data/live';
---
<AppShell title="Project Management · TechMigos">
  <div class="page">
    <section class="page-header">
      <div class="page-title"><h1>Project Management</h1><p>Plan. Track. Collaborate. Deliver.</p></div>
      <img class="header-illustration" src="/techmigos-ops/assets/projects-hero.png" alt="Team collaborating on projects" />
      <button class="primary-button" data-action="open-drawer" data-target="project-drawer" style="position:absolute;right:10px;bottom:15px"><Icon name="plus" size={16}/> New Project</button>
    </section>

    <section class="stats-grid">
      <StatCard icon="folder" label="Total Projects" value="28" delta="12%" tone="blue" progress={56}/>
      <StatCard icon="play" label="Active Projects" value="16" delta="7%" tone="green" progress={58}/>
      <StatCard icon="warning" label="At Risk" value="4" delta="33%" trend="down" tone="orange" progress={24}/>
      <StatCard icon="check" label="Completed" value="8" delta="60%" tone="green" progress={64}/>
      <StatCard icon="flag" label="Milestones" value="52" delta="18%" tone="purple" progress={72}/>
    </section>

    <section class="card table-card">
      <div class="table-toolbar">
        <div class="tabs" data-filter-group="project-status">
          <button class="tab active" data-value="all">All Projects (28)</button>
          <button class="tab" data-value="active">Active (16)</button>
          <button class="tab" data-value="at risk">At Risk (4)</button>
          <button class="tab" data-value="completed">Completed (8)</button>
        </div>
        <div class="toolbar-actions">
          <div class="segmented"><button class="active" data-project-view="list" aria-label="List view"><Icon name="list" size={17}/></button><button data-project-view="grid" aria-label="Grid view"><Icon name="grid" size={16}/></button></div>
          <button class="secondary-button" data-action="filter-menu"><Icon name="filter" size={15}/> Filters</button>
        </div>
      </div>
      <table class="table" id="projects-table">
        <thead><tr><th>Project</th><th>Client</th><th>Progress</th><th>Status</th><th>Team</th><th>Budget</th><th>Due Date</th><th></th></tr></thead>
        <tbody>
          {projects.map((p, index) => (
            <tr data-row-search={`${p.name} ${p.code} ${p.client} ${p.status}`} data-status={p.status.toLowerCase()}>
              <td><div class="project-cell"><div class="project-thumb"><Icon name={index % 2 ? 'play' : 'folder'} size={18}/></div><div class="cell-stack"><strong>{p.name}</strong><small>{p.code}</small></div></div></td>
              <td><span class="client-pill"><span class="client-initial">{p.clientInitial}</span>{p.client}</span></td>
              <td><div class="progress-cell"><div class="bar"><span style={`width:${p.progress}%`}></span></div><span>{p.progress}%</span></div></td>
              <td><span class={`status-pill ${p.statusTone}`}>● {p.status}</span></td>
              <td><div class="team-stack">{p.team.map((n,j)=><Avatar name={n} size="sm" tone={j+index}/>)}<span class="team-more">+{p.more}</span></div></td>
              <td>{p.budget}</td><td>{p.due}</td>
              <td><button class="ellipsis" data-action="row-menu" aria-label="Project actions"><Icon name="more" size={17}/></button></td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="table-footer"><span>Showing 1–8 of 28 projects</span><div class="pagination"><button>‹</button><button class="active">1</button><button>2</button><button>3</button><button>4</button><button>›</button></div></div>
    </section>
  </div>

  <aside class="drawer open" id="project-drawer" aria-label="Create or edit project">
    <div class="drawer-header"><h2>Create / Edit Project</h2><button class="icon-button" data-action="close-drawer" data-target="project-drawer"><Icon name="close" size={18}/></button></div>
    <form class="drawer-body" id="project-form">
      <section class="form-section"><div class="form-section-title"><Icon name="folder" size={16}/> Basic Information</div><div class="form-grid">
        <div class="field"><label>Project Name *</label><input name="name" required placeholder="Enter project name" /></div>
        <div class="field"><label>Project Code *</label><input name="code" required placeholder="e.g. TMG-009" /></div>
        <div class="field"><label>Client *</label><select name="client_id" id="project-client-id" required><option value="">Select client</option></select></div>
        <div class="field"><label>Contact Person</label><select><option>Select contact</option><option>Sarah Khan</option><option>Michael Chen</option></select></div>
        <div class="field"><label>Category</label><select><option>Web Development</option><option>Mobile App</option><option>Cloud</option><option>Consulting</option></select></div>
        <div class="field"><label>Department</label><select><option>Engineering</option><option>Design</option><option>Support</option></select></div>
      </div></section>
      <section class="form-section"><div class="form-section-title"><Icon name="calendar" size={16}/> Timeline & Status</div><div class="form-grid three">
        <div class="field"><label>Start Date</label><input type="date" name="startDate" /></div><div class="field"><label>End Date</label><input type="date" name="endDate" /></div><div class="field"><label>Priority</label><select name="priority"><option>Medium</option><option>High</option><option>Low</option></select></div>
        <div class="field full"><label>Status</label><select name="status"><option>Planning</option><option>In Progress</option><option>On Track</option><option>At Risk</option></select></div>
      </div></section>
      <section class="form-section"><div class="form-section-title"><Icon name="finance" size={16}/> Financials</div><div class="form-grid three"><div class="field"><label>Budget (USD)</label><input name="budget" type="number" placeholder="0" /></div><div class="field"><label>Billing Type</label><select><option>Fixed Cost</option><option>Hourly</option><option>Retainer</option></select></div><div class="field"><label>Estimated Hours</label><input type="number" placeholder="0" /></div></div></section>
      <section class="form-section"><div class="form-section-title"><Icon name="users" size={16}/> Team & Resources</div><div class="form-grid"><div class="field"><label>Project Manager</label><select><option>Select manager</option><option>John Carter</option><option>Sarah Mitchell</option></select></div><div class="field"><label>Team Members</label><input placeholder="Select team members" /></div></div></section>
      <section class="form-section"><div class="form-section-title"><Icon name="tag" size={16}/> Additional Details</div><div class="form-grid"><div class="field"><label>Milestones</label><input placeholder="Add milestones" /></div><div class="field"><label>Deliverables</label><input placeholder="Add deliverables" /></div><div class="field"><label>Tags</label><input placeholder="Add tags" /></div><div class="field"><label>Risk Level</label><select><option>Low</option><option>Medium</option><option>High</option></select></div><div class="field"><label>Communication Channel</label><select><option>Select channel</option><option>Email</option><option>Slack</option></select></div><div class="field"><label>File Permissions</label><select><option>Company Only</option><option>Company + Client</option></select></div></div>
        <div class="switch-row"><div><strong style="font-size:10.5px">Maintenance / AMC</strong><small style="display:block;color:#8495ad">Include in AMC</small></div><button type="button" class="switch" data-action="toggle-switch" aria-label="AMC"></button></div>
        <div class="switch-row"><div><strong style="font-size:10.5px">Project Notifications</strong><small style="display:block;color:#8495ad">Notify team members</small></div><button type="button" class="switch on" data-action="toggle-switch" aria-label="Notifications"></button></div>
        <div class="field"><label>Internal Notes</label><textarea name="notes" placeholder="Add internal notes (optional)"></textarea></div>
      </section>
    </form>
    <div class="drawer-footer"><button class="secondary-button" data-action="close-drawer" data-target="project-drawer">Cancel</button><button class="primary-button" form="project-form" type="submit">Create Project</button></div>
  </aside>
</AppShell>
