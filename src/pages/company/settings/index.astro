---
import AppShell from '../../../features/operations/layouts/AppShell.astro';
import Icon from '../../../features/operations/components/Icon.astro';
import Logo from '../../../features/operations/components/Logo.astro';
---
<AppShell title="Settings · TechMigos">
  <div class="page"><section class="page-header" style="min-height:92px"><div class="page-title"><h1>Settings</h1><p>Manage your workspace</p></div><button class="secondary-button" data-action="save-settings" style="position:absolute;right:8px;top:8px"><Icon name="eye" size={14}/> View Public Profile</button></section>
    <div class="settings-layout"><aside class="card settings-nav" data-settings-nav>{['Company Profile','Branding','Project Settings','Notifications','Security','Integrations','Billing','Team & Permissions','System Preferences'].map((x,i)=><button class={i===0?'active':''} data-settings-tab={x.toLowerCase().replace(/ /g,'-')}><Icon name={i===0?'building':i===1?'tag':i===3?'bell':i===4?'shield':i===5?'link':i===6?'finance':i===7?'users':'settings'} size={15}/>{x}</button>)}</aside>
      <section class="settings-content" id="settings-content">
        <article class="card settings-card" data-settings-section="company-profile"><h3><Icon name="building" size={16}/> Company Profile <button class="ghost-button" style="margin-left:auto;min-height:29px" data-action="edit-card"><Icon name="edit" size={13}/> Edit</button></h3><div class="company-profile-row"><div class="company-logo-large"><Logo /></div><div class="cell-stack"><strong style="font-size:14px">TechMigos Global</strong><small>Company Name</small><div style="display:flex;gap:16px;margin-top:12px"><div><small>Website</small><strong>https://techmigos.com</strong></div><div><small>Industry</small><strong>IT Services</strong></div></div><div style="display:flex;gap:16px;margin-top:9px"><div><small>Location</small><strong>Hyderabad, India</strong></div><div><small>Company Size</small><strong>8–50</strong></div></div></div></div></article>
        <article class="card settings-card" data-settings-section="branding"><h3><Icon name="tag" size={16}/> Branding <button class="ghost-button" style="margin-left:auto;min-height:29px" data-action="edit-card"><Icon name="edit" size={13}/> Edit</button></h3><img class="brand-preview" src="/techmigos-ops/assets/brand-preview.png" alt="TechMigos brand preview"/><div style="display:flex;align-items:center;gap:8px;margin-top:10px"><small style="color:#7e8fa8">Brand Colors</small><span style="width:20px;height:20px;border-radius:50%;background:#0b6ffb"></span><span style="width:20px;height:20px;border-radius:50%;background:#173358"></span><span style="width:20px;height:20px;border-radius:50%;background:#dfe9f6"></span><small style="margin-left:auto;color:#7e8fa8">Favicon</small><Logo /></div></article>
        <article class="card settings-card" data-settings-section="project-settings"><h3><Icon name="folder" size={16}/> Default Project Settings <button class="ghost-button" style="margin-left:auto;min-height:29px" data-action="edit-card"><Icon name="edit" size={13}/> Edit</button></h3><div class="form-grid"><div class="field"><label>Default Status</label><select><option>Planning</option><option>In Progress</option></select></div><div class="field"><label>Default Priority</label><select><option>Medium</option><option>High</option></select></div><div class="field"><label>Default Team Access</label><select><option>Project Members</option></select></div><div class="field"><label>Default Billing</label><select><option>Not billable</option><option>Billable</option></select></div></div></article>
        <article class="card settings-card" data-settings-section="notifications"><h3><Icon name="bell" size={16}/> Notification Preferences</h3>{['Project updates','Task assignments','Client messages','Meeting & comments','System announcements','Weekly summary'].map((x,i)=><div class="switch-row"><span style="font-size:10.5px">{x}</span><button class:list={{switch:true,on:i<4}} data-action="toggle-switch"></button></div>)}</article>
        <article class="card settings-card" data-settings-section="security"><h3><Icon name="shield" size={16}/> Security Settings <button class="ghost-button" style="margin-left:auto;min-height:29px" data-action="edit-card"><Icon name="edit" size={13}/> Edit</button></h3><div style="display:grid;grid-template-columns:repeat(3,1fr);gap:9px"><div class="meta-box"><small>Two-Factor Auth</small><strong style="color:#07865b">✓ Enabled</strong></div><div class="meta-box"><small>Password Policy</small><strong>Strong</strong></div><div class="meta-box"><small>Active Sessions</small><strong>2 devices</strong></div></div></article>
        <article class="card settings-card" data-settings-section="integrations"><h3><Icon name="link" size={16}/> Integrations <button class="ghost-button" style="margin-left:auto;min-height:29px" data-action="add-integration"><Icon name="plus" size={13}/> Manage</button></h3><div class="integration-row"><span class="integration-icon">G</span><div class="cell-stack"><strong>Google Drive</strong><small>Connected</small></div><button class="secondary-button">Manage</button></div><div class="integration-row"><span class="integration-icon">GH</span><div class="cell-stack"><strong>GitHub</strong><small>Connected</small></div><button class="secondary-button">Manage</button></div><div class="integration-row"><span class="integration-icon">S</span><div class="cell-stack"><strong>Slack</strong><small>Not connected</small></div><button class="secondary-button">Connect</button></div></article>
      </section></div>
  </div>
</AppShell>
