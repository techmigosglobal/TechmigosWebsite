---
import AppShell from '../../../features/operations/layouts/AppShell.astro';
import Icon from '../../../features/operations/components/Icon.astro';
import Avatar from '../../../features/operations/components/Avatar.astro';
import { files } from '../../../features/operations/data/live';
---
<AppShell title="Project Files · TechMigos">
  <div class="page files-layout">
    <aside class="card file-sidebar">
      <a href="/company/projects" class="tag" style="border:0;background:transparent;margin-bottom:8px"><Icon name="chevronLeft" size={14}/> Projects</a>
      <div class="project-mini"><div class="project-thumb">A</div><div class="cell-stack"><strong>Website Redesign</strong><small>TMG-001 · Acme Corp</small></div></div>
      <nav class="folder-nav" data-folder-nav>
        <button class="active" data-folder="all"><Icon name="folder" size={18}/> All Files <span class="count">24</span></button>
        <button data-folder="design"><Icon name="folder" size={18}/> Design <span class="count">8</span></button>
        <button data-folder="documents"><Icon name="folder" size={18}/> Documents <span class="count">5</span></button>
        <button data-folder="development"><Icon name="folder" size={18}/> Development <span class="count">6</span></button>
        <button data-folder="assets"><Icon name="folder" size={18}/> Assets <span class="count">4</span></button>
        <button data-folder="feedback"><Icon name="message" size={18}/> Client Feedback <span class="count">3</span></button>
        <button data-folder="archive"><Icon name="report" size={18}/> Archive <span class="count">0</span></button>
      </nav>
      <button class="secondary-button new-folder" data-action="new-folder"><Icon name="plus" size={15}/> New Folder</button>
    </aside>

    <section class="files-main">
      <div class="files-heading"><div><h1>All Files</h1><p>Website Redesign · <span id="file-count">24 items</span></p></div><div class="toolbar-actions"><div class="segmented"><button class="active" data-file-view="grid"><Icon name="grid" size={16}/></button><button data-file-view="list"><Icon name="list" size={17}/></button></div><select class="secondary-button" id="file-sort" style="appearance:auto"><option>Last Modified</option><option>Name</option><option>Size</option></select><button class="secondary-button"><Icon name="filter" size={15}/> Filters</button></div></div>
      <div class="dropzone" id="dropzone"><div><div class="upload-cloud"><Icon name="upload" size={22}/></div><strong>Drop files here or <span style="color:var(--blue)">click to upload</span></strong><p>Images, PDFs, Docs, ZIP up to 100MB</p><button class="secondary-button" data-action="trigger-upload"><Icon name="upload" size={15}/> Upload Files</button><input id="file-input" type="file" multiple hidden /></div></div>

      <div class="section-heading"><h2>Folders</h2></div>
      <div class="folder-grid" id="folder-grid">
        {['Design','Documents','Development','Assets'].map((name,i)=><button class="folder-card" data-action="open-folder" data-folder={name.toLowerCase()} style="text-align:left"><div class="folder-shape"></div><strong>{name}</strong><small>{[8,5,6,4][i]} items</small><span class="ellipsis" style="position:absolute;right:6px;top:6px"><Icon name="more" size={16}/></span></button>)}
      </div>
      <div class="section-heading"><h2>Files</h2></div>
      <div class="file-grid" id="file-grid">
        {files.map((f,i)=><button class:list={{'file-card':true,'selected':i===0}} data-file={f.name} data-type={f.type} data-size={f.size} data-action="select-file"><span class="ellipsis"><Icon name="more" size={16}/></span><div class={`file-visual ${f.visual}`}>{(f.visual==='preview') && <img src="/techmigos-ops/assets/file-preview.png" alt="Homepage design preview" />}{(f.visual==='brand') && <img src="/techmigos-ops/assets/brand-preview.png" alt="Brand guidelines preview" />}</div><strong>{f.name}</strong><small>{f.type} · {f.size}</small></button>)}
      </div>
    </section>
  </div>

  <aside class="detail-panel open" id="file-detail">
    <div class="drawer-header"><div style="display:flex;align-items:center;gap:10px"><span class="status-pill red">PNG</span><h2 id="detail-file-name">homepage-design.png</h2></div><button class="icon-button" data-action="close-detail"><Icon name="close" size={18}/></button></div>
    <div class="detail-content"><img class="detail-preview" id="detail-preview" src="/techmigos-ops/assets/file-preview.png" alt="Selected file preview" /><div class="detail-meta"><span class="tag" id="detail-type">PNG</span><span class="tag" id="detail-size">2.4 MB</span><span class="tag">1920 × 1080</span><span class="tag"><Icon name="calendar" size={13}/> Apr 25, 2025, 10:24 AM</span></div><div style="display:flex;align-items:center;gap:9px"><Avatar name="John Doe" size="sm" tone={0}/><div class="cell-stack"><small>Uploaded by</small><strong>John Doe</strong></div></div><div class="detail-actions"><button class="secondary-button" data-action="download-file"><Icon name="download" size={15}/> Download</button><button class="secondary-button" data-action="copy-link"><Icon name="link" size={15}/> Share</button><button class="secondary-button" data-action="lock-file"><Icon name="lock" size={15}/> Lock</button></div><div class="switch-row card" style="padding:10px"><div><strong style="font-size:11px">Visible to Client</strong><small style="display:block;color:#8091aa">Client can view this file</small></div><button class="switch on" data-action="toggle-switch"></button></div><div class="tabs" style="margin-top:18px;border-bottom:1px solid var(--line)"><button class="tab active">Related Files</button><button class="tab">Folder Contents</button><button class="tab">Activity</button></div><div class="related-grid"><div class="related-card">hero-bg.jpg</div><div class="related-card">wireframes.pdf</div><div class="related-card">copy-draft.docx</div><div class="related-card">mobile-ui.fig</div><div class="related-card">logo-variations.png</div><div class="related-card">icons.zip</div></div></div>
  </aside>
</AppShell>
