---
import AppShell from '../../../features/operations/layouts/AppShell.astro';
import Icon from '../../../features/operations/components/Icon.astro';
import StatCard from '../../../features/operations/components/StatCard.astro';
import Avatar from '../../../features/operations/components/Avatar.astro';
import { tickets } from '../../../features/operations/data/live';
---
<AppShell title="Support Tickets · TechMigos">
  <div class="page">
    <section class="page-header"><div class="page-title"><h1>Support Tickets</h1><p>Help people. Solve problems. Build great experiences.</p></div><img class="header-illustration" src="/techmigos-ops/assets/support-hero.png" alt="Customer support illustration" /></section>
    <section class="stats-grid four"><StatCard icon="mail" label="Total Tickets" value="32" delta="12%" tone="blue" progress={68}/><StatCard icon="clock" label="Open" value="18" delta="6%" trend="down" tone="red" progress={45}/><StatCard icon="check" label="Resolved" value="9" delta="28%" tone="green" progress={54}/><StatCard icon="warning" label="Overdue" value="5" delta="25%" trend="down" tone="red" progress={29}/></section>
    <div class="support-layout">
      <section class="card table-card">
        <div class="table-toolbar"><div class="tabs" data-filter-group="ticket-status"><button class="tab active" data-value="all">All Tickets (32)</button><button class="tab" data-value="open">Open (18)</button><button class="tab" data-value="pending">Pending (6)</button><button class="tab" data-value="resolved">Resolved (9)</button><button class="tab" data-value="closed">Closed (5)</button></div><div class="toolbar-actions"><div class="segmented"><button class="active"><Icon name="list" size={16}/></button><button><Icon name="grid" size={16}/></button></div><button class="secondary-button"><Icon name="filter" size={15}/> Filters</button></div></div>
        <table class="table" id="tickets-table"><thead><tr><th></th><th>Ticket</th><th>Requester</th><th>Category</th><th>Priority</th><th>Status</th><th>Created ↓</th><th></th></tr></thead><tbody>
          {tickets.map((t,i)=><tr data-ticket={t.id} data-status={t.status.toLowerCase()} data-row-search={`${t.id} ${t.title} ${t.requester} ${t.company}`} data-action="select-ticket"><td><input type="checkbox" /></td><td><div class="project-cell"><div class={`stat-icon tone-${i%3===0?'blue':i%3===1?'green':'red'}`} style="margin:0;width:34px;height:34px"><Icon name="message" size={15}/></div><div class="cell-stack"><strong>{t.id}</strong><small>{t.title}</small></div></div></td><td><div class="requester-cell"><Avatar name={t.requester} size="sm" tone={i}/><div class="cell-stack"><strong>{t.requester}</strong><small>{t.company}</small></div></div></td><td>{t.category}</td><td><span class={`status-pill ${t.tone}`}>● {t.priority}</span></td><td><span class={`status-pill ${t.status==='Resolved'?'green':t.status==='Closed'?'slate':t.status==='Pending'?'orange':'blue'}`}>{t.status}</span></td><td>{t.date}</td><td><button class="ellipsis"><Icon name="more" size={16}/></button></td></tr>)}
        </tbody></table><div class="table-footer"><span>Showing 1–8 of 32 tickets</span><div class="pagination"><button>‹</button><button class="active">1</button><button>2</button><button>3</button><button>4</button><button>›</button></div></div>
      </section>

      <aside class="card support-detail" id="ticket-detail">
        <div class="ticket-head"><div class="ticket-head-row"><div style="display:flex;gap:10px;align-items:center"><strong id="ticket-id" style="font-size:15px">#SUP-0421</strong><span class="status-pill green">● Open</span></div><div><button class="icon-button" data-ticket-nav="-1"><Icon name="chevronLeft" size={16}/></button><button class="icon-button" data-ticket-nav="1"><Icon name="chevronRight" size={16}/></button></div></div><h2 id="ticket-title">Cannot access my account</h2><p id="ticket-summary">I’m unable to log in to my account. It shows an invalid credentials error even though I’m using the correct details.</p><div style="display:flex;gap:6px;margin-top:10px"><span class="tag"><Icon name="lock" size={12}/> Access</span><span class="tag">Login</span><span class="tag">Account</span></div></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:12px 0"><div><small style="color:#7f90a9">Requester</small><div class="requester-cell" style="margin-top:7px"><Avatar name="Sarah Khan" size="md" tone={4}/><div class="cell-stack"><strong>Sarah Khan</strong><small>Acme Corp</small></div></div></div><div><small style="color:#7f90a9">Assignee</small><div class="requester-cell" style="margin-top:7px"><Avatar name="Alex Morgan" size="md" tone={1}/><div class="cell-stack"><strong>Alex Morgan</strong><small>Support Team</small></div></div></div></div>
        <div class="ticket-meta-grid"><div class="meta-box"><small>Priority</small><strong style="color:#e14350">● High</strong></div><div class="meta-box"><small>SLA</small><strong style="color:#07865b">◷ 16h left</strong></div><div class="meta-box"><small>Created</small><strong>Apr 25, 2025<br/>10:24 AM</strong></div></div>
        <div class="message-thread" id="message-thread"><div class="message"><Avatar name="Sarah Khan" size="sm" tone={4}/><div><div class="message-meta"><strong>Sarah Khan</strong> · 10:24 AM</div><div class="message-bubble">Hi, I’m unable to log in to my account. It shows an invalid credentials error.</div></div></div><div class="message agent"><Avatar name="Alex Morgan" size="sm" tone={1}/><div><div class="message-meta"><strong>Alex Morgan</strong> · 11:02 AM</div><div class="message-bubble">Hi Sarah! Thanks for reaching out. I’ll look into this right away. Could you please confirm if you’re using SSO or a direct login?</div></div></div><div class="message"><Avatar name="Sarah Khan" size="sm" tone={4}/><div><div class="message-meta"><strong>Sarah Khan</strong> · 11:15 AM</div><div class="message-bubble">I’m using direct login with my work email.</div></div></div><div class="message agent"><Avatar name="Alex Morgan" size="sm" tone={1}/><div><div class="message-meta"><strong>Alex Morgan</strong> · 11:20 AM</div><div class="message-bubble">Got it! I’ve reset your account password. You should receive an email shortly. Please try logging in and let me know if it works.</div></div></div><div class="message"><Avatar name="Sarah Khan" size="sm" tone={4}/><div><div class="message-meta"><strong>Sarah Khan</strong> · 11:28 AM</div><div class="message-bubble">It’s working now! Thank you so much! 👍</div></div></div></div>
        <div class="reply-box"><div class="reply-tabs"><button class="active" data-reply-mode="reply">Reply</button><button data-reply-mode="note">Internal Note</button></div><textarea id="reply-input" placeholder="Type a reply…"></textarea><div class="reply-actions"><button class="icon-button"><Icon name="paperclip" size={17}/></button><button class="icon-button"><Icon name="mail" size={17}/></button><button class="primary-button" data-action="send-reply"><Icon name="send" size={15}/> Send Reply</button></div></div>
      </aside>
    </div>
  </div>
</AppShell>
