---
import AppShell from '../../../features/operations/layouts/AppShell.astro';
import Icon from '../../../features/operations/components/Icon.astro';
import StatCard from '../../../features/operations/components/StatCard.astro';
import Avatar from '../../../features/operations/components/Avatar.astro';
import { users } from '../../../features/operations/data/live';
---
<AppShell title="User Management · TechMigos">
  <div class="page">
    <section class="page-header"><div class="page-title"><h1>User Management</h1><p>People. Access. Productivity.</p></div><img class="header-illustration" src="/techmigos-ops/assets/projects-hero.png" alt="Team collaboration illustration" /><button class="primary-button" data-action="open-drawer" data-target="user-drawer" style="position:absolute;right:10px;bottom:15px"><Icon name="plus" size={15}/> Add User</button></section>
    <section class="stats-grid"><StatCard icon="users" label="Total Users" value="42" delta="8%" tone="blue" progress={72}/><StatCard icon="check" label="Active" value="36" delta="4%" tone="green" progress={84}/><StatCard icon="clock" label="Pending" value="4" delta="20%" trend="down" tone="orange" progress={28}/><StatCard icon="lock" label="Roles" value="6" delta="10%" tone="purple" progress={64}/><StatCard icon="shield" label="Admins" value="3" delta="0%" tone="blue" progress={42}/></section>
    <section class="card table-card"><div class="table-toolbar"><div class="tabs" data-filter-group="user-status"><button class="tab active" data-value="all">All Users (42)</button><button class="tab" data-value="active">Active (36)</button><button class="tab" data-value="inactive">Inactive (2)</button><button class="tab" data-value="pending">Pending (4)</button></div><div class="toolbar-actions"><label class="global-search" style="width:220px;height:36px"><Icon name="search" size={15}/><input id="user-search" placeholder="Search users…" /></label><button class="secondary-button"><Icon name="filter" size={15}/> Filters</button></div></div>
      <table class="table" id="users-table"><thead><tr><th>User</th><th>Role</th><th>Company / Client</th><th>Status</th><th>Last Active</th><th>Actions</th></tr></thead><tbody>
        {users.map((u,i)=><tr data-status={u.status.toLowerCase()} data-row-search={`${u.name} ${u.email} ${u.role} ${u.company}`}><td><div class="user-cell"><Avatar name={u.name} size="md" tone={i}/><div class="cell-stack"><strong>{u.name}</strong><small>{u.email}</small></div></div></td><td><span class="role-chip">{u.role}</span></td><td><span class="client-pill"><span class="company-dot">{u.company[0]}</span>{u.company}</span></td><td><span class={`status-pill ${u.status==='Active'?'green':'slate'}`}>● {u.status}</span></td><td>{u.last}</td><td><button class="ellipsis" data-action="row-menu"><Icon name="more" size={17}/></button></td></tr>)}
      </tbody></table><div class="table-footer"><span>Showing 1–8 of 42 users</span><div class="pagination"><button>‹</button><button class="active">1</button><button>2</button><button>3</button><button>4</button><button>›</button></div></div>
    </section>
  </div>

  <aside class="drawer open" id="user-drawer"><div class="drawer-header"><h2>Create / Edit User</h2><button class="icon-button" data-action="close-drawer" data-target="user-drawer"><Icon name="close" size={18}/></button></div><form class="drawer-body" id="user-form">
    <section class="form-section"><div class="form-section-title"><Icon name="users" size={16}/> Basic Information</div><div class="form-grid"><div class="field"><label>Full Name *</label><input name="name" required placeholder="John Carter" /></div><div class="field"><label>Email *</label><input name="email" type="email" required placeholder="user@company.com" /></div><div class="field"><label>Role *</label><select name="role"><option>Admin</option><option>Project Manager</option><option>Developer</option><option>Designer</option><option>Support</option><option>Client</option></select></div><div class="field"><label>Status</label><select name="status"><option>Active</option><option>Pending</option><option>Inactive</option></select></div></div></section>
    <section class="form-section"><div class="form-section-title"><Icon name="building" size={16}/> Organization</div><div class="form-grid"><div class="field"><label>Company / Client</label><select name="client_id" id="user-client-id"><option value="">Company user</option></select><small style="color:#7e8fa8">Required when the role is Client.</small></div><div class="field"><label>Department</label><select name="department"><option value="">Select department</option><option>Engineering</option><option>Design</option><option>Support</option><option>Operations</option></select></div></div></section>
    <section class="form-section"><div class="form-section-title"><Icon name="shield" size={16}/> Permissions</div><div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px">{['Users','Settings','Reports','Billing','Projects','Files'].map((x,i)=><button type="button" class={`tag permission-tag ${i<3?'selected':''}`} data-action="toggle-permission"><Icon name={i<2?'users':'report'} size={13}/>{x}</button>)}</div></section>
    <section class="form-section"><div class="form-section-title"><Icon name="calendar" size={16}/> Additional Details</div><div class="form-grid"><div class="field"><label>Job Title</label><input placeholder="Senior Developer" /></div><div class="field"><label>Phone (optional)</label><input placeholder="+91 98765 43210" /></div><div class="field"><label>Location</label><select><option>India</option><option>United States</option><option>Remote</option></select></div><div class="field"><label>Time Zone</label><select><option>GMT+5:30</option><option>GMT</option><option>EST</option></select></div></div></section>
    <section class="form-section"><div class="form-section-title"><Icon name="users" size={16}/> Profile Photo</div><div style="display:flex;align-items:center;gap:10px"><Avatar name="New User" size="lg" tone={0}/><button type="button" class="secondary-button">Upload Photo</button><button type="button" class="ghost-button">Remove</button></div></section>
  </form><div class="drawer-footer"><button class="secondary-button" data-action="close-drawer" data-target="user-drawer">Cancel</button><button class="primary-button" type="submit" form="user-form">Create User</button></div></aside>
</AppShell>
