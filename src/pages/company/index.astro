---
import AppShell from '../../features/operations/layouts/AppShell.astro';
import Icon from '../../features/operations/components/Icon.astro';
import StatCard from '../../features/operations/components/StatCard.astro';
import Avatar from '../../features/operations/components/Avatar.astro';
import { projects } from '../../features/operations/data/live';
---
<AppShell title="Dashboard · TechMigos"><div class="page"><section class="page-header"><div class="page-title"><h1>Operations Dashboard</h1><p>Everything your team needs, in one connected workspace.</p></div><img class="header-illustration" src="/techmigos-ops/assets/projects-hero.png" alt="Team collaboration"/></section>
  <div class="quick-actions"><a class="quick-action" href="/company/projects"><div class="stat-icon tone-blue"><Icon name="plus" size={18}/></div><div><strong>Create Project</strong><small>Plan a new delivery</small></div></a><a class="quick-action" href="/company/files"><div class="stat-icon tone-purple"><Icon name="upload" size={18}/></div><div><strong>Upload Files</strong><small>Share project assets</small></div></a><a class="quick-action" href="/company/support"><div class="stat-icon tone-green"><Icon name="support" size={18}/></div><div><strong>Support Queue</strong><small>18 tickets need review</small></div></a><a class="quick-action" href="/company/users"><div class="stat-icon tone-orange"><Icon name="users" size={18}/></div><div><strong>Manage Team</strong><small>People and permissions</small></div></a></div>
  <section class="stats-grid"><StatCard icon="folder" label="Active Projects" value="16" delta="7%" tone="blue" progress={68}/><StatCard icon="check" label="Completed" value="8" delta="18%" tone="green" progress={54}/><StatCard icon="support" label="Open Tickets" value="18" delta="6%" trend="down" tone="orange" progress={42}/><StatCard icon="finance" label="Monthly Revenue" value="$84K" delta="14%" tone="purple" progress={74}/><StatCard icon="users" label="Active Users" value="36" delta="4%" tone="green" progress={81}/></section>
  <div class="dashboard-grid"><section class="card table-card"><div class="table-toolbar"><strong style="font-size:14px">Your Projects</strong><a href="/company/projects" class="secondary-button" style="margin-left:auto">View All <Icon name="chevronRight" size={14}/></a></div><table class="table" id="dashboard-projects"><thead><tr><th>Project</th><th>Client</th><th>Progress</th><th>Status</th><th>Due</th></tr></thead><tbody>{projects.slice(0,5).map((p,i)=><tr><td><div class="project-cell"><div class="project-thumb"><Icon name="folder" size={16}/></div><div class="cell-stack"><strong>{p.name}</strong><small>{p.code}</small></div></div></td><td>{p.client}</td><td><div class="progress-cell"><div class="bar"><span style={`width:${p.progress}%`}></span></div><span>{p.progress}%</span></div></td><td><span class={`status-pill ${p.statusTone}`}>{p.status}</span></td><td>{p.due}</td></tr>)}</tbody></table></section><aside class="card metric-panel"><h2>Latest Activity</h2><div class="activity-list" id="dashboard-activity">{[['Sarah Mitchell','updated Website Redesign','8 min ago'],['Alex Morgan','replied to #SUP-0421','24 min ago'],['Emily Rodriguez','uploaded brand-guidelines.png','1 hr ago'],['John Carter','added Michael to CRM Integration','2 hrs ago'],['Priya Nair','changed project permissions','Yesterday']].map((a,i)=><div class="activity"><Avatar name={a[0]} size="sm" tone={i}/><div><p><strong>{a[0]}</strong> {a[1]}</p><small>{a[2]}</small></div></div>)}</div></aside></div>
</div></AppShell>
