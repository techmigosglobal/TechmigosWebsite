---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Project Support for Clients"
  description="Get help from TechMigos for an active project, deployment issue, or product request. We triage support requests quickly and respond within one business day."
  noIndex={true}
>
  <section class="pt-36 pb-16 relative overflow-hidden">
    <div class="absolute inset-0 dot-pattern opacity-50"></div>
    <div class="absolute -top-28 -right-24 w-96 h-96 bg-primary-100 rounded-full blur-3xl opacity-60"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-accent-100 rounded-full blur-3xl opacity-40"></div>
    <div class="container-custom relative z-10">
      <div class="max-w-3xl">
        <span class="section-eyebrow reveal">Need Help?</span>
        <h1 class="reveal stagger-1 text-5xl sm:text-6xl font-extrabold text-gray-900 mb-4 leading-tight">
          Project Support
          <span class="text-gradient">Desk</span>
        </h1>
        <p class="reveal stagger-2 text-xl text-gray-500 leading-relaxed max-w-2xl">
          Tell us what is broken, blocked, or unclear and we will route it to the right person.
          For production incidents, include the exact page, error message, and steps to reproduce.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-32 bg-white">
    <div class="container-custom">
      <div class="grid lg:grid-cols-5 gap-16">
        <div class="lg:col-span-3 reveal-left">
          <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-8">
            <div class="flex items-start justify-between gap-6 mb-8">
              <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-2">Open a support request</h2>
                <p class="text-gray-500 text-sm">We usually reply within one business day. Urgent issues should be marked high priority.</p>
              </div>
              <div class="hidden sm:flex items-center justify-center w-14 h-14 rounded-2xl bg-primary-50 text-2xl">
                🛟
              </div>
            </div>

            <form id="support-form" class="space-y-6" method="POST">
              <input type="text" name="company_website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

              <div class="grid sm:grid-cols-2 gap-6">
                <div class="form-group">
                  <label for="name" class="form-label">
                    Full Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="form-input form-control form-control--muted"
                    placeholder="John Smith"
                  />
                </div>
                <div class="form-group">
                  <label for="email" class="form-label">
                    Email <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="form-input form-control form-control--muted"
                    placeholder="john@company.com"
                  />
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-6">
                <div class="form-group">
                  <label for="company" class="form-label">Company</label>
                  <input
                    type="text"
                    id="company"
                    name="company"
                    class="form-input form-control form-control--muted"
                    placeholder="Your company or organization"
                  />
                </div>
                <div class="form-group">
                  <label for="product" class="form-label">Product / Project</label>
                  <input
                    type="text"
                    id="product"
                    name="product"
                    class="form-input form-control form-control--muted"
                    placeholder="Website, app, campaign, or area affected"
                  />
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-6">
                <div class="form-group">
                  <label for="topic" class="form-label">
                    Support Topic <span class="text-red-500">*</span>
                  </label>
                  <select
                    id="topic"
                    name="topic"
                    required
                    class="form-input form-control form-control--muted appearance-none"
                  >
                    <option value="">Choose a topic</option>
                    <option value="technical">Technical issue</option>
                    <option value="deployment">Deployment help</option>
                    <option value="bug">Bug report</option>
                    <option value="content">Content update</option>
                    <option value="access">Account access</option>
                    <option value="billing">Billing or invoice</option>
                    <option value="teacher-training">Teacher training or technical guidance</option>
                    <option value="other">Other</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="priority" class="form-label">
                    Priority <span class="text-red-500">*</span>
                  </label>
                  <select
                    id="priority"
                    name="priority"
                    required
                    class="form-input form-control form-control--muted appearance-none"
                  >
                    <option value="">Choose priority</option>
                    <option value="low">Low</option>
                    <option value="medium">Medium</option>
                    <option value="high">High</option>
                    <option value="urgent">Urgent</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="subject" class="form-label">
                  Subject <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  required
                  class="form-input form-control form-control--muted"
                  placeholder="Short summary of the issue"
                />
              </div>

              <div class="form-group">
                <label for="message" class="form-label">
                  Request Details <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="6"
                  class="form-input form-control form-control--muted form-textarea resize-none"
                  placeholder="Describe what happened, what you expected, the page or feature involved, and any steps to reproduce it."
                ></textarea>
              </div>

              <button
                type="submit"
                id="submit-btn"
                class="btn-primary w-full justify-center py-4 text-base shine-hover group"
              >
                <span id="btn-text">Send Support Request</span>
                <svg id="btn-icon" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                </svg>
                <svg id="btn-spinner" class="hidden animate-spin w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
              </button>
            </form>
          </div>
        </div>

        <div class="lg:col-span-2 reveal-right space-y-6">
          {[
            {
              icon: '⚡',
              title: 'Urgent issues',
              value: '+919959703547',
              href: 'tel:+919959703547',
              sub: 'Call or WhatsApp for blocked deployments and production outages',
            },
            {
              icon: '📧',
              title: 'Email support',
              value: 'info@techmigos.com',
              href: 'mailto:info@techmigos.com',
              sub: 'Best for screenshots, logs, and longer explanations',
            },
            {
              icon: '🕐',
              title: 'Response window',
              value: 'Within 1 business day',
              href: 'mailto:info@techmigos.com',
              sub: 'High priority items are reviewed first during office hours',
            },
            {
              icon: '📍',
              title: 'Office hours',
              value: 'Mon–Fri: 9AM – 6PM IST',
              href: 'tel:+919959703547',
              sub: 'Weekend support is handled by appointment',
            },
          ].map((item, i) => (
            <a
              href={item.href}
              class={`flex items-start gap-4 p-5 rounded-2xl border border-gray-100 bg-white hover:border-primary-200 hover:shadow-lg transition-[border-color,box-shadow,transform] duration-300 group glow-card stagger-${i + 1}`}
            >
              <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl flex-shrink-0 group-hover:scale-110 transition-transform" style="background: linear-gradient(135deg, rgba(79,70,229,0.1), rgba(6,182,212,0.1))">
                {item.icon}
              </div>
              <div>
                <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-0.5">{item.title}</div>
                <div class="font-semibold text-gray-900 group-hover:text-primary-600 transition-colors">{item.value}</div>
                <div class="text-sm text-gray-500 mt-0.5">{item.sub}</div>
              </div>
            </a>
          ))}

          <div class="rounded-3xl border border-gray-100 bg-gray-50 p-6">
            <h3 class="text-base font-bold text-gray-900 mb-4">Include these details if possible</h3>
            <ul class="space-y-3 text-sm text-gray-600">
              <li class="flex gap-3"><span class="text-primary-600">•</span>Exact page or feature name</li>
              <li class="flex gap-3"><span class="text-primary-600">•</span>Steps to reproduce the issue</li>
              <li class="flex gap-3"><span class="text-primary-600">•</span>Error message or screenshot</li>
              <li class="flex gap-3"><span class="text-primary-600">•</span>Any recent changes before the issue started</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div id="form-toast" class="fixed bottom-8 right-8 px-6 py-4 rounded-2xl shadow-2xl transform translate-y-24 opacity-0 transition-[transform,opacity] duration-500 z-50 flex items-center gap-3" role="status" aria-live="polite">
    <span id="toast-icon" class="text-xl"></span>
    <p id="toast-message" class="font-medium"></p>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('support-form') as HTMLFormElement;
  const toast = document.getElementById('form-toast') as HTMLElement;
  const toastMessage = document.getElementById('toast-message') as HTMLElement;
  const toastIcon = document.getElementById('toast-icon') as HTMLElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLElement;
  const btnIcon = document.getElementById('btn-icon') as HTMLElement;
  const btnSpinner = document.getElementById('btn-spinner') as HTMLElement;

  document.querySelectorAll('.form-input').forEach((input) => {
    input.addEventListener('focus', () => {
      (input as HTMLElement).parentElement?.classList.add('focused');
    });
    input.addEventListener('blur', () => {
      (input as HTMLElement).parentElement?.classList.remove('focused');
    });
  });

  function showToast(message: string, type: 'success' | 'error') {
    toast.className = `fixed bottom-8 right-8 px-6 py-4 rounded-2xl shadow-2xl flex items-center gap-3 z-50 transition-[transform,opacity] duration-500 ${
      type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
    }`;
    toastIcon.textContent = type === 'success' ? '✅' : '❌';
    toastMessage.textContent = message;
    toast.style.transform = 'translateY(0)';
    toast.style.opacity = '1';
    setTimeout(() => {
      toast.style.transform = 'translateY(100px)';
      toast.style.opacity = '0';
    }, 5000);
  }

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    btnText.textContent = loading ? 'Sending...' : 'Send Support Request';
    btnIcon.classList.toggle('hidden', loading);
    btnSpinner.classList.toggle('hidden', !loading);
  }

  async function getCsrfToken() {
    return (window as any).techmigosGetCsrfToken('Could not initialize secure form submission. Please refresh and try again.');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    setLoading(true);

    try {
      const formData = new FormData(form);
      const topic = String(formData.get('topic') || '');
      const priority = String(formData.get('priority') || '');
      const subject = String(formData.get('subject') || '');
      const details = String(formData.get('message') || '');
      const company = String(formData.get('company') || '');
      const product = String(formData.get('product') || '');

      const message = [
        `Subject: ${subject}`,
        `Support Topic: ${topic}`,
        `Priority: ${priority}`,
        company ? `Company: ${company}` : '',
        product ? `Product / Project: ${product}` : '',
        '',
        details,
      ].filter(Boolean).join('\n');

      const payload = {
        name: String(formData.get('name') || ''),
        email: String(formData.get('email') || ''),
        company,
        service: topic,
        budget: priority,
        message,
        company_website: String(formData.get('company_website') || ''),
        sourcePath: '/support',
      };

      const csrfToken = await getCsrfToken();
      const response = await (window as any).techmigosApiFetch('/api/leads/contact', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-csrf-token': csrfToken,
        },
        body: JSON.stringify(payload),
      });
      const result = await response.json();

      if (!response.ok || !result.ok) {
        if (result.fieldErrors) {
          const firstError = Object.values(result.fieldErrors)[0];
          throw new Error(String(firstError || result.error || 'Validation failed.'));
        }
        throw new Error(result.error || 'Request failed.');
      }

      showToast('Support request sent. We will review it shortly.', 'success');
      form.reset();
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Something went wrong. Please email us directly.';
      showToast(message, 'error');
    } finally {
      setLoading(false);
    }
  });
</script>
