      const open = state.data.tickets.filter((item) => !['resolved', 'closed'].includes(item.status));
      const high = state.data.tickets.filter((item) => ['high', 'urgent'].includes(item.priority));
      const rows = filtered(state.data.tickets, ['subject', 'status', 'priority', 'assigned_to']).map((ticket) => `
        <tr data-resource="tickets" data-row-id="${ticket.id}">
          <td><input type="checkbox" data-row-select aria-label="Select ticket ${ticket.id}" /></td>
          <td>#TIC-${ticket.id}</td><td><input class="crm-edit-input" data-field="subject" value="${escapeHtml(ticket.subject)}" /></td><td>${escapeHtml(clientName(ticket.client_id))}</td>
          <td>${escapeHtml(projectName(ticket.project_id))}</td>
          <td><select class="crm-edit-select" data-field="priority">${['low', 'medium', 'high', 'urgent'].map((item) => `<option value="${item}" ${ticket.priority === item ? 'selected' : ''}>${nice(item)}</option>`).join('')}</select></td>
          <td><input class="crm-edit-input" data-field="assigned_to" value="${escapeHtml(ticket.assigned_to || '')}" /></td>
          <td>${ticket.priority === 'urgent' ? badge('breached', 'red') : ticket.priority === 'high' ? badge('at_risk', 'orange') : badge('on_track', 'green')}</td>
          <td><select class="crm-edit-select" data-field="status">${['open', 'in_progress', 'waiting', 'resolved', 'closed'].map((item) => `<option value="${item}" ${ticket.status === item ? 'selected' : ''}>${nice(item)}</option>`).join('')}</select></td>
          <td>${rowActions('tickets', ticket.id, { view: true, viewAttr: `data-ticket-detail="${ticket.id}"` })}</td>
        </tr>`).join('');
      els.view.innerHTML = `
        ${pageHead('Support Ticketing', 'Track, assign, prioritize, and resolve client support requests.', '<button class="crm-button primary" data-create="tickets" type="button">+ Create Ticket</button><button class="crm-button" data-export="tickets" type="button">Export</button>')}
        <div class="crm-grid crm-kpis">
          ${metric('Open Tickets', open.length, '◴', 'blue', open.length ? 'down 8% vs last week' : 'up 0% vs last week')}
          ${metric('High Priority', high.length, '!', 'red', 'up 17% vs last week')}
          ${metric('SLA Breaches', state.data.tickets.filter((item) => item.priority === 'urgent').length, '△', 'orange', 'up 50% vs last week')}
          ${metric('Resolved Today', state.data.tickets.filter((item) => ['resolved', 'closed'].includes(item.status)).length, '✓', 'green', 'up 23% vs yesterday')}
        </div>
        <div class="crm-two-col mt-5">
          <section class="crm-card">
            <div class="crm-card-head"><h2 class="crm-card-title">Tickets Queue</h2><div class="crm-toolbar"><select class="crm-select"><option>All Statuses</option></select><select class="crm-select"><option>All Priorities</option></select><button class="crm-button">Clear Filters</button></div></div>
            ${table(['', 'Ticket ID', 'Subject', 'Client', 'Linked Project', 'Priority', 'Assigned Agent', 'SLA Status', 'Current Status', 'Actions'], rows)}
          </section>
          <aside class="crm-card crm-detail">${ticketDetail(selected)}</aside>
        </div>
        <div class="crm-three-col mt-5">
          <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Ticket Categories</h2></div><div class="crm-donut"></div><div class="crm-list"><div class="crm-list-row"><span>Technical Issue</span><strong>${open.length}</strong></div><div class="crm-list-row"><span>Billing & Payments</span><strong>${state.data.tickets.filter((item) => /pay|bill|invoice/i.test(item.subject || '')).length}</strong></div></div></section>
          <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Resolution Performance</h2></div><div class="crm-chart"></div></section>
          <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">SLA Compliance</h2></div><div class="crm-donut"></div><div class="crm-list"><div class="crm-list-row"><span>On Time</span><strong>${state.data.tickets.length - high.length}</strong></div><div class="crm-list-row"><span>At Risk</span><strong>${high.length}</strong></div></div></section>
        </div>`;
    }

    function ticketDetail(ticket) {
      if (!ticket) return '<p class="text-sm font-bold text-slate-500">No ticket selected.</p>';
      return `<div class="crm-detail-hero"><div class="crm-detail-icon">◴</div><div><h2 class="text-xl font-black text-slate-950">#TIC-${ticket.id}</h2><p class="font-semibold text-slate-500">${escapeHtml(ticket.subject || 'Untitled ticket')}</p></div></div>
        <div class="crm-list">
          <div class="crm-list-row"><span>Client</span><strong>${escapeHtml(clientName(ticket.client_id))}</strong></div>
          <div class="crm-list-row"><span>Linked project</span><strong>${escapeHtml(projectName(ticket.project_id))}</strong></div>
          <div class="crm-list-row"><span>Assigned agent</span><strong>${escapeHtml(ticket.assigned_to || 'Unassigned')}</strong></div>
          <div class="crm-list-row"><span>Priority</span>${badge(ticket.priority, statusTone(ticket.priority))}</div>
          <div class="crm-list-row"><span>Status</span>${badge(ticket.status)}</div>
          <p class="text-sm font-semibold leading-6 text-slate-600">${escapeHtml(ticket.description || 'No issue summary added yet.')}</p>
          <div class="crm-toolbar"><button class="crm-button primary" data-create="ticket_messages" type="button">Reply</button><button class="crm-button" data-edit-resource="tickets" data-edit-id="${ticket.id}" type="button">Reassign</button><button class="crm-button green" data-quick-patch="tickets" data-quick-id="${ticket.id}" data-quick-field="status" data-quick-value="resolved" type="button">Resolve</button></div>
        </div>`;
    }

    function financeSheetRows() {
      const invoices = state.data.invoices.map((invoice) => ({
        ...invoice,
        id: invoice.id,
        transaction_date: invoice.invoice_date || invoice.created_at?.slice(0, 10),
        reference_id: invoice.invoice_number,
        client: invoice.customer_company || invoice.customer_name || clientName(invoice.client_id),
        project: projectName(invoice.project_id),
        transaction_type: 'invoice',
        amount: invoice.total_amount || invoice.amount,
        notes: invoice.notes,
      }));
      if (state.financeSheet === 'invoices') return invoices;
      return state.data.finances.filter((item) => {
        if (state.financeSheet === 'all') return true;
        if (state.financeSheet === 'income') return ['income', 'revenue'].includes(item.transaction_type);
        if (state.financeSheet === 'expenses') return item.transaction_type === 'expense';
        if (state.financeSheet === 'salary') return item.transaction_type === 'salary';
        if (state.financeSheet === 'pending') return ['pending', 'half_payment', 'sent'].includes(item.status);
        if (state.financeSheet === 'paid') return ['paid', 'received'].includes(item.status);
        return true;
      });
    }

    function financeRows() {
      const resource = state.financeSheet === 'invoices' ? 'invoices' : 'finances';
      return filtered(financeSheetRows(), ['transaction_type', 'reference_id', 'title', 'client', 'project', 'status', 'paid_by', 'received_by']).map((item) => `
        <tr data-resource="${resource}" data-row-id="${item.id}">
          <td><input type="checkbox" data-row-select aria-label="Select finance record ${item.id}" /></td>
          <td><input class="crm-edit-input" data-field="${state.financeSheet === 'invoices' ? 'invoice_date' : 'transaction_date'}" type="date" value="${escapeHtml(item.transaction_date || '')}" /></td>
          <td><input class="crm-edit-input" data-field="${state.financeSheet === 'invoices' ? 'invoice_number' : 'reference_id'}" value="${escapeHtml(item.reference_id || '')}" /></td>
          <td><input class="crm-edit-input" data-field="${state.financeSheet === 'invoices' ? 'customer_name' : 'client'}" value="${escapeHtml(item.client || '')}" /></td>
          <td><input class="crm-edit-input" data-field="${state.financeSheet === 'invoices' ? 'service_title' : 'project'}" value="${escapeHtml(item.project || '')}" /></td>
          <td>${state.financeSheet === 'invoices' ? badge('invoice', 'blue') : `<select class="crm-edit-select" data-field="transaction_type">${['income', 'expense', 'revenue', 'salary'].map((type) => `<option value="${type}" ${item.transaction_type === type ? 'selected' : ''}>${nice(type)}</option>`).join('')}</select>`}</td>
          <td><input class="crm-edit-input" data-field="${state.financeSheet === 'invoices' ? 'amount' : 'amount'}" type="number" value="${escapeHtml(item.amount || 0)}" /></td>
          <td><select class="crm-edit-select" data-field="status">${['pending', 'paid', 'received', 'sent', 'overdue', 'active', 'half_payment', 'cancelled'].map((status) => `<option value="${status}" ${item.status === status ? 'selected' : ''}>${nice(status)}</option>`).join('')}</select></td>
          <td><input class="crm-edit-input" data-field="notes" value="${escapeHtml(item.notes || '')}" /></td>
          <td>${rowActions(resource, item.id)}</td>
        </tr>`).join('');
    }

    function financeSheetTabs() {
      const sheets = [
        ['all', 'All Records'],
        ['income', 'Income'],
        ['expenses', 'Expenses'],
        ['salary', 'Salary'],
        ['pending', 'Pending'],
        ['paid', 'Paid / Received'],
        ['invoices', 'Invoices'],
      ];
      return `<div class="crm-sheet-tabs" role="tablist" aria-label="Finance sheets">${sheets.map(([key, label]) => `<button class="crm-sheet-tab ${state.financeSheet === key ? 'active' : ''}" data-finance-sheet="${key}" type="button" role="tab" aria-selected="${state.financeSheet === key}">${label}</button>`).join('')}</div>`;
    }

    function oldFinanceRowsUnused() {
      return filtered(state.data.finances, ['transaction_type', 'reference_id', 'title', 'client', 'project', 'status', 'paid_by', 'received_by']).map((item) => `
        <tr data-resource="finances" data-row-id="${item.id}">
          <td><input type="checkbox" data-row-select aria-label="Select finance record ${item.id}" /></td>
          <td><input class="crm-edit-input" data-field="transaction_date" type="date" value="${escapeHtml(item.transaction_date || '')}" /></td>
          <td><input class="crm-edit-input" data-field="reference_id" value="${escapeHtml(item.reference_id || '')}" /></td>
          <td><input class="crm-edit-input" data-field="client" value="${escapeHtml(item.client || '')}" /></td>
          <td><input class="crm-edit-input" data-field="project" value="${escapeHtml(item.project || '')}" /></td>
          <td><select class="crm-edit-select" data-field="transaction_type">${['income', 'expense', 'revenue', 'salary'].map((type) => `<option value="${type}" ${item.transaction_type === type ? 'selected' : ''}>${nice(type)}</option>`).join('')}</select></td>
          <td><input class="crm-edit-input" data-field="amount" type="number" value="${escapeHtml(item.amount || 0)}" /></td>
          <td><select class="crm-edit-select" data-field="status">${['pending', 'paid', 'received', 'active', 'half_payment', 'cancelled'].map((status) => `<option value="${status}" ${item.status === status ? 'selected' : ''}>${nice(status)}</option>`).join('')}</select></td>
          <td><input class="crm-edit-input" data-field="notes" value="${escapeHtml(item.notes || '')}" /></td>
          <td>${rowActions('finances', item.id)}</td>
        </tr>`).join('');
    }

    function renderFinance() {
      const income = state.data.finances.filter((item) => ['income', 'revenue'].includes(item.transaction_type)).reduce((sum, item) => sum + Number(item.amount || 0), 0);
      const expenses = state.data.finances.filter((item) => ['expense', 'salary'].includes(item.transaction_type)).reduce((sum, item) => sum + Number(item.amount || 0), 0);
      els.view.innerHTML = `
        ${pageHead('Financial Management', 'Manage invoices, expenses, payments, and cash flow in one place.', '<button class="crm-button primary" data-create="invoices" type="button">+ New Invoice</button><button class="crm-button green" data-create="finances" type="button">+ Add Expense</button><button class="crm-button" data-export="finance" type="button">Export</button>')}
        <div class="crm-grid crm-kpis">
          ${metric('Total Revenue', compactMoney(income), '₹', 'green')}
          ${metric('Total Expenses', compactMoney(expenses), '▵', 'red', 'down 7% vs last month')}
          ${metric('Outstanding Invoices', compactMoney(state.data.invoices.reduce((sum, item) => sum + Number(item.total_amount || item.amount || 0), 0)), '▱', 'orange')}
          ${metric('Profit This Month', compactMoney(income - expenses), '▢', income - expenses >= 0 ? 'green' : 'red')}
          ${metric('Cash Balance', compactMoney(income - expenses), '▤', 'blue')}
        </div>
        <section class="crm-card mt-5"><div class="crm-card-head"><h2 class="crm-card-title">Financial Records</h2><div class="crm-toolbar"><button class="crm-button" data-export="finance">Export Sheet</button><input class="crm-input" placeholder="Search records..." /></div></div>${financeSheetTabs()}${table(['', 'Date', 'Reference', 'Client', 'Project / Service', 'Sheet Type', 'Amount', 'Payment Status', 'Notes', 'Actions'], financeRows())}</section>
        <div class="crm-three-col mt-5">
          <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Recent Transactions</h2></div><div class="crm-list">${state.data.finances.slice(0, 5).map((item) => `<div class="crm-list-row"><span>${escapeHtml(item.title || item.reference_id || item.transaction_type)}</span><strong>${compactMoney(item.amount)}</strong></div>`).join('')}</div></section>
          <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Monthly Cash Flow</h2></div><div class="crm-chart"></div></section>
          <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Invoice Aging</h2></div><div class="crm-list"><div class="crm-list-row"><span>0-30 Days</span><strong>${compactMoney(48500)}</strong></div><div class="crm-list-row"><span>31-60 Days</span><strong>${compactMoney(41250)}</strong></div><div class="crm-list-row"><span>90+ Days</span><strong>${compactMoney(24000)}</strong></div></div></section>
        </div>`;
    }

    function renderAnalytics() {
      const clients = state.data.clients.length;
      const projects = state.data.projects.length;
      const revenue = state.data.finances.filter((item) => ['income', 'revenue'].includes(item.transaction_type)).reduce((sum, item) => sum + Number(item.amount || 0), 0);
      els.view.innerHTML = `${pageHead('Analytics & User Access', 'Track performance, analyze trends, and manage secure logins for clients and employees.', '<button class="crm-button">May 20 - May 26, 2025</button>')}
        <div class="crm-grid crm-kpis">${metric('Client Retention', '92%', '○', 'blue')}${metric('Employee Utilization', '78%', '♙', 'blue')}${metric('Ticket Resolution Rate', '96%', '◴', 'red')}${metric('Revenue by Client', compactMoney(revenue), '₹', 'green')}${metric('Login Activity 7D', Math.max(clients + projects, 1), '▥', 'purple')}</div>
        <div class="crm-three-col mt-5"><section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Monthly Revenue</h2></div><div class="crm-chart"></div></section><section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Support Performance</h2></div><div class="crm-chart"></div></section><section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Project Status Distribution</h2></div><div class="crm-list">${Object.entries(groupCount(state.data.projects, 'status')).map(([key, count]) => `<div class="crm-list-row"><span>${nice(key)}</span><strong>${count}</strong></div>`).join('')}</div></section></div>
        <section class="crm-card mt-5"><div class="crm-card-head"><h2 class="crm-card-title">User Management</h2><div class="crm-toolbar"><button class="crm-button primary" data-create="profiles">+ Create Login</button><button class="crm-button">Assign Role</button><button class="crm-button">Reset Password</button></div></div>${table(['', 'Name', 'Role', 'User Type', 'Company', 'Access Level', 'Status', 'Actions'], userRows())}</section>`;
