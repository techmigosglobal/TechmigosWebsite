    function projectName(id) {
      const project = state.data.projects.find((item) => String(item.id) === String(id));
      return project?.name || 'Unlinked';
    }

    function groupCount(rows, key) {
      return rows.reduce((acc, row) => {
        const label = row[key] || 'Unassigned';
        acc[label] = (acc[label] || 0) + 1;
        return acc;
      }, {});
    }

    function userRows() {
      const profiles = state.data.profiles.length ? state.data.profiles : [{ name: state.profile?.name || 'Admin', role: state.profile?.role || 'company_admin', status: 'active', email: state.profile?.email || '' }];
      return profiles.map((item) => `<tr data-resource="profiles" data-row-id="${item.id || ''}"><td><input type="checkbox" data-row-select aria-label="Select user ${escapeHtml(item.name || item.email)}" /></td><td><strong>${escapeHtml(item.name || item.email)}</strong><br><small>${escapeHtml(item.email || '')}</small></td><td>${badge(item.role, item.role === 'client' ? 'green' : 'blue')}</td><td>${item.role === 'client' ? 'Client' : 'Employee'}</td><td>${escapeHtml(clientName(item.client_id) || 'TechMigos')}</td><td>${item.role === 'company_admin' ? 'Full Access' : item.role === 'client' ? 'Client Portal' : 'Standard Access'}</td><td>${badge(item.status || 'active', 'green')}</td><td>${item.id ? rowActions('profiles', item.id) : '<span class="text-sm font-bold text-slate-400">Session user</span>'}</td></tr>`).join('');
    }

