        <div class="crm-two-col mt-5"><section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Operational Defaults</h2></div><form class="crm-form-grid"><label>Default Project Status<input value="In Progress" /></label><label>Default Priority<input value="Medium" /></label><label>Default SLA<input value="48 Hours - Standard" /></label><label>Invoice Prefix<input value="TM/INV" /></label><label>Currency<input value="INR" /></label><label>Payment Terms<input value="Net 30" /></label></form></section><section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Connected Integrations</h2></div><div class="crm-list"><div class="crm-list-row"><span>InsForge</span>${badge('connected', 'green')}</div><div class="crm-list-row"><span>MSG91</span>${badge('ready', 'blue')}</div><div class="crm-list-row"><span>Exports</span><strong>Excel, CSV, PDF</strong></div></div></section></div>
        <section class="crm-card mt-5"><div class="crm-card-head"><h2 class="crm-card-title">Notification Rules</h2></div>${table(['Notification Type', 'Email', 'In-App', 'Frequency', 'Recipients'], '<tr><td>New Support Ticket</td><td>Enabled</td><td>Enabled</td><td>Instant</td><td>Support Team</td></tr><tr><td>Ticket Assigned</td><td>Enabled</td><td>Enabled</td><td>Instant</td><td>Assignee Only</td></tr><tr><td>Invoice Created</td><td>Enabled</td><td>Optional</td><td>Daily Digest</td><td>Finance Team, Client</td></tr>')}</section>`;
