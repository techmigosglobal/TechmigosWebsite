    function render() {
      renderShell();
      if (state.active === 'dashboard') renderDashboard();
      if (state.active === 'leads') renderCrudResource('leads', 'Leads', 'Capture, qualify, assign, and convert incoming opportunities.', [['name', 'Name'], ['company', 'Company'], ['email', 'Email'], ['service', 'Service'], ['budget', 'Budget'], ['priority', 'Priority'], ['status', 'Status'], ['assigned_to', 'Assigned To']]);
      if (state.active === 'deals') renderCrudResource('deals', 'Deals', 'Track pipeline value, stages, owners, and expected close dates.', [['title', 'Title'], ['stage', 'Stage'], ['value', 'Value', 'number'], ['currency', 'Currency'], ['expected_close_date', 'Close Date', 'date']]);
      if (state.active === 'projects') renderProjects();
      if (state.active === 'tickets') renderTickets();
      if (state.active === 'finance') renderFinance();
      if (state.active === 'analytics') renderAnalytics();
      if (state.active === 'clients') renderClients();
      if (state.active === 'employees') renderEmployees();
      if (state.active === 'users') renderUsers();
      if (state.active === 'followups') renderCrudResource('followups', 'Follow-ups', 'Schedule next actions and keep client work moving.', [['title', 'Title'], ['related_type', 'Related Type'], ['related_id', 'Related ID', 'number'], ['due_at', 'Due Date'], ['status', 'Status'], ['assigned_to', 'Assigned To'], ['notes', 'Notes']]);
      if (state.active === 'campaigns') renderCrudResource('campaigns', 'Campaigns', 'Create, schedule, and track client communication campaigns.', [['name', 'Name'], ['subject', 'Subject'], ['status', 'Status'], ['scheduled_at', 'Scheduled At'], ['sent_at', 'Sent At']]);
      if (state.active === 'settings') renderSettings();
      bindActions();
