    function bindActions() {
      document.querySelectorAll('[data-project-detail]').forEach((button) => button.addEventListener('click', () => {
        state.selectedProjectId = button.dataset.projectDetail;
        renderProjects();
      }));
      document.querySelectorAll('[data-ticket-detail]').forEach((button) => button.addEventListener('click', () => {
        state.selectedTicketId = button.dataset.ticketDetail;
        renderTickets();
      }));
      document.querySelectorAll('[data-client-detail]').forEach((button) => button.addEventListener('click', () => {
        state.selectedClientId = button.dataset.clientDetail;
        renderClients();
      }));
      document.querySelectorAll('[data-employee-detail]').forEach((button) => button.addEventListener('click', () => {
        state.selectedEmployeeId = button.dataset.employeeDetail;
        renderEmployees();
      }));
      document.querySelectorAll('[data-row-id] [data-field]').forEach((input) => {
        input.addEventListener('input', () => scheduleSave(input));
        input.addEventListener('change', () => scheduleSave(input));
      });
      document.querySelectorAll('[data-create]').forEach((button) => button.addEventListener('click', () => openCreate(button.dataset.create)));
      document.querySelectorAll('[data-export]').forEach((button) => button.addEventListener('click', () => exportRows(button.dataset.export)));
      document.querySelectorAll('[data-save-settings]').forEach((button) => button.addEventListener('click', saveSettings));
      document.querySelectorAll('[data-finance-sheet]').forEach((button) => button.addEventListener('click', () => {
        state.financeSheet = button.dataset.financeSheet;
        renderFinance();
        bindActions();
      }));
      document.getElementById('crm-collapse')?.addEventListener('click', toggleSidebar);
      document.getElementById('crm-notifications')?.addEventListener('click', openNotifications);
      document.getElementById('crm-profile-button')?.addEventListener('click', openProfileManagement);
      document.querySelectorAll('[data-edit-resource]').forEach((button) => button.addEventListener('click', () => openEdit(button.dataset.editResource, button.dataset.editId)));
      document.querySelectorAll('[data-duplicate-resource]').forEach((button) => button.addEventListener('click', () => duplicateRecord(button.dataset.duplicateResource, button.dataset.duplicateId)));
      document.querySelectorAll('[data-delete-resource]').forEach((button) => button.addEventListener('click', () => deleteRecord(button.dataset.deleteResource, button.dataset.deleteId)));
      document.querySelectorAll('[data-quick-patch]').forEach((button) => button.addEventListener('click', () => quickPatch(button)));
      document.querySelectorAll('[data-row-select]').forEach((checkbox) => checkbox.addEventListener('change', updateSelectionBar));
      document.querySelector('[data-bulk-delete]')?.addEventListener('click', bulkDelete);
      document.querySelector('[data-bulk-export]')?.addEventListener('click', bulkExport);
      document.querySelector('[data-clear-selection]')?.addEventListener('click', clearSelection);
      document.querySelectorAll('[data-invoice-view]').forEach((button) => button.addEventListener('click', () => showInvoice(button.dataset.invoiceView)));
      document.querySelectorAll('[data-jump]').forEach((button) => button.addEventListener('click', () => {
        state.active = button.dataset.jump;
        render();
      }));
      updateSelectionBar();
    }

    function toggleSidebar() {
      const app = document.querySelector('.crm-app');
      app.classList.toggle('sidebar-collapsed');
      const collapsed = app.classList.contains('sidebar-collapsed');
      localStorage.setItem('tm_crm_sidebar_collapsed', collapsed ? '1' : '0');
      document.getElementById('crm-collapse').textContent = collapsed ? '⇥' : '⇤';
    }

    function openNotifications() {
      const items = [
        ...state.data.tickets.filter((ticket) => !['resolved', 'closed'].includes(ticket.status)).slice(0, 4).map((ticket) => ({ title: ticket.subject, meta: `Ticket #TIC-${ticket.id} is ${nice(ticket.status)}`, tone: statusTone(ticket.priority) })),
        ...state.data.invoices.filter((invoice) => ['pending', 'sent', 'overdue'].includes(invoice.status)).slice(0, 3).map((invoice) => ({ title: invoice.invoice_number || 'Invoice', meta: `${compactMoney(invoice.total_amount || invoice.amount)} ${nice(invoice.status)}`, tone: statusTone(invoice.status) })),
        ...state.data.followups.filter((item) => item.status !== 'completed').slice(0, 3).map((item) => ({ title: item.title, meta: `Follow-up due ${String(item.due_at || '').slice(0, 10) || 'soon'}`, tone: 'orange' })),
      ];
      els.modalTitle.textContent = 'Notifications';
      els.modalBody.innerHTML = `<div class="crm-list">${items.map((item) => `<div class="crm-list-row"><span>${escapeHtml(item.title || 'Notification')}</span>${badge(item.meta || 'new', item.tone)}</div>`).join('') || '<p class="p-4 text-sm font-bold text-slate-500">No pending notifications.</p>'}</div><div class="crm-toolbar p-5 pt-0"><button class="crm-button primary" data-jump="tickets" type="button">Open Tickets</button><button class="crm-button" data-jump="finance" type="button">Open Finance</button></div>`;
      els.modal.classList.add('open');
      bindActions();
    }

    function openProfileManagement() {
      const profile = state.profile || {};
      els.modalTitle.textContent = 'Profile Management';
      els.modalBody.innerHTML = `<form id="crm-profile-form" class="crm-form-grid">
        <label>Name<input name="name" value="${escapeHtml(profile.name || '')}" /></label>
        <label>Email<input name="email" type="email" value="${escapeHtml(profile.email || '')}" /></label>
        <label>Role<input name="role" value="${escapeHtml(profile.role || '')}" disabled /></label>
        <label>Status<input name="status" value="${escapeHtml(profile.status || 'active')}" /></label>
        <label class="wide">Notification Preference<select name="notification_preference"><option>Email and in-app</option><option>In-app only</option><option>Critical only</option></select></label>
        <button class="crm-button primary wide" type="submit">Update Profile</button>
      </form>`;
      els.modal.classList.add('open');
      document.getElementById('crm-profile-form')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!profile.id) return toast('Profile is not loaded yet');
        const body = normalizePayload('profiles', Object.fromEntries(new FormData(event.currentTarget).entries()));
        try {
          await portal(`/api/portal/profiles/${profile.id}`, { method: 'PATCH', body: JSON.stringify(body) });
          els.modal.classList.remove('open');
          toast('Profile updated in InsForge');
          await loadData();
        } catch (error) {
          toast(error instanceof Error ? error.message : 'Profile update failed');
        }
      });
    }

    function rowPayload(row, resource) {
      const body = {};
      row.querySelectorAll('[data-field]').forEach((input) => { body[input.dataset.field] = input.value; });
      for (const key of ['amount', 'budget', 'progress', 'expenses', 'revenue', 'profit']) {
        if (body[key] === '') delete body[key];
        else if (body[key] !== undefined) body[key] = Number(body[key]);
      }
      return body;
    }

    function scheduleSave(input) {
      const row = input.closest('[data-row-id]');
      if (!row) return;
      row.classList.add('crm-dirty');
      const key = `${row.dataset.resource}:${row.dataset.rowId}`;
      clearTimeout(state.saveTimers.get(key));
      state.saveTimers.set(key, setTimeout(() => saveRow(row), 850));
    }

    async function saveRow(row) {
      try {
        await portal(`/api/portal/${row.dataset.resource}/${row.dataset.rowId}`, { method: 'PATCH', body: JSON.stringify(rowPayload(row, row.dataset.resource)) });
        row.classList.remove('crm-dirty');
        toast('Saved to InsForge');
      } catch (error) {
        toast(error instanceof Error ? error.message : 'Save failed');
      }
    }

    async function saveSettings() {
      const values = Array.from(document.querySelectorAll('.crm-form-grid input')).reduce((acc, input) => {
        const label = input.closest('label')?.childNodes?.[0]?.textContent?.trim() || input.name || 'Setting';
        acc[label] = input.value;
        return acc;
      }, {});
      try {
        await portal('/api/portal/activities', {
          method: 'POST',
          body: JSON.stringify({
            action: 'updated_settings',
            entity_type: 'company_settings',
            summary: `Updated company settings: ${Object.keys(values).join(', ')}`,
          }),
        });
        toast('Settings update recorded in InsForge');
        await loadData();
      } catch (error) {
        toast(error instanceof Error ? error.message : 'Settings save failed');
      }
    }

    function dataKey(resource) {
      return resource === 'finance' ? 'finances' : resource;
    }

    function findRecord(resource, id) {
      return (state.data[dataKey(resource)] || []).find((item) => String(item.id) === String(id));
    }

    function createFields(resource) {
      const configs = {
        projects: [['client_id', 'Client ID', 'number'], ['name', 'Project name', 'text'], ['client_name', 'Client name', 'text'], ['project_manager', 'Project manager', 'text'], ['budget', 'Budget', 'number'], ['status', 'Status', 'text'], ['summary', 'Summary', 'textarea']],
        tickets: [['client_id', 'Client ID', 'number'], ['subject', 'Subject', 'text'], ['priority', 'Priority', 'text'], ['status', 'Status', 'text'], ['description', 'Description', 'textarea']],
        finances: [['transaction_date', 'Date', 'date'], ['transaction_type', 'Type', 'text'], ['reference_id', 'Reference', 'text'], ['title', 'Title', 'text'], ['client', 'Client', 'text'], ['project', 'Project', 'text'], ['amount', 'Amount', 'number'], ['status', 'Status', 'text'], ['notes', 'Notes', 'textarea']],
        invoices: [['client_id', 'Client ID', 'number'], ['project_id', 'Project ID', 'number'], ['invoice_number', 'Invoice number', 'text'], ['currency', 'Currency', 'text'], ['customer_name', 'Customer name', 'text'], ['customer_email', 'Customer email', 'email'], ['service_title', 'Service title', 'text'], ['amount', 'Amount', 'number'], ['due_date', 'Due date', 'date'], ['notes', 'Notes', 'textarea']],
        clients: [['name', 'Name', 'text'], ['company', 'Company', 'text'], ['email', 'Email', 'email'], ['phone', 'Phone', 'text'], ['status', 'Status', 'text']],
        profiles: [['auth_user_id', 'Auth user ID', 'text'], ['email', 'Email', 'email'], ['name', 'Name', 'text'], ['role', 'Role', 'text'], ['status', 'Status', 'text'], ['client_id', 'Client ID for client users', 'number'], ['temporary_password', 'Temporary password for new login', 'text']],
        leads: [['name', 'Name', 'text'], ['email', 'Email', 'email'], ['company', 'Company', 'text'], ['service', 'Service', 'text'], ['budget', 'Budget', 'text'], ['priority', 'Priority', 'text'], ['assigned_to', 'Assigned To', 'text'], ['message', 'Message', 'textarea']],
        deals: [['client_id', 'Client ID', 'number'], ['lead_id', 'Lead ID', 'number'], ['title', 'Title', 'text'], ['stage', 'Stage', 'text'], ['value', 'Value', 'number'], ['currency', 'Currency', 'text'], ['expected_close_date', 'Expected Close Date', 'date']],
        followups: [['related_type', 'Related Type', 'text'], ['related_id', 'Related ID', 'number'], ['title', 'Title', 'text'], ['due_at', 'Due At', 'date'], ['status', 'Status', 'text'], ['assigned_to', 'Assigned To', 'text'], ['notes', 'Notes', 'textarea']],
        campaigns: [['name', 'Name', 'text'], ['subject', 'Subject', 'text'], ['body', 'Body', 'textarea'], ['status', 'Status', 'text'], ['msg91_template_id', 'MSG91 Template ID', 'text'], ['scheduled_at', 'Scheduled At', 'date']],
        ticket_messages: [['ticket_id', 'Ticket ID', 'number'], ['body', 'Reply', 'textarea'], ['visibility', 'Visibility', 'text']],
      };
      return configs[resource] || configs.clients;
    }

    function formMarkup(resource, values = {}, submitLabel = 'Save to InsForge') {
      return `<form id="crm-edit-form" class="crm-form-grid">${createFields(resource).map(([name, label, type]) => {
        const value = escapeHtml(values[name] ?? '');
        return `<label class="${type === 'textarea' ? 'wide' : ''}">${label}${type === 'textarea' ? `<textarea name="${name}">${value}</textarea>` : `<input name="${name}" type="${type}" value="${value}" />`}</label>`;
      }).join('')}<button class="crm-button primary wide" type="submit">${submitLabel}</button></form>`;
    }

    function openCreate(resource) {
      els.modalTitle.textContent = `Create ${resource}`;
      els.modalBody.innerHTML = formMarkup(resource, smartDefaults(resource), 'Create in InsForge');
      els.modal.classList.add('open');
      document.getElementById('crm-edit-form')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const body = normalizePayload(resource, Object.fromEntries(new FormData(event.currentTarget).entries()));
        if (resource === 'invoices') {
          body.items = [{ description: body.service_title || 'TechMigos service', quantity: 1, rate: Number(body.amount || 0) }];
        }
        try {
          await portal(`/api/portal/${resource}`, { method: 'POST', body: JSON.stringify(body) });
          els.modal.classList.remove('open');
          toast('Created in InsForge');
          await loadData();
        } catch (error) {
          toast(error instanceof Error ? error.message : 'Create failed');
        }
      });
    }

    function smartDefaults(resource) {
      const today = new Date().toISOString().slice(0, 10);
      const defaults = {
        projects: { status: 'planning', budget: 0 },
        tickets: { priority: 'medium', status: 'open' },
        finances: { transaction_date: today, transaction_type: 'expense', status: 'pending', amount: 0, source: 'manual' },
        invoices: { currency: 'INR', due_date: today, amount: 0 },
        clients: { status: 'active' },
        profiles: { role: 'company_member', status: 'active' },
        ticket_messages: { ticket_id: state.selectedTicketId || '', visibility: 'internal' },
      };
      return defaults[resource] || {};
    }

    function normalizePayload(resource, body) {
      Object.keys(body).forEach((key) => {
        if (typeof body[key] === 'string') body[key] = body[key].trim();
        if (body[key] === '') delete body[key];
      });
      for (const key of ['client_id', 'project_id', 'ticket_id', 'amount', 'budget', 'progress', 'expenses', 'revenue', 'profit']) {
        if (body[key] !== undefined) body[key] = Number(body[key]);
      }
      return body;
    }

    function openEdit(resource, id) {
      const item = findRecord(resource, id);
      if (!item) return toast('Record not found');
      els.modalTitle.textContent = `Edit ${resource}`;
      els.modalBody.innerHTML = formMarkup(resource, item, 'Update in InsForge');
      els.modal.classList.add('open');
      document.getElementById('crm-edit-form')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        try {
          await portal(`/api/portal/${resource}/${id}`, { method: 'PATCH', body: JSON.stringify(normalizePayload(resource, Object.fromEntries(new FormData(event.currentTarget).entries()))) });
          els.modal.classList.remove('open');
          toast('Updated in InsForge');
          await loadData();
        } catch (error) {
          toast(error instanceof Error ? error.message : 'Update failed');
        }
      });
    }

    async function duplicateRecord(resource, id) {
      const item = findRecord(resource, id);
      if (!item) return toast('Record not found');
      const body = { ...item };
      ['id', 'created_at', 'updated_at', 'sent_at', 'viewed_at', 'paid_at'].forEach((key) => delete body[key]);
      if (body.name) body.name = `${body.name} Copy`;
      if (body.subject) body.subject = `${body.subject} Copy`;
      if (body.reference_id) body.reference_id = `${body.reference_id}-COPY`;
      if (body.invoice_number) delete body.invoice_number;
      try {
        await portal(`/api/portal/${resource}`, { method: 'POST', body: JSON.stringify(normalizePayload(resource, body)) });
        toast('Duplicated in InsForge');
        await loadData();
      } catch (error) {
        toast(error instanceof Error ? error.message : 'Duplicate failed');
      }
    }

    async function deleteRecord(resource, id) {
      if (!id || !confirm(`Delete this ${resource.slice(0, -1) || resource}? This cannot be undone.`)) return;
      try {
        await portal(`/api/portal/${resource}/${id}`, { method: 'DELETE' });
        toast('Deleted from InsForge');
        await loadData();
      } catch (error) {
        toast(error instanceof Error ? error.message : 'Delete failed');
      }
    }

    async function quickPatch(button) {
      try {
        await portal(`/api/portal/${button.dataset.quickPatch}/${button.dataset.quickId}`, {
          method: 'PATCH',
          body: JSON.stringify({ [button.dataset.quickField]: button.dataset.quickValue }),
        });
        toast('Updated in InsForge');
        await loadData();
      } catch (error) {
        toast(error instanceof Error ? error.message : 'Update failed');
      }
    }

    function selectedRows() {
      return Array.from(document.querySelectorAll('[data-row-select]:checked')).map((input) => input.closest('[data-row-id]')).filter(Boolean);
    }

    function updateSelectionBar() {
      const rows = selectedRows();
      els.selectedCount.textContent = `${rows.length} selected`;
      els.actionbar.classList.toggle('show', rows.length > 0);
    }

    function clearSelection() {
      document.querySelectorAll('[data-row-select]').forEach((input) => { input.checked = false; });
      updateSelectionBar();
    }

    async function bulkDelete() {
      const rows = selectedRows();
      if (!rows.length || !confirm(`Delete ${rows.length} selected records?`)) return;
      try {
        await Promise.all(rows.map((row) => portal(`/api/portal/${row.dataset.resource}/${row.dataset.rowId}`, { method: 'DELETE' })));
        toast(`Deleted ${rows.length} records`);
        await loadData();
      } catch (error) {
        toast(error instanceof Error ? error.message : 'Bulk delete failed');
      }
    }

    function bulkExport() {
      const rows = selectedRows().map((row) => findRecord(row.dataset.resource, row.dataset.rowId)).filter(Boolean);
      if (!rows.length) return;
      const keys = Array.from(new Set(rows.flatMap((row) => Object.keys(row)))).filter((key) => !String(key).endsWith('_at'));
      const csv = [keys.join(','), ...rows.map((row) => keys.map((key) => `"${String(row[key] ?? '').replace(/"/g, '""')}"`).join(','))].join('\n');
      downloadCsv(csv, 'techmigos-selected-records.csv');
    }

    function exportRows(kind) {
      const configs = {
        projects: { rows: state.data.projects, keys: ['external_project_id', 'name', 'client_name', 'project_manager', 'status', 'budget', 'progress'] },
        finance: { rows: state.data.finances, keys: ['transaction_date', 'transaction_type', 'reference_id', 'title', 'client', 'project', 'status', 'amount'] },
        finances: { rows: state.data.finances, keys: ['transaction_date', 'transaction_type', 'reference_id', 'title', 'client', 'project', 'status', 'amount'] },
        tickets: { rows: state.data.tickets, keys: ['id', 'subject', 'client_id', 'project_id', 'priority', 'assigned_to', 'status'] },
        clients: { rows: state.data.clients, keys: ['name', 'company', 'email', 'phone', 'status'] },
        leads: { rows: state.data.leads, keys: ['name', 'email', 'company', 'service', 'budget', 'priority', 'assigned_to', 'status'] },
        deals: { rows: state.data.deals, keys: ['client_id', 'lead_id', 'title', 'stage', 'value', 'currency', 'expected_close_date'] },
        followups: { rows: state.data.followups, keys: ['related_type', 'related_id', 'title', 'due_at', 'status', 'assigned_to', 'notes'] },
        campaigns: { rows: state.data.campaigns, keys: ['name', 'subject', 'status', 'msg91_template_id', 'scheduled_at', 'sent_at'] },
        employees: { rows: employeeSeed(), keys: ['name', 'email', 'role', 'status'] },
        users: { rows: state.data.profiles.length ? state.data.profiles : employeeSeed(), keys: ['name', 'email', 'role', 'status', 'client_id'] },
      };
      const config = configs[kind] || configs.finance;
      const rows = config.rows;
      const keys = config.keys;
      const csv = [keys.join(','), ...rows.map((row) => keys.map((key) => `"${String(row[key] ?? '').replace(/"/g, '""')}"`).join(','))].join('\n');
      downloadCsv(csv, `techmigos-${kind}.csv`);
    }

    function downloadCsv(csv, filename) {
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = filename;
      link.click();
      URL.revokeObjectURL(url);
    }

    async function showInvoice(id) {
      const result = await portal(`/api/portal/invoices/${id}`);
      const detail = result.detail;
      els.invoicePreviewTitle.textContent = `Invoice ${detail.invoice.invoice_number}`;
      els.invoicePreview.innerHTML = `<pre class="whitespace-pre-wrap text-sm">${escapeHtml(JSON.stringify(detail, null, 2))}</pre>`;
      els.invoiceModal.classList.add('open');
    }

    async function loadData() {
      setStatus('Loading CRM data...');
      const names = Object.keys(state.data).filter((name) => name !== 'profiles' || state.profile?.role === 'company_admin');
      const results = await Promise.all(names.map(async (name) => [name, (await portal(`/api/portal/${name}`)).items || []]));
      results.forEach(([name, items]) => { state.data[name] = items; });
      setStatus('CRM data synced with InsForge.', 'success');
      render();
    }

    async function boot() {
      if (!token()) return logout();
      try {
        if (localStorage.getItem('tm_crm_sidebar_collapsed') === '1') {
          document.querySelector('.crm-app')?.classList.add('sidebar-collapsed');
          document.getElementById('crm-collapse').textContent = '⇥';
        }
        const me = await portal('/api/portal/me');
        state.profile = me.profile;
        if (me.destination !== '/company') location.href = me.destination;
        document.getElementById('crm-user-name').textContent = me.profile.name || 'TechMigos';
        document.getElementById('crm-user-role').textContent = String(me.profile.role || 'company').replace(/_/g, ' ');
        await loadData();
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'Could not load CRM.', 'error');
        setTimeout(logout, 1200);
      }
    }

    els.search.addEventListener('input', () => {
      state.search = els.search.value;
      render();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && document.activeElement !== els.search) {
        event.preventDefault();
        els.search.focus();
      }
    });
    document.getElementById('crm-modal-close')?.addEventListener('click', () => els.modal.classList.remove('open'));
    document.getElementById('close-invoice')?.addEventListener('click', () => els.invoiceModal.classList.remove('open'));
    document.getElementById('print-invoice')?.addEventListener('click', () => window.print());

    boot();
  </script>
</BaseLayout>
