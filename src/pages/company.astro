          <td>${badge(client.status || 'active')}</td>
          <td><input class="crm-edit-input" data-field="email" value="${escapeHtml(client.email || '')}" /></td>
          <td>${rowActions('clients', client.id, { view: true, viewAttr: `data-client-detail="${client.id}"` })}</td>
