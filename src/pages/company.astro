        </label>
        <label class="wide">Payment Details
          <input name="payment_instructions" placeholder="e.g. UPI: techmigos@upi" value="${escapeHtml(inv?.payment_instructions || '')}" />
        </label>
        <label class="wide">Terms and Conditions
          <textarea name="terms" rows="3" placeholder="e.g. 1. Goods once sold will not be taken back&#10;2. All disputes subject to Hyderabad jurisdiction">${escapeHtml(inv?.terms || '')}</textarea>
        </label>

        <div class="wide" style="border:1px solid #e2e8f0;border-radius:6px;padding:10px 12px;">
          <strong style="font-size:12px;">Authorised Signatory Image</strong>
          <span style="display:block;font-size:10px;color:#667599;margin-bottom:6px;">Upload a signature image (PNG/JPG, max 2 MB) — it will appear on the printed invoice.</span>
          ${inv?.sign_url ? `<img src="${escapeHtml(inv.sign_url)}" style="max-height:48px;margin-bottom:6px;border:1px solid #e2e8f0;border-radius:4px;" alt="Current signature" />` : ''}
          <input type="file" id="inv-sign-file" accept="image/png,image/jpeg,image/jpg" style="display:block;" />
          ${inv?.sign_url ? `<input type="hidden" name="sign_url" id="inv-sign-url" value="${escapeHtml(inv.sign_url)}" />` : `<input type="hidden" name="sign_url" id="inv-sign-url" value="" />`}
          <span id="inv-sign-status" style="font-size:10px;color:#667599;"></span>
        </div>

        <button class="crm-button primary wide" type="submit">${submitLabel}</button>
      </form>`;
    }

    function bindInvoiceFormEvents(invoiceId) {
      // Auto-fill from client
      document.getElementById('inv-client')?.addEventListener('change', function () {
        const client = state.data.clients.find((c) => String(c.id) === this.value);
        if (!client) return;
        document.getElementById('inv-cname').value = client.name || '';
        document.getElementById('inv-cemail').value = client.email || '';
        document.getElementById('inv-cphone').value = client.phone || '';
      });

      // qty × rate = amount
      els.modalBody.addEventListener('input', (e) => {
        const item = e.target.closest('.inv-line-item');
        if (!item) return;
        const qty = parseFloat(item.querySelector('[name^="item_qty"]')?.value || 1);
        const rate = parseFloat(item.querySelector('[name^="item_rate"]')?.value || 0);
        const amountInput = item.querySelector('[name^="item_amount"]');
        if (amountInput) amountInput.value = (qty * rate).toFixed(2);
      });

      // Add item row
      document.getElementById('inv-add-item')?.addEventListener('click', () => {
        const list = document.getElementById('inv-items-list');
        const count = list.querySelectorAll('.inv-line-item').length;
        const div = document.createElement('div');
        div.innerHTML = invoiceLineItemsHtml([{ description: '', quantity: 1, rate: 0, amount: 0 }])
          .replace(/item_desc_0/g, `item_desc_${count}`)
          .replace(/item_qty_0/g, `item_qty_${count}`)
          .replace(/item_rate_0/g, `item_rate_${count}`)
          .replace(/item_amount_0/g, `item_amount_${count}`);
        list.appendChild(div.firstElementChild);
      });

      // Remove item row
      els.modalBody.addEventListener('click', (e) => {
        if (e.target.classList.contains('inv-remove-item')) {
          if (els.modalBody.querySelectorAll('.inv-line-item').length > 1) e.target.closest('.inv-line-item').remove();
        }
      });

      // Signature upload — upload immediately on file pick if editing an existing invoice
      document.getElementById('inv-sign-file')?.addEventListener('change', async function () {
        const file = this.files?.[0];
        if (!file) return;
        const statusEl = document.getElementById('inv-sign-status');
        const urlInput = document.getElementById('inv-sign-url');
        if (!invoiceId) {
          // For new invoices, store as object URL temporarily; real upload happens on create (not supported without id)
          statusEl.textContent = 'Signature will be uploaded after invoice is created. Re-open to add it.';
          return;
        }
        statusEl.textContent = 'Uploading...';
        try {
          const fd = new FormData();
          fd.append('file', file);
          const res = await portal(`/api/portal/invoices/${invoiceId}/upload-sign`, { method: 'POST', body: fd, headers: {} });
          urlInput.value = res.sign_url || '';
          statusEl.textContent = '✓ Signature uploaded';
          statusEl.style.color = '#16a34a';
        } catch (err) {
          statusEl.textContent = err instanceof Error ? err.message : 'Upload failed';
          statusEl.style.color = '#dc2626';
        }
      });
    }

    function collectInvoiceBody(data) {
      const itemEls = els.modalBody.querySelectorAll('.inv-line-item');
      const items = Array.from(itemEls).map((el, i) => ({
        description: (el.querySelector(`[name="item_desc_${i}"]`)?.value || '').trim(),
        quantity: parseFloat(el.querySelector(`[name="item_qty_${i}"]`)?.value || 1),
        rate: parseFloat(el.querySelector(`[name="item_rate_${i}"]`)?.value || 0),
      })).filter((x) => x.description);
      return {
        client_id: Number(data.client_id),
        project_id: data.project_id ? Number(data.project_id) : undefined,
        invoice_number: data.invoice_number?.trim() || undefined,
        invoice_date: data.invoice_date,
        due_date: data.due_date || undefined,
        currency: data.currency || 'INR',
        customer_name: data.customer_name?.trim() || undefined,
        customer_email: data.customer_email?.trim() || undefined,
        customer_phone: data.customer_phone?.trim() || undefined,
        billing_address: data.billing_address?.trim() || undefined,
        discount_amount: parseFloat(data.discount_amount || 0),
        tax_amount: parseFloat(data.tax_amount || 0),
        received_amount: parseFloat(data.received_amount || 0),
        status: data.status || 'draft',
        notes: data.notes?.trim() || undefined,
        payment_instructions: data.payment_instructions?.trim() || undefined,
        terms: data.terms?.trim() || undefined,
        sign_url: data.sign_url?.trim() || undefined,
        items,
      };
    }

    function openInvoiceCreate() {
      els.modalTitle.textContent = 'New Invoice';
      els.modalBody.innerHTML = buildInvoiceFormHtml(null, [], 'Create Invoice');
      els.modal.classList.add('open');
      bindInvoiceFormEvents(null);

      document.getElementById('crm-invoice-form')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const body = collectInvoiceBody(Object.fromEntries(new FormData(event.currentTarget).entries()));
        if (!body.items.length) return toast('Add at least one line item');
        Object.keys(body).forEach((k) => body[k] === undefined && delete body[k]);
        try {
          const result = await portal('/api/portal/invoices', { method: 'POST', body: JSON.stringify(body) });
          els.modal.classList.remove('open');
          toast('Invoice created');
          await loadData();
          if (result?.item?.id) showInvoice(result.item.id);
        } catch (error) {
          toast(error instanceof Error ? error.message : 'Invoice creation failed');
        }
      });
    }

    async function openInvoiceEdit(id) {
      els.modalTitle.textContent = 'Edit Invoice';
      els.modalBody.innerHTML = `<p class="p-4 text-sm text-slate-500">Loading invoice...</p>`;
      els.modal.classList.add('open');
      try {
        const result = await portal(`/api/portal/invoices/${id}`);
        const { invoice, items } = result.detail;
        els.modalBody.innerHTML = buildInvoiceFormHtml(invoice, items, 'Save Changes');
        bindInvoiceFormEvents(id);

        document.getElementById('crm-invoice-form')?.addEventListener('submit', async (event) => {
          event.preventDefault();
          const body = collectInvoiceBody(Object.fromEntries(new FormData(event.currentTarget).entries()));
          if (!body.items.length) return toast('Add at least one line item');
          Object.keys(body).forEach((k) => body[k] === undefined && delete body[k]);
          try {
            await portal(`/api/portal/invoices/${id}`, { method: 'PATCH', body: JSON.stringify(body) });
            els.modal.classList.remove('open');
            toast('Invoice updated');
            await loadData();
            showInvoice(id);
          } catch (error) {
            toast(error instanceof Error ? error.message : 'Invoice update failed');
          }
        });
      } catch (error) {
        els.modalBody.innerHTML = `<p class="p-4 text-sm text-red-600">${escapeHtml(error instanceof Error ? error.message : 'Could not load invoice')}</p>`;
      }
    }

    function openTicketCreate() {
      const clientOpts = state.data.clients.map((c) => `<option value="${c.id}">${escapeHtml(c.company || c.name)}</option>`).join('');
      const empOpts = employeeSeed().map((e) => `<option value="${escapeHtml(e.name)}">${escapeHtml(e.name)}</option>`).join('');
