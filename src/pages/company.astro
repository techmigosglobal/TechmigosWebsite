      els.view.innerHTML = `
        ${pageHead('Client Management', 'Manage client companies, relationships, project portfolio, billing health, and portal access.', '<button class="crm-button primary" data-create="clients" type="button">+ Add Client</button><button class="crm-button" data-export="clients" type="button">Export</button>')}
        <div class="crm-grid crm-kpis">
          ${metric('Total Clients', state.data.clients.length, '○', 'blue')}
          ${metric('Active Contracts', state.data.projects.filter((item) => item.status !== 'completed').length, '▱', 'green')}
          ${metric('Avg. MRR per Client', compactMoney(state.data.clients.length ? state.data.finances.reduce((sum, item) => sum + Number(item.amount || 0), 0) / state.data.clients.length : 0), '₹', 'purple')}
          ${metric('At-Risk Accounts', state.data.projects.filter((item) => item.health === 'at_risk').length, '!', 'orange', 'up 2 vs last month')}
