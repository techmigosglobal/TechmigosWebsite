    function projectDetail(project) {
      if (!project) return '<p class="text-sm font-bold text-slate-500">No project selected.</p>';
      const spent = Number(project.expenses || 0);
      const budget = Number(project.budget || 0);
      const used = budget ? Math.min(100, Math.round((spent / budget) * 100)) : 0;
      return `<div class="crm-detail-hero"><div class="crm-detail-icon">▣</div><div><h2 class="text-xl font-black text-slate-950">${escapeHtml(project.name)}</h2><p class="font-semibold text-slate-500">${escapeHtml(project.client_name || clientName(project.client_id))}</p></div></div>
        <div class="crm-list">
          <div class="crm-list-row"><span>Project Manager</span><strong>${escapeHtml(project.project_manager || '-')}</strong></div>
          <div class="crm-list-row"><span>Deadline</span><strong>${escapeHtml(project.due_date || '-')}</strong></div>
          <div class="crm-list-row"><span>Status</span>${badge(project.status)}</div>
          <div class="crm-list-row"><span>Budget used</span><strong>${compactMoney(spent)} of ${compactMoney(budget)}</strong></div>
          <div>${progress(used)}</div>
          <p class="text-sm font-semibold leading-6 text-slate-600">${escapeHtml(project.summary || project.notes || 'No project overview added yet.')}</p>
        </div>`;
    }

    function renderTickets() {
      const selected = state.data.tickets.find((item) => String(item.id) === String(state.selectedTicketId)) || state.data.tickets[0];
