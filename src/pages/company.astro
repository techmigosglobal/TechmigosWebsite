              <label>Company Email<input name="company_email" type="email" value="info@techmigos.com" /></label>
              <label>Phone Number<input name="company_phone" value="+91 9959703547" /></label>
              <label>Timezone<input name="timezone" value="Asia/Kolkata" /></label>
              <label>Currency<input name="currency" value="INR" /></label>
