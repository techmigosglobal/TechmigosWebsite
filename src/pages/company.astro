        <div class="crm-two-col mt-5">
          <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Clients</h2><div class="crm-toolbar"><select class="crm-select"><option>All Industries</option></select><input class="crm-input" placeholder="Search clients..." /></div></div>${table(['', 'Client Name', 'Primary Contact', 'Active Projects', 'Total Revenue', 'Outstanding Invoices', 'Portal Access', 'Email', 'Actions'], rows)}</section>
          <aside class="crm-card crm-detail">${clientDetail(selected)}</aside>
        </div>
        <div class="crm-three-col mt-5"><section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Client Retention</h2></div><div class="crm-donut"></div><div class="crm-list"><div class="crm-list-row"><span>Retained</span><strong>92%</strong></div><div class="crm-list-row"><span>At Risk</span><strong>${state.data.projects.filter((item) => item.health === 'at_risk').length}</strong></div></div></section><section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Recent Client Activity</h2></div><div class="crm-list">${state.data.activities.slice(0, 5).map((item) => `<div class="crm-list-row"><span>${escapeHtml(item.summary || item.action)}</span><small>${escapeHtml(String(item.created_at || '').slice(0, 10))}</small></div>`).join('') || '<p class="p-4 text-sm font-bold text-slate-500">No activity yet.</p>'}</div></section><section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Client Satisfaction</h2></div><div class="crm-list"><div class="crm-list-row"><span>CSAT</span><strong>4.6 / 5</strong></div><div class="crm-list-row"><span>Response quality</span><strong>Excellent</strong></div></div></section></div>`;
    }

    function clientDetail(client) {
      if (!client) return '<p class="text-sm font-bold text-slate-500">No client selected.</p>';
