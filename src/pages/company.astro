            <strong>${esc(item.description)}</strong>
            ${item.notes ? `<br><span style="color:#666;font-size:9px;">${esc(item.notes)}</span>` : ''}
            ${inv.service_title && i === 0 && item.description !== inv.service_title ? `<br><span style="color:#888;font-size:9px;">${esc(inv.service_title)}</span>` : ''}
          </td>
          <td style="border:1px solid #ccc;padding:6px 8px;text-align:center;vertical-align:top;">${fmtNum(item.quantity)} SERVICE</td>
          <td style="border:1px solid #ccc;padding:6px 8px;text-align:right;vertical-align:top;">${fmtNum(item.rate)}</td>
          <td style="border:1px solid #ccc;padding:6px 8px;text-align:right;vertical-align:top;">${fmtNum(item.amount)}</td>
        </tr>`).join('');

      return `<article class="invoice-print-sheet" style="width:100%;max-width:780px;margin:0 auto;font-family:Arial,sans-serif;font-size:11px;color:#111;background:#fff;">

        <!-- BILL OF SUPPLY header bar -->
