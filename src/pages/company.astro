---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="TechMigos Company CRM"
  description="TechMigos company CRM for projects, tickets, finance, analytics, clients, employees, and secure access management."
  noIndex={true}
  hideNavbar={true}
>
  <style is:global>
    :root {
      --crm-blue: #1f7aff;
      --crm-blue-dark: #0f5fe8;
      --crm-navy: #081638;
      --crm-text: #102047;
      --crm-muted: #667599;
      --crm-line: #dfe7f3;
      --crm-bg: #f7faff;
      --crm-green: #08a979;
      --crm-red: #ff4d47;
      --crm-orange: #ff9f1a;
      --crm-purple: #8b5cf6;
    }

    body:has(.crm-app) {
      background: var(--crm-bg);
    }

    .crm-app {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 272px minmax(0, 1fr);
      background: var(--crm-bg);
      color: var(--crm-text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .crm-app.sidebar-collapsed {
      grid-template-columns: 92px minmax(0, 1fr);
    }

    .crm-sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      border-right: 1px solid var(--crm-line);
      background: #fff;
      display: flex;
      flex-direction: column;
      padding: 20px 14px;
    }

    .crm-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 8px 20px;
      color: var(--crm-navy);
      font-weight: 900;
      font-size: 25px;
      letter-spacing: -0.04em;
    }

    .crm-logo {
      width: 38px;
      height: 38px;
      border-radius: 11px;
      background:
        linear-gradient(135deg, #1f7aff, #00c2a8 58%, #8b5cf6);
      box-shadow: inset 0 0 0 7px rgba(255, 255, 255, 0.32), 0 12px 28px rgba(31, 122, 255, 0.22);
    }

    .crm-nav {
      display: grid;
      gap: 8px;
      overflow-y: auto;
      padding: 4px 0;
    }

    .crm-nav button,
    .crm-button,
    .crm-icon-button {
      min-height: 44px;
      touch-action: manipulation;
    }

    .crm-nav button {
      display: flex;
      align-items: center;
      gap: 13px;
      width: 100%;
      border: 0;
      border-radius: 8px;
      background: transparent;
      padding: 12px 14px;
      text-align: left;
      color: #26395e;
      font-size: 15px;
      font-weight: 800;
      cursor: pointer;
    }

    .crm-nav button[aria-current="page"] {
      background: linear-gradient(135deg, var(--crm-blue), var(--crm-blue-dark));
      color: #fff;
      box-shadow: 0 14px 30px rgba(31, 122, 255, 0.28);
    }

    .crm-nav button:hover:not([aria-current="page"]) {
      background: #f2f6fd;
      color: var(--crm-blue-dark);
    }

    .crm-nav-icon {
      width: 23px;
      text-align: center;
      font-size: 18px;
      line-height: 1;
    }

    .crm-collapse {
      margin-top: auto;
      width: 100%;
      justify-content: center;
    }

    .sidebar-collapsed .crm-brand span,
    .sidebar-collapsed .crm-nav-label {
      display: none;
    }

    .sidebar-collapsed .crm-brand,
    .sidebar-collapsed .crm-nav button {
      justify-content: center;
    }

    .sidebar-collapsed .crm-nav button {
      padding-inline: 10px;
    }

    .crm-main {
      min-width: 0;
      display: grid;
      grid-template-rows: auto 1fr;
    }

    .crm-topbar {
      position: sticky;
      top: 0;
      z-index: 30;
      display: grid;
      grid-template-columns: minmax(260px, 560px) 1fr auto;
      align-items: center;
      gap: 18px;
      min-height: 78px;
      border-bottom: 1px solid var(--crm-line);
      background: rgba(255, 255, 255, 0.94);
      padding: 14px 28px;
      backdrop-filter: blur(14px);
    }

    .crm-search {
      position: relative;
    }

    .crm-search input {
      width: 100%;
      height: 48px;
      border: 1px solid var(--crm-line);
      border-radius: 9px;
      background: #fff;
      padding: 0 58px 0 44px;
      color: var(--crm-text);
      font-weight: 700;
      box-shadow: 0 8px 28px rgba(14, 29, 64, 0.05);
    }

    .crm-search span:first-child {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: #7484a3;
    }

    .crm-search-kbd {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      border-radius: 7px;
      background: #f0f4fb;
      padding: 4px 8px;
      color: #62718f;
      font-size: 12px;
      font-weight: 900;
    }

    .crm-top-actions {
      justify-self: end;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .crm-company-pill {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      min-height: 44px;
      border-right: 1px solid var(--crm-line);
      padding-right: 22px;
      color: var(--crm-navy);
      font-weight: 900;
      white-space: nowrap;
    }

    .crm-icon-button {
      position: relative;
      width: 44px;
      border: 1px solid var(--crm-line);
      border-radius: 10px;
      background: #fff;
      color: #26395e;
      font-size: 18px;
      font-weight: 900;
      cursor: pointer;
    }

    .crm-badge-dot {
      position: absolute;
      right: 7px;
      top: 7px;
      width: 17px;
      height: 17px;
      border-radius: 999px;
      background: #ff3b3b;
      color: #fff;
      font-size: 10px;
      line-height: 17px;
      text-align: center;
    }

    .crm-user {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 180px;
      border: 0;
      background: transparent;
      color: inherit;
      cursor: pointer;
      text-align: left;
    }

    .crm-avatar {
      position: relative;
      width: 44px;
      height: 44px;
      border-radius: 999px;
      overflow: hidden;
      background: linear-gradient(135deg, #e2e8f0, #bfdbfe);
      display: grid;
      place-items: center;
      color: var(--crm-blue);
      font-weight: 900;
    }

    .crm-avatar::after {
      content: "";
      position: absolute;
      right: 1px;
      bottom: 1px;
      width: 11px;
      height: 11px;
      border: 2px solid #fff;
      border-radius: 999px;
      background: #15b56d;
    }

    .crm-content {
      min-width: 0;
      padding: 28px;
    }

    .crm-page-head {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: flex-start;
      margin-bottom: 22px;
    }

    .crm-page-title {
      margin: 0;
      color: var(--crm-navy);
      font-size: clamp(26px, 2.4vw, 36px);
      line-height: 1.05;
      font-weight: 950;
      letter-spacing: -0.05em;
    }

    .crm-page-subtitle {
      margin-top: 8px;
      color: var(--crm-muted);
      font-size: 15px;
      font-weight: 650;
    }

    .crm-toolbar {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 10px;
    }

    .crm-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      border: 1px solid var(--crm-line);
      border-radius: 9px;
      background: #fff;
      padding: 0 16px;
      color: var(--crm-text);
      font-size: 14px;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(16, 32, 71, 0.05);
    }

    .crm-button.primary {
      border-color: transparent;
      background: linear-gradient(135deg, var(--crm-blue), var(--crm-blue-dark));
      color: #fff;
      box-shadow: 0 16px 30px rgba(31, 122, 255, 0.28);
    }

    .crm-button.green {
      border-color: transparent;
      background: linear-gradient(135deg, #0ac391, #059669);
      color: #fff;
      box-shadow: 0 16px 30px rgba(8, 169, 121, 0.24);
    }

    .crm-button.danger {
      border-color: #ffd7d4;
      background: #fff;
      color: #d9342e;
    }

    .crm-select,
    .crm-input {
      height: 44px;
      border: 1px solid var(--crm-line);
      border-radius: 9px;
      background: #fff;
      padding: 0 13px;
      color: var(--crm-text);
      font-weight: 750;
    }

    .crm-grid {
      display: grid;
      gap: 18px;
    }

    .crm-kpis {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .crm-card {
      border: 1px solid var(--crm-line);
      border-radius: 12px;
      background: #fff;
      box-shadow: 0 10px 30px rgba(16, 32, 71, 0.055);
    }

    .crm-kpi {
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 14px;
      align-items: center;
      min-height: 112px;
      padding: 20px;
    }

    .crm-kpi-icon {
      width: 58px;
      height: 58px;
      display: grid;
      place-items: center;
      border-radius: 999px;
      font-size: 28px;
      font-weight: 900;
    }

    .blue-soft { background: #eaf3ff; color: var(--crm-blue); }
    .green-soft { background: #ddfaef; color: var(--crm-green); }
    .red-soft { background: #ffeded; color: var(--crm-red); }
    .orange-soft { background: #fff3dc; color: var(--crm-orange); }
    .purple-soft { background: #f1eaff; color: var(--crm-purple); }

    .crm-kpi-label {
      color: #506080;
      font-size: 13px;
      font-weight: 850;
    }

    .crm-kpi-value {
      margin-top: 4px;
      color: var(--crm-navy);
      font-size: 25px;
      font-weight: 950;
      letter-spacing: -0.03em;
    }

    .crm-trend {
      margin-top: 4px;
      color: var(--crm-muted);
      font-size: 12px;
      font-weight: 800;
    }

    .crm-trend.up { color: var(--crm-green); }
    .crm-trend.down { color: var(--crm-red); }

    .crm-card-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      min-height: 56px;
      border-bottom: 1px solid var(--crm-line);
      padding: 0 18px;
    }

    .crm-card-title {
      color: var(--crm-navy);
      font-weight: 950;
    }

    .crm-link {
      border: 0;
      background: transparent;
      color: var(--crm-blue);
      font-size: 12px;
      font-weight: 900;
      cursor: pointer;
    }

    .crm-sheet-tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 4px 0 14px;
      scrollbar-width: thin;
    }

    .crm-sheet-tab {
      flex: 0 0 auto;
      min-height: 40px;
      border: 1px solid var(--crm-line);
      border-radius: 9px 9px 0 0;
      background: #f7faff;
      padding: 0 16px;
      color: #52617f;
      font-size: 13px;
      font-weight: 950;
      cursor: pointer;
    }

    .crm-sheet-tab.active {
      border-color: #b9d2ff;
      border-bottom-color: #fff;
      background: #fff;
      color: var(--crm-blue-dark);
      box-shadow: 0 -6px 18px rgba(31, 122, 255, 0.08);
    }

    .crm-table-wrap {
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: #cbd5e1 transparent;
      max-width: 100%;
    }

    .crm-table {
      width: 100%;
      min-width: 860px;
      border-collapse: collapse;
      color: #26395e;
      font-size: 13px;
      font-weight: 720;
    }

    .crm-table th,
    .crm-table td {
      border-bottom: 1px solid #edf2f8;
      padding: 13px 16px;
      text-align: left;
      vertical-align: middle;
      white-space: nowrap;
    }

    .crm-table td::before {
      display: none;
    }

    .crm-table th {
      color: #4f5f80;
      font-size: 12px;
      font-weight: 950;
      background: #fbfdff;
    }

    .crm-table tr:hover td {
      background: #f8fbff;
    }

    .crm-status {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 24px;
      border-radius: 6px;
      padding: 0 9px;
      font-size: 12px;
      font-weight: 900;
    }

    .crm-status.blue { background: #e9f3ff; color: var(--crm-blue); }
    .crm-status.green { background: #e5f9f0; color: #05875f; }
    .crm-status.red { background: #ffeded; color: var(--crm-red); }
    .crm-status.orange { background: #fff3df; color: #c56b00; }
    .crm-status.purple { background: #f1eaff; color: var(--crm-purple); }
    .crm-status.gray { background: #eef3f9; color: #62718f; }

    .crm-progress {
      display: grid;
      grid-template-columns: minmax(72px, 1fr) 38px;
      gap: 10px;
      align-items: center;
    }

    .crm-progress-track {
      height: 7px;
      border-radius: 999px;
      background: #e8eef6;
      overflow: hidden;
    }

    .crm-progress-fill {
      height: 100%;
      border-radius: inherit;
      background: #0eb6a3;
    }

    .crm-two-col {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(340px, 0.35fr);
      gap: 18px;
      align-items: start;
    }

    .crm-three-col {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .crm-chart {
      height: 190px;
      margin: 18px;
      border-radius: 10px;
      background:
        linear-gradient(to top, transparent 23%, #edf2f8 24%, transparent 25%),
        linear-gradient(to top, transparent 48%, #edf2f8 49%, transparent 50%),
        linear-gradient(to top, transparent 73%, #edf2f8 74%, transparent 75%),
        linear-gradient(135deg, rgba(31, 122, 255, 0.12), rgba(8, 169, 121, 0.12));
      position: relative;
      overflow: hidden;
    }

    .crm-chart::before,
    .crm-chart::after {
      content: "";
      position: absolute;
      left: 20px;
      right: 20px;
      height: 4px;
      border-radius: 999px;
      transform-origin: left center;
    }

    .crm-chart::before {
      bottom: 58px;
      background: linear-gradient(90deg, var(--crm-green), #22d3ee);
      transform: skewY(-9deg);
      box-shadow: 70px -20px 0 -1px #16c79a, 150px 4px 0 -1px #16c79a, 245px -42px 0 -1px #16c79a;
    }

    .crm-chart::after {
      bottom: 32px;
      background: linear-gradient(90deg, var(--crm-red), #ff8a80);
      transform: skewY(-6deg);
      box-shadow: 85px 14px 0 -1px #ff6b67, 180px -8px 0 -1px #ff6b67, 275px 6px 0 -1px #ff6b67;
    }

    .crm-donut {
      width: 156px;
      height: 156px;
      margin: 22px auto;
      border-radius: 999px;
      background: conic-gradient(var(--crm-blue) 0 38%, var(--crm-green) 38% 68%, var(--crm-purple) 68% 82%, var(--crm-orange) 82% 94%, var(--crm-red) 94% 100%);
      position: relative;
      box-shadow: inset 0 0 0 1px rgba(8, 22, 56, 0.04), 0 18px 38px rgba(31, 122, 255, 0.12);
    }

    .crm-donut::after {
      content: "";
      position: absolute;
      inset: 38px;
      border-radius: inherit;
      background: #fff;
      box-shadow: inset 0 0 0 1px #edf2f8;
    }

    .crm-detail {
      position: sticky;
      top: 94px;
      padding: 20px;
    }

    .crm-detail-hero {
      display: flex;
      gap: 14px;
      align-items: center;
      margin-bottom: 18px;
    }

    .crm-detail-icon {
      width: 56px;
      height: 56px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--crm-blue), var(--crm-blue-dark));
      color: #fff;
      font-size: 26px;
      font-weight: 900;
    }

    .crm-list {
      display: grid;
      gap: 12px;
      padding: 18px;
    }

    .crm-list-row {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      border-bottom: 1px solid #edf2f8;
      padding-bottom: 12px;
      color: #26395e;
      font-size: 13px;
      font-weight: 750;
    }

    .crm-list-row:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }

    .crm-actionbar {
      display: none;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
      border: 1px solid #b9d2ff;
      border-radius: 10px;
      background: #eef5ff;
      padding: 12px 14px;
      color: #143a79;
      font-size: 13px;
      font-weight: 850;
    }

    .crm-actionbar.show {
      display: flex;
    }

    .crm-row-actions {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
    }

    .crm-mini-action {
      min-height: 34px;
      border: 1px solid var(--crm-line);
      border-radius: 7px;
      background: #fff;
      padding: 0 10px;
      color: #26456f;
      font-size: 12px;
      font-weight: 900;
      cursor: pointer;
    }

    .crm-mini-action:hover {
      border-color: #b9d2ff;
      color: var(--crm-blue-dark);
      box-shadow: 0 8px 18px rgba(31, 122, 255, 0.1);
    }

    .crm-mini-action.danger {
      border-color: #ffd7d4;
      color: #d9342e;
    }

    .crm-page {
      display: none;
    }

    .crm-page.active {
      display: block;
    }

    .crm-edit-input,
    .crm-edit-select {
      width: 100%;
      min-width: 120px;
      height: 34px;
      border: 1px solid transparent;
      border-radius: 7px;
      background: transparent;
      padding: 0 8px;
      color: inherit;
      font: inherit;
      font-weight: 760;
    }

    .crm-edit-input:hover,
    .crm-edit-select:hover,
    .crm-edit-input:focus,
    .crm-edit-select:focus {
      border-color: var(--crm-line);
      background: #fff;
      outline: none;
      box-shadow: 0 0 0 3px rgba(31, 122, 255, 0.12);
    }

    .crm-dirty {
      box-shadow: inset 3px 0 0 var(--crm-orange);
    }

    .crm-modal {
      position: fixed;
      inset: 0;
      z-index: 90;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(8, 22, 56, 0.55);
      padding: 18px;
    }

    .crm-modal.open {
      display: flex;
    }

    .crm-modal-panel {
      width: min(940px, 100%);
      max-height: 92vh;
      overflow: auto;
      border-radius: 12px;
      background: #fff;
      box-shadow: 0 24px 90px rgba(8, 22, 56, 0.28);
    }

    .crm-form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .crm-form-grid label {
      display: grid;
      gap: 7px;
      color: #52617f;
      font-size: 12px;
      font-weight: 950;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .crm-form-grid input,
    .crm-form-grid select,
    .crm-form-grid textarea {
      border: 1px solid var(--crm-line);
      border-radius: 9px;
      padding: 12px;
      color: var(--crm-text);
      font-size: 14px;
      font-weight: 750;
      text-transform: none;
      letter-spacing: 0;
    }

    .crm-form-grid textarea,
    .crm-form-grid .wide {
      grid-column: 1 / -1;
    }

    .crm-toast {
      position: fixed;
      right: 24px;
      bottom: 24px;
      z-index: 120;
      display: none;
      border-radius: 10px;
      background: #081638;
      padding: 13px 16px;
      color: #fff;
      font-size: 14px;
      font-weight: 850;
      box-shadow: 0 20px 44px rgba(8, 22, 56, 0.22);
    }

    .crm-toast.show {
      display: block;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .crm-app button:focus-visible,
    .crm-app input:focus-visible,
    .crm-app select:focus-visible,
    .crm-app textarea:focus-visible {
      outline: 3px solid rgba(31, 122, 255, 0.32);
      outline-offset: 2px;
    }

    @media (max-width: 1180px) {
      .crm-app {
        grid-template-columns: 92px minmax(0, 1fr);
      }

      .crm-brand span,
      .crm-nav-label,
      .crm-company-pill,
      .crm-user-text {
        display: none;
      }

      .crm-brand {
        justify-content: center;
        padding-left: 0;
        padding-right: 0;
      }

      .crm-nav button {
        justify-content: center;
        padding: 13px;
      }

      .crm-topbar {
        grid-template-columns: minmax(220px, 1fr) auto;
      }

      .crm-two-col {
        grid-template-columns: 1fr;
      }

      .crm-kpis {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding-bottom: 8px;
      }

      .crm-kpi {
        min-width: 260px;
        scroll-snap-align: start;
      }

      .crm-detail {
        position: static;
      }
    }

    @media (max-width: 900px) {
      .crm-app {
        display: block;
      }

      .crm-sidebar {
        position: sticky;
        z-index: 40;
        top: 0;
        height: auto;
        border-right: 0;
        border-bottom: 1px solid var(--crm-line);
        padding: 12px;
      }

      .crm-brand {
        justify-content: flex-start;
        padding-bottom: 10px;
      }

      .crm-brand span {
        display: inline;
      }

      .crm-nav {
        display: flex;
        overflow-x: auto;
        gap: 8px;
        padding-bottom: 4px;
        scroll-snap-type: x mandatory;
      }

      .crm-nav button {
        flex: 0 0 auto;
        width: auto;
        scroll-snap-align: start;
      }

      .crm-nav-label {
        display: inline;
      }

      .crm-collapse {
        display: none;
      }

      .crm-topbar {
        position: static;
        grid-template-columns: 1fr;
        padding: 12px;
      }

      .crm-top-actions {
        justify-self: stretch;
        justify-content: space-between;
      }

      .crm-user {
        min-width: auto;
      }

      .crm-content {
        padding: 16px 12px 28px;
      }

      .crm-page-head {
        display: grid;
      }

      .crm-toolbar {
        justify-content: flex-start;
      }

      .crm-kpis,
      .crm-three-col {
        grid-template-columns: 1fr;
      }

      .crm-kpis {
        display: flex;
      }

      .crm-card-head {
        align-items: flex-start;
        gap: 12px;
      }

      .crm-actionbar {
        position: sticky;
        top: 0;
        z-index: 35;
        align-items: flex-start;
        flex-direction: column;
      }

      .crm-form-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .crm-app {
        background: #fff;
      }

      .crm-sidebar {
        padding: 10px 10px 8px;
      }

      .crm-brand {
        font-size: 20px;
      }

      .crm-logo {
        width: 32px;
        height: 32px;
        border-radius: 9px;
      }

      .crm-nav button {
        min-height: 40px;
        padding: 9px 11px;
        font-size: 13px;
      }

      .crm-top-actions {
        display: grid;
        grid-template-columns: repeat(3, 44px) 1fr;
        gap: 8px;
      }

      .crm-company-pill {
        display: none;
      }

      .crm-user {
        justify-content: flex-end;
        padding-left: 0;
      }

      .crm-search input {
        height: 44px;
        font-size: 14px;
      }

      .crm-page-title {
        font-size: 24px;
      }

      .crm-page-subtitle {
        font-size: 14px;
      }

      .crm-toolbar {
        width: 100%;
      }

      .crm-toolbar > * {
        flex: 1 1 150px;
      }

      .crm-button,
      .crm-select,
      .crm-input {
        width: 100%;
      }

      .crm-kpi {
        min-width: 78vw;
      }

      .crm-card {
        border-radius: 10px;
      }

      .crm-table-wrap {
        overflow: visible;
      }

      .crm-table {
        min-width: 0;
        display: block;
      }

      .crm-table thead {
        display: none;
      }

      .crm-table tbody,
      .crm-table tr,
      .crm-table td {
        display: block;
        width: 100%;
      }

      .crm-table tr {
        border-bottom: 1px solid #edf2f8;
        padding: 12px 14px;
      }

      .crm-table td {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        border-bottom: 0;
        padding: 8px 0;
        white-space: normal;
        text-align: right;
      }

      .crm-table td::before {
        content: attr(data-label);
        display: block;
        min-width: 110px;
        color: #667599;
        text-align: left;
        font-size: 12px;
        font-weight: 950;
      }

      .crm-table td:first-child::before {
        content: "Select";
      }

      .crm-edit-input,
      .crm-edit-select {
        min-width: 0;
        text-align: right;
      }

      .crm-row-actions {
        justify-content: flex-end;
        flex-wrap: wrap;
      }

      .crm-detail {
        padding: 16px;
      }

      .crm-list {
        padding: 14px;
      }

      .crm-list-row {
        align-items: flex-start;
        flex-direction: column;
        gap: 5px;
      }

      .crm-modal {
        align-items: stretch;
        padding: 8px;
      }

      .crm-modal-panel {
        max-height: calc(100vh - 16px);
        border-radius: 10px;
      }

      .crm-actionbar.show {
        position: fixed;
        right: 10px;
        bottom: 10px;
        left: 10px;
        top: auto;
        z-index: 80;
        box-shadow: 0 18px 46px rgba(8, 22, 56, 0.2);
      }

      .crm-toast {
        right: 10px;
        bottom: 10px;
        left: 10px;
      }
    }
  </style>

  <div class="crm-app">
    <aside class="crm-sidebar">
      <div class="crm-brand"><div class="crm-logo"></div><span>TechMigos CRM</span></div>
      <nav class="crm-nav" aria-label="Company CRM navigation" id="crm-nav"></nav>
      <button id="crm-collapse" class="crm-button crm-collapse" type="button" aria-label="Collapse sidebar">⇤</button>
    </aside>

    <main class="crm-main">
      <header class="crm-topbar">
        <label class="crm-search">
          <span>⌕</span>
          <span class="sr-only">Search CRM</span>
          <input id="crm-search" type="search" placeholder="Search across projects, clients, tickets..." />
          <span class="crm-search-kbd">/</span>
        </label>
        <div></div>
        <div class="crm-top-actions">
          <div class="crm-company-pill"><span>▥</span><span>TechMigos Solutions</span></div>
          <button id="crm-notifications" class="crm-icon-button" type="button" aria-label="Notifications">⌁<span class="crm-badge-dot">3</span></button>
          <button class="crm-icon-button" type="button" aria-label="Help">?</button>
          <button id="crm-profile-button" class="crm-user" type="button" aria-label="Open profile management">
            <div class="crm-avatar">TM</div>
            <div class="crm-user-text">
              <p id="crm-user-name" class="font-black leading-tight text-slate-950">Loading...</p>
              <p id="crm-user-role" class="text-sm font-semibold text-slate-500">Company</p>
            </div>
          </button>
        </div>
      </header>

      <section class="crm-content">
        <p id="crm-status" class="mb-4 text-sm font-bold text-slate-500" role="status">Loading CRM data...</p>
        <div id="crm-actionbar" class="crm-actionbar">
          <span id="crm-selected-count">0 selected</span>
          <div class="crm-toolbar">
            <button class="crm-button" type="button" data-bulk-export>Export Selected</button>
            <button class="crm-button danger" type="button" data-bulk-delete>Delete Selected</button>
            <button class="crm-button" type="button" data-clear-selection>Clear</button>
          </div>
        </div>
        <div id="crm-view"></div>
      </section>
    </main>
  </div>

  <div id="crm-modal" class="crm-modal" role="dialog" aria-modal="true">
    <div class="crm-modal-panel">
      <div class="crm-card-head">
        <h2 id="crm-modal-title" class="crm-card-title">Create</h2>
        <button id="crm-modal-close" class="crm-icon-button" type="button" aria-label="Close">×</button>
      </div>
      <div id="crm-modal-body" class="p-5"></div>
    </div>
  </div>
  <div id="invoice-modal" class="crm-modal" role="dialog" aria-modal="true">
    <div class="crm-modal-panel">
      <div class="crm-card-head">
        <h2 id="invoice-preview-title" class="crm-card-title">Invoice</h2>
        <div class="flex gap-2">
          <button id="print-invoice" class="crm-button primary" type="button">Print PDF</button>
          <button id="close-invoice" class="crm-icon-button" type="button" aria-label="Close">×</button>
        </div>
      </div>
      <div id="invoice-preview" class="p-5"></div>
    </div>
  </div>
  <div id="crm-toast" class="crm-toast"></div>

  <script is:inline>
    const navItems = [
      ['dashboard', 'Dashboard', '⌂'],
      ['leads', 'Leads', '◎'],
      ['deals', 'Deals', '◈'],
      ['projects', 'Projects', '▣'],
      ['tickets', 'Support Tickets', '◴'],
      ['finance', 'Finance', '▤'],
      ['analytics', 'Analytics', '▥'],
      ['clients', 'Clients', '○'],
      ['employees', 'Employees', '♙'],
      ['users', 'User Management', '♧'],
      ['followups', 'Follow-ups', '⌁'],
      ['campaigns', 'Campaigns', '✉'],
      ['settings', 'Settings', '⚙'],
    ];

    const state = {
      active: 'dashboard',
      search: '',
      profile: null,
      selectedProjectId: null,
      selectedTicketId: null,
      selectedClientId: null,
      selectedEmployeeId: null,
      financeSheet: 'all',
      saveTimers: new Map(),
      data: {
        leads: [],
        clients: [],
        projects: [],
        deals: [],
        tickets: [],
        invoices: [],
        finances: [],
        followups: [],
        campaigns: [],
        activities: [],
        profiles: [],
      },
    };

    const els = {
      nav: document.getElementById('crm-nav'),
      view: document.getElementById('crm-view'),
      search: document.getElementById('crm-search'),
      status: document.getElementById('crm-status'),
      toast: document.getElementById('crm-toast'),
      modal: document.getElementById('crm-modal'),
      modalTitle: document.getElementById('crm-modal-title'),
      modalBody: document.getElementById('crm-modal-body'),
      invoiceModal: document.getElementById('invoice-modal'),
      invoicePreview: document.getElementById('invoice-preview'),
      invoicePreviewTitle: document.getElementById('invoice-preview-title'),
      actionbar: document.getElementById('crm-actionbar'),
      selectedCount: document.getElementById('crm-selected-count'),
    };

    function token() {
      return sessionStorage.getItem('tm_portal_access_token') || '';
    }

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
    }

    function money(value, currency = 'INR') {
      return `${currency} ${Number(value || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    function compactMoney(value) {
      return `₹${Number(value || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 })}`;
    }

    function nice(value) {
      return escapeHtml(String(value || '').replace(/_/g, ' ') || '-');
    }

    function toast(message) {
      els.toast.textContent = message;
      els.toast.classList.add('show');
      clearTimeout(toast.timer);
      toast.timer = setTimeout(() => els.toast.classList.remove('show'), 2400);
    }

    function setStatus(message, tone = 'neutral') {
      els.status.textContent = message;
      els.status.style.color = tone === 'error' ? 'var(--crm-red)' : tone === 'success' ? 'var(--crm-green)' : '#667599';
    }

    async function portal(path, options = {}) {
      const headers = new Headers(options.headers || {});
      headers.set('authorization', `Bearer ${token()}`);
      if (options.body && !headers.has('content-type')) headers.set('content-type', 'application/json');
      const response = await window.techmigosApiFetch(path, { ...options, headers });
      const data = await response.json().catch(() => null);
      if (!response.ok) throw new Error(data?.error || 'Portal request failed.');
      return data;
    }

    function logout() {
      sessionStorage.removeItem('tm_portal_access_token');
      sessionStorage.removeItem('tm_portal_refresh_token');
      sessionStorage.removeItem('tm_portal_csrf_token');
      location.href = '/login';
    }

    function clientName(id) {
      const client = state.data.clients.find((item) => String(item.id) === String(id));
      return client?.company || client?.name || `Client #${id || '-'}`;
    }

    function filtered(rows, keys) {
      const query = state.search.trim().toLowerCase();
      if (!query) return rows;
      return rows.filter((row) => keys.some((key) => String(row[key] || '').toLowerCase().includes(query)));
    }

    function statusTone(status) {
      if (['paid', 'received', 'active', 'completed', 'resolved', 'closed', 'on_track'].includes(status)) return 'green';
      if (['overdue', 'urgent', 'at_risk', 'cancelled'].includes(status)) return 'red';
      if (['sent', 'viewed', 'watch', 'high', 'half_payment', 'pending', 'on_hold'].includes(status)) return 'orange';
      if (['planning', 'proposal'].includes(status)) return 'purple';
      return 'blue';
    }

    function badge(value, tone = statusTone(value)) {
      return `<span class="crm-status ${tone}">${nice(value)}</span>`;
    }

    function rowActions(resource, id, options = {}) {
      const view = options.view ? `<button class="crm-mini-action" ${options.viewAttr || ''} type="button">View</button>` : '';
      const invoice = resource === 'invoices' ? `<button class="crm-mini-action" data-invoice-view="${id}" type="button">Invoice</button>` : '';
      return `<div class="crm-row-actions">
        ${view}${invoice}
        <button class="crm-mini-action" data-edit-resource="${resource}" data-edit-id="${id}" type="button">Edit</button>
        <button class="crm-mini-action" data-duplicate-resource="${resource}" data-duplicate-id="${id}" type="button">Duplicate</button>
        <button class="crm-mini-action danger" data-delete-resource="${resource}" data-delete-id="${id}" type="button">Delete</button>
      </div>`;
    }

    function metric(label, value, icon, color = 'blue', trend = 'up 12% vs last month') {
      return `<article class="crm-card crm-kpi">
        <div class="crm-kpi-icon ${color}-soft">${icon}</div>
        <div><p class="crm-kpi-label">${label}</p><p class="crm-kpi-value">${value}</p><p class="crm-trend ${trend.startsWith('down') ? 'down' : 'up'}">${trend}</p></div>
      </article>`;
    }

    function progress(value) {
      const safe = Math.max(0, Math.min(100, Number(value || 0)));
      return `<div class="crm-progress"><div class="crm-progress-track"><div class="crm-progress-fill" style="width:${safe}%"></div></div><strong>${safe}%</strong></div>`;
    }

    function renderShell() {
      els.nav.innerHTML = navItems.map(([key, label, icon]) => `
        <button type="button" data-nav="${key}" aria-current="${state.active === key ? 'page' : 'false'}">
          <span class="crm-nav-icon">${icon}</span><span class="crm-nav-label">${label}</span>
        </button>
      `).join('');
      els.nav.querySelectorAll('[data-nav]').forEach((button) => button.addEventListener('click', () => {
        state.active = button.dataset.nav;
        render();
      }));
      document.querySelectorAll('[data-jump]').forEach((button) => button.addEventListener('click', () => {
        state.active = button.dataset.jump;
        render();
      }));
    }

    function pageHead(title, subtitle, actions = '') {
      return `<div class="crm-page-head"><div><h1 class="crm-page-title">${title}</h1><p class="crm-page-subtitle">${subtitle}</p></div><div class="crm-toolbar">${actions}</div></div>`;
    }

    function table(headers, rows, empty = 'No records yet.') {
      table.labelIndex = 0;
      const labeledRows = rows ? rows.replace(/<td(?![^>]*data-label=)([^>]*)>/g, (match, attrs) => {
        const index = table.labelIndex % headers.length;
        table.labelIndex += 1;
        return `<td data-label="${escapeHtml(headers[index] || '')}"${attrs}>`;
      }) : '';
      return `<div class="crm-table-wrap"><table class="crm-table"><thead><tr>${headers.map((item) => `<th>${item}</th>`).join('')}</tr></thead><tbody>${labeledRows || `<tr><td data-label="" colspan="${headers.length}">${empty}</td></tr>`}</tbody></table></div>`;
    }
    table.labelIndex = 0;

    function renderDashboard() {
      const projects = state.data.projects;
      const tickets = state.data.tickets;
      const clients = state.data.clients;
      const finances = state.data.finances;
      const income = finances.filter((item) => ['income', 'revenue'].includes(item.transaction_type)).reduce((sum, item) => sum + Number(item.amount || 0), 0);
      const expenses = finances.filter((item) => ['expense', 'salary'].includes(item.transaction_type)).reduce((sum, item) => sum + Number(item.amount || 0), 0);
      const openTickets = tickets.filter((item) => !['resolved', 'closed'].includes(item.status));
      const projectRows = filtered(projects, ['name', 'client_name', 'status', 'project_manager']).slice(0, 5).map((project) => `
        <tr><td><strong>${escapeHtml(project.name)}</strong></td><td>${escapeHtml(project.client_name || clientName(project.client_id))}</td><td>${badge(project.status)}</td><td>${compactMoney(project.budget)}</td><td>${progress(project.progress)}</td></tr>
      `).join('');
      const ticketRows = filtered(tickets, ['subject', 'priority', 'assigned_to', 'status']).slice(0, 5).map((ticket) => `
        <tr><td>#TIC-${ticket.id}</td><td>${badge(ticket.priority, statusTone(ticket.priority))}</td><td>${escapeHtml(ticket.assigned_to || 'Unassigned')}</td><td>${badge(ticket.status)}</td></tr>
      `).join('');
      els.view.innerHTML = `
        ${pageHead(`Welcome back, ${escapeHtml(state.profile?.name || 'Team')}`, "Here's what's happening with your company today.", '<button class="crm-button" type="button">May 20 - May 26, 2025</button>')}
        <div class="crm-grid crm-kpis">
          ${metric('Total Projects', projects.length, '▣', 'blue')}
          ${metric('Active Clients', clients.filter((item) => item.status !== 'archived').length, '○', 'green')}
          ${metric('Open Tickets', openTickets.length, '◴', 'red', openTickets.length ? 'down 5% vs last month' : 'up 0% vs last month')}
          ${metric('Monthly Revenue', compactMoney(income), '₹', 'green')}
          ${metric('Active Employees', Math.max(state.data.profiles.length, 1), '♙', 'purple')}
        </div>
        <div class="crm-two-col mt-5">
          <section class="crm-card">
            <div class="crm-card-head"><h2 class="crm-card-title">Projects Overview</h2><button class="crm-link" data-jump="projects">View all projects</button></div>
            ${table(['Project Name', 'Client', 'Status', 'Budget', 'Progress'], projectRows)}
          </section>
          <section class="crm-card">
            <div class="crm-card-head"><h2 class="crm-card-title">Financial Summary</h2><button class="crm-link" data-jump="finance">View full report</button></div>
            <div class="crm-list">
              <div class="crm-list-row"><span>Revenue</span><strong>${compactMoney(income)}</strong></div>
              <div class="crm-list-row"><span>Expenses</span><strong>${compactMoney(expenses)}</strong></div>
              <div class="crm-list-row"><span>Invoices Due</span><strong>${compactMoney(state.data.invoices.reduce((sum, item) => sum + Number(item.total_amount || item.amount || 0), 0))}</strong></div>
              <div class="crm-list-row"><span>Net Cash Flow</span><strong>${compactMoney(income - expenses)}</strong></div>
            </div>
            <div class="crm-chart" aria-hidden="true"></div>
          </section>
        </div>
        <div class="crm-three-col mt-5">
          <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Recent Support Tickets</h2><button class="crm-link" data-jump="tickets">View all tickets</button></div>${table(['Ticket ID', 'Priority', 'Assigned Agent', 'Status'], ticketRows)}</section>
          <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">User Activity</h2></div><div class="crm-list">${state.data.activities.slice(0, 5).map((item) => `<div class="crm-list-row"><span>${escapeHtml(item.summary || item.action)}</span><small>${escapeHtml(String(item.created_at || '').slice(0, 10))}</small></div>`).join('') || '<p class="p-4 text-sm font-bold text-slate-500">No activity yet.</p>'}</div></section>
          <section class="crm-card"><div class="crm-card-head"><h2 class="crm-card-title">Secure Role-Based Access</h2></div><div class="crm-list"><p class="text-sm font-semibold leading-6 text-slate-600">Separate workspaces for clients and employees keep project, finance, and support data controlled.</p><div class="crm-list-row"><span>Clients</span><strong>Project visibility</strong></div><div class="crm-list-row"><span>Employees</span><strong>Company operations</strong></div></div></section>
        </div>
      `;
    }

    function projectRows() {
      return filtered(state.data.projects, ['name', 'client_name', 'status', 'project_manager']).map((project) => `
        <tr data-resource="projects" data-row-id="${project.id}">
          <td><input type="checkbox" data-row-select aria-label="Select project ${escapeHtml(project.name)}" /></td>
          <td><input class="crm-edit-input" data-field="name" value="${escapeHtml(project.name)}" /></td>
          <td><input class="crm-edit-input" data-field="client_name" value="${escapeHtml(project.client_name || clientName(project.client_id))}" /></td>
          <td><input class="crm-edit-input" data-field="project_manager" value="${escapeHtml(project.project_manager || '')}" /></td>
          <td><input class="crm-edit-input" data-field="budget" type="number" value="${escapeHtml(project.budget || 0)}" /></td>
          <td><input class="crm-edit-input" data-field="due_date" type="date" value="${escapeHtml(project.due_date || '')}" /></td>
          <td><select class="crm-edit-select" data-field="status">${['planning', 'active', 'review', 'completed', 'on_hold'].map((item) => `<option value="${item}" ${project.status === item ? 'selected' : ''}>${nice(item)}</option>`).join('')}</select></td>
          <td>${badge(project.health, statusTone(project.health))}</td>
          <td>${progress(project.progress)}</td>
          <td>${rowActions('projects', project.id, { view: true, viewAttr: `data-project-detail="${project.id}"` })}</td>
        </tr>
      `).join('');
    }

    function renderProjects() {
      const selected = state.data.projects.find((item) => String(item.id) === String(state.selectedProjectId)) || state.data.projects[0];
      state.selectedProjectId = selected?.id || null;
      els.view.innerHTML = `
        ${pageHead('Projects Management', 'Manage all projects, track progress, budgets, and project health.', '<button class="crm-button primary" data-create="projects" type="button">+ Create Project</button>')}
        <div class="crm-grid crm-kpis">
          ${metric('Total Projects', state.data.projects.length, '▣', 'blue')}
          ${metric('At-Risk Projects', state.data.projects.filter((item) => ['watch', 'at_risk'].includes(item.health)).length, '!', 'orange', 'up 3 vs last month')}
          ${metric('Open Support Tickets', state.data.tickets.filter((item) => !['resolved', 'closed'].includes(item.status)).length, '◴', 'red', 'down 8 vs last month')}
          ${metric('Resolved Tickets', state.data.tickets.filter((item) => ['resolved', 'closed'].includes(item.status)).length, '✓', 'green')}
        </div>
        <div class="crm-two-col mt-5">
          <section class="crm-card">
            <div class="crm-card-head"><h2 class="crm-card-title">Projects</h2><div class="crm-toolbar"><select class="crm-select"><option>All Statuses</option></select><button class="crm-button" data-export="projects">Export</button></div></div>
