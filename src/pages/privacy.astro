---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';

const updatedAt = 'April 3, 2026';

const highlights = [
  'We only collect the information needed to respond, deliver services, and process applications.',
  'We do not sell personal information to third parties.',
  'You can request access, correction, or deletion of your personal data.',
];

const sections = [
  {
    id: 'data-we-collect',
    title: 'Information We Collect',
    body: [
      'We collect information you choose to share with us through contact forms, newsletter signups, and job applications.',
      'This may include your name, email address, company information, project details, links you submit, and resume or CV files for career applications.',
    ],
    bullets: [
      'Contact details such as name, email, and phone number when provided',
      'Business details such as company name, service interest, and project scope',
      'Career application materials such as resume files, cover letters, and public profile links',
      'Basic technical information required to protect the site, prevent abuse, and maintain operations',
    ],
  },
  {
    id: 'how-we-use-data',
    title: 'How We Use Information',
    body: [
      'We use collected information to communicate with you, evaluate inquiries, deliver requested services, review hiring submissions, and improve the website experience.',
      'Where appropriate, we may also use limited information for fraud prevention, rate limiting, security monitoring, and record keeping.',
    ],
    bullets: [
      'Respond to contact requests and project inquiries',
      'Process and review job applications',
      'Send newsletter updates when you opt in',
      'Maintain service reliability, security, and abuse prevention',
    ],
  },
  {
    id: 'sharing',
    title: 'Information Sharing',
    body: [
      'We do not sell or rent your personal information. We may share information with trusted service providers only when necessary to operate the website, manage communications, or support business operations.',
      'We may also disclose information when required by law or when reasonably necessary to protect our rights, users, or systems.',
    ],
  },
  {
    id: 'retention-security',
    title: 'Data Retention and Security',
    body: [
      'We keep information only for as long as it is reasonably needed for the purpose it was collected, legal obligations, dispute resolution, or legitimate operational needs.',
      'We use appropriate technical and organizational measures to help protect submitted data, but no system can guarantee absolute security.',
    ],
  },
  {
    id: 'your-rights',
    title: 'Your Choices and Rights',
    body: [
      'You may request access to, correction of, or deletion of your personal information, subject to legal and operational limitations.',
      'If you have subscribed to marketing communications, you can opt out at any time using the unsubscribe option or by contacting us directly.',
    ],
  },
  {
    id: 'contact',
    title: 'Contact',
    body: [
      'If you have questions about this Privacy Policy or want to make a privacy request, contact us at privacy@techmigos.com.',
    ],
  },
];
---

<BaseLayout
  title="Privacy Policy"
  description="Read how TechMigos collects, uses, stores, and protects personal information across inquiries, newsletters, and career applications."
>
  <section class="pt-36 pb-16 relative overflow-hidden bg-gray-50">
    <div class="absolute inset-0 dot-pattern opacity-40"></div>
    <div class="absolute -top-24 right-0 h-80 w-80 rounded-full bg-primary-100 blur-3xl opacity-50"></div>
    <div class="container-custom relative z-10">
      <div class="max-w-4xl">
        <span class="section-eyebrow reveal">Legal</span>
        <h1 class="reveal stagger-1 text-5xl sm:text-6xl font-extrabold text-gray-900 mb-5 leading-tight">
          Privacy Policy
        </h1>
        <p class="reveal stagger-2 max-w-3xl text-xl text-gray-500 leading-relaxed">
          A clearer view of what we collect, why we collect it, and how we handle it.
        </p>
        <div class="reveal stagger-3 mt-8 inline-flex items-center gap-3 rounded-full border border-primary-100 bg-white px-5 py-2 text-sm font-semibold text-slate-600 shadow-sm">
          <span class="h-2.5 w-2.5 rounded-full bg-primary-500"></span>
          Last updated {updatedAt}
        </div>
      </div>
    </div>
  </section>

  <section class="pb-24 bg-white">
    <div class="container-custom">
      <div class="grid gap-10 lg:grid-cols-[18rem,minmax(0,1fr)]">
        <aside class="reveal-left">
          <div class="sticky top-28 space-y-5 rounded-3xl border border-slate-200 bg-slate-50 p-6 shadow-sm">
            <div>
              <h2 class="text-lg font-extrabold text-slate-900">Quick Summary</h2>
              <p class="mt-2 text-sm leading-6 text-slate-500">The most important points to know before reading the full policy.</p>
            </div>
            <ul class="space-y-3">
              {highlights.map((item) => (
                <li class="rounded-2xl bg-white px-4 py-3 text-sm leading-6 text-slate-700 border border-slate-200">{item}</li>
              ))}
            </ul>
            <nav aria-label="Privacy policy sections">
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400 mb-3">On this page</p>
              <div class="space-y-2">
                {sections.map((section) => (
                  <a href={`#${section.id}`} class="block rounded-xl px-3 py-2 text-sm font-medium text-slate-600 transition-[background-color,color] duration-200 hover:bg-white hover:text-primary-700">
                    {section.title}
                  </a>
                ))}
              </div>
            </nav>
          </div>
        </aside>

        <div class="reveal-right space-y-6">
          {sections.map((section, index) => (
            <section id={section.id} class={`rounded-3xl border border-slate-200 bg-white p-7 shadow-sm stagger-${Math.min(index + 1, 6)} reveal`}>
              <div class="flex items-center gap-3 mb-4">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-primary-50 text-sm font-black tracking-[0.18em] text-primary-700">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h2 class="text-2xl font-extrabold text-slate-900">{section.title}</h2>
              </div>
              <div class="space-y-4 text-[1.02rem] leading-8 text-slate-600">
                {section.body.map((paragraph) => <p>{paragraph}</p>)}
              </div>
              {section.bullets && (
                <ul class="mt-5 space-y-3">
                  {section.bullets.map((bullet) => (
                    <li class="flex gap-3 rounded-2xl bg-slate-50 px-4 py-3 text-sm leading-6 text-slate-700">
                      <span class="mt-1 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-accent-500"></span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
