---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSectionHeading from '../components/home/HomeSectionHeading.astro';
import HomeServiceCard from '../components/home/HomeServiceCard.astro';
import { services } from '../data/services';

const faqs = [
  ['How do we begin?', 'We start by understanding the problem, the people affected, and the constraints. That gives the work a useful first scope instead of a generic estimate.'],
  ['Can you work with an existing team?', 'Yes. The engagement can be a focused review, a delivery partnership, or a contribution alongside an internal team.'],
  ['What happens after launch?', 'The right next step depends on the product. We can help define a support, improvement, or knowledge-transfer plan as part of the project conversation.'],
];
---

<BaseLayout title="Software development services" description="Explore TechMigos services for web and mobile product development, quality assurance, backend systems, AI integration, and practical technology consulting.">
  <section class="border-b border-slate-200 bg-slate-50 pt-32 sm:pt-40">
    <div class="container-custom grid gap-10 pb-16 sm:pb-24 lg:grid-cols-[minmax(0,1fr),17rem] lg:items-end">
      <div class="max-w-4xl">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary-700">TechMigos services</p>
        <h1 class="mt-4 text-5xl font-extrabold tracking-[-0.06em] text-slate-950 sm:text-7xl">Build the part of the product that matters next.</h1>
        <p class="mt-7 max-w-3xl text-xl leading-8 text-slate-600">Product engineering, quality, and technical direction grounded in a real delivery context—not a pre-packaged promise.</p>
      </div>
      <a href="/contact" class="btn-primary justify-center text-center">Start a conversation <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-24">
    <div class="container-custom">
      <HomeSectionHeading eyebrow="Capabilities" title="Six ways to move a product forward" description="Choose a focused capability or bring the whole problem. We will help identify the most useful first move." />
      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {services.map((service) => <HomeServiceCard icon={service.icon} title={service.shortTitle} problem={service.summary} deliverable={service.deliverables[0]} platform="Explore service" href={`/services/${service.slug}`} />)}
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50 py-16 sm:py-24">
    <div class="container-custom grid gap-10 lg:grid-cols-[.8fr,1.2fr]">
      <HomeSectionHeading eyebrow="Working together" title="Start with context, then choose the right scope." description="A useful engagement creates clarity before it creates code." />
      <ol class="border-l border-slate-300 pl-7">{['Understand the current product and the decision in front of you.', 'Make the first release, review, or training outcome concrete.', 'Deliver with visible checkpoints and a clear handover.'].map((step, index) => <li class="relative pb-9 text-lg leading-8 text-slate-700"><span class="absolute -left-[2.35rem] top-1 flex h-5 w-5 items-center justify-center rounded-full border border-primary-300 bg-slate-50 text-[10px] font-bold text-primary-700">{index + 1}</span>{step}</li>)}</ol>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-24"><div class="container-custom grid gap-10 lg:grid-cols-[.75fr,1.25fr]"><HomeSectionHeading eyebrow="Questions" title="Before we start" description="The answers depend on scope, existing systems, and the people using the outcome." /> <div class="divide-y divide-slate-200">{faqs.map(([question, answer]) => <details class="group py-5"><summary class="cursor-pointer list-none pr-8 text-lg font-bold text-slate-950 marker:hidden">{question}<span class="float-right text-primary-700 group-open:rotate-45">+</span></summary><p class="mt-3 max-w-2xl leading-7 text-slate-600">{answer}</p></details>)}</div></div></section>
</BaseLayout>
