---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';

const services = [
  {
    id: 'web',
    icon: 'web',
    title: 'Web Application Development',
    color: 'from-indigo-500 to-blue-500',
    description: [
      'We build high-performance web applications designed for performance and usability. Our engineers are experts in modern JavaScript frameworks and server-side technologies.',
      'From e-commerce platforms to enterprise dashboards, we architect solutions that scale with your business — following best practices in code quality, testing, and CI/CD to ensure long-term maintainability.',
      'Our web applications are built with accessibility and SEO in mind, ensuring your product reaches the widest audience possible.',
    ],
    deliverables: [
      'Custom web applications (React, Next.js, Vue, Angular)',
      'Progressive Web Apps (PWAs) with offline support',
      'API development and third-party integrations',
      'Real-time features (WebSockets, Server-Sent Events)',
      'Performance optimization and Core Web Vitals',
    ],
    techStack: ['React', 'Next.js', 'Vue', 'Node.js', 'TypeScript', 'PostgreSQL', 'Redis'],
  },
  {
    id: 'mobile',
    icon: 'mobile',
    title: 'Mobile Apps',
    color: 'from-blue-500 to-cyan-500',
    description: [
      'We create native and cross-platform mobile applications that deliver exceptional user experiences on both iOS and Android. We work across the mobile product lifecycle.',
      'Whether you need React Native for speed or native Swift/Kotlin for peak performance, we have the expertise. We follow platform-specific guidelines ensuring your app feels native on every device.',
      'From concept to App Store, we handle the full mobile development lifecycle including ASO, push notifications, and ongoing maintenance.',
    ],
    deliverables: [
      'Native iOS apps (Swift, SwiftUI)',
      'Native Android apps (Kotlin, Jetpack Compose)',
      'Cross-platform apps (React Native, Flutter)',
      'Mobile API backends and offline sync',
      'App Store deployment and ASO',
    ],
    techStack: ['Swift', 'Kotlin', 'React Native', 'Flutter', 'Firebase', 'GraphQL'],
  },
  {
    id: 'desktop',
    icon: 'web',
    title: 'Desktop Software',
    color: 'from-blue-500 to-cyan-500',
    description: [
      'We design and build desktop software for Windows, macOS and Linux.',
      'From focused utilities to full business applications, we create workflows that fit the way your team works.',
    ],
    deliverables: ['Windows, macOS and Linux applications', 'Cross-platform desktop experiences', 'Integrations with your existing services', 'Testing and release support'],
    techStack: ['Desktop applications', 'Cross-platform development', 'API integration'],
  },
  {
    id: 'qa',
    icon: 'qa',
    title: 'Quality Assurance & Testing',
    color: 'from-pink-500 to-rose-500',
    description: [
      'Quality is built into everything we ship. Our QA team designs thorough testing strategies that catch bugs early, prevent regressions, and protect critical user journeys.',
      'We combine manual exploratory testing with automation to validate functionality, edge cases, performance, and reliability across browsers, devices, and environments.',
      'From sprint-level test planning to pre-release certification, we help your team launch with confidence and maintain consistent product quality over time.',
    ],
    deliverables: [
      'Test strategy and end-to-end QA planning',
      'Manual exploratory and regression testing',
      'Automated test suites (UI, API, integration)',
      'Performance, load, and stress testing',
      'Cross-browser and cross-device validation',
      'Defect reporting and release sign-off support',
    ],
    techStack: ['Cypress', 'Playwright', 'Selenium', 'Postman', 'Jest', 'k6', 'JMeter'],
  },
  {
    id: 'backend',
    icon: 'backend',
    title: 'Backend Development',
    color: 'from-cyan-500 to-sky-500',
    description: [
      'We engineer robust backend systems that power your product\'s core workflows with speed, reliability, and security. From APIs to distributed services, we build foundations that scale.',
      'Our team designs clean domain models, resilient service boundaries, and optimized data access patterns to keep your systems maintainable as traffic and complexity grow.',
      'Whether you need a new backend from scratch or modernization of legacy services, we deliver architecture and implementation that supports long-term product evolution.',
    ],
    deliverables: [
      'REST/GraphQL API design and implementation',
      'Authentication, authorization, and security hardening',
      'Database schema design and query optimization',
      'Microservices and event-driven architecture',
      'Caching, queues, and background job systems',
      'Monitoring, observability, and reliability engineering',
    ],
    techStack: ['Node.js', 'Python', 'Java', 'PostgreSQL', 'MongoDB', 'Redis', 'Kafka'],
  },
  {
    id: 'ai',
    icon: 'ai',
    title: 'AI & Machine Learning Integration',
    color: 'from-emerald-500 to-teal-500',
    description: [
      'We integrate AI capabilities into your existing products or build AI-first features from scratch. From natural language processing to computer vision, we bring modern AI to your product.',
      'Our team stays at the forefront of AI research and applies proven techniques to real-world problems. We identify high-impact AI opportunities and deliver genuine business value.',
      'We prioritize responsible AI practices, ensuring transparency, fairness, and privacy in every implementation.',
    ],
    deliverables: [
      'Custom AI/ML model development and fine-tuning',
      'Natural Language Processing (NLP & LLMs)',
      'Computer Vision applications',
      'Predictive analytics and forecasting',
      'LLM integration (OpenAI, Anthropic, HuggingFace)',
      'Model deployment and MLOps monitoring',
    ],
    techStack: ['Python', 'TensorFlow', 'PyTorch', 'OpenAI', 'LangChain', 'Hugging Face'],
  },
  {
    id: 'consulting',
    icon: 'consulting',
    title: 'Tech Consulting',
    color: 'from-amber-500 to-orange-500',
    description: [
      'Sometimes you need an outside perspective. Our consultants provide expert guidance on technology strategy, architecture decisions, digital readiness, and practical technical education.',
      'For schools and institutions, TechMigos supports teacher training, technology orientation, technical field guidance, and motivational sessions that help educators and students use modern tools with confidence.',
      'Whether planning a migration, evaluating a stack, mentoring a team, or preparing teachers for digital classrooms, we bring clear guidance backed by real engineering practice.',
    ],
    deliverables: [
      'Technology stack assessment',
      'Architecture review and recommendations',
      'School teacher training workshops',
      'Curriculum and education technology orientation',
      'Technical field and career guidance sessions',
      'Motivational programs for teachers and students',
      'Institutional digital-readiness consulting',
      'Technical due diligence for M&A',
      'Code audit and quality analysis',
      'Performance optimization roadmap',
      'Team augmentation and mentoring',
    ],
    techStack: ['Technical Training', 'Education Technology', 'Architecture Patterns', 'System Design', 'Digital Readiness', 'Security Best Practices'],
  },
];

const faqs = [
  { question: 'How long does a typical project take?', answer: 'Timelines vary by scope. A landing site takes 4–6 weeks, a full-stack web app typically 3–6 months, and a mobile app 2–4 months. We\'ll give you a precise timeline during discovery.' },
  { question: 'What is your development process?', answer: 'We follow agile sprints (2 weeks), with regular standups, demos, and full transparency via project management tools. You\'ll always know where we stand.' },
  { question: 'Do you offer ongoing support after launch?', answer: 'Yes! We offer maintenance plans covering bug fixes, security updates, feature additions, and dedicated support. We want to be your long-term tech partner.' },
  { question: 'Can you work with our existing team?', answer: 'Absolutely. We frequently augment teams with specialized skills and integrate seamlessly with your existing workflows and tools.' },
  { question: 'Do you provide teacher training or school technology guidance?', answer: 'Yes. Our consulting work includes teacher workshops, technical field guidance, digital classroom readiness, and motivational sessions for schools and education teams.' },
  { question: 'How do you handle scope changes?', answer: 'We use a structured change request process — all scope changes are documented, priced, and approved before work begins. Zero surprises.' },
  { question: 'What technologies do you specialize in?', answer: 'Our core strengths include React/Next.js, Node.js, Python, AWS/GCP, and mobile with React Native and Flutter. We stay current with AI/ML tooling.' },
  { question: 'Do you sign NDAs?', answer: 'Yes, always. We sign NDAs before any detailed discussions. Your IP and business ideas are treated with strict confidentiality.' },
  { question: 'What are your payment terms?', answer: 'Typically: 30% upfront, 30% at design approval, 40% at launch. For larger projects, we can structure milestone-based payments.' },
];
const serviceLabels: Record<string, string> = {
  web: 'Web', mobile: 'Mobile', desktop: 'Desktop', qa: 'Testing', backend: 'Backend', ai: 'AI integration', consulting: 'Consulting',
};
const bestFit: Record<string, string> = {
  web: 'Storefronts, customer portals, and tools that teams use in a browser.',
  mobile: 'Products that people need on the go, on Android or iOS.',
  desktop: 'Specialized workflows that benefit from a dedicated computer application.',
  qa: 'Teams preparing for launch or trying to prevent recurring defects.',
  backend: 'Products that need reliable APIs, integrations, or a new data foundation.',
  ai: 'Workflows with a clear task to assist and a way to evaluate the results.',
  consulting: 'Teams and institutions weighing a technical decision or planning training.',
};
---

<BaseLayout
  title="Software Development Services in Hyderabad"
  ogImage="/images/og/services.png"
  description="TechMigos offers web, mobile and desktop development, QA automation, backend engineering, AI/ML integration, consulting, and technical training."
>
  <!-- HERO -->
  <section class="service-hero pt-32 pb-12 sm:pt-36 sm:pb-16 relative overflow-hidden">
    <div class="container-custom relative z-10">
      <nav class="mb-8 reveal" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2 text-sm">
          <li><a href="/" class="text-gray-500 hover:text-primary-600 transition-colors">Home</a></li>
          <li class="text-gray-300">/</li>
          <li class="text-primary-600 font-semibold">Services</li>
        </ol>
      </nav>
      <div class="grid gap-8 lg:grid-cols-[1.35fr_1fr] lg:items-end">
        <div class="max-w-3xl">
          <span class="section-eyebrow">What we build</span>
          <h1 class="text-4xl sm:text-6xl font-extrabold text-gray-900 mb-5 leading-tight tracking-tight">
            Software development services
          </h1>
          <p class="text-lg sm:text-xl text-gray-600 leading-relaxed max-w-[47ch]">
            Build a website, app, or desktop tool. Bring us in to test a release, improve your backend, or work through a technical decision.
          </p>
        </div>
        <nav class="service-chooser" aria-label="Choose a starting point">
          <p>What are you working on?</p>
          <a href="#web">Building a new product <span aria-hidden="true">↘</span></a>
          <a href="#qa">Improving an existing product <span aria-hidden="true">↘</span></a>
          <a href="#consulting">Making a technical decision <span aria-hidden="true">↘</span></a>
        </nav>
      </div>
    </div>
  </section>

  <!-- SERVICE QUICK LINKS -->
  <div class="sticky top-20 z-40 bg-white/80 backdrop-blur-xl border-b border-gray-100 shadow-sm">
    <div class="container-custom py-3">
      <nav aria-label="Service sections" class="service-nav flex gap-2 overflow-x-auto py-1">
        {services.map(s => (
          <a
            href={`#${s.id}`}
            class="flex-shrink-0 flex min-h-11 items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium text-gray-600 hover:text-primary-600 hover:bg-primary-50 transition-colors whitespace-nowrap"
          >
            <ServiceIcon name={s.icon} class="w-4 h-4" /> {serviceLabels[s.id]}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <!-- SERVICES CONTENT -->
  <section class="py-16 bg-white">
    <div class="container-custom">
      <div class="space-y-12 sm:space-y-20">
        {services.map((service) => (
          <article id={service.id} class="service-detail scroll-mt-40">
            <!-- Section header -->
            <div class="flex items-start gap-4 sm:gap-6 mb-6 sm:mb-9 reveal">
              <div class={`size-12 sm:size-16 rounded-2xl bg-gradient-to-br ${service.color} flex items-center justify-center shadow-sm flex-shrink-0`}>
                <ServiceIcon name={service.icon} class="size-6 sm:size-8 text-white" />
              </div>
              <div>
                <h2 class="text-2xl sm:text-4xl font-bold text-gray-900">{service.title}</h2>
                <p class="mt-2 text-sm sm:text-base text-gray-600"><strong class="text-primary-800">Best fit.</strong> {bestFit[service.id]}</p>
              </div>
            </div>

            <div class="grid lg:grid-cols-5 gap-7 lg:gap-12">
              <!-- Description -->
              <div class="lg:col-span-3 space-y-4 reveal-left">
                {service.description.map(para => (
                  <p class="text-gray-600 leading-relaxed">{para}</p>
                ))}

                <!-- Tech Stack -->
                <div class="pt-4">
                  <h3 class="font-bold text-gray-900 mb-3 text-sm uppercase tracking-wider">Tech Stack</h3>
                  <div class="flex flex-wrap gap-2">
                    {service.techStack.map(tech => (
                      <span class="tech-badge">{tech}</span>
                    ))}
                  </div>
                </div>

                <div class="pt-4">
                  <a href={`/contact?service=${service.id}`} class="btn-primary inline-flex items-center shine-hover group">
                    Discuss {serviceLabels[service.id].toLowerCase()}
                    <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </a>
                </div>
              </div>

              <!-- Deliverables card -->
              <div class="lg:col-span-2 reveal-right">
                <div class="bg-[#f7f5ff] rounded-2xl p-5 sm:p-7 border border-indigo-100">
                  <h3 class="font-bold text-gray-900 mb-5 flex items-center gap-2">
                    <span class="w-5 h-5 rounded-full flex items-center justify-center text-white text-xs" style="background: linear-gradient(135deg,#4F46E5,#06B6D4)">✓</span>
                    What We Deliver
                  </h3>
                  <ul class="space-y-3">
                    {service.deliverables.map(item => (
                      <li class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-primary-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span class="text-gray-700 text-sm">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">FAQ</span>
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Frequently Asked Questions</h2>
        <p class="text-gray-500 max-w-2xl mx-auto">Everything you need to know before starting your project.</p>
      </div>

      <div class="max-w-3xl mx-auto space-y-3">
        {faqs.map((faq) => (
          <details name="service-faq" class="service-faq bg-white rounded-2xl border border-gray-200">
            <summary class="px-5 sm:px-7 py-4 text-left flex items-center justify-between gap-4 group">
              <span class="font-semibold text-gray-900 group-hover:text-primary-600 transition-colors">{faq.question}</span>
              <span aria-hidden="true" class="faq-icon w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center transition-transform duration-300 flex-shrink-0">
                <svg class="w-4 h-4 text-gray-500 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </span>
            </summary>
            <p class="text-gray-600 px-5 sm:px-7 pb-6 leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- RELATED -->
  <section class="py-12 bg-white">
    <div class="container-custom">
      <nav aria-label="Related pages" class="grid gap-6 md:grid-cols-2">
        <a href="/work" class="block rounded-2xl border border-gray-200 p-6 hover:border-primary-300 transition-colors">
          <span class="text-sm font-semibold text-primary-600">See the work</span>
          <span class="block mt-2 text-xl font-bold text-gray-900">Products we have shipped for clients</span>
        </a>
        <a href="/blog" class="block rounded-2xl border border-gray-200 p-6 hover:border-primary-300 transition-colors">
          <span class="text-sm font-semibold text-primary-600">Read the blog</span>
          <span class="block mt-2 text-xl font-bold text-gray-900">Guides on planning websites, apps and desktop software</span>
        </a>
      </nav>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 animate-gradient-shift" style="background: linear-gradient(135deg,#2563eb,#0ea5e9,#06b6d4,#2563eb); background-size:300% 300%;"></div>
    <div class="container-custom relative z-10 text-center reveal">
      <h2 class="text-4xl sm:text-5xl font-extrabold text-white mb-6">Ready to start your project?</h2>
      <p class="text-xl text-white/80 mb-10 max-w-2xl mx-auto">Free consultation, no commitment required. Let's see what we can build together.</p>
      <a href="/contact" class="inline-flex items-center justify-center px-10 py-4 bg-white text-primary-700 font-bold rounded-xl hover:-translate-y-1 transition-[box-shadow,transform] duration-300 shadow-2xl text-lg shine-hover">
        Schedule a Consultation
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
})} />
</BaseLayout>

<style>
  .service-hero { background: radial-gradient(ellipse at 92% 20%, #ded9ff 0, transparent 58%), #f5f4ff; }
  .service-chooser { background: #ffffffbd; border: 1px solid #d9d3fa; border-radius: 1rem; padding: 1rem 1.15rem; }
  .service-chooser p { margin-bottom: .35rem; color: #4b3a91; font-size: .85rem; font-weight: 750; }
  .service-chooser a { display: flex; justify-content: space-between; align-items: center; gap: .8rem; min-height: 2.75rem; padding-block: .5rem; border-top: 1px solid #e2ddf8; color: #26204d; font-weight: 650; }
  .service-chooser a:hover { color: #4f35b3; }
  .service-nav { scrollbar-width: thin; scrollbar-color: #bfb2ec transparent; }
  .service-nav a[aria-current="location"] { color: #4427a7; background: #eee8ff; }
  .service-detail { min-width: 0; border-bottom: 1px solid #e8e3f6; padding-bottom: clamp(2rem, 5vw, 4rem); }
  .service-detail:last-child { padding-bottom: 0; border-bottom: 0; }
  .service-faq summary { cursor: pointer; list-style: none; }
  .service-faq summary::-webkit-details-marker { display: none; }
  .service-faq[open] .faq-icon { transform: rotate(180deg); }
  :is(.service-chooser a, .service-faq summary):focus-visible { outline: 2px solid #4f35b3; outline-offset: 3px; }
  .service-nav a:focus-visible { outline: 2px solid #4f35b3; outline-offset: -2px; }
</style>

<script>
  let stopServiceNav: (() => void) | undefined;

  function initServiceNav() {
    const nav = document.querySelector<HTMLElement>('.service-nav');
    if (!nav || stopServiceNav) return;
    const articles = [...document.querySelectorAll<HTMLElement>('.service-detail')];
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
    let frame = 0;
    let current: HTMLAnchorElement | undefined;

    function update() {
      frame = 0;
      const threshold = nav!.getBoundingClientRect().bottom + 24;
      const visible = articles.findLast(article => article.getBoundingClientRect().top <= threshold);
      const next = links.find(link => link.hash === '#' + visible?.id);
      if (next === current) return;
      current?.removeAttribute('aria-current');
      current = next;
      current?.setAttribute('aria-current', 'location');
      if (!next) return;
      const bounds = next.getBoundingClientRect();
      const rail = nav!.getBoundingClientRect();
      if (bounds.left < rail.left) nav!.scrollLeft -= rail.left - bounds.left;
      else if (bounds.right > rail.right) nav!.scrollLeft += bounds.right - rail.right;
    }

    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    stopServiceNav = () => {
      removeEventListener('scroll', schedule);
      removeEventListener('resize', schedule);
      cancelAnimationFrame(frame);
      stopServiceNav = undefined;
    };
    schedule();
  }

  initServiceNav();
  document.addEventListener('astro:page-load', initServiceNav);
  document.addEventListener('astro:before-swap', () => stopServiceNav?.());
</script>
