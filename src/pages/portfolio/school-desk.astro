---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/portfolio/focus/HeroSection.astro';
import FeatureGrid from '../../components/portfolio/focus/FeatureGrid.astro';
import TrustCards from '../../components/portfolio/focus/TrustCards.astro';
import FinalCta from '../../components/portfolio/focus/FinalCta.astro';

const appName = 'SchoolDesk';
const webUrl = '/showcase'; // This will point to the integrated app showcase
const androidUrl = '#'; // Placeholder for play store

const features = [
  {
    icon: '01',
    title: 'Multi-Stakeholder Dashboards',
    description: 'Personalized views for Admins, Teachers, Parents, and Students to focus on what matters.',
  },
  {
    icon: '02',
    title: 'Financial Management',
    description: 'Track fee collections, generate receipts, and manage expenses with real-time reporting.',
  },
  {
    icon: '03',
    title: 'Academic Excellence',
    description: 'Attendance tracking, homework assignments, and test results with instant progress insights.',
  },
  {
    icon: '04',
    title: 'Communication Hub',
    description: 'Instant alerts for circulars, events, and direct messaging between parents and teachers.',
  },
  {
    icon: '05',
    title: 'Resource Library',
    description: 'Share PDFs, videos, and notes across subjects for seamless digital learning.',
  },
  {
    icon: '06',
    title: 'Rapid Deployment',
    description: 'Go live in 30 minutes. Designed for easy onboarding without complex training.',
  },
];

const trustItems = [
  {
    quote: 'SchoolDesk has completely digitized our operations. The financial tracking alone saved us hours of manual work every week.',
    name: 'Administrator',
    role: 'Global Heritage School',
  },
  {
    quote: 'As a teacher, the ability to take attendance and assign homework in seconds is a game changer. I can focus more on teaching.',
    name: 'Senior Faculty',
    role: 'Greenwood Academy',
  },
  {
    quote: 'Staying updated on my child\'s progress and paying fees from my phone has made my life much easier.',
    name: 'Parent',
    role: 'Active School Member',
  },
];
---

<BaseLayout
  title="SchoolDesk"
  description="SchoolDesk case study: A comprehensive school management platform digitizing academics, finance, and communication."
  ogImage="/images/portfolio/school-desk/cover-schooldesk.webp"
  ogType="article"
>
  <HeroSection
    appName={appName}
    eyebrow="School Operations Platform"
    tagline="One platform for every stakeholder. Digitize your school's academics, finance, and communication in 30 minutes."
    heroImage="/images/school-desk-logo.png"
    webUrl={webUrl}
    androidUrl={androidUrl}
    primaryLabel="Open Interactive Showcase"
    supportText="Role-based workflows for administrators, teachers, parents, and students, supported by operational dashboards and live showcase access."
  />

  <section class="py-20 bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">The Complete School Ecosystem</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Replacing scattered spreadsheets and WhatsApp groups with a unified, intelligent dashboard.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100 hover:shadow-xl transition-shadow duration-300">
          <div class="w-12 h-12 bg-primary-100 text-primary-600 rounded-xl flex items-center justify-center mb-6">
             <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">For Administrators</h3>
          <p class="text-gray-600 mb-4">Live summary of fee collections, attendance, and staff activity. Multi-branch management from a single login.</p>
          <ul class="text-sm text-gray-500 space-y-2">
            <li class="flex items-center gap-2">✓ QR Visitor Management</li>
            <li class="flex items-center gap-2">✓ Custom Roles & Permissions</li>
            <li class="flex items-center gap-2">✓ Automated Cloud Backups</li>
          </ul>
        </div>

        <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100 hover:shadow-xl transition-shadow duration-300">
          <div class="w-12 h-12 bg-accent-100 text-accent-600 rounded-xl flex items-center justify-center mb-6">
             <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">For Teachers</h3>
          <p class="text-gray-600 mb-4">Take attendance in 30 seconds, assign homework, and track progress without administrative overhead.</p>
          <ul class="text-sm text-gray-500 space-y-2">
            <li class="flex items-center gap-2">✓ Offline Attendance Support</li>
            <li class="flex items-center gap-2">✓ Auto-Grading Tools</li>
            <li class="flex items-center gap-2">✓ Resource Library Sharing</li>
          </ul>
        </div>

        <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100 hover:shadow-xl transition-shadow duration-300">
          <div class="w-12 h-12 bg-green-100 text-green-600 rounded-xl flex items-center justify-center mb-6">
             <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">For Parents</h3>
          <p class="text-gray-600 mb-4">Real-time alerts, fee payments, and academic tracking for their children directly from their mobile phone.</p>
          <ul class="text-sm text-gray-500 space-y-2">
            <li class="flex items-center gap-2">✓ Smart Event Notifications</li>
            <li class="flex items-center gap-2">✓ Direct Teacher Communication</li>
            <li class="flex items-center gap-2">✓ Fee Status Tracking</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-900 text-white overflow-hidden">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="section-eyebrow text-primary-400">Live Experience</span>
          <h2 class="text-4xl font-bold mt-4 mb-6">Experience the Dashboard</h2>
          <p class="text-gray-400 text-lg mb-8">
            We've integrated the full SchoolDesk showcase application. Explore every feature, role-based view, and management tool in a live interactive environment.
          </p>
          <a href={webUrl} class="inline-flex items-center justify-center px-8 py-3 bg-primary-600 text-white font-bold rounded-xl hover:bg-primary-700 transition-colors duration-300">
            Open Interactive Showcase
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </div>
        <div class="relative">
           <div class="aspect-video bg-slate-800 rounded-3xl border border-slate-700 shadow-2xl overflow-hidden relative group">
              <img src="https://img.rocket.new/generatedImages/rocket_gen_img_1f5404807-1769365502162.png" alt="SchoolDesk Dashboard Overview" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
              <div class="absolute inset-0 bg-slate-900/40 flex items-center justify-center">
                 <div class="w-16 h-16 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center border border-white/30">
                    <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path></svg>
                 </div>
              </div>
           </div>
        </div>
      </div>
    </div>
  </section>

  <FeatureGrid
    features={features}
    title="Built for Multi-Role School Operations"
    description="A full-stack platform model covering administration, academics, finance, communication, and resource workflows across school stakeholders."
  />

  <TrustCards
    items={trustItems}
    title="Validated Across School Roles"
  />

  <FinalCta
    webUrl={webUrl}
    androidUrl={androidUrl}
    title="Explore SchoolDesk Live"
    description="Open the integrated showcase to review the role-based product flow and school management feature set."
    primaryLabel="Open Interactive Showcase"
  />

  <section class="bg-slate-100 py-8">
    <div class="container-custom flex flex-col items-center justify-between gap-3 text-sm text-slate-600 sm:flex-row">
      <p class="font-semibold text-slate-800">SchoolDesk by TechMigos</p>
      <div class="flex items-center gap-4">
        <a href="/portfolio" class="hover:text-primary-700">All Projects</a>
        <a href="/contact" class="hover:text-primary-700">Start Similar Build</a>
      </div>
    </div>
  </section>
</BaseLayout>
