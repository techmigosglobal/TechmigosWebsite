---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/portfolio/focus/HeroSection.astro';
import ShowcaseCarousel from '../../components/portfolio/focus/ShowcaseCarousel.astro';
import FeatureGrid from '../../components/portfolio/focus/FeatureGrid.astro';
import ScrollStoryDemo from '../../components/portfolio/focus/ScrollStoryDemo.astro';
import TrustCards from '../../components/portfolio/focus/TrustCards.astro';
import FinalCta from '../../components/portfolio/focus/FinalCta.astro';

const appName = 'Focus Today';
const webUrl = 'https://crii-focus-today.web.app';
const androidUrl = 'https://play.google.com/store/apps/details?id=com.eagletv.eagle_tv';

const showcaseSlides = [
  {
    src: '/images/portfolio/focus-today/screenshots/focus-today-feed-census.png',
    alt: 'Focus Today feed screen showing a Census 2027 civic post',
    title: 'Civic Feed',
    caption: 'Public-interest posts combine clear media, engagement actions, tags, and story summaries.',
    displayClass: 'focus-today-showcase-poster',
  },
  {
    src: '/images/portfolio/focus-today/screenshots/focus-today-article-feed.png',
    alt: 'Focus Today article feed with regional language story content',
    title: 'Article Feed',
    caption: 'Long-form stories stay readable with headline, local language body copy, and quick actions.',
    displayClass: 'focus-today-showcase-poster',
  },
  {
    src: '/images/portfolio/focus-today/screenshots/focus-today-bank-fraud.png',
    alt: 'Focus Today feed screen showing bank fraud news post',
    title: 'Image Posts',
    caption: 'Visual posts support strong news imagery while preserving summary and category context.',
    displayClass: 'focus-today-showcase-poster',
  },
  {
    src: '/images/portfolio/focus-today/screenshots/focus-today-reporter-workspace.png',
    alt: 'Focus Today reporter workspace with content creation options',
    title: 'Reporter Workspace',
    caption: 'Content teams can move from creation to pending and rejected post queues quickly.',
    displayClass: 'focus-today-showcase-poster',
  },
  {
    src: '/images/portfolio/focus-today/screenshots/focus-today-notifications.png',
    alt: 'Focus Today notifications screen with new post alerts',
    title: 'Notification Center',
    caption: 'Grouped alerts make new posts and activity easier to scan without leaving the app.',
    displayClass: 'focus-today-showcase-poster',
  },
];

const features = [
  {
    icon: '01',
    title: 'Multilingual UX',
    description: 'Language-first onboarding and navigation built for regional audience accessibility.',
  },
  {
    icon: '02',
    title: 'Content + PDF Cards',
    description: 'Structured feed cards support text updates, image media, and PDF-centric civic material.',
  },
  {
    icon: '03',
    title: 'Realtime Delivery',
    description: 'Firebase-backed pipelines keep stories and alerts synchronized across active devices.',
  },
  {
    icon: '04',
    title: 'Trusted Auth Flow',
    description: 'Phone OTP and platform-verification pathways designed for stable sign-in completion.',
  },
  {
    icon: '05',
    title: 'Notification Ready',
    description: 'Push and group notifications are integrated to support ongoing public communication.',
  },
  {
    icon: '06',
    title: 'Operational Settings',
    description: 'Preferences for theme, language, and feed behavior reduce friction in daily usage.',
  },
];

const storySteps = [
  {
    image: '/images/portfolio/focus-today/screenshots/focus-today-feed-census.png',
    alt: 'Focus Today civic feed screen',
    title: 'Publishable Feed',
    description: 'The feed gives every post a clear hierarchy: media first, headline next, then context and actions.',
  },
  {
    image: '/images/portfolio/focus-today/screenshots/focus-today-notifications.png',
    alt: 'Focus Today notifications list screen',
    title: 'Activity Awareness',
    description: 'Notification screens keep new post alerts visible and organized for frequent civic updates.',
  },
  {
    image: '/images/portfolio/focus-today/screenshots/focus-today-reporter-workspace.png',
    alt: 'Focus Today reporter workspace screen',
    title: 'Editorial Workspace',
    description: 'Reporter tools keep creation, review queues, and rejected posts close to the publishing workflow.',
  },
];

const trustItems = [
  {
    quote: 'The app experience now feels structured and reliable for day-to-day publishing operations.',
    name: 'Community Editorial Team',
    role: 'Product Stakeholders',
  },
  {
    quote: 'Multilingual access and mobile-first readability made local content easier to consume.',
    name: 'Field Distribution Group',
    role: 'Regional Coordinators',
  },
  {
    quote: 'Deployment across web and Android gave us a practical way to validate behavior on live devices.',
    name: 'Delivery Engineering Team',
    role: 'Implementation Review',
  },
];
---

<BaseLayout
  title="Focus Today Civic News Case Study"
  description="Focus Today case study: a Flutter + Firebase civic news product with multilingual onboarding, realtime feed delivery, and live web/android access."
  ogImage="/images/portfolio/focus-today/cover-screenshots.webp"
  ogType="article"
>
  <HeroSection
    appName={appName}
    tagline="A community-first civic news application connecting people with verified local updates, emergency alerts, and public meeting information."
    heroImage="/images/portfolio/focus-today/screenshots/focus-today-feed-census.png"
    webUrl={webUrl}
    androidUrl={androidUrl}
    supportText="Verified local updates, multilingual content, notification workflows, and civic engagement screens in one mobile experience."
  />

  <ShowcaseCarousel
    slides={showcaseSlides}
    title="Real Product Screens From the Focus Today App"
    description="The case study now uses the uploaded app screenshots for the feed, discovery, meetings, settings, notifications, and regional content states."
  />

  <FeatureGrid
    features={features}
    title="Built for Fast Civic Publishing"
    description="A practical mobile architecture focused on clear publishing flows, regional language access, notifications, and stable day-to-day operation."
  />

  <ScrollStoryDemo steps={storySteps} webUrl={webUrl} androidUrl={androidUrl} />

  <TrustCards items={trustItems} />

  <FinalCta webUrl={webUrl} androidUrl={androidUrl} />

  <section class="bg-slate-100 py-8">
    <div class="container-custom flex flex-col items-center justify-between gap-3 text-sm text-slate-600 sm:flex-row">
      <p class="font-semibold text-slate-800">Focus Today by TechMigos</p>
      <div class="flex items-center gap-4">
        <a href="/portfolio" class="hover:text-primary-700">All Projects</a>
        <a href="/contact" class="hover:text-primary-700">Start Similar Build</a>
      </div>
    </div>
  </section>
</BaseLayout>
