---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested TechMigos page could not be found. Browse services, portfolio work, or contact the team." noIndex>
  <section class="min-h-[70vh] border-b border-slate-200 bg-slate-50 pt-40">
    <div class="container-custom grid gap-10 pb-20 lg:grid-cols-[minmax(0,1fr),18rem] lg:items-end">
      <div class="max-w-3xl"><p class="text-xs font-bold uppercase tracking-[0.16em] text-primary-700">404 · Page not found</p><h1 class="mt-5 text-5xl font-extrabold tracking-[-0.06em] text-slate-950 sm:text-7xl">This route does not lead anywhere.</h1><p class="mt-7 max-w-2xl text-xl leading-8 text-slate-600">The page may have moved or the address may be incomplete. Start from a trusted public route below.</p></div>
      <div class="grid gap-3"><a href="/services" class="btn-primary">Explore services <span aria-hidden="true">→</span></a><a href="/portfolio" class="btn-secondary">Browse product work</a><a href="/contact" class="btn-link">Contact TechMigos</a></div>
    </div>
  </section>
</BaseLayout>
