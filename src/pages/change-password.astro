---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Set portal password | TechMigos" noIndex={true}>
  <main class="min-h-screen bg-slate-100 px-4 py-16">
    <section class="mx-auto max-w-md rounded-2xl border border-slate-200 bg-white p-7 shadow-sm sm:p-9">
      <p class="text-xs font-black uppercase tracking-[0.16em] text-emerald-700">Secure your account</p>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-950">Set a new password</h1>
      <p class="mt-2 text-sm leading-6 text-slate-500">Use at least eight characters with uppercase, lowercase, a number, and a symbol.</p>
      <form id="change-password-form" class="mt-7 space-y-5">
        <label class="block"><span class="form-label">New password</span><input class="form-input form-control" name="password" type="password" required minlength="8" autocomplete="new-password" /></label>
        <label class="block"><span class="form-label">Confirm password</span><input class="form-input form-control" name="confirm_password" type="password" required minlength="8" autocomplete="new-password" /></label>
        <button id="change-password-button" class="btn-primary w-full justify-center" type="submit">Save password</button>
        <p id="change-password-status" class="min-h-[1.25rem] text-sm text-slate-600" role="status" aria-live="polite"></p>
      </form>
    </section>
  </main>
  <script is:inline>
    const form = document.getElementById('change-password-form');
    const status = document.getElementById('change-password-status');
    const button = document.getElementById('change-password-button');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const password = String(data.get('password') || '');
      if (password !== String(data.get('confirm_password') || '')) {
        status.textContent = 'Passwords do not match.';
        status.classList.add('text-rose-600');
        return;
      }
      button.disabled = true;
      status.textContent = 'Saving password...';
      try {
        const { data: result, error } = await window.tmSupabase.functions.invoke('admin-users', { body: { operation: 'change_initial_password', password } });
        if (error || result?.error) throw new Error(result?.error || error.message);
        const { data: profile } = await window.tmSupabase.from('crm_profiles').select('role').eq('auth_user_id', (await window.tmSupabase.auth.getUser()).data.user.id).single();
        status.textContent = 'Password saved. Opening your workspace...';
        window.location.replace(profile?.role === 'client' ? '/client' : '/company');
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Could not save password.';
        status.classList.add('text-rose-600');
      } finally {
        button.disabled = false;
      }
    });
  </script>
</BaseLayout>
