---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthField from '../components/auth/AuthField.astro';
import AuthStatus from '../components/auth/AuthStatus.astro';
---

<BaseLayout title="Set portal password | TechMigos" noIndex={true}>
  <section class="min-h-screen bg-slate-100 px-4 py-16">
    <section class="mx-auto max-w-md rounded-2xl border border-slate-200 bg-white p-7 shadow-sm sm:p-9">
      <p class="text-xs font-black uppercase tracking-[0.16em] text-emerald-700">Secure your account</p>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-950">Set a new password</h1>
      <p class="mt-2 text-sm leading-6 text-slate-500">Use at least eight characters with uppercase, lowercase, a number, and a symbol.</p>
      <form id="change-password-form" class="mt-7 space-y-5">
        <AuthField id="new-password" name="password" label="New password" type="password" required minLength={8} autocomplete="new-password" />
        <AuthField id="confirm-password" name="confirm_password" label="Confirm password" type="password" required minLength={8} autocomplete="new-password" />
        <button id="change-password-button" class="btn-primary w-full justify-center" type="submit">Save password</button>
        <AuthStatus id="change-password-status" />
      </form>
    </section>
  </section>
  <script is:inline>
    const form = document.getElementById('change-password-form');
    const status = document.getElementById('change-password-status');
    const button = document.getElementById('change-password-button');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const password = String(data.get('password') || '');
      if (password !== String(data.get('confirm_password') || '')) {
        status.className = 'auth-status min-h-[1.25rem] text-sm text-rose-600';
        status.textContent = 'Passwords do not match.';
        return;
      }
      if (password.length < 8 || !/[a-z]/.test(password) || !/[A-Z]/.test(password) || !/\d/.test(password) || !/[^A-Za-z0-9]/.test(password)) {
        status.className = 'auth-status min-h-[1.25rem] text-sm text-rose-600';
        status.textContent = 'Use at least eight characters with uppercase, lowercase, a number, and a symbol.';
        return;
      }
      button.disabled = true;
      status.className = 'auth-status min-h-[1.25rem] text-sm text-slate-600';
      status.textContent = 'Saving password...';
      try {
        if (!window.tmSupabase) throw new Error('Auth client not ready. Please refresh the page.');
        const { data: userData, error: userError } = await window.tmSupabase.auth.getUser();
        if (userError || !userData?.user) throw new Error('This password link is no longer active. Request a new one.');
        const { data: profile, error: profileError } = await window.tmSupabase
          .from('crm_profiles')
          .select('role, status, must_change_password')
          .eq('auth_user_id', userData.user.id)
          .maybeSingle();
        if (profileError || !profile || !['active', 'pending'].includes(profile.status)) throw new Error('Portal access is not available for this account.');

        if (profile.must_change_password) {
          const { data: result, error } = await window.tmSupabase.functions.invoke('admin-users', { body: { operation: 'change_initial_password', password } });
          if (error || result?.error) throw new Error(result?.error || error.message);
        } else {
          const { error } = await window.tmSupabase.auth.updateUser({ password });
          if (error) throw error;
        }
        status.textContent = 'Password saved. Opening your workspace...';
        window.location.replace(profile?.role === 'client' ? '/client' : '/company');
      } catch (error) {
        status.className = 'auth-status min-h-[1.25rem] text-sm text-rose-600';
        status.textContent = error instanceof Error ? error.message : 'Could not save password.';
      } finally {
        button.disabled = false;
      }
    });
  </script>
</BaseLayout>
