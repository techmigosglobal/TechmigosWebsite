---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';

const milestones = [
  {
    need: 'Clarity First',
    title: 'Remove Ambiguity Early',
    moment: 'Discovery before delivery',
    description: 'We begin by mapping goals, constraints, risks, and assumptions before implementation starts.',
    impact: 'A shared plan makes the next decision easier to evaluate.',
  },
  {
    need: 'Speed to Value',
    title: 'Ship Useful Value Quickly',
    moment: 'Useful increments',
    description: 'We shape work into focused releases so teams can validate the most important parts of a product early.',
    impact: 'Feedback can inform what is built next.',
  },
  {
    need: 'Quality as a Standard',
    title: 'Protect Every Release',
    moment: 'Release discipline',
    description: 'Testing, review, and reliability checks are built into the delivery process.',
    impact: 'Each release has a clear quality checkpoint.',
  },
  {
    need: 'Scale‑Ready Delivery',
    title: 'Built to Grow',
    moment: 'Long-term thinking',
    description: 'We consider maintainability, performance, and operational needs while shaping the architecture.',
    impact: 'The technical direction stays visible as the product evolves.',
  },
  {
    need: 'Transparent Collaboration',
    title: 'Trust Through Visibility',
    moment: 'Visible collaboration',
    description: 'Shared documentation, demos, and direct communication keep project context accessible.',
    impact: 'Everyone can see the decisions behind the work.',
  },
  {
    need: 'Measurable Outcomes',
    title: 'Impact Over Activity',
    moment: 'Intentional priorities',
    description: 'We connect planned work to the product or business question it is meant to answer.',
    impact: 'Activity is easier to assess against a stated purpose.',
  },
];

const values = [
  { icon: 'innovation', title: 'Innovation First', description: 'We push boundaries and embrace new technologies that create real, measurable value for clients.' },
  { icon: 'collaboration', title: 'Deep Collaboration', description: 'Great outcomes happen when diverse, talented minds work together toward a shared purpose.' },
  { icon: 'transparency', title: 'Radical Transparency', description: 'Open communication and honest feedback build the trust that fuels long-term partnerships.' },
  { icon: 'quality', title: 'Uncompromising Quality', description: 'We obsess over every detail because the smallest things matter most to users.' },
  { icon: 'agility', title: 'True Agility', description: 'Fast iteration and adaptability let us respond to change and market shifts with confidence.' },
  { icon: 'impact', title: 'Meaningful Impact', description: 'Every project we take on must make a real difference — for clients, users, and the world.' },
];

const technologies = [
  { name: 'React', category: 'Frontend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg' },
  { name: 'Next.js', category: 'Frontend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nextjs/nextjs-original.svg' },
  { name: 'Vue.js', category: 'Frontend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vuejs/vuejs-original.svg' },
  { name: 'TypeScript', category: 'Frontend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg' },
  { name: 'Node.js', category: 'Backend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg' },
  { name: 'Python', category: 'Backend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg' },
  { name: 'C++', category: 'Backend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/cplusplus/cplusplus-original.svg' },
  { name: 'Rust', category: 'Backend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/rust/rust-original.svg' },
  { name: 'Kotlin', category: 'Mobile', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kotlin/kotlin-original.svg' },
  { name: 'Swift', category: 'Mobile', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/swift/swift-original.svg' },
  { name: 'Flutter', category: 'Mobile', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/flutter/flutter-original.svg' },
  { name: 'React Native', category: 'Mobile', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg' },
  { name: 'PostgreSQL', category: 'Database', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg' },
  { name: 'MySQL', category: 'Database', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg' },
  { name: 'Redis', category: 'Database', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/redis/redis-original.svg' },
  { name: 'Perl', category: 'Backend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/perl/perl-original.svg' },
  { name: 'Docker', category: 'DevOps', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg' },
  { name: 'Figma', category: 'Design', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/figma/figma-original.svg' },
  { name: 'TensorFlow', category: 'AI/ML', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tensorflow/tensorflow-original.svg' },
];

---

<BaseLayout
  title="About TechMigos Software Studio"
  description="Learn about TechMigos, our approach to product delivery, and the technologies we use to build digital products."
>
  <!-- ========================================
       HERO
       ======================================== -->
  <section id="about-hero" class="section-surface section-surface-mist section-spotlight pt-36 pb-20 relative overflow-hidden">
    <canvas class="section-neural-canvas" data-network-canvas data-particle-count="42"></canvas>
    <div class="section-orb -top-40 -right-40 w-96 h-96 bg-primary-100"></div>
    <div class="section-orb -bottom-20 -left-20 w-72 h-72 bg-accent-100 opacity-45"></div>
    <div class="container-custom relative z-10">
      <div class="max-w-3xl">
        <div class="reveal">
          <span class="section-eyebrow">About Us</span>
        </div>
        <h1 class="reveal stagger-1 text-5xl sm:text-6xl font-extrabold text-gray-900 mb-6 leading-tight">
          We're engineers, designers &<br>
          <span class="text-gradient">dreamers</span>
        </h1>
        <p class="reveal stagger-2 text-xl text-gray-500 max-w-2xl leading-relaxed">
          We help teams turn practical product ideas into considered, scalable digital experiences.
        </p>
        <div class="reveal stagger-3 mt-8 flex items-center gap-6">
          <a href="/contact" class="btn-primary shine-hover">Work With Us</a>
          <a href="/careers" class="btn-ghost">Join Our Team</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================
       MISSION & VISION
       ======================================== -->
  <section id="about-mission" class="section-surface section-surface-glow section-spotlight section-padding">
    <canvas class="section-neural-canvas opacity-35" data-network-canvas data-particle-count="30"></canvas>
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-20 items-center">
        <div class="reveal-left">
          <span class="section-eyebrow">Our Mission</span>
          <h2 class="text-4xl font-bold text-gray-900 mb-6 leading-tight">
            To empower every business with <span class="text-gradient">thoughtful technology</span>
          </h2>
          <p class="text-gray-600 leading-relaxed mb-6 text-lg">
            We believe useful technology starts with a clear idea and a thoughtful implementation plan. Our mission is to bridge the gap between product intent and delivery.
          </p>
          <p class="text-gray-600 leading-relaxed mb-8">
            Every project we take on is an opportunity to create something meaningful. We're not just building features — we're building foundations for lasting growth.
          </p>
          <div class="grid grid-cols-3 gap-6">
            {[
              { val: 'Discover', label: 'Plan Clearly' },
              { val: 'Build', label: 'Ship Reliably' },
              { val: 'Improve', label: 'Iterate Fast' },
            ].map(s => (
              <div class="text-center p-4 rounded-2xl bg-white/80 border border-primary-100 shadow-sm lift-panel">
                <div class="text-2xl font-black text-primary-600">{s.val}</div>
                <div class="text-sm text-gray-500 mt-1">{s.label}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="relative reveal-right">
          <div class="absolute inset-0 bg-gradient-to-br from-primary-300 to-accent-300 rounded-3xl transform rotate-3 opacity-20 animate-morph"></div>
          <img
            src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&h=600&fit=crop"
            alt="Team collaboration"
            class="relative rounded-3xl shadow-2xl object-cover w-full"
            loading="lazy"
            width="800"
            height="600"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================
       TIMELINE
       ======================================== -->
  <section id="about-timeline" class="section-surface section-surface-mist section-spotlight section-padding">
    <canvas class="section-neural-canvas opacity-30" data-network-canvas data-particle-count="28"></canvas>
    <div class="container-custom">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow">Our Journey</span>
        <h2 class="text-4xl font-bold text-gray-900 mb-4">How We Evolved</h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">The delivery principles we use to turn an idea into a clear, maintainable product direction.</p>
      </div>

      <div class="max-w-3xl mx-auto">
        <div class="relative">
          {milestones.map((milestone, index) => (
            <div class={`relative pl-16 pb-12 last:pb-0 reveal stagger-${Math.min(index + 1, 6)}`}>
              {/* Vertical line */}
              {index !== milestones.length - 1 && (
                <div class="absolute left-5 top-6 bottom-0 w-0.5 bg-gradient-to-b from-primary-300 to-primary-100"></div>
              )}
              {/* Dot */}
              <div class="absolute left-0 top-1 w-10 h-10 rounded-full flex items-center justify-center text-white text-xs font-bold shadow-lg animate-pulse-glow" style="background: linear-gradient(135deg,#4F46E5,#06B6D4)"></div>
              {/* Card */}
              <div class="bg-white/88 backdrop-blur-sm rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-xl hover:border-primary-100 transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-1">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-primary-50 text-primary-700 text-xs font-semibold mb-2">{milestone.need}</span>
                <h3 class="text-xl font-bold text-gray-900 mb-2">{milestone.title}</h3>
                <p class="text-sm text-gray-500 italic mb-3">{milestone.moment}</p>
                <p class="text-gray-600 text-sm leading-relaxed">{milestone.description}</p>
                <p class="text-sm text-gray-500 mt-3">{milestone.impact}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================
       VALUES
       ======================================== -->
  <section id="about-values" class="section-surface section-surface-dark section-spotlight section-padding">
    <canvas class="section-neural-canvas opacity-35" data-network-canvas data-particle-count="34"></canvas>
    <div class="section-orb top-0 left-8 w-80 h-80 bg-cyan-300/25"></div>
    <div class="section-orb bottom-0 right-12 w-96 h-96 bg-indigo-300/20"></div>
    <div class="container-custom">
      <div class="text-center mb-16 reveal">
        <span class="section-eyebrow" style="color:#a5b4fc; background: rgba(165,180,252,0.1); border-color: rgba(165,180,252,0.2);">Our Values</span>
        <h2 class="text-4xl font-bold text-white mb-4">What We Stand For</h2>
        <p class="text-indigo-200 max-w-2xl mx-auto">The principles that guide every decision we make and every line of code we write.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {values.map((value, i) => (
          <div class={`group p-7 rounded-2xl border border-white/10 hover:border-primary-400/40 bg-white/6 hover:bg-white/12 backdrop-blur-sm transition-[background-color,border-color,transform] duration-300 hover:-translate-y-1 stagger-${i + 1} reveal`}>
            <div class="w-12 h-12 rounded-xl mb-5 flex items-center justify-center text-2xl" style="background: rgba(255,255,255,0.1)">
              {value.icon === 'innovation' && '💡'}
              {value.icon === 'collaboration' && '🤝'}
              {value.icon === 'transparency' && '🔍'}
              {value.icon === 'quality' && '✨'}
              {value.icon === 'agility' && '⚡'}
              {value.icon === 'impact' && '🌍'}
            </div>
            <h3 class="text-lg font-bold text-white mb-2">{value.title}</h3>
            <p class="text-indigo-200 text-sm leading-relaxed">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       TECHNOLOGIES
       ======================================== -->
  <section id="about-tech" class="section-surface section-surface-glow section-spotlight section-padding bg-white relative overflow-hidden">
    <canvas class="section-neural-canvas opacity-32" data-network-canvas data-particle-count="36"></canvas>
    <div class="absolute inset-0" aria-hidden="true">
      <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full blur-3xl bg-gradient-to-br from-primary-100/70 to-accent-100/60"></div>
      <div class="absolute -bottom-24 -left-24 w-80 h-80 rounded-full blur-3xl bg-gradient-to-tr from-amber-100/60 to-rose-100/60"></div>
    </div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="section-eyebrow">Tech Stack</span>
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Technologies We Master</h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">A living toolkit we sharpen with every build — chosen for speed, reliability, and long‑term clarity.</p>
      </div>

      <div class="tech-icon-wall reveal" role="list" aria-label="Technology icons">
        {technologies.map((tech) => (
          <button class="tech-icon-item group" type="button" role="listitem" aria-label={`${tech.name} - ${tech.category}`}>
            <span class="tech-icon-badge">
              <img src={tech.icon} alt={tech.name} class="tech-icon-img" loading="lazy" width="28" height="28" />
            </span>
            <span class="tech-icon-name">{tech.name}</span>
            <span class="tech-icon-tooltip">{tech.name} · {tech.category}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       CTA
       ======================================== -->
  <section id="about-cta" class="section-surface section-spotlight py-24 relative overflow-hidden">
    <div class="absolute inset-0 animate-gradient-shift" style="background: linear-gradient(135deg, #2563eb, #0ea5e9, #06b6d4, #2563eb); background-size: 300% 300%;"></div>
    <div class="container-custom relative z-10 text-center reveal">
      <h2 class="text-4xl sm:text-5xl font-extrabold text-white mb-6">Join us in building the future</h2>
      <p class="text-xl text-white/80 mb-10 max-w-2xl mx-auto">
        Explore current opportunities or start a conversation about your next product.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/careers" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white/50 text-white font-bold rounded-xl hover:bg-white/10 hover:border-white transition-[background-color,border-color] duration-300 text-lg">
          View Open Positions
        </a>
        <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary-700 font-bold rounded-xl hover:-translate-y-1 transition-[box-shadow,transform] duration-300 shadow-xl text-lg shine-hover">
          Get in Touch
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tech-icon-wall {
    position: relative;
    max-width: 980px;
    margin-inline: auto;
  }

  .tech-icon-item {
    background: rgba(255, 255, 255, 0.58);
    border-radius: 20px;
    padding: 16px 12px 14px;
    border: 1px solid rgba(148, 163, 184, 0.18);
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    backdrop-filter: blur(10px);
  }

  .tech-icon-item:hover,
  .tech-icon-item:focus-visible {
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.12);
    border-color: rgba(37, 99, 235, 0.22);
  }
</style>

<script>
  const aboutReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const aboutFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const aboutCleanups: Array<() => void> = [];

  function addAboutCleanup(cleanup: () => void) {
    aboutCleanups.push(cleanup);
  }

  function cleanupAboutPage() {
    while (aboutCleanups.length > 0) {
      aboutCleanups.pop()?.();
    }
  }

  if (!aboutReducedMotion) {
    document.querySelectorAll<HTMLElement>('.section-spotlight').forEach((section) => {
      if (!aboutFinePointer) return;

      const updateSpotlight = (event: PointerEvent) => {
        const rect = section.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) return;

        section.style.setProperty('--spotlight-x', `${((event.clientX - rect.left) / rect.width) * 100}%`);
        section.style.setProperty('--spotlight-y', `${((event.clientY - rect.top) / rect.height) * 100}%`);
      };

      section.classList.add('is-interactive');
      section.addEventListener('pointermove', updateSpotlight, { passive: true });
      addAboutCleanup(() => {
        section.removeEventListener('pointermove', updateSpotlight);
        section.classList.remove('is-interactive');
      });
    });

    document.querySelectorAll<HTMLCanvasElement>('[data-network-canvas]').forEach((canvasEl) => {
      const section = canvasEl.closest<HTMLElement>('section');
      const context = canvasEl.getContext('2d');
      if (!section || !context) return;

      const configuredParticleCount = Number(canvasEl.dataset.particleCount ?? '30');
      const particleCount = Number.isFinite(configuredParticleCount)
        ? Math.max(0, Math.floor(configuredParticleCount))
        : 30;
      const particles = Array.from({ length: particleCount }, () => ({
        x: 0,
        y: 0,
        vx: (Math.random() - 0.5) * 0.28,
        vy: (Math.random() - 0.5) * 0.28,
        r: Math.random() * 1.8 + 0.9,
      }));

      let width = 0;
      let height = 0;
      let animationFrameId: number | undefined;
      let isActive = true;

      const resizeCanvas = () => {
        width = canvasEl.width = section.clientWidth;
        height = canvasEl.height = section.clientHeight;
        particles.forEach((particle) => {
          if (!particle.x || particle.x > width) particle.x = Math.random() * width;
          if (!particle.y || particle.y > height) particle.y = Math.random() * height;
        });
      };

      const drawCanvas = () => {
        if (!isActive) return;

        context.clearRect(0, 0, width, height);
        context.fillStyle = section.id === 'about-values' ? 'rgba(125, 211, 252, 0.40)' : 'rgba(13, 148, 136, 0.28)';
        context.strokeStyle = section.id === 'about-values' ? 'rgba(255, 255, 255, 0.11)' : 'rgba(37, 99, 235, 0.07)';

        for (let i = 0; i < particles.length; i++) {
          const particle = particles[i];
          if (!particle) continue;
          particle.x += particle.vx;
          particle.y += particle.vy;

          if (particle.x < 0 || particle.x > width) particle.vx *= -1;
          if (particle.y < 0 || particle.y > height) particle.vy *= -1;
          particle.x = Math.max(0, Math.min(width, particle.x));
          particle.y = Math.max(0, Math.min(height, particle.y));

          context.beginPath();
          context.arc(particle.x, particle.y, particle.r, 0, Math.PI * 2);
          context.fill();

          for (let j = i + 1; j < particles.length; j++) {
            const particleB = particles[j];
            if (!particleB) continue;
            const dx = particle.x - particleB.x;
            const dy = particle.y - particleB.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 118) {
              context.beginPath();
              context.lineWidth = (1 - dist / 118) * 0.75;
              context.moveTo(particle.x, particle.y);
              context.lineTo(particleB.x, particleB.y);
              context.stroke();
            }
          }
        }

        animationFrameId = window.requestAnimationFrame(drawCanvas);
      };

      const resizeObserver = typeof ResizeObserver === 'undefined'
        ? undefined
        : new ResizeObserver(resizeCanvas);
      resizeObserver?.observe(section);
      resizeCanvas();
      drawCanvas();
      window.addEventListener('resize', resizeCanvas, { passive: true });
      addAboutCleanup(() => {
        isActive = false;
        if (animationFrameId !== undefined) window.cancelAnimationFrame(animationFrameId);
        resizeObserver?.disconnect();
        window.removeEventListener('resize', resizeCanvas);
        context.clearRect(0, 0, width, height);
        canvasEl.width = 0;
        canvasEl.height = 0;
      });
    });
  }

  window.addEventListener('pagehide', cleanupAboutPage, { once: true });
  document.addEventListener('astro:before-swap', cleanupAboutPage, { once: true });
</script>
