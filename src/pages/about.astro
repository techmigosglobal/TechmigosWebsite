---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';

const enterpriseMetrics = [
  {
    value: '45+',
    counter: '45+',
    label: 'Enterprise & Scaleup Deployments',
    description: 'Production-grade web, mobile, and cloud platforms shipped on schedule.',
    highlight: '100% Delivery Success',
  },
  {
    value: '99.98%',
    counter: '99.98%',
    label: 'Average System Availability',
    description: 'Fault-tolerant distributed architectures built for high-throughput concurrency.',
    highlight: 'Tier-1 Reliability',
  },
  {
    value: '< 14 Days',
    counter: '14 Days',
    label: 'Discovery to Technical Blueprint',
    description: 'Rapid validation, threat modeling, and prototype verification before sprint build.',
    highlight: 'De-Risked Velocity',
  },
  {
    value: '0',
    counter: '0',
    label: 'Critical Vulnerability Tolerance',
    description: 'Automated CI/CD security scanning, static code analysis, and ISO/SOC2 rigor.',
    highlight: 'DevSecOps Standards',
  },
];

const pillars = [
  {
    id: 'cloud',
    badge: 'Enterprise Architecture',
    title: 'Cloud Systems & Distributed Infrastructure',
    description: 'Engineered for high concurrency, sub-second latency, and horizontal scalability across multi-cloud environments (AWS, GCP, Azure).',
    capabilities: [
      'Microservices & Event-Driven Topologies',
      'High-Throughput REST, GraphQL & gRPC APIs',
      'Zero-Downtime CI/CD & Infrastructure as Code',
      'Database Optimization & Redis Caching Layers',
    ],
    iconSvg: `<svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>`,
  },
  {
    id: 'web',
    badge: 'Digital Platforms',
    title: 'High-Impact Web Applications & Portals',
    description: 'Modern frontend ecosystems designed with Astro, Next.js, and React for lightning-fast Core Web Vitals, enterprise security, and seamless user experiences.',
    capabilities: [
      'High-Performance Modern Web Architectures',
      'Micro-Frontends & Design Token Systems',
      'Strict WCAG 2.1 AA Accessibility & Global SEO',
      'Real-Time Collaboration & State Synchronization',
    ],
    iconSvg: `<svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
  },
  {
    id: 'mobile',
    badge: 'Omnichannel Mobility',
    title: 'Cross-Platform Mobile & Desktop Suites',
    description: 'Native iOS/Android, Flutter, and cross-platform desktop applications engineered for fluid 60fps interaction and secure enterprise sync.',
    capabilities: [
      'Native Swift/Kotlin & Flutter Ecosystems',
      'Robust Offline-First Data Synchronization',
      'Biometric Security & Hardware Telemetry',
      'Cross-Platform Windows, macOS & Linux Tools',
    ],
    iconSvg: `<svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>`,
  },
  {
    id: 'ai',
    badge: 'Cognitive Automation',
    title: 'Applied AI & Autonomous Agent Workflows',
    description: 'Pragmatic AI integration that embeds intelligent agent pipelines, custom RAG architectures, and predictive analytics into core operational workflows.',
    capabilities: [
      'Domain-Specific LLM & Agentic Workflows',
      'Secure Vector Embeddings & Hybrid RAG Retrieval',
      'Automated Document Processing & Extraction',
      'Real-Time Predictive Intelligence & Telemetry',
    ],
    iconSvg: `<svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  },
];

const governancePhases = [
  {
    phase: '01',
    name: 'Discovery & Threat Modeling',
    focus: 'Clarity Over Assumption',
    description: 'We deconstruct business logic, map integration boundaries, and conduct risk modeling before committing sprint capital.',
    deliverable: 'Architecture Decision Record (ADR), threat model, and interactive specification.',
  },
  {
    phase: '02',
    name: 'Thin-Slice Prototyping',
    focus: 'Rapid Validation',
    description: 'We build functional, end-to-end technical slices early to validate concurrency benchmarks, data schemas, and user workflows.',
    deliverable: 'Clickable prototype, proven data contracts, and stakeholder alignment.',
  },
  {
    phase: '03',
    name: 'Rigorous Sprint Engineering',
    focus: 'DevSecOps & Reliability',
    description: 'Bi-weekly sprint iterations accompanied by automated unit, integration, and E2E test suites with zero regression tolerance.',
    deliverable: 'Production-ready candidate builds with comprehensive test pass reports.',
  },
  {
    phase: '04',
    name: 'Zero-Downtime Rollout & SLA',
    focus: 'Production Stewardship',
    description: 'Seamless cutovers, blue/green deployments, real-time APM telemetry, and dedicated post-launch SLA support.',
    deliverable: 'Automated monitoring dashboards, runbooks, and enterprise operational handoff.',
  },
];

const values = [
  {
    title: 'Architectural Rigor',
    description: 'We write clean, modular, self-documenting code with zero shortcuts on test coverage and maintainability.',
    icon: `<svg class="w-6 h-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
  },
  {
    title: 'Fiduciary Stewardship',
    description: 'We treat client capital, cloud infrastructure budgets, and production uptime with the diligence of equity partners.',
    icon: `<svg class="w-6 h-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
  },
  {
    title: 'Radical Transparency',
    description: 'No opaque sprint blockers. Shared live repositories, verifiable build artifacts, and weekly executive telemetry.',
    icon: `<svg class="w-6 h-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>`,
  },
  {
    title: 'DevSecOps by Default',
    description: 'Security is embedded into every commit through automated dependency scanning, static code analysis, and role gating.',
    icon: `<svg class="w-6 h-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>`,
  },
  {
    title: 'High-Velocity Cadence',
    description: 'Two-week sprint cadences delivering tangible, demonstrable increments that accelerate your go-to-market advantage.',
    icon: `<svg class="w-6 h-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  },
  {
    title: 'Measurable Commercial ROI',
    description: 'We hold ourselves accountable to commercial metrics—customer conversion, compute efficiency, and user retention.',
    icon: `<svg class="w-6 h-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
  },
];

const technologies = [
  { name: 'React', category: 'Frontend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg' },
  { name: 'Next.js', category: 'Frontend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nextjs/nextjs-original.svg' },
  { name: 'Vue.js', category: 'Frontend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vuejs/vuejs-original.svg' },
  { name: 'TypeScript', category: 'Frontend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg' },
  { name: 'Node.js', category: 'Backend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg' },
  { name: 'Python', category: 'Backend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg' },
  { name: 'C++', category: 'Backend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/cplusplus/cplusplus-original.svg' },
  { name: 'Rust', category: 'Backend', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/rust/rust-original.svg' },
  { name: 'Kotlin', category: 'Mobile', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kotlin/kotlin-original.svg' },
  { name: 'Swift', category: 'Mobile', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/swift/swift-original.svg' },
  { name: 'Flutter', category: 'Mobile', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/flutter/flutter-original.svg' },
  { name: 'React Native', category: 'Mobile', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg' },
  { name: 'PostgreSQL', category: 'Database', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg' },
  { name: 'MySQL', category: 'Database', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg' },
  { name: 'Redis', category: 'Database', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/redis/redis-original.svg' },
  { name: 'Docker', category: 'DevOps', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg' },
  { name: 'Figma', category: 'Design', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/figma/figma-original.svg' },
  { name: 'TensorFlow', category: 'AI/ML', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tensorflow/tensorflow-original.svg' },
];
---

<BaseLayout
  title="About TechMigos | Enterprise Software Engineering & Digital Advisory"
  ogImage="/images/og/about.png"
  description="TechMigos delivers enterprise digital engineering, cloud architecture, and high-performance product platforms. Learn about our leadership, governance, and technology stack."
>
  <!-- ========================================
       HERO: ENTERPRISE MNC CALIBER
       ======================================== -->
  <section id="about-hero" class="section-surface section-surface-mist section-spotlight pt-36 pb-20 relative overflow-hidden">
    <canvas class="section-neural-canvas" data-network-canvas data-particle-count="48"></canvas>
    <div class="section-orb -top-40 -right-40 w-96 h-96 bg-primary-100"></div>
    <div class="section-orb -bottom-20 -left-20 w-80 h-80 bg-accent-100 opacity-45"></div>

    <div class="container-custom relative z-10">
      <div class="max-w-4xl">
        <div class="reveal">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase bg-primary-50 text-primary-700 border border-primary-200/80 shadow-sm mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Global Software Studio & Digital Advisory
          </span>
        </div>
        <h1 class="reveal stagger-1 text-4xl sm:text-6xl font-black text-gray-900 mb-6 leading-[1.12] tracking-tight">
          Engineering Mission-Critical Platforms for <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 via-indigo-600 to-cyan-600">
            Ambitious Global Enterprises
          </span>.
        </h1>
        <p class="reveal stagger-2 text-lg sm:text-xl text-gray-600 max-w-3xl leading-relaxed mb-8">
          TechMigos partners with forward-thinking enterprises and fast-scaling innovators to architect, engineer, and deploy high-concurrency digital platforms. We unite deep technical rigor, modern cloud paradigms, and human-centric design to transform complexity into sustained commercial momentum.
        </p>

        <div class="reveal stagger-3 flex flex-wrap items-center gap-4 mb-12">
          <a href="/contact" class="btn-primary shine-hover shadow-lg shadow-primary-500/25 px-7 py-3.5 text-base rounded-xl font-semibold">
            Consult Our Engineering Leads <span class="ml-2">→</span>
          </a>
          <a href="/work" class="btn-ghost px-7 py-3.5 text-base rounded-xl font-semibold bg-white/70 backdrop-blur-sm">
            Review Case Studies
          </a>
        </div>

        <!-- Trust Badges Bar -->
        <div class="reveal stagger-4 pt-6 border-t border-gray-200/80 flex flex-wrap items-center gap-6 text-xs sm:text-sm font-medium text-gray-600">
          <span class="flex items-center gap-2">
            <span class="text-blue-600 font-bold">✓</span> SOC2 & ISO-Aligned Rigor
          </span>
          <span class="flex items-center gap-2">
            <span class="text-blue-600 font-bold">✓</span> 99.98% High-Availability SLA
          </span>
          <span class="flex items-center gap-2">
            <span class="text-blue-600 font-bold">✓</span> Dedicated Multi-Disciplinary Pods
          </span>
          <span class="flex items-center gap-2">
            <span class="text-blue-600 font-bold">✓</span> Global Delivery & Clear Governance
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================
       ENTERPRISE IMPACT TELEMETRY (METRICS)
       ======================================== -->
  <section id="about-metrics" class="py-16 bg-white border-y border-slate-100 relative">
    <div class="container-custom">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {enterpriseMetrics.map((item, index) => (
          <div class={`p-7 rounded-2xl bg-gradient-to-b from-white to-slate-50 border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-primary-300 transition-[box-shadow,border-color,transform] duration-300 hover:-translate-y-1 tilt-card reveal stagger-${index + 1}`}>
            <div class="text-xs font-bold tracking-wider uppercase text-primary-600 mb-2">{item.highlight}</div>
            <div class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight mb-2" data-counter={item.counter}>
              {item.value}
            </div>
            <div class="text-base font-bold text-gray-800 mb-1">{item.label}</div>
            <p class="text-sm text-gray-500 leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       CORE CAPABILITIES / MNC PILLARS
       ======================================== -->
  <section id="about-pillars" class="section-surface section-surface-glow section-spotlight section-padding">
    <canvas class="section-neural-canvas opacity-30" data-network-canvas data-particle-count="32"></canvas>
    <div class="container-custom relative z-10">
      <div class="max-w-3xl mb-16 reveal">
        <span class="section-eyebrow">Enterprise Capabilities</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mt-3 mb-4 leading-tight">
          Engineered for Performance, Resilience & Scalability
        </h2>
        <p class="text-lg text-gray-600 leading-relaxed">
          We do not deliver superficial code or fragile templates. Our engineering pods design resilient systems engineered to withstand exponential transaction growth and stringent enterprise security audits.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {pillars.map((pillar, idx) => (
          <div class={`p-8 rounded-3xl bg-white/90 backdrop-blur-md border border-slate-200/90 shadow-sm hover:shadow-2xl hover:border-primary-400 transition-all duration-300 group tilt-card reveal stagger-${idx + 1}`}>
            <div class="flex items-start justify-between gap-4 mb-6">
              <div class="w-14 h-14 rounded-2xl bg-primary-50 border border-primary-100 flex items-center justify-center text-primary-600 group-hover:scale-110 group-hover:bg-primary-600 group-hover:text-white transition-all duration-300 shadow-sm" set:html={pillar.iconSvg}></div>
              <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                {pillar.badge}
              </span>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-3 group-hover:text-primary-600 transition-colors">
              {pillar.title}
            </h3>
            <p class="text-sm sm:text-base text-gray-600 leading-relaxed mb-6">
              {pillar.description}
            </p>

            <div class="pt-6 border-t border-slate-100">
              <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Core Technical Capabilities</div>
              <ul class="space-y-2.5">
                {pillar.capabilities.map((cap) => (
                  <li class="flex items-center gap-2.5 text-sm text-gray-700 font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary-600"></span>
                    {cap}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       GOVERNANCE & DELIVERY FRAMEWORK
       ======================================== -->
  <section id="about-governance" class="section-surface section-surface-mist section-spotlight section-padding">
    <canvas class="section-neural-canvas opacity-25" data-network-canvas data-particle-count="28"></canvas>
    <div class="container-custom relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-16 reveal">
        <span class="section-eyebrow">Delivery Governance</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mt-3 mb-4">
          A Predictable, Risk-Engineered Delivery Operating Model
        </h2>
        <p class="text-lg text-gray-600">
          How enterprise organizations scale software without surprises. Every engagement follows structured milestones, transparent telemetry, and verified automated checks.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {governancePhases.map((phase, i) => (
          <div class={`p-7 rounded-2xl bg-white/90 border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-primary-300 transition-all duration-300 hover:-translate-y-1 reveal stagger-${i + 1}`}>
            <div class="flex items-center justify-between mb-4">
              <span class="text-2xl font-black text-primary-600 font-mono">{phase.phase}</span>
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-primary-50 text-primary-700 border border-primary-100">{phase.focus}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{phase.name}</h3>
            <p class="text-sm text-gray-600 leading-relaxed mb-4">{phase.description}</p>
            <div class="pt-4 border-t border-slate-100 text-xs text-gray-500 font-medium">
              <strong class="text-gray-800">Outcome:</strong> {phase.deliverable}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       VALUES: ENTERPRISE STEWARDSHIP (DARK SECTION)
       ======================================== -->
  <section id="about-values" class="section-surface section-surface-dark section-spotlight section-padding">
    <canvas class="section-neural-canvas opacity-35" data-network-canvas data-particle-count="36"></canvas>
    <div class="section-orb top-0 left-8 w-80 h-80 bg-cyan-400/20"></div>
    <div class="section-orb bottom-0 right-12 w-96 h-96 bg-indigo-500/20"></div>
    <div class="container-custom relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-16 reveal">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider text-cyan-300 bg-cyan-900/30 border border-cyan-500/30">
          ✦ Core Operating Values
        </span>
        <h2 class="text-3xl sm:text-5xl font-black text-white mt-4 mb-4">
          What Sets Our Engineering Apart
        </h2>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          The foundational principles that govern every pull request, architectural decision record, and client partnership.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {values.map((value, i) => (
          <div class={`group p-8 rounded-2xl border border-white/10 hover:border-cyan-400/40 bg-white/[0.05] hover:bg-white/[0.09] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 reveal stagger-${i + 1}`}>
            <div class="w-12 h-12 rounded-xl mb-6 flex items-center justify-center bg-cyan-500/10 border border-cyan-400/20 group-hover:scale-110 group-hover:border-cyan-400/50 transition-all duration-300" set:html={value.icon}></div>
            <h3 class="text-xl font-bold text-white mb-2.5">{value.title}</h3>
            <p class="text-slate-300 text-sm leading-relaxed">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       TECHNOLOGIES & PLATFORMS
       ======================================== -->
  <section id="about-tech" class="section-surface section-surface-glow section-spotlight section-padding bg-white relative overflow-hidden">
    <canvas class="section-neural-canvas opacity-30" data-network-canvas data-particle-count="36"></canvas>
    <div class="absolute inset-0" aria-hidden="true">
      <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full blur-3xl bg-gradient-to-br from-primary-100/70 to-accent-100/60"></div>
      <div class="absolute -bottom-24 -left-24 w-80 h-80 rounded-full blur-3xl bg-gradient-to-tr from-amber-100/60 to-rose-100/60"></div>
    </div>
    <div class="container-custom relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="section-eyebrow">Technology Portfolio</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mt-3 mb-4">
          World-Class Stacks for Scaled Systems
        </h2>
        <p class="text-base sm:text-lg text-gray-600 max-w-2xl mx-auto">
          We leverage modern, type-safe, and high-performance stacks selected for velocity, production resilience, and ecosystem longevity.
        </p>
      </div>

      <div class="tech-icon-wall reveal" role="list" aria-label="Technology icons">
        {technologies.map((tech) => (
          <button class="tech-icon-item group" type="button" role="listitem" aria-label={`${tech.name} - ${tech.category}`}>
            <span class="tech-icon-badge">
              <img
                src={tech.icon}
                alt={tech.name}
                class="tech-icon-img"
                loading="lazy"
                width="28"
                height="28"
                onerror={`this.onerror=null; this.src='data:image/svg+xml,%3Csvg xmlns=\\'http://www.w3.org/2000/svg\\' viewBox=\\'0 0 28 28\\'%3E%3Ccircle cx=\\'14\\' cy=\\'14\\' r=\\'12\\' fill=\\'%236366f1\\' opacity=\\'0.15\\'/%3E%3Ctext x=\\'14\\' y=\\'18\\' font-family=\\'system-ui\\' font-size=\\'10\\' font-weight=\\'bold\\' fill=\\'%234f46e5\\' text-anchor=\\'middle\\'%3E${encodeURIComponent(tech.name.substring(0, 2))}%3C/text%3E%3C/svg%3E'`}
              />
            </span>
            <span class="tech-icon-name">{tech.name}</span>
            <span class="tech-icon-tooltip">{tech.name} · {tech.category}</span>
