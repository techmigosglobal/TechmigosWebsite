<style>
  .tech-icon-wall {
    position: relative;
    max-width: 980px;
    margin-inline: auto;
  }

  .tech-icon-item {
    background: rgba(255, 255, 255, 0.58);
    border-radius: 20px;
    padding: 16px 12px 14px;
    border: 1px solid rgba(148, 163, 184, 0.18);
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    backdrop-filter: blur(10px);
  }

  .tech-icon-item:hover,
  .tech-icon-item:focus-visible {
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.12);
    border-color: rgba(37, 99, 235, 0.22);
  }
</style>

<script>
  const initAbout = () => {
    const aboutReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const aboutFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (!aboutReducedMotion) {
      document.querySelectorAll('.section-spotlight').forEach((section) => {
        if (!(section instanceof HTMLElement)) return;
        if (!aboutFinePointer) return;
        section.classList.add('is-interactive');
        section.addEventListener('pointermove', (event) => {
          const pointerEvent = event as PointerEvent;
          const rect = section.getBoundingClientRect();
          section.style.setProperty('--spotlight-x', `${((pointerEvent.clientX - rect.left) / rect.width) * 100}%`);
          section.style.setProperty('--spotlight-y', `${((pointerEvent.clientY - rect.top) / rect.height) * 100}%`);
        }, { passive: true });
      });

      document.querySelectorAll('[data-network-canvas]').forEach((canvasEl) => {
        if (!(canvasEl instanceof HTMLCanvasElement)) return;
        const section = canvasEl.closest('section');
        const context = canvasEl.getContext('2d');
        if (!(section instanceof HTMLElement) || !context) return;
        const networkCanvas = canvasEl as HTMLCanvasElement;
        const canvasSection = section;
        const canvasContext = context;

        const particleCount = Number(canvasEl.dataset.particleCount || 30);
        const particles = Array.from({ length: particleCount }, () => ({
          x: 0,
          y: 0,
          vx: (Math.random() - 0.5) * 0.28,
          vy: (Math.random() - 0.5) * 0.28,
          r: Math.random() * 1.8 + 0.9,
        }));

        let width = 0;
        let height = 0;

        function resizeCanvas() {
          width = networkCanvas.width = canvasSection.clientWidth;
          height = networkCanvas.height = canvasSection.clientHeight;
          particles.forEach((particle) => {
            if (!particle.x || particle.x > width) particle.x = Math.random() * width;
            if (!particle.y || particle.y > height) particle.y = Math.random() * height;
          });
        }

        function drawCanvas() {
          canvasContext.clearRect(0, 0, width, height);
          canvasContext.fillStyle = canvasSection.id === 'about-values' ? 'rgba(125, 211, 252, 0.40)' : 'rgba(13, 148, 136, 0.28)';
          canvasContext.strokeStyle = canvasSection.id === 'about-values' ? 'rgba(255, 255, 255, 0.11)' : 'rgba(37, 99, 235, 0.07)';

          for (let i = 0; i < particles.length; i++) {
            const particle = particles[i];
            if (!particle) continue;
            particle.x += particle.vx;
            particle.y += particle.vy;

            if (particle.x < 0 || particle.x > width) particle.vx *= -1;
            if (particle.y < 0 || particle.y > height) particle.y *= -1;
            particle.x = Math.max(0, Math.min(width, particle.x));
            particle.y = Math.max(0, Math.min(height, particle.y));

            canvasContext.beginPath();
            canvasContext.arc(particle.x, particle.y, particle.r, 0, Math.PI * 2);
            canvasContext.fill();

            for (let j = i + 1; j < particles.length; j++) {
              const particleB = particles[j];
              if (!particleB) continue;
              const dx = particle.x - particleB.x;
              const dy = particle.y - particleB.y;
              const dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < 118) {
                canvasContext.beginPath();
                canvasContext.lineWidth = (1 - dist / 118) * 0.75;
                canvasContext.moveTo(particle.x, particle.y);
                canvasContext.lineTo(particleB.x, particleB.y);
                canvasContext.stroke();
              }
            }
          }

          requestAnimationFrame(drawCanvas);
        }

        resizeCanvas();
        drawCanvas();
        window.addEventListener('resize', resizeCanvas, { passive: true });
      });
    }
  };
  initAbout();
  document.addEventListener('astro:page-load', initAbout);
</script>
