---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="TechMigos Secure Portal Login"
  description="Secure TechMigos portal login for clients and company team members to access projects, support, invoices, leads, and CRM workflows."
  noIndex={true}
>
  <section class="min-h-screen pt-28 pb-16 bg-slate-950 text-white overflow-hidden">
    <div class="container-custom max-w-6xl">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_440px] lg:items-center">
        <div class="relative z-10">
          <span class="section-eyebrow text-cyan-300">TechMigos Portal</span>
          <h1 class="mt-5 max-w-3xl text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight">
            One login for project clients and TechMigos teams.
          </h1>
          <p class="mt-5 max-w-2xl text-base sm:text-lg text-slate-300 leading-relaxed">
            Sign in once and we will route your account to the right workspace: client projects, support and invoices, or the internal CRM for leads, follow-ups, sales and operations.
          </p>

          <div class="mt-8 grid gap-3 sm:grid-cols-2 max-w-3xl">
            <div class="rounded-lg border border-white/10 bg-white/5 p-4">
              <p class="text-sm font-bold text-white">Clients</p>
              <p class="mt-1 text-sm text-slate-300">View projects, invoices, and support tickets.</p>
            </div>
            <div class="rounded-lg border border-white/10 bg-white/5 p-4">
              <p class="text-sm font-bold text-white">TechMigos team</p>
              <p class="mt-1 text-sm text-slate-300">Manage CRM, leads, follow-ups, campaigns, and work activity.</p>
            </div>
          </div>
        </div>

        <div class="relative z-10 bg-white text-slate-950 rounded-lg p-5 sm:p-7 shadow-2xl border border-slate-200">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-2xl font-extrabold">Portal login</h2>
              <p class="mt-2 text-sm text-slate-500">Use the credentials provided by TechMigos.</p>
            </div>
            <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">Secure</span>
          </div>

          <form id="portal-login-form" class="mt-7 space-y-5">
            <label class="block" for="login-id">
              <span class="form-label">Username or email</span>
              <input id="login-id" name="login_id" type="text" required class="form-input form-control" autocomplete="username" placeholder="vinay or you@example.com" />
            </label>
            <label class="block" for="password">
              <span class="form-label">Password</span>
              <input id="password" name="password" type="password" required class="form-input form-control" autocomplete="current-password" placeholder="Enter your password" />
            </label>
            <button id="login-button" type="submit" class="btn-primary w-full justify-center min-h-[48px]">Login</button>
            <p id="login-status" class="text-sm text-slate-500 min-h-[1.25rem]" role="status" aria-live="polite"></p>
          </form>

          <div class="mt-5 border-t border-slate-100 pt-4">
            <p class="text-xs leading-relaxed text-slate-500">
              Accounts are invite-only. If you need access, contact your TechMigos project owner or email info@techmigos.com.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('portal-login-form');
    const statusEl = document.getElementById('login-status');
    const button = document.getElementById('login-button');

    function setStatus(message, isError) {
      statusEl.textContent = message || '';
      statusEl.className = `text-sm min-h-[1.25rem] ${isError ? 'text-red-600' : 'text-slate-500'}`;
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      setStatus('Signing in...', false);

      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const loginId = String(data.login_id || '').trim();
        const password = String(data.password || '');
        let email = loginId;

        if (!loginId.includes('@')) {
          const { data: resolvedEmail, error: rpcError } = await window.tmSupabase
            .rpc('get_email_by_username', { p_username: loginId });
          if (rpcError || !resolvedEmail) {
            throw new Error('Username not found. Please use your email address.');
          }
          email = resolvedEmail;
        }

        const { data: authData, error: authError } = await window.tmSupabase.auth.signInWithPassword({
          email,
          password,
        });

        if (authError) {
          throw new Error(authError.message === 'Invalid login credentials'
            ? 'Email or password is incorrect.'
            : authError.message);
        }

        const { data: profile } = await window.tmSupabase
          .from('crm_profiles')
          .select('role, name')
          .eq('auth_user_id', authData.user.id)
          .limit(1)
          .single();

        if (!profile) throw new Error('Portal access is not provisioned for this account.');

        await window.tmSupabase
          .from('crm_profiles')
          .update({ last_login: new Date().toISOString() })
          .eq('auth_user_id', authData.user.id);

        location.href = profile.role === 'client' ? '/client' : '/company';
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'Could not sign in.', true);
        button.disabled = false;
      }
    });
  </script>
</BaseLayout>
