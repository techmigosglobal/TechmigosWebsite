---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((candidate) => candidate.slug !== post.slug)
  .map((candidate) => {
    const sharedTags = candidate.data.tags.filter((tag: string) => post.data.tags.includes(tag)).length;
    const sameCategoryBonus = candidate.data.category === post.data.category ? 3 : 0;
    const score = sharedTags * 2 + sameCategoryBonus;
    return { candidate, score };
  })
  .filter((item) => item.score > 0)
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return b.candidate.data.pubDate.valueOf() - a.candidate.data.pubDate.valueOf();
  })
  .slice(0, 3)
  .map((item) => item.candidate);

const fallbackPosts = allPosts
  .filter((candidate) => candidate.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const finalRelatedPosts = relatedPosts.length > 0 ? relatedPosts : fallbackPosts;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: post.data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'TechMigos',
    logo: {
      '@type': 'ImageObject',
      url: 'https://techmigos.com/icon.png',
    },
  },
  image: post.data.heroImage || 'https://techmigos.com/og-image.png',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url.href,
  },
  keywords: post.data.tags.join(', '),
  articleSection: post.data.category,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.heroImage}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div id="progress-bar" class="fixed top-0 left-0 h-1 bg-primary-600 z-50" style="width: 0%"></div>

  <section class="pt-32 pb-12 bg-gray-50">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <nav class="mb-8" aria-label="Breadcrumb">
          <ol class="flex items-center space-x-2 text-sm text-gray-500">
            <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
            <li>/</li>
            <li><a href="/blog" class="hover:text-primary-600 transition-colors">Blog</a></li>
            <li>/</li>
            <li class="text-gray-900 truncate max-w-[220px]">{post.data.title}</li>
          </ol>
        </nav>

        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-3 py-1 bg-primary-50 text-primary-600 rounded-full text-sm font-semibold">
            {post.data.category}
          </span>
          {post.data.tags?.map((tag: string) => (
            <span class="px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-sm">
              {tag}
            </span>
          ))}
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-6 leading-tight">
          {post.data.title}
        </h1>

        <div class="flex items-center text-gray-500 text-sm flex-wrap gap-y-2">
          <img
            src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&h=100&fit=crop&crop=face"
            alt={post.data.author}
            class="w-10 h-10 rounded-full mr-3"
            loading="eager"
            width="40"
            height="40"
          />
          <span class="font-medium text-gray-900">{post.data.author}</span>
          <span class="mx-2">•</span>
          <span>{post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
          <span class="mx-2">•</span>
          <span>{post.data.readTime || 6} min read</span>
        </div>
      </div>
    </div>
  </section>

  {post.data.heroImage && (
    <section class="pb-12 bg-gray-50">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto">
          <img
            src={post.data.heroImage}
            alt={post.data.title}
            class="w-full rounded-2xl shadow-xl"
            loading="eager"
            width="1200"
            height="600"
          />
        </div>
      </div>
    </section>
  )}

  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="lg:grid lg:grid-cols-12 gap-12">
        <aside class="lg:col-span-3 hidden lg:block">
          <div class="sticky top-24 space-y-6">
            <div>
              <h4 class="font-semibold text-gray-900 mb-4">On this page</h4>
              <nav class="space-y-2" id="toc">
                {headings.map((heading: { depth: number; slug: string; text: string }) => (
                  <a
                    href={`#${heading.slug}`}
                    class={`block text-sm transition-colors hover:text-primary-600 ${
                      heading.depth === 3 ? 'pl-4' : ''
                    } text-gray-500`}
                  >
                    {heading.text}
                  </a>
                ))}
              </nav>
            </div>

            <div class="p-4 border border-gray-200 rounded-xl bg-gray-50">
              <h5 class="font-semibold text-gray-900 mb-2">Reading goal</h5>
              <p class="text-sm text-gray-600 mb-2">Finish this article and apply one idea today.</p>
              <p class="text-xs text-gray-500">Tip: save one code snippet and one career note before you leave.</p>
            </div>
          </div>
        </aside>

        <article class="lg:col-span-9 max-w-3xl">
          <div class="prose prose-lg prose-gray prose-headings:text-gray-900 prose-a:text-primary-600 prose-a:no-underline hover:prose-a:underline prose-code:bg-gray-100 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:text-primary-600 prose-pre:bg-gray-900 prose-pre:text-gray-100">
            <Content />
          </div>

          <div class="mt-12 pt-8 border-t border-gray-200">
            <h4 class="font-semibold text-gray-900 mb-4">Share this article</h4>
            <div class="flex flex-wrap gap-3">
              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(Astro.url.href)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-200 transition-colors"
              >
                Share on X
              </a>
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-200 transition-colors"
              >
                Share on LinkedIn
              </a>
              <button
                id="copy-link"
                class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-200 transition-colors"
              >
                Copy Link
              </button>
            </div>
          </div>

          <div class="mt-12 p-8 bg-gray-50 rounded-2xl">
            <div class="flex items-start gap-4">
              <img
                src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&h=100&fit=crop&crop=face"
                alt={post.data.author}
                class="w-16 h-16 rounded-full"
                loading="lazy"
                width="64"
                height="64"
              />
              <div>
                <h4 class="font-semibold text-gray-900">{post.data.author}</h4>
                <p class="text-gray-500 text-sm mb-2">{post.data.authorRole || 'Software Engineer & Mentor'}</p>
                <p class="text-gray-600 text-sm">{post.data.authorBio || 'Ravali writes practical engineering guides for students and developers, combining hands-on project stories, career lessons, and trend-focused technical research.'}</p>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gray-50">
    <div class="container-custom">
      <div class="flex items-center justify-between mb-8 flex-wrap gap-2">
        <h2 class="text-2xl font-bold text-gray-900">Related Articles</h2>
        <a href="/blog" class="text-primary-600 text-sm font-semibold hover:text-primary-700">View all posts</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {finalRelatedPosts.map((related) => (
          <a href={`/blog/${related.slug}`} class="block bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow">
            <img
              src={related.data.heroImage || 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=600&h=360&fit=crop'}
              alt={related.data.title}
              class="w-full h-40 object-cover"
              loading="lazy"
              width="600"
              height="360"
            />
            <div class="p-5">
              <p class="text-xs font-semibold text-primary-600 mb-2">{related.data.category}</p>
              <h3 class="font-bold text-gray-900 leading-snug mb-2">{related.data.title}</h3>
              <p class="text-sm text-gray-500 line-clamp-2">{related.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  window.addEventListener('scroll', () => {
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? (window.scrollY / docHeight) * 100 : 0;
    const progressBar = document.getElementById('progress-bar');
    if (progressBar) {
      progressBar.style.width = `${progress}%`;
    }
  });

  const copyBtn = document.getElementById('copy-link');
  copyBtn?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(window.location.href);
    if (copyBtn) {
      const originalText = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyBtn.textContent = originalText;
      }, 2000);
    }
  });

  document.querySelectorAll('#toc a').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const href = link.getAttribute('href') || '';
      const targetId = href.startsWith('#') ? href.slice(1) : '';
      const target = document.getElementById(targetId);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>
