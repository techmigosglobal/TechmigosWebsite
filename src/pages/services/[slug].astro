---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { services, serviceBySlug } from '../../data/services';

export const getStaticPaths = (() => services.map((service) => ({ params: { slug: service.slug } }))) satisfies GetStaticPaths;

const slug = Astro.params.slug as keyof typeof serviceBySlug;
const service = serviceBySlug[slug];

if (!service) Astro.response.status = 404;
---

<BaseLayout
  title={service ? service.title : 'Service not found'}
  description={service ? `${service.summary} Explore TechMigos' approach, typical deliverables, and next steps.` : 'The requested TechMigos service could not be found.'}
>
  {service ? (
    <>
      <section class="border-b border-slate-200 bg-slate-50 pt-32 sm:pt-40">
        <div class="container-custom pb-14 sm:pb-20">
          <nav aria-label="Breadcrumb" class="mb-8 text-sm text-slate-500"><a href="/" class="hover:text-primary-700">Home</a><span class="px-2">/</span><a href="/services" class="hover:text-primary-700">Services</a><span class="px-2">/</span><span aria-current="page">{service.shortTitle}</span></nav>
          <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr),16rem] lg:items-end">
            <div class="max-w-4xl">
              <div class="mb-7 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-50 text-primary-700"><ServiceIcon name={service.icon} class="h-7 w-7" /></div>
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary-700">TechMigos service</p>
              <h1 class="mt-4 text-5xl font-extrabold tracking-[-0.055em] text-slate-950 sm:text-6xl">{service.title}</h1>
              <p class="mt-6 max-w-3xl text-xl leading-8 text-slate-600">{service.summary}</p>
            </div>
            <a href={`/contact?service=${service.slug}`} class="btn-primary justify-center text-center">Discuss this service <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section class="bg-white py-16 sm:py-24">
        <div class="container-custom grid gap-14 lg:grid-cols-[minmax(0,1.2fr),minmax(18rem,.8fr)]">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary-700">How we approach it</p>
            <div class="mt-6 space-y-5 text-lg leading-8 text-slate-600">{service.description.map((paragraph) => <p>{paragraph}</p>)}</div>
            <div class="mt-12 border-t border-slate-200 pt-8">
              <h2 class="text-2xl font-extrabold tracking-[-0.03em] text-slate-950">Typical engagement rhythm</h2>
              <ol class="mt-6 space-y-5">{service.engagement.map((step, index) => <li class="grid grid-cols-[2.5rem,1fr] gap-4"><span class="text-sm font-bold text-primary-700">0{index + 1}</span><p class="text-slate-700">{step}</p></li>)}</ol>
            </div>
          </div>
          <aside class="h-fit rounded-3xl border border-slate-200 bg-slate-50 p-7 sm:p-8">
            <h2 class="text-xl font-extrabold text-slate-950">What this can include</h2>
            <ul class="mt-6 space-y-4">{service.deliverables.map((item) => <li class="flex gap-3 text-sm leading-6 text-slate-700"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500"></span>{item}</li>)}</ul>
            <p class="mt-9 text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Relevant tools</p>
            <div class="mt-3 flex flex-wrap gap-2">{service.techStack.map((tech) => <span class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700">{tech}</span>)}</div>
          </aside>
        </div>
      </section>

      <section class="border-y border-slate-200 bg-slate-950 py-16 text-white sm:py-20">
        <div class="container-custom grid gap-7 md:grid-cols-[1fr,auto] md:items-center"><div><p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-300">Start with the real problem</p><h2 class="mt-3 max-w-2xl text-3xl font-extrabold tracking-[-0.04em] sm:text-4xl">Need a clearer technical path?</h2></div><a class="inline-flex min-h-12 items-center justify-center rounded-xl bg-white px-5 py-3 font-bold text-slate-950 transition hover:bg-slate-100" href={`/contact?service=${service.slug}`}>Talk to TechMigos <span class="ml-2" aria-hidden="true">→</span></a></div>
      </section>
    </>
  ) : <section class="container-custom pb-24 pt-40 text-center"><h1 class="text-4xl font-extrabold text-slate-950">Service not found</h1><a href="/services" class="mt-6 inline-flex text-primary-700 underline">Back to services</a></section>}
</BaseLayout>
