---
import BaseLayout from '../layouts/BaseLayout.astro';

const plans = [
  {
    name: 'Starter',
    emoji: '🚀',
    description: 'Best for MVP web apps, simple mobile apps, admin dashboards, and early-stage product builds.',
    projectPrice: '15,000',
    features: [
      'Focused scope for one product surface',
      'Responsive UI and core user flows',
      'Basic backend/API integration',
      'QA pass and launch checklist',
      '2-4 weeks delivery',
      'Email support',
    ],
    cta: 'Get Started',
    popular: false,
    color: 'from-gray-50 to-gray-100',
    borderColor: 'border-gray-200',
  },
  {
    name: 'Growth',
    emoji: '⚡',
    description: 'For full-feature product launches across web, mobile, SaaS platforms, and AI-enabled workflows.',
    projectPrice: '45,000',
    features: [
      'Multi-module product delivery',
      'Custom UI interactions',
      'Advanced API and third-party integrations',
      'Analytics and event tracking',
      'Production deployment support',
      '4-8 weeks delivery',
      'Priority support',
      'Architecture and code handover',
    ],
    cta: 'Get Started',
    popular: true,
    color: 'from-primary-600 to-primary-700',
    borderColor: 'border-primary-400',
  },
  {
    name: 'Enterprise',
    emoji: '🏢',
    description: 'Custom engagement for complex systems, multi-app ecosystems, and long-term product engineering.',
    projectPrice: 'Custom',
    features: [
      'End-to-end solution architecture',
      'Advanced custom functionality',
      'AI/ML and automation workflows',
      'Cloud, security, and scale readiness',
      'Dedicated cross-functional team',
      'Roadmap-based phased delivery',
      'SLA guarantee',
      'Executive-level collaboration',
    ],
    cta: 'Contact Sales',
    popular: false,
    color: 'from-gray-50 to-gray-100',
    borderColor: 'border-gray-200',
  },
];

const comparisonFeatures = [
  { feature: 'Product Scope', starter: 'Single app surface', growth: 'Multi-module product', enterprise: 'Program-level delivery' },
  { feature: 'Responsive UI', starter: true, growth: true, enterprise: true },
  { feature: 'Custom UX Interactions', starter: false, growth: true, enterprise: true },
  { feature: 'Core Integrations', starter: 'Basic', growth: 'Advanced', enterprise: 'Full ecosystem' },
  { feature: 'Analytics & Insights', starter: false, growth: true, enterprise: true },
  { feature: 'AI/ML Components', starter: false, growth: 'Optional', enterprise: true },
  { feature: 'Cloud Architecture', starter: false, growth: true, enterprise: true },
  { feature: 'Technical Discovery', starter: 'Light', growth: 'Structured', enterprise: 'Deep-dive' },
  { feature: 'Dedicated Manager', starter: false, growth: true, enterprise: true },
  { feature: 'SLA Guarantee', starter: false, growth: false, enterprise: true },
  { feature: 'Support', starter: 'Email', growth: 'Priority', enterprise: 'Dedicated' },
];

const faqs = [
  { question: 'What payment methods do you accept?', answer: 'We accept major credit cards, bank transfers, and PayPal. Enterprise clients can use invoicing with net-30 terms.' },
  { question: 'Do you offer payment plans?', answer: 'Yes! Milestone-based payments: 30% upfront, 30% at design approval, 40% at launch. Flexible structures for larger projects.' },
  { question: 'What happens if I need changes after launch?', answer: 'All projects include a revision period. After that, we offer hourly rates or ongoing maintenance plans.' },
  { question: 'How do I choose the right package?', answer: 'We recommend a short discovery call. We map your scope, timeline, and technical needs, then confirm the best-fit package before kickoff.' },
  { question: 'Do you offer refunds?', answer: 'Due to the nature of our work, refunds on completed work aren\'t offered. However, we guarantee satisfaction throughout the process.' },
  { question: 'How long does a typical project take?', answer: 'Starter: 2–4 weeks. Growth: 4–8 weeks. Enterprise: scoped individually. We\'ll give an exact timeline after discovery.' },
];
---

<BaseLayout
  title="Pricing"
  description="Transparent pricing for web development, mobile apps, and digital transformation. Find a plan that works for your budget."
>
  <!-- HERO -->
  <section class="pt-36 pb-16 relative overflow-hidden">
    <div class="absolute inset-0 dot-pattern opacity-50"></div>
    <div class="absolute -top-32 -right-32 w-96 h-96 bg-primary-100 rounded-full blur-3xl opacity-60"></div>
    <div class="container-custom relative z-10 text-center">
      <div class="reveal">
        <span class="section-eyebrow">Pricing</span>
      </div>
      <h1 class="reveal stagger-1 text-5xl sm:text-6xl font-extrabold text-gray-900 mb-4">Transparent Pricing</h1>
      <p class="reveal stagger-2 text-xl text-gray-500 max-w-2xl mx-auto mb-8">
        No hidden fees. No surprises. Choose the plan that fits your ambitions.
      </p>

      <div class="reveal stagger-3 inline-flex items-center gap-2 bg-primary-50 text-primary-700 rounded-2xl px-5 py-2.5 text-sm font-semibold border border-primary-100">
        Project-Based Packages For All Application Types
      </div>
    </div>
  </section>

  <!-- PRICING CARDS -->
  <section class="pb-24 bg-white">
    <div class="container-custom">
      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {plans.map((plan, i) => (
          <div
            class={`relative rounded-3xl overflow-hidden border-2 transition-all duration-500 stagger-${i + 1} reveal ${
              plan.popular
                ? 'border-primary-400 shadow-2xl shadow-primary-500/20 -mt-4 mb-4'
                : 'border-gray-200 hover:border-primary-200 hover:shadow-xl'
            }`}
            style={plan.popular ? 'background: linear-gradient(160deg, #4F46E5 0%, #312e81 100%)' : 'background: white'}
          >
            {plan.popular && (
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-accent-400 to-primary-300"></div>
            )}

            {plan.popular && (
              <div class="absolute top-5 right-5">
                <span class="inline-flex items-center gap-1 px-3 py-1 bg-white/20 text-white text-xs font-bold rounded-full backdrop-blur-sm border border-white/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
                  Most Popular
                </span>
              </div>
            )}

            <div class="p-8">
              <div class="text-4xl mb-3">{plan.emoji}</div>
              <h3 class={`text-2xl font-extrabold mb-1 ${plan.popular ? 'text-white' : 'text-gray-900'}`}>
                {plan.name}
              </h3>
              <p class={`text-sm mb-7 ${plan.popular ? 'text-indigo-200' : 'text-gray-500'}`}>
                {plan.description}
              </p>

              <!-- Project price -->
              <div class="mb-7">
                <span class={`text-5xl font-black tabular-nums ${plan.popular ? 'text-white' : 'text-gray-900'}`}>
                  {plan.projectPrice !== 'Custom' ? `$${plan.projectPrice}` : 'Custom'}
                </span>
                <p class={`mt-2 text-xs uppercase tracking-wider font-semibold ${plan.popular ? 'text-indigo-200' : 'text-gray-400'}`}>
                  One-Time Project Investment
                </p>
              </div>

              <a
                href="/contact"
                class={`block w-full py-3.5 px-6 rounded-xl font-bold text-center transition-all duration-300 text-sm ${
                  plan.popular
                    ? 'bg-white text-primary-700 hover:bg-gray-50 shadow-lg hover:shadow-xl hover:-translate-y-0.5'
                    : 'bg-primary-600 text-white hover:bg-primary-700 shadow-md hover:shadow-lg hover:-translate-y-0.5'
                }`}
              >
                {plan.cta}
              </a>

              <ul class="mt-7 space-y-3">
                {plan.features.map(feature => (
                  <li class="flex items-center gap-3 text-sm">
                    <div class={`w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 ${plan.popular ? 'bg-white/20' : 'bg-primary-50'}`}>
                      <svg class={`w-3 h-3 ${plan.popular ? 'text-white' : 'text-primary-600'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                      </svg>
                    </div>
                    <span class={plan.popular ? 'text-indigo-100' : 'text-gray-600'}>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <!-- Trust badges -->
      <div class="reveal mt-12 flex flex-wrap justify-center gap-6 text-sm text-gray-500">
        {['✅ No hidden fees', '🔒 Secure payments', '📞 Free consultation', '↩️ Satisfaction guarantee'].map(b => (
          <span class="flex items-center gap-1">{b}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- COMPARISON TABLE -->
  <section class="section-padding bg-gray-50">
    <div class="container-custom">
      <div class="text-center mb-12 reveal">
        <span class="section-eyebrow">Compare</span>
        <h2 class="text-4xl font-bold text-gray-900">Feature Comparison</h2>
      </div>

      <div class="overflow-x-auto rounded-2xl shadow-sm reveal">
        <table class="w-full bg-white overflow-hidden">
          <thead>
            <tr style="background: linear-gradient(135deg, #f8fafc, #f1f5f9)">
              <th class="px-6 py-5 text-left font-bold text-gray-900 w-1/4">Feature</th>
              <th class="px-6 py-5 text-center font-bold text-gray-700">Starter</th>
              <th class="px-6 py-5 text-center font-extrabold text-primary-600" style="background: rgba(79,70,229,0.04)">Growth ⭐</th>
              <th class="px-6 py-5 text-center font-bold text-gray-700">Enterprise</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {comparisonFeatures.map((row, index) => (
              <tr class={`transition-colors hover:bg-primary-50/30 ${index % 2 === 0 ? 'bg-white' : 'bg-gray-50/50'}`}>
                <td class="px-6 py-4 text-gray-800 font-medium text-sm">{row.feature}</td>
                <td class="px-6 py-4 text-center text-gray-600 text-sm">
                  {typeof row.starter === 'boolean' ? (
                    row.starter
                      ? <svg class="w-5 h-5 text-primary-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      : <svg class="w-5 h-5 text-gray-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                  ) : row.starter}
                </td>
                <td class="px-6 py-4 text-center text-sm font-medium" style="background: rgba(79,70,229,0.04)">
                  {typeof row.growth === 'boolean' ? (
                    row.growth
                      ? <svg class="w-5 h-5 text-primary-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                      : <svg class="w-5 h-5 text-gray-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                  ) : <span class="text-primary-700">{row.growth}</span>}
                </td>
                <td class="px-6 py-4 text-center text-gray-600 text-sm">
                  {typeof row.enterprise === 'boolean' ? (
                    row.enterprise
                      ? <svg class="w-5 h-5 text-primary-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      : <svg class="w-5 h-5 text-gray-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                  ) : row.enterprise}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center mb-12 reveal">
        <span class="section-eyebrow">FAQ</span>
        <h2 class="text-4xl font-bold text-gray-900">Common Questions</h2>
      </div>
      <div class="max-w-3xl mx-auto space-y-3">
        {faqs.map((faq, index) => (
          <div class={`faq-item bg-gray-50 rounded-2xl overflow-hidden stagger-${Math.min(index + 1, 6)} reveal`}>
            <button class="faq-trigger w-full px-7 py-5 text-left flex items-center justify-between group" aria-expanded="false">
              <span class="font-semibold text-gray-900 group-hover:text-primary-600 transition-colors">{faq.question}</span>
              <div class="faq-icon w-8 h-8 rounded-full bg-white flex items-center justify-center shadow-sm transition-all duration-300 flex-shrink-0 ml-4">
                <svg class="w-4 h-4 text-gray-500 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </div>
            </button>
            <div class="faq-body">
              <p class="text-gray-600 px-7 pb-6 leading-relaxed">{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 animate-gradient-shift" style="background: linear-gradient(135deg,#4F46E5,#7C3AED,#06B6D4,#4F46E5); background-size:300% 300%;"></div>
    <div class="container-custom relative z-10 text-center reveal">
      <h2 class="text-4xl sm:text-5xl font-extrabold text-white mb-6">Still have questions?</h2>
      <p class="text-xl text-white/80 mb-10 max-w-2xl mx-auto">Talk to our team and get a custom quote tailored to your project.</p>
      <a href="/contact" class="inline-flex items-center justify-center px-10 py-4 bg-white text-primary-700 font-bold rounded-xl hover:-translate-y-1 transition-all duration-300 shadow-2xl text-lg shine-hover">
        Schedule a Call
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  // FAQ
  document.querySelectorAll('.faq-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const body = trigger.nextElementSibling as HTMLElement;
      const icon = trigger.querySelector('svg')!;
      const isOpen = body.classList.contains('open');
      document.querySelectorAll('.faq-body').forEach(b => b.classList.remove('open'));
      document.querySelectorAll('.faq-trigger svg').forEach(i => i.classList.remove('rotate-180'));
      document.querySelectorAll('.faq-trigger').forEach(t => t.setAttribute('aria-expanded', 'false'));
      if (!isOpen) { body.classList.add('open'); icon.classList.add('rotate-180'); trigger.setAttribute('aria-expanded', 'true'); }
    });
  });
</script>
