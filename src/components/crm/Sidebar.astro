---
import Icon from './Icon.astro';
import { crmNavItems } from '../../lib/crmNav';

interface Props {
  activeTab: string;
}

const { activeTab } = Astro.props;
const groups = [...new Set(crmNavItems.map((item) => item.group))];
---

<aside class="crm-sidebar">
  <div class="crm-brand"><img src="/icon.png" class="crm-logo" alt="TechMigos" /><span>TechMigos</span></div>
  <nav class="crm-nav" aria-label="Company CRM navigation" id="crm-nav">
    {groups.map((group) => (
      <div class="crm-nav-group">
        <span class="crm-nav-section">{group}</span>
        {crmNavItems.filter((item) => item.group === group).map((item) => {
          return (
            <a
              href={item.href}
              class={`crm-nav-item ${activeTab === item.key || (activeTab === 'tickets' && item.key === 'support') ? 'active' : ''}`}
              style="text-decoration:none;"
              title={item.label}
              data-nav-key={item.key}
              data-required-roles={item.roles.join(',')}
              data-required-resource={item.resource}
              data-readable-resources={item.readableResources.join(',')}
              data-supported-actions={item.supportedActions.join(',')}
            >
              <span class="crm-nav-icon"><Icon name={item.icon} size={18} /></span>
              <span class="crm-nav-label">{item.label}</span>
            </a>
          );
        })}
      </div>
    ))}
  </nav>
  <div class="crm-sidebar-footer">
    <button id="crm-collapse" class="crm-button crm-collapse" type="button" aria-label="Collapse sidebar">⇤</button>
  </div>
</aside>
