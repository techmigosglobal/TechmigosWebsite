---
import CrmButton from './CrmButton.astro';
import CrmIconButton from './CrmIconButton.astro';
import CrmModal from './CrmModal.astro';
---

<CrmModal id="crm-modal" title="Create" bodyId="crm-modal-body" closeId="crm-modal-close" />
<div id="invoice-modal" class="crm-modal" role="dialog" aria-modal="true">
  <div class="crm-modal-panel">
    <div class="crm-card-head">
      <h2 id="invoice-preview-title" class="crm-card-title">Invoice</h2>
      <div class="flex gap-2">
        <CrmButton id="print-invoice" variant="primary">Print / Save PDF</CrmButton>
        <CrmIconButton id="close-invoice" icon="close" label="Close invoice preview" />
      </div>
    </div>
    <div id="invoice-preview" class="p-5"></div>
  </div>
</div>
<div id="crm-toast" class="crm-toast" aria-live="polite"></div>
<div id="invoice-hover-preview" class="invoice-hover-preview" aria-hidden="true"></div>
<CrmModal id="proof-preview-modal" modalClass="proof-preview-modal" panelClass="proof-preview-panel" title="Proof Preview" bodyId="proof-preview-body" closeId="proof-preview-close" closeLabel="Close proof preview" />
