<div id="crm-modal" class="crm-modal" role="dialog" aria-modal="true">
  <div class="crm-modal-panel">
    <div class="crm-card-head">
      <h2 id="crm-modal-title" class="crm-card-title">Create</h2>
      <button id="crm-modal-close" class="crm-icon-button" type="button" aria-label="Close">×</button>
    </div>
    <div id="crm-modal-body" class="p-5"></div>
  </div>
</div>
<div id="invoice-modal" class="crm-modal" role="dialog" aria-modal="true">
  <div class="crm-modal-panel">
    <div class="crm-card-head">
      <h2 id="invoice-preview-title" class="crm-card-title">Invoice</h2>
      <div class="flex gap-2">
        <button id="print-invoice" class="crm-button primary" type="button">Print / Save PDF</button>
        <button id="close-invoice" class="crm-icon-button" type="button" aria-label="Close">×</button>
      </div>
    </div>
    <div id="invoice-preview" class="p-5"></div>
    <div class="pt-4 flex justify-end gap-2 border-t border-slate-200">
      <button id="download-pdf-invoice" class="crm-button" type="button">Print / Save PDF</button>
    </div>
  </div>
</div>
<div id="crm-toast" class="crm-toast" aria-live="polite"></div>
<div id="invoice-hover-preview" class="invoice-hover-preview" aria-hidden="true"></div>
<div id="proof-preview-modal" class="proof-preview-modal" role="dialog" aria-modal="true" aria-label="Proof preview">
  <div class="proof-preview-panel">
    <div class="crm-card-head">
      <h2 class="crm-card-title">Proof Preview</h2>
      <button id="proof-preview-close" class="crm-icon-button" type="button" aria-label="Close preview">×</button>
    </div>
    <div id="proof-preview-body" class="proof-preview-body"></div>
  </div>
</div>
