---

<footer class="relative overflow-hidden" style="background: linear-gradient(160deg, #0f0c29 0%, #1e1b4b 40%, #0c1a2e 100%)">
  <!-- Decorative floating orbs -->
  <div class="absolute top-0 left-0 w-96 h-96 bg-primary-600 rounded-full blur-3xl opacity-5 -translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-accent-500 rounded-full blur-3xl opacity-5 translate-x-1/2 translate-y-1/2"></div>
  <div class="absolute inset-0 dot-pattern opacity-5 pointer-events-none"></div>

  <!-- Newsletter strip -->
  <div class="relative z-10 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="text-2xl font-bold text-white mb-1">Stay in the loop</h3>
          <p class="text-indigo-300 text-sm">Get the latest insights on tech, design, and AI delivered to your inbox.</p>
        </div>
        <form id="newsletter-form" class="flex gap-3 w-full lg:w-auto">
          <input
            name="company_website"
            type="text"
            tabindex="-1"
            autocomplete="off"
            class="hidden"
            aria-hidden="true"
          />
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            placeholder="your@email.com…"
            required
            autocomplete="email"
            spellcheck="false"
            class="form-control flex-1 lg:w-72 text-sm bg-white text-slate-900 placeholder:text-slate-400 border-white/30"
          />
          <button
            id="newsletter-submit"
            type="submit"
            class="px-5 py-3 rounded-xl font-semibold text-sm text-white transition-[transform,box-shadow] duration-300 hover:-translate-y-0.5 shine-hover"
            style="background: linear-gradient(135deg, #4F46E5, #06B6D4)"
          >
            Subscribe
          </button>
        </form>
        <p id="newsletter-status" class="text-xs text-indigo-300 w-full lg:w-auto lg:text-right" role="status" aria-live="polite"></p>
      </div>
    </div>
  </div>

  <!-- Main Footer Grid -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">

      <!-- Brand Column -->
      <div class="space-y-5 lg:col-span-1">
        <a href="/" class="flex items-center space-x-2.5 group" aria-label="TechMigos Home">
          <div class="relative">
            <img
              src="/icon.png"
              alt="TechMigos logo"
              width="40"
              height="40"
              class="h-10 w-10 object-contain transition-transform duration-300 group-hover:scale-110"
            />
          </div>
          <span class="text-xl font-black text-white">TechMigos</span>
        </a>
        <p class="text-sm text-indigo-300 leading-relaxed">{footerLinks.brand.description}</p>

        <!-- Social links -->
        <div class="flex items-center gap-3 pt-2">
          {socialLinks.map(social => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-social w-9 h-9 rounded-lg flex items-center justify-center text-indigo-400 transition-[transform,background-color,color] duration-300 hover:text-white hover:scale-105"
              style="background: rgba(255,255,255,0.07)"
              aria-label={social.name}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" set:html={social.icon}></svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-bold mb-5 text-sm uppercase tracking-wider">Quick Links</h3>
        <ul class="space-y-3">
          {footerLinks.quickLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="text-sm text-indigo-300 hover:text-white transition-colors duration-200 flex items-center gap-1.5 group"
              >
                <span class="w-0 group-hover:w-3 h-0.5 bg-gradient-to-r from-primary-400 to-accent-400 rounded-full transition-[width] duration-300 overflow-hidden"></span>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-white font-bold mb-5 text-sm uppercase tracking-wider">Services</h3>
        <ul class="space-y-3">
          {footerLinks.services.map(link => (
            <li>
              <a
                href={link.href}
                class="text-sm text-indigo-300 hover:text-white transition-colors duration-200 flex items-center gap-1.5 group"
              >
                <span class="w-0 group-hover:w-3 h-0.5 bg-gradient-to-r from-primary-400 to-accent-400 rounded-full transition-[width] duration-300 overflow-hidden"></span>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-bold mb-5 text-sm uppercase tracking-wider">Contact Us</h3>
        <ul class="space-y-4">
          {footerLinks.contact.map(item => (
            <li>
              <a
                href={item.href}
                class="flex items-center gap-3 text-sm text-indigo-300 hover:text-white transition-colors duration-200 group"
              >
                <span class="text-base flex-shrink-0">{item.emoji}</span>
                <span class="group-hover:translate-x-0.5 transition-transform duration-200">{item.name}</span>
              </a>
            </li>
          ))}
        </ul>

        <!-- CTA pill -->
        <a
          href="/contact"
          class="mt-6 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white transition-[transform,box-shadow] duration-300 hover:-translate-y-0.5 shine-hover"
          style="background: linear-gradient(135deg, #4F46E5, #06B6D4)"
        >
          Start a Project
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="relative z-10 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-indigo-400">
          &copy; {currentYear} TechMigos. All rights reserved. Built in Hyderabad, Telangana, India.
        </p>
        <div class="flex items-center gap-4 text-sm text-indigo-400">
          <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
          <span class="text-white/20">|</span>
          <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
          <span class="text-white/20">|</span>
          <a href="/sitemap-index.xml" class="hover:text-white transition-colors">Sitemap</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  const newsletterForm = document.getElementById('newsletter-form') as HTMLFormElement;
  const newsletterStatus = document.getElementById('newsletter-status');
  const newsletterSubmit = document.getElementById('newsletter-submit') as HTMLButtonElement;

  async function getCsrfToken() {
    return (window as any).techmigosGetCsrfToken('Could not initialize secure newsletter submission. Please refresh and try again.');
  }

  newsletterForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const formData = new FormData(newsletterForm);
    const payload = {
      email: String(formData.get('email') || ''),
      company_website: String(formData.get('company_website') || ''),
      sourcePath: window.location.pathname || '/',
    };

    try {
      newsletterSubmit.disabled = true;
      newsletterSubmit.textContent = 'Subscribing…';
      const csrfToken = await getCsrfToken();
      const response = await (window as any).techmigosApiFetch('/api/leads/newsletter', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-csrf-token': csrfToken,
        },
        body: JSON.stringify(payload),
      });
      const result = await response.json();
      if (!response.ok || !result.ok) {
        const firstError = result.fieldErrors ? Object.values(result.fieldErrors)[0] : null;
        throw new Error(String(firstError || result.error || 'Could not subscribe.'));
      }
      newsletterForm.reset();
      if (newsletterStatus) {
        newsletterStatus.textContent = 'Thanks for subscribing.';
        newsletterStatus.className = 'text-xs text-emerald-300 w-full lg:w-auto lg:text-right';
      }
    } catch (error) {
      if (newsletterStatus) {
        newsletterStatus.textContent = error instanceof Error ? error.message : 'Could not subscribe right now.';
        newsletterStatus.className = 'text-xs text-rose-300 w-full lg:w-auto lg:text-right';
      }
    } finally {
      newsletterSubmit.disabled = false;
      newsletterSubmit.textContent = 'Subscribe';
    }
  });
</script>

<style>
  .footer-social:hover,
  .footer-social:focus-visible {
    background: linear-gradient(135deg, #2563eb, #06b6d4) !important;
  }
</style>
