---
interface Props {
  title: string;
  description: string;
  category: string;
  pubDate: Date;
  readTime?: number;
  href: string;
}

const { title, description, category, pubDate, readTime, href } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<article class="home-insight-card">
  <p class="home-insight-card__meta">{category} <span aria-hidden="true">•</span> {formattedDate}</p>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <a href={href} class="home-insight-card__link">Read article{readTime ? ` · ${readTime} min` : ''}<span aria-hidden="true">→</span></a>
</article>

<style>
  .home-insight-card { display: flex; flex-direction: column; min-height: 100%; padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .home-insight-card__meta { margin: 0; color: var(--color-accent); font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: 0.06em; text-transform: uppercase; }
  h3 { margin: var(--space-4) 0 0; font-size: var(--text-xl); letter-spacing: -0.02em; line-height: 1.22; }
  h3 a { color: var(--color-text-primary); text-decoration: none; }
  h3 a:hover, h3 a:focus-visible { color: var(--color-primary-strong); }
  p:not(.home-insight-card__meta) { margin: var(--space-3) 0 0; color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.6; }
  .home-insight-card__link { display: inline-flex; gap: var(--space-2); width: fit-content; min-height: 2.75rem; align-items: end; margin-top: auto; padding-top: var(--space-5); color: var(--color-primary-strong); font-size: var(--text-sm); font-weight: var(--weight-semibold); text-decoration: none; }
  .home-insight-card__link span { transition: transform var(--motion-fast) var(--ease-standard); }
  .home-insight-card__link:hover span, .home-insight-card__link:focus-visible span { transform: translateX(0.25rem); }
</style>
