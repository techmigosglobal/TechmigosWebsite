---
interface Props {
  title: string;
  category: string;
  description: string;
  image: string;
  tags: string[];
  href: string;
}

const { title, category, description, image, tags, href } = Astro.props;
---

<article class="home-project-card" data-work-card data-cursor-label="View">
  <a href={href} class="home-project-card__link">
    <figure>
      <img src={image} alt={`${title} product interface preview`} loading="lazy" width="960" height="640" />
      <figcaption>{category}</figcaption>
      <div class="home-project-card__overlay" aria-hidden="true">
        <span>View project</span>
      </div>
    </figure>
    <div class="home-project-card__body">
      <ul aria-label={`${title} technologies`}>
        {tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
      </ul>
      <h3>{title}</h3>
      <p>{description}</p>
      <span class="home-project-card__cta">View product details <span aria-hidden="true">↗</span></span>
    </div>
  </a>
</article>

<style>
  .home-project-card {
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--motion-normal) var(--ease-standard),
      box-shadow var(--motion-normal) var(--ease-standard),
      transform var(--motion-normal) var(--ease-standard);
  }

  .home-project-card:hover {
    border-color: rgb(13 148 136 / 0.45);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-5px);
  }

  .home-project-card__link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  figure {
    position: relative;
    aspect-ratio: 3 / 2;
    margin: 0;
    overflow: hidden;
    background: var(--color-surface-subtle);
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-slow) var(--ease-emphasized);
    will-change: transform;
  }

  .home-project-card:hover img {
    transform: scale(1.05);
  }

  figcaption {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: 0.35rem 0.55rem;
    border-radius: var(--radius-sm);
    background: rgb(15 23 42 / 0.82);
    color: var(--color-text-inverse);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    backdrop-filter: blur(8px);
  }

  /* Hover overlay — always accessible via visible CTA below */
  .home-project-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(15 23 42 / 0.45);
    opacity: 0;
    transition: opacity var(--motion-normal) var(--ease-standard);
    backdrop-filter: blur(2px);
  }

  .home-project-card__overlay span {
    padding: 0.5rem 1.2rem;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: var(--radius-md);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
  }

  .home-project-card:hover .home-project-card__overlay {
    opacity: 1;
  }

  .home-project-card__body {
    padding: var(--space-6);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0 0 var(--space-4);
    list-style: none;
  }

  li {
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  h3 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }

  p {
    margin: var(--space-3) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .home-project-card__cta {
    display: inline-flex;
    gap: var(--space-2);
    margin-top: var(--space-5);
    color: var(--color-primary-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  @media (prefers-reduced-motion: reduce) {
    .home-project-card,
    img,
    .home-project-card__overlay {
      transition: none;
    }

    .home-project-card:hover,
    .home-project-card:hover img {
      transform: none;
    }
  }
</style>
