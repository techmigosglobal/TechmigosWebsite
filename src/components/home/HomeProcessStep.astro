---
interface Props {
  number: string;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<li class="home-process-step" data-process-step>
  <div class="home-process-step__marker" aria-hidden="true">
    <span class="home-process-step__number">{number}</span>
    <div class="home-process-step__line"></div>
  </div>
  <div class="home-process-step__content">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</li>

<style>
  .home-process-step {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: var(--space-4);
    align-items: start;
    transition: opacity var(--motion-normal) var(--ease-standard);
  }

  /* Active state set by GSAP ScrollTrigger */
  .home-process-step.is-active .home-process-step__number {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 4px rgb(13 148 136 / 0.18);
  }

  .home-process-step.is-active h3 {
    color: var(--color-accent);
  }

  .home-process-step__marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .home-process-step__number {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    transition:
      background var(--motion-normal) var(--ease-standard),
      color var(--motion-normal) var(--ease-standard),
      border-color var(--motion-normal) var(--ease-standard),
      box-shadow var(--motion-normal) var(--ease-standard);
    flex-shrink: 0;
  }

  /* Connecting line between steps */
  .home-process-step__line {
    width: 1px;
    flex: 1;
    min-height: 1.5rem;
    background: var(--color-border);
    margin-top: 0.25rem;
  }

  /* Hide line on last step — CSS :last-child */
  .home-process-step:last-child .home-process-step__line {
    display: none;
  }

  .home-process-step__content {
    padding-top: 0.55rem;
  }

  h3 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--text-lg);
    transition: color var(--motion-normal) var(--ease-standard);
  }

  p {
    margin: var(--space-2) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-process-step,
    .home-process-step__number,
    h3 {
      transition: none;
    }

    .home-process-step.is-active .home-process-step__number {
      box-shadow: none;
    }
  }
</style>
