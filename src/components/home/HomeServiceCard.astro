---
import ServiceIcon from '../ServiceIcon.astro';

interface Props {
  icon: string;
  title: string;
  problem: string;
  deliverable: string;
  platform: string;
  href: string;
}

const { icon, title, problem, deliverable, platform, href } = Astro.props;
---

<article class="home-service-card" data-service-card>
  <div class="home-service-card__spotlight" aria-hidden="true"></div>
  <div class="home-service-card__icon"><ServiceIcon name={icon} class="h-6 w-6" /></div>
  <p class="home-service-card__platform">{platform}</p>
  <h3>{title}</h3>
  <p class="home-service-card__problem">{problem}</p>
  <p class="home-service-card__deliverable"><strong>Delivered:</strong> {deliverable}</p>
  <a href={href} class="home-service-card__link">Explore {title}<span aria-hidden="true">→</span></a>
</article>

<style>
  .home-service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    /* No transform-style: preserve-3d — it causes cards to go blank on rotateY */
    will-change: transform;
    --spotlight-opacity: 0;
    --spotlight-x: 50%;
    --spotlight-y: 50%;
  }

  /* Pointer-following spotlight — vivid teal */
  .home-service-card__spotlight {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      16rem circle at var(--spotlight-x) var(--spotlight-y),
      rgb(20 184 166 / 0.25),
      rgb(37 99 235 / 0.08) 50%,
      transparent 75%
    );
    transition: opacity 0.3s ease;
  }

  .home-service-card:hover {
    border-color: rgb(20 184 166 / 0.5);
    box-shadow: var(--shadow-card), 0 12px 40px rgb(13 148 136 / 0.15), 0 0 0 1px rgb(20 184 166 / 0.15);
  }

  .home-service-card__icon {
    position: relative;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    transition: background-color var(--motion-normal) var(--ease-standard), transform var(--motion-normal) var(--ease-standard);
  }

  .home-service-card:hover .home-service-card__icon {
    background: rgb(13 148 136 / 0.2);
    transform: scale(1.08);
  }

  .home-service-card__platform {
    margin: var(--space-5) 0 var(--space-2);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }

  .home-service-card__problem,
  .home-service-card__deliverable {
    margin: var(--space-3) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .home-service-card__deliverable strong {
    color: var(--color-text-primary);
  }

  .home-service-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    min-height: 2.75rem;
    margin-top: auto;
    padding-top: var(--space-5);
    color: var(--color-primary-strong);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .home-service-card__link span {
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .home-service-card__link:hover span,
  .home-service-card__link:focus-visible span {
    transform: translateX(0.3rem);
  }

  /* Border-light response on hover */
  .home-service-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid transparent;
    background: linear-gradient(
        var(--color-surface),
        var(--color-surface)
      )
      padding-box,
      linear-gradient(135deg, rgb(13 148 136 / 0.6), rgb(37 99 235 / 0.4)) border-box;
    opacity: 0;
    transition: opacity var(--motion-normal) var(--ease-standard);
    pointer-events: none;
  }

  .home-service-card:hover::after,
  .home-service-card:focus-within::after {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-service-card,
    .home-service-card__icon,
    .home-service-card__link span {
      transition: none;
    }

    .home-service-card:hover {
      transform: none;
    }
  }
</style>
