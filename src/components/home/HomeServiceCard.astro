---
import ServiceIcon from '../ServiceIcon.astro';

interface Props {
  icon: string;
  title: string;
  problem: string;
  deliverable: string;
  platform: string;
  href: string;
}

const { icon, title, problem, deliverable, platform, href } = Astro.props;
---

<article class="home-service-card">
  <div class="home-service-card__icon"><ServiceIcon name={icon} class="h-6 w-6" /></div>
  <p class="home-service-card__platform">{platform}</p>
  <h3>{title}</h3>
  <p class="home-service-card__problem">{problem}</p>
  <p class="home-service-card__deliverable"><strong>Delivered:</strong> {deliverable}</p>
  <a href={href} class="home-service-card__link">Explore {title}<span aria-hidden="true">→</span></a>
</article>

<style>
  .home-service-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--motion-normal) var(--ease-standard), box-shadow var(--motion-normal) var(--ease-standard), transform var(--motion-normal) var(--ease-standard);
  }
  .home-service-card:hover { border-color: var(--color-border-strong); box-shadow: var(--shadow-card); transform: translateY(-4px); }
  .home-service-card__icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-accent-subtle);
    color: var(--color-accent);
  }
  .home-service-card__platform { margin: var(--space-5) 0 var(--space-2); color: var(--color-accent); font-size: var(--text-xs); font-weight: var(--weight-bold); letter-spacing: 0.08em; text-transform: uppercase; }
  h3 { margin: 0; color: var(--color-text-primary); font-size: var(--text-xl); letter-spacing: -0.02em; }
  .home-service-card__problem, .home-service-card__deliverable { margin: var(--space-3) 0 0; color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.6; }
  .home-service-card__deliverable strong { color: var(--color-text-primary); }
  .home-service-card__link { display: inline-flex; align-items: center; gap: var(--space-2); width: fit-content; min-height: 2.75rem; margin-top: auto; padding-top: var(--space-5); color: var(--color-primary-strong); font-size: var(--text-sm); font-weight: var(--weight-semibold); text-decoration: none; }
  .home-service-card__link span { transition: transform var(--motion-fast) var(--ease-standard); }
  .home-service-card__link:hover span, .home-service-card__link:focus-visible span { transform: translateX(0.25rem); }
  @media (prefers-reduced-motion: reduce) { .home-service-card, .home-service-card__link span { transition: none; } .home-service-card:hover { transform: none; } }
</style>
