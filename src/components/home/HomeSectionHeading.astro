---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  id?: string;
}

const { eyebrow, title, description, align = 'left', id } = Astro.props;
---

<header class:list={['home-section-heading', `home-section-heading--${align}`]}>
  <p class="home-section-heading__eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {description && <p class="home-section-heading__description">{description}</p>}
</header>

<style>
  .home-section-heading { max-width: var(--container-reading); }
  .home-section-heading--center { margin-inline: auto; text-align: center; }
  .home-section-heading__eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h2 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.045em;
    line-height: 1.04;
  }
  .home-section-heading__description {
    margin: var(--space-5) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }
</style>
