---
interface Props {
  src: string;
  alt: string;
  priority?: boolean;
  width?: number;
  height?: number;
  className?: string;
}

const {
  src,
  alt,
  priority = false,
  width = 900,
  height = 1800,
  className = '',
} = Astro.props;
---

<div class={`focus-phone-shell ${className}`}>
  <div class="focus-phone-notch"></div>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    class="focus-phone-image"
  />
</div>

<style>
  .focus-phone-shell {
    position: relative;
    width: min(320px, 80vw);
    border-radius: 2.5rem;
    border: 7px solid #0f172a;
    overflow: hidden;
    background: #0f172a;
    box-shadow: 0 30px 70px rgba(15, 23, 42, 0.35);
  }

  .focus-phone-notch {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 36%;
    height: 24px;
    border-radius: 999px;
    background: #0b1220;
    z-index: 2;
  }

  .focus-phone-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 9 / 18;
    object-fit: cover;
    object-position: top;
    background: #e2e8f0;
  }
</style>
