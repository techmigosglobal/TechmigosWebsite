---
interface Props {
  src: string;
  alt: string;
  priority?: boolean;
  width?: number;
  height?: number;
  className?: string;
}

const {
  src,
  alt,
  priority = false,
  width = 900,
  height = 1800,
  className = '',
} = Astro.props;

const isPreframedScreenshot = src.includes('/screenshots/');
---

{isPreframedScreenshot ? (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    class={`focus-device-shot ${className}`}
  />
) : (
  <div class={`focus-phone-shell ${className}`}>
    <div class="focus-phone-notch"></div>
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      class="focus-phone-image"
    />
  </div>
)}

<style>
  .focus-device-shot {
    display: block;
    width: min(340px, 82vw);
    max-height: min(740px, 82vh);
    height: auto;
    object-fit: contain;
    object-position: center;
    border-radius: 2rem;
    filter: drop-shadow(0 30px 55px rgba(15, 23, 42, 0.22));
  }

  .focus-device-shot.focus-showcase-shot {
    width: min(300px, 72vw);
    height: 535px;
    max-width: none;
    max-height: none;
    object-fit: cover;
    object-position: center center;
    transform-origin: center center;
  }

  .focus-device-shot.focus-showcase-shot--screen-01 {
    transform: translateY(38px) scale(1.17);
  }

  .focus-device-shot.focus-showcase-shot--screen-04 {
    transform: scale(0.96);
  }

  .focus-device-shot.focus-showcase-shot--screen-21 {
    transform: scale(1);
  }

  .focus-device-shot.focus-showcase-shot--screen-22 {
    transform: scale(1.09);
  }

  .focus-device-shot.focus-showcase-shot--screen-23 {
    transform: scale(1.04);
  }

  .focus-device-shot.focus-showcase-shot--screen-10 {
    transform: scale(1.05);
  }

  .focus-device-shot.focus-showcase-shot--screen-18 {
    transform-origin: top center;
    transform: scale(1.36);
  }

  .focus-device-shot.focus-showcase-shot--screen-19 {
    transform: scale(0.98);
  }

  .focus-device-shot.focus-today-shot--02 {
    transform: translateY(6px) scale(0.98);
  }

  .focus-device-shot.focus-today-shot--03 {
    transform: translateY(2px) scale(1);
  }

  .focus-device-shot.focus-today-shot--04 {
    transform: translateY(-2px) scale(1.02);
  }

  .focus-device-shot.focus-today-shot--05 {
    transform: translateY(-1px) scale(1.01);
  }

  .focus-device-shot.focus-today-shot--08 {
    transform: translateY(38px) scale(1.18);
  }

  .focus-device-shot.focus-today-shot--11 {
    transform: translateY(2px) scale(1);
  }

  .focus-device-shot.workora-showcase-poster {
    object-fit: contain;
    object-position: center bottom;
    transform: none;
  }

  .focus-device-shot.notiva-showcase-poster {
    object-fit: contain;
    object-position: center bottom;
    transform: none;
  }

  .focus-phone-shell {
    position: relative;
    width: min(320px, 80vw);
    border-radius: 2.5rem;
    border: 7px solid #0f172a;
    overflow: hidden;
    background: #0f172a;
    box-shadow: 0 30px 70px rgba(15, 23, 42, 0.35);
  }

  .focus-phone-notch {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 36%;
    height: 24px;
    border-radius: 999px;
    background: #0b1220;
    z-index: 2;
  }

  .focus-phone-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 9 / 18;
    object-fit: cover;
    object-position: top;
    background: #e2e8f0;
  }
</style>
