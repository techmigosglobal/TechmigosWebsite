---
interface Props {
  src: string;
  alt: string;
  priority?: boolean;
  className?: string;
  url?: string;
}

const {
  src,
  alt,
  priority = false,
  className = '',
  url = 'ecommerce-site-taupe-seven.vercel.app',
} = Astro.props;
---

<div class={`focus-browser-shell ${className}`}>
  <!-- Browser Chrome Top Bar -->
  <div class="focus-browser-header">
    <div class="focus-browser-dots">
      <span class="focus-browser-dot dot-red"></span>
      <span class="focus-browser-dot dot-yellow"></span>
      <span class="focus-browser-dot dot-green"></span>
    </div>
    <div class="focus-browser-address-bar">
      <svg class="icon-padlock" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <span class="focus-browser-url truncate">{url}</span>
    </div>
  </div>
  
  <!-- Browser Content -->
  <div class="focus-browser-content">
    <img
      src={src}
      alt={alt}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      class="focus-browser-image"
    />
  </div>
</div>

<style>
  .focus-browser-shell {
    position: relative;
    width: 100%;
    border-radius: 14px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.22);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.3s ease;
  }

  .focus-browser-shell:hover {
    box-shadow: 0 35px 80px -20px rgba(15, 23, 42, 0.3);
  }

  .focus-browser-header {
    height: 42px;
    background: #f1f5f9;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    padding: 0 16px;
    gap: 16px;
    user-select: none;
  }

  .focus-browser-dots {
    display: flex;
    gap: 6px;
  }

  .focus-browser-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot-red { background: #ef4444; }
  .dot-yellow { background: #eab308; }
  .dot-green { background: #22c55e; }

  .focus-browser-address-bar {
    flex: 1;
    max-width: 440px;
    height: 26px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    margin: 0 auto;
  }

  .icon-padlock {
    width: 12px;
    height: 12px;
    color: #10b981;
    margin-right: 6px;
    flex-shrink: 0;
  }

  .focus-browser-url {
    font-size: 11px;
    color: #475569;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-weight: 500;
  }

  .focus-browser-content {
    width: 100%;
    aspect-ratio: 1.6;
    overflow: hidden;
    background: #f8fafc;
  }

  .focus-browser-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.4s ease;
  }
</style>
