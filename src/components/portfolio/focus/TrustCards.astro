---
type TrustItem = {
  quote: string;
  name: string;
  role: string;
};

interface Props {
  items: TrustItem[];
  eyebrow?: string;
  title?: string;
}

const {
  items,
  eyebrow = 'Trust Signals',
  title = 'Built With Ground-Level Product Feedback',
} = Astro.props;
---

<section class="section-padding bg-white" id="focus-trust">
  <div class="container-custom">
    <div class="mb-10 text-center reveal">
      <span class="section-eyebrow">{eyebrow}</span>
      <h2 class="mt-4 text-3xl font-extrabold text-gray-900 sm:text-4xl">{title}</h2>
    </div>

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
      {items.map((item, index) => (
        <article class={`reveal stagger-${(index % 6) + 1} rounded-2xl border border-slate-200 bg-white p-6 shadow-sm`}>
          <p class="text-gray-700">"{item.quote}"</p>
          <p class="mt-4 text-sm font-semibold text-gray-900">{item.name}</p>
          <p class="text-sm text-gray-500">{item.role}</p>
        </article>
      ))}
    </div>
  </div>
</section>
