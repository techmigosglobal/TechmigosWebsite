---
type Feature = {
  title: string;
  description: string;
  icon: string;
};

interface Props {
  features: Feature[];
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  features,
  eyebrow = 'Feature Stack',
  title = 'Built for Fast Civic Publishing',
  description = 'A practical mobile architecture focused on clear publishing flows, local language access, and stable day-to-day operation.',
} = Astro.props;
---

<section class="section-padding bg-gray-50" id="focus-features">
  <div class="container-custom">
    <div class="mb-12 text-center reveal">
      <span class="section-eyebrow">{eyebrow}</span>
      <h2 class="mt-4 text-3xl font-extrabold text-gray-900 sm:text-4xl">{title}</h2>
      <p class="mx-auto mt-4 max-w-2xl text-gray-600">{description}</p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {features.map((feature, index) => (
        <article class={`reveal stagger-${(index % 6) + 1} rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-primary-200 hover:shadow-xl`}>
          <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary-50 text-lg font-bold text-primary-700">
            {feature.icon}
          </div>
          <h3 class="text-xl font-bold text-gray-900">{feature.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
