---
import PhoneFrame from './PhoneFrame.astro';
import BrowserFrame from './BrowserFrame.astro';

interface Props {
  appName: string;
  tagline: string;
  heroImage: string;
  webUrl: string;
  androidUrl?: string;
  eyebrow?: string;
  primaryLabel?: string;
  secondaryLabel?: string;
  supportText?: string;
  isDesktop?: boolean;
}

const {
  appName,
  tagline,
  heroImage,
  webUrl,
  androidUrl,
  eyebrow = 'Flutter + Firebase Product',
  primaryLabel = 'Try Web Live',
  secondaryLabel = 'Get Android App',
  supportText = 'Verified local updates, multilingual content, and civic engagement workflows in one mobile experience.',
  isDesktop = false,
} = Astro.props;

const hasSecondaryLink = Boolean(androidUrl && androidUrl !== '#');
const secondaryUrl = hasSecondaryLink ? String(androidUrl) : '';
const isExternalUrl = (url: string) => /^https?:\/\//.test(url);
const isPreframedHero = heroImage.includes('/screenshots/');
---

<section class="relative overflow-hidden pt-32 pb-20 sm:pt-36 sm:pb-24">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(37,99,235,0.22),transparent_55%),radial-gradient(circle_at_85%_15%,rgba(14,165,233,0.18),transparent_45%),linear-gradient(180deg,#f8fbff_0%,#f3f6fc_60%,#eef3fa_100%)]"></div>
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute -top-20 -right-12 h-72 w-72 rounded-full bg-white/60 blur-3xl"></div>
    <div class="absolute -bottom-20 -left-10 h-72 w-72 rounded-full bg-primary-100/70 blur-3xl"></div>
  </div>

  <div class="container-custom relative z-10 grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="reveal">
      <span class="section-eyebrow">{eyebrow}</span>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">{appName}</h1>
      <p class="mt-5 max-w-xl text-lg text-gray-600 sm:text-xl">{tagline}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={webUrl}
          target={isExternalUrl(webUrl) ? '_blank' : undefined}
          rel={isExternalUrl(webUrl) ? 'noopener noreferrer' : undefined}
          class="btn-primary"
        >
          {primaryLabel}
        </a>
        {hasSecondaryLink && (
          <a
            href={secondaryUrl}
            target={isExternalUrl(secondaryUrl) ? '_blank' : undefined}
            rel={isExternalUrl(secondaryUrl) ? 'noopener noreferrer' : undefined}
            class="btn-ghost border-slate-300"
          >
            {secondaryLabel}
          </a>
        )}
      </div>

      {supportText && <p class="mt-5 text-sm text-gray-500">{supportText}</p>}
    </div>

    <div class="reveal-scale justify-self-center lg:justify-self-end w-full max-w-xl lg:max-w-2xl">
      {isDesktop ? (
        <div class="animate-float-slow">
          <BrowserFrame src={heroImage} alt={`${appName} desktop screen`} priority={true} url={isExternalUrl(webUrl) ? new URL(webUrl).hostname : 'hastkala.vercel.app'} />
        </div>
      ) : isPreframedHero ? (
        <div class="animate-float-slow">
          <PhoneFrame src={heroImage} alt={`${appName} hero screen`} priority={true} />
        </div>
      ) : (
        <div class="relative rounded-[2.5rem] border border-white/70 bg-white/45 p-4 shadow-[0_40px_80px_rgba(15,23,42,0.2)] backdrop-blur-xl">
          <div class="animate-float-slow">
            <PhoneFrame src={heroImage} alt={`${appName} hero screen`} priority={true} />
          </div>
        </div>
      )}
    </div>
  </div>
</section>
