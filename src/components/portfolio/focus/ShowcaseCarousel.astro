---
import PhoneFrame from './PhoneFrame.astro';
import BrowserFrame from './BrowserFrame.astro';

type Slide = {
  src: string;
  alt: string;
  title: string;
  caption: string;
  displayClass?: string;
};

interface Props {
  slides: Slide[];
  eyebrow?: string;
  title?: string;
  description?: string;
  isDesktop?: boolean;
}

const {
  slides,
  eyebrow = 'App Showcase',
  title = 'A Polished Mobile Experience',
  description = 'Core screens presented in a smooth scroll carousel designed for quick product comprehension.',
  isDesktop = false,
} = Astro.props;
---

<section class="section-padding bg-white" id="focus-showcase">
  <div class="container-custom">
    <div class="mb-10 text-center reveal">
      <span class="section-eyebrow">{eyebrow}</span>
      <h2 class="mt-4 text-3xl font-extrabold text-gray-900 sm:text-4xl">{title}</h2>
      <p class="mx-auto mt-4 max-w-2xl text-gray-600">{description}</p>
    </div>

    <div class="relative reveal">
      <div id="focus-carousel-track" class="flex snap-x snap-mandatory items-start gap-6 overflow-x-auto pb-6 scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {slides.map((slide, index) => (
          <article class={`focus-slide flex snap-center flex-col px-4 py-3 text-center ${isDesktop ? 'min-w-[90%] sm:min-w-[70%] lg:min-w-[55%]' : 'min-w-[86%] sm:min-w-[48%] lg:min-w-[32%]'}`} data-slide-index={index}>
            <div class={`focus-shot-viewport mx-auto flex items-center justify-center overflow-hidden ${isDesktop ? 'focus-shot-viewport--desktop' : ''}`}>
              {isDesktop ? (
                <BrowserFrame src={slide.src} alt={slide.alt} className={`focus-showcase-shot ${slide.displayClass || ''}`} />
              ) : (
                <PhoneFrame src={slide.src} alt={slide.alt} className={`focus-showcase-shot ${slide.displayClass || ''}`} />
              )}
            </div>
            <div class="focus-slide-copy mx-auto flex w-full max-w-lg flex-1 flex-col justify-start">
              <h3 class="mt-4 text-xl font-bold text-gray-900">{slide.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-600">{slide.caption}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-3 flex items-center justify-center gap-4">
        <button
          id="focus-carousel-prev"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:border-primary-200 hover:text-primary-700 hover:shadow-md"
          type="button"
          aria-label="Show previous screen"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>

        <div class="flex items-center justify-center gap-2" id="focus-carousel-dots">
          {slides.map((_, index) => (
            <button
              class="focus-dot h-2.5 w-2.5 rounded-full bg-slate-300 transition-all duration-300"
              data-dot-index={index}
              aria-label={`Go to slide ${index + 1}`}
              type="button"
            ></button>
          ))}
        </div>

        <button
          id="focus-carousel-next"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:border-primary-200 hover:text-primary-700 hover:shadow-md"
          type="button"
          aria-label="Show next screen"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  let disposeCarousel: (() => void) | undefined;

  function initShowcaseCarousel() {
    const section = document.getElementById('focus-showcase');
    const track = section?.querySelector<HTMLElement>('#focus-carousel-track');
    if (!section || !track || disposeCarousel) return;
    const slides = [...track.querySelectorAll<HTMLElement>('.focus-slide')];
    const dots = [...section.querySelectorAll<HTMLButtonElement>('.focus-dot')];
    if (!slides.length) return;

    const controller = new AbortController();
    const { signal } = controller;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let activeIndex = 0;
    let inView = false;
    let pointerOver = false;
    let manualSelection = false;
    let timer: number | undefined;
    let frame = 0;

    function activate(index: number) {
      activeIndex = index;
      dots.forEach((dot, dotIndex) => {
        dot.classList.toggle('bg-primary-600', dotIndex === index);
        dot.classList.toggle('w-8', dotIndex === index);
        dot.classList.toggle('bg-slate-300', dotIndex !== index);
        dot.setAttribute('aria-current', String(dotIndex === index));
      });
    }

    function scrollToSlide(index: number) {
      const next = (index + slides.length) % slides.length;
      const bounds = track!.getBoundingClientRect();
      const slide = slides[next].getBoundingClientRect();
      const left = track!.scrollLeft + slide.left - bounds.left + (slide.width - bounds.width) / 2;
      track!.scrollTo({ left, top: 0, behavior: reduced.matches ? 'instant' : 'smooth' });
      activate(next);
    }

    function syncPlayback() {
      window.clearTimeout(timer);
      if (reduced.matches || slides.length < 2 || !inView || document.hidden || pointerOver || manualSelection || section!.contains(document.activeElement)) return;
      timer = window.setTimeout(() => {
        scrollToSlide(activeIndex + 1);
        syncPlayback();
      }, 3600);
    }

    function choose(index: number) {
      manualSelection = true;
      syncPlayback();
      scrollToSlide(index);
    }

    const visibility = new IntersectionObserver(([entry]) => {
      inView = entry.intersectionRatio >= .15;
      syncPlayback();
    }, { threshold: .15 });
    visibility.observe(track);

    dots.forEach((dot, index) => dot.addEventListener('click', () => choose(index), { signal }));
    section.querySelector('#focus-carousel-prev')?.addEventListener('click', () => choose(activeIndex - 1), { signal });
    section.querySelector('#focus-carousel-next')?.addEventListener('click', () => choose(activeIndex + 1), { signal });
    track.addEventListener('pointerdown', () => {
      manualSelection = true;
      syncPlayback();
    }, { signal });
    track.addEventListener('scroll', () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const center = track!.getBoundingClientRect().left + track!.clientWidth / 2;
        let nearest = 0;
        let distance = Infinity;
        slides.forEach((slide, index) => {
          const bounds = slide.getBoundingClientRect();
          const delta = Math.abs(bounds.left + bounds.width / 2 - center);
          if (delta < distance) {
            nearest = index;
            distance = delta;
          }
        });
        if (track!.scrollLeft < 2) nearest = 0;
        else if (track!.scrollLeft + track!.clientWidth >= track!.scrollWidth - 2) nearest = slides.length - 1;
        activate(nearest);
      });
    }, { signal, passive: true });
    section.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse') return;
      pointerOver = true;
      syncPlayback();
    }, { signal });
    section.addEventListener('pointerleave', () => {
      pointerOver = false;
      syncPlayback();
    }, { signal });
    section.addEventListener('focusin', syncPlayback, { signal });
    section.addEventListener('focusout', () => queueMicrotask(() => { if (!signal.aborted) syncPlayback(); }), { signal });
    document.addEventListener('visibilitychange', syncPlayback, { signal });
    reduced.addEventListener('change', syncPlayback, { signal });

    activate(0);
    disposeCarousel = () => {
      controller.abort();
      visibility.disconnect();
      window.clearTimeout(timer);
      cancelAnimationFrame(frame);
      disposeCarousel = undefined;
    };
  }

  initShowcaseCarousel();
  document.addEventListener('astro:page-load', initShowcaseCarousel);
  document.addEventListener('astro:before-swap', () => disposeCarousel?.());
</script>

<style>
  .focus-shot-viewport {
    width: min(300px, 72vw);
    height: 560px;
  }

  .focus-shot-viewport.focus-shot-viewport--desktop {
    width: 100%;
    height: auto;
    aspect-ratio: 1.6;
  }

  .focus-slide-copy {
    min-height: 9.25rem;
  }

  @media (max-width: 639px) {
    .focus-shot-viewport {
      height: min(560px, 134vw);
    }
    .focus-shot-viewport.focus-shot-viewport--desktop {
      height: auto;
      aspect-ratio: 1.6;
    }
  }
</style>
