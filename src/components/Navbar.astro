---
const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: 'Work', href: '/work' },
  { name: 'About', href: '/about' },
  { name: 'Blog', href: '/blog' },
  { name: 'Careers', href: '/careers' },
  { name: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const isLinkActive = (href: string) => {
  const normCurrent = normalizePath(currentPath);
  const normHref = normalizePath(href);
  if (normHref === '/') return normCurrent === '/';
  return normCurrent === normHref || normCurrent.startsWith(normHref + '/');
};
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-[background-color,box-shadow,backdrop-filter] duration-500">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2.5 group flex-shrink-0" aria-label="TechMigos Home">
        <div class="relative">
          <img
            src="/icon.png"
            alt="TechMigos logo"
            width="40"
            height="40"
            class="h-10 w-10 object-contain transition-transform duration-300 group-hover:scale-110"
          />
          <div class="absolute inset-0 rounded-full bg-primary-500 opacity-0 group-hover:opacity-15 blur-md transition-opacity duration-300 scale-125"></div>
        </div>
        <span class="text-xl font-black tracking-tight" style="background: linear-gradient(135deg,#1e1b4b,#4F46E5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
          TechMigos
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center space-x-1">
        {navLinks.slice(0, -1).map((link) => (
          <a
            href={link.href}
            data-nav-link
            data-href={link.href}
            class={`relative px-3.5 py-2 text-sm font-semibold rounded-lg transition-all duration-200 link-underline ${
              isLinkActive(link.href)
                ? 'text-primary-600 font-bold active-nav-link'
                : 'text-slate-600 hover:text-primary-600 hover:bg-primary-50/80'
            }`}
          >
            {link.name}
            {isLinkActive(link.href) && (
              <span class="nav-indicator absolute bottom-0 left-3.5 right-3.5 h-0.5 rounded-full bg-gradient-to-r from-primary-500 to-accent-400"></span>
            )}
          </a>
        ))}
      </div>

      <!-- Actions & Menu -->
      <div class="flex items-center gap-2 sm:gap-3 ml-auto lg:ml-0">
        <a href="/contact" class="hidden lg:inline-flex btn-primary text-sm px-5 py-2.5 shine-hover font-semibold tracking-wide shadow-md shadow-primary-600/20">
          Get a Free Quote
        </a>
        <a href="/login" aria-label="Log in to TechMigos Finance" title="Finance login" class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-slate-200/90 text-slate-700 hover:text-primary-600 hover:bg-primary-50/70 hover:border-primary-200 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
          <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 5h5a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-5M3 12h12m-4-4 4 4-4 4" />
          </svg>
        </a>
        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden relative w-10 h-10 flex flex-col items-center justify-center gap-1.5 rounded-xl text-slate-700 hover:bg-primary-50 hover:text-primary-600 transition-colors"
          aria-label="Toggle mobile menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="hamburger-line w-5 h-0.5 bg-current rounded-full transition-[transform,opacity] duration-300 origin-center"></span>
          <span class="hamburger-line w-5 h-0.5 bg-current rounded-full transition-[transform,opacity] duration-300"></span>
          <span class="hamburger-line w-5 h-0.5 bg-current rounded-full transition-[transform,opacity] duration-300 origin-center"></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    class="lg:hidden overflow-hidden transition-[max-height,opacity] duration-500 ease-in-out"
    style="max-height: 0; opacity: 0;"
    hidden
  >
    <div class="px-4 pb-6 pt-2 space-y-1 border-t border-gray-100 bg-white/95 backdrop-blur-xl shadow-lg">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-mobile-nav-link
          data-href={link.href}
          class={`flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition-[background-color,color] duration-200 ${
            isLinkActive(link.href)
              ? 'bg-primary-50 text-primary-600 font-bold active-mobile-nav-link'
              : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'
          }`}
        >
          {isLinkActive(link.href) && (
            <span class="nav-mobile-dot w-1.5 h-1.5 rounded-full bg-primary-500 flex-shrink-0"></span>
          )}
          {link.name}
        </a>
      ))}
      <div class="pt-3 px-4">
        <a href="/contact" class="btn-primary w-full text-center shine-hover">
          Get a Free Quote
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Hamburger → X animation */
  #mobile-menu-btn.open .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #mobile-menu-btn.open .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #mobile-menu-btn.open .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>

<script>
  const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
  const checkLinkActive = (href: string, currentPath: string) => {
    const normCurrent = normalizePath(currentPath);
    const normHref = normalizePath(href);
    if (normHref === '/') return normCurrent === '/';
    return normCurrent === normHref || normCurrent.startsWith(normHref + '/');
  };

  const syncActiveNavLinks = () => {
    const currentPath = window.location.pathname;

    // Synchronize Desktop Navigation Links
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
      const href = link.getAttribute('data-href') || link.getAttribute('href') || '';
      const active = checkLinkActive(href, currentPath);

      link.classList.toggle('text-primary-600', active);
      link.classList.toggle('font-bold', active);
      link.classList.toggle('active-nav-link', active);
      link.classList.toggle('text-slate-600', !active);

      let indicator = link.querySelector('.nav-indicator');
      if (active) {
        if (!indicator) {
          indicator = document.createElement('span');
          indicator.className = 'nav-indicator absolute bottom-0 left-3.5 right-3.5 h-0.5 rounded-full bg-gradient-to-r from-primary-500 to-accent-400';
          link.appendChild(indicator);
        }
      } else if (indicator) {
        indicator.remove();
      }
    });

    // Synchronize Mobile Navigation Links
    document.querySelectorAll<HTMLAnchorElement>('[data-mobile-nav-link]').forEach((link) => {
      const href = link.getAttribute('data-href') || link.getAttribute('href') || '';
      const active = checkLinkActive(href, currentPath);

      link.classList.toggle('bg-primary-50', active);
      link.classList.toggle('text-primary-600', active);
      link.classList.toggle('font-bold', active);
      link.classList.toggle('active-mobile-nav-link', active);
      link.classList.toggle('text-gray-600', !active);

      let dot = link.querySelector('.nav-mobile-dot');
      if (active) {
        if (!dot) {
          dot = document.createElement('span');
          dot.className = 'nav-mobile-dot w-1.5 h-1.5 rounded-full bg-primary-500 flex-shrink-0';
          link.prepend(dot);
        }
      } else if (dot) {
        dot.remove();
      }
    });
  };

  const initNavbar = () => {
    let menuOpen = false;
    const navbar = document.getElementById('navbar') as HTMLElement;
    const mobileMenuBtn = document.getElementById('mobile-menu-btn') as HTMLButtonElement;
    const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;

    // Sync active state on init
    syncActiveNavLinks();

    // Handle scroll — add glass effect
    let ticking = false;
    if (!(window as any).__navScrollBound) {
      (window as any).__navScrollBound = true;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            const scrolled = window.scrollY > 20;
            if (scrolled) {
              navbar.style.background = 'rgba(255,255,255,0.85)';
              navbar.style.backdropFilter = 'blur(20px)';
              navbar.style.setProperty('-webkit-backdrop-filter', 'blur(20px)');
              navbar.style.boxShadow = '0 1px 30px rgba(79,70,229,0.08), 0 1px 0 rgba(0,0,0,0.06)';
            } else {
              navbar.style.background = window.location.pathname === '/' ? 'transparent' : 'rgba(255,255,255,0.95)';
              navbar.style.backdropFilter = scrolled ? 'blur(20px)' : 'none';
              navbar.style.boxShadow = 'none';
            }
            ticking = false;
          });
          ticking = true;
        }
      });
    }

    // Initialize background
    if (window.scrollY > 20) {
      navbar.style.background = 'rgba(255,255,255,0.85)';
      navbar.style.backdropFilter = 'blur(20px)';
      navbar.style.boxShadow = '0 1px 30px rgba(79,70,229,0.08)';
    } else if (window.location.pathname !== '/') {
      navbar.style.background = 'rgba(255,255,255,0.95)';
      navbar.style.boxShadow = '0 1px 0 rgba(0,0,0,0.06)';
    }

    // Toggle mobile menu
    mobileMenuBtn?.addEventListener('click', () => {
      menuOpen = !menuOpen;
      mobileMenuBtn.classList.toggle('open', menuOpen);
      mobileMenuBtn.setAttribute('aria-expanded', menuOpen.toString());

      if (menuOpen) {
        mobileMenu.hidden = false;
        mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
        mobileMenu.style.opacity = '1';
      } else {
        mobileMenu.style.maxHeight = '0';
        mobileMenu.style.opacity = '0';
        window.setTimeout(() => {
          if (!menuOpen) mobileMenu.hidden = true;
        }, 500);
      }
    });

    // Close on link click
    const closeMenu = (returnFocus = false) => {
      if (!menuOpen) return;
      menuOpen = false;
      mobileMenuBtn?.classList.remove('open');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
      mobileMenu.style.maxHeight = '0';
      mobileMenu.style.opacity = '0';
      window.setTimeout(() => {
        if (!menuOpen) mobileMenu.hidden = true;
      }, 500);
      if (returnFocus) mobileMenuBtn?.focus();
    };

    mobileMenu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => closeMenu());
    });

    // Escape closes the open drawer and returns focus to its toggle
    (window as any).__navClose = closeMenu;
    if (!(window as any).__navKeyBound) {
      (window as any).__navKeyBound = true;
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') (window as any).__navClose?.(true);
      });
    }
  };

  initNavbar();
  document.addEventListener('astro:page-load', initNavbar);
  document.addEventListener('astro:after-swap', syncActiveNavLinks);
  window.addEventListener('popstate', syncActiveNavLinks);
</script>
