---
const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: 'Portfolio', href: '/portfolio' },
  { name: 'About', href: '/about' },
  { name: 'Blog', href: '/blog' },
  { name: 'Pricing', href: '/pricing' },
  { name: 'Careers', href: '/careers' },
  { name: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2.5 group flex-shrink-0" aria-label="TechMigos Home">
        <!-- Animated Logo SVG -->
        <div class="relative">
          <svg width="36" height="36" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"
            class="transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6">
            <path d="M16 2L28 9V23L16 30L4 23V9L16 2Z" stroke="#4F46E5" stroke-width="2" fill="none"/>
            <path d="M16 8L22 12V20L16 24L10 20V12L16 8Z" fill="#4F46E5"/>
            <path d="M16 14L19 16V22L16 24L13 22V16L16 14Z" fill="#06B6D4"/>
          </svg>
          <!-- Glow on hover -->
          <div class="absolute inset-0 rounded-full bg-primary-500 opacity-0 group-hover:opacity-20 blur-md transition-all duration-300 scale-150"></div>
        </div>
        <span class="text-xl font-black tracking-tight" style="background: linear-gradient(135deg,#1e1b4b,#4F46E5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
          TechMigos
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center space-x-1">
        {navLinks.slice(0, -1).map((link) => (
          <a
            href={link.href}
            class={`relative px-3 py-2 text-sm font-medium rounded-lg transition-all duration-200 link-underline ${
              currentPath === link.href
                ? 'text-primary-600'
                : 'text-gray-600 hover:text-primary-600 hover:bg-primary-50'
            }`}
          >
            {link.name}
            {currentPath === link.href && (
              <span class="absolute bottom-0 left-3 right-3 h-0.5 rounded-full bg-gradient-to-r from-primary-500 to-accent-400"></span>
            )}
          </a>
        ))}
      </div>

      <!-- CTA Button -->
      <div class="hidden lg:flex items-center gap-3">
        <a href="/contact" class="btn-primary text-sm px-5 py-2.5 shine-hover">
          Get a Free Quote
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden relative w-10 h-10 flex flex-col items-center justify-center gap-1.5 rounded-xl text-gray-600 hover:bg-primary-50 hover:text-primary-600 transition-all duration-200"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <span class="hamburger-line w-5 h-0.5 bg-current rounded-full transition-all duration-300 origin-center"></span>
        <span class="hamburger-line w-5 h-0.5 bg-current rounded-full transition-all duration-300"></span>
        <span class="hamburger-line w-5 h-0.5 bg-current rounded-full transition-all duration-300 origin-center"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    class="lg:hidden overflow-hidden transition-all duration-500 ease-in-out"
    style="max-height: 0; opacity: 0;"
  >
    <div class="px-4 pb-6 pt-2 space-y-1 border-t border-gray-100 bg-white/95 backdrop-blur-xl shadow-lg">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition-all duration-200 ${
            currentPath === link.href
              ? 'bg-primary-50 text-primary-600'
              : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'
          }`}
        >
          {currentPath === link.href && (
            <span class="w-1.5 h-1.5 rounded-full bg-primary-500 flex-shrink-0"></span>
          )}
          {link.name}
        </a>
      ))}
      <div class="pt-3 px-4">
        <a href="/contact" class="btn-primary w-full text-center shine-hover">
          Get a Free Quote
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Hamburger → X animation */
  #mobile-menu-btn.open .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #mobile-menu-btn.open .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #mobile-menu-btn.open .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>

<script>
  const navbar = document.getElementById('navbar') as HTMLElement;
  const mobileMenuBtn = document.getElementById('mobile-menu-btn') as HTMLButtonElement;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;
  let menuOpen = false;

  // Handle scroll — add glass effect
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        const scrolled = window.scrollY > 20;
        if (scrolled) {
          navbar.style.background = 'rgba(255,255,255,0.85)';
          navbar.style.backdropFilter = 'blur(20px)';
          navbar.style.webkitBackdropFilter = 'blur(20px)';
          navbar.style.boxShadow = '0 1px 30px rgba(79,70,229,0.08), 0 1px 0 rgba(0,0,0,0.06)';
        } else {
          navbar.style.background = window.location.pathname === '/' ? 'transparent' : 'rgba(255,255,255,0.95)';
          navbar.style.backdropFilter = scrolled ? 'blur(20px)' : 'none';
          navbar.style.boxShadow = 'none';
        }
        ticking = false;
      });
      ticking = true;
    }
  });

  // Initialize
  if (window.scrollY > 20) {
    navbar.style.background = 'rgba(255,255,255,0.85)';
    navbar.style.backdropFilter = 'blur(20px)';
    navbar.style.boxShadow = '0 1px 30px rgba(79,70,229,0.08)';
  } else if (window.location.pathname !== '/') {
    navbar.style.background = 'rgba(255,255,255,0.95)';
    navbar.style.boxShadow = '0 1px 0 rgba(0,0,0,0.06)';
  }

  // Toggle mobile menu
  mobileMenuBtn?.addEventListener('click', () => {
    menuOpen = !menuOpen;
    mobileMenuBtn.classList.toggle('open', menuOpen);
    mobileMenuBtn.setAttribute('aria-expanded', menuOpen.toString());

    if (menuOpen) {
      mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
      mobileMenu.style.opacity = '1';
    } else {
      mobileMenu.style.maxHeight = '0';
      mobileMenu.style.opacity = '0';
    }
  });

  // Close on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menuOpen = false;
      mobileMenuBtn?.classList.remove('open');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
      mobileMenu.style.maxHeight = '0';
      mobileMenu.style.opacity = '0';
    });
  });
</script>
