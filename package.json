{
  "name": "techmigos-website",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro preview",
    "build": "astro build",
    "build:vercel": "npm run build",
    "build:full": "npm run build",
    "preview": "astro preview",
    "astro": "astro",
    "verify:content": "./scripts/verify-blog-content.sh",
    "validate": "npm run build && node scripts/validate-site.mjs",
    "seo:audit": "node scripts/seo-weekly-audit.mjs",
    "leads:export": "node scripts/lead-management.mjs export",
    "leads:list": "node scripts/lead-management.mjs list",
    "portal:user": "node scripts/provision-portal-user.mjs",
    "vercel:whoami": "npx --yes vercel@54.1.0 whoami",
