rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validEmail() {
      return request.resource.data.email is string
        && request.resource.data.email.size() <= 320;
    }

    match /contact_leads/{id} {
      allow create: if validEmail();
      allow read, update, delete: if false;
    }

    match /newsletter_subscribers/{id} {
      allow create: if validEmail();
      allow read, update, delete: if false;
    }

    match /career_applications/{id} {
      allow create: if validEmail();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
