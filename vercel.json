{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "framework": "astro",
  "env": {
    "NODE_ENV": "production",
    "PUBLIC_SITE_URL": "https://www.techmigos.com",
    "NEXT_PUBLIC_SITE_URL": "https://www.techmigos.com",
    "PUBLIC_SUPABASE_URL": "https://lzlflnjrtxovzrniwmyq.supabase.co",
    "PUBLIC_SUPABASE_KEY": "sb_publishable_c6ePngXzONzedvwFQnL6tw_5tyUCLHJ"
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "techmigos.com"
        }
      ],
      "destination": "https://www.techmigos.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/_astro/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
